#SAVEAS "@:TXT3.SRC.PRG"
#REM 0
#INCLUDE "GPB.INC.BL"

## THE SLOT SWAP: back to a bank that has already been written to.
##
## G.C is in bank 6 like G.A, so its base has to CONTINUE from G.A's two strings and not start
## again at zero. That is the counters going away with the slot and coming back with it, which
## is the one thing BStrSelectSlot exists to do.

GP.BANKEDSTR 6 G.A
  "A0"
  "A1"
GP.ENDBANKEDSTR

GP.BANKEDSTR 7 G.B
  "B0"
GP.ENDBANKEDSTR

GP.BANKEDSTR 6 G.C
  "C0"
GP.ENDBANKEDSTR

PRINT "T1 " + GP.BSTR(G.A, 0)
PRINT "T2 " + GP.BSTR(G.A, 1)
PRINT "T3 " + GP.BSTR(G.B, 0)
PRINT "T4 " + GP.BSTR(G.C, 0)
PRINT "T5 END"
END
