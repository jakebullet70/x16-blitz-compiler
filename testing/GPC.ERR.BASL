#INCLUDE "GPB.INC.BL"
#SAVEAS "@:GPC.ERR.PRG"
#SYMFILE "@:GPC.ERR.SYM"
#AUTONUM 5
#REM 0

REM --------------------------------------------------------
REM ---> GPC.ERR (BASLOAD SOURCE)
REM ---> READS A GPC DEBUG MAP (M.<SOURCE>) AND TURNS A
REM ---> RUNTIME ERROR  "<MSG> @ $XXXX"  INTO A BASIC LINE.
REM ---> MAKE THE MAP BY ANSWERING "MAKE A DEBUG MAP? YES"
REM ---> WHEN YOU COMPILE WITH GPC.
REM ---> SADLOGIC, JULY 2026
REM --------------------------------------------------------
REM ---> GP.BASIC THROUGHOUT: GP.IF/GP.ELSEIF/GP.ELSE/GP.ENDIF
REM ---> FOR THE BRANCHES, GP.DO/GP.LOOP/GP.EXITDO FOR THE
REM ---> LOOPS, AND GP.INSTR/GP.UPPER/GP.LTRIM FOR THE HEX
REM ---> PARSING. THERE IS NOT ONE GOTO LEFT.
REM ---> IT THEREFORE COMPILES SHARED AGAINST GPB.RT.NNN.BIN,
REM ---> THE RUNTIME *WITH* THE HANDLERS -- NOT THE CORE-ONLY
REM ---> GPC.RT.NNN.BIN IT USED BEFORE.
REM --------------------------------------------------------

REM ---- HD$, NOT HEX$: HEX$ IS A REAL X16 BASIC FUNCTION, SO BASLOAD
REM ---- TOKENISES IT AND THE COMPILER SEES A FUNCTION CALL WHERE A
REM ---- VARIABLE WAS MEANT -- SYNTAX ERROR, WITH NOTHING TO SAY WHY.
HD$ = "0123456789ABCDEF"
LF$ = CHR$(10)
CR$ = CHR$(13)

PRINT : PRINT
PRINT "GPC ERROR LOOKUP HELPER"
PRINT "TURN A RUNTIME ERROR @ $XXXX INTO A LINE #"
PRINT
GOSUB CLEAR.KB

REM ---- ASK FOR THE MAP FILE (BARE RETURN QUITS) ----
GP.DO
  PR$="MAP FILE (E.G. M.MYPROG): " : GOSUB READLINE
  GP.IF GP.ISEMPTY(NM$) THEN
    PRINT : PRINT "BYE" : END
  GP.ENDIF
  MP$=NM$
  GOSUB MAP.CHECK
  IF EX<>0 THEN GP.EXITDO
  PRINT "  NOT FOUND, TRY AGAIN"
GP.LOOP

PRINT
PRINT "NOW ENTER AN ERROR ADDRESS LIKE  $0030"
PRINT "(OR THE WHOLE ERROR LINE). RETURN QUITS."
PRINT

REM ---- LOOP: READ AN ADDRESS, LOOK IT UP ----
GP.DO
  PR$="ERROR ADDRESS: " : GOSUB READLINE
  GP.IF GP.ISEMPTY(NM$) THEN
    PRINT : PRINT "BYE" : END
  GP.ENDIF
  GOSUB PARSE.ADDR
  GP.IF PV<0 THEN
    PRINT "  NO HEX ADDRESS FOUND"
  GP.ELSE
    TG=PV : GOSUB SCAN : GOSUB REPORT
  GP.ENDIF
GP.LOOP

REM =====================================================================
REM SCAN: WALK THE MAP, KEEP THE LARGEST OFFSET <= TG.
REM   OUT: BO = BEST OFFSET (-1 IF NONE), BL = ITS BASIC LINE.
REM   THE MAP IS A SEQ FILE, LINES "HHHH DDDDD" ENDED BY LF ($0A).
REM   OPENED BY PLAIN NAME (PORTABLE); ADD ",S,R" ONLY IF A DOS NEEDS IT.
REM =====================================================================
SCAN:
  BO=-1 : BL=-1 : L$=""
  OPEN 2,8,2,MP$
  GP.DO
    GET#2,C$
    GP.IF C$=LF$ THEN
      GOSUB SC.LINE : L$=""
    GP.ELSEIF C$<>CR$ AND LEN(C$)>0 THEN
      L$=L$+C$
    GP.ENDIF
    GP.IF ST<>0 THEN
      GP.EXITDO
    GP.ENDIF
  GP.LOOP
  GP.IF LEN(L$)>0 THEN
    GOSUB SC.LINE
  GP.ENDIF
  CLOSE 2
  RETURN

SC.LINE:
  GP.IF LEN(L$)>=6 THEN
    H$=LEFT$(L$,4) : GOSUB HEXVAL : OF=HV
    LN=VAL(MID$(L$,6))
    GP.IF OF<=TG AND OF>BO THEN
      BO=OF : BL=LN
    GP.ENDIF
  GP.ENDIF
  RETURN

REM =====================================================================
REM REPORT: PRINT THE ANSWER FOR ADDRESS TG USING BO/BL.
REM   LINES 65024/65535 ARE THE COMPILER'S OWN SETUP CODE, NOT SOURCE.
REM =====================================================================
REPORT:
  PH=TG : PRINT "  $"; : GOSUB PHEX4
  GP.IF BO<0 THEN
    PRINT " IS BEFORE THE FIRST MAPPED LINE"
  GP.ELSEIF BL>=65024 THEN
    PRINT " IS IN COMPILER SETUP CODE, NOT A LINE"
  GP.ELSEIF BO=TG THEN
    PRINT " IS ON BASIC LINE ";BL
  GP.ELSE
    PRINT " IS ON/NEAR BASIC LINE ";BL
  GP.ENDIF
  RETURN

REM =====================================================================
REM PARSE.ADDR: NM$ -> PV (HEX VALUE) OR -1. TAKES THE TEXT AFTER THE
REM   LAST "$" IF PRESENT, THEN ITS LEADING HEX DIGITS.
REM   GP.INSTR WALKS THE "$"S FORWARD, AND GP.LTRIM/GP.UPPER DO THE
REM   SPACE SKIPPING AND CASE FOLDING THE OLD CHARACTER LOOP SPELLED OUT.
REM =====================================================================
PARSE.ADDR:
  PV=-1 : H$="" : LP=0
  GP.DO
    Q=GP.INSTR(NM$,"$",LP+1)
    IF Q=0 THEN GP.EXITDO
    LP=Q
  GP.LOOP
  REM ---- MID$ WHETHER OR NOT A "$" WAS FOUND, SO S$ IS ALWAYS A FRESH
  REM ---- STRING: GP.LTRIM AND GP.UPPER REWRITE IN PLACE, AND A PLAIN
  REM ---- S$=NM$ COULD LEAVE THE TWO SHARING BYTES -- WHICH WOULD EDIT
  REM ---- THE CALLER'S NM$ AS A SIDE EFFECT.
  S$=MID$(NM$,LP+1)
  GP.LTRIM S$
  GP.UPPER S$
  P=1
  GP.DO
    IF P>LEN(S$) THEN GP.EXITDO
    D$=MID$(S$,P,1)
    IF GP.INSTR(HD$,D$)=0 THEN GP.EXITDO
    H$=H$+D$ : P=P+1
  GP.LOOP
  GP.IF LEN(H$)>0 THEN
    GOSUB HEXVAL : PV=HV
  GP.ENDIF
  RETURN

REM =====================================================================
REM HEXVAL: H$ (HEX DIGITS) -> HV. GP.INSTR TURNS A DIGIT STRAIGHT INTO
REM   ITS VALUE, WHICH IS THE WHOLE OF THE ASC() ARITHMETIC THE OLD
REM   VERSION SPELLED OUT. THE GP.UPPER KEEPS THE OLD VERSION'S CONTRACT:
REM   BOTH CALLERS HAPPEN TO PASS UPPERCASE TODAY, BUT FOLDING HERE IS ONE
REM   CALL AND MEANS HEXVAL STILL TAKES HEX IN EITHER CASE.
REM =====================================================================
HEXVAL:
  HV=0
  GP.UPPER H$
  FOR I=1 TO LEN(H$)
    HV=HV*16+GP.INSTR(HD$,MID$(H$,I,1))-1
  NEXT
  RETURN

REM =====================================================================
REM PHEX4: PRINT PH (0..65535) AS 4 UPPERCASE HEX DIGITS, NO NEWLINE.
REM =====================================================================
PHEX4:
  N=PH
  A3=INT(N/4096) : N=N-A3*4096
  A2=INT(N/256)  : N=N-A2*256
  A1=INT(N/16)   : N=N-A1*16
  PRINT MID$(HD$,A3+1,1);MID$(HD$,A2+1,1);MID$(HD$,A1+1,1);MID$(HD$,N+1,1);
  RETURN

REM =====================================================================
REM MAP.CHECK: EX=1 IF MP$ EXISTS ON DEVICE 8, ELSE 0 (DOS ERR CHANNEL).
REM =====================================================================
MAP.CHECK:
  EX=0
  OPEN 15,8,15
  OPEN 2,8,2,MP$
  INPUT#15,EN,EM$,ET,ES
  CLOSE 2 : CLOSE 15
  GP.IF EN<20 THEN
    EX=1
  GP.ENDIF
  RETURN

REM =====================================================================
REM READLINE / CLEAR.KB: FROM GPC.BASL. RETURN ENDS; DEL($14) ERASES;
REM   PRINTABLE PETSCII KEPT; CONTROL IGNORED.
REM   THE INNER GP.DO IS THE KEY WAIT; ITS GP.EXITDO LEAVES ONLY THAT
REM   ONE, BECAUSE GP.EXITDO ALWAYS MEANS THE INNERMOST GP.DO.
REM =====================================================================
READLINE:
  PRINT PR$; : NM$=""
  GP.DO
    GP.DO
      GET K$
      GP.IF K$<>"" THEN
        GP.EXITDO
      GP.ENDIF
    GP.LOOP
    K=ASC(K$)
    GP.IF K=13 THEN
      PRINT
      GP.EXITDO
    GP.ELSEIF K=20 THEN
      GP.IF LEN(NM$)>0 THEN
        NM$=LEFT$(NM$,LEN(NM$)-1) : PRINT CHR$(20);
      GP.ENDIF
    GP.ELSEIF K>=32 AND (K<128 OR K>=160) AND LEN(NM$)<39 THEN
      NM$=NM$+K$ : PRINT K$;
    GP.ENDIF
  GP.LOOP
  RETURN

CLEAR.KB:
  GP.DO
    GET K$
    GP.IF GP.ISEMPTY(K$) THEN
      GP.EXITDO
    GP.ENDIF
  GP.LOOP
  RETURN
