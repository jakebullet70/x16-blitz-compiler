#SAVEAS "@:DEFFN1.SRC.PRG"
#REM 0
#INCLUDE "GPB.INC.BL"

## GP.FN, the marked half of the pair. DEFFN1C prints the same seven lines the long way.

GOTO F1.MAIN

## AREA(w,h) -- two formals and a numeric RETURNS.
GP.DEFPROC AREA, A.W, A.H RETURNS A.R : GOSUB AREA.BODY
RETURN
AREA.BODY:
A.R = A.W * A.H
RETURN

## TAG$(s$) -- a string formal and a string result.
GP.DEFPROC TAG, T.S$ RETURNS T.R$ : GOSUB TAG.BODY
RETURN
TAG.BODY:
T.R$ = "<" + T.S$ + ">"
RETURN

F1.MAIN:
PRINT "T1 "; GP.FN(AREA, 3, 4)
A = 100
PRINT "T2 "; A + GP.FN(AREA, 3, 4)
PRINT "T3 "; GP.FN(AREA, 2, GP.FN(AREA, 3, 4))
PRINT "T4 "; GP.FN(AREA, 2, 3) + GP.FN(AREA, 4, 5)
PRINT "T5 "; "X" + GP.FN(TAG, "AB") + "Y"
B$ = "Q"
PRINT "T6 "; B$ + GP.FN(TAG, B$ + "Z") + B$
FOR I = 1 TO 3
PRINT "T7 "; I; " "; GP.FN(AREA, I, I)
NEXT I
PRINT "Z9 DONE"
END
