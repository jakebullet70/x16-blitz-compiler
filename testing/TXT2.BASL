#SAVEAS "@:TXT2.SRC.PRG"
#REM 0
#INCLUDE "GPB.INC.BL"

## VERIFICATION ITEM 10: two text banks, a group in each.
##
## BOTH GROUPS START AT INDEX 0, because each bank has a flat list of its own -- so the slot in
## the top four bits of the constant is the ONLY thing telling the two call sites apart. Get the
## packing wrong and MENU.EDIT reads MENU.FILE's text and still prints something.

GP.BANKEDSTR 6 MENU.FILE
  " Open "
  " Save As... "
GP.ENDBANKEDSTR

GP.BANKEDSTR 7 MENU.EDIT
  " Cut "
  " Paste "
  " Copy "
GP.ENDBANKEDSTR

PRINT "T1 START"
FOR I = 0 TO GP.BSTRCOUNT(MENU.FILE) - 1
  PRINT "F|" + GP.BSTR(MENU.FILE, I) + "|"
NEXT I
FOR I = 0 TO GP.BSTRCOUNT(MENU.EDIT) - 1
  PRINT "E|" + GP.BSTR(MENU.EDIT, I) + "|"
NEXT I
PRINT "T2 END"
END
