#SAVEAS "@:BNK63.SRC.PRG"
#REM 0
#INCLUDE "GPB.INC.BL"

## REGIONS, one bank each from 1 up.  The COUNT is the whole test -- what each
## region does is deliberately trivial.  Every call selects its bank first: with
## several regions the bootstrap leaves the LAST one selected, and a call into
## any other lands on the wrong bytes at the same $A000.

PRINT "R0 BEFORE"
BANK 1 : GOSUB BK.0
BANK 2 : GOSUB BK.1
BANK 3 : GOSUB BK.2
BANK 4 : GOSUB BK.3
BANK 5 : GOSUB BK.4
BANK 6 : GOSUB BK.5
BANK 7 : GOSUB BK.6
BANK 8 : GOSUB BK.7
BANK 9 : GOSUB BK.8
BANK 10 : GOSUB BK.9
BANK 11 : GOSUB BK.10
BANK 12 : GOSUB BK.11
BANK 13 : GOSUB BK.12
BANK 14 : GOSUB BK.13
BANK 15 : GOSUB BK.14
BANK 16 : GOSUB BK.15
BANK 17 : GOSUB BK.16
BANK 18 : GOSUB BK.17
BANK 19 : GOSUB BK.18
BANK 20 : GOSUB BK.19
BANK 21 : GOSUB BK.20
BANK 22 : GOSUB BK.21
BANK 23 : GOSUB BK.22
BANK 24 : GOSUB BK.23
BANK 25 : GOSUB BK.24
BANK 26 : GOSUB BK.25
BANK 27 : GOSUB BK.26
BANK 28 : GOSUB BK.27
BANK 29 : GOSUB BK.28
BANK 30 : GOSUB BK.29
BANK 31 : GOSUB BK.30
BANK 32 : GOSUB BK.31
BANK 33 : GOSUB BK.32
BANK 34 : GOSUB BK.33
BANK 35 : GOSUB BK.34
BANK 36 : GOSUB BK.35
BANK 37 : GOSUB BK.36
BANK 38 : GOSUB BK.37
BANK 39 : GOSUB BK.38
BANK 40 : GOSUB BK.39
BANK 41 : GOSUB BK.40
BANK 42 : GOSUB BK.41
BANK 43 : GOSUB BK.42
BANK 44 : GOSUB BK.43
BANK 45 : GOSUB BK.44
BANK 46 : GOSUB BK.45
BANK 47 : GOSUB BK.46
BANK 48 : GOSUB BK.47
BANK 49 : GOSUB BK.48
BANK 50 : GOSUB BK.49
BANK 51 : GOSUB BK.50
BANK 52 : GOSUB BK.51
BANK 53 : GOSUB BK.52
BANK 54 : GOSUB BK.53
BANK 55 : GOSUB BK.54
BANK 56 : GOSUB BK.55
BANK 57 : GOSUB BK.56
BANK 58 : GOSUB BK.57
BANK 59 : GOSUB BK.58
BANK 60 : GOSUB BK.59
BANK 61 : GOSUB BK.60
BANK 62 : GOSUB BK.61
BANK 63 : GOSUB BK.62
PRINT "RZ AFTER"
END

GP.BANKED 1
BK.0:
    PRINT "R1 IN 1"
    RETURN
GP.ENDBANKED

GP.BANKED 2
BK.1:
    PRINT "R2 IN 2"
    RETURN
GP.ENDBANKED

