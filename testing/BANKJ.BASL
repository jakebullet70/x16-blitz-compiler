#SAVEAS "@:BANKJ.SRC.PRG"
#REM 0
#SYMFILE "@:BANKJ.SRC.SYM"
#INCLUDE "GPB.INC.BL"

BK.V% = 0
PRINT "J1 BEFORE"

GP.BANKED 5
DEF FN BK.SQ(BK.X) = BK.X * BK.X
#REM 1
GP.ASM
REM LDA #77
REM STA {BK.V%}
REM LDX #1
REM LDA #0
REM STA {BK.V%},X
GP.ENDASM
#REM 0
PRINT "J2 BLOB";BK.V%
GP.ENDBANKED

PRINT "J3 FN";FN BK.SQ(6)
#REM 1
GP.ASM
REM LDA #88
REM STA {BK.V%}
REM LDX #1
REM LDA #0
REM STA {BK.V%},X
GP.ENDASM
#REM 0
PRINT "J4 BLOB";BK.V%
END
