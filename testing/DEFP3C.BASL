#SAVEAS "@:DEFP3C.SRC.PRG"
#REM 0
#INCLUDE "GPB.INC.BL"

## DEFP3 written the long way -- the control -- DBBANK.INC.BL's whole front door, its names and its
## three sets of formals, with the bank shim reduced to a GOSUB. DEFP1 declared four, and
## the question this asks is whether twenty-one proc records still fit the variable list
## and still find each other. The declarations are folded onto the shims' first statement
## line, which is what DBBANK does, so none of them costs a byte.

GOTO D3.MAIN

## ---- the front door ----
DB.INIT:
    GOSUB DB.INIT.BODY
    RETURN

DB.SELECT:
    GOSUB DB.SELECT.BODY
    RETURN

DB.OPEN:
    GOSUB DB.OPEN.BODY
    RETURN

DB.CREATE:
    GOSUB DB.CREATE.BODY
    RETURN

DB.CLOSE:
    GOSUB DB.CLOSE.BODY
    RETURN

DB.CLOSEALL:
    GOSUB DB.CLOSEALL.BODY
    RETURN

DB.FIX:
    GOSUB DB.FIX.BODY
    RETURN

DB.GOTO:
    GOSUB DB.GOTO.BODY
    RETURN

DB.NEXT:
    GOSUB DB.NEXT.BODY
    RETURN

DB.PREV:
    GOSUB DB.PREV.BODY
    RETURN

DB.TOP:
    GOSUB DB.TOP.BODY
    RETURN

DB.BOTTOM:
    GOSUB DB.BOTTOM.BODY
    RETURN

DB.PUT:
    GOSUB DB.PUT.BODY
    RETURN

DB.NEW:
    GOSUB DB.NEW.BODY
    RETURN

DB.DEL:
    GOSUB DB.DEL.BODY
    RETURN

DB.UNDEL:
    GOSUB DB.UNDEL.BODY
    RETURN

DB.PACK:
    GOSUB DB.PACK.BODY
    RETURN

DB.ZAP:
    GOSUB DB.ZAP.BODY
    RETURN

DB.FIND:
    GOSUB DB.FIND.BODY
    RETURN

DB.FINDFLD:
    GOSUB DB.FINDFLD.BODY
    RETURN

DB.BLANK:
    GOSUB DB.BLANK.BODY
    RETURN

## ---- the bodies ----
DB.INIT.BODY:
    PRINT "V0"
    RETURN

DB.SELECT.BODY:
    PRINT "V1 " + STR$(DB.A)
    RETURN

DB.OPEN.BODY:
    PRINT "V2"
    RETURN

DB.CREATE.BODY:
    PRINT "V3"
    RETURN

DB.CLOSE.BODY:
    PRINT "V4"
    RETURN

DB.CLOSEALL.BODY:
    PRINT "V5"
    RETURN

DB.FIX.BODY:
    PRINT "V6"
    RETURN

DB.GOTO.BODY:
    PRINT "V7"
    RETURN

DB.NEXT.BODY:
    PRINT "V8"
    RETURN

DB.PREV.BODY:
    PRINT "V9"
    RETURN

DB.TOP.BODY:
    PRINT "V10"
    RETURN

DB.BOTTOM.BODY:
    PRINT "V11"
    RETURN

DB.PUT.BODY:
    PRINT "V12"
    RETURN

DB.NEW.BODY:
    PRINT "V13"
    RETURN

DB.DEL.BODY:
    PRINT "V14"
    RETURN

DB.UNDEL.BODY:
    PRINT "V15"
    RETURN

DB.PACK.BODY:
    PRINT "V16"
    RETURN

DB.ZAP.BODY:
    PRINT "V17"
    RETURN

DB.FIND.BODY:
    PRINT "V18 " + STR$(DB.F) + " " + DB.KEY$ + STR$(DB.EXACT)
    RETURN

DB.FINDFLD.BODY:
    PRINT "V19 " + DB.KEY$
    RETURN

DB.BLANK.BODY:
    PRINT "V20"
    RETURN

D3.MAIN:
PRINT "D1 START"
GOSUB DB.INIT
DB.A = 1 : GOSUB DB.SELECT
GOSUB DB.OPEN
GOSUB DB.CREATE
GOSUB DB.CLOSE
GOSUB DB.CLOSEALL
GOSUB DB.FIX
GOSUB DB.GOTO
GOSUB DB.NEXT
GOSUB DB.PREV
GOSUB DB.TOP
GOSUB DB.BOTTOM
GOSUB DB.PUT
GOSUB DB.NEW
GOSUB DB.DEL
GOSUB DB.UNDEL
GOSUB DB.PACK
GOSUB DB.ZAP
DB.F = 3 : DB.KEY$ = "ACME" : DB.EXACT = 0 - 1 : GOSUB DB.FIND
DB.KEY$ = "PRICE" : GOSUB DB.FINDFLD
GOSUB DB.BLANK
PRINT "D9 END"
END
