#SAVEAS "@:BANKB.SRC.PRG"
#REM 0
#SYMFILE "@:BANKB.SRC.SYM"
#INCLUDE "GPB.INC.BL"

PRINT "T1 BEFORE"
GOSUB BK.ONE
GOSUB BK.TWO
PRINT "T5 AFTER"
END

GP.BANKED 5
BK.ONE:
    PRINT "T2 ONE"
    RETURN
BK.TWO:
    PRINT "T3 TWO"
    GOSUB BK.THREE
    RETURN
GP.ENDBANKED

BK.THREE:
    PRINT "T4 THREE"
    RETURN
