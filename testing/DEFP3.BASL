#SAVEAS "@:DEFP3.SRC.PRG"
#REM 0
#INCLUDE "GPB.INC.BL"

## Twenty-one verbs in one program -- DBBANK.INC.BL's whole front door, its names and its
## three sets of formals, with the bank shim reduced to a GOSUB. DEFP1 declared four, and
## the question this asks is whether twenty-one proc records still fit the variable list
## and still find each other. The declarations are folded onto the shims' first statement
## line, which is what DBBANK does, so none of them costs a byte.

GOTO D3.MAIN

## ---- the front door ----
DB.INIT:
    GP.DEFPROC DBINIT : GOSUB DB.INIT.BODY
    RETURN

DB.SELECT:
    GP.DEFPROC DBSELECT, DB.A : GOSUB DB.SELECT.BODY
    RETURN

DB.OPEN:
    GP.DEFPROC DBOPEN : GOSUB DB.OPEN.BODY
    RETURN

DB.CREATE:
    GP.DEFPROC DBCREATE : GOSUB DB.CREATE.BODY
    RETURN

DB.CLOSE:
    GP.DEFPROC DBCLOSE : GOSUB DB.CLOSE.BODY
    RETURN

DB.CLOSEALL:
    GP.DEFPROC DBCLOSEALL : GOSUB DB.CLOSEALL.BODY
    RETURN

DB.FIX:
    GP.DEFPROC DBFIX : GOSUB DB.FIX.BODY
    RETURN

DB.GOTO:
    GP.DEFPROC DBGOTO : GOSUB DB.GOTO.BODY
    RETURN

DB.NEXT:
    GP.DEFPROC DBNEXT : GOSUB DB.NEXT.BODY
    RETURN

DB.PREV:
    GP.DEFPROC DBPREV : GOSUB DB.PREV.BODY
    RETURN

DB.TOP:
    GP.DEFPROC DBTOP : GOSUB DB.TOP.BODY
    RETURN

DB.BOTTOM:
    GP.DEFPROC DBBOTTOM : GOSUB DB.BOTTOM.BODY
    RETURN

DB.PUT:
    GP.DEFPROC DBPUT : GOSUB DB.PUT.BODY
    RETURN

DB.NEW:
    GP.DEFPROC DBNEW : GOSUB DB.NEW.BODY
    RETURN

DB.DEL:
    GP.DEFPROC DBDEL : GOSUB DB.DEL.BODY
    RETURN

DB.UNDEL:
    GP.DEFPROC DBUNDEL : GOSUB DB.UNDEL.BODY
    RETURN

DB.PACK:
    GP.DEFPROC DBPACK : GOSUB DB.PACK.BODY
    RETURN

DB.ZAP:
    GP.DEFPROC DBZAP : GOSUB DB.ZAP.BODY
    RETURN

DB.FIND:
    GP.DEFPROC DBFIND, DB.F, DB.KEY$, DB.EXACT : GOSUB DB.FIND.BODY
    RETURN

DB.FINDFLD:
    GP.DEFPROC DBFINDFLD, DB.KEY$ : GOSUB DB.FINDFLD.BODY
    RETURN

DB.BLANK:
    GP.DEFPROC DBBLANK : GOSUB DB.BLANK.BODY
    RETURN

## ---- the bodies ----
DB.INIT.BODY:
    PRINT "V0"
    RETURN

DB.SELECT.BODY:
    PRINT "V1 " + STR$(DB.A)
    RETURN

DB.OPEN.BODY:
    PRINT "V2"
    RETURN

DB.CREATE.BODY:
    PRINT "V3"
    RETURN

DB.CLOSE.BODY:
    PRINT "V4"
    RETURN

DB.CLOSEALL.BODY:
    PRINT "V5"
    RETURN

DB.FIX.BODY:
    PRINT "V6"
    RETURN

DB.GOTO.BODY:
    PRINT "V7"
    RETURN

DB.NEXT.BODY:
    PRINT "V8"
    RETURN

DB.PREV.BODY:
    PRINT "V9"
    RETURN

DB.TOP.BODY:
    PRINT "V10"
    RETURN

DB.BOTTOM.BODY:
    PRINT "V11"
    RETURN

DB.PUT.BODY:
    PRINT "V12"
    RETURN

DB.NEW.BODY:
    PRINT "V13"
    RETURN

DB.DEL.BODY:
    PRINT "V14"
    RETURN

DB.UNDEL.BODY:
    PRINT "V15"
    RETURN

DB.PACK.BODY:
    PRINT "V16"
    RETURN

DB.ZAP.BODY:
    PRINT "V17"
    RETURN

DB.FIND.BODY:
    PRINT "V18 " + STR$(DB.F) + " " + DB.KEY$ + STR$(DB.EXACT)
    RETURN

DB.FINDFLD.BODY:
    PRINT "V19 " + DB.KEY$
    RETURN

DB.BLANK.BODY:
    PRINT "V20"
    RETURN

D3.MAIN:
PRINT "D1 START"
GP.SUB DBINIT
GP.SUB DBSELECT, 1
GP.SUB DBOPEN
GP.SUB DBCREATE
GP.SUB DBCLOSE
GP.SUB DBCLOSEALL
GP.SUB DBFIX
GP.SUB DBGOTO
GP.SUB DBNEXT
GP.SUB DBPREV
GP.SUB DBTOP
GP.SUB DBBOTTOM
GP.SUB DBPUT
GP.SUB DBNEW
GP.SUB DBDEL
GP.SUB DBUNDEL
GP.SUB DBPACK
GP.SUB DBZAP
GP.SUB DBFIND, 3, "ACME", 0 - 1
GP.SUB DBFINDFLD, "PRICE"
GP.SUB DBBLANK
PRINT "D9 END"
END
