#SAVEAS "@:DEFFN1C.SRC.PRG"
#REM 0
#INCLUDE "GPB.INC.BL"

## The control for DEFFN1, written the way a programmer would before GP.FN existed.

GOTO F1.MAIN

AREA.BODY:
A.R = A.W * A.H
RETURN

TAG.BODY:
T.R$ = "<" + T.S$ + ">"
RETURN

F1.MAIN:
A.W = 3 : A.H = 4 : GOSUB AREA.BODY
PRINT "T1 "; A.R
A = 100
A.W = 3 : A.H = 4 : GOSUB AREA.BODY
PRINT "T2 "; A + A.R
A.W = 3 : A.H = 4 : GOSUB AREA.BODY
C1 = A.R
A.W = 2 : A.H = C1 : GOSUB AREA.BODY
PRINT "T3 "; A.R
A.W = 2 : A.H = 3 : GOSUB AREA.BODY
C1 = A.R
A.W = 4 : A.H = 5 : GOSUB AREA.BODY
PRINT "T4 "; C1 + A.R
T.S$ = "AB" : GOSUB TAG.BODY
PRINT "T5 "; "X" + T.R$ + "Y"
B$ = "Q"
T.S$ = B$ + "Z" : GOSUB TAG.BODY
PRINT "T6 "; B$ + T.R$ + B$
FOR I = 1 TO 3
A.W = I : A.H = I : GOSUB AREA.BODY
PRINT "T7 "; I; " "; A.R
NEXT I
PRINT "Z9 DONE"
END
