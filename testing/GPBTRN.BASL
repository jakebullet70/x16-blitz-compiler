#SAVEAS "@:GPBTRN.SRC.PRG"
#SYMFILE "@:GPBTRN.SRC.SYM"
#INCLUDE "GPB.INC.BL"
#INCLUDE "BANKMGR.INC.BL"
#INCLUDE "APPSYS.INC.BL"
#INCLUDE "STASH.INC.BL"
#INCLUDE "LIBBANK.INC.BL"

GOTO TR.LIBEND
GP.BANKED LIB.CODEBANK
#INCLUDE "THEME.INC.BL"
#INCLUDE "MENUVERT.INC.BL"
#INCLUDE "MENUBAR.INC.BL"
#INCLUDE "LINEINPUT.INC.BL"
#INCLUDE "GUI.INC.BL"
#INCLUDE "GUI2.INC.BL"
GP.ENDBANKED
TR.LIBEND:

## GPBTRN -- the two renames, through the banked shims. GUI.TEXT is GUI.INPUT
## and the string it edits is GUI.TEXT$; THEME.LOAD is THEME.SELECT. Keys go in
## through kbdbuf_put, because paste cannot drive a program sitting in a GET loop.
##
## IT NEEDS THE RENAMED MODULES BESIDE IT. Only samples/GPB-MODS-TESTING/GPC-BASIC/
## carries them today -- the root library still says GUI.TEXT and THEME.LOAD -- so
## copy that folder in before building this, or BASLOAD stops on LABEL NOT FOUND.

#DEFINE KBDBUF.PUT $F09F

DIM MENUVERT.ITEM$(32)

GOSUB APPSYS.STARTUP
SCREEN 1
GP.CALL APPSYS.SCRMODE, 0, 0, 0, 1
APPSYS.COLS = GP.X : APPSYS.ROWS = GP.Y

THEME.ID = 0 : GOSUB THEME.SELECT
TR.T1 = THEME.CLR(THEME.PAGE)

GOSUB BANKMGR.INIT
BANKMGR.WANT = LIB.CODEBANK : GOSUB BANKMGR.CLAIM
GOSUB BANKMGR.ALLOC
TR.BANK = BANKMGR.BANK

## ---- 1. THEME.SELECT picks a palette, and THEME.NEXT falls into it
THEME.ID = 1 : GOSUB THEME.SELECT
TR.T2 = THEME.CLR(THEME.PAGE)
GOSUB THEME.NEXT
TR.T3 = THEME.ID
THEME.ID = 0 : GOSUB THEME.SELECT

## ---- 2. GUI.INPUT edits GUI.TEXT$ in place. RETURN takes what is there.
GUI.BANK = TR.BANK
GUI.MSG$ = "TYPE A NAME." : GUI.MSG2$ = "" : GUI.TITLE$ = " GUI.INPUT " : GUI.HINT$ = ""
GUI.STYLE = 0 : GUI.GLYPH = 0 : GUI.PLACE = 0 : GUI.X = 0 : GUI.Y = 0
GUI.ROW.OFFSET = 0 : GUI.PANEL.IN = 0 : GUI.BORDER.IN = 0 : GUI.OKCANCEL = 0
GUI.LEN = 20 : GUI.MASK = 0 : GUI.FLAGS = 0 : GUI.SEL = 0 : GUI.COUNT = 0
GUI.TEXT$ = "GPC"
TR.KEY = 13 : GOSUB TR.SEND
GOSUB GUI.INPUT
TR.SAID$ = GUI.TEXT$
TR.OK = GUI.OK

## ---- 3. ESC puts the old text back, and it is GUI.TEXT$ that comes back
GUI.TEXT$ = "KEEP ME"
GUI.TITLE$ = " CANCELLED "
TR.KEY = ASC("X") : GOSUB TR.SEND
TR.KEY = 27 : GOSUB TR.SEND
GOSUB GUI.INPUT
TR.BACK$ = GUI.TEXT$
TR.NOTOK = GUI.OK

GOSUB APPSYS.RESTORE

PRINT "T1 PAGE"; TR.T1; " T2 PAGE"; TR.T2; " T3 ID"; TR.T3
PRINT "T4 ["; TR.SAID$; "] OK"; TR.OK
PRINT "T5 ["; TR.BACK$; "] OK"; TR.NOTOK
PRINT "DONE"
END

TR.SEND:
  POKE 1,0 : GP.CALL KBDBUF.PUT, TR.KEY : POKE 1,4
  RETURN
