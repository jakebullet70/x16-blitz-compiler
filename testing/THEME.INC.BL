## ***********************************************************************
## **
## **  THEME.INC.BL -- named colour roles, light and dark.
## **
## **  A theme costs NO TOKENS AND NO RUNTIME BYTES, and that is the whole
## **  point. Theme colours are read by BASIC, for COLOR and for the GP
## **  drawing commands -- assembly never touches them -- so putting them
## **  in the runtime would have bought nothing and spent two keywords.
## **  As data they are also savable and loadable like any other array,
## **  so "switch to dark" is reloading an array, not invoking a command.
## **
## **  #DEFINE substitutes at TRANSLATION time (BASLOAD.MD:313), so
## **  THEME.C(THEME.TITLE) compiles to THEME.C(2) -- the name costs
## **  nothing at all: no variable, no lookup, and the index is a one byte
## **  short constant.
## **
## **  Usage:
## **      THEME.DARK = 1 : GOSUB THEME.LOAD
## **      GP.BOX 4,2,30,8, 2, THEME.C(THEME.BORDER)
## **      GP.PRINTAT 6,3, "TITLE", THEME.C(THEME.TITLE)
## **
## **  THE VALUES ARE PACKED ATTRIBUTES -- background * 16 + foreground --
## **  because that is exactly what GP.BOX, GP.FILL and GP.PRINTAT take,
## **  and it is the same packing the KERNAL keeps at $0376. For COLOR,
## **  which wants the two halves separately, use THEME.SET.
## **
## ***********************************************************************
#IFNDEF THEME.DEFS
#DEFINE THEME.DEFS 1

## The roles. Add one here and to BOTH palettes below, and raise SLOTS.

#DEFINE THEME.PAGE 0
#DEFINE THEME.TEXT 1
#DEFINE THEME.TITLE 2
#DEFINE THEME.BORDER 3
#DEFINE THEME.HILITE 4
#DEFINE THEME.DIMMED 5
#DEFINE THEME.WARN 6
#DEFINE THEME.SLOTS 7

## X16 palette indices, for reading the tables below.
##   0 black    1 white   2 red     3 cyan     4 purple  5 green
##   6 blue     7 yellow  8 orange  9 brown   10 pink   11 dk grey
##  12 md grey 13 lt green 14 lt blue 15 lt grey

GOTO THEME.SKIP

## THEME.LOAD -- fill THEME.C from THEME.DARK (0 light, non-zero dark).
##
## THEME.C is deliberately DIMmed here rather than left to GPC's implicit
## DIM: an implicit array is 0..10, and DIMming one GPC has already
## auto-dimensioned is an error -- so the module has to own it outright.
##
## No DATA statement, on purpose. READ walks every DATA in the whole
## program in order, so a library owning one would silently derail the
## caller's own READs. The same reason STRHELP.PET2SCR is a compare chain.

THEME.LOAD:
    IF THEME.READY = 0 THEN DIM THEME.C(THEME.SLOTS) : THEME.READY = 1
    IF THEME.DARK <> 0 THEN GOTO THEME.LOAD.DARK

    THEME.C(THEME.PAGE)   = 6 * 16 + 6
    THEME.C(THEME.TEXT)   = 6 * 16 + 1
    THEME.C(THEME.TITLE)  = 6 * 16 + 7
    THEME.C(THEME.BORDER) = 6 * 16 + 14
    THEME.C(THEME.HILITE) = 1 * 16 + 6
    THEME.C(THEME.DIMMED) = 6 * 16 + 12
    THEME.C(THEME.WARN)   = 6 * 16 + 2
    RETURN

THEME.LOAD.DARK:
    THEME.C(THEME.PAGE)   = 0 * 16 + 0
    THEME.C(THEME.TEXT)   = 0 * 16 + 15
    THEME.C(THEME.TITLE)  = 0 * 16 + 1
    THEME.C(THEME.BORDER) = 0 * 16 + 11
    THEME.C(THEME.HILITE) = 15 * 16 + 0
    THEME.C(THEME.DIMMED) = 0 * 16 + 12
    THEME.C(THEME.WARN)   = 0 * 16 + 8
    RETURN

## THEME.SET -- make THEME.ROLE the colour PRINT uses.
##
##   in   THEME.ROLE   a packed attribute, e.g. THEME.C(THEME.TEXT)
##
## Splits it for COLOR, which takes foreground and background separately.
## INT(x/16), not a shift, and AND 15 is safe here only because a packed
## attribute is 0..255 -- AND is 16 bit SIGNED in GPC, so it raises OUT OF
## RANGE above 32767. See GP.STRPTR for where that actually bites.

THEME.SET:
    COLOR THEME.ROLE AND 15, INT(THEME.ROLE / 16)
    RETURN

## THEME.HI -- the inverse of a packed attribute, which is what GP.MENU
## does to highlight a row. Handy when you want to pre-draw a row already
## looking selected, so it matches what GP.MENU will produce.
##
##   in   THEME.ROLE   packed attribute      out  THEME.INV

THEME.HI:
    THEME.INV = (THEME.ROLE AND 15) * 16 + INT(THEME.ROLE / 16)
    RETURN

THEME.SKIP:
#ENDIF
