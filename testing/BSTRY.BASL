#SAVEAS "@:BSTRY.SRC.PRG"
#REM 0
#INCLUDE "GPB.INC.BL"

## The same collision the other way round -- the region first, the text after it.  The
## check cannot live at either keyword for that reason: whichever comes second is the
## only one that can see the first.

PRINT "Y1 BEFORE"

GP.BANKED 5
PRINT "Y2 IN"
GP.ENDBANKED

GP.BANKEDSTR 5 G.ONE
  " Open "
  " Save "
GP.ENDBANKEDSTR

PRINT "Y3 " + GP.BSTR(G.ONE, 0)
END
