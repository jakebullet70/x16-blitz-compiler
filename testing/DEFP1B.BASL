#SAVEAS "@:DEFP1B.SRC.PRG"
#REM 0
#INCLUDE "GPB.INC.BL"

## DEFP1 again, with each declaration FOLDED ONTO THE SHIM'S OWN LINE rather than put on a
## line of its own. A BASIC line costs one byte of p-code -- its new.line marker -- and a bare
## label is not a BASIC line, so this is the spelling that adds no line and therefore no byte.
## It has to come out exactly as long as DEFP1C.

GOTO DP.MAIN

DP.HELLO: GP.DEFPROC HELLO : PRINT "D2 HELLO"
RETURN

DP.SHOUT: GP.DEFPROC SHOUT, DP.S$ : PRINT "D3 " + DP.S$
RETURN

DP.TWICE: GP.DEFPROC TWICE, DP.N : PRINT "D4 " + STR$(DP.N * 2)
RETURN

DP.REPORT: GP.DEFPROC REPORT, DP.A$, DP.M, DP.B$ : PRINT "D5 " + DP.A$ + STR$(DP.M) + " " + DP.B$
RETURN

DP.MAIN:
PRINT "D1 START"
GP.SUB HELLO
GP.SUB SHOUT, "ONE"
GP.SUB TWICE, 7
GP.SUB TWICE, 20
GP.SUB REPORT, "R", 3, "X"
GOSUB DP.SHOUT
PRINT "D9 END"
END
