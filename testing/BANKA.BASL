#SAVEAS "@:BANKA.SRC.PRG"
#REM 0
#SYMFILE "@:BANKA.SRC.SYM"
#INCLUDE "GPB.INC.BL"

PRINT "T1 BEFORE"
BK.N = 0

GP.BANKED 5
PRINT "T2 IN"
FOR BK.I = 1 TO 4
    BK.N = BK.N + BK.I
NEXT BK.I
PRINT "T3 SUM";BK.N
GOSUB BK.OUT
GP.ENDBANKED

PRINT "T5 AFTER";BK.N
END

BK.OUT:
    PRINT "T4 OUT"
    RETURN
