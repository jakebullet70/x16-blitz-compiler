#SAVEAS "@:DEFP2.SRC.PRG"
#REM 0
#INCLUDE "GPB.INC.BL"

## The declaration binds to a LOW memory shim and the body is at $A000 in bank 5, which is
## LIBBANK.INC.BL's shape with one line taken off every call site. SAY goes the other way --
## a GP.SUB INSIDE the region calling low memory -- so the call operand has to be corrected
## in both directions.

GOTO DP.MAIN

GP.DEFPROC PUTLINE, DP.T$, DP.N
DP.PUT:  BANK 5 : GOSUB DP.PUT.BODY : RETURN

GP.DEFPROC SAY, DP.W$
DP.SAY:
PRINT "P" + DP.W$
RETURN

GP.BANKED 5
DP.PUT.BODY:
GP.SUB SAY, "3 IN BANK " + DP.T$
PRINT "P4 N=" + STR$(DP.N)
RETURN
GP.ENDBANKED

DP.MAIN:
PRINT "P1 START"
GP.SUB PUTLINE, "A", 1
GP.SUB PUTLINE, "B", 2
PRINT "P9 END"
END
