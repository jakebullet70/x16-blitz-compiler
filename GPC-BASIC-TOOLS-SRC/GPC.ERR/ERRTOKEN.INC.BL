## ***********************************************************************
## **  ERRTOKEN.INC.BL -- BASIC keyword text, one string a token number.
## **
## **  GENERATED by source/gpc/gen_err_tokens.py out of the #TOKEN lines in
## **  GPC-BASIC/GPB.INC.BL and the stock tables in
## **  source/common-scripts/c64tokens.py. An edit here is lost on the next run.
## **
## **      ERR.TOKEN.PLAIN     a single byte token, index = byte - ERR.PLAIN.FIRST
## **      ERR.TOKEN.SHIFTED   a $CE pair, index = second byte - ERR.SHIFTED.FIRST
## **
## **  A slot no keyword uses is an empty string, which is what tells an unknown
## **  token from a real one. An index outside a group reads the next group's text,
## **  so a caller range checks the byte against BASE and TOP first.
## **
## **  Claim ERR.TOKENBANK before the first GP.BSTR.
## ***********************************************************************
#IFNDEF ERR.TOKENBANK
#DEFINE ERR.TOKENBANK 61
#ENDIF

#DEFINE ERR.PLAIN.FIRST 128
#DEFINE ERR.PLAIN.LAST 255
#DEFINE ERR.SHIFTED.FIRST 77
#DEFINE ERR.SHIFTED.LAST 222

GP.BANKEDSTR ERR.TOKENBANK ERR.TOKEN.PLAIN
  "END"
