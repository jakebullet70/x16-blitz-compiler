## ***********************************************************************
## **
## **  MANDEL.BASL -- the Mandelbrot set on the 40x30 text screen, timed.
## **
## **  Plain X16 BASIC, no GP keywords. The tokenised MANDEL.SRC.PRG runs
## **  in ROM BASIC, and GPC compiles the same file to MANDEL.PRG. A cell's
## **  background colour is the count of iterations it took to escape.
## **  Black cells never escaped. MANDELASM.BASL is the GP.ASM version.
## **
## ***********************************************************************

#SAVEAS "@:MANDEL.SRC.PRG"

## The first statement must not be a SYS. GPC's stub starts SYS 2069, so the
## token at $0805 tells a compiled run from an interpreted one.
MANDEL.COMPILED = PEEK($0805) = $9E
MANDEL.RUNNER$ = "ROM BASIC"
IF MANDEL.COMPILED THEN MANDEL.RUNNER$ = "GPC COMPILED"

## What APPSYS.STARTUP saves, in plain BASIC. screen_mode with the carry set
## reports the mode in A. ROM BASIC and GPC both pass registers at 780-783.
POKE 783, 1
SYS $FF5F
MANDEL.SAVED.MODE = PEEK(780)
MANDEL.SAVED.COLOUR = PEEK($0376)
MANDEL.SAVED.CHARSET = PEEK($0372)

SCREEN 3
MANDEL.COLUMNS = 40
MANDEL.ROWS = 28
MANDEL.MOST.ITERATIONS = 32
MANDEL.REAL.LEFT = -2.2
MANDEL.REAL.STEP = 3 / MANDEL.COLUMNS
MANDEL.IMAGINARY.TOP = -1.05
MANDEL.IMAGINARY.STEP = 2.1 / MANDEL.ROWS

## Layer 1's map: L1_MAPBASE holds address bits 16-9, L1_CONFIG bits 4-5 the width.
MANDEL.CELL.ADDRESS = PEEK($9F35) * 512
MANDEL.MAP.BANK = INT(MANDEL.CELL.ADDRESS / 65536)
MANDEL.MAP.ADDRESS = MANDEL.CELL.ADDRESS - MANDEL.MAP.BANK * 65536
MANDEL.ROW.BYTES = 64 * 2 ^ ((PEEK($9F34) / 16) AND 3)

DIM MANDEL.PALETTE(12)
FOR MANDEL.COUNT = 0 TO 12
    READ MANDEL.PALETTE(MANDEL.COUNT)
NEXT
DATA 6,14,3,13,5,7,8,2,10,4,12,15,1

## A colour byte per count, background in the high nibble. Index MOST.ITERATIONS stays 0, black.
DIM MANDEL.SHADE(MANDEL.MOST.ITERATIONS)
FOR MANDEL.COUNT = 0 TO MANDEL.MOST.ITERATIONS - 1
    MANDEL.SHADE(MANDEL.COUNT) = 16 * MANDEL.PALETTE(MANDEL.COUNT - 13 * INT(MANDEL.COUNT / 13))
NEXT

PRINT
PRINT " MANDELBROT SPEED DUEL"
PRINT
PRINT MANDEL.COLUMNS; "X"; MANDEL.ROWS; "CELLS, UP TO"; MANDEL.MOST.ITERATIONS; "ITERATIONS."
PRINT " ONE PICTURE, THREE WAYS TO RUN IT:"
PRINT
PRINT "   MANDEL.SRC.PRG   ROM BASIC"
PRINT "   MANDEL.PRG       GPC COMPILED"
PRINT "   MANDELASM.PRG    GPC + GP.ASM"
PRINT
PRINT " THIS RUN: "; MANDEL.RUNNER$
PRINT
PRINT " PRESS A KEY TO START."
GOSUB MANDEL.WAIT.KEY
CLS

MANDEL.START.TIME = TI
FOR MANDEL.ROW = 0 TO MANDEL.ROWS - 1
    MANDEL.C.IMAGINARY = MANDEL.IMAGINARY.TOP + MANDEL.ROW * MANDEL.IMAGINARY.STEP
    MANDEL.CELL.ADDRESS = MANDEL.MAP.ADDRESS + MANDEL.ROW * MANDEL.ROW.BYTES + 1
    FOR MANDEL.COLUMN = 0 TO MANDEL.COLUMNS - 1
        MANDEL.C.REAL = MANDEL.REAL.LEFT + MANDEL.COLUMN * MANDEL.REAL.STEP
        MANDEL.Z.REAL = 0
        MANDEL.Z.IMAGINARY = 0
        MANDEL.COUNT = 0
MANDEL.ITERATE:
        MANDEL.REAL.SQUARED = MANDEL.Z.REAL * MANDEL.Z.REAL
        MANDEL.IMAGINARY.SQUARED = MANDEL.Z.IMAGINARY * MANDEL.Z.IMAGINARY
        IF MANDEL.REAL.SQUARED + MANDEL.IMAGINARY.SQUARED > 4 THEN GOTO MANDEL.PAINT
        MANDEL.Z.IMAGINARY = 2 * MANDEL.Z.REAL * MANDEL.Z.IMAGINARY + MANDEL.C.IMAGINARY
        MANDEL.Z.REAL = MANDEL.REAL.SQUARED - MANDEL.IMAGINARY.SQUARED + MANDEL.C.REAL
        MANDEL.COUNT = MANDEL.COUNT + 1
        IF MANDEL.COUNT < MANDEL.MOST.ITERATIONS THEN GOTO MANDEL.ITERATE
MANDEL.PAINT:
        VPOKE MANDEL.MAP.BANK, MANDEL.CELL.ADDRESS, MANDEL.SHADE(MANDEL.COUNT)
        MANDEL.CELL.ADDRESS = MANDEL.CELL.ADDRESS + 2
    NEXT
NEXT
MANDEL.JIFFIES = TI - MANDEL.START.TIME

LOCATE 29, 1
PRINT MANDEL.RUNNER$; ":"; MANDEL.JIFFIES; "JIFFIES ="; INT(MANDEL.JIFFIES / 6 + 0.5) / 10; "S";
LOCATE 30, 1
PRINT "PRESS A KEY TO EXIT.";
GOSUB MANDEL.WAIT.KEY

## What APPSYS.RESTORE puts back. COLOR goes first: the mode change clears
## the screen in the colour already selected.
COLOR MANDEL.SAVED.COLOUR AND 15, INT(MANDEL.SAVED.COLOUR / 16)
SCREEN MANDEL.SAVED.MODE
POKE 780, MANDEL.SAVED.CHARSET AND 63
SYS $FF62
POKE $0372, MANDEL.SAVED.CHARSET
END

MANDEL.WAIT.KEY:
GET MANDEL.KEY$
IF MANDEL.KEY$ = "" THEN GOTO MANDEL.WAIT.KEY
RETURN
