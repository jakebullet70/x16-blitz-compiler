#SAVEAS "@:GPC.HELP.SRC.PRG"
#SYMFILE "@:GPC.HELP.SRC.SYM"
## The three code regions. HELP.BOOT claims each through BANKMGR. They are
## #DEFINEd above the GP.BANKED lines because BASLOAD resolves a #DEFINE only
## once it has read it, and GP.BANKED takes a decimal constant.
#DEFINE HELP.LIBCODE 11
#DEFINE HELP.GUICODE 12
#DEFINE HELP.DLGCODE 13

## ---- what stays in low memory ----
## GPB.INC.BL is declarations. STASH executes BANK, which a region may not.
## STRCASE is a GP.ASM blob. APPSYS runs before the regions are claimed.
#INCLUDE "GPC-BASIC/GPB.INC.BL"
#INCLUDE "GPC-BASIC/STASH.INC.BL"
#INCLUDE "GPC-BASIC/STRCASE.INC.BL"
#INCLUDE "GPC-BASIC/APPSYS.INC.BL"

## ---- the library modules run from a RAM bank ----
## Each is its ordinary .INC.BL file between GP.BANKED and GP.ENDBANKED and
## nothing else: a call in from outside selects the region's bank and RETURN
## puts the caller's back. GPC-BASIC/BANKED-OR-NOT.md has the rules.
##
## The GOTO jumps the region. A GOTO into one is refused, so the bridge
## GP.BANKED leaves is the only way to fall past it, and that works at program
## start only.
##
## Order is not free. THEME is first because everything below reads its role
## numbers, which are #DEFINEs. MENU.INC.BANKED.BL is above MENU, which is the
## store it declares.
GOTO HELP.LIBEND
GP.BANKED HELP.LIBCODE
#INCLUDE "GPC-BASIC/THEME.INC.BL"
#INCLUDE "GPC-BASIC/BANKMGR.INC.BL"
#INCLUDE "GPC-BASIC/MENU.INC.BANKED.BL"
#INCLUDE "GPC-BASIC/MENU.INC.BL"
GP.ENDBANKED
HELP.LIBEND:

## ---- the dialogs take two more regions ----
## A region is 8,192 bytes and the engine and the verbs over it do not fit in
## one. GP.BANKED REGION OVER 8K is what the compiler says when they are put in
## one anyway.
##
## The engine is the first region. LINEINPUT is the field, GUI.INC.BL the box
## and the form loop over it.
##
## The controls and the verbs are the second. COMBO and CHECK are included
## whether or not a form has one of them, because GUI.INC.BL names their
## painters and a name with no module behind it does not compile.
##
## STASH stays in low memory above: GUI.OPEN saves the cells a box covers
## through it, and the call out of the region is what makes that legal.
GOTO HELP.GUIEND
GP.BANKED HELP.GUICODE
#INCLUDE "GPC-BASIC/LINEINPUT.INC.BL"
#INCLUDE "GPC-BASIC/GUI.INC.BL"
GP.ENDBANKED
GP.BANKED HELP.DLGCODE
#INCLUDE "GPC-BASIC/COMBO.INC.BL"
#INCLUDE "GPC-BASIC/CHECK.INC.BL"
#INCLUDE "GPC-BASIC/GUI-DIALOGS.INC.BL"
GP.ENDBANKED
HELP.GUIEND:

## ============================================================================
## GPC.HELP.BASL -- the GP.BASIC and BASL reference, on the machine.
##
## The index loads once at startup. A topic is read once into the banks, its
## line table into HELP.TBANK and its text into the banks from HELP.TEXTBANK.
## Every scroll after that paints one row out of them.
##
## An index row can also name an example program in the GPC-BASIC folder. That
## file is read as it stands and painted in syntax colour: see HELP.SRC.LOAD.
##
## The content is HELP-TXT/ beside the program: GPC.HELP.IDX and one .HLP per
## topic, built by MKHELP.PY from GPC-BASIC/. Nothing here parses markdown,
## measures a string or wraps a line.
##
## .HLP line format, a marker character then the text:
##      @  the topic record: line 1, and its title
##      =  section header, drawn as a full width bar
##      .  text, already wrapped        :  code, dimmed, what "export" writes
##      >  cross reference, ">index row|text"
##
## CP437 (charset 7) with bit 6 of $0372 set, 80x30. Labels and variables are
## both HELP.*: BASL files them in one symbol table.
##
## WARNING: do not add #AUTONUM. The default step of 1 is the only one
## STRCASE.INC.BL survives. At any other step its label jumps resolve to lines
## that were never generated and GPC stops with UNKNOWN LINE NUMBER.
## ============================================================================

## The index bank holds 210 records and 6,302 characters of text, and rows
## past either limit are dropped. Change MKHELP.PY's IDX_ROWS with it.
#DEFINE HELP.MAXIX 210

## Cross references in one topic, and the deepest chain of them ESC can walk
## back along. The largest topic carries 12.
#DEFINE HELP.MAXPICK 20
#DEFINE HELP.MAXBACK 12

## A spare RAM bank for the cells a dialog covers. Bank 0 holds the KERNAL's
## keyboard layout, so anything above it will do.
#DEFINE HELP.BANK 8

#DEFINE HELP.TBANK 9

## The topic text, in eight banks from 15. A line never straddles two.
#DEFINE HELP.TEXTBANK 15
#DEFINE HELP.TEXTBANKS 8

## The index bank. Records at the front, nine bytes each: text offset lo and
## hi, length, type, topic, section line lo and hi, topic length lo and hi. The
## text sits above them, row N at HELP.IWIN + (N - 1) * 9.
#DEFINE HELP.IBANK 10
#DEFINE HELP.IWIN $A000
#DEFINE HELP.IXREC 9
#DEFINE HELP.IXWIDE 72
#DEFINE HELP.WIN $A000
#DEFINE HELP.BANKSIZE 8192
#DEFINE HELP.MAXLINES 2048

## The line table fills HELP.TBANK, four bytes a line: offset low, offset high,
## length, kind. Line N is at (N-1)*4. The offset is into the line's text bank,
## and the kind byte carries which one: kind + 16 * (bank - HELP.TEXTBANK).
## WARNING: do not move this to arrays. The workspace cannot hold three DIMs of
## HELP.MAXLINES, and OUT OF MEMORY is what it raises.
#DEFINE HELP.RECSIZE 4
#DEFINE HELP.KINDBANK 16

## The kinds past the .HLP markers: a line of an example program, and one of
## them inside its GP.ASM block.
#DEFINE HELP.KIND.SOURCE 4
#DEFINE HELP.KIND.ASMLINE 5

## The index row type of an example program. 1 is a topic and 2 a section.
#DEFINE HELP.IX.EXAMPLE 3

## The keyword table, and above it what the source painter works in: seven inks
## from HELP.SYN.INKTABLE, the line at $BE00 and a class a column at $BF00.
## HELP.SRC.SCAN and HELP.SRC.PAINT spell the three addresses out, so change
## them there as well.
#DEFINE HELP.KEYBANK 23
#DEFINE HELP.SYN.INKTABLE $BDF0

## A source line is stored whole, up to HELP.SRC.MAXWIDE. LEFT and RIGHT move
## HELP.SRC.STEP columns. HELP.SRC.LEFTCAP is the furthest the left edge goes:
## the painter counts columns in one byte, and 176 + 79 is 255.
#DEFINE HELP.SRC.MAXWIDE 250
#DEFINE HELP.SRC.STEP 8
#DEFINE HELP.SRC.LEFTCAP 176

## VERA and the KERNAL, for HELP.PAGE.SHIFT. A #DEFINE takes a signed int16, so
## an address is written in hex, and it refuses a digit anywhere in the name, so
## the second data port is .B.
#DEFINE HELPK.MEMCOPY $FEE7
#DEFINE HELPK.VCTRL $9F25
#DEFINE HELPK.VLO $9F20
#DEFINE HELPK.VMID $9F21
#DEFINE HELPK.VHI $9F22
#DEFINE HELPK.LCONFIG $9F34
#DEFINE HELPK.LMAPBASE $9F35

## $9F23 and $9F24, VERA's two data ports, split into the bytes the 16-bit ABI
## registers want.
#DEFINE HELPK.PORTLO 35
#DEFINE HELPK.PORTLO.B 36
#DEFINE HELPK.PORTHI 159

## ADDRH: bank in bit 0, DECR in bit 3, auto-increment in the top nibble. 16 is
## "step forward by one", 24 the same walking backwards.
#DEFINE HELPK.UP 16
#DEFINE HELPK.DOWN 24

#DEFINE HELP.CHAN 2

## Mode $00 is 80x60 and $01 is 80x30. APPSYS.STARTUP remembers whichever the
## user had and APPSYS.RESTORE puts it back.
#DEFINE HELP.MODE 1

## CP437, the IBM PC set, charset 7. ROM R47 and later. $20-$7E is ASCII
## exactly and the high half carries the line drawing glyphs.
#DEFINE HELP.CHARSET 7

## The KERNAL's charset register. Bit 6 says the text is ASCII, and GP.PRINTAT
## reads it per character. Poke it rather than PRINT CHR$(15): that control code
## sets the same bit but also uploads the ISO font, losing the line drawing.
#DEFINE HELP.CHRREG 882
#DEFINE HELP.ASCIIBIT 64

## The single line box, as CP437 code points. GP.BOX writes its glyphs to VERA
## as tile indices without converting, and in CP437 the two are one number.
#DEFINE HELP.GL.H 196
#DEFINE HELP.GL.V 179
#DEFINE HELP.GL.TL 218
#DEFINE HELP.GL.TR 191
#DEFINE HELP.GL.BL 192
#DEFINE HELP.GL.BR 217

## The splash bank and the big letters in it. The art is "#" and space, 5x7
## letters with a column between them, and HELP.SPLASH draws each run of "#" as
## CP437 219, the solid block. The widths are the art's, not the text's.
#DEFINE HELP.BANBANK 14
#DEFINE HELP.BAN.BLOCK 219
#DEFINE HELP.BAN.TOPW 53
#DEFINE HELP.BAN.BOTW 65
#DEFINE HELP.BAN.MAXRUN 5

#DEFINE HELP.K.UP 145
#DEFINE HELP.K.DOWN 17
#DEFINE HELP.K.PGUP 130
#DEFINE HELP.K.PGDN 2
#DEFINE HELP.K.HOME 19
#DEFINE HELP.K.END 4
#DEFINE HELP.K.LEFT 157
#DEFINE HELP.K.RIGHT 29

GOSUB HELP.BOOT
GP.IF HELP.OK = 0 THEN
    GOSUB APPSYS.RESTORE
    PRINT
    PRINT "GPC.HELP: HELP-TXT/GPC.HELP.IDX WOULD NOT LOAD."
    PRINT "RUN MKHELP.PY AND PUT THE HELP-TXT FOLDER"
    PRINT "BESIDE GPC.HELP.PRG OR IN /GPC/."
    END
GP.ENDIF

GOSUB HELP.INDEX
GOSUB APPSYS.RESTORE
PRINT
PRINT "GPC.HELP."
END


## ============================================================================
## HELP.BOOT -- the screen as we want it, the arrays, and the index
## ============================================================================
HELP.BOOT:
    ## Before any SCREEN of our own: it records the state as it finds it.
    GOSUB APPSYS.STARTUP
    SCREEN HELP.MODE

    ## Before the first MENU.BEGIN, which claims MENU.TEXTBANK (62) for the
    ## link menu's rows.
    GOSUB BANKMGR.INIT

    ## The three code regions, claimed so that nothing can be handed the
    ## program's own code as scratch.
    IF GP.FN(BANKMGR.CLAIM.BANK, HELP.LIBCODE) = 0 THEN GOTO HELP.BANK.FAILED
    IF GP.FN(BANKMGR.CLAIM.BANK, HELP.GUICODE) = 0 THEN GOTO HELP.BANK.FAILED
    IF GP.FN(BANKMGR.CLAIM.BANK, HELP.DLGCODE) = 0 THEN GOTO HELP.BANK.FAILED

    ## The splash art. The compiler puts it there; BANKMGR has to be told.
    IF GP.FN(BANKMGR.CLAIM.BANK, HELP.BANBANK) = 0 THEN GOTO HELP.BANK.FAILED

    ## The keyword table, put there by the compiler like the splash art.
    IF GP.FN(BANKMGR.CLAIM.BANK, HELP.KEYBANK) = 0 THEN GOTO HELP.BANK.FAILED

    ## The topic text. HELP.PAGE.LOAD fills them.
    FOR HELP.I = 0 TO HELP.TEXTBANKS - 1
        IF GP.FN(BANKMGR.CLAIM.BANK, HELP.TEXTBANK + HELP.I) = 0 THEN GOTO HELP.BANK.FAILED
    NEXT HELP.I

    ## Asked after the mode change. APPSYS.STARTUP reported the old screen.
    GOSUB GUI.SCREEN
    HELP.COLS = GUI.SCREEN.COLS : HELP.ROWS = GUI.SCREEN.ROWS

    ## After the mode change as well: it reads the text layer's map.
    GOSUB HELP.SYN.SETUP

    ## Row 0 is the title and the last row the hint.
    HELP.VIEW = HELP.ROWS - 2
    IF HELP.VIEW < 4 THEN HELP.VIEW = 4

    THEME.ID% = 0 : GOSUB HELP.THEME.SET

    ## CP437, then declare that the text is ASCII. The order matters:
    ## screen_set_charset does not clear bit 6, so the charset goes first and the
    ## bit after. APPSYS.RESTORE hands the whole $0372 byte back.
    GP.CALL APPSYS.SETCHR, HELP.CHARSET, 0, 0, 0
    POKE HELP.CHRREG, PEEK(HELP.CHRREG) OR HELP.ASCIIBIT

    ## GP.BOX's four built-in styles are PETSCII screen codes and would draw
    ## letters here, so the frame glyphs are named outright.
    GP.SUB DLGRESET, HELP.BANK
    GUI.EDGE.H = HELP.GL.H     : GUI.EDGE.V = HELP.GL.V
    GUI.CORNER.TL = HELP.GL.TL : GUI.CORNER.TR = HELP.GL.TR
    GUI.CORNER.BL = HELP.GL.BL : GUI.CORNER.BR = HELP.GL.BR
    GP.SUB DLGGLYPH, 1

    GP.SUB DLGSHADOW, 1

    ## 72 spaces, HELP.IXWIDE. GPC takes SPC( only inside PRINT and inside a
    ## GP.BANKEDSTR body, so the width cannot be written as SPC(HELP.IXWIDE).
    ## Never reallocated: HELP.IXTEXT pokes the length byte and the characters
    ## through GP.STRPTR, and a string block never grows.
    HELP.ROW$ = "                                                                        "

    ## What HELP.CENTRE cuts its padding from. 60 covers the widest line a
    ## dialog puts up.
    HELP.SPACES$ = "                                                            "
    HELP.IXFREE = HELP.MAXIX * HELP.IXREC
    DIM HELP.PICK%(HELP.MAXPICK)    : DIM HELP.BACK.GO%(HELP.MAXBACK)
    DIM HELP.BACK.AT%(HELP.MAXBACK) : DIM HELP.FLD$(6)

    ## The content folder. Set before HELP.IDXLOAD, the first thing to use it.
    HELP.DIR$ = "//HELP-TXT/:" : HELP.FIND$ = ""

    GOSUB HELP.SPLASH
    GOSUB HELP.IDXLOAD
    ## Not beside the program: the copy in /GPC/, the tool home.
    GP.IF HELP.OK = 0 THEN
        HELP.DIR$ = "//GPC/HELP-TXT/:"
        GOSUB HELP.IDXLOAD
    GP.ENDIF
    RETURN


HELP.BANK.FAILED:
    PRINT "BANK"; BANKMGR.SET.BANK; "FAILED"
    GOSUB APPSYS.RESTORE
    END


## ============================================================================
## HELP.SPLASH -- the name of the program, in big letters, while the index reads
## ============================================================================

## Two groups, because a group name is resolved while the program compiles and
## cannot be held in a variable.
GP.BANKEDSTR HELP.BANBANK HELP.BS.TOP
  " ###  ####   ###        ####   ###   #### #####  ###"
  "#   # #   # #   #       #   # #   # #       #   #   #"
  "#     #   # #           #   # #   # #       #   #"
  "#  ## ####  #           ####  #####  ###    #   #"
  "#   # #     #           #   # #   #     #   #   #"
  "#   # #     #   #       #   # #   #     #   #   #   #"
  " ###  #      ###        ####  #   # ####  #####  ###"
GP.ENDBANKEDSTR

GP.BANKEDSTR HELP.BANBANK HELP.BS.BOT
  "#   # ##### #     ####         #### #   #  #### ##### ##### #   #"
  "#   # #     #     #   #       #     #   # #       #   #     ## ##"
  "#   # #     #     #   #       #      # #  #       #   #     # # #"
  "##### ####  #     ####         ###    #    ###    #   ####  # # #"
  "#   # #     #     #               #   #       #   #   #     #   #"
  "#   # #     #     #               #   #       #   #   #     #   #"
  "#   # ##### ##### #           ####    #   ####    #   ##### #   #"
GP.ENDBANKEDSTR


## GP.FILL translates its character from PETSCII, which cannot reach a tile
## index above 127, so the block is printed rather than filled: GP.PRINTAT
## passes the byte through untouched while bit 6 of $0372 is set.
HELP.SPLASH:
    GP.FILL 0, 0, HELP.COLS, HELP.ROWS, 32, THEME.CLR(THEME.PAGE)
    HELP.BAN.INK = THEME.CLR(THEME.TITLE)

    ## No run is longer than five cells, so five blocks is the whole pen.
    HELP.BAN.PEN$ = ""
    FOR HELP.BAN.I = 1 TO HELP.BAN.MAXRUN
        HELP.BAN.PEN$ = HELP.BAN.PEN$ + CHR$(HELP.BAN.BLOCK)
    NEXT HELP.BAN.I

    HELP.BAN.X = INT((HELP.COLS - HELP.BAN.TOPW) / 2)
    HELP.BAN.Y = 2
    FOR HELP.BAN.I = 0 TO GP.BSTRCOUNT(HELP.BS.TOP) - 1
        HELP.BAN.LINE$ = GP.BSTR(HELP.BS.TOP, HELP.BAN.I)
        GOSUB HELP.SPLASH.ROW
        HELP.BAN.Y = HELP.BAN.Y + 1
    NEXT HELP.BAN.I

    HELP.BAN.X = INT((HELP.COLS - HELP.BAN.BOTW) / 2)
    HELP.BAN.Y = HELP.ROWS - 10
    FOR HELP.BAN.I = 0 TO GP.BSTRCOUNT(HELP.BS.BOT) - 1
        HELP.BAN.LINE$ = GP.BSTR(HELP.BS.BOT, HELP.BAN.I)
        GOSUB HELP.SPLASH.ROW
        HELP.BAN.Y = HELP.BAN.Y + 1
    NEXT HELP.BAN.I

    HELP.BAN.WORD$ = "Reading index ..."
    HELP.BAN.X = INT((HELP.COLS - LEN(HELP.BAN.WORD$)) / 2)
    GP.PRINTAT HELP.BAN.X, INT(HELP.ROWS / 2) - 1, HELP.BAN.WORD$, THEME.CLR(THEME.TEXT)
    RETURN

## One row of art, its left edge at HELP.BAN.X and its row HELP.BAN.Y. Runs of
## "#" are collected and printed; a space closes the run being collected.
HELP.SPLASH.ROW:
    HELP.BAN.RUN = 0
    FOR HELP.BAN.C = 1 TO LEN(HELP.BAN.LINE$)
        GP.IF MID$(HELP.BAN.LINE$, HELP.BAN.C, 1) = "#" THEN
            IF HELP.BAN.RUN = 0 THEN HELP.BAN.FROM = HELP.BAN.C
            HELP.BAN.RUN = HELP.BAN.RUN + 1
        GP.ELSE
            GOSUB HELP.SPLASH.RUN
        GP.ENDIF
    NEXT HELP.BAN.C
    ## The run that ends at the last character has no space to close it.
    GOSUB HELP.SPLASH.RUN
    RETURN

HELP.SPLASH.RUN:
    IF HELP.BAN.RUN = 0 THEN RETURN
    GP.PRINTAT HELP.BAN.X + HELP.BAN.FROM - 1, HELP.BAN.Y, LEFT$(HELP.BAN.PEN$, HELP.BAN.RUN), HELP.BAN.INK
    HELP.BAN.RUN = 0
    RETURN


## ============================================================================
## HELP.IDX -- the master index, read once
## ============================================================================

HELP.IDXLOAD:
    HELP.OK = 0 : HELP.IX.N = 0
    OPEN HELP.CHAN, 8, HELP.CHAN, HELP.DIR$ + "GPC.HELP.IDX,S,R"
HELP.IDXLOAD.LOOP:
    LINPUT# HELP.CHAN, HELP.LINE$, 10 : HELP.ST = ST
    ## Bit 1 of ST is a read error. An OPEN that found no file still opens, and
    ## every LINPUT# then hands back CHR$(0) with ST = 66, for ever. Clean EOF is
    ## 64, so bit 1 alone tells "no such file" from "that was the last line".
    IF (HELP.ST AND 2) <> 0 THEN GOTO HELP.IDXLOAD.DONE
    GOSUB HELP.STRIP : GOSUB HELP.IDXROW
    ## Only bit 6 ends a read, not "ST is not zero". After a write channel has
    ## been opened and closed on this device a good read comes back with ST = 128
    ## and the line intact. Bit 1 is the error, bit 6 the end, bit 7 neither.
    IF (HELP.ST AND 64) = 0 THEN GOTO HELP.IDXLOAD.LOOP
HELP.IDXLOAD.DONE:
    CLOSE HELP.CHAN : IF HELP.IX.N > 0 THEN HELP.OK = 1
    RETURN

## Read to the LF, and drop a CR if one came with it.
HELP.STRIP:
    IF LEN(HELP.LINE$) = 0 THEN RETURN
    IF RIGHT$(HELP.LINE$, 1) = CHR$(13) THEN HELP.LINE$ = LEFT$(HELP.LINE$, LEN(HELP.LINE$) - 1)
    RETURN

## HELP.LINE$ -> HELP.FLD$(1..5). The fifth field takes everything left,
## because a title is free to contain the separator and a row is not.
HELP.SPLIT:
    HELP.REST$ = HELP.LINE$
    FOR HELP.FI = 1 TO 4
        HELP.CUT = GP.INSTR(HELP.REST$, "|")
        GP.IF HELP.CUT = 0 THEN
            HELP.FLD$(HELP.FI) = HELP.REST$
            HELP.REST$ = ""
        GP.ELSE
            HELP.FLD$(HELP.FI) = LEFT$(HELP.REST$, HELP.CUT - 1)
            HELP.REST$ = MID$(HELP.REST$, HELP.CUT + 1)
        GP.ENDIF
    NEXT HELP.FI
    HELP.FLD$(5) = HELP.REST$
    RETURN

HELP.IDXROW:
    IF LEN(HELP.LINE$) < 3 THEN RETURN
    HELP.TAG$ = LEFT$(HELP.LINE$, 1)
    IF HELP.TAG$ = "#" THEN RETURN
    IF HELP.TAG$ = "N" THEN RETURN
    IF HELP.IX.N >= HELP.MAXIX THEN RETURN
    GOSUB HELP.SPLIT
    HELP.IX.N = HELP.IX.N + 1 : HELP.KIND = 0
    IF HELP.TAG$ = "T" THEN HELP.KIND = 1
    IF HELP.TAG$ = "S" THEN HELP.KIND = 2
    IF HELP.TAG$ = "E" THEN HELP.KIND = HELP.IX.EXAMPLE
    HELP.T$ = HELP.FLD$(5) : HELP.TL = LEN(HELP.T$)
    IF HELP.TL > HELP.IXWIDE THEN HELP.TL = HELP.IXWIDE
    ## A row that will not fit is dropped whole rather than half written.
    IF HELP.IXFREE + HELP.TL > 8192 THEN HELP.IX.N = HELP.IX.N - 1 : RETURN
    HELP.REC = HELP.IWIN + (HELP.IX.N - 1) * HELP.IXREC
    HELP.LN2 = VAL(HELP.FLD$(4)) : HELP.HI = INT(HELP.LN2 / 256)
    HELP.SECLINE = VAL(HELP.FLD$(3))
    HELP.SECHI = INT(HELP.SECLINE / 256)
    BANK HELP.IBANK
    POKE HELP.REC, HELP.IXFREE - INT(HELP.IXFREE / 256) * 256
    POKE HELP.REC + 1, INT(HELP.IXFREE / 256)
    POKE HELP.REC + 2, HELP.TL
    POKE HELP.REC + 3, HELP.KIND
    POKE HELP.REC + 4, VAL(HELP.FLD$(2))
    POKE HELP.REC + 5, HELP.SECLINE - HELP.SECHI * 256
    POKE HELP.REC + 6, HELP.SECHI
    POKE HELP.REC + 7, HELP.LN2 - HELP.HI * 256
    POKE HELP.REC + 8, HELP.HI
    HELP.SP = GP.STRPTR(HELP.T$) + 1
    GP.IF HELP.TL > 0 THEN
        FOR HELP.I = 0 TO HELP.TL - 1
            POKE HELP.IWIN + HELP.IXFREE + HELP.I, PEEK(HELP.SP + HELP.I)
        NEXT HELP.I
    GP.ENDIF
    HELP.IXFREE = HELP.IXFREE + HELP.TL
    RETURN

## One row out of the bank. HELP.IXR in, the six fields out. The rows live only
## in the bank, so every caller that wants a field calls this first.
HELP.IXREAD:
    BANK HELP.IBANK
    HELP.REC = HELP.IWIN + (HELP.IXR - 1) * HELP.IXREC
    HELP.IXOFF = PEEK(HELP.REC) + PEEK(HELP.REC + 1) * 256
    HELP.IXLEN = PEEK(HELP.REC + 2) : HELP.IXTYPE = PEEK(HELP.REC + 3)
    HELP.IXTOPIC = PEEK(HELP.REC + 4)
    HELP.IXSEC = PEEK(HELP.REC + 5) + PEEK(HELP.REC + 6) * 256
    HELP.IXLINES = PEEK(HELP.REC + 7) + PEEK(HELP.REC + 8) * 256
    RETURN

## The row's text, in HELP.ROW$. Call HELP.IXREAD first: this uses its offset
## and length. The length byte is poked rather than the string assigned, so
## nothing is allocated.
HELP.IXTEXT:
    HELP.RP = GP.STRPTR(HELP.ROW$)
    POKE HELP.RP, HELP.IXLEN
    BANK HELP.IBANK
    GP.IF HELP.IXLEN > 0 THEN
        FOR HELP.I = 0 TO HELP.IXLEN - 1
            POKE HELP.RP + 1 + HELP.I, PEEK(HELP.IWIN + HELP.IXOFF + HELP.I)
        NEXT HELP.I
    GP.ENDIF
    RETURN

## Topic 7 is HELP-TXT/H007.HLP: the index carries the number, so no row holds a
## file name. "//DIR/:NAME" is the CMD subdirectory syntax (X16 Reference 13). A
## plain "HELP-TXT/H007.HLP" works on the host filesystem and not on an SD card.
HELP.FILENAME:
    HELP.NUMV = HELP.TOPICNUM : GOSUB HELP.NUMSTR
    HELP.NAME$ = HELP.DIR$ + "H" + RIGHT$("000" + HELP.NUM$, 3) + ".HLP"
    RETURN


## ============================================================================
## The master index page
## ============================================================================

HELP.INDEX:
    HELP.IX.SEL = 1
HELP.INDEX.FIRST:
    ## Row 1 is a category header, and a header is not a destination.
    HELP.IXR = HELP.IX.SEL : GOSUB HELP.IXREAD
    IF HELP.IXTYPE = 0 THEN HELP.IX.SEL = HELP.IX.SEL + 1 : GOTO HELP.INDEX.FIRST
    HELP.IX.TOP = 1
    HELP.FULL = 1

HELP.INDEX.LOOP:
    GP.IF HELP.FULL <> 0 THEN
        GOSUB HELP.INDEX.DRAW
        HELP.FULL = 0
    GP.ENDIF
    GOSUB HELP.INDEX.STATUS

    HELP.SEL.WAS = HELP.IX.SEL : HELP.TOP.WAS = HELP.IX.TOP
    HELP.DONE = 0
    GOSUB HELP.GETKEY

    GP.SELECT HELP.KEY
        GP.CASE HELP.K.UP
            HELP.DIR = -1 : GOSUB HELP.IX.STEP
        GP.CASE HELP.K.DOWN
            HELP.DIR = 1 : GOSUB HELP.IX.STEP
        GP.CASE HELP.K.PGUP
            HELP.DIR = -1 : GOSUB HELP.IX.PAGE
        GP.CASE HELP.K.PGDN
            HELP.DIR = 1 : GOSUB HELP.IX.PAGE
        GP.CASE HELP.K.HOME
            HELP.IX.SEL = 1 : HELP.DIR = 1 : GOSUB HELP.IX.SNAP
        GP.CASE HELP.K.END
            HELP.IX.SEL = HELP.IX.N : HELP.DIR = -1 : GOSUB HELP.IX.SNAP
        GP.CASE 47, 70, 102
            GOSUB HELP.FIND.ASK
        GP.CASE 78, 110
            GOSUB HELP.FIND.NEXT
        GP.CASE 84, 116
            GOSUB HELP.THEME.NEXT : HELP.FULL = 1
        GP.CASE 63, 72, 104
            GOSUB HELP.ABOUT
        GP.CASE GUI.RETURN
            GOSUB HELP.OPEN.SEL
        GP.CASE GUI.ESCAPE, GUI.STOP
            GOSUB HELP.ASKQUIT
    GP.ENDSEL

    IF HELP.DONE <> 0 THEN RETURN
    GOSUB HELP.IX.SHOW
    ## A full redraw is already owed, so leave the row repaints below alone.
    IF HELP.FULL <> 0 THEN GOTO HELP.INDEX.LOOP
    ## A one row move slides. A move inside the page repaints two rows. A page
    ## jump or HOME repaints whole.
    GP.IF HELP.IX.TOP <> HELP.TOP.WAS THEN
        HELP.IXD = HELP.IX.TOP - HELP.TOP.WAS
        HELP.SHIFT = 0
        IF HELP.IXD = 1 THEN HELP.SHIFT = 1
        IF HELP.IXD = 0 - 1 THEN HELP.SHIFT = 0 - 1
        GP.IF HELP.SHIFT <> 0 THEN
            GOSUB HELP.INDEX.SLIDE
        GP.ELSE
            GOSUB HELP.INDEX.ROWS
        GP.ENDIF
        ## The row the highlight came from slid with it and is still wearing
        ## it, so it is redrawn where it landed.
        HELP.ROWI = HELP.SEL.WAS : GOSUB HELP.INDEX.ROW
    GP.ELSE
        HELP.ROWI = HELP.SEL.WAS : GOSUB HELP.INDEX.ROW
        HELP.ROWI = HELP.IX.SEL : GOSUB HELP.INDEX.ROW
    GP.ENDIF
    GOTO HELP.INDEX.LOOP

## The screen, the bars and the entries. For entering the index, or coming back
## to it from a topic or a dialog.
HELP.INDEX.DRAW:
    GOSUB HELP.PAGE.FRAME
    HELP.TITLE$ = "GPC.HELP    GP.BASIC and BASL, built from the library"
    GOSUB HELP.TITLEBAR
    GOSUB HELP.INDEX.ROWS
    RETURN

## The entries only: the bars do not change when the list moves. A one row move
## slides in VERA and names the entry that lands on the exposed row.
HELP.INDEX.SLIDE:
    GOSUB HELP.PAGE.SHIFT
    HELP.ROWI = HELP.IX.TOP + HELP.ONLY
    GOSUB HELP.INDEX.ROW
    RETURN

HELP.INDEX.ROWS:
    GP.FILL 0, 1, HELP.COLS, HELP.VIEW, 32, THEME.CLR(THEME.PAGE)
    FOR HELP.R = 0 TO HELP.VIEW - 1
        HELP.ROWI = HELP.IX.TOP + HELP.R
        GOSUB HELP.INDEX.ROW
    NEXT HELP.R
    RETURN

HELP.INDEX.ROW:
    IF HELP.ROWI < HELP.IX.TOP THEN RETURN
    IF HELP.ROWI > HELP.IX.TOP + HELP.VIEW - 1 THEN RETURN
    IF HELP.ROWI > HELP.IX.N THEN RETURN
    HELP.Y = 1 + HELP.ROWI - HELP.IX.TOP
    HELP.IXR = HELP.ROWI : GOSUB HELP.IXREAD
    HELP.ATTR = THEME.CLR(THEME.TEXT)
    IF HELP.IXTYPE = 0 THEN HELP.ATTR = THEME.CLR(THEME.TITLE)
    IF HELP.IXTYPE = 2 THEN HELP.ATTR = THEME.CLR(THEME.DIMMED)
    IF HELP.ROWI = HELP.IX.SEL THEN HELP.ATTR = THEME.CLR(THEME.HILITE)
    GP.FILL 0, HELP.Y, HELP.COLS, 1, 32, HELP.ATTR
    GOSUB HELP.IXTEXT
    GP.PRINTAT 1, HELP.Y, HELP.ROW$, HELP.ATTR
    RETURN

HELP.INDEX.STATUS:
    HELP.HINT$ = "ENTER open   / find   N next   T theme   ? about   ESC quit"
    HELP.NUMV = HELP.IX.SEL : GOSUB HELP.NUMSTR
    HELP.NOTE$ = HELP.NUM$
    HELP.NUMV = HELP.IX.N : GOSUB HELP.NUMSTR
    HELP.NOTE$ = HELP.NOTE$ + " of " + HELP.NUM$
    GOSUB HELP.STATUSBAR
    RETURN

## One selectable entry in HELP.DIR, stopping at either end.
HELP.IX.STEP:
    HELP.J = HELP.IX.SEL + HELP.DIR
HELP.IX.STEP.SCAN:
    IF HELP.J < 1 THEN RETURN
    IF HELP.J > HELP.IX.N THEN RETURN
    HELP.IXR = HELP.J : GOSUB HELP.IXREAD
    IF HELP.IXTYPE = 0 THEN HELP.J = HELP.J + HELP.DIR : GOTO HELP.IX.STEP.SCAN
    HELP.IX.SEL = HELP.J
    RETURN

HELP.IX.PAGE:
    HELP.J = HELP.IX.SEL + HELP.DIR * (HELP.VIEW - 1)
    IF HELP.J < 1 THEN HELP.J = 1
    IF HELP.J > HELP.IX.N THEN HELP.J = HELP.IX.N
    HELP.IX.SEL = HELP.J
    GOSUB HELP.IX.SNAP
    RETURN

## Land on something selectable: try HELP.DIR first, then turn round once.
HELP.IX.SNAP:
    HELP.TURNED = 0
    HELP.J = HELP.IX.SEL
HELP.IX.SNAP.SCAN:
    IF HELP.J < 1 THEN GOTO HELP.IX.SNAP.TURN
    IF HELP.J > HELP.IX.N THEN GOTO HELP.IX.SNAP.TURN
    HELP.IXR = HELP.J : GOSUB HELP.IXREAD
    IF HELP.IXTYPE <> 0 THEN HELP.IX.SEL = HELP.J : RETURN
    HELP.J = HELP.J + HELP.DIR
    GOTO HELP.IX.SNAP.SCAN
HELP.IX.SNAP.TURN:
    IF HELP.TURNED <> 0 THEN RETURN
    HELP.TURNED = 1
    HELP.DIR = 0 - HELP.DIR
    HELP.J = HELP.IX.SEL + HELP.DIR
    GOTO HELP.IX.SNAP.SCAN

HELP.IX.SHOW:
    IF HELP.IX.SEL < HELP.IX.TOP THEN HELP.IX.TOP = HELP.IX.SEL
    IF HELP.IX.SEL > HELP.IX.TOP + HELP.VIEW - 1 THEN HELP.IX.TOP = HELP.IX.SEL - HELP.VIEW + 1
    ## Keep a category heading on screen above the row that is selected.
    GP.IF HELP.IX.SEL > 1 AND HELP.IX.TOP = HELP.IX.SEL THEN
        HELP.IXR = HELP.IX.SEL - 1 : GOSUB HELP.IXREAD
        IF HELP.IXTYPE = 0 THEN HELP.IX.TOP = HELP.IX.SEL - 1
    GP.ENDIF
    IF HELP.IX.TOP > HELP.IX.N - HELP.VIEW + 1 THEN HELP.IX.TOP = HELP.IX.N - HELP.VIEW + 1
    IF HELP.IX.TOP < 1 THEN HELP.IX.TOP = 1
    RETURN


## ============================================================================
## The reader
## ============================================================================

HELP.OPEN.SEL:
    HELP.GO = HELP.IX.SEL
    HELP.BACK.N = 0
    GOSUB HELP.START.AT
    GOSUB HELP.TOPIC
    HELP.FULL = 1
    RETURN

## Where a row opens its topic. A section row starts on its own header; a
## topic row starts at the top.
HELP.START.AT:
    HELP.PG.FROM = 0
    HELP.IXR = HELP.GO : GOSUB HELP.IXREAD
    IF HELP.IXSEC > 1 THEN HELP.PG.FROM = HELP.IXSEC - 1
    GOSUB HELP.PG.CLAMP
    RETURN

HELP.PG.CLAMP:
    HELP.IXR = HELP.GO : GOSUB HELP.IXREAD
    HELP.PG.TOTAL = HELP.IXLINES
    ## An example is as long as its file was when it loaded.
    IF HELP.IXTYPE = HELP.IX.EXAMPLE THEN HELP.PG.TOTAL = HELP.PG.LINES
    HELP.PG.MAX = HELP.PG.TOTAL - HELP.VIEW
    IF HELP.PG.FROM > HELP.PG.MAX THEN HELP.PG.FROM = HELP.PG.MAX
    IF HELP.PG.FROM < 0 THEN HELP.PG.FROM = 0
    RETURN

## Show index row HELP.GO, and every row a cross reference in it leads to, until
## ESC has walked back out. Flat, not nested: following a link re-enters at the
## top with HELP.NAV = 1, so the depth is in HELP.BACK.* and not on the stack.
HELP.TOPIC:
HELP.TOPIC.ENTER:
    ## Once per topic, not once per scroll. Everything below draws out of this
    ## bank.
    GOSUB HELP.PAGE.LOAD
    IF HELP.SRC.MODE <> 0 AND HELP.PG.LINES = 0 THEN GOTO HELP.SRC.MISSING
    HELP.REDRAW = 1 : HELP.SHIFT = 0
HELP.PAGE.LOOP:
    GP.IF HELP.REDRAW <> 0 THEN
        GOSUB HELP.PAGE.DRAW
        HELP.REDRAW = 0
    GP.ENDIF
    IF HELP.PG.LINES = 0 THEN RETURN
    GOSUB HELP.PAGE.STATUS

    HELP.FROM.WAS = HELP.PG.FROM : HELP.NAV = 0
    GOSUB HELP.GETKEY

    GP.SELECT HELP.KEY
        GP.CASE HELP.K.UP
            HELP.PG.FROM = HELP.PG.FROM - 1
        GP.CASE HELP.K.DOWN
            HELP.PG.FROM = HELP.PG.FROM + 1
        GP.CASE HELP.K.PGUP
            HELP.PG.FROM = HELP.PG.FROM - HELP.VIEW + 1
        GP.CASE HELP.K.PGDN, GUI.SPACE
            HELP.PG.FROM = HELP.PG.FROM + HELP.VIEW - 1
        GP.CASE HELP.K.HOME
            HELP.PG.FROM = 0
        GP.CASE HELP.K.END
            ## Past the end. HELP.PG.CLAMP brings it back to the last page.
            HELP.PG.FROM = HELP.MAXLINES
        GP.CASE HELP.K.LEFT
            HELP.SRC.DIR = 0 - 1
            GOSUB HELP.SRC.SIDE
        GP.CASE HELP.K.RIGHT
            HELP.SRC.DIR = 1
            GOSUB HELP.SRC.SIDE
        GP.CASE 76, 108
            GOSUB HELP.LINKS
        GP.CASE 84, 116
            ## The frame as well. A topic page inherits the index's and never
            ## paints one, so the three corner cells would keep the old theme's
            ## colours.
            GOSUB HELP.THEME.NEXT : GOSUB HELP.PAGE.FRAME : HELP.REDRAW = 1
        GP.CASE 88, 120
            GOSUB HELP.EXPORT
        GP.CASE GUI.ESCAPE, GUI.STOP
            GOSUB HELP.BACK.POP
    GP.ENDSEL

    IF HELP.NAV = 2 THEN RETURN
    IF HELP.NAV = 1 THEN GOTO HELP.TOPIC.ENTER
    GOSUB HELP.PG.CLAMP
    ## The clamp runs first, so a PgDn that lands one line short of the bottom
    ## arrives here as a delta of 1 and slides like an arrow key.
    HELP.SHIFT = 0 : HELP.DELTA = HELP.PG.FROM - HELP.FROM.WAS
    IF HELP.DELTA = 1 THEN HELP.SHIFT = 1
    IF HELP.DELTA = 0 - 1 THEN HELP.SHIFT = 0 - 1
    IF HELP.DELTA <> 0 THEN HELP.REDRAW = 1
    GOTO HELP.PAGE.LOOP

## ============================================================================
## The topic lives in banks. It is read once, on entry: the line table into
## HELP.TBANK and the text into the banks from HELP.TEXTBANK. A scroll then
## paints one row out of RAM.
##
## WARNING: this cannot be one GP.CALL. The KERNAL's memory_copy takes no bank
## argument and BANK applies only around a PEEK or a POKE, so a raw call runs
## with whatever BASIC left in $00. Holding a bank across one needs GP.ASM.
## ============================================================================
HELP.PAGE.LOAD:
    HELP.HASCODE = 0
    HELP.PG.LINES = 0 : HELP.LINKN = 0 : HELP.ATTOPIC = 0
    HELP.SRC.MODE = 0
    HELP.SRC.LEFT = 0
    ## The link menu is built as the topic loads, one popup row a cross reference.
    GP.SUB MENU.BEGIN, MENU.POPUP
    ## The text starts at the bottom of the first text bank.
    HELP.PG.P = 0
    HELP.PG.BANKIX = 0
    HELP.RECP = HELP.WIN
    HELP.IXR = HELP.GO : GOSUB HELP.IXREAD
    IF HELP.IXTYPE = HELP.IX.EXAMPLE THEN GOTO HELP.SRC.LOAD
    HELP.TOPICNUM = HELP.IXTOPIC
    IF HELP.TOPICNUM < 1 THEN RETURN
    GOSUB HELP.FILENAME
    GOSUB HELP.PAGE.LOADING

    OPEN HELP.CHAN, 8, HELP.CHAN, HELP.NAME$ + ",S,R"
    LINPUT# HELP.CHAN, HELP.LINE$, 10 : HELP.ST = ST
    IF (HELP.ST AND 2) <> 0 THEN GOTO HELP.LOAD.CLOSE
    GOSUB HELP.STRIP
    HELP.IXR = HELP.GO : GOSUB HELP.IXREAD : GOSUB HELP.IXTEXT
    ## A copy. HELP.ROW$ is rewritten in place by the next row read.
    HELP.TITLE$ = HELP.ROW$ + ""
    IF LEFT$(HELP.LINE$, 1) = "@" THEN HELP.TITLE$ = MID$(HELP.LINE$, 2) : HELP.ATTOPIC = 1

HELP.LOAD.READ:
    IF HELP.PG.LINES > HELP.IXLINES + 4 THEN GOTO HELP.LOAD.CLOSE
    LINPUT# HELP.CHAN, HELP.LINE$, 10 : HELP.ST = ST
    IF (HELP.ST AND 2) <> 0 THEN GOTO HELP.LOAD.CLOSE
    HELP.PG.LINES = HELP.PG.LINES + 1
    ## The line is read through its pointer, not taken apart into strings.
    ## GP.STRPTR gives the address of the length byte, so length is offset 0, the
    ## marker 1 and the body 2. PEEK reads main RAM and ignores the bank.
    HELP.LP = GP.STRPTR(HELP.LINE$)
    HELP.LL = LEN(HELP.LINE$)
    IF HELP.LL > 0 THEN IF PEEK(HELP.LP + HELP.LL) = 13 THEN HELP.LL = HELP.LL - 1
    HELP.MARKC = 0
    IF HELP.LL > 0 THEN HELP.MARKC = PEEK(HELP.LP + 1)
    HELP.KIND = 0
    IF HELP.MARKC = 61 THEN HELP.KIND = 1
    IF HELP.MARKC = 58 THEN HELP.KIND = 2
    IF HELP.MARKC = 58 THEN HELP.HASCODE = 1
    ## A cross reference is the one line that needs a string. HELP.PAGE.REF
    ## splits it on "|" and adds the text to the link menu.
    GP.IF HELP.MARKC = 62 THEN
        HELP.BODY$ = MID$(HELP.LINE$, 2, HELP.LL - 1)
        GOSUB HELP.PAGE.REF
        HELP.SP = GP.STRPTR(HELP.BODY$) + 1 : HELP.W = LEN(HELP.BODY$)
    GP.ELSE
        HELP.SP = HELP.LP + 2 : HELP.W = HELP.LL - 1
    GP.ENDIF
    IF HELP.W < 0 THEN HELP.W = 0
    GOSUB HELP.LOAD.STORE
    IF HELP.PG.LINES >= HELP.MAXLINES THEN GOTO HELP.LOAD.CLOSE
    ## Bit 6 is the end. The last line carries data and the flag, so it is stored
    ## first and the loop leaves after it. HELP.IDXLOAD has the note on ST.
    IF (HELP.ST AND 64) = 0 THEN GOTO HELP.LOAD.READ

HELP.LOAD.CLOSE:
    CLOSE HELP.CHAN
    RETURN

## One line into the bank, its kind beside it so no row is parsed twice. The
## body is truncated to what a row can show. In: HELP.SP the address of the
## first body character, HELP.W how many, HELP.KIND. Out: HELP.W as stored.
HELP.LOAD.STORE:
    ## Ordinary text starts at column 2, which is the widest a row can be. Link
    ## rows indent to 5 and are clamped where they are drawn. A source line is
    ## kept whole, for LEFT and RIGHT to bring into view.
    HELP.STORE.WIDE = HELP.COLS - 2
    IF HELP.SRC.MODE <> 0 THEN HELP.STORE.WIDE = HELP.SRC.MAXWIDE
    IF HELP.W > HELP.STORE.WIDE THEN HELP.W = HELP.STORE.WIDE
    ## A line that will not fit starts the next text bank.
    GP.IF HELP.PG.P + HELP.W > HELP.BANKSIZE THEN
        GP.IF HELP.PG.BANKIX < HELP.TEXTBANKS - 1 THEN
            HELP.PG.BANKIX = HELP.PG.BANKIX + 1
            HELP.PG.P = 0
        GP.ENDIF
    GP.ENDIF
    ## Out of banks is recorded as an empty line, not a half written one.
    IF HELP.PG.P + HELP.W > HELP.BANKSIZE THEN HELP.W = 0
    ## The blob writes the line record as well as the text.
    ## WARNING: these are signed int16 holding an unsigned address. $A000
    ## comes back negative, but the low two bytes are the bit pattern the
    ## blob reads. Never do arithmetic on them in BASIC.
    ## HELP.SP already points at the first character, not the length byte.
    HELP.AS.SRC% = HELP.SP
    HELP.AS.DST% = HELP.WIN + HELP.PG.P
    HELP.AS.LEN% = HELP.W
    HELP.AS.RECBANK% = HELP.TBANK
    HELP.AS.TEXTBANK% = HELP.TEXTBANK + HELP.PG.BANKIX
    HELP.AS.REC% = HELP.RECP
    HELP.AS.OFF% = HELP.PG.P
    HELP.AS.KIND% = HELP.KIND + HELP.PG.BANKIX * HELP.KINDBANK
    GOSUB HELP.STORE.ASM
    HELP.RECP = HELP.RECP + HELP.RECSIZE
    HELP.PG.P = HELP.PG.P + HELP.W
    RETURN

## ============================================================================
## ============================================================================
## One line into the banks, in assembly: the record into HELP.AS.RECBANK% and
## the text into HELP.AS.TEXTBANK%.
##
## zTemp0, zTemp1 and zTemp2 hold the three pointers. They are free inside a
## blob: SYS clobbers zTemp0 reaching it.
##
## $00 is saved and put back, so the interpreter finds the bank as it left it. A
## line is at most HELP.SRC.MAXWIDE bytes, so the count fits in X and Y never
## wraps.
## ============================================================================
HELP.STORE.ASM:
    #REM 1
    GP.ASM
    REM LDA {HELP.AS.SRC%}       ; source -> zTemp0
    REM STA $2C
    REM LDX #1
    REM LDA {HELP.AS.SRC%},X
    REM STA $2D
    REM LDA {HELP.AS.DST%}       ; destination -> zTemp1
    REM STA $2E
    REM LDX #1
    REM LDA {HELP.AS.DST%},X
    REM STA $2F
    REM LDA {HELP.AS.REC%}       ; the line record -> zTemp2
    REM STA $30
    REM LDX #1
    REM LDA {HELP.AS.REC%},X
    REM STA $31
    REM LDA $00                  ; the bank we were handed, to put back
    REM PHA
    REM LDA {HELP.AS.RECBANK%}
    REM STA $00
    REM ; ---- offset low, offset high, length, kind ----
    REM LDY #0
    REM LDA {HELP.AS.OFF%}
    REM STA ($30),Y
    REM INY
    REM LDX #1
    REM LDA {HELP.AS.OFF%},X
    REM STA ($30),Y
    REM INY
    REM LDA {HELP.AS.LEN%}
    REM STA ($30),Y
    REM INY
    REM LDA {HELP.AS.KIND%}
    REM STA ($30),Y
    REM LDA {HELP.AS.TEXTBANK%}  ; the text goes in its own bank
    REM STA $00
    REM LDX {HELP.AS.LEN%}
    REM BEQ HSDONE
    REM LDY #0
    REM HSLP: LDA ($2C),Y
    REM STA ($2E),Y
    REM INY
    REM DEX
    REM BNE HSLP
    REM HSDONE: PLA
    REM STA $00
    GP.ENDASM
    #REM 0
    RETURN

## The title bar goes up before the read, so the topic is named while it loads.
HELP.PAGE.LOADING:
    GOSUB HELP.PAGE.FRAME
    HELP.IXR = HELP.GO : GOSUB HELP.IXREAD : GOSUB HELP.IXTEXT
    ## A copy. HELP.ROW$ is rewritten in place by the next row read.
    HELP.TITLE$ = HELP.ROW$ + ""
    GOSUB HELP.TITLEBAR
    GP.PRINTAT 2, 2, "Reading " + HELP.NAME$ + " ...", THEME.CLR(THEME.DIMMED)
    RETURN

## The page, painted from the bank. No file is opened here: this runs on every
## scroll and HELP.PAGE.LOAD does not.
HELP.PAGE.DRAW:
    IF HELP.PG.LINES = 0 THEN RETURN
    GOSUB HELP.TITLEBAR
    HELP.ONLY = 0 - 1
    GP.IF HELP.SHIFT <> 0 THEN
        GOSUB HELP.PAGE.SHIFT
    GP.ELSE
        ## A sideways move paints over every cell it shows, so nothing is cleared.
        IF HELP.SRC.SIDEWAYS = 0 THEN GP.FILL 0, 1, HELP.COLS, HELP.VIEW, 32, THEME.CLR(THEME.PAGE)
    GP.ENDIF
    HELP.SRC.SIDEWAYS = 0
    FOR HELP.R = 0 TO HELP.VIEW - 1
        HELP.LN = HELP.PG.FROM + HELP.R + 1
        HELP.Y = 1 + HELP.R
        ## HELP.ONLY < 0 is "all of them". Otherwise one row is new and the rest
        ## are already on screen, slid into place.
        IF HELP.ONLY < 0 THEN GOSUB HELP.PAGE.ROW
        IF HELP.ONLY = HELP.R THEN GOSUB HELP.PAGE.ROW
    NEXT HELP.R
    RETURN

## Slide the text region one row rather than repainting it. Rows 1..HELP.VIEW
## move; the bars are outside the rectangle. HELP.ONLY names the row the slide
## exposed, the only one the draw pass paints.
##
## One memory_copy, and the cells never leave VRAM. The two data ports $9F23 and
## $9F24 go in r0 and r1 a row apart, and the KERNAL steps no pointer, so VERA
## walks both itself. Going down the ranges overlap, so both ports start at the
## last byte and VERA's DECR bit walks them backwards.
HELP.PAGE.SHIFT:
    HELP.SC.MAPW = 32 * 2 ^ INT((PEEK(HELPK.LCONFIG) AND 48) / 16)
    HELP.SC.STRIDE = HELP.SC.MAPW * 2
    HELP.SC.BASE = PEEK(HELPK.LMAPBASE) * 512
    HELP.SC.N = (HELP.VIEW - 1) * HELP.SC.STRIDE

    HELP.SC.SRC = HELP.SC.BASE + HELP.SC.STRIDE * 2
    HELP.SC.DST = HELP.SC.BASE + HELP.SC.STRIDE
    HELP.SC.STEP = HELPK.UP
    HELP.ONLY = HELP.VIEW - 1
    GP.IF HELP.SHIFT <> 1 THEN
        HELP.SC.SRC = HELP.SC.BASE + HELP.SC.STRIDE + HELP.SC.N - 1
        HELP.SC.DST = HELP.SC.BASE + HELP.SC.STRIDE * 2 + HELP.SC.N - 1
        HELP.SC.STEP = HELPK.DOWN
        HELP.ONLY = 0
    GP.ENDIF

    HELP.SC.ADDR = HELP.SC.SRC : GOSUB HELP.SC.PORTA
    HELP.SC.ADDR = HELP.SC.DST : GOSUB HELP.SC.PORTB
    POKE 2, HELPK.PORTLO : POKE 3, HELPK.PORTHI
    POKE 4, HELPK.PORTLO.B : POKE 5, HELPK.PORTHI
    HELP.SC.HI = INT(HELP.SC.N / 256)
    POKE 6, HELP.SC.N - HELP.SC.HI * 256 : POKE 7, HELP.SC.HI
    GP.CALL HELPK.MEMCOPY

    ## The exposed row still holds its old text. HELP.PAGE.ROW paints over a
    ## cleared row and does not clear one itself.
    GP.FILL 0, 1 + HELP.ONLY, HELP.COLS, 1, 32, THEME.CLR(THEME.PAGE)
    RETURN

## The two address ports. CTRL bit 0 is ADDRSEL, so $9F20-$9F22 are port 1's
## registers while it is set, and it goes back to 0 for the streaming path.
HELP.SC.PORTA:
    GOSUB HELP.SC.SPLIT
    POKE HELPK.VCTRL, 0
    POKE HELPK.VLO, HELP.SC.LO : POKE HELPK.VMID, HELP.SC.MID
    POKE HELPK.VHI, HELP.SC.BANK + HELP.SC.STEP
    RETURN

HELP.SC.PORTB:
    GOSUB HELP.SC.SPLIT
    POKE HELPK.VCTRL, 1
    POKE HELPK.VLO, HELP.SC.LO : POKE HELPK.VMID, HELP.SC.MID
    POKE HELPK.VHI, HELP.SC.BANK + HELP.SC.STEP
    POKE HELPK.VCTRL, 0
    RETURN

## A VRAM address is 17 bits, so GP.HIBYTE and GP.LOBYTE cannot split it. Bit 16
## comes off first and rides in ADDRH.
HELP.SC.SPLIT:
    HELP.SC.BANK = INT(HELP.SC.ADDR / 65536)
    HELP.SC.REST = HELP.SC.ADDR - HELP.SC.BANK * 65536
    HELP.SC.MID = INT(HELP.SC.REST / 256)
    HELP.SC.LO = HELP.SC.REST - HELP.SC.MID * 256
    RETURN

## A ">" line is "ordinal|text". The ordinal is a HELP.IDX row, resolved by
## MKHELP.PY when it laid the index out.
HELP.PAGE.REF:
    HELP.KIND = 3
    HELP.CUT = GP.INSTR(HELP.BODY$, "|")
    IF HELP.CUT = 0 THEN RETURN
    HELP.TREF = VAL(LEFT$(HELP.BODY$, HELP.CUT - 1))
    HELP.BODY$ = MID$(HELP.BODY$, HELP.CUT + 1)
    IF HELP.TREF < 1 THEN RETURN
    IF HELP.TREF > HELP.IX.N THEN RETURN
    IF HELP.LINKN >= HELP.MAXPICK THEN RETURN
    HELP.LINKN = HELP.LINKN + 1
    HELP.PICK%(HELP.LINKN) = HELP.TREF
    GP.SUB MENU.ITEM, HELP.BODY$
    RETURN

## One row, out of the bank. HELP.LN is the line and HELP.Y the screen row. The
## row must be clear already: the full draw fills the region and a slide fills
## the one row it exposed. A line of an example goes to HELP.SRC.ROW.
HELP.PAGE.ROW:
    IF HELP.LN < 1 THEN RETURN
    IF HELP.LN > HELP.PG.LINES THEN RETURN
    ## WARNING: select the bank every time. STASH selects its own and does not
    ## put ours back, so a row read after a dialog comes out as the stash buffer
    ## and looks like the scroll corrupting the screen.
    BANK HELP.TBANK
    HELP.REC = HELP.WIN + (HELP.LN - 1) * HELP.RECSIZE
    HELP.A = HELP.WIN + PEEK(HELP.REC) + PEEK(HELP.REC + 1) * 256
    HELP.W = PEEK(HELP.REC + 2)
    HELP.KINDBYTE = PEEK(HELP.REC + 3)
    HELP.ROW.BANKIX = INT(HELP.KINDBYTE / HELP.KINDBANK)
    HELP.KIND = HELP.KINDBYTE - HELP.ROW.BANKIX * HELP.KINDBANK
    IF HELP.KIND >= HELP.KIND.SOURCE THEN GOTO HELP.SRC.ROW
    HELP.ATTR = THEME.CLR(THEME.TEXT)
    HELP.INDENT = 2
    GP.IF HELP.KIND = 1 THEN
        GP.FILL 0, HELP.Y, HELP.COLS, 1, 32, THEME.CLR(THEME.TITLE)
        HELP.ATTR = THEME.CLR(THEME.TITLE)
    GP.ENDIF
    IF HELP.KIND = 2 THEN HELP.ATTR = THEME.CLR(THEME.DIMMED)
    GP.IF HELP.KIND = 3 THEN
        HELP.ATTR = THEME.CLR(THEME.WARN)
        GP.PRINTAT 2, HELP.Y, "->", HELP.ATTR
        HELP.INDENT = 5
    GP.ENDIF
    HELP.WMAX = HELP.COLS - HELP.INDENT
    IF HELP.W > HELP.WMAX THEN HELP.W = HELP.WMAX
    ## The line's text bank. A dialog may have run since the record read, so it
    ## is selected here.
    BANK HELP.TEXTBANK + HELP.ROW.BANKIX
    GP.IF HELP.W > 0 THEN
        FOR HELP.I = 0 TO HELP.W - 1
            GP.CHAR HELP.INDENT + HELP.I, HELP.Y, PEEK(HELP.A + HELP.I), HELP.ATTR
        NEXT HELP.I
    GP.ENDIF
    RETURN

## Only what this topic can do. A topic with no ":" lines gets no X in its
## footer, and an example no wider than the page gets no LEFT and RIGHT.
HELP.PAGE.STATUS:
    HELP.HINT$ = "T theme   ESC back"
    IF HELP.HASCODE <> 0 THEN HELP.HINT$ = "X export code   " + HELP.HINT$
    IF HELP.LINKN > 0 THEN HELP.HINT$ = "L links   " + HELP.HINT$
    IF HELP.SRC.MODE <> 0 AND HELP.SRC.LEFTMAX > 0 THEN HELP.HINT$ = "LEFT RIGHT scroll   " + HELP.HINT$
    HELP.NUMV = HELP.PG.FROM + 1 : GOSUB HELP.NUMSTR
    HELP.NOTE$ = "line " + HELP.NUM$
    HELP.NUMV = HELP.PG.LINES : GOSUB HELP.NUMSTR
    HELP.NOTE$ = HELP.NOTE$ + " of " + HELP.NUM$
    GP.IF HELP.SRC.LEFT > 0 THEN
        HELP.NUMV = HELP.SRC.LEFT + 1
        GOSUB HELP.NUMSTR
        HELP.NOTE$ = "column " + HELP.NUM$ + "   " + HELP.NOTE$
    GP.ENDIF
    GOSUB HELP.STATUSBAR
    RETURN


## ============================================================================
## An example program, read as source
##
## An index row of type HELP.IX.EXAMPLE names a file in the GPC-BASIC folder. It
## loads into the same banks as a topic, every line whole, and each row is
## painted in syntax colour by HELP.SRC.SCAN and HELP.SRC.PAINT.
## ============================================================================

## The keywords, one a line. HELP.SRC.PAINT walks the bank's records in order,
## takes the first HELP.SYN.STATEMENTS% as statements and the rest as functions,
## and stops at the first match, so the common words lead. REM is not here:
## HELP.SRC.SCAN finds it. A GP. word needs no line either.
## WARNING: these two must stay the first groups in HELP.KEYBANK, in this order.
## A word over eight characters is never looked up.
GP.BANKEDSTR HELP.KEYBANK HELP.KW.STATEMENT
  "IF"
  "THEN"
  "GOTO"
  "GOSUB"
  "RETURN"
  "FOR"
  "TO"
  "NEXT"
  "STEP"
  "PRINT"
  "AND"
  "OR"
  "NOT"
  "END"
  "POKE"
  "DIM"
  "INPUT"
  "GET"
  "ON"
  "OPEN"
  "CLOSE"
  "DATA"
  "READ"
  "RESTORE"
  "LET"
  "DEF"
  "SYS"
  "STOP"
  "BANK"
  "LOAD"
  "SAVE"
  "LINPUT"
  "BINPUT"
  "SCREEN"
  "COLOR"
  "LOCATE"
  "CLS"
  "RETURNS"
  "BANNER"
  "BASLOAD"
  "BLOAD"
  "BOOT"
  "BSAVE"
  "BVERIFY"
  "BVLOAD"
  "CHAR"
  "CLR"
  "CMD"
  "CODEX"
  "CONT"
  "DOS"
  "EDIT"
  "EXEC"
  "FMCHORD"
  "FMDRUM"
  "FMFREQ"
  "FMINIT"
  "FMINST"
  "FMNOTE"
  "FMPAN"
  "FMPLAY"
  "FMPOKE"
  "FMVIB"
  "FMVOL"
  "FRAME"
  "GEOS"
  "GO"
  "HBLOAD"
  "HELP"
  "I2CPOKE"
  "KEYMAP"
  "LINE"
  "LIST"
  "MENU"
  "MOD"
  "MON"
  "MOUSE"
  "MOVSPR"
  "NEW"
  "OLD"
  "OVAL"
  "POWEROFF"
  "PSET"
  "PSGCHORD"
  "PSGFREQ"
  "PSGINIT"
  "PSGNOTE"
  "PSGPAN"
  "PSGPLAY"
  "PSGVOL"
  "PSGWAV"
  "REBOOT"
  "RECT"
  "REN"
  "RESET"
  "RING"
  "RUN"
  "SLEEP"
  "SPRITE"
  "SPRMEM"
  "TEST"
  "TILE"
  "VERIFY"
  "VLOAD"
  "VPOKE"
  "WAIT"
GP.ENDBANKEDSTR

GP.BANKEDSTR HELP.KEYBANK HELP.KW.FUNCTION
  "LEN"
  "MID$"
  "LEFT$"
  "RIGHT$"
  "CHR$"
  "ASC"
  "STR$"
  "VAL"
  "INT"
  "PEEK"
  "ABS"
  "SGN"
  "RND"
  "FRE"
  "POS"
  "SQR"
  "LOG"
  "EXP"
  "COS"
  "SIN"
  "TAN"
  "ATN"
  "USR"
  "FN"
  "TAB"
  "SPC"
  "PI"
  "VPEEK"
  "HEX$"
  "BIN$"
  "RPT$"
  "STRPTR"
  "JOY"
  "MX"
  "MY"
  "MB"
  "MWHEEL"
  "POINTER"
  "I2CPEEK"
  "TATTR"
  "TDATA"
GP.ENDBANKEDSTR

## The syntax inks, a row a theme in THEME.ID% order. Six foreground colours as
## hex digits: plain text, statement, function, string, number, comment. The
## background is the theme's page colour.
GP.BANKEDSTR HELP.KEYBANK HELP.SYN.INK
  "1ADE8C"
  "FE78D5"
  "046285"
  "1E78D5"
  "1E78D5"
GP.ENDBANKEDSTR

## Every variable the two blobs name, made here: {VAR} needs a slot that already
## exists, so this routine stays above them. The map figures are HELP.PAGE.SHIFT's.
HELP.SYN.SETUP:
    HELP.SYN.KEYBANK% = HELP.KEYBANK
    HELP.SYN.STATEMENTS% = GP.BSTRCOUNT(HELP.KW.STATEMENT)
    HELP.SYN.WORDS% = HELP.SYN.STATEMENTS% + GP.BSTRCOUNT(HELP.KW.FUNCTION)
    HELP.SYN.SOURCE% = 0
    HELP.SYN.TEXTBANK% = 0
    HELP.SYN.LENGTH% = 0
    HELP.SYN.FIRST% = 0
    HELP.SYN.ASMLINE% = 0
    HELP.SYN.TOKSTART% = 0
    HELP.SYN.TOKEND% = 0
    HELP.SYN.TOKLEN% = 0
    HELP.SYN.DOTTED% = 0
    HELP.SYN.RECORD% = 0
    HELP.SYN.LEFT% = 0
    HELP.SYN.RIGHT% = 0
    HELP.SYN.VLO% = 0
    HELP.SYN.VMID% = 0
    HELP.SYN.VHI% = 0
    HELP.SRC.STRIDE = 64 * 2 ^ INT((PEEK(HELPK.LCONFIG) AND 48) / 16)
    HELP.SRC.MAPBASE = PEEK(HELPK.LMAPBASE) * 512
    RETURN

## The theme's six inks over its page colour, into the table HELP.SRC.PAINT
## reads. Every theme change comes through here.
HELP.SYN.INKS:
    HELP.SYN.ROW$ = GP.BSTR(HELP.SYN.INK, THEME.ID%)
    HELP.SYN.PAPER = THEME.CLR(THEME.PAGE) AND 240
    BANK HELP.KEYBANK
    FOR HELP.SYN.SLOT = 0 TO 5
        HELP.SYN.DIGIT = GP.INSTR("0123456789ABCDEF", MID$(HELP.SYN.ROW$, HELP.SYN.SLOT + 1, 1)) - 1
        POKE HELP.SYN.INKTABLE + HELP.SYN.SLOT, HELP.SYN.PAPER + HELP.SYN.DIGIT
    NEXT HELP.SYN.SLOT
    ## Class 6 is a word the table does not hold, and takes the plain ink.
    POKE HELP.SYN.INKTABLE + 6, PEEK(HELP.SYN.INKTABLE)
    RETURN

## The file an example row names, read into the banks. The row's text is two
## spaces and the file name, which ends at the first space or the end of the
## row. The folder beside the program is tried first and the one in /GPC/
## second.
HELP.SRC.LOAD:
    HELP.SRC.MODE = 1
    GOSUB HELP.IXTEXT
    HELP.SRC.FILE$ = MID$(HELP.ROW$, 3)
    HELP.CUT = GP.INSTR(HELP.SRC.FILE$, " ")
    IF HELP.CUT > 0 THEN HELP.SRC.FILE$ = LEFT$(HELP.SRC.FILE$, HELP.CUT - 1)
    HELP.SRC.FOLDER$ = "//GPC-BASIC/:"
    GOSUB HELP.SRC.READ
    IF HELP.PG.LINES > 0 THEN GOTO HELP.SRC.LOADED
    HELP.SRC.FOLDER$ = "//GPC/GPC-BASIC/:"
    GOSUB HELP.SRC.READ
HELP.SRC.LOADED:
    ## How far RIGHT can go: until the longest line's end is on the page, in
    ## whole steps. HELP.SRC.PAINT counts columns in one byte, which is the cap.
    HELP.SRC.LEFTMAX = INT((HELP.SRC.WIDEST - HELP.COLS + HELP.SRC.STEP) / HELP.SRC.STEP) * HELP.SRC.STEP
    IF HELP.SRC.LEFTMAX < 0 THEN HELP.SRC.LEFTMAX = 0
    IF HELP.SRC.LEFTMAX > HELP.SRC.LEFTCAP THEN HELP.SRC.LEFTMAX = HELP.SRC.LEFTCAP
    RETURN

## One attempt, from HELP.SRC.FOLDER$. No line has a marker: each is stored
## whole, as HELP.KIND.SOURCE or HELP.KIND.ASMLINE. HELP.PG.LINES stays 0 when
## the file is not there.
HELP.SRC.READ:
    HELP.NAME$ = HELP.SRC.FOLDER$ + HELP.SRC.FILE$
    GOSUB HELP.PAGE.LOADING
    HELP.TITLE$ = HELP.SRC.FILE$
    HELP.SRC.INASM = 0
    HELP.SRC.WIDEST = 0
    OPEN HELP.CHAN, 8, HELP.CHAN, HELP.NAME$ + ",S,R"
HELP.SRC.READ.LINE:
    LINPUT# HELP.CHAN, HELP.LINE$, 10
    HELP.ST = ST
    IF (HELP.ST AND 2) <> 0 THEN GOTO HELP.LOAD.CLOSE
    HELP.PG.LINES = HELP.PG.LINES + 1
    HELP.LP = GP.STRPTR(HELP.LINE$)
    HELP.LL = LEN(HELP.LINE$)
    IF HELP.LL > 0 THEN IF PEEK(HELP.LP + HELP.LL) = 13 THEN HELP.LL = HELP.LL - 1
    GOSUB HELP.SRC.ASMSTATE
    HELP.SP = HELP.LP + 1
    HELP.W = HELP.LL
    GOSUB HELP.LOAD.STORE
    IF HELP.W > HELP.SRC.WIDEST THEN HELP.SRC.WIDEST = HELP.W
    IF HELP.PG.LINES >= HELP.MAXLINES THEN GOTO HELP.LOAD.CLOSE
    ## Bit 6 is the end. HELP.IDXLOAD has the note on ST.
    IF (HELP.ST AND 64) = 0 THEN GOTO HELP.SRC.READ.LINE
    GOTO HELP.LOAD.CLOSE

## HELP.KIND for the line in HELP.LINE$: HELP.KIND.ASMLINE between GP.ASM and
## GP.ENDASM, HELP.KIND.SOURCE everywhere else and for those two lines. Either
## keyword counts only as the first word on its line, so a comment that names
## one changes nothing.
HELP.SRC.ASMSTATE:
    HELP.SRC.WORD$ = "GP.ENDASM"
    GOSUB HELP.SRC.LEADS
    IF HELP.SRC.FOUND <> 0 THEN HELP.SRC.INASM = 0
    HELP.KIND = HELP.KIND.SOURCE
    IF HELP.SRC.INASM <> 0 THEN HELP.KIND = HELP.KIND.ASMLINE
    HELP.SRC.WORD$ = "GP.ASM"
    GOSUB HELP.SRC.LEADS
    IF HELP.SRC.FOUND <> 0 THEN HELP.SRC.INASM = 1
    RETURN

## HELP.SRC.FOUND is 1 when HELP.SRC.WORD$ is the first thing on HELP.LINE$,
## with only spaces in front of it.
HELP.SRC.LEADS:
    HELP.SRC.FOUND = 0
    HELP.SRC.AT = GP.INSTR(HELP.LINE$, HELP.SRC.WORD$)
    IF HELP.SRC.AT = 0 THEN RETURN
    IF HELP.SRC.AT > LEN(HELP.SPACES$) THEN RETURN
    IF LEFT$(HELP.LINE$, HELP.SRC.AT - 1) = LEFT$(HELP.SPACES$, HELP.SRC.AT - 1) THEN HELP.SRC.FOUND = 1
    RETURN

## The example was in neither folder. Say so, then go back the way ESC does.
## Reached by GOTO from HELP.TOPIC, so the RETURN is that routine's.
HELP.SRC.MISSING:
    HELP.MSG.ONE$ = "Not found: " + HELP.SRC.FILE$
    HELP.MSG.TWO$ = "Examples are read from the GPC-BASIC folder."
    GOSUB HELP.SAY
    GOSUB HELP.BACK.POP
    IF HELP.NAV = 2 THEN RETURN
    GOTO HELP.TOPIC.ENTER

## LEFT and RIGHT. HELP.SRC.DIR is -1 or 1. A source page moves HELP.SRC.STEP
## columns and repaints in place. A topic page has nothing off to the side.
HELP.SRC.SIDE:
    IF HELP.SRC.MODE = 0 THEN RETURN
    HELP.SRC.WAS = HELP.SRC.LEFT
    HELP.SRC.LEFT = HELP.SRC.LEFT + HELP.SRC.DIR * HELP.SRC.STEP
    IF HELP.SRC.LEFT > HELP.SRC.LEFTMAX THEN HELP.SRC.LEFT = HELP.SRC.LEFTMAX
    IF HELP.SRC.LEFT < 0 THEN HELP.SRC.LEFT = 0
    IF HELP.SRC.LEFT = HELP.SRC.WAS THEN RETURN
    HELP.SRC.SIDEWAYS = 1
    HELP.REDRAW = 1
    RETURN

## One source row. HELP.A, HELP.W, HELP.KIND and HELP.ROW.BANKIX are the line's
## record as HELP.PAGE.ROW read it, and HELP.Y is the screen row. The text
## starts one column in, like the index.
HELP.SRC.ROW:
    HELP.SYN.SOURCE% = HELP.A
    HELP.SYN.LENGTH% = HELP.W
    HELP.SYN.TEXTBANK% = HELP.TEXTBANK + HELP.ROW.BANKIX
    HELP.SYN.ASMLINE% = 0
    IF HELP.KIND = HELP.KIND.ASMLINE THEN HELP.SYN.ASMLINE% = 1
    HELP.SYN.LEFT% = HELP.SRC.LEFT
    HELP.SYN.RIGHT% = HELP.SRC.LEFT + HELP.COLS - 1
    HELP.SC.ADDR = HELP.SRC.MAPBASE + HELP.Y * HELP.SRC.STRIDE + 2
    GOSUB HELP.SC.SPLIT
    HELP.SYN.VLO% = HELP.SC.LO
    HELP.SYN.VMID% = HELP.SC.MID
    HELP.SYN.VHI% = HELP.SC.BANK + HELPK.UP
    GOSUB HELP.SRC.SCAN
    GOSUB HELP.SRC.PAINT
    RETURN

## ============================================================================
## The line into the buffer, then a class for every column of it.
##
##   in   HELP.SYN.SOURCE%     the line's address in its text bank
##        HELP.SYN.TEXTBANK%   that bank
##        HELP.SYN.LENGTH%     its length, HELP.SRC.MAXWIDE at most
##        HELP.SYN.ASMLINE%    1 inside a GP.ASM block
##   out  the text at $BE00 and the classes at $BF00, both in HELP.KEYBANK
##
## The classes: 0 plain, 1 statement, 2 function, 3 string, 4 number,
## 5 comment, 6 a word HELP.SRC.PAINT has still to look up.
##
## A word is letters, digits and dots, with the $ or % that types it. REM is
## the one word looked at here. It turns the rest of the line into a comment,
## except on an assembly line, where it is a statement and ";" starts the
## comment. A "#" that leads the line is a directive, and "##" is a comment
## anywhere.
##
## zTemp0 is the source pointer. X is the column from the scan on.
## ============================================================================
HELP.SRC.SCAN:
    #REM 1
    GP.ASM
    REM CLD
    REM LDA {HELP.SYN.SOURCE%}       ; the line -> zTemp0
    REM STA $2C
    REM LDX #1
    REM LDA {HELP.SYN.SOURCE%},X
    REM STA $2D
    REM LDA $00                      ; the bank we were handed, to put back
    REM PHA
    REM ; ---- the line, out of its text bank and into the buffer ----
    REM LDX {HELP.SYN.KEYBANK%}
    REM LDY #0
    REM FLP: CPY {HELP.SYN.LENGTH%}
    REM BEQ FEND
    REM LDA {HELP.SYN.TEXTBANK%}
    REM STA $00
    REM LDA ($2C),Y
    REM STX $00
    REM STA $BE00,Y
    REM INY
    REM BNE FLP
    REM FEND: STX $00
    REM LDA #0                       ; the end marker every loop below stops on
    REM STA $BE00,Y
    REM ; ---- the first column that is not a space ----
    REM LDY #0
    REM FSP: LDA $BE00,Y
    REM CMP #$20
    REM BNE FGOT
    REM INY
    REM BNE FSP
    REM FGOT: STY {HELP.SYN.FIRST%}
    REM LDX #0
    REM BRA MAIN
    REM ; ---- a number: digits, a dot, and the letters of hex ----
    REM NUMBER: LDA #4
    REM STA $BF00,X
    REM INX
    REM LDA $BE00,X
    REM CMP #$2E
    REM BEQ NUMBER
    REM JSR ISDIG
    REM BCC NUMBER
    REM JSR ISLET
    REM BCC NUMBER
    REM BRA MAIN
    REM ; ---- a string, to its closing quote or the end of the line ----
    REM STRING: LDA #3
    REM STA $BF00,X
    REM INX
    REM LDA $BE00,X
    REM BEQ MAIN
    REM CMP #$22
    REM BNE STRING
    REM LDA #3                       ; the closing quote
    REM BRA PUTONE
    REM PLAIN: LDA #0
    REM PUTONE: STA $BF00,X
    REM INX
    REM ; ---- what the next column starts ----
    REM MAIN: CPX {HELP.SYN.LENGTH%}
    REM BCS DONE
    REM LDA $BE00,X
    REM CMP #$22                     ; a quote
    REM BEQ STRING
    REM CMP #$24                     ; $ and % lead a number
    REM BEQ NUMBER
    REM CMP #$25
    REM BEQ NUMBER
    REM CMP #$23                     ; #
    REM BEQ HASH
    REM CMP #$3B                     ; ;
    REM BEQ SEMI
    REM JSR ISDIG
    REM BCC NUMBER
    REM JSR ISLET
    REM BCS PLAIN
    REM JMP WORD
    REM ; ---- two of them are a comment, one leading the line is a directive ----
    REM HASH: LDA $BE01,X
    REM CMP #$23
    REM BEQ REST
    REM CPX {HELP.SYN.FIRST%}
    REM BNE PLAIN
    REM DIRLP: LDA #1
    REM STA $BF00,X
    REM INX
    REM LDA $BE00,X
    REM JSR ISLET
    REM BCC DIRLP
    REM BRA MAIN
    REM SEMI: LDA {HELP.SYN.ASMLINE%}
    REM BEQ PLAIN
    REM ; ---- a comment, from X to the end of the line ----
    REM REST: LDA #5
    REM RESTLP: STA $BF00,X
    REM INX
    REM CPX {HELP.SYN.LENGTH%}
    REM BCC RESTLP
    REM DONE: LDX {HELP.SYN.LENGTH%}     ; a class 6 word must end with the line
    REM STZ $BF00,X
    REM PLA
    REM STA $00
    REM RTS
    REM ; ---- carry clear when A is a digit. A is kept. ----
    REM ISDIG: PHA
    REM SEC
    REM SBC #$30
    REM CMP #10
    REM PLA
    REM RTS
    REM ; ---- carry clear when A is a letter of either case. A is kept. ----
    REM ISLET: PHA
    REM AND #$DF
    REM SEC
    REM SBC #$41
    REM CMP #26
    REM PLA
    REM RTS
    REM ; ---- a word, marked class 6 from its first column to its last ----
    REM WORD: STX {HELP.SYN.TOKSTART%}
    REM WLP: LDA #6
    REM STA $BF00,X
    REM INX
    REM LDA $BE00,X
    REM JSR ISLET
    REM BCC WLP
    REM JSR ISDIG
    REM BCC WLP
    REM CMP #$2E                     ; .
    REM BEQ WLP
    REM CMP #$24                     ; $
    REM BEQ WLP
    REM CMP #$25                     ; %
    REM BEQ WLP
    REM ; ---- three letters long and they fold to R, E, M ----
    REM TXA
    REM SEC
    REM SBC {HELP.SYN.TOKSTART%}
    REM CMP #3
    REM BNE WOUT
    REM LDY {HELP.SYN.TOKSTART%}
    REM LDA $BE00,Y
    REM AND #$DF
    REM CMP #$52
    REM BNE WOUT
    REM LDA $BE01,Y
    REM AND #$DF
    REM CMP #$45
    REM BNE WOUT
    REM LDA $BE02,Y
    REM AND #$DF
    REM CMP #$4D
    REM BNE WOUT
    REM LDA {HELP.SYN.ASMLINE%}
    REM BNE REMKEY
    REM LDX {HELP.SYN.TOKSTART%}     ; the comment starts at the R
    REM JMP REST
    REM REMKEY: LDA #1
    REM STA $BF00,Y
    REM STA $BF01,Y
    REM STA $BF02,Y
    REM WOUT: JMP MAIN
    GP.ENDASM
    #REM 0
    RETURN

## ============================================================================
## The words looked up, then the row painted.
##
##   in   the text at $BE00 and the classes at $BF00, as HELP.SRC.SCAN left them
##        HELP.SYN.LEFT%       the first column shown
##        HELP.SYN.RIGHT%      one past the last, 255 at most
##        HELP.SYN.VLO% .VMID% .VHI%   the row's first cell, as VERA takes it
##
## A class 6 word becomes a statement when GP. leads it, or when the table holds
## it among the statements. It becomes a function when the table holds it among
## the functions. Any other stays at 6, and ink 6 is the plain ink. An assembly
## line is not looked up at all.
##
## The table is the GP.BSTR image: a count at $A000, then two bytes a record
## from $A002, the offset from $A000 to the record's length byte. zTemp1 walks
## that directory and zTemp2 is the record.
##
## The row is padded with spaces as far as HELP.SYN.RIGHT%, so it needs no
## clearing first.
## ============================================================================
HELP.SRC.PAINT:
    #REM 1
    GP.ASM
    REM CLD
    REM LDA $00                      ; the bank we were handed, to put back
    REM PHA
    REM LDA {HELP.SYN.KEYBANK%}
    REM STA $00
    REM LDA {HELP.SYN.ASMLINE%}
    REM BEQ WFIRST
    REM JMP PAINT
    REM WFIRST: LDX #0
    REM ; ---- the next class 6 word, from X ----
    REM WSCAN: CPX {HELP.SYN.LENGTH%}
    REM BCC WLOOK
    REM JMP PAINT
    REM WLOOK: LDA $BF00,X
    REM CMP #6
    REM BEQ WFOUND
    REM INX
    REM BNE WSCAN
    REM WFOUND: STX {HELP.SYN.TOKSTART%}
    REM STZ {HELP.SYN.DOTTED%}
    REM WEND: LDA $BE00,X
    REM CMP #$2E
    REM BNE WNODOT
    REM STA {HELP.SYN.DOTTED%}
    REM WNODOT: INX
    REM LDA $BF00,X
    REM CMP #6
    REM BEQ WEND
    REM STX {HELP.SYN.TOKEND%}
    REM LDA {HELP.SYN.DOTTED%}
    REM BEQ WTABLE
    REM ; ---- a dotted word is a statement only when G, P and a dot lead it ----
    REM LDY {HELP.SYN.TOKSTART%}
    REM LDA $BE00,Y
    REM AND #$DF
    REM CMP #$47
    REM BNE WSCAN
    REM LDA $BE01,Y
    REM AND #$DF
    REM CMP #$50
    REM BNE WSCAN
    REM LDA $BE02,Y
    REM CMP #$2E
    REM BNE WSCAN
    REM LDA #1
    REM JMP WPAINT
    REM ; ---- no keyword is one character, or longer than eight ----
    REM WTABLE: TXA
    REM SEC
    REM SBC {HELP.SYN.TOKSTART%}
    REM STA {HELP.SYN.TOKLEN%}
    REM CMP #2
    REM BCC WSCAN
    REM CMP #9
    REM BCS WSCAN
    REM LDA #$02                     ; the directory -> zTemp1
    REM STA $2E
    REM LDA #$A0
    REM STA $2F
    REM STZ {HELP.SYN.RECORD%}
    REM ; ---- the record -> zTemp2, and the directory on to the next ----
    REM RECLP: LDY #0
    REM LDA ($2E),Y
    REM STA $30
    REM INY
    REM LDA ($2E),Y
    REM CLC
    REM ADC #$A0
    REM STA $31
    REM CLC
    REM LDA $2E
    REM ADC #2
    REM STA $2E
    REM LDA $2F
    REM ADC #0
    REM STA $2F
    REM LDA ($30)                    ; the length byte, then the letters from 1
    REM CMP {HELP.SYN.TOKLEN%}
    REM BNE RECNXT
    REM LDY #1
    REM LDX {HELP.SYN.TOKSTART%}
    REM CMPLP: LDA $BE00,X
    REM CMP #$61                     ; lower case folds to upper
    REM BCC CMPGO
    REM AND #$DF
    REM CMPGO: CMP ($30),Y
    REM BNE RECNXT
    REM INX
    REM INY
    REM CPX {HELP.SYN.TOKEND%}
    REM BNE CMPLP
    REM LDA #1                       ; found: the record number says which kind
    REM LDY {HELP.SYN.RECORD%}
    REM CPY {HELP.SYN.STATEMENTS%}
    REM BCC WPAINT
    REM LDA #2
    REM BRA WPAINT
    REM RECNXT: INC {HELP.SYN.RECORD%}
    REM LDA {HELP.SYN.RECORD%}
    REM CMP {HELP.SYN.WORDS%}
    REM BNE RECLP
    REM LDX {HELP.SYN.TOKEND%}       ; not in the table
    REM JMP WSCAN
    REM ; ---- class A over the whole word ----
    REM WPAINT: LDX {HELP.SYN.TOKSTART%}
    REM WPLP: STA $BF00,X
    REM INX
    REM CPX {HELP.SYN.TOKEND%}
    REM BNE WPLP
    REM JMP WSCAN
    REM ; ---- the row: a character and its ink, a cell ----
    REM PAINT: STZ $9F25
    REM LDA {HELP.SYN.VLO%}
    REM STA $9F20
    REM LDA {HELP.SYN.VMID%}
    REM STA $9F21
    REM LDA {HELP.SYN.VHI%}
    REM STA $9F22
    REM LDX {HELP.SYN.LEFT%}
    REM CELL: CPX {HELP.SYN.LENGTH%}
    REM BCS PAD
    REM LDA $BE00,X
    REM STA $9F23
    REM LDY $BF00,X
    REM LDA $BDF0,Y
    REM STA $9F23
    REM INX
    REM CPX {HELP.SYN.RIGHT%}
    REM BCC CELL
    REM BCS PDONE
    REM PAD: LDA #$20
    REM STA $9F23
    REM LDA $BDF0
    REM STA $9F23
    REM INX
    REM CPX {HELP.SYN.RIGHT%}
    REM BCC PAD
    REM PDONE: PLA
    REM STA $00
    GP.ENDASM
    #REM 0
    RETURN


## ============================================================================
## Cross references, and the way back
## ============================================================================

HELP.LINKS:
    ## The footer is the contract. It does not offer L on a topic with no cross
    ## references, so the key does nothing. Same rule as X in HELP.EXPORT.
    IF HELP.LINKN = 0 THEN RETURN
    HELP.LINKSEL = GP.FN(PICKMENUEX, "SEE ALSO", "Follow", "", "", 1, 0)
    HELP.REDRAW = 1
    IF HELP.LINKSEL < 1 THEN RETURN
    GOSUB HELP.BACK.PUSH
    HELP.GO = HELP.PICK%(HELP.LINKSEL)
    HELP.PG.FROM = 0
    HELP.NAV = 1
    RETURN

HELP.BACK.PUSH:
    IF HELP.BACK.N >= HELP.MAXBACK THEN RETURN
    HELP.BACK.N = HELP.BACK.N + 1
    HELP.BACK.GO%(HELP.BACK.N) = HELP.GO
    HELP.BACK.AT%(HELP.BACK.N) = HELP.PG.FROM
    RETURN

## ESC. One step back along the links that got here, and the index when there
## are none left.
HELP.BACK.POP:
    IF HELP.BACK.N < 1 THEN HELP.NAV = 2 : RETURN
    HELP.GO = HELP.BACK.GO%(HELP.BACK.N)
    HELP.PG.FROM = HELP.BACK.AT%(HELP.BACK.N)
    HELP.BACK.N = HELP.BACK.N - 1
    HELP.NAV = 1
    RETURN


## ============================================================================
## Export -- the code out of a topic, as something BASLOAD can read
## ============================================================================

HELP.EXPORT:
    IF HELP.HASCODE = 0 THEN RETURN
    HELP.OUTNAME$ = GP.FN(INPUTBOXEX, "EXPORT", "Write this topic's code to:", "", "", "EXAMPLE.BL", 24, 0)
    HELP.REDRAW = 1
    IF GUI.OK = 0 THEN RETURN
    IF HELP.OUTNAME$ = "" THEN RETURN

    ## Channel 2 reads the topic and channel 3 writes the export. "@:" replaces.
    ## The lines are ASCII already, which is what BASLOAD reads.
    HELP.IXR = HELP.GO : GOSUB HELP.IXREAD
    HELP.TOPICNUM = HELP.IXTOPIC : GOSUB HELP.FILENAME
    HELP.CNT = 0
    OPEN 3, 8, 3, "@:" + HELP.OUTNAME$ + ",S,W"
    PRINT# 3, "## " + HELP.TITLE$
    PRINT# 3, "## exported by GPC.HELP from " + HELP.NAME$
    PRINT# 3, ""
    OPEN HELP.CHAN, 8, HELP.CHAN, HELP.NAME$ + ",S,R"
HELP.EXPORT.LOOP:
    LINPUT# HELP.CHAN, HELP.LINE$, 10 : HELP.ST = ST
    IF (HELP.ST AND 2) <> 0 THEN GOTO HELP.EXPORT.DONE
    GOSUB HELP.STRIP
    IF LEFT$(HELP.LINE$, 1) = ":" THEN GOSUB HELP.EXPORT.WRITE
    ## Bit 6 only. This loop is where ST = 128 comes from, since channel 3 is
    ## open for writing while channel 2 is being read.
    IF (HELP.ST AND 64) = 0 THEN GOTO HELP.EXPORT.LOOP
HELP.EXPORT.DONE:
    CLOSE HELP.CHAN
    CLOSE 3

    HELP.NUMV = HELP.CNT : GOSUB HELP.NUMSTR
    HELP.MSG.ONE$ = "Wrote " + HELP.NUM$ + " lines to " + HELP.OUTNAME$
    HELP.MSG.TWO$ = "It is source, not a program: BASLOAD it."
    IF HELP.CNT = 0 THEN HELP.MSG.TWO$ = "This topic had no code in it."
    GOSUB HELP.SAY
    RETURN

HELP.EXPORT.WRITE:
    HELP.CNT = HELP.CNT + 1
    PRINT# 3, MID$(HELP.LINE$, 2)
    RETURN


## ============================================================================
## Find, over the index that is already in memory
## ============================================================================

HELP.FIND.ASK:
    HELP.ASKED$ = GP.FN(INPUTBOXEX, "FIND", "Find in the index:", "", "", HELP.FIND$, 30, 0)
    HELP.FULL = 1
    IF GUI.OK = 0 THEN RETURN
    ## The "" is what makes it a copy. Assigning one string to another can hand
    ## over the same block, and STRCASE rewrites the bytes where they lie.
    HELP.FIND$ = HELP.ASKED$ + ""
    IF HELP.FIND$ = "" THEN RETURN
    STRCASE.PTR = GP.STRPTR(HELP.FIND$) : STRCASE.MODE = STRCASE.UPPER
    GOSUB STRCASE.GO
    GOSUB HELP.FIND.RUN
    RETURN

HELP.FIND.NEXT:
    IF HELP.FIND$ = "" THEN GOSUB HELP.FIND.ASK : RETURN
    GOSUB HELP.FIND.RUN
    RETURN

## The first selectable entry after the highlight that contains the needle,
## wrapping once. Case is folded on a copy, as in HELP.FIND.ASK.
HELP.FIND.RUN:
    HELP.J = HELP.IX.SEL
    HELP.TRIES = 0
HELP.FIND.SCAN:
    HELP.TRIES = HELP.TRIES + 1
    IF HELP.TRIES > HELP.IX.N THEN GOTO HELP.FIND.MISS
    HELP.J = HELP.J + 1
    IF HELP.J > HELP.IX.N THEN HELP.J = 1
    HELP.IXR = HELP.J : GOSUB HELP.IXREAD
    IF HELP.IXTYPE = 0 THEN GOTO HELP.FIND.SCAN
    GOSUB HELP.IXTEXT
    HELP.HAY$ = HELP.ROW$ + ""
    STRCASE.PTR = GP.STRPTR(HELP.HAY$) : STRCASE.MODE = STRCASE.UPPER
    GOSUB STRCASE.GO
    IF GP.INSTR(HELP.HAY$, HELP.FIND$) = 0 THEN GOTO HELP.FIND.SCAN
    HELP.IX.SEL = HELP.J
    GOSUB HELP.IX.SHOW
    HELP.FULL = 1
    RETURN
HELP.FIND.MISS:
    HELP.MSG.ONE$ = "Not found: " + HELP.FIND$
    HELP.MSG.TWO$ = ""
    GOSUB HELP.SAY
    HELP.FULL = 1
    RETURN


## ============================================================================
## Small dialogs, and the two bars
## ============================================================================

HELP.SAY:
    GP.SUB MSGBOXEX, "GPC.HELP", HELP.MSG.ONE$, HELP.MSG.TWO$, "", ""
    RETURN

## HELP.CENTRE -- HELP.PAD.TEXT$ padded out to HELP.PAD.WIDE with the text in
## the middle. Text already that wide is left alone.
HELP.CENTRE:
    HELP.PAD.GAP = HELP.PAD.WIDE - LEN(HELP.PAD.TEXT$)
    IF HELP.PAD.GAP < 1 THEN RETURN
    HELP.PAD.HALF = INT(HELP.PAD.GAP / 2)
    HELP.PAD.TEXT$ = LEFT$(HELP.SPACES$, HELP.PAD.HALF) + HELP.PAD.TEXT$ + LEFT$(HELP.SPACES$, HELP.PAD.GAP - HELP.PAD.HALF)
    RETURN

## HELP.ABOUT -- what the program is, and what the machine has left.
HELP.ABOUT:
    GOSUB BANKMGR.COUNT
    HELP.ABOUT.WHAT$ = "The GP.BASIC and BASL reference"
    HELP.ABOUT.WHO$ = "For the X16 GPC-BASIC compiler (C)SADLOGIC - 2026"
    HELP.ABOUT.MEM$ = "Total banks" + STR$(BANKMGR.BANKS) + "   Unused" + STR$(BANKMGR.SPARE) + "   Bytes free" + STR$(FRE(0))
    HELP.PAD.WIDE = LEN(HELP.ABOUT.MEM$) + 6
    IF LEN(HELP.ABOUT.WHO$) > HELP.PAD.WIDE THEN HELP.PAD.WIDE = LEN(HELP.ABOUT.WHO$)
    HELP.PAD.TEXT$ = HELP.ABOUT.WHAT$ : GOSUB HELP.CENTRE : HELP.ABOUT.WHAT$ = HELP.PAD.TEXT$
    HELP.PAD.TEXT$ = HELP.ABOUT.WHO$ : GOSUB HELP.CENTRE : HELP.ABOUT.WHO$ = HELP.PAD.TEXT$
    GP.SUB MSGBOXEX, "ABOUT GPC.HELP", HELP.ABOUT.WHAT$, HELP.ABOUT.WHO$, HELP.ABOUT.MEM$, "&OK"
    HELP.FULL = 1
    RETURN

HELP.ASKQUIT:
    HELP.DONE = GP.FN(ASKYNEX, "GPC.HELP", "Leave the help viewer?", "", "", 1, 0)
    HELP.FULL = 1
    RETURN

## THEME.HI trades an attribute's nibbles, which turns white-on-black text into
## a black-on-white bar. The two bars are worked out on a theme change, so every
## theme change has to come back through here.
HELP.THEME.NEXT:
    GOSUB THEME.NEXT
    GOTO HELP.THEME.BARS

HELP.THEME.SET:
    GOSUB THEME.SELECT
HELP.THEME.BARS:
    THEME.ATTR% = THEME.CLR(THEME.TITLE)  : GOSUB THEME.HI : HELP.BAR.TOP = THEME.INV%
    THEME.ATTR% = THEME.CLR(THEME.DIMMED) : GOSUB THEME.HI : HELP.BAR.BOT = THEME.INV%
    GOSUB HELP.SYN.INKS
    RETURN

## The bars are filled once a page. Filling a row and printing over it leaves
## the bar empty in between, and the status bar is redrawn on every pass of the
## key loop, which flickers under a held arrow key.
HELP.PAGE.FRAME:
    GP.FILL 0, 0, HELP.COLS, HELP.ROWS, 32, THEME.CLR(THEME.PAGE)
    GP.FILL 0, 0, HELP.COLS, 1, 32, HELP.BAR.TOP
    GP.FILL 0, HELP.ROWS - 1, HELP.COLS, 1, 32, HELP.BAR.BOT
    RETURN

## The tail is cleared. The title is set twice, the index text and then the
## topic's own "@" record, and a shorter second would leave the first's end.
HELP.TITLEBAR:
    GP.PRINTAT 1, 0, HELP.TITLE$, HELP.BAR.TOP
    HELP.X = 1 + LEN(HELP.TITLE$)
    IF HELP.X < HELP.COLS THEN GP.FILL HELP.X, 0, HELP.COLS - HELP.X, 1, 32, HELP.BAR.TOP
    RETURN

HELP.STATUSBAR:
    GP.PRINTAT 1, HELP.ROWS - 1, HELP.HINT$, HELP.BAR.BOT
    HELP.X = 1 + LEN(HELP.HINT$)
    HELP.NX = HELP.COLS
    IF HELP.NOTE$ <> "" THEN HELP.NX = HELP.COLS - LEN(HELP.NOTE$) - 1
    ## The gap, so a note that shrinks by a digit leaves no tail behind.
    IF HELP.NX > HELP.X THEN GP.FILL HELP.X, HELP.ROWS - 1, HELP.NX - HELP.X, 1, 32, HELP.BAR.BOT
    IF HELP.NOTE$ <> "" THEN GP.PRINTAT HELP.NX, HELP.ROWS - 1, HELP.NOTE$, HELP.BAR.BOT
    RETURN

## STR$ leads a positive number with a space.
HELP.NUMSTR:
    HELP.NUM$ = STR$(HELP.NUMV)
    IF LEFT$(HELP.NUM$, 1) = " " THEN HELP.NUM$ = MID$(HELP.NUM$, 2)
    RETURN

## One key, in HELP.KEY. KBCLEAR drains the rest of the queue: a held arrow
## repeats faster than a page is drawn, and the queue keeps scrolling after the
## key is let go.
HELP.GETKEY:
    HELP.KEY = 0
HELP.GETKEY.WAIT:
    GET HELP.IN$
    IF HELP.IN$ = "" THEN GOTO HELP.GETKEY.WAIT
    HELP.KEY = ASC(HELP.IN$)
    GP.SUB KBCLEAR
    RETURN

