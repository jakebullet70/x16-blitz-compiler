## ***********************************************************************
## **
## **  BMX.INC.BL -- load a BMX bitmap into VERA.
## **
## **      BMX.OPEN    open the file and read its 32 byte header
## **      BMX.PAINT   palette and pixels into VRAM, then close
## **      BMX.SHOW    both, for when you already trust the file
## **      BMX.CLOSE   abandon a file opened by BMX.OPEN
## **      BMX.RESTORE put the machine's own palette back
## **
## **  BMX.OPEN also has a verb. GP.FN(BMX.LOAD, F$) fills BMX.FILE$, opens the
## **  file and gives back BMX.ERROR$, so the open and its test are one statement.
## **
## **  Usage, the short way -- a title screen:
## **
## **      BMX.FILE$ = "TITLE.BMX"
## **      SCREEN 128
## **      GOSUB BMX.SHOW
## **      IF BMX.ERROR$ <> "" THEN PRINT BMX.ERROR$
## **
## **  Usage, the careful way -- when you want the size before you commit
## **  to a screen mode, or want to report a bad file without the display
## **  already torn down:
## **
## **      BMX.FILE$ = F$
## **      GOSUB BMX.OPEN
## **      IF BMX.ERROR$ <> "" THEN GOTO COMPLAIN
## **      ... BMX.WIDTH, BMX.HEIGHT, BMX.PALUSED are readable here ...
## **      SCREEN 128
## **      GOSUB BMX.PAINT
## **
## **  SET THE SCREEN MODE BEFORE BMX.PAINT, NOT AFTER: SCREEN reloads the default
## **  palette, so a mode change afterwards leaves the right pixels in the wrong
## **  colours, which reads as a corrupt file rather than a mistake.
## **
## **  8 bits per pixel, uncompressed -- what SCREEN 128 shows without a decompressor.
## **  Anything else is reported, not attempted.
## **
## **  THE PALETTE IS BORROWED, NOT TAKEN. Nothing on the X16 puts it back -- neither
## **  SCREEN nor screen_mode restores it, measured rather than assumed -- so BMX.PAINT
## **  stashes all 256 entries in spare VRAM and BMX.RESTORE writes them back:
## **
## **      BMX.FILE$ = "TITLE.BMX"
## **      SCREEN 128
## **      GOSUB BMX.SHOW
## **      ... the title screen ...
## **      GOSUB BMX.RESTORE
## **
## **  A caller that owns the machine need never call it; one handing the machine back
## **  calls it and is done, without learning where the palette lives or how many
## **  entries the picture claimed. Both halves are ONE KERNAL CALL: memory_copy leaves
## **  an address in $9F00-$9FFF unstepped, so with VERA's two ports at each end the
## **  copy happens inside VRAM.
## **
## **  BMX.STASH IS SPARE VRAM, defaulting to $13000 just above the 320x240
## **  framebuffer. Free in the mode this paints into, but a caller with tiles, sprites
## **  or a second bitmap up there must move it or switch it off:
## **
## **      BMX.STASH = -1     keep nothing; BMX.RESTORE becomes a no-op
## **
## **  MINUS ONE AND NOT ZERO, because zero is what the variable holds before anyone
## **  touches it and BMX.INIT must tell "not set" from "set to off". It is checked, not
## **  trusted: a stash inside the bitmap, or running into the PSG at $1F9C0, is
## **  reported and nothing is painted.
## **
## **  THE INCLUDING PROGRAM NEEDS A #SYMFILE, placed above its #INCLUDEs:
## **
## **      #SYMFILE "@:YOURPROG.SYM"
## **
## **  BMX.MOVE reaches BASIC's variables from assembly and #SYMFILE is the name map.
## **  The compiler derives the name from the PRG it is compiling, so the directive
## **  must match it. Without one the compile stops with ?STRING TOO LONG ERROR,
## **  which names neither this file nor the cause.
## **
## **  The whole BMX.* name space belongs to this file.
## **
## **  TO RUN IT FROM A RAM BANK, put the #INCLUDE between GP.BANKED and
## **  GP.ENDBANKED. A call from outside the region selects the region's bank
## **  and RETURN puts the caller's back, so a caller is written the same
## **  either way. GPC-BASIC/BANKED-OR-NOT.md has the rules.
## **
## **  Its MACPTR reads land in VRAM and in low memory string blocks, never in
## **  $A000-$BFFF, so MACPTR's own bank stepping cannot reach a banked copy of
## **  this code.
## **
## ***********************************************************************
#IFNDEF BMX.DEFS
#DEFINE BMX.DEFS 1

## KERNAL entries. CHKIN and MACPTR are not here. They are inside BMX.MOVE's
## assembly, where no statement can come between them.

#DEFINE BMXK.CLRCHN $FFCC

## memory_copy. Source and target both live in $9F00-$9FFF here, so neither
## is stepped and both ends are VERA data ports -- see BMX.PALCOPY.
#DEFINE BMXK.MEMCOPY $FEE7

#DEFINE BMXK.VCTRL $9F25
#DEFINE BMXK.VLO $9F20
#DEFINE BMXK.VMID $9F21
#DEFINE BMXK.VHI $9F22

## $9F23 and $9F24 are VERA data ports 0 and 1, split into the bytes the 16-bit ABI
## registers want. Two ports is what makes a VRAM-to-VRAM copy one call, not a loop.
##
## PORTLO.B, NOT THE OBVIOUS NAME ENDING IN A ONE: a #DEFINE name may not contain a
## digit ANYWHERE, and BASLOAD rejects the whole FILE rather than the line. Same rule
## that stops VERA's own register names being used here.
#DEFINE BMXK.PORTLO 35
#DEFINE BMXK.PORTLO.B 36
#DEFINE BMXK.PORTHI 159

## The logical file number. Change it here if it collides with yours.
#DEFINE BMXK.LFN 4

GOTO BMX.MODULE.END

## ***********************************************************************
## **  BMX.INIT -- allocate the buffers. Called on demand, so there is
## **  nothing for a caller to forget.
## **
## **  A STRING BLOCK IS REAL RAM, so the KERNAL can write straight into it -- which is
## **  why this needs no fixed scratch address. $0400 is the obvious one and is NOT
## **  free: a compiled program keeps runtime state there and corrupts it quietly.
## **
## **  BMX.PALBASE ($1FA00) and BMX.STASH ($13000) are VARIABLES, not #DEFINEs, because
## **  #DEFINE takes an INT16 and every VRAM address past $FFFF overflows it. BMX.STASH
## **  would have to be one anyway, so a caller can move it.
## ***********************************************************************

BMX.INIT:
    BMX.PALBASE = 129536 : BMX.KEPT = 0

## ---- ONLY IF THE CALLER HAS NOT ALREADY SET IT. BMX.INIT runs at the first BMX.OPEN,
## ---- AFTER the caller's setup, so assigning unconditionally would quietly undo a
## ---- stash address set at the top of a program. Zero means "never set"; -1 means off.

    IF BMX.STASH = 0 THEN BMX.STASH = 77824
    BMX.HEADER$  = RPT$(32, 32)  : BMX.PTR = GP.STRPTR(BMX.HEADER$) + 1
    BMX.SCRATCH$ = RPT$(32, 255) : BMX.SCRATCH = GP.STRPTR(BMX.SCRATCH$) + 1
    RETURN

## ***********************************************************************
## **  BMX.OPEN -- open BMX.FILE$ and read its header.
## **
## **   in   BMX.FILE$
## **   out  BMX.ERROR$    empty if the file is one we can paint
## **        BMX.WIDTH  BMX.HEIGHT  BMX.DEPTH  BMX.VERSION
## **        BMX.PALUSED  BMX.PALFIRST  BMX.DATAOFF  BMX.PACKED
## **
## **  ON SUCCESS THE CHANNEL IS LEFT OPEN, standing exactly where the
## **  palette begins -- which is why nothing in this file ever seeks. On
## **  failure it is closed for you.
## **
## **      IF GP.FN(BMX.LOAD, F$) <> "" THEN GOTO COMPLAIN
## ***********************************************************************

BMX.OPEN:
    GP.DEFPROC BMX.LOAD, BMX.FILE$ RETURNS BMX.ERROR$
    IF BMX.PTR = 0 THEN GOSUB BMX.INIT
    BMX.ERROR$ = "" : OPEN BMXK.LFN, 8, 4, BMX.FILE$ + ",S,R"
    BMX.ADDR = BMX.PTR
    GOSUB BMX.SPLIT : BMX.RUN = 32 : BMX.HOLD = 0 : GOSUB BMX.MOVE
    IF BMX.MOVE.GOT% < 32 THEN BMX.ERROR$ = "CANNOT READ " + BMX.FILE$
    IF BMX.ERROR$ = "" THEN GOSUB BMX.PARSE
    IF BMX.ERROR$ <> "" THEN GOSUB BMX.CLOSE
    RETURN

## ***********************************************************************
## **  BMX.PAINT -- palette and pixels into VRAM, then close.
## **
## **  The screen mode must ALREADY be set (see the note at the top).
## **
## **  A FULL WIDTH image goes in as ONE block -- the framebuffer is linear, so 320-wide
## **  rows at x=0 are contiguous however tall the picture is. Narrower goes a row at a
## **  time, which is what buys centring of any size. Worth five times the speed on a
## **  full screen: 19 jiffies against 93.
## ***********************************************************************

BMX.PAINT:
    GOSUB BMX.KEEP : IF BMX.ERROR$ <> "" THEN GOTO BMX.PAINT.END

    BMX.ADDR = BMX.PALBASE + BMX.PALFIRST * 2
    GOSUB BMX.VERA : BMX.COUNT = BMX.PALUSED * 2 : GOSUB BMX.STREAM
    IF BMX.ERROR$ <> "" THEN GOTO BMX.PAINT.END

## ---- The header names where the image data starts. Normally that is
## ---- right after the palette, but honour it rather than assume it.

    BMX.SKIP = BMX.DATAOFF - 32 - BMX.PALUSED * 2
    IF BMX.SKIP > 0 THEN GOSUB BMX.DISCARD

    BMX.X0 = INT((320 - BMX.WIDTH) / 2)  : IF BMX.X0 < 0 THEN BMX.X0 = 0
    BMX.Y0 = INT((240 - BMX.HEIGHT) / 2) : IF BMX.Y0 < 0 THEN BMX.Y0 = 0
    BMX.ROWS = BMX.HEIGHT : IF BMX.ROWS > 240 THEN BMX.ROWS = 240

## ---- A FULL WIDTH IMAGE IS ONE BLOCK. The framebuffer is linear -- row n is at n*320
## ---- exactly -- so 320-wide rows at x=0 run together with no gap. Set the address
## ---- once and stream the lot.
## ----
## ---- MEASURED on CANDLE.BMX, 320x240x8, 76,800 bytes: 93 jiffies row by row against
## ---- 19 as one block. THE BYTES ARE NOT THE COST -- only 0.32s of that is MACPTR
## ---- moving them. The other 1.23s was 240 times (a float multiply, two divides, four
## ---- POKEs) plus a second MACPTR every row, because 320 is 255 + 65 and the tail call
## ---- moves a quarter of a chunk for a whole call's overhead.

    BMX.ONEBLOCK = 0
    IF BMX.WIDTH = 320 THEN BMX.ONEBLOCK = 1
    IF BMX.X0 <> 0 THEN BMX.ONEBLOCK = 0
    IF BMX.ONEBLOCK = 0 THEN GOTO BMX.PAINT.ROWS

    BMX.ADDR = BMX.Y0 * 320
    GOSUB BMX.VERA   : BMX.COUNT = BMX.WIDTH * BMX.ROWS
    GOSUB BMX.STREAM : GOTO BMX.PAINT.END

BMX.PAINT.ROWS:
    FOR BMX.ROW = 0 TO BMX.ROWS - 1
        BMX.ADDR = (BMX.Y0 + BMX.ROW) * 320 + BMX.X0
        GOSUB BMX.VERA : BMX.COUNT = BMX.WIDTH : GOSUB BMX.STREAM
        IF BMX.ERROR$ <> "" THEN GOTO BMX.PAINT.END
    NEXT

BMX.PAINT.END:
    GOSUB BMX.CLOSE  
    RETURN

## ---- Both halves, for a file you already trust. The mode must be set first, so a bad
## ---- file is reported with the display already in graphics -- split them if that
## ---- matters.

BMX.SHOW:
    GOSUB BMX.OPEN : IF BMX.ERROR$ <> "" THEN RETURN
    GOSUB BMX.PAINT  
    RETURN

## ---- Hand the channel back. Safe to call twice; also the way to abandon
## ---- a file opened by BMX.OPEN without painting it.

BMX.CLOSE:
    GP.CALL BMXK.CLRCHN : CLOSE BMXK.LFN  
    RETURN

## ***********************************************************************
## **  BMX.KEEP -- the machine's palette into spare VRAM. Called by
## **  BMX.PAINT, so a caller never has to remember it.
## **
## **  ALL 256 ENTRIES, not the range the picture claims: the same single KERNAL call,
## **  and it makes the stash independent of the file. Snapshotting only the claimed
## **  range would leave the first picture's leftovers behind after a second one with a
## **  different BMX.PALFIRST, with no way for the caller to know.
## **
## **  ONCE PER RUN, and the guard is what makes a slideshow correct: the ORIGINAL
## **  palette is kept, not the previous picture's.
## ***********************************************************************

BMX.KEEP:
    IF BMX.PTR = 0 THEN GOSUB BMX.INIT
    IF BMX.KEPT = 1 THEN RETURN
    IF BMX.STASH < 0 THEN RETURN : REM switched off by the caller; nothing kept, nothing to put back

## ---- Checked, not trusted, because a bad address is silent: below the framebuffer top
## ---- the picture paints over it, and $1F9C0 up is the PSG, where a 512-byte write is
## ---- audible rather than merely wrong.

    IF BMX.STASH < 76800 THEN BMX.ERROR$ = "BMX.STASH IS INSIDE THE BITMAP"
    IF BMX.STASH > 128960 THEN BMX.ERROR$ = "BMX.STASH RUNS INTO THE PSG REGISTERS"
    IF BMX.ERROR$ <> "" THEN RETURN

    BMX.SRC = BMX.PALBASE : BMX.DST = BMX.STASH : GOSUB BMX.PALCOPY : BMX.KEPT = 1
    RETURN

## ***********************************************************************
## **  BMX.RESTORE -- the machine's palette back, and the stash released.
## **
## **  Safe at any time -- nothing kept means nothing to do -- so a program whose picture
## **  failed to load can call it unconditionally on the way out.
## ***********************************************************************

BMX.RESTORE:
    IF BMX.KEPT = 0 THEN RETURN
    BMX.SRC = BMX.STASH : BMX.DST = BMX.PALBASE : GOSUB BMX.PALCOPY : BMX.KEPT = 0
    RETURN

## ***********************************************************************
## **  BMX.PALCOPY -- 512 bytes from BMX.SRC to BMX.DST, inside VRAM.
## **
## **  VERA's TWO address ports step independently, so pointing one at each end turns
## **  this into a single memory_copy: both r0 and r1 land in $9F00-$9FFF, where the
## **  KERNAL does not increment, and VERA walks both addresses itself. The KERNAL
## **  chapter names this use exactly. A VPEEK/VPOKE loop would be five jiffies each
## **  way, and the loop overhead, not the bytes, is what that would buy.
## **
## **  Poking $02..$07 direct is safe from a compiled program: r0..r15 live at $02..$21
## **  and GPC's own zero page starts at $22.
## ***********************************************************************

BMX.PALCOPY:
    BMX.ADDR = BMX.SRC : GOSUB BMX.VERA : REM data port 0 -> the source, stepping by one

    BMX.ADDR = BMX.DST : GOSUB BMX.SPLIT
    POKE BMXK.VCTRL, 1 : REM VERA CTRL bit 0, ADDRSEL = 1: $9F20-$9F22 are port 1's now
    POKE BMXK.VLO, BMX.LO : REM ADDR1_L
    POKE BMXK.VMID, BMX.HI : REM ADDR1_M
    POKE BMXK.VHI, BMX.BANK + 16 : REM ADDR1_H: bank in bit 0, increment 1 in the top nibble
    POKE BMXK.VCTRL, 0 : REM ADDRSEL back to 0, so the streaming path finds port 0 selected

    POKE 2, BMXK.PORTLO : REM r0L = $9F23, VERA DATA0 -- the source, and NOT stepped
    POKE 3, BMXK.PORTHI : REM r0H
    POKE 4, BMXK.PORTLO.B : REM r1L = $9F24, VERA DATA1 -- the target, and NOT stepped
    POKE 5, BMXK.PORTHI : REM r1H
    POKE 6, 0 : REM r2L = byte count low: 512, the whole 256 entry palette
    POKE 7, 2 : REM r2H
    GP.CALL BMXK.MEMCOPY : REM r2 is destroyed, r0 and r1 are not
    RETURN

## ***********************************************************************
## **  BMX.PARSE -- the 32 byte header, read straight out of the string.
## **
## **   0-2  "BMX"           6-7  width         12-13 image data offset
## **     3  version         8-9  height           14 compression
## **     4  bits per pixel   10  palette entries used, 0 meaning 256
## **     5  VERA depth reg   11  first palette index
## ***********************************************************************

BMX.PARSE:
    BMX.VERSION = PEEK(BMX.PTR + 3) : BMX.DEPTH = PEEK(BMX.PTR + 4)
    BMX.WIDTH = PEEK(BMX.PTR + 6) + PEEK(BMX.PTR + 7) * 256
    BMX.HEIGHT = PEEK(BMX.PTR + 8) + PEEK(BMX.PTR + 9) * 256
    BMX.PALUSED = PEEK(BMX.PTR + 10)
    IF BMX.PALUSED = 0 THEN BMX.PALUSED = 256
    BMX.PALFIRST = PEEK(BMX.PTR + 11)
    BMX.DATAOFF = PEEK(BMX.PTR + 12) + PEEK(BMX.PTR + 13) * 256
    BMX.PACKED = PEEK(BMX.PTR + 14)

    BMX.BAD = 0
    IF PEEK(BMX.PTR) <> 66     THEN BMX.BAD = 1
    IF PEEK(BMX.PTR + 1) <> 77 THEN BMX.BAD = 1
    IF PEEK(BMX.PTR + 2) <> 88 THEN BMX.BAD = 1
    IF BMX.BAD = 1 THEN BMX.ERROR$ = BMX.FILE$ + " IS NOT A BMX FILE"
    IF BMX.BAD = 1 THEN RETURN

    IF BMX.VERSION <> 1 THEN BMX.ERROR$ = "BMX VERSION" + STR$(BMX.VERSION) + " IS NOT SUPPORTED"
    IF BMX.ERROR$ <> "" THEN RETURN

## ---- Bit depth is a SPARSE selector -- 1, 2, 4, 8 and nothing else -- which ON x
## ---- GOSUB cannot index. The 8 case is deliberately EMPTY: a match falls straight out
## ---- of the select, which is what "this one is fine" should cost.

    GP.SELECT BMX.DEPTH
        GP.CASE 8
        GP.CASE 1, 2, 4
            BMX.ERROR$ = STR$(BMX.DEPTH) + " BIT IMAGES NEED ANOTHER SCREEN MODE"
        GP.OTHER
            BMX.ERROR$ = "BAD BIT DEPTH IN THE HEADER"
    GP.ENDSEL
    IF BMX.ERROR$ <> "" THEN RETURN

    IF BMX.PACKED <> 0 THEN BMX.ERROR$ = "LZSA COMPRESSED FILES ARE NOT SUPPORTED"
    RETURN

## ***********************************************************************
## **  BMX.SPLIT -- a 17 bit VRAM (or 16 bit RAM) address into bytes.
## **
## **    in  BMX.ADDR    out  BMX.LO  BMX.HI  BMX.BANK
## **
## **  Arithmetic, not AND: AND is 16-bit SIGNED in GPC, so a VRAM address above 32767 --
## **  every screen row past the top eighth -- raises OUT OF RANGE rather than masking.
## ***********************************************************************

BMX.SPLIT:
    BMX.BANK = INT(BMX.ADDR / 65536) : BMX.REST = BMX.ADDR - BMX.BANK * 65536
    BMX.HI = INT(BMX.REST / 256) : BMX.LO = BMX.REST - BMX.HI * 256
    RETURN

## ---- VERA data port 0 at BMX.ADDR, stepping by one: the increment rides in the high
## ---- byte's top nibble, so 16 is "add 1 per byte", and the bank bit is bit 0.

BMX.VERA:
    GOSUB BMX.SPLIT
    POKE BMXK.VCTRL, 0 : POKE BMXK.VLO, BMX.LO : POKE BMXK.VMID, BMX.HI
    POKE BMXK.VHI, BMX.BANK + 16
    RETURN

## ***********************************************************************
## **  BMX.STREAM -- BMX.COUNT bytes from the channel into VERA.
## **
## **   in   BMX.COUNT   bytes, any size
## **   out  BMX.ERROR$  set if the file ran short or the read failed
## **
## **  VERA's data port is one address and VERA does the stepping, so the target is
## **  held. BMX.MOVE takes 30,000 bytes a call and a full screen is 76,800, which is
## **  what the outer loop is for.
## ***********************************************************************

BMX.STREAM:
    BMX.LEFT = BMX.COUNT : BMX.HOLD = 1
BMX.STREAM.MORE:
    BMX.RUN = BMX.LEFT
    IF BMX.RUN > 30000 THEN BMX.RUN = 30000
    BMX.LO = BMXK.PORTLO : BMX.HI = BMXK.PORTHI
    GOSUB BMX.MOVE : GOSUB BMX.MOVE.FAULT
    IF BMX.ERROR$ <> "" THEN RETURN
    BMX.LEFT = BMX.LEFT - BMX.MOVE.GOT%
    IF BMX.LEFT > 0 THEN GOTO BMX.STREAM.MORE
    RETURN

## ---- Throw away BMX.SKIP bytes into the scratch string. Stepped rather than held,
## ---- and capped at that string's 255 bytes. A short read ends the skip and sets no
## ---- error; the caller meets it at the next BMX.STREAM.

BMX.DISCARD:
    BMX.ADDR = BMX.SCRATCH : GOSUB BMX.SPLIT : BMX.HOLD = 0
BMX.DISCARD.MORE:
    BMX.RUN = BMX.SKIP
    IF BMX.RUN > 255 THEN BMX.RUN = 255
    GOSUB BMX.MOVE
    IF BMX.MOVE.FAIL% <> 0 THEN RETURN
    IF BMX.MOVE.GOT% = 0 THEN RETURN
    BMX.SKIP = BMX.SKIP - BMX.MOVE.GOT%
    IF BMX.SKIP > 0 THEN GOTO BMX.DISCARD.MORE
    RETURN

## ---- BMX.MOVE's outcome as a message. A count of zero and a count that is merely
## ---- short read the same to a caller, so both say ENDED EARLY.

BMX.MOVE.FAULT:
    IF BMX.MOVE.GOT% < BMX.MOVE.WANT% THEN BMX.ERROR$ = BMX.FILE$ + " ENDED EARLY"
    IF BMX.MOVE.FAIL% = 1 THEN BMX.ERROR$ = BMX.FILE$ + " CHANNEL REFUSED"
    IF BMX.MOVE.FAIL% = 2 THEN BMX.ERROR$ = BMX.FILE$ + " NEEDS A MACPTR DEVICE"
    IF BMX.MOVE.FAIL% = 4 THEN BMX.ERROR$ = BMX.FILE$ + " READ FAILED"
    RETURN

## ***********************************************************************
## **  BMX.MOVE -- the only place in this file that reads the channel.
## **
## **   in   BMX.LO  BMX.HI   target address, from BMX.SPLIT
## **        BMX.RUN          bytes to move, 1 to 30000
## **        BMX.HOLD         1 holds the target on one address, 0 steps it
## **   out  BMX.MOVE.GOT%    bytes moved, which may be short of BMX.RUN
## **        BMX.MOVE.FAIL%   0 done, 1 CHKIN refused, 2 the device has no
## **                         MACPTR, 3 MACPTR moved nothing, 4 MACPTR
## **                         reported more than it was asked for
## **
## **  Trap: CHKIN and MACPTR share one blob because they must not be separated.
## **  PRINT and SCREEN each put the input channel back on the keyboard, so a CHKIN
## **  done at open time is gone by the time a caller paints. MACPTR on the wrong
## **  channel moves nothing and still reports a count that is not zero, and a caller
## **  testing only for zero reads that as progress and paints nothing.
## **
## **  The 4 test is what makes such a count visible: MACPTR is asked for at most 255
## **  bytes, so any count above the ask is impossible and is named, not believed.
## ***********************************************************************

BMX.MOVE:
    BMX.MOVE.LFN% = BMXK.LFN : BMX.MOVE.WANT% = BMX.RUN
    BMX.MOVE.LO% = BMX.LO : BMX.MOVE.HI% = BMX.HI : BMX.MOVE.HOLD% = BMX.HOLD
    BMX.MOVE.GOT% = 0 : BMX.MOVE.FAIL% = 0 : BMX.MOVE.CHUNK% = 0 : BMX.MOVE.STEP% = 0
    #REM 1
    GP.ASM
    REM CLD
    REM LDX {BMX.MOVE.LFN%}
    REM JSR $FFC6                     ; CHKIN
    REM BCC BMVRUN
    REM LDA #1
    REM STA {BMX.MOVE.FAIL%}
    REM RTS
    REM ;
    REM ; ---- zTemp0 target, zTemp1 left to move, zTemp2 moved so far ----
    REM BMVRUN: LDA {BMX.MOVE.LO%}
    REM STA $2C
    REM LDA {BMX.MOVE.HI%}
    REM STA $2D
    REM LDX #1
    REM LDA {BMX.MOVE.WANT%}
    REM STA $2E
    REM LDA {BMX.MOVE.WANT%},X
    REM STA $2F
    REM STZ $30
    REM STZ $31
    REM ;
    REM ; ---- ask for min(255, left). Nothing left is the job done. ----
    REM BMVLOP: LDA $2F
    REM BNE BMVBIG
    REM LDA $2E
    REM BEQ BMVOUT
    REM CMP #255
    REM BCC BMVASK
    REM BMVBIG: LDA #255
    REM BMVASK: STA {BMX.MOVE.CHUNK%}
    REM ;
    REM ; ---- carry set holds the target on one address, a VERA data port ----
    REM LDA {BMX.MOVE.HOLD%}
    REM BEQ BMVSTP
    REM SEC
    REM BRA BMVGO
    REM BMVSTP: CLC
    REM BMVGO: LDA {BMX.MOVE.CHUNK%}
    REM LDX $2C
    REM LDY $2D
    REM JSR $FF44                     ; MACPTR
    REM BCC BMVCNT
    REM LDA #2
    REM STA {BMX.MOVE.FAIL%}
    REM BRA BMVOUT
    REM ;
    REM ; ---- the count is a contract: never 0, never over the ask ----
    REM BMVCNT: CPY #0
    REM BNE BMVOVR
    REM CPX #0
    REM BEQ BMVSHT
    REM CPX {BMX.MOVE.CHUNK%}
    REM BEQ BMVADD
    REM BCS BMVOVR
    REM BMVADD: JSR BMVSUM
    REM JSR $FFB7                     ; READST
    REM AND #$40                      ; bit 6, end of file
    REM BEQ BMVLOP
    REM BMVOUT: LDX #1
    REM LDA $30
    REM STA {BMX.MOVE.GOT%}
    REM LDA $31
    REM STA {BMX.MOVE.GOT%},X
    REM RTS
    REM ;
    REM BMVSHT: LDA #3
    REM STA {BMX.MOVE.FAIL%}
    REM BRA BMVOUT
    REM BMVOVR: LDA #4
    REM STA {BMX.MOVE.FAIL%}
    REM BRA BMVOUT
    REM ;
    REM ; ---- moved up, left down, target up unless it is held ----
    REM BMVSUM: STX {BMX.MOVE.STEP%}
    REM CLC
    REM LDA $30
    REM ADC {BMX.MOVE.STEP%}
    REM STA $30
    REM LDA $31
    REM ADC #0
    REM STA $31
