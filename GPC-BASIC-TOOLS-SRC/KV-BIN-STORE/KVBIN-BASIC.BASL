## ***********************************************************************
## **
## **  KVBIN-BASIC.BASL -- a KVBIN store read and written from ROM BASIC.
## **
## **  Plain X16 BASIC, no GP keywords. The tokenised KVBIN-BASIC.PRG runs
## **  in ROM BASIC. It works on SETTINGS.KVB, the store that
## **  KV-BIN-STORE.PRG and KVBIN-PROG8.PRG work on.
## **
## **      L  every key and its value
## **      G  a value by key
## **      P  write a value by key
## **      D  remove a key
## **      Q  back to BASIC
## **
## ***********************************************************************
#SAVEAS "@:KVBIN-BASIC.PRG"
#INCLUDE "GPC-BASIC/KVBIN.INC.BL"

## The drive's number for a file that is not there.
#DEFINE KVB.DOS.NOTFOUND 62
#DEFINE KVB.VALUECOLUMN 13

KVBIN.FNAME$ = "SETTINGS.KVB"
PRINT "KVBIN STORE, ROM BASIC"
GOSUB KVBIN.INFO
IF KVBIN.OK% = 0 THEN IF KVBIN.DOSERR% = KVB.DOS.NOTFOUND THEN GOSUB KVB.NEW.STORE
IF KVBIN.OK% = 0 THEN GOSUB KVB.EXPLAIN
IF KVBIN.OK% = 0 THEN END
KVB.NUMBER = KVBIN.SLOTS
GOSUB KVB.NUMBER.TEXT
PRINT KVBIN.FNAME$; ": "; KVB.DIGITS$; " SLOTS"

KVB.MENU:
    PRINT
    PRINT "L LIST   G GET   P PUT   D DELETE   Q QUIT"
KVB.MENU.WAIT:
    GET KVB.COMMAND$
    IF KVB.COMMAND$ = "L" THEN GOTO KVB.LIST.KEYS
    IF KVB.COMMAND$ = "G" THEN GOTO KVB.GET.VALUE
    IF KVB.COMMAND$ = "P" THEN GOTO KVB.PUT.VALUE
    IF KVB.COMMAND$ = "D" THEN GOTO KVB.DELETE.KEY
    IF KVB.COMMAND$ <> "Q" THEN GOTO KVB.MENU.WAIT
    END

## ---- every slot in order. A free slot comes back with an empty key.
KVB.LIST.KEYS:
    KVB.USED = 0
    GOSUB KVBIN.FIRST
KVB.LIST.EACH:
    IF KVBIN.OK% = 0 THEN GOTO KVB.LIST.TOTAL
    IF KVBIN.KEY$ <> "" THEN GOSUB KVB.LIST.SHOW
    GOSUB KVBIN.NEXT
    GOTO KVB.LIST.EACH
KVB.LIST.TOTAL:
    IF KVBIN.WHY% <> KVBIN.WHY.NONE THEN GOSUB KVB.EXPLAIN
    IF KVBIN.WHY% <> KVBIN.WHY.NONE THEN GOTO KVB.MENU
    KVB.NUMBER = KVB.USED
    GOSUB KVB.NUMBER.TEXT
    PRINT KVB.DIGITS$; " OF ";
    KVB.NUMBER = KVBIN.SLOTS
    GOSUB KVB.NUMBER.TEXT
    PRINT KVB.DIGITS$; " SLOTS USED"
    GOTO KVB.MENU

KVB.LIST.SHOW:
    PRINT KVBIN.KEY$; TAB(KVB.VALUECOLUMN); "= "; KVBIN.VALUE$
    KVB.USED = KVB.USED + 1
    RETURN

KVB.GET.VALUE:
    GOSUB KVB.ASK.KEY
    IF KVBIN.KEY$ = "" THEN GOTO KVB.MENU
    GOSUB KVBIN.GET
    IF KVBIN.OK% THEN PRINT KVBIN.VALUE$
    IF KVBIN.OK% = 0 THEN GOSUB KVB.EXPLAIN
    GOTO KVB.MENU

KVB.PUT.VALUE:
    GOSUB KVB.ASK.KEY
    IF KVBIN.KEY$ = "" THEN GOTO KVB.MENU
    PRINT "VALUE: ";
    KVBIN.VALUE$ = ""
    LINPUT KVBIN.VALUE$
    GOSUB KVBIN.PUT
    KVB.NUMBER = KVBIN.SLOT%
    GOSUB KVB.NUMBER.TEXT
    IF KVBIN.OK% THEN PRINT "SAVED IN SLOT "; KVB.DIGITS$
    IF KVBIN.OK% = 0 THEN GOSUB KVB.EXPLAIN
    GOTO KVB.MENU

KVB.DELETE.KEY:
    GOSUB KVB.ASK.KEY
    IF KVBIN.KEY$ = "" THEN GOTO KVB.MENU
    GOSUB KVBIN.DEL
    KVB.NUMBER = KVBIN.SLOT%
    GOSUB KVB.NUMBER.TEXT
    IF KVBIN.OK% THEN PRINT "DELETED FROM SLOT "; KVB.DIGITS$
    IF KVBIN.OK% = 0 THEN GOSUB KVB.EXPLAIN
    GOTO KVB.MENU

## ---- a typed key into KVBIN.KEY$. An empty line gives "".
KVB.ASK.KEY:
    PRINT "KEY: ";
    KVBIN.KEY$ = ""
    LINPUT KVBIN.KEY$
    RETURN

## ---- a store of the usual 40 slots, for a drive that has none.
KVB.NEW.STORE:
    KVBIN.NEWSLOTS% = 0
    GOSUB KVBIN.CREATE
    IF KVBIN.OK% THEN PRINT "NEW STORE"
    RETURN

## ---- KVBIN.WHY% in words.
KVB.EXPLAIN:
    IF KVBIN.WHY% = KVBIN.WHY.NOFILE THEN PRINT "CANNOT OPEN "; KVBIN.FNAME$; ": "; KVBIN.DOSMSG$
    IF KVBIN.WHY% = KVBIN.WHY.NOTSTORE THEN PRINT KVBIN.FNAME$; " IS NOT A KVBIN STORE"
    IF KVBIN.WHY% = KVBIN.WHY.NOKEY THEN PRINT "NO SUCH KEY"
    IF KVBIN.WHY% = KVBIN.WHY.FULL THEN PRINT "THE STORE IS FULL"
    RETURN

## ---- KVB.NUMBER into KVB.DIGITS$, without the space STR$ leads with.
KVB.NUMBER.TEXT:
    KVB.DIGITS$ = MID$(STR$(KVB.NUMBER), 2)
    RETURN
