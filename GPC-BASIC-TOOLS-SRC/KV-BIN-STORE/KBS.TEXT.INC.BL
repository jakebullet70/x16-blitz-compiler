## ***********************************************************************
## **  KBS.TEXT.INC.BL -- every string KV-BIN-STORE shows, in KBS.TEXTBANK.
## **
## **  Include it after the regions and above KBS.LIBEND, so the GOTO at
## **  the top steps over it. KBS.TEXTBANK is #DEFINEd in the program and
## **  claimed in KBS.CLAIM.BANKS.
## ***********************************************************************

## ---- The menus. A & marks the hot key. The KBS.ITEM.* and KBS.*ROW.*
## ---- numbers in the program count these rows, separators included.
GP.BANKEDSTR KBS.TEXTBANK KBS.TEXT.BAR
  " &FILE "
  " &KEY "
  " &VIEW "
  " &HELP "
GP.ENDBANKEDSTR

GP.BANKEDSTR KBS.TEXTBANK KBS.TEXT.FILEMENU
  "&NEW STORE"
  "&OPEN STORE"
  "&EXPAND STORE"
  "-"
  "EXPORT &TEXT"
  "&IMPORT TEXT"
  "-"
  "E&XIT"
GP.ENDBANKEDSTR

GP.BANKEDSTR KBS.TEXTBANK KBS.TEXT.KEYMENU
  "&NEW KEY"
  "&EDIT VALUE"
  "&DELETE KEY"
  "-"
  "&GET BY NAME"
GP.ENDBANKEDSTR

GP.BANKEDSTR KBS.TEXTBANK KBS.TEXT.VIEWMENU
  "&USED KEYS"
  "&ALL SLOTS"
  "-"
  "&READ AGAIN"
GP.ENDBANKEDSTR

GP.BANKEDSTR KBS.TEXTBANK KBS.TEXT.HELPMENU
  "&KEYS"
  "&FILE LAYOUT"
GP.ENDBANKEDSTR

GP.BANKEDSTR KBS.TEXTBANK KBS.TEXT.PAGE
  "KV-BIN-STORE  REGISTRY EDITOR"
  "SLOT  KEY"
  "(FREE)"
  " OF"
  " SLOTS USED"
  "   USED KEYS SHOWN"
  "   ALL SLOTS SHOWN"
  "NO STORE IS OPEN"
  "ARROWS MOVE   RETURN EDITS   INS NEW   DEL DELETES   ESC OR ALT+LETTER MENU"
GP.ENDBANKEDSTR

GP.BANKEDSTR KBS.TEXTBANK KBS.TEXT.PANEL
  "KEY"
  "SLOT"
  "AT BYTE"
  "LENGTH"
  " OF 115"
  "VALUE"
  "FREE SLOT"
GP.ENDBANKEDSTR

## ---- Row n - 1 is KVBIN.WHY n. The drive's own message follows the first.
GP.BANKEDSTR KBS.TEXTBANK KBS.TEXT.WHY
  "THE DRIVE SAYS"
  "NOT A STORE"
  "NO SUCH KEY"
  "THE STORE IS FULL"
  "A KEY NEEDS A NAME"
GP.ENDBANKEDSTR

## ---- The status line's words.
GP.BANKEDSTR KBS.TEXTBANK KBS.TEXT.SAY
  "CREATE "
  "READ "
  "PUT "
  "GET "
  "DEL "
  "AT SLOT"
  "EXPAND "
  " JIFFIES"
  "EXPORTED"
  " KEYS TO "
  "IMPORTED"
  " KEYS FROM "
  " LINES SKIPPED"
  " SLOTS"
GP.ENDBANKEDSTR

GP.BANKEDSTR KBS.TEXTBANK KBS.TEXT.ASK
  "NAME FOR THE NEW STORE"
  "STORE TO OPEN"
  " EXISTS. REPLACE IT?"
  "ADD 20 FREE SLOTS TO THE STORE?"
  "THE STORE IS FULL. ADD 20 FREE SLOTS?"
  "NEW KEY"
  "THE KEY, UP TO 12 CHARACTERS"
  "THE VALUE, UP TO 70 CHARACTERS"
  "DELETE "
  "?"
  "KEY TO GET"
  "TEXT FILE TO WRITE"
  "TEXT FILE TO READ"
  "LEAVE THE EDITOR?"
  " IS NOT HERE. CREATE IT WITH 40 FREE SLOTS?"
GP.ENDBANKEDSTR

GP.BANKEDSTR KBS.TEXTBANK KBS.TEXT.TELL
  "NO STORE IS OPEN. USE FILE, NEW STORE OR OPEN STORE."
  "THIS EDITOR SHOWS 100 SLOTS, AND 20 MORE WOULD PASS THAT."
  "THE VALUE IS LONGER THAN THE 70 CHARACTER EDIT FIELD."
  " WAS NOT FOUND."
GP.ENDBANKEDSTR

GP.BANKEDSTR KBS.TEXTBANK KBS.TEXT.HELPKEYS
  "KEYS"
  "UP, DOWN, PGUP, PGDN, HOME AND END MOVE THE BAR."
  "RETURN EDITS THE VALUE. INS ADDS A KEY. DEL REMOVES ONE."
  "ESC OR ALT WITH A LETTER OPENS A MENU."
GP.ENDBANKEDSTR

GP.BANKEDSTR KBS.TEXTBANK KBS.TEXT.HELPFILE
  "FILE LAYOUT"
  "THE FILE IS RECORDS OF 128 BYTES. RECORD 0 IS THE HEADER."
  "A SLOT IS A KEY OF 12 BYTES, THEN A VALUE OF UP TO 115."
  "BOTH ARE PADDED WITH ZERO BYTES. A FREE SLOT STARTS WITH ONE."
GP.ENDBANKEDSTR

## ---- The store and the text file the program starts with.
GP.BANKEDSTR KBS.TEXTBANK KBS.TEXT.NAMES
  "SETTINGS.KVB"
  "SETTINGS.TXT"
GP.ENDBANKEDSTR

## ---- What a new SETTINGS.KVB holds. The two groups list the same keys in
## ---- the same order.
GP.BANKEDSTR KBS.TEXTBANK KBS.TEXT.SAMPLEKEYS
  "USER.NAME"
  "SCR.THEME"
  "SCR.MODE"
  "EDIT.TABSIZE"
  "TERM.BAUD"
  "GPC.HOME"
GP.ENDBANKEDSTR

GP.BANKEDSTR KBS.TEXTBANK KBS.TEXT.SAMPLEVALUES
  "X16 USER"
  "DARK"
  "1"
  "4"
  "19200"
  "/GPC/"
GP.ENDBANKEDSTR
