## TG-THEME.BASL -- the Custom theme of TURBO.BASL, THEME.ID% 4, and the box that builds it.
##
## TURBO.CUSTOM%() holds the theme as 23 colours, each background * 16 + foreground:
##   0 to 9     the THEME.CLR% roles: page, text, title, border, hilite, dimmed, warn, focus,
##              bar and shadow. The boxes and the dropdowns draw in them.
##   10 to 13   the text pane: the text, the cursor line, the line numbers and the cursor
##   14         the selection's background. Its foreground is 0.
##   15         the hot letters' foreground. Its background is 0.
##   16 to 22   the syntax foregrounds: plain, statement, function, string, number, comment
##              and other word. Their backgrounds are 0.
##
## The store keeps it under TG.CUSTOM, two letters a colour, A for 0 to P for 15.
##
## #INCLUDE it after THEME.INC.BL and TG-VIEW.BASL. TURBO.PREFS.LOAD calls TURBO.CUSTOM.LOAD
## once. TURBO.THEME.APPLY calls TURBO.CUSTOM.PUT for theme 4.
##
## WARNING: TURBO is at BASLOAD's limit of variable names. Reuse a variable here before adding
## one.

#DEFINE TURBO.ROLE.LAST 22
#DEFINE TURBO.ROLE.PANE.TEXT 10
#DEFINE TURBO.ROLE.SELECTION 14
#DEFINE TURBO.ROLE.HOT 15
#DEFINE TURBO.ROLE.INKS 16
#DEFINE TURBO.CUSTOM.TEXT.LENGTH 46
#DEFINE TURBO.INK.TABLE 48624
#DEFINE TURBO.CUSTOM.NAME.WIDTH 11
#DEFINE TURBO.CUSTOM.BOX.LEFT 50
#DEFINE TURBO.CUSTOM.BOX.TOP 1
#DEFINE TURBO.CUSTOM.BOX.WIDTH 28
#DEFINE TURBO.CUSTOM.BOX.HEIGHT 28
#DEFINE TURBO.CUSTOM.INNER.LEFT 52

## TURBO.CUSTOM.LOAD -- read the Custom theme from the store. TURBO.CUSTOM.READY% is -1 when
## the store holds one.
TURBO.CUSTOM.LOAD:
  DIM TURBO.CUSTOM%(TURBO.ROLE.LAST)
  DIM TURBO.CUSTOM.KEPT%(TURBO.ROLE.LAST)
  TURBO.CUSTOM.READY% = 0
  KVBIN.KEY$ = "TG.CUSTOM"
  GOSUB KVBIN.GET
  IF LEN(KVBIN.VALUE$) <> TURBO.CUSTOM.TEXT.LENGTH THEN RETURN
  FOR TURBO.CUSTOM.ROLE = 0 TO TURBO.ROLE.LAST
    TURBO.CUSTOM%(TURBO.CUSTOM.ROLE) = (ASC(MID$(KVBIN.VALUE$, TURBO.CUSTOM.ROLE * 2 + 1, 1)) - 65) * 16 + ASC(MID$(KVBIN.VALUE$, TURBO.CUSTOM.ROLE * 2 + 2, 1)) - 65
  NEXT TURBO.CUSTOM.ROLE
  TURBO.CUSTOM.READY% = -1
  RETURN

## TURBO.CUSTOM.SAVE -- write the Custom theme to the store.
TURBO.CUSTOM.SAVE:
  KVBIN.VALUE$ = ""
  FOR TURBO.CUSTOM.ROLE = 0 TO TURBO.ROLE.LAST
    TURBO.CUSTOM.VALUE% = TURBO.CUSTOM%(TURBO.CUSTOM.ROLE)
    KVBIN.VALUE$ = KVBIN.VALUE$ + CHR$(65 + INT(TURBO.CUSTOM.VALUE% / 16)) + CHR$(65 + (TURBO.CUSTOM.VALUE% AND 15))
  NEXT TURBO.CUSTOM.ROLE
  KVBIN.KEY$ = "TG.CUSTOM"
  GOSUB TURBO.SETTING.PUT
  RETURN

## TURBO.CUSTOM.TAKE -- copy the colours the editor has now into the Custom theme.
TURBO.CUSTOM.TAKE:
  FOR TURBO.CUSTOM.ROLE = 0 TO 9
    TURBO.CUSTOM%(TURBO.CUSTOM.ROLE) = THEME.CLR%(TURBO.CUSTOM.ROLE)
  NEXT TURBO.CUSTOM.ROLE
  TURBO.CUSTOM%(10) = VIEW.ATTR.TEXT%
  TURBO.CUSTOM%(11) = VIEW.ATTR.BAND%
  TURBO.CUSTOM%(12) = VIEW.ATTR.GUTTER%
  TURBO.CUSTOM%(13) = VIEW.ATTR.CURSOR%
  TURBO.CUSTOM%(TURBO.ROLE.SELECTION) = VIEW.SELECT.PAPER%
  TURBO.CUSTOM%(TURBO.ROLE.HOT) = TURBO.HOT.COLOUR%
  DOC.PEEK.BANK% = VIEW.KEY.BANK%
  GOSUB DOC.PEEK.BANK.SET
  FOR TURBO.CUSTOM.ROLE = TURBO.ROLE.INKS TO TURBO.ROLE.LAST
    TURBO.CUSTOM%(TURBO.CUSTOM.ROLE) = PEEK(TURBO.INK.TABLE + TURBO.CUSTOM.ROLE - TURBO.ROLE.INKS)
  NEXT TURBO.CUSTOM.ROLE
  TURBO.CUSTOM.READY% = -1
  RETURN

## TURBO.CUSTOM.PUT -- give THEME.CLR%, the text pane and the hot letters the Custom theme. With
## no Custom theme yet, it takes the colours the editor has now. It selects bank
## VIEW.KEY.BANK%. The caller gives the menus the theme.
TURBO.CUSTOM.PUT:
  IF TURBO.CUSTOM.READY% = 0 THEN GOSUB TURBO.CUSTOM.TAKE
  FOR TURBO.CUSTOM.ROLE = 0 TO 9
    THEME.CLR%(TURBO.CUSTOM.ROLE) = TURBO.CUSTOM%(TURBO.CUSTOM.ROLE)
  NEXT TURBO.CUSTOM.ROLE
  VIEW.ATTR.TEXT% = TURBO.CUSTOM%(10)
  VIEW.ATTR.BAND% = TURBO.CUSTOM%(11)
  VIEW.ATTR.GUTTER% = TURBO.CUSTOM%(12)
  VIEW.ATTR.CURSOR% = TURBO.CUSTOM%(13)
  VIEW.SELECT.PAPER% = TURBO.CUSTOM%(TURBO.ROLE.SELECTION) AND 240
  TURBO.HOT.COLOUR% = TURBO.CUSTOM%(TURBO.ROLE.HOT) AND 15
  DOC.PEEK.BANK% = VIEW.KEY.BANK%
  GOSUB DOC.PEEK.BANK.SET
  FOR TURBO.CUSTOM.ROLE = TURBO.ROLE.INKS TO TURBO.ROLE.LAST
    POKE TURBO.INK.TABLE + TURBO.CUSTOM.ROLE - TURBO.ROLE.INKS, TURBO.CUSTOM%(TURBO.CUSTOM.ROLE) AND 15
  NEXT TURBO.CUSTOM.ROLE
  RETURN

## TURBO.CUSTOM.EDIT -- the theme builder. A box at the right lists the 23 colours, and the
## editor behind it repaints in the theme at every change. Return keeps the theme, selects
## it and writes it to the store. Esc puts back the colours and the theme the editor had.
## The first edit starts from the colours the editor has now. The caller repaints.
##
##   Up, Down      choose a colour
##   Left, Right   step its background or its foreground through the 16 colours
##   Tab           switch between the background and the foreground
TURBO.CUSTOM.EDIT:
  IF LEN(TURBO.CUSTOM.NAMES$) = 0 THEN GOSUB TURBO.CUSTOM.WORDS.MAKE
  TURBO.CUSTOM.WAS.THEME% = THEME.ID%
  IF TURBO.CUSTOM.READY% = 0 THEN GOSUB TURBO.CUSTOM.TAKE
  FOR TURBO.CUSTOM.ROLE = 0 TO TURBO.ROLE.LAST
    TURBO.CUSTOM.KEPT%(TURBO.CUSTOM.ROLE) = TURBO.CUSTOM%(TURBO.CUSTOM.ROLE)
  NEXT TURBO.CUSTOM.ROLE
  THEME.ID% = 4
  TURBO.CUSTOM.ROW% = 0
  TURBO.CUSTOM.SIDE% = 1
  GOSUB TURBO.CUSTOM.SHOW
TURBO.CUSTOM.KEY:
  GET TURBO.CUSTOM.PRESSED$
  IF TURBO.CUSTOM.PRESSED$ = "" THEN GOTO TURBO.CUSTOM.KEY
  IF TURBO.CUSTOM.PRESSED$ = CHR$(13) THEN GOTO TURBO.CUSTOM.KEEP
  IF TURBO.CUSTOM.PRESSED$ = CHR$(27) THEN GOTO TURBO.CUSTOM.DROP
  IF TURBO.CUSTOM.PRESSED$ = CHR$(145) THEN GOTO TURBO.CUSTOM.UP
  IF TURBO.CUSTOM.PRESSED$ = CHR$(17) THEN GOTO TURBO.CUSTOM.DOWN
  IF TURBO.CUSTOM.PRESSED$ = CHR$(9) THEN GOTO TURBO.CUSTOM.TAB
  IF TURBO.CUSTOM.PRESSED$ = CHR$(157) THEN GOSUB TURBO.CUSTOM.LOWER
  IF TURBO.CUSTOM.PRESSED$ = CHR$(29) THEN GOSUB TURBO.CUSTOM.HIGHER
  GOTO TURBO.CUSTOM.KEY
TURBO.CUSTOM.UP:
  TURBO.CUSTOM.ROW% = TURBO.CUSTOM.ROW% - 1
  IF TURBO.CUSTOM.ROW% < 0 THEN TURBO.CUSTOM.ROW% = TURBO.ROLE.LAST
  GOTO TURBO.CUSTOM.MOVED
TURBO.CUSTOM.DOWN:
  TURBO.CUSTOM.ROW% = TURBO.CUSTOM.ROW% + 1
  IF TURBO.CUSTOM.ROW% > TURBO.ROLE.LAST THEN TURBO.CUSTOM.ROW% = 0
TURBO.CUSTOM.MOVED:
  IF TURBO.CUSTOM.ROW% = TURBO.ROLE.SELECTION THEN TURBO.CUSTOM.SIDE% = 0
  IF TURBO.CUSTOM.ROW% > TURBO.ROLE.SELECTION THEN TURBO.CUSTOM.SIDE% = 1
  GOSUB TURBO.CUSTOM.BOX.PAINT
  GOTO TURBO.CUSTOM.KEY
TURBO.CUSTOM.TAB:
  IF TURBO.CUSTOM.ROW% < TURBO.ROLE.SELECTION THEN TURBO.CUSTOM.SIDE% = 1 - TURBO.CUSTOM.SIDE%
  GOTO TURBO.CUSTOM.MOVED
TURBO.CUSTOM.KEEP:
  TURBO.CUSTOM.READY% = -1
  GOSUB TURBO.CUSTOM.SAVE
  RETURN
TURBO.CUSTOM.DROP:
  FOR TURBO.CUSTOM.ROLE = 0 TO TURBO.ROLE.LAST
    TURBO.CUSTOM%(TURBO.CUSTOM.ROLE) = TURBO.CUSTOM.KEPT%(TURBO.CUSTOM.ROLE)
  NEXT TURBO.CUSTOM.ROLE
  THEME.ID% = TURBO.CUSTOM.WAS.THEME%
  GOSUB TURBO.THEME.APPLY
  RETURN

## Make the box's words PETSCII, once a run. TURBO.CUSTOM.NAMES$ holds the 23 names,
## TURBO.CUSTOM.NAME.WIDTH letters each. TURBO.CUSTOM.WORDS$ holds the title from 1, the
## column heads from 15, the sample from 20 and the two hints from 25 and 47.
TURBO.CUSTOM.WORDS.MAKE:
  TURBO.ASCII.TEXT$ = "Page       Box text   Box title  Box frame  Hilite     Dimmed     "
  TURBO.ASCII.TEXT$ = TURBO.ASCII.TEXT$ + "Warning    Focus      Bars       Shadow     Text       "
  TURBO.ASCII.TEXT$ = TURBO.ASCII.TEXT$ + "Cursor lineLine no.   Cursor     Selection  Hot letter "
  TURBO.ASCII.TEXT$ = TURBO.ASCII.TEXT$ + "Plain      Statement  Function   String     Number     "
  TURBO.ASCII.TEXT$ = TURBO.ASCII.TEXT$ + "Comment    Other word "
  GOSUB TURBO.ASCII.TO.PETSCII
  TURBO.CUSTOM.NAMES$ = TURBO.PETSCII.TEXT$
  TURBO.ASCII.TEXT$ = " Custom theme Bg Fg Abc Up Down Left Right TabReturn keep  Esc cancel"
  GOSUB TURBO.ASCII.TO.PETSCII
  TURBO.CUSTOM.WORDS$ = TURBO.PETSCII.TEXT$
  RETURN

## Step half TURBO.CUSTOM.SIDE% of colour TURBO.CUSTOM.ROW% down or up by one, and show the
## theme. Side 0 is the background, 1 the foreground.
TURBO.CUSTOM.LOWER:
  TURBO.CUSTOM.VALUE% = TURBO.CUSTOM%(TURBO.CUSTOM.ROW%)
  IF TURBO.CUSTOM.SIDE% = 0 THEN TURBO.CUSTOM.VALUE% = (TURBO.CUSTOM.VALUE% + 240) AND 255
  IF TURBO.CUSTOM.SIDE% = 1 THEN TURBO.CUSTOM.VALUE% = (TURBO.CUSTOM.VALUE% AND 240) + ((TURBO.CUSTOM.VALUE% + 15) AND 15)
  GOTO TURBO.CUSTOM.CHANGED
TURBO.CUSTOM.HIGHER:
  TURBO.CUSTOM.VALUE% = TURBO.CUSTOM%(TURBO.CUSTOM.ROW%)
  IF TURBO.CUSTOM.SIDE% = 0 THEN TURBO.CUSTOM.VALUE% = (TURBO.CUSTOM.VALUE% + 16) AND 255
  IF TURBO.CUSTOM.SIDE% = 1 THEN TURBO.CUSTOM.VALUE% = (TURBO.CUSTOM.VALUE% AND 240) + ((TURBO.CUSTOM.VALUE% + 1) AND 15)
TURBO.CUSTOM.CHANGED:
  TURBO.CUSTOM%(TURBO.CUSTOM.ROW%) = TURBO.CUSTOM.VALUE%
TURBO.CUSTOM.SHOW:
  GOSUB TURBO.THEME.APPLY
  GOSUB TURBO.TITLE.PAINT
  GOSUB TURBO.STATUS.PAINT
  GOSUB VIEW.PAINT.ALL
  GOTO TURBO.CUSTOM.BOX.PAINT

## Draw the builder's box in the theme's own colours.
TURBO.CUSTOM.BOX.PAINT:
  GP.FILL TURBO.CUSTOM.BOX.LEFT, TURBO.CUSTOM.BOX.TOP, TURBO.CUSTOM.BOX.WIDTH, TURBO.CUSTOM.BOX.HEIGHT, 32, THEME.CLR%(THEME.TEXT)
  GP.BOX TURBO.CUSTOM.BOX.LEFT, TURBO.CUSTOM.BOX.TOP, TURBO.CUSTOM.BOX.WIDTH, TURBO.CUSTOM.BOX.HEIGHT, TURBO.FRAME.ADDR, THEME.CLR%(THEME.BORDER)
  GP.PRINTAT TURBO.CUSTOM.INNER.LEFT, TURBO.CUSTOM.BOX.TOP, MID$(TURBO.CUSTOM.WORDS$, 1, 14), THEME.CLR%(THEME.TITLE)
  GP.PRINTAT TURBO.CUSTOM.INNER.LEFT + 18, TURBO.CUSTOM.BOX.TOP, MID$(TURBO.CUSTOM.WORDS$, 15, 5), THEME.CLR%(THEME.TITLE)
  FOR TURBO.CUSTOM.ROLE = 0 TO TURBO.ROLE.LAST
    GOSUB TURBO.CUSTOM.ROW.PAINT
  NEXT TURBO.CUSTOM.ROLE
  GP.PRINTAT TURBO.CUSTOM.INNER.LEFT, TURBO.CUSTOM.BOX.TOP + 25, MID$(TURBO.CUSTOM.WORDS$, 25, 22), THEME.CLR%(THEME.DIMMED)
  GP.PRINTAT TURBO.CUSTOM.INNER.LEFT, TURBO.CUSTOM.BOX.TOP + 26, MID$(TURBO.CUSTOM.WORDS$, 47, 23), THEME.CLR%(THEME.DIMMED)
  RETURN

## Draw row TURBO.CUSTOM.ROLE: the name, a sample in the colour, and its two numbers. The
## chosen row's name and the half the arrows change are in HILITE.
TURBO.CUSTOM.ROW.PAINT:
  TURBO.CUSTOM.VALUE% = TURBO.CUSTOM%(TURBO.CUSTOM.ROLE)
  TURBO.CUSTOM.ATTR% = THEME.CLR%(THEME.TEXT)
  IF TURBO.CUSTOM.ROLE = TURBO.CUSTOM.ROW% THEN TURBO.CUSTOM.ATTR% = THEME.CLR%(THEME.HILITE)
  GP.PRINTAT TURBO.CUSTOM.INNER.LEFT, TURBO.CUSTOM.BOX.TOP + 1 + TURBO.CUSTOM.ROLE, MID$(TURBO.CUSTOM.NAMES$, TURBO.CUSTOM.ROLE * TURBO.CUSTOM.NAME.WIDTH + 1, TURBO.CUSTOM.NAME.WIDTH), TURBO.CUSTOM.ATTR%
  ## ---- a foreground alone shows on the background it is used on ----
  TURBO.CUSTOM.ATTR% = TURBO.CUSTOM.VALUE%
  IF TURBO.CUSTOM.ROLE = TURBO.ROLE.SELECTION THEN TURBO.CUSTOM.ATTR% = (TURBO.CUSTOM.VALUE% AND 240) + (TURBO.CUSTOM%(TURBO.ROLE.PANE.TEXT) AND 15)
  IF TURBO.CUSTOM.ROLE = TURBO.ROLE.HOT THEN TURBO.CUSTOM.ATTR% = (TURBO.CUSTOM%(1) AND 240) + TURBO.CUSTOM.VALUE%
  IF TURBO.CUSTOM.ROLE >= TURBO.ROLE.INKS THEN TURBO.CUSTOM.ATTR% = (TURBO.CUSTOM%(TURBO.ROLE.PANE.TEXT) AND 240) + TURBO.CUSTOM.VALUE%
  GP.PRINTAT TURBO.CUSTOM.INNER.LEFT + 12, TURBO.CUSTOM.BOX.TOP + 1 + TURBO.CUSTOM.ROLE, MID$(TURBO.CUSTOM.WORDS$, 20, 5), TURBO.CUSTOM.ATTR%
  ## ---- the background's number ----
  TURBO.CUSTOM.ATTR% = THEME.CLR%(THEME.TEXT)
  IF TURBO.CUSTOM.ROLE = TURBO.CUSTOM.ROW% AND TURBO.CUSTOM.SIDE% = 0 THEN TURBO.CUSTOM.ATTR% = THEME.CLR%(THEME.HILITE)
  IF TURBO.CUSTOM.ROLE <= TURBO.ROLE.SELECTION THEN GP.PRINTAT TURBO.CUSTOM.INNER.LEFT + 18, TURBO.CUSTOM.BOX.TOP + 1 + TURBO.CUSTOM.ROLE, RIGHT$(STR$(100 + INT(TURBO.CUSTOM.VALUE% / 16)), 2), TURBO.CUSTOM.ATTR%
  IF TURBO.CUSTOM.ROLE > TURBO.ROLE.SELECTION THEN GP.PRINTAT TURBO.CUSTOM.INNER.LEFT + 18, TURBO.CUSTOM.BOX.TOP + 1 + TURBO.CUSTOM.ROLE, "--", TURBO.CUSTOM.ATTR%
  ## ---- the foreground's number ----
  TURBO.CUSTOM.ATTR% = THEME.CLR%(THEME.TEXT)
  IF TURBO.CUSTOM.ROLE = TURBO.CUSTOM.ROW% AND TURBO.CUSTOM.SIDE% = 1 THEN TURBO.CUSTOM.ATTR% = THEME.CLR%(THEME.HILITE)
  IF TURBO.CUSTOM.ROLE <> TURBO.ROLE.SELECTION THEN GP.PRINTAT TURBO.CUSTOM.INNER.LEFT + 21, TURBO.CUSTOM.BOX.TOP + 1 + TURBO.CUSTOM.ROLE, RIGHT$(STR$(100 + (TURBO.CUSTOM.VALUE% AND 15)), 2), TURBO.CUSTOM.ATTR%
  IF TURBO.CUSTOM.ROLE = TURBO.ROLE.SELECTION THEN GP.PRINTAT TURBO.CUSTOM.INNER.LEFT + 21, TURBO.CUSTOM.BOX.TOP + 1 + TURBO.CUSTOM.ROLE, "--", TURBO.CUSTOM.ATTR%
  RETURN
