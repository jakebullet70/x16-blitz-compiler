## TG-PREFS.BASL -- the Settings box for TURBO.BASL, and the settings it keeps in the store.
##
## The box sets four things:
##   Theme          THEME.ID%, 0 to 4: X16, Dark, Light, Gray, Custom
##   Tab width      VIEW.TAB.WIDTH%, 2, 3, 4 or 8
##   New files      TURBO.NEW.PETSCII%, the encoding of File, New: 0 ASCII, -1 PETSCII
##   Syntax colour  VIEW.COLOUR.ON%, 1 on, 0 off
##
## A theme picked in the box recolours the box alone. OK gives the rest of the editor the
## theme and writes the settings that changed. Cancel puts the old theme back. Edit custom
## opens the theme builder of TG-THEME.BASL over the editor, then the box again.
##
## The store /SETTINGS.KVB keeps them under TG.THEME, TG.TAB.WIDTH, TG.NEW.PETSCII and
## TG.COLOUR. TURBO.PREFS.LOAD reads them at the start.
##
## WARNING: GP.SUB and GP.FN compile only below their GP.DEFPROC. TURBO.BASL includes this file
## below GUI-DIALOGS.

#DEFINE TURBO.PREFS.FORM.WIDTH 44
#DEFINE TURBO.PREFS.LABEL.WIDTH 10
#DEFINE TURBO.PREFS.RIGHT.COLUMN 22

## The box's controls, numbered in the order TURBO.PREFS.FORM adds them.
#DEFINE TURBO.PREFS.THEME.CONTROL 1
#DEFINE TURBO.PREFS.PETSCII.CONTROL 2
#DEFINE TURBO.PREFS.TAB.CONTROL 3
#DEFINE TURBO.PREFS.EDIT.CONTROL 4
#DEFINE TURBO.PREFS.COLOUR.CONTROL 5

## TURBO.PREFS.LOAD -- read the settings from the store and give the editor the theme. A key
## the store does not hold keeps the setting it has. Call it once, after TURBO.SETUP.
TURBO.PREFS.LOAD:
  TURBO.NEW.PETSCII% = 0
  KVBIN.KEY$ = "TG.THEME"
  GOSUB KVBIN.GET
  IF LEN(KVBIN.VALUE$) > 0 THEN THEME.ID% = VAL(KVBIN.VALUE$)
  KVBIN.KEY$ = "TG.TAB.WIDTH"
  GOSUB KVBIN.GET
  IF LEN(KVBIN.VALUE$) > 0 THEN VIEW.TAB.WIDTH% = VAL(KVBIN.VALUE$)
  KVBIN.KEY$ = "TG.NEW.PETSCII"
  GOSUB KVBIN.GET
  IF VAL(KVBIN.VALUE$) <> 0 THEN TURBO.NEW.PETSCII% = -1
  KVBIN.KEY$ = "TG.COLOUR"
  GOSUB KVBIN.GET
  IF LEN(KVBIN.VALUE$) > 0 THEN VIEW.COLOUR.ON% = VAL(KVBIN.VALUE$)
  GOSUB TURBO.CUSTOM.LOAD
  TURBO.FILE.PETSCII% = TURBO.NEW.PETSCII%
  FOR TURBO.PREFS.DOCUMENT = 0 TO 2
    TURBO.KEPT.PETSCII%(TURBO.PREFS.DOCUMENT) = TURBO.NEW.PETSCII%
  NEXT TURBO.PREFS.DOCUMENT
  GOTO TURBO.THEME.APPLY

## TURBO.PREFS.SHOW -- the Settings box. OK repaints the editor in the settings chosen.
TURBO.PREFS.SHOW:
  TURBO.PREFS.KEPT.THEME% = THEME.ID%
  TURBO.PREFS.KEPT.TAB% = VIEW.TAB.WIDTH%
  TURBO.PREFS.KEPT.PETSCII% = TURBO.NEW.PETSCII%
  TURBO.PREFS.KEPT.COLOUR% = VIEW.COLOUR.ON%
  TURBO.PREFS.TAB% = VIEW.TAB.WIDTH%
  TURBO.PREFS.PETSCII% = TURBO.NEW.PETSCII%
  TURBO.PREFS.COLOUR% = VIEW.COLOUR.ON%
  TURBO.PREFS.RETHEMED% = 0
TURBO.PREFS.OPEN:
  GOSUB TURBO.PREFS.FORM
  GP.DO
    TURBO.PREFS.EVENT% = GP.FN(FORMTO.EVENT)
    IF TURBO.PREFS.EVENT% <= 0 THEN GP.EXITDO
    IF TURBO.PREFS.EVENT% = TURBO.PREFS.THEME.CONTROL THEN GP.EXITDO
    IF TURBO.PREFS.EVENT% = TURBO.PREFS.EDIT.CONTROL THEN GP.EXITDO
  GP.LOOP
  GOSUB TURBO.PREFS.READ
  GP.SUB FORM.END
  IF TURBO.PREFS.EVENT% <= 0 THEN GOTO TURBO.PREFS.CLOSED
  ## TURBO.PREFS.RETHEMED% bit 0: the theme changed. Bit 1: the editor was repainted.
  TURBO.PREFS.RETHEMED% = TURBO.PREFS.RETHEMED% OR 1
  IF TURBO.PREFS.EVENT% = TURBO.PREFS.EDIT.CONTROL THEN GOTO TURBO.PREFS.BUILD
  ## ---- a new theme: open the box again in it ----
  GOSUB TURBO.THEME.APPLY
  GOTO TURBO.PREFS.OPEN
TURBO.PREFS.BUILD:
  GOSUB TURBO.CUSTOM.EDIT
  GOSUB TURBO.TITLE.PAINT
  GOSUB TURBO.STATUS.PAINT
  GOSUB VIEW.PAINT.ALL
  TURBO.PREFS.RETHEMED% = TURBO.PREFS.RETHEMED% OR 2
  GOTO TURBO.PREFS.OPEN
TURBO.PREFS.CLOSED:
  IF TURBO.PREFS.EVENT% = 0 THEN GOTO TURBO.PREFS.CANCEL
  VIEW.TAB.WIDTH% = TURBO.PREFS.TAB%
  TURBO.NEW.PETSCII% = TURBO.PREFS.PETSCII%
  VIEW.COLOUR.ON% = TURBO.PREFS.COLOUR%
  GOSUB TURBO.PREFS.SAVE
  GOSUB TURBO.THEME.APPLY
  GOSUB TURBO.TITLE.PAINT
  GOSUB TURBO.STATUS.PAINT
  GOSUB VIEW.PAINT.ALL
  RETURN
TURBO.PREFS.CANCEL:
  THEME.ID% = TURBO.PREFS.KEPT.THEME%
  IF TURBO.PREFS.RETHEMED% <> 0 THEN GOSUB TURBO.THEME.APPLY
  IF (TURBO.PREFS.RETHEMED% AND 2) = 0 THEN RETURN
  GOSUB TURBO.TITLE.PAINT
  GOSUB TURBO.STATUS.PAINT
  GOSUB VIEW.PAINT.ALL
  RETURN

## Draw the box with the settings it holds now. The theme is control 1, so it has the focus
## when the box opens again in a new theme.
TURBO.PREFS.FORM:
  GP.SUB FORM.BEGIN, GP.FN(TURBO.PETSCII, "Settings"), "", "", 8, TURBO.PREFS.FORM.WIDTH, GP.FN(TURBO.PETSCII, "&OK"), GP.FN(TURBO.PETSCII, "&Cancel")
  GP.SUB FORM.ITEMS, TURBO.ITEM.BANK%, TURBO.ITEM.ADDR
  TURBO.PREFS.CONTROL% = GP.FN(FORM.RADIO, 0, GP.FN(TURBO.PETSCII, "Theme:"), TURBO.PREFS.LABEL.WIDTH, THEME.ID% + 1)
  GP.SUB FORM.ITEM, GP.FN(TURBO.PETSCII, "X16")
  GP.SUB FORM.ITEM, GP.FN(TURBO.PETSCII, "Dark")
  GP.SUB FORM.ITEM, GP.FN(TURBO.PETSCII, "Light")
  GP.SUB FORM.ITEM, GP.FN(TURBO.PETSCII, "Gray")
  GP.SUB FORM.ITEM, GP.FN(TURBO.PETSCII, "Custom")
  TURBO.PREFS.CONTROL% = GP.FN(FORM.RADIO, 6, GP.FN(TURBO.PETSCII, "New files:"), TURBO.PREFS.LABEL.WIDTH, 1 - TURBO.PREFS.PETSCII%)
  GP.SUB FORM.ITEM, GP.FN(TURBO.PETSCII, "ASCII")
  GP.SUB FORM.ITEM, GP.FN(TURBO.PETSCII, "PETSCII")
  GP.SUB FORM.COLUMN, TURBO.PREFS.RIGHT.COLUMN
  TURBO.PREFS.TAB.SEL% = 3
  IF TURBO.PREFS.TAB% < 4 THEN TURBO.PREFS.TAB.SEL% = TURBO.PREFS.TAB% - 1
  IF TURBO.PREFS.TAB% = 8 THEN TURBO.PREFS.TAB.SEL% = 4
  TURBO.PREFS.CONTROL% = GP.FN(FORM.RADIO, 0, GP.FN(TURBO.PETSCII, "Tab width:"), TURBO.PREFS.LABEL.WIDTH, TURBO.PREFS.TAB.SEL%)
  GP.SUB FORM.ITEM, "2"
  GP.SUB FORM.ITEM, "3"
  GP.SUB FORM.ITEM, "4"
  GP.SUB FORM.ITEM, "8"
  TURBO.PREFS.CONTROL% = GP.FN(FORM.CHECK, 4, GP.FN(TURBO.PETSCII, "&Edit custom..."), 0)
  TURBO.PREFS.CONTROL% = GP.FN(FORM.CHECK, 6, GP.FN(TURBO.PETSCII, "S&yntax colour"), TURBO.PREFS.COLOUR%)
  GP.SUB FORM.COLUMN, 0
  RETURN

## Read the box's controls into THEME.ID% and the TURBO.PREFS working copies.
TURBO.PREFS.READ:
  THEME.ID% = GP.FN(FORM.SEL, TURBO.PREFS.THEME.CONTROL) - 1
  TURBO.PREFS.PETSCII% = 0
  IF GP.FN(FORM.SEL, TURBO.PREFS.PETSCII.CONTROL) = 2 THEN TURBO.PREFS.PETSCII% = -1
  TURBO.PREFS.TAB.SEL% = GP.FN(FORM.SEL, TURBO.PREFS.TAB.CONTROL)
  TURBO.PREFS.TAB% = TURBO.PREFS.TAB.SEL% + 1
  IF TURBO.PREFS.TAB.SEL% = 4 THEN TURBO.PREFS.TAB% = 8
  TURBO.PREFS.COLOUR% = 0
  IF GP.FN(FORM.CHECKED, TURBO.PREFS.COLOUR.CONTROL) <> 0 THEN TURBO.PREFS.COLOUR% = 1
  RETURN

## Write each setting that differs from what the box opened with, and the Custom theme when
## it is the theme.
TURBO.PREFS.SAVE:
  GP.IF THEME.ID% <> TURBO.PREFS.KEPT.THEME% THEN
    KVBIN.KEY$ = "TG.THEME"
    KVBIN.VALUE$ = CHR$(48 + THEME.ID%)
    GOSUB TURBO.SETTING.PUT
  GP.ENDIF
  GP.IF VIEW.TAB.WIDTH% <> TURBO.PREFS.KEPT.TAB% THEN
    KVBIN.KEY$ = "TG.TAB.WIDTH"
    KVBIN.VALUE$ = CHR$(48 + VIEW.TAB.WIDTH%)
    GOSUB TURBO.SETTING.PUT
  GP.ENDIF
  GP.IF TURBO.NEW.PETSCII% <> TURBO.PREFS.KEPT.PETSCII% THEN
    KVBIN.KEY$ = "TG.NEW.PETSCII"
    KVBIN.VALUE$ = CHR$(48 - TURBO.NEW.PETSCII%)
    GOSUB TURBO.SETTING.PUT
  GP.ENDIF
  GP.IF VIEW.COLOUR.ON% <> TURBO.PREFS.KEPT.COLOUR% THEN
    KVBIN.KEY$ = "TG.COLOUR"
    KVBIN.VALUE$ = CHR$(48 + VIEW.COLOUR.ON%)
    GOSUB TURBO.SETTING.PUT
  GP.ENDIF
  IF THEME.ID% = 4 THEN GOSUB TURBO.CUSTOM.SAVE
  RETURN
