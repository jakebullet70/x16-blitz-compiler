#SAVEAS "@:KEYBEN.SRC.PRG"
#REM 0
#SYMFILE "@:KEYBEN.SRC.SYM"
#INCLUDE "GPC-BASIC/GPB.INC.BL"
#INCLUDE "GPC-BASIC/MEM.INC.BL"

## ============================================================================
## KEYBEN -- checks the key map and the edit keys on the 2,000 line document, and times the
## keys the other benches do not.
##
## It feeds the keys of KEYBEN.KEY to KEYS.DISPATCH. keymodel.py writes that file and
## documents its layout. The document then goes to KEYBEN.OUT and the pane to KEYBEN.PANE.
## The keys end with a selection on, so the pane holds its highlight. The selection then
## ends.
##
## It undoes every edit and the document goes to KEYBEN.UND. It redoes every edit and the
## document goes to KEYBEN.RED. The keys write more records than the editor's rings hold,
## so KEYBEN's rings keep 512 records each, in bank BEN.RING.BANK.
##
## It loads the document again and times keys through KEYS.DISPATCH on line 100: 40
## characters typed from column 0, 40 Backspaces, 40 Deletes, 40 cursor rights, 20
## RETURNs at column 0 and the 20 Backspaces that join the lines again. From column 0 of
## that line it times 40 Ctrl+Rights, then 40 Ctrl+Lefts. The document goes to
## KEYBEN.TIM.
##
## The results go to KEYBEN.RES. spike.py checks the four documents, the pane and the
## cursor.
##
## WARNING: run it at real speed. Under -warp, TI is not tied to the CPU.
## ============================================================================

BEN.SCRIPT.BANK = 14
BEN.RING.BANK = 11
BEN.TIMED.KEYS = 40
BEN.TIMED.JOINS = 20

SCREEN 1
GOSUB DOC.SETUP
GOSUB UNDO.SETUP
UNDO.RING.BANK% = BEN.RING.BANK
UNDO.RING.PAGE% = 160
UNDO.RING.DEPTH% = 512
GOSUB UNDO.CLEAR
GOSUB VIEW.SETUP
GOSUB KEYS.SETUP
GOSUB CLIP.SETUP
GOSUB BEN.CONFIG

## ---- the keys of KEYBEN.KEY ----
GOSUB BEN.LOAD.FIXTURE
BLOAD "KEYBEN.KEY", 8, BEN.SCRIPT.BANK, 40960
BANK BEN.SCRIPT.BANK
BEN.KEY.TOTAL = PEEK(40960) + PEEK(40961) * 256
BEN.COMMANDS = 0
KEYS.MODIFIERS% = 0
FOR BEN.KEY.INDEX = 0 TO BEN.KEY.TOTAL - 1
  BANK BEN.SCRIPT.BANK
  KEYS.CODE% = PEEK(40962 + BEN.KEY.INDEX * 2)
  KEYS.MODIFIERS% = PEEK(40963 + BEN.KEY.INDEX * 2)
  GOSUB KEYS.DISPATCH
  IF KEYS.COMMAND% <> 0 THEN BEN.COMMANDS = BEN.COMMANDS + 1
NEXT BEN.KEY.INDEX
KEYS.MODIFIERS% = 0
BEN.SCRIPT.LINES = LINE.COUNT%
DOC.FILE.NAME$ = "KEYBEN.OUT"
GOSUB DOC.SAVEFILE
BEN.PANE.NAME$ = "KEYBEN.PANE"
GOSUB BEN.PANE.DUMP
BEN.PANE.TOP = VIEW.TOP.LINE%
BEN.PANE.LEFT = VIEW.LEFT.COL%
BEN.PANE.CURSOR.LINE = VIEW.CURSOR.LINE%
BEN.PANE.CURSOR.COL = VIEW.CURSOR.COL%
BEN.SELECT.ON = VIEW.SELECT.ON%
BEN.SELECT.ANCHOR.LINE = VIEW.SELECT.ANCHOR.LINE%
BEN.SELECT.ANCHOR.COL = VIEW.SELECT.ANCHOR.COL%
VIEW.SELECT.ON% = 0

## ---- undo every edit, then redo every edit ----
BEN.UNDO.APPLIED = 0
GOSUB BEN.UNDO.ALL
BEN.UNDO.LINES = LINE.COUNT%
DOC.FILE.NAME$ = "KEYBEN.UND"
GOSUB DOC.SAVEFILE
BEN.REDO.APPLIED = 0
GOSUB BEN.REDO.ALL
BEN.REDO.LINES = LINE.COUNT%
DOC.FILE.NAME$ = "KEYBEN.RED"
GOSUB DOC.SAVEFILE

## ---- the timed keys, on line 100 ----
GOSUB VIEW.CURSOR.TOP
GOSUB BEN.LOAD.FIXTURE
FOR BEN.COUNT = 1 TO 100
  GOSUB VIEW.CURSOR.DOWN
NEXT BEN.COUNT

KEYS.CODE% = 88
BEN.KEY.COUNT = BEN.TIMED.KEYS
GOSUB BEN.TIME.KEY
BEN.TYPE.JIFFIES = BEN.JIFFIES

KEYS.CODE% = 20
GOSUB BEN.TIME.KEY
BEN.BACK.JIFFIES = BEN.JIFFIES

KEYS.CODE% = 88
GOSUB BEN.TIME.KEY
GOSUB VIEW.CURSOR.HOME
KEYS.CODE% = 25
GOSUB BEN.TIME.KEY
BEN.DELETE.JIFFIES = BEN.JIFFIES

KEYS.CODE% = 29
GOSUB BEN.TIME.KEY
BEN.RIGHT.JIFFIES = BEN.JIFFIES

GOSUB VIEW.CURSOR.HOME
KEYS.CODE% = 13
BEN.KEY.COUNT = BEN.TIMED.JOINS
GOSUB BEN.TIME.KEY
BEN.RETURN.JIFFIES = BEN.JIFFIES
BEN.RETURN.LINES = LINE.COUNT%

KEYS.CODE% = 20
GOSUB BEN.TIME.KEY
BEN.JOIN.JIFFIES = BEN.JIFFIES
BEN.JOIN.LINES = LINE.COUNT%
BEN.JOIN.CURSOR = VIEW.CURSOR.LINE%

GOSUB VIEW.CURSOR.HOME
KEYS.MODIFIERS% = 4
KEYS.CODE% = 29
BEN.KEY.COUNT = BEN.TIMED.KEYS
GOSUB BEN.TIME.KEY
BEN.WORD.RIGHT.JIFFIES = BEN.JIFFIES
KEYS.CODE% = 157
GOSUB BEN.TIME.KEY
BEN.WORD.LEFT.JIFFIES = BEN.JIFFIES
KEYS.MODIFIERS% = 0
DOC.FILE.NAME$ = "KEYBEN.TIM"
GOSUB DOC.SAVEFILE

OPEN 3, 8, 3, "@:KEYBEN.RES,S,W"
PRINT# 3, "KEYS"; BEN.KEY.TOTAL
PRINT# 3, "COMMANDS"; BEN.COMMANDS
PRINT# 3, "SCRIPT.LINES"; BEN.SCRIPT.LINES
PRINT# 3, "UNDO.APPLIED"; BEN.UNDO.APPLIED
PRINT# 3, "UNDO.LINES"; BEN.UNDO.LINES
PRINT# 3, "REDO.APPLIED"; BEN.REDO.APPLIED
PRINT# 3, "REDO.LINES"; BEN.REDO.LINES
PRINT# 3, "TIMED.KEYS"; BEN.TIMED.KEYS
PRINT# 3, "TYPE.JIFFIES"; BEN.TYPE.JIFFIES
PRINT# 3, "BACK.JIFFIES"; BEN.BACK.JIFFIES
PRINT# 3, "DELETE.JIFFIES"; BEN.DELETE.JIFFIES
PRINT# 3, "RIGHT.JIFFIES"; BEN.RIGHT.JIFFIES
PRINT# 3, "TIMED.JOINS"; BEN.TIMED.JOINS
PRINT# 3, "RETURN.JIFFIES"; BEN.RETURN.JIFFIES
PRINT# 3, "RETURN.LINES"; BEN.RETURN.LINES
PRINT# 3, "JOIN.JIFFIES"; BEN.JOIN.JIFFIES
PRINT# 3, "JOIN.LINES"; BEN.JOIN.LINES
PRINT# 3, "JOIN.CURSOR"; BEN.JOIN.CURSOR
PRINT# 3, "WORD.RIGHT.JIFFIES"; BEN.WORD.RIGHT.JIFFIES
PRINT# 3, "WORD.LEFT.JIFFIES"; BEN.WORD.LEFT.JIFFIES
PRINT# 3, "FULL"; DOC.FULL%
PRINT# 3, "COLOUR"; VIEW.COLOUR.ON%
PRINT# 3, "PANE.TOP"; BEN.PANE.TOP
PRINT# 3, "PANE.LEFT"; BEN.PANE.LEFT
PRINT# 3, "PANE.CURSOR.LINE"; BEN.PANE.CURSOR.LINE
PRINT# 3, "PANE.CURSOR.COL"; BEN.PANE.CURSOR.COL
PRINT# 3, "SELECT.ON "; BEN.SELECT.ON
PRINT# 3, "SELECT.ANCHOR.LINE"; BEN.SELECT.ANCHOR.LINE
PRINT# 3, "SELECT.ANCHOR.COL"; BEN.SELECT.ANCHOR.COL
PRINT# 3, "DONE"
CLOSE 3
END

## Load the fixture, empty the undo rings, open line 0 and paint the pane. The cursor
## must be on line 0.
BEN.LOAD.FIXTURE:
  DOC.FILE.NAME$ = "FIX2000.TXT"
  GOSUB DOC.LOADFILE
  GOSUB UNDO.CLEAR
  DOC.LINE% = 0
  GOSUB DOC.EDIT.OPEN
  GOSUB VIEW.PAINT.ALL
  RETURN

## Send key KEYS.CODE% to KEYS.DISPATCH BEN.KEY.COUNT times.
##
##   out  BEN.JIFFIES   the time of all of them
BEN.TIME.KEY:
  BEN.START = TI
  FOR BEN.COUNT = 1 TO BEN.KEY.COUNT
    GOSUB KEYS.DISPATCH
  NEXT BEN.COUNT
  BEN.JIFFIES = TI - BEN.START
  RETURN

## Undo until no edit is left. Each undo adds one to BEN.UNDO.APPLIED.
BEN.UNDO.ALL:
  GOSUB VIEW.UNDO
  IF UNDO.DONE% = 0 THEN RETURN
  BEN.UNDO.APPLIED = BEN.UNDO.APPLIED + 1
  GOTO BEN.UNDO.ALL

## Redo until no edit is left. Each redo adds one to BEN.REDO.APPLIED.
BEN.REDO.ALL:
  GOSUB VIEW.REDO
  IF UNDO.DONE% = 0 THEN RETURN
  BEN.REDO.APPLIED = BEN.REDO.APPLIED + 1
  GOTO BEN.REDO.ALL

#INCLUDE "TG-BENCH-CHECK.BASL"
#INCLUDE "TG-STORE.BASL"
#INCLUDE "TG-UNDO.BASL"
#INCLUDE "TG-VIEW.BASL"
#INCLUDE "TG-CLIP.BASL"
#INCLUDE "TG-KEYS.BASL"
#INCLUDE "TG-LOW.BASL"
