#SAVEAS "@:EDITBEN.SRC.PRG"
#REM 0
#SYMFILE "@:EDITBEN.SRC.SYM"
#INCLUDE "GPC-BASIC/GPB.INC.BL"
#INCLUDE "GPC-BASIC/MEM.INC.BL"

## ============================================================================
## EDITBEN -- the edit and file paths on a 2,000 line document: load, type, RETURN, delete
## line, save, find. It is the sequence MSBENCH.P8 drives MSEDIT through, without the moves,
## scrolls and pages.
##
## Each key is the whole path: decide, note the edit for undo, change the store, paint,
## status. Times are jiffies off TI. The bench's own FOR loop is inside each time.
##
## WARNING: run it at real speed. Under -warp TI is not tied to the CPU.
##
## The results go to EDITBEN.RES. The saved document goes to EDITBEN.OUT. The MISMATCHES
## rows count the cells of the pane that differ from the store read in BASIC. The pane
## after the find goes to EDITBEN.PANE.
## ============================================================================

BEN.TYPE.LINES = 5
BEN.TYPE.KEYS = 40
BEN.RETURNS = 50

SCREEN 1
GOSUB DOC.SETUP
GOSUB UNDO.SETUP
GOSUB VIEW.SETUP
GOSUB BEN.CONFIG

## ---- load, with the first paint ----
BEN.START = TI
DOC.FILE.NAME$ = "FIX2000.TXT"
GOSUB DOC.LOADFILE
DOC.LINE% = 0
GOSUB DOC.EDIT.OPEN
GOSUB VIEW.PAINT.ALL
BEN.LOAD.JIFFIES = TI - BEN.START
BEN.LOAD.LINES = LINE.COUNT%

FOR BEN.COUNT = 1 TO 100
  GOSUB VIEW.CURSOR.DOWN
NEXT BEN.COUNT

## ---- type at column 0 of lines 101 to 105 ----
VIEW.KEY.CHAR% = 88
BEN.TYPE.JIFFIES = 0
FOR BEN.TYPE.LINE = 1 TO BEN.TYPE.LINES
  BEN.START = TI
  FOR BEN.COUNT = 1 TO BEN.TYPE.KEYS
    GOSUB VIEW.TYPE.CHAR
  NEXT BEN.COUNT
  BEN.TYPE.JIFFIES = BEN.TYPE.JIFFIES + TI - BEN.START
  IF BEN.TYPE.LINE < BEN.TYPE.LINES THEN GOSUB BEN.NEXT.LINE.START
NEXT BEN.TYPE.LINE
BEN.TYPE.LENGTH = PEEK(DOC.EDIT.ADDR)

## ---- RETURN at the end of line 105 ----
GOSUB VIEW.CURSOR.END
BEN.START = TI
FOR BEN.COUNT = 1 TO BEN.RETURNS
  GOSUB VIEW.KEY.RETURN
NEXT BEN.COUNT
BEN.RETURN.JIFFIES = TI - BEN.START
BEN.RETURN.LINES = LINE.COUNT%
GOSUB BEN.REFERENCE.CHECK
BEN.RETURN.MISMATCHES = BEN.MISMATCHES

## ---- delete the lines RETURN made ----
FOR BEN.COUNT = 1 TO BEN.RETURNS - 1
  GOSUB VIEW.CURSOR.UP
NEXT BEN.COUNT
BEN.START = TI
FOR BEN.COUNT = 1 TO BEN.RETURNS
  GOSUB VIEW.DELETE.LINE
NEXT BEN.COUNT
BEN.DELETE.JIFFIES = TI - BEN.START
BEN.DELETE.LINES = LINE.COUNT%
BEN.DELETE.CURSOR = VIEW.CURSOR.LINE%
GOSUB BEN.REFERENCE.CHECK
BEN.DELETE.MISMATCHES = BEN.MISMATCHES

## ---- save ----
BEN.START = TI
DOC.FILE.NAME$ = "EDITBEN.OUT"
GOSUB DOC.SAVEFILE
BEN.SAVE.JIFFIES = TI - BEN.START

## ---- find, from the first line ----
GOSUB VIEW.CURSOR.TOP
DOC.FIND.TERM$ = "ZZNEEDLE"
BEN.START = TI
GOSUB VIEW.FIND.NEXT
BEN.FIND.JIFFIES = TI - BEN.START
GOSUB BEN.REFERENCE.CHECK
BEN.PANE.NAME$ = "EDITBEN.PANE"
GOSUB BEN.PANE.DUMP

OPEN 3, 8, 3, "@:EDITBEN.RES,S,W"
PRINT# 3, "LOAD.JIFFIES"; BEN.LOAD.JIFFIES
PRINT# 3, "LINES"; BEN.LOAD.LINES
PRINT# 3, "LOAD.STATUS"; DOC.LOAD.STATUS%
PRINT# 3, "TYPE.KEYS"; BEN.TYPE.LINES * BEN.TYPE.KEYS
PRINT# 3, "TYPE.JIFFIES"; BEN.TYPE.JIFFIES
PRINT# 3, "TYPE.LENGTH"; BEN.TYPE.LENGTH
PRINT# 3, "RETURN.JIFFIES"; BEN.RETURN.JIFFIES
PRINT# 3, "RETURN.LINES"; BEN.RETURN.LINES
PRINT# 3, "MISMATCHES.RETURN"; BEN.RETURN.MISMATCHES
PRINT# 3, "DELETE.JIFFIES"; BEN.DELETE.JIFFIES
PRINT# 3, "DELETE.LINES"; BEN.DELETE.LINES
PRINT# 3, "DELETE.CURSOR"; BEN.DELETE.CURSOR
PRINT# 3, "MISMATCHES.DELETE"; BEN.DELETE.MISMATCHES
PRINT# 3, "SAVE.JIFFIES"; BEN.SAVE.JIFFIES
PRINT# 3, "SAVE.ERROR"; DOC.SAVE.ERROR%
PRINT# 3, "FIND.JIFFIES"; BEN.FIND.JIFFIES
PRINT# 3, "FIND.FOUND"; DOC.FIND.FOUND%
PRINT# 3, "FIND.LINE"; VIEW.CURSOR.LINE%
PRINT# 3, "FIND.COLUMN"; VIEW.CURSOR.COL%
PRINT# 3, "MISMATCHES.FIND"; BEN.MISMATCHES
PRINT# 3, "FULL"; DOC.FULL%
GOSUB BEN.PANE.REPORT
PRINT# 3, "DONE"
CLOSE 3
END

## Move the cursor to column 0 of the next line.
BEN.NEXT.LINE.START:
  GOSUB VIEW.CURSOR.DOWN
  GOSUB VIEW.CURSOR.HOME
  RETURN

#INCLUDE "TG-BENCH-CHECK.BASL"
#INCLUDE "TG-STORE.BASL"
#INCLUDE "TG-UNDO.BASL"
#INCLUDE "TG-VIEW.BASL"
#INCLUDE "TG-LOW.BASL"
