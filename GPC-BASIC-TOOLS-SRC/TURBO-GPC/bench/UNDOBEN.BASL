#SAVEAS "@:UNDOBEN.SRC.PRG"
#REM 0
#SYMFILE "@:UNDOBEN.SRC.SYM"
#INCLUDE "GPC-BASIC/GPB.INC.BL"
#INCLUDE "GPC-BASIC/MEM.INC.BL"

## ============================================================================
## UNDOBEN -- the check of the undo records, on the 2,000 line document. It times undo and
## redo.
##
## With a ring of 4 records it makes four edits that write seven records: two RETURNs, a
## line delete and a RETURN. The ring then holds the last two edits. It undoes until
## nothing is left to undo. The document goes to UNDOBEN.WRP.
##
## It loads the document again and makes six edits: 40 characters typed into a line, a
## RETURN inside them, three lines deleted, and 5 characters typed into another line. The
## document goes to UNDOBEN.NEW. It undoes all six and the document goes to UNDOBEN.UND.
## It redoes all six and the document goes to UNDOBEN.RED. It undoes all six again. The
## document goes to UNDOBEN.OUT and the pane to UNDOBEN.PANE.
##
## Every undo and redo loop asks for one edit more than there are. The results go to
## UNDOBEN.RES. spike.py checks the five documents and the pane.
##
## WARNING: run it at real speed. Under -warp TI is not tied to the CPU.
## ============================================================================

BEN.WRAP.DEPTH = 4
BEN.WRAP.EDITS = 4
BEN.EDITS = 6

SCREEN 1
GOSUB DOC.SETUP
GOSUB UNDO.SETUP
GOSUB VIEW.SETUP
GOSUB BEN.CONFIG

## ---- the full ring ----
GOSUB BEN.LOAD.FIXTURE
UNDO.RING.DEPTH% = BEN.WRAP.DEPTH
GOSUB UNDO.CLEAR
FOR BEN.COUNT = 1 TO 200
  GOSUB VIEW.CURSOR.DOWN
NEXT BEN.COUNT
GOSUB VIEW.KEY.RETURN
GOSUB VIEW.KEY.RETURN
GOSUB VIEW.DELETE.LINE
GOSUB VIEW.KEY.RETURN
BEN.TRIES = BEN.WRAP.EDITS + 1
GOSUB BEN.UNDO.ALL
BEN.WRAP.UNDONE = BEN.APPLIED
BEN.WRAP.LINES = LINE.COUNT%
DOC.FILE.NAME$ = "UNDOBEN.WRP"
GOSUB DOC.SAVEFILE

## ---- six edits ----
GOSUB VIEW.CURSOR.TOP
GOSUB BEN.LOAD.FIXTURE
UNDO.RING.DEPTH% = 32
GOSUB UNDO.CLEAR
FOR BEN.COUNT = 1 TO 100
  GOSUB VIEW.CURSOR.DOWN
NEXT BEN.COUNT
VIEW.KEY.CHAR% = 88
FOR BEN.COUNT = 1 TO 40
  GOSUB VIEW.TYPE.CHAR
NEXT BEN.COUNT
VIEW.CURSOR.COL% = 20
VIEW.MOVED.FROM% = VIEW.CURSOR.LINE%
GOSUB VIEW.AFTER.MOVE
GOSUB VIEW.KEY.RETURN
FOR BEN.COUNT = 1 TO 10
  GOSUB VIEW.CURSOR.DOWN
NEXT BEN.COUNT
FOR BEN.COUNT = 1 TO 3
  GOSUB VIEW.DELETE.LINE
NEXT BEN.COUNT
VIEW.KEY.CHAR% = 89
FOR BEN.COUNT = 1 TO 5
  GOSUB VIEW.TYPE.CHAR
NEXT BEN.COUNT
BEN.EDITED.LINES = LINE.COUNT%
DOC.FILE.NAME$ = "UNDOBEN.NEW"
GOSUB DOC.SAVEFILE

## ---- undo them ----
BEN.TRIES = BEN.EDITS + 1
BEN.START = TI
GOSUB BEN.UNDO.ALL
BEN.UNDO.JIFFIES = TI - BEN.START
BEN.UNDO.APPLIED = BEN.APPLIED
BEN.UNDO.LINES = LINE.COUNT%
GOSUB BEN.REFERENCE.CHECK
BEN.UNDO.MISMATCHES = BEN.MISMATCHES
DOC.FILE.NAME$ = "UNDOBEN.UND"
GOSUB DOC.SAVEFILE

## ---- redo them ----
BEN.APPLIED = 0
BEN.START = TI
FOR BEN.COUNT = 1 TO BEN.TRIES
  GOSUB VIEW.REDO
  IF UNDO.DONE% <> 0 THEN BEN.APPLIED = BEN.APPLIED + 1
NEXT BEN.COUNT
BEN.REDO.JIFFIES = TI - BEN.START
BEN.REDO.APPLIED = BEN.APPLIED
BEN.REDO.LINES = LINE.COUNT%
GOSUB BEN.REFERENCE.CHECK
BEN.REDO.MISMATCHES = BEN.MISMATCHES
DOC.FILE.NAME$ = "UNDOBEN.RED"
GOSUB DOC.SAVEFILE

## ---- undo them again ----
GOSUB BEN.UNDO.ALL
BEN.AGAIN.APPLIED = BEN.APPLIED
DOC.FILE.NAME$ = "UNDOBEN.OUT"
GOSUB DOC.SAVEFILE
BEN.PANE.NAME$ = "UNDOBEN.PANE"
GOSUB BEN.PANE.DUMP

OPEN 3, 8, 3, "@:UNDOBEN.RES,S,W"
PRINT# 3, "WRAP.UNDONE"; BEN.WRAP.UNDONE
PRINT# 3, "WRAP.LINES"; BEN.WRAP.LINES
PRINT# 3, "EDITED.LINES"; BEN.EDITED.LINES
PRINT# 3, "UNDO.APPLIED"; BEN.UNDO.APPLIED
PRINT# 3, "UNDO.JIFFIES"; BEN.UNDO.JIFFIES
PRINT# 3, "UNDO.LINES"; BEN.UNDO.LINES
PRINT# 3, "MISMATCHES.UNDO"; BEN.UNDO.MISMATCHES
PRINT# 3, "REDO.APPLIED"; BEN.REDO.APPLIED
PRINT# 3, "REDO.JIFFIES"; BEN.REDO.JIFFIES
PRINT# 3, "REDO.LINES"; BEN.REDO.LINES
PRINT# 3, "MISMATCHES.REDO"; BEN.REDO.MISMATCHES
PRINT# 3, "AGAIN.APPLIED"; BEN.AGAIN.APPLIED
PRINT# 3, "FULL"; DOC.FULL%
GOSUB BEN.PANE.REPORT
PRINT# 3, "DONE"
CLOSE 3
END

## Load the fixture and paint it from its first line. The cursor must be on line 0.
BEN.LOAD.FIXTURE:
  DOC.FILE.NAME$ = "FIX2000.TXT"
  GOSUB DOC.LOADFILE
  DOC.LINE% = 0
  GOSUB DOC.EDIT.OPEN
  GOSUB VIEW.PAINT.ALL
  RETURN

## Ask for BEN.TRIES undos. BEN.APPLIED is the number that took an edit back.
BEN.UNDO.ALL:
  BEN.APPLIED = 0
  FOR BEN.COUNT = 1 TO BEN.TRIES
    GOSUB VIEW.UNDO
    IF UNDO.DONE% <> 0 THEN BEN.APPLIED = BEN.APPLIED + 1
  NEXT BEN.COUNT
  RETURN

#INCLUDE "TG-BENCH-CHECK.BASL"
#INCLUDE "TG-STORE.BASL"
#INCLUDE "TG-UNDO.BASL"
#INCLUDE "TG-VIEW.BASL"
#INCLUDE "TG-LOW.BASL"
