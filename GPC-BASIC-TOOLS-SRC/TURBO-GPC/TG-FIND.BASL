## TG-FIND.BASL -- Find, Find Next and Replace for TURBO.BASL: the two boxes, the search and
## its options, the histories in the settings store, and the replace run.
##
## The find box and the replace box are forms. A term's field has its history in a list under
## it, and Down opens the list. Four check boxes set the options, and they hold for Find Next.
##   Match case     the case of each letter must match. DOC.FIND ignores case.
##   Whole word     no letter or digit touches either end of the place.
##   Wrap around    Find goes on from the top after the last line. Replace runs from the first
##                  line, and from the cursor without it.
##   In selection   only places inside the selection the box opened on. It starts ticked when
##                  that selection covers more than one line.
##
## The find box starts with the selected text when the selection is on one line. The settings
## store /SETTINGS.KVB keeps the last TURBO.HISTORY.DEPTH terms of each box, newest first, under
## TG.FIND.1 to TG.FIND.6 and TG.REPLACE.1 to TG.REPLACE.6.
##
## Replace runs over each place the term starts. The place is selected and a key on the status
## bar answers: Y replaces it, N passes it, A replaces it and every place after it, Esc stops.
##
## WARNING: GP.SUB and GP.FN compile only below their GP.DEFPROC. TURBO.BASL includes this file
## below GUI-DIALOGS.

#DEFINE TURBO.FIND.LABEL.WIDTH 13
#DEFINE TURBO.FIND.FORM.WIDTH 55
#DEFINE TURBO.FIND.OPTION.COLUMN 28

## ---- the boxes ----
## TURBO.FIND -- ask for a term and move the cursor to the next place it starts. The term goes
## to the front of the find history. The selection ends when the find runs, and stays when the
## box is left with Esc.
TURBO.FIND:
  GOSUB TURBO.FIND.PREPARE
  ## --
  GP.SUB FORM.BEGIN, GP.FN(TURBO.PETSCII, "Find"), "", "", 4, TURBO.FIND.FORM.WIDTH, GP.FN(TURBO.PETSCII, "&Find"), GP.FN(TURBO.PETSCII, "&Cancel")
  GP.SUB FORM.ITEMS, TURBO.ITEM.BANK%, TURBO.ITEM.ADDR
  GOSUB TURBO.FIND.TERM.FIELD : TURBO.FIND.OPTION.ROW% = 2
  GOSUB TURBO.FIND.OPTIONS : GOSUB TURBO.FIND.RUN
  GP.SUB FORM.END
  ## --
  IF TURBO.FIND.ANSWER% = 0 THEN RETURN
  IF LEN(TURBO.FIND.TYPED$) = 0 THEN RETURN
  DOC.FIND.TERM$ = TURBO.FIND.TYPED$
  GOSUB VIEW.SELECT.DROP : GOSUB TURBO.FIND.AGAIN : GOSUB TURBO.FIND.REMEMBER
  RETURN


## TURBO.FIND.NEXT -- find the last term again. With no term yet it asks for one.
TURBO.FIND.NEXT:
  IF LEN(DOC.FIND.TERM$) = 0 THEN GOTO TURBO.FIND
  GOTO TURBO.FIND.AGAIN


## TURBO.REPLACE -- ask for a term and its replacement, then run over the places the term
## starts. An empty replacement takes the term out. The status bar then shows the count. Both
## terms go to the front of their histories.
TURBO.REPLACE:
  GOSUB TURBO.FIND.PREPARE : GOSUB TURBO.REPLACE.PREPARE
  GP.SUB FORM.BEGIN, GP.FN(TURBO.PETSCII, "Replace"), "", "", 5, TURBO.FIND.FORM.WIDTH, GP.FN(TURBO.PETSCII, "&Replace"), GP.FN(TURBO.PETSCII, "&Cancel")
  GP.SUB FORM.DEFAULT, 2
  GP.SUB FORM.ITEMS, TURBO.ITEM.BANK%, TURBO.ITEM.ADDR
  GOSUB TURBO.FIND.TERM.FIELD
  TURBO.REPLACE.FIELD% = GP.FN(FORM.EDITCOMBO, 1, GP.FN(TURBO.PETSCII, "Replace with:"), TURBO.FIND.LABEL.WIDTH, TURBO.FIELD.LENGTH, TURBO.REPLACE.TERM$)
  TURBO.HISTORY.WALK$ = TURBO.REPLACE.HISTORY$
  GOSUB TURBO.FIND.ITEMS : TURBO.FIND.OPTION.ROW% = 3 : GOSUB TURBO.FIND.OPTIONS : GOSUB TURBO.FIND.RUN
  IF TURBO.FIND.ANSWER% <> 0 THEN TURBO.REPLACE.TERM$ = GP.FN(FORM.TEXT, TURBO.REPLACE.FIELD%)
  GP.SUB FORM.END
  ## ---
  IF TURBO.FIND.ANSWER% = 0 THEN RETURN
  IF LEN(TURBO.FIND.TYPED$) = 0 THEN RETURN
  DOC.FIND.TERM$ = TURBO.FIND.TYPED$ : GOSUB VIEW.SELECT.DROP : GOSUB TURBO.REPLACE.WALK
  GOSUB TURBO.FIND.REMEMBER : GOSUB TURBO.REPLACE.REMEMBER : TURBO.MESSAGE$ = "Not found"
  IF TURBO.REPLACE.ANSWER% <> 0 THEN TURBO.MESSAGE$ = "Replaced " + MID$(STR$(TURBO.REPLACE.COUNT%), 2)
  IF TURBO.REPLACE.SKIPPED% > 0 THEN TURBO.MESSAGE$ = TURBO.MESSAGE$ + ", " + MID$(STR$(TURBO.REPLACE.SKIPPED%), 2) + " too long"
  GOSUB TURBO.MESSAGE.SHOW
  RETURN


## The "Find what:" field on row 0, with the find history.
TURBO.FIND.TERM.FIELD:
  TURBO.FIND.FIELD% = GP.FN(FORM.EDITCOMBO, 0, GP.FN(TURBO.PETSCII, "Find what:"), TURBO.FIND.LABEL.WIDTH, TURBO.FIELD.LENGTH, TURBO.FIND.START$)
  TURBO.HISTORY.WALK$ = TURBO.FIND.HISTORY$


## Add the entries of TURBO.HISTORY.WALK$ to the field just added.
TURBO.FIND.ITEMS:
  TURBO.HISTORY.PLACE% = 0
  GP.DO TURBO.HISTORY.DEPTH
    TURBO.HISTORY.PLACE% = TURBO.HISTORY.PLACE% + 1
    GOSUB TURBO.HISTORY.PICK : IF LEN(TURBO.HISTORY.ENTRY$) = 0 THEN GP.EXITDO
    GP.SUB FORM.ITEM, TURBO.HISTORY.ENTRY$
  GP.LOOP
  RETURN


## The four check boxes, two to a row from row TURBO.FIND.OPTION.ROW%.
TURBO.FIND.OPTIONS:
  TURBO.FIND.CASE.BOX% = GP.FN(FORM.CHECK, TURBO.FIND.OPTION.ROW%, GP.FN(TURBO.PETSCII, "&Match case"), TURBO.FIND.CASE%)
  TURBO.FIND.WORD.BOX% = GP.FN(FORM.CHECK, TURBO.FIND.OPTION.ROW% + 1, GP.FN(TURBO.PETSCII, "&Whole word"), TURBO.FIND.WORD%)
  GP.SUB FORM.COLUMN, TURBO.FIND.OPTION.COLUMN
  TURBO.FIND.WRAP.BOX% = GP.FN(FORM.CHECK, TURBO.FIND.OPTION.ROW%, GP.FN(TURBO.PETSCII, "Wra&p around"), TURBO.FIND.WRAP%)
  TURBO.FIND.INSEL.BOX% = GP.FN(FORM.CHECK, TURBO.FIND.OPTION.ROW% + 1, GP.FN(TURBO.PETSCII, "In &selection"), TURBO.FIND.INSEL%)
  GP.SUB FORM.COLUMN, 0
  RETURN


## Run the box. On the default button read the term and the options. In selection holds only
## when the box opened on a selection.
##
##   out  TURBO.FIND.ANSWER%   0 on Cancel or Esc
##        TURBO.FIND.TYPED$    the term
TURBO.FIND.RUN:
  TURBO.FIND.ANSWER% = GP.FN(FORMTO.RUN)
  IF TURBO.FIND.ANSWER% = 0 THEN RETURN
  TURBO.FIND.TYPED$ = GP.FN(FORM.TEXT, TURBO.FIND.FIELD%)
  TURBO.FIND.CASE%  = GP.FN(FORM.CHECKED, TURBO.FIND.CASE.BOX%)
  TURBO.FIND.WORD%  = GP.FN(FORM.CHECKED, TURBO.FIND.WORD.BOX%)
  TURBO.FIND.WRAP%  = GP.FN(FORM.CHECKED, TURBO.FIND.WRAP.BOX%)
  TURBO.FIND.INSEL% = GP.FN(FORM.CHECKED, TURBO.FIND.INSEL.BOX%)
  IF TURBO.FIND.HAS.RANGE% = 0 THEN TURBO.FIND.INSEL% = 0
  RETURN


## ---- the search ----
## TURBO.FIND.AGAIN -- select the next place from the cursor that the options allow. The
## cursor goes to the end of the place, so the next search starts past it.
TURBO.FIND.AGAIN:
  IF DOC.EDIT.DIRTY% <> 0 THEN GOSUB DOC.EDIT.CLOSE
  DOC.FIND.LINE% = VIEW.CURSOR.LINE% : DOC.FIND.COLUMN% = VIEW.CURSOR.COL%
  IF TURBO.FIND.INSEL% <> 0 THEN GOSUB TURBO.FIND.CLAMP
  GOSUB TURBO.FIND.SEEK
  IF DOC.FIND.FOUND% = 0 AND TURBO.FIND.WRAP% <> 0 THEN GOSUB TURBO.FIND.TOP : GOSUB TURBO.FIND.SEEK
  GP.IF DOC.FIND.FOUND% = 0 THEN
    TURBO.MESSAGE$ = "Not found" : GOSUB TURBO.MESSAGE.SHOW
    RETURN
  GP.ENDIF
  GOSUB VIEW.SELECT.DROP
  VIEW.MOVED.FROM% = VIEW.CURSOR.LINE% : VIEW.CURSOR.LINE% = DOC.FIND.LINE% : VIEW.CURSOR.COL% = DOC.FIND.COLUMN%
  GOSUB VIEW.SELECT.START
  VIEW.CURSOR.COL% = DOC.FIND.COLUMN% + LEN(DOC.FIND.TERM$)
  GOSUB VIEW.ENTER.LINE
  RETURN


## TURBO.FIND.SEEK -- the first place from DOC.FIND.LINE% and DOC.FIND.COLUMN% that the
## options allow, in DOC.FIND.LINE% and DOC.FIND.COLUMN%. DOC.FIND.FOUND% is 0 when there is
## none.
TURBO.FIND.SEEK:
  GP.DO
    GOSUB DOC.FIND
    IF DOC.FIND.FOUND% = 0 THEN RETURN
    GOSUB TURBO.FIND.CHECK
    IF DOC.FIND.FOUND% = 0 THEN RETURN
    IF TURBO.FIND.OK% <> 0 THEN RETURN
    DOC.FIND.COLUMN% = DOC.FIND.COLUMN% + 1
  GP.LOOP


## Test the place DOC.FIND.LINE% and DOC.FIND.COLUMN% against the options. A place past the
## end of the selection sets DOC.FIND.FOUND% to 0. TURBO.FIND.OK% is 0 when the case or a word
## edge rules the place out. The edit buffer is left holding the place's line.
TURBO.FIND.CHECK:
  TURBO.FIND.OK% = -1
  IF TURBO.FIND.INSEL% <> 0 THEN GOSUB TURBO.FIND.INSIDE
  IF DOC.FIND.FOUND% = 0 THEN RETURN
  IF TURBO.FIND.CASE% = 0 AND TURBO.FIND.WORD% = 0 THEN RETURN
  DOC.LINE% = DOC.FIND.LINE%
  GOSUB DOC.EDIT.OPEN
  TURBO.FIND.AT = DOC.EDIT.ADDR + 1 + DOC.FIND.COLUMN%
  IF TURBO.FIND.CASE% <> 0 THEN GOSUB TURBO.FIND.CASE.CHECK
  IF TURBO.FIND.WORD% <> 0 THEN GOSUB TURBO.FIND.WORD.CHECK
  RETURN

TURBO.FIND.INSIDE:
  IF DOC.FIND.LINE% > TURBO.FIND.LAST.LINE% THEN DOC.FIND.FOUND% = 0
  IF DOC.FIND.LINE% = TURBO.FIND.LAST.LINE% AND DOC.FIND.COLUMN% + LEN(DOC.FIND.TERM$) > TURBO.FIND.LAST.COL% THEN DOC.FIND.FOUND% = 0
  RETURN

## The store and the term hold the same codes, so an exact match is a byte compare.
TURBO.FIND.CASE.CHECK:
  TURBO.FIND.TERM.AT = GP.STRPTR(DOC.FIND.TERM$)
  FOR TURBO.FIND.EACH = 1 TO LEN(DOC.FIND.TERM$)
    IF PEEK(TURBO.FIND.AT + TURBO.FIND.EACH - 1) <> PEEK(TURBO.FIND.TERM.AT + TURBO.FIND.EACH) THEN TURBO.FIND.OK% = 0
  NEXT TURBO.FIND.EACH
  RETURN

TURBO.FIND.WORD.CHECK:
  IF DOC.FIND.COLUMN% > 0 THEN TURBO.FIND.CHAR% = PEEK(TURBO.FIND.AT - 1) : GOSUB TURBO.FIND.EDGE
  GP.IF DOC.FIND.COLUMN% + LEN(DOC.FIND.TERM$) < PEEK(DOC.EDIT.ADDR) THEN
    TURBO.FIND.CHAR% = PEEK(TURBO.FIND.AT + LEN(DOC.FIND.TERM$)) : GOSUB TURBO.FIND.EDGE
  GP.ENDIF
  RETURN

## A letter or a digit in TURBO.FIND.CHAR% sets TURBO.FIND.OK% to 0. AND 127 folds both
## letter cases of the store onto 65 to 90.
TURBO.FIND.EDGE:
  TURBO.FIND.CHAR% = TURBO.FIND.CHAR% AND 127
  IF TURBO.FIND.CHAR% >= 48 AND TURBO.FIND.CHAR% <= 57 THEN TURBO.FIND.OK% = 0
  IF TURBO.FIND.CHAR% >= 65 AND TURBO.FIND.CHAR% <= 90 THEN TURBO.FIND.OK% = 0
  RETURN

## Set DOC.FIND.LINE% and DOC.FIND.COLUMN% to the start of the search: the selection's start
## with In selection, the first line without.
TURBO.FIND.TOP:
  DOC.FIND.LINE% = 0 : DOC.FIND.COLUMN% = 0
  IF TURBO.FIND.INSEL% = 0 THEN RETURN
  DOC.FIND.LINE% = TURBO.FIND.FIRST.LINE% : DOC.FIND.COLUMN% = TURBO.FIND.FIRST.COL%
  RETURN

## A start before the selection moves to the selection's start.
TURBO.FIND.CLAMP:
  IF DOC.FIND.LINE% < TURBO.FIND.FIRST.LINE% THEN GOTO TURBO.FIND.TOP
  IF DOC.FIND.LINE% = TURBO.FIND.FIRST.LINE% AND DOC.FIND.COLUMN% < TURBO.FIND.FIRST.COL% THEN GOTO TURBO.FIND.TOP
  RETURN

## ---- the find history ----
## TURBO.FIND.PREPARE -- keep the selection as the search range, and set TURBO.FIND.START$,
## the text the find box starts with. It is the selected text when the selection is on one
## line, cut to TURBO.FIELD.LENGTH characters, and the last term when not. The first call reads
## the find history from the settings store.
##
## A selection on one line is on the cursor line, and the edit buffer holds that line.
TURBO.FIND.PREPARE:
  IF TURBO.FIND.LOADED% = 0 THEN GOSUB TURBO.FIND.LOAD
  GOSUB TURBO.FIND.RANGE : TURBO.FIND.START$ = DOC.FIND.TERM$
  IF VIEW.SELECT.ON% = 0 THEN RETURN
  IF VIEW.SELECT.ANCHOR.LINE% <> VIEW.CURSOR.LINE% THEN RETURN
  IF VIEW.SELECT.LAST.COL% - VIEW.SELECT.FIRST.COL% > TURBO.FIELD.LENGTH THEN VIEW.SELECT.LAST.COL% = VIEW.SELECT.FIRST.COL% + TURBO.FIELD.LENGTH
  TURBO.FIND.START$ = ""
  FOR TURBO.FIND.COLUMN = VIEW.SELECT.FIRST.COL% TO VIEW.SELECT.LAST.COL% - 1
    TURBO.FIND.START$ = TURBO.FIND.START$ + CHR$(PEEK(DOC.EDIT.ADDR + 1 + TURBO.FIND.COLUMN))
  NEXT TURBO.FIND.COLUMN
  RETURN

## Keep the selection in TURBO.FIND.FIRST.LINE% .FIRST.COL% .LAST.LINE% .LAST.COL%. In
## selection starts ticked when it covers more than one line.
TURBO.FIND.RANGE:
  TURBO.FIND.HAS.RANGE% = VIEW.SELECT.ON% : TURBO.FIND.INSEL% = 0
  IF VIEW.SELECT.ON% = 0 THEN RETURN
  GOSUB VIEW.SELECT.ORDER
  TURBO.FIND.FIRST.LINE% = VIEW.SELECT.FIRST.LINE% : TURBO.FIND.FIRST.COL% = VIEW.SELECT.FIRST.COL%
  TURBO.FIND.LAST.LINE% = VIEW.SELECT.LAST.LINE% : TURBO.FIND.LAST.COL% = VIEW.SELECT.LAST.COL%
  IF TURBO.FIND.LAST.LINE% > TURBO.FIND.FIRST.LINE% THEN TURBO.FIND.INSEL% = -1
  RETURN

TURBO.FIND.LOAD:
  TURBO.HISTORY.KEY$ = "TG.FIND." : GOSUB TURBO.HISTORY.LOAD
  TURBO.FIND.HISTORY$ = TURBO.HISTORY.LIST$ : TURBO.FIND.LOADED% = -1
  RETURN

## TURBO.FIND.REMEMBER -- put DOC.FIND.TERM$ at the front of the find history.
TURBO.FIND.REMEMBER:
  TURBO.HISTORY.KEY$ = "TG.FIND."
  TURBO.HISTORY.LIST$ = TURBO.FIND.HISTORY$ : TURBO.HISTORY.TERM$ = DOC.FIND.TERM$
  GOSUB TURBO.HISTORY.ADD : TURBO.FIND.HISTORY$ = TURBO.HISTORY.LIST$
  RETURN

## ---- histories in the settings store ----
## A history is the values of keys 1 to TURBO.HISTORY.DEPTH under one stem in the settings
## store, newest first. Stem "TG.FIND." gives keys TG.FIND.1 to TG.FIND.6. In memory a
## history is TURBO.HISTORY.LIST$: the entries, newest first, each followed by CHR$(13).

## TURBO.HISTORY.LOAD -- read the history of stem TURBO.HISTORY.KEY$ into
## TURBO.HISTORY.LIST$. The read stops at the first key the store does not hold. A store that
## is not on the drive gives "".
TURBO.HISTORY.LOAD:
  TURBO.HISTORY.LIST$ = "" : TURBO.HISTORY.PLACE% = 0
  GP.DO TURBO.HISTORY.DEPTH
    TURBO.HISTORY.PLACE% = TURBO.HISTORY.PLACE% + 1
    KVBIN.KEY$ = TURBO.HISTORY.KEY$ + CHR$(48 + TURBO.HISTORY.PLACE%)
    GOSUB KVBIN.GET : IF LEN(KVBIN.VALUE$) = 0 THEN GP.EXITDO
    TURBO.HISTORY.LIST$ = TURBO.HISTORY.LIST$ + KVBIN.VALUE$ + CHR$(13)
  GP.LOOP
  RETURN

## TURBO.HISTORY.ADD -- put TURBO.HISTORY.TERM$ at the front of TURBO.HISTORY.LIST$, the
## history of stem TURBO.HISTORY.KEY$, and write the entries that changed to the settings
## store. The term leaves its old place. An entry past TURBO.HISTORY.DEPTH is dropped. The
## term must not be empty.
TURBO.HISTORY.ADD:
  TURBO.HISTORY.OLD$  = TURBO.HISTORY.LIST$ : TURBO.HISTORY.LIST$ = TURBO.HISTORY.TERM$ + CHR$(13)
  TURBO.HISTORY.KEPT% = 1 : TURBO.HISTORY.WALK$ = TURBO.HISTORY.OLD$ : TURBO.HISTORY.PLACE% = 0
  GP.DO TURBO.HISTORY.DEPTH
    TURBO.HISTORY.PLACE% = TURBO.HISTORY.PLACE% + 1 : GOSUB TURBO.HISTORY.PICK
    IF LEN(TURBO.HISTORY.ENTRY$) = 0 THEN GP.EXITDO
    IF TURBO.HISTORY.KEPT% = TURBO.HISTORY.DEPTH THEN GP.EXITDO
    IF TURBO.HISTORY.ENTRY$ <> TURBO.HISTORY.TERM$ THEN TURBO.HISTORY.LIST$ = TURBO.HISTORY.LIST$ + TURBO.HISTORY.ENTRY$ + CHR$(13)
    IF TURBO.HISTORY.ENTRY$ <> TURBO.HISTORY.TERM$ THEN TURBO.HISTORY.KEPT% = TURBO.HISTORY.KEPT% + 1
  GP.LOOP
  TURBO.HISTORY.PLACE% = 0
  GP.DO TURBO.HISTORY.KEPT%
    TURBO.HISTORY.PLACE% = TURBO.HISTORY.PLACE% + 1 : TURBO.HISTORY.WALK$ = TURBO.HISTORY.OLD$
    GOSUB TURBO.HISTORY.PICK
    TURBO.HISTORY.WAS$ = TURBO.HISTORY.ENTRY$ : TURBO.HISTORY.WALK$ = TURBO.HISTORY.LIST$
    GOSUB TURBO.HISTORY.PICK
    IF TURBO.HISTORY.ENTRY$ <> TURBO.HISTORY.WAS$ THEN GOSUB TURBO.HISTORY.WRITE
  GP.LOOP
  RETURN

## Set TURBO.HISTORY.ENTRY$ to entry TURBO.HISTORY.PLACE% of TURBO.HISTORY.WALK$, counted from
## 1. It is "" when the history holds fewer entries.
##
## WARNING: GP.DO 0 loops forever. TURBO.HISTORY.PLACE% must be 1 or more.
TURBO.HISTORY.PICK:
  TURBO.HISTORY.ENTRY$ = "" : TURBO.HISTORY.FROM% = 1
  GP.DO TURBO.HISTORY.PLACE%
    IF TURBO.HISTORY.FROM% > LEN(TURBO.HISTORY.WALK$) THEN TURBO.HISTORY.ENTRY$ = ""
    IF TURBO.HISTORY.FROM% > LEN(TURBO.HISTORY.WALK$) THEN GP.EXITDO
    TURBO.HISTORY.CUT% = GP.INSTR(TURBO.HISTORY.WALK$, CHR$(13), TURBO.HISTORY.FROM%)
    TURBO.HISTORY.ENTRY$ = MID$(TURBO.HISTORY.WALK$, TURBO.HISTORY.FROM%, TURBO.HISTORY.CUT% - TURBO.HISTORY.FROM%)
    TURBO.HISTORY.FROM% = TURBO.HISTORY.CUT% + 1
  GP.LOOP
  RETURN

TURBO.HISTORY.WRITE:
  KVBIN.KEY$ = TURBO.HISTORY.KEY$ + CHR$(48 + TURBO.HISTORY.PLACE%)
  KVBIN.VALUE$ = TURBO.HISTORY.ENTRY$

## TURBO.SETTING.PUT -- write KVBIN.KEY$ and KVBIN.VALUE$ to the settings store. A full store
## grows.
TURBO.SETTING.PUT:
  IF TURBO.SETTINGS.CHECKED% = 0 THEN GOSUB TURBO.SETTINGS.CHECK
  GOSUB KVBIN.PUT    : IF KVBIN.WHY% <> KVBIN.WHY.FULL THEN RETURN
  GOSUB KVBIN.EXPAND : IF KVBIN.OK% <> 0 THEN GOSUB KVBIN.PUT
  RETURN

## Make the settings store when it is not on the drive, or is an empty file. Once a run.
##
## WARNING: KVBIN.PUT opens the store to read and write. On a store not on the drive that open
## makes an empty file, and KVBIN takes an empty file for one that is not a store.
TURBO.SETTINGS.CHECK:
  TURBO.SETTINGS.CHECKED% = -1 : GOSUB KVBIN.INFO
  IF KVBIN.WHY% = KVBIN.WHY.NOFILE   THEN IF KVBIN.DOSERR% = TURBO.DOS.NOT.FOUND THEN GOSUB KVBIN.CREATE
  IF KVBIN.WHY% = KVBIN.WHY.NOTSTORE THEN IF KVBIN.HEADER$ = "" THEN GOSUB KVBIN.CREATE
  RETURN

## ---- replace ----
## TURBO.REPLACE.PREPARE -- read the replace history from the settings store. Only the first
## call reads it.
TURBO.REPLACE.PREPARE:
  IF TURBO.REPLACE.LOADED% <> 0 THEN RETURN
  TURBO.HISTORY.KEY$ = "TG.REPLACE."
  GOSUB TURBO.HISTORY.LOAD : TURBO.REPLACE.HISTORY$ = TURBO.HISTORY.LIST$ : TURBO.REPLACE.LOADED% = -1
  RETURN

## TURBO.REPLACE.REMEMBER -- put TURBO.REPLACE.TERM$ at the front of the replace history. An
## empty replacement is not kept.
TURBO.REPLACE.REMEMBER:
  IF LEN(TURBO.REPLACE.TERM$) = 0 THEN RETURN
  TURBO.HISTORY.KEY$ = "TG.REPLACE."
  TURBO.HISTORY.LIST$ = TURBO.REPLACE.HISTORY$ : TURBO.HISTORY.TERM$ = TURBO.REPLACE.TERM$
  GOSUB TURBO.HISTORY.ADD : TURBO.REPLACE.HISTORY$ = TURBO.HISTORY.LIST$
  RETURN

## TURBO.REPLACE.WALK -- replace DOC.FIND.TERM$ with TURBO.REPLACE.TERM$ at each place the
## options allow, to the last line. The run starts at the first line with Wrap around, at the
## selection's start with In selection, and at the cursor with neither. Each place is asked
## about. An A answer stands for every place after it. A replacement that would make its line
## longer than 250 characters is passed over. The run is one edit for undo. A run that changes
## more lines than the undo ring keeps empties the rings. The cursor ends after the term at the
## last place asked about.
##
##   out  TURBO.REPLACE.COUNT%    the places replaced
##        TURBO.REPLACE.SKIPPED%  the places passed over for length
##        TURBO.REPLACE.ANSWER%   0 when the term is nowhere
TURBO.REPLACE.WALK:
  IF DOC.EDIT.DIRTY% <> 0 THEN GOSUB DOC.EDIT.CLOSE
  TURBO.REPLACE.COUNT% = 0 : TURBO.REPLACE.ANSWER% = 0
  TURBO.REPLACE.SKIPPED% = 0
  TURBO.REPLACE.NOTED% = 0 : TURBO.REPLACE.NOTED.LINE% = -1
  DOC.FIND.LINE% = VIEW.CURSOR.LINE% : DOC.FIND.COLUMN% = VIEW.CURSOR.COL%
  IF TURBO.FIND.WRAP% <> 0 OR TURBO.FIND.INSEL% <> 0 THEN GOSUB TURBO.FIND.TOP
  GP.DO
    GOSUB TURBO.FIND.SEEK
    IF DOC.FIND.FOUND% = 0 THEN GP.EXITDO
    IF TURBO.REPLACE.ANSWER% <> TURBO.ANSWER.ALL THEN GOSUB TURBO.REPLACE.ASK
    IF TURBO.REPLACE.ANSWER% = TURBO.ANSWER.STOP THEN GP.EXITDO
    IF TURBO.REPLACE.ANSWER% = TURBO.ANSWER.NO THEN DOC.FIND.COLUMN% = DOC.FIND.COLUMN% + LEN(DOC.FIND.TERM$)
    IF TURBO.REPLACE.ANSWER% <> TURBO.ANSWER.NO THEN GOSUB TURBO.REPLACE.ONE
  GP.LOOP
  IF TURBO.REPLACE.NOTED% > UNDO.RING.DEPTH% THEN GOSUB UNDO.CLEAR
  IF TURBO.REPLACE.ANSWER% = 0 THEN RETURN
  VIEW.SELECT.ON% = 0
  DOC.LINE% = VIEW.CURSOR.LINE% : GOSUB DOC.EDIT.OPEN
  IF VIEW.CURSOR.COL% > PEEK(DOC.EDIT.ADDR) THEN VIEW.CURSOR.COL% = PEEK(DOC.EDIT.ADDR)
  VIEW.CHANGE.LINE% = 0 : GOSUB VIEW.AFTER.CHANGE
  RETURN

## Select the place DOC.FIND.LINE% and DOC.FIND.COLUMN%, with the cursor at its end, bring it
## into the pane, and wait for the answer. RETURN and Space answer Y. Stop answers Esc.
##
##   out  TURBO.REPLACE.ANSWER%   TURBO.ANSWER.YES, NO, ALL or STOP
TURBO.REPLACE.ASK:
  VIEW.SELECT.ANCHOR.LINE% = DOC.FIND.LINE% : VIEW.SELECT.ANCHOR.COL% = DOC.FIND.COLUMN%
  VIEW.SELECT.ON% = -1 : VIEW.CURSOR.LINE% = DOC.FIND.LINE%
  VIEW.CURSOR.COL% = DOC.FIND.COLUMN% + LEN(DOC.FIND.TERM$) : DOC.LINE% = VIEW.CURSOR.LINE%
  GOSUB DOC.EDIT.OPEN : VIEW.CHANGE.LINE% = 0 : GOSUB VIEW.AFTER.CHANGE
  TURBO.MESSAGE$ = "Replace?  Yes  No  All  Esc"
  GOSUB TURBO.MESSAGE.SHOW
  GP.PRINTAT TURBO.MESSAGE.COLUMN + 10, VIEW.STATUS.ROW%, MID$(TURBO.PETSCII.TEXT$, 11, 1), (TURBO.ATTR.BAR% AND 240) + TURBO.HOT.COLOUR%
  GP.PRINTAT TURBO.MESSAGE.COLUMN + 15, VIEW.STATUS.ROW%, MID$(TURBO.PETSCII.TEXT$, 16, 1), (TURBO.ATTR.BAR% AND 240) + TURBO.HOT.COLOUR%
  GP.PRINTAT TURBO.MESSAGE.COLUMN + 19, VIEW.STATUS.ROW%, MID$(TURBO.PETSCII.TEXT$, 20, 1), (TURBO.ATTR.BAR% AND 240) + TURBO.HOT.COLOUR%
  GP.PRINTAT TURBO.MESSAGE.COLUMN + 24, VIEW.STATUS.ROW%, MID$(TURBO.PETSCII.TEXT$, 25, 3), (TURBO.ATTR.BAR% AND 240) + TURBO.HOT.COLOUR%
  GP.DO
    GET TURBO.KEY$
    TURBO.REPLACE.ANSWER% = 0
    IF LEN(TURBO.KEY$) > 0 THEN TURBO.REPLACE.ANSWER% = ASC(TURBO.KEY$) AND 127
    IF TURBO.REPLACE.ANSWER% = 13 OR TURBO.REPLACE.ANSWER% = 32 THEN TURBO.REPLACE.ANSWER% = TURBO.ANSWER.YES
    IF TURBO.REPLACE.ANSWER% = 3 THEN TURBO.REPLACE.ANSWER% = TURBO.ANSWER.STOP
    IF TURBO.REPLACE.ANSWER% = TURBO.ANSWER.YES OR TURBO.REPLACE.ANSWER% = TURBO.ANSWER.NO THEN GP.EXITDO
    IF TURBO.REPLACE.ANSWER% = TURBO.ANSWER.ALL OR TURBO.REPLACE.ANSWER% = TURBO.ANSWER.STOP THEN GP.EXITDO
  GP.LOOP
  RETURN

## Replace the term at DOC.FIND.LINE% and DOC.FIND.COLUMN%, and move DOC.FIND.COLUMN% past the
## replacement. A line the replacement would make longer than 250 characters stays as it is,
## and the column moves past the term. A change on the selection's last line moves its end.
##
## WARNING: GP.DO 0 loops forever. The term is never empty.
TURBO.REPLACE.ONE:
  DOC.LINE% = DOC.FIND.LINE% : GOSUB DOC.EDIT.OPEN
  DOC.EDIT.COLUMN% = DOC.FIND.COLUMN% : DOC.FIND.COLUMN% = DOC.FIND.COLUMN% + LEN(DOC.FIND.TERM$)
  IF PEEK(DOC.EDIT.ADDR) - LEN(DOC.FIND.TERM$) + LEN(TURBO.REPLACE.TERM$) > 250 THEN GOTO TURBO.REPLACE.SKIP
  IF TURBO.REPLACE.COUNT% = 0 THEN GOSUB UNDO.GROUP.BEGIN
  IF DOC.FIND.LINE% <> TURBO.REPLACE.NOTED.LINE% THEN GOSUB TURBO.REPLACE.NOTE
  GP.DO LEN(DOC.FIND.TERM$)
    GOSUB DOC.EDIT.REMOVE
  GP.LOOP
  DOC.FIND.COLUMN% = DOC.EDIT.COLUMN%
  IF LEN(TURBO.REPLACE.TERM$) > 0 THEN GOSUB TURBO.REPLACE.INSERT
  DOC.EDIT.DIRTY% = -1
  GOSUB DOC.EDIT.CLOSE
  TURBO.REPLACE.COUNT% = TURBO.REPLACE.COUNT% + 1
  IF DOC.FIND.LINE% = TURBO.FIND.LAST.LINE% THEN TURBO.FIND.LAST.COL% = TURBO.FIND.LAST.COL% + LEN(TURBO.REPLACE.TERM$) - LEN(DOC.FIND.TERM$)
  RETURN
TURBO.REPLACE.SKIP:
  TURBO.REPLACE.SKIPPED% = TURBO.REPLACE.SKIPPED% + 1
  RETURN

## Put TURBO.REPLACE.TERM$ into the edit buffer at column DOC.FIND.COLUMN%, and move
## DOC.FIND.COLUMN% past it. DOC.EDIT.COLUMN% starts at DOC.FIND.COLUMN%.
TURBO.REPLACE.INSERT:
  GP.DO LEN(TURBO.REPLACE.TERM$)
    DOC.EDIT.CHAR% = PEEK(GP.STRPTR(TURBO.REPLACE.TERM$) + 1 + DOC.EDIT.COLUMN% - DOC.FIND.COLUMN%)
    GOSUB DOC.EDIT.INSERT
    DOC.EDIT.COLUMN% = DOC.EDIT.COLUMN% + 1
  GP.LOOP
  DOC.FIND.COLUMN% = DOC.EDIT.COLUMN%
  RETURN

## Note line DOC.FIND.LINE% in the undo ring before its first change. Past UNDO.RING.DEPTH%
## lines nothing more is noted, and TURBO.REPLACE.WALK empties the rings.
TURBO.REPLACE.NOTE:
  TURBO.REPLACE.NOTED.LINE% = DOC.FIND.LINE%
  TURBO.REPLACE.NOTED% = TURBO.REPLACE.NOTED% + 1
  IF TURBO.REPLACE.NOTED% > UNDO.RING.DEPTH% THEN RETURN
  UNDO.LINE% = DOC.FIND.LINE%
  GOSUB UNDO.NOTE.REPLACE
  RETURN
