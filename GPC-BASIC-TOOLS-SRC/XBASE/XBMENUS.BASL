## ============================================================================
## XBMENUS.BASL -- the bar, the dropdowns and the dispatch.
## #INCLUDEd inline by XBASE.BASL, like ED-MENUS.BASL: one global symbol table.
##
## SKELETON. Nothing here has run.
##
## THE SHAPE IS CLIPPER'S DBU, not dBASE III's ASSIST. Seven titles, each
## dropping one to eight rows. ASSIST's dropdowns build a command line at the
## bottom of the screen and that is a lot of machinery to arrive at a verb the
## bar already named.
##
##      File   Modify   Browse   Utility   Move   Help   Test
##
## FILE CARRIES ALL SIX FILE VERBS, in two groups of three: open, create and
## close a database, then the same three for an index. DBU spreads them over
## File, Create and Set; one menu holding the pairs is shorter to read and it
## is where a user looks for them.
##
## TEST IS NOT DBU'S. XBase is the first real application the CUA library runs
## inside, so a seventh title opens the dialogs the record keeper never reaches
## and cycles the palette over them. It is a development column, which is why
## it sits after Help rather than in DBU's order.
##
## DBU MAKES EVERY TITLE A FUNCTION KEY AS WELL, and that part is not copied.
## ESC opens the bar and the arrows walk it, the way EDITOR.BASL does it. The
## hot letter in each dropdown row stays, and MENUVERT.HOT$ already draws it.
##
## EVERY ITEM CARRIES AN ENABLE RULE, which is the part of DBU worth copying.
## Its source keeps a parallel boolean array per menu -- open_b[2] reads
## "sysfunc = 0 .AND. .NOT. box_open .AND. .NOT. EMPTY(cur_dbf)" -- so File
## Index is unreachable until a database is open. Here the rule is a number
## and XB.ITEMOK reads it.
##
## A DISABLED ITEM IS STILL DRAWN AND STILL SELECTABLE, and says why when it is
## chosen. MENUVERT has no notion of a dead row, and giving it one is a library
## change, not a change here.
##
## A SEPARATOR IS A ROW WHOSE TEXT IS ONE HYPHEN, and that one MENUVERT does
## know: it draws the row as a line, the highlight steps over it and no hotkey
## can reach it. It still counts as a row, so it needs an entry in the hotkey
## string and a slot in the dispatch, both of which are placeholders.
##
## The menu text is in low memory. ED-MENUS.BASL moves its own into a bank and
## measures the win at 249 bytes; that is worth doing here only if low memory
## runs short, and the win scales with the LENGTH of the text, not the count.
## These items are four to eight characters.
## ============================================================================

## The bar. Seven titles, and the deepest dropdown is File's eight rows, so
## XB.MAXI is now the longer of the two and one DIM off it sizes both sides of
## MENUVERT.ITEM$.
#DEFINE XB.MENUS 7
#DEFINE XB.LASTM 6
#DEFINE XB.MAXI 8
#DEFINE XB.LASTI 7

## Enable rules. XB.ITEMOK turns one of these into true or false.
#DEFINE XB.ALWAYS 0
#DEFINE XB.HASDB 1
#DEFINE XB.HASBOTH 2
#DEFINE XB.NOTYET 3

## Screen furniture. The bar is row 0, row 1 carries the top border of an open
## panel, and the dropdown items hang from row 2.
#DEFINE XB.BARROW 0
#DEFINE XB.DROPROW 2


## ---------------------------------------------------------------- the text
## THE MENU TEXT LIVES IN A BANK, not in the program. A string constant costs
## 2 + LEN bytes of resident p-code wherever it is written and GP.BSTR costs 5,
## so every name here pays its way from four characters up.
##
## ONE GROUP A MENU, so a row added to one moves nothing in another, and the
## count comes from GP.BSTRCOUNT rather than a number written beside it: the
## two cannot drift apart. The bar's own two lists are flat, one entry a menu.

GP.BANKEDSTR XB.TEXTBANK BS.TITLES
  "FILE"
  "MODIFY"
  "BROWSE"
  "UTILITY"
  "MOVE"
  "HELP"
  "TEST"
GP.ENDBANKEDSTR

GP.BANKEDSTR XB.TEXTBANK BS.HOTS
  "OCLIND X"
  "S"
  "TR"
  "CARPZ"
  "EGLS"
  "AM"
  "MCILBT"
GP.ENDBANKEDSTR

## FILE'S HOTKEYS, which are the FIRST entry in BS.HOTS above: the database
## trio take a letter from their own verb, O C L, the index trio take one from
## the word INDEX, I N D, and Exit takes X because every menu bar ever written
## has put X on Exit. The seventh character is a space, the separator's
## placeholder -- MENUVERT never matches it, but the string has to stay one
## character a row or every letter after it lands on the wrong item.
GP.BANKEDSTR XB.TEXTBANK BS.I.FILE
  "OPEN DATABASE"
  "CREATE DATABASE"
  "CLOSE DATABASE"
  "OPEN INDEX"
  "CREATE INDEX"
  "CLOSE INDEX"
  "-"
  "EXIT"
GP.ENDBANKEDSTR

GP.BANKEDSTR XB.TEXTBANK BS.I.MODIFY
  "STRUCT"
GP.ENDBANKEDSTR

GP.BANKEDSTR XB.TEXTBANK BS.I.BROWSE
  "TABLE"
  "RECORD"
GP.ENDBANKEDSTR

GP.BANKEDSTR XB.TEXTBANK BS.I.UTIL
  "COPY"
  "APPEND"
  "REPLACE"
  "PACK"
  "ZAP"
GP.ENDBANKEDSTR

GP.BANKEDSTR XB.TEXTBANK BS.I.MOVE
  "SEEK"
  "GOTO"
  "LOCATE"
  "SKIP"
GP.ENDBANKEDSTR

GP.BANKEDSTR XB.TEXTBANK BS.I.HELP
  "ABOUT"
  "MEMORY"
GP.ENDBANKEDSTR

GP.BANKEDSTR XB.TEXTBANK BS.I.TEST
  "MESSAGE"
  "CONFIRM"
  "INPUT"
  "LISTBOX"
  "COMBO"
  "THEME"
GP.ENDBANKEDSTR


XB.MENU.SETUP:
    DIM XB.MNAME$(XB.LASTM)
    DIM XB.MITEMS(XB.LASTM)
    DIM XB.MWIDTH(XB.LASTM)
    DIM XB.MHOT$(XB.LASTM)
    DIM XB.ITEM$(XB.LASTM, XB.LASTI)
    DIM XB.RULE(XB.LASTM, XB.LASTI)

    ## The one menu array that cannot move -- MENUVERT reads it directly. It
    ## carries the bar as well as the dropdowns, so it is sized for whichever is
    ## longer, and today that is File: eight rows, held from index 1.
    ## GUI.LISTBOX borrows the same array, and Test Listbox fills six rows of it.
    DIM MENUVERT.ITEM$(XB.MAXI)

    ## The bar, in one pass over both flat groups.
    FOR XB.I = 0 TO XB.LASTM
        XB.MNAME$(XB.I) = GP.BSTR(BS.TITLES, XB.I)
        XB.MHOT$(XB.I) = GP.BSTR(BS.HOTS, XB.I)
    NEXT XB.I

    ## Then a dropdown at a time. The rules stay written out: they are the one
    ## part of the table that is not text and they read as a column.

    XB.MITEMS(0) = GP.BSTRCOUNT(BS.I.FILE)
    FOR XB.J = 0 TO XB.MITEMS(0) - 1
        XB.ITEM$(0, XB.J) = GP.BSTR(BS.I.FILE, XB.J)
    NEXT XB.J
    XB.RULE(0, 0) = XB.ALWAYS
    XB.RULE(0, 1) = XB.ALWAYS
    XB.RULE(0, 2) = XB.HASDB
    XB.RULE(0, 3) = XB.NOTYET
    XB.RULE(0, 4) = XB.NOTYET
    XB.RULE(0, 5) = XB.NOTYET
    XB.RULE(0, 6) = XB.ALWAYS
    XB.RULE(0, 7) = XB.ALWAYS

    XB.MITEMS(1) = GP.BSTRCOUNT(BS.I.MODIFY)
    FOR XB.J = 0 TO XB.MITEMS(1) - 1
        XB.ITEM$(1, XB.J) = GP.BSTR(BS.I.MODIFY, XB.J)
    NEXT XB.J
    XB.RULE(1, 0) = XB.HASDB

    XB.MITEMS(2) = GP.BSTRCOUNT(BS.I.BROWSE)
    FOR XB.J = 0 TO XB.MITEMS(2) - 1
        XB.ITEM$(2, XB.J) = GP.BSTR(BS.I.BROWSE, XB.J)
    NEXT XB.J
    XB.RULE(2, 0) = XB.HASDB
    XB.RULE(2, 1) = XB.HASDB

    XB.MITEMS(3) = GP.BSTRCOUNT(BS.I.UTIL)
    FOR XB.J = 0 TO XB.MITEMS(3) - 1
        XB.ITEM$(3, XB.J) = GP.BSTR(BS.I.UTIL, XB.J)
    NEXT XB.J
    XB.RULE(3, 0) = XB.HASDB
    XB.RULE(3, 1) = XB.HASDB
    XB.RULE(3, 2) = XB.HASDB
    XB.RULE(3, 3) = XB.HASDB
    XB.RULE(3, 4) = XB.HASDB

    XB.MITEMS(4) = GP.BSTRCOUNT(BS.I.MOVE)
    FOR XB.J = 0 TO XB.MITEMS(4) - 1
        XB.ITEM$(4, XB.J) = GP.BSTR(BS.I.MOVE, XB.J)
    NEXT XB.J
    XB.RULE(4, 0) = XB.NOTYET
    XB.RULE(4, 1) = XB.HASDB
    XB.RULE(4, 2) = XB.HASDB
    XB.RULE(4, 3) = XB.HASDB

    XB.MITEMS(5) = GP.BSTRCOUNT(BS.I.HELP)
    FOR XB.J = 0 TO XB.MITEMS(5) - 1
        XB.ITEM$(5, XB.J) = GP.BSTR(BS.I.HELP, XB.J)
    NEXT XB.J
    XB.RULE(5, 0) = XB.ALWAYS
    XB.RULE(5, 1) = XB.ALWAYS

    XB.MITEMS(6) = GP.BSTRCOUNT(BS.I.TEST)
    FOR XB.J = 0 TO XB.MITEMS(6) - 1
        XB.ITEM$(6, XB.J) = GP.BSTR(BS.I.TEST, XB.J)
    NEXT XB.J
    XB.RULE(6, 0) = XB.ALWAYS
    XB.RULE(6, 1) = XB.ALWAYS
    XB.RULE(6, 2) = XB.ALWAYS
    XB.RULE(6, 3) = XB.ALWAYS
    XB.RULE(6, 4) = XB.ALWAYS
    XB.RULE(6, 5) = XB.ALWAYS

    ## Dropdown widths, measured once and kept as numbers.
    FOR XB.I = 0 TO XB.LASTM
        XB.W = LEN(XB.MNAME$(XB.I))
        FOR XB.J = 0 TO XB.MITEMS(XB.I) - 1
            IF LEN(XB.ITEM$(XB.I, XB.J)) > XB.W THEN XB.W = LEN(XB.ITEM$(XB.I, XB.J))
        NEXT XB.J
        XB.MWIDTH(XB.I) = XB.W + 2
    NEXT XB.I

    XB.ACTIVE = 0 - 1
    RETURN

## ------------------------------------------------------------ enable rules
## DBU's parallel boolean arrays, as a number. XB.RULE(m, i) picks one.
##
##   in   XB.RULEID
##   out  XB.ENABLED, and XB.WHY$ when it is false

XB.ITEMOK:
    XB.ENABLED = -1
    XB.WHY$ = ""
    IF XB.RULEID = XB.HASDB THEN GOSUB XB.RULE.HASDB
    IF XB.RULEID = XB.HASBOTH THEN GOSUB XB.RULE.HASBOTH
    IF XB.RULEID = XB.NOTYET THEN GOSUB XB.RULE.NOTYET
    RETURN

XB.RULE.HASDB:
    IF DB.ISOPEN(DB.A) THEN RETURN
    XB.ENABLED = 0
    XB.WHY$ = "NO DATABASE OPEN IN THIS AREA"
    RETURN

XB.RULE.HASBOTH:
    IF DB.ISOPEN(0) THEN IF DB.ISOPEN(1) THEN RETURN
    XB.ENABLED = 0
    XB.WHY$ = "BOTH AREAS MUST HAVE A DATABASE OPEN"
    RETURN

XB.RULE.NOTYET:
    XB.ENABLED = 0
    XB.WHY$ = "NOT IN THIS VERSION -- IT NEEDS THE INDEX"
    RETURN


## ---------------------------------------------------------- the bar itself
## MENUBAR and MENUVERT share MENUVERT.ITEM$, so each drawer loads its own
## first. An item is " NAME " and the spaces are the layout: MENUBAR makes
## every item exactly as wide as its text.
XB.MENU.BAR.ITEMS:
    FOR XB.I = 0 TO XB.LASTM
        MENUVERT.ITEM$(XB.I + 1) = " " + XB.MNAME$(XB.I) + " "
    NEXT XB.I
    MENUVERT.COUNT = XB.MENUS
    MENUVERT.X = 0
    MENUVERT.Y = XB.BARROW
    MENUVERT.ATTR = THEME.CLR(THEME.TEXT)
    MENUVERT.HIATTR = THEME.CLR(THEME.HILITE)
    MENUVERT.HOT$ = ""
    MENUVERT.HOTATTR = 0
    MENUBAR.X = 0
    MENUBAR.Y = XB.BARROW
    MENUBAR.GAP = 0
    RETURN

## The whole bar, unhighlighted.
##
## THE BAR IS THE PAGE'S OWN COLOURS AND THE SELECTED TITLE IS THE REVERSED
## PAIR, which is GPBMODS.BASL's GMX.BAR.LOAD and every bar menu ever written.
## The row is filled with the item colour rather than left alone so the columns
## past the last title are clean; GPBMODS does not fill because its shell has
## already painted that row.
XB.RENDER.MENUBAR:
    GP.FILL 0, XB.BARROW, APPSYS.COLS, 1, 32, THEME.CLR(THEME.TEXT)
    GOSUB XB.MENU.BAR.ITEMS
    GOSUB MENUBAR.DRAW
    IF XB.ACTIVE >= 0 THEN MENUBAR.SEL = XB.ACTIVE + 1
    IF XB.ACTIVE >= 0 THEN GOSUB MENUBAR.MARK
    RETURN


## ------------------------------------------------------------- the panel
## XB.MENU.BAR.ITEMS first: MENUBAR.WHERE measures MENUVERT.ITEM$ and leaves
## the title's column in MENUBAR.SELX, and this routine is about to overwrite
## that same array.
XB.DRAW.DROPDOWN:
    GOSUB XB.MENU.BAR.ITEMS
    MENUBAR.SEL = XB.ACTIVE + 1
    GOSUB MENUBAR.WHERE
    XB.DD.X = MENUBAR.SELX + 1
    XB.DD.W = XB.MWIDTH(XB.ACTIVE)
    XB.DD.N = XB.MITEMS(XB.ACTIVE)
    IF XB.DD.X + XB.DD.W > APPSYS.COLS THEN XB.DD.X = APPSYS.COLS - XB.DD.W

    ## THE CELLS FIRST, THEN THE PANEL OVER THEM. XB.ERASE.DROPDOWN puts them
    ## back, and that put-back is the whole of the repaint: walking the bar no
    ## longer leaves a hole in whatever the last panel stood on.
    XB.DD.BX = XB.DD.X - 1
    XB.DD.BY = XB.DROPROW - 1
    XB.DD.BW = XB.DD.W + 2
    XB.DD.BH = XB.DD.N + 2

    ## THE SHADOW IS WORKED OUT BEFORE THE SAVE, because it is drawn outside
    ## the panel: a save of the panel alone would put the panel back and leave
    ## the shadow standing as a dark L where a menu used to be. GP.FILL clips
    ## nothing, so the two arms are trimmed to the screen rather than the panel
    ## being moved to make room for them. Two columns and one row, the same
    ## offsets GUI.SHADOW.DRAW uses, so a dropdown and a dialog cast the same
    ## shadow.
    XB.DD.SW = APPSYS.COLS - XB.DD.BX - XB.DD.BW
    IF XB.DD.SW > 2 THEN XB.DD.SW = 2
    IF XB.DD.SW < 0 THEN XB.DD.SW = 0
    XB.DD.SH = 1
    IF XB.DD.BY + XB.DD.BH >= APPSYS.ROWS THEN XB.DD.SH = 0

    SV.X = XB.DD.BX
    SV.Y = XB.DD.BY
    SV.W = XB.DD.BW + XB.DD.SW
    SV.H = XB.DD.BH + XB.DD.SH
    GOSUB SV.SAVE
    IF SV.HND = 0 THEN GOSUB XB.PANEL.TIGHTEN
    XB.DD.HND = SV.HND

    ## Attribute 0 is black on black. The fill is solid, not a recolour, so the
    ## shadow rubs out what it covers -- acceptable only because the put-back
    ## above restores it.
    IF XB.DD.SW > 0 THEN GP.FILL XB.DD.BX + XB.DD.BW, XB.DD.BY + 1, XB.DD.SW, XB.DD.BH - 1, 32, 0
    IF XB.DD.SH > 0 THEN GP.FILL XB.DD.BX + 2, XB.DD.BY + XB.DD.BH, XB.DD.BW + XB.DD.SW - 2, 1, 32, 0

    GP.BOX XB.DD.BX, XB.DD.BY, XB.DD.BW, XB.DD.BH, 1, THEME.CLR(THEME.BORDER)
    MENUVERT.X = XB.DD.X
    MENUVERT.Y = XB.DROPROW
    MENUVERT.WIDTH = XB.DD.W
    MENUVERT.COUNT = XB.DD.N
    ## The selected row is the reversed pair, the same one the bar's open title
    ## wears, because a dropdown and the bar it hangs off are one menu.
    MENUVERT.ATTR = THEME.CLR(THEME.TEXT)
    MENUVERT.HIATTR = THEME.CLR(THEME.HILITE)

    ## The separator is the frame's colour, not the text's. It runs the full
    ## width of the dropdown in the same stroke GP.BOX just drew the border
    ## with, so in any other attribute it reads as a row of its own.
    MENUVERT.SEPATTR = THEME.CLR(THEME.BORDER)

    ## BEFORE the rows are drawn: MENUVERT.ROW tints from MENUVERT.HOT$ as it
    ## prints each one.
    MENUVERT.HOT$ = XB.MHOT$(XB.ACTIVE)
    MENUVERT.HOTATTR = THEME.CLR(THEME.BORDER)

    ## MENUVERT.ITEM$ is 1 based, XB.SEL is 0 based off the table. Converted
    ## here and nowhere else.
    ## A SEPARATOR GOES IN WITHOUT THE LEADING SPACE. MENUVERT tests for the
    ## hyphen alone, so " -" would be an ordinary row whose text is a hyphen.
    FOR XB.I = 0 TO XB.DD.N - 1
        MENUVERT.ITEM$(XB.I + 1) = " " + XB.ITEM$(XB.ACTIVE, XB.I)
        IF XB.ITEM$(XB.ACTIVE, XB.I) = "-" THEN MENUVERT.ITEM$(XB.I + 1) = "-"
    NEXT XB.I

    ## THE ROWS ARE NOT DRAWN HERE. MENUVERT.RUN draws every row and then the
    ## highlighted one as its first act, so drawing them here painted the whole
    ## panel a second time on every open. The frame, the shadow and the item
    ## text are set up above; the rows land when the key loop starts.
    RETURN

## Take the panel away, by putting back the cells it covered. It works from the
## XB.DD.* geometry the last XB.DRAW.DROPDOWN left behind, so it has to run
## while XB.ACTIVE still names the panel that is on screen.
##
## The store can refuse, and then this falls back to what it did before: blank
## the rectangle and mark the view dirty for the caller to redraw.
XB.ERASE.DROPDOWN:
    IF XB.DD.HND = 0 THEN GOTO XB.ERASE.BLANK
    SV.HND = XB.DD.HND
    SV.MOVE = 0
    GOSUB SV.RESTORE
    XB.PUTBACK = SV.OK
    SV.HND = XB.DD.HND
    GOSUB SV.FREE
    XB.DD.HND = 0
    IF XB.PUTBACK THEN RETURN

XB.ERASE.BLANK:
    GP.FILL XB.DD.BX, XB.DD.BY, XB.DD.BW + XB.DD.SW, XB.DD.BH + XB.DD.SH, 32, THEME.CLR(THEME.PAGE)
    XB.DIRTY = -1
    RETURN

## The store had no room. A hole can only appear in it when something frees out
## of order, so this is the one place the compactor belongs: asked for, on a
## refusal, and never on a timer. SV.SAVE is retried once; if it refuses again
## the panel is drawn anyway and the erase falls back to a repaint.
XB.PANEL.TIGHTEN:
    GOSUB SV.COMPACT
    GOSUB SV.SAVE
    RETURN


## ------------------------------------------------------------ the key loop
## THE DROPDOWN'S KEY LOOP IS MENUVERT.RUN'S. What is needed on top of it is
## that this is a dropdown UNDER A BAR: LEFT and RIGHT walk the bar with the
## panel still open. MENUVERT.KEYEXIT hands those two back instead of
## swallowing them, and MENUBAR.DOWNEXIT is the same idea pointing the other
## way.
##
## XB.ACTIVE and XB.SEL are 0 based; MENUBAR.SEL and MENUVERT.SEL are 1 based.
## Converted at the boundary and nowhere else.
XB.OPEN.MENUBAR:
    XB.SEL = 0
    GOSUB XB.RENDER.MENUBAR

XB.MENU.OPEN:
    GOSUB XB.DRAW.DROPDOWN

## A KEY NOBODY CLAIMED COMES BACK TO XB.MENU.KEYS, NOT TO XB.MENU.OPEN. Going
## back to the open would run XB.DRAW.DROPDOWN over a panel already on screen:
## SV.SAVE would store the panel as what lies underneath it, and the handle from
## the first save would never be freed. LEFT and RIGHT still go to the open,
## because they erase first and the panel moves.
XB.MENU.KEYS:
    MENUVERT.SEL = XB.SEL + 1
    MENUVERT.FLAGS = MENUVERT.KEYEXIT
    GOSUB MENUVERT.RUN
    IF MENUVERT.SEL = 0 THEN GOSUB XB.MENU.CANCEL : RETURN
    XB.SEL = MENUVERT.SEL - 1
    IF MENUVERT.HOTHIT THEN GOSUB XB.MENU.SELECT : RETURN
    IF MENUVERT.KEY = 13 THEN GOSUB XB.MENU.SELECT : RETURN
    IF MENUVERT.KEY = 157 THEN GOSUB XB.MENU.LEFT : GOTO XB.MENU.OPEN
    IF MENUVERT.KEY = 29 THEN GOSUB XB.MENU.RIGHT : GOTO XB.MENU.OPEN
    GOTO XB.MENU.KEYS

## ERASE BEFORE MOVING. XB.ERASE.DROPDOWN works from the XB.DD.* geometry the
## last XB.DRAW.DROPDOWN left behind -- the panel actually on screen -- so it
## has to run while XB.ACTIVE still names that panel.
XB.MENU.LEFT:
    GOSUB XB.ERASE.DROPDOWN
    IF XB.DIRTY THEN GOSUB XB.VIEW.DRAW
    XB.WAS = XB.ACTIVE
    XB.ACTIVE = XB.ACTIVE - 1
    IF XB.ACTIVE < 0 THEN XB.ACTIVE = XB.LASTM
    XB.SEL = 0
    GOSUB XB.MENU.BAR.MOVE
    RETURN

XB.MENU.RIGHT:
    GOSUB XB.ERASE.DROPDOWN
    IF XB.DIRTY THEN GOSUB XB.VIEW.DRAW
    XB.WAS = XB.ACTIVE
    XB.ACTIVE = XB.ACTIVE + 1
    IF XB.ACTIVE > XB.LASTM THEN XB.ACTIVE = 0
    XB.SEL = 0
    GOSUB XB.MENU.BAR.MOVE
    RETURN

## The two titles that changed, and nothing else. XB.MENU.BAR.ITEMS first,
## because XB.DRAW.DROPDOWN has since pointed MENUVERT.X, .Y, .WIDTH, .ATTR
## and .HIATTR at the PANEL, and MENUBAR.ITEM and MENUBAR.MARK both reach
## MENUVERT.ROW through those.
XB.MENU.BAR.MOVE:
    GOSUB XB.MENU.BAR.ITEMS
    MENUBAR.DRAWN = XB.WAS + 1
    MENUBAR.PAINT = MENUVERT.ATTR
    GOSUB MENUBAR.ITEM
    MENUBAR.SEL = XB.ACTIVE + 1
    GOSUB MENUBAR.MARK
    RETURN

XB.MENU.SELECT:
    XB.PICK.M = XB.ACTIVE
    XB.PICK.I = XB.SEL
    XB.ACTIVE = 0 - 1
    GOSUB XB.MENU.CLOSE
    XB.RULEID = XB.RULE(XB.PICK.M, XB.PICK.I)
    GOSUB XB.ITEMOK
    IF XB.ENABLED = 0 THEN XB.MSG$ = XB.WHY$ : GOSUB XB.SAY : RETURN
    GOSUB XB.MENU.DISPATCH
    RETURN

XB.MENU.CANCEL:
    XB.ACTIVE = 0 - 1
    GOSUB XB.MENU.CLOSE
    RETURN

XB.MENU.CLOSE:
    GOSUB XB.ERASE.DROPDOWN
    GOSUB XB.RENDER.MENUBAR
    GOSUB XB.VIEW.DRAW
    RETURN


## --------------------------------------------------------------- dispatch
## Two levels, both ON ... GOSUB. The commands themselves are in XBASE.BASL.
XB.MENU.DISPATCH:
    ON XB.PICK.M + 1 GOSUB XB.DISP.FILE, XB.DISP.MODIFY, XB.DISP.BROWSE, XB.DISP.UTIL, XB.DISP.MOVE, XB.DISP.HELP, XB.DISP.TEST
    RETURN

## THE SEVENTH NAME IS THE SEPARATOR'S. ON ... GOSUB counts its names, so the
## row needs one even though nothing can select it; XB.CMD.NOP is a RETURN.
XB.DISP.FILE:
    ON XB.PICK.I + 1 GOSUB XB.CMD.OPENDB, XB.CMD.CREATEDB, XB.CMD.CLOSEDB, XB.CMD.OPENIX, XB.CMD.CREATEIX, XB.CMD.CLOSEIX, XB.CMD.NOP, XB.CMD.QUIT
    RETURN

XB.DISP.MODIFY:
    ON XB.PICK.I + 1 GOSUB XB.CMD.SAVESTRU
    RETURN

XB.DISP.BROWSE:
    ON XB.PICK.I + 1 GOSUB XB.CMD.BROWSE, XB.CMD.RECORD
    RETURN

XB.DISP.UTIL:
    ON XB.PICK.I + 1 GOSUB XB.CMD.COPY, XB.CMD.APPEND, XB.CMD.REPLACE, XB.CMD.PACK, XB.CMD.ZAP
    RETURN

XB.DISP.MOVE:
    ON XB.PICK.I + 1 GOSUB XB.CMD.SEEK, XB.CMD.GOTO, XB.CMD.LOCATE, XB.CMD.SKIP
    RETURN

XB.DISP.HELP:
    ON XB.PICK.I + 1 GOSUB XB.CMD.ABOUT, XB.CMD.MEMORY
    RETURN

XB.DISP.TEST:
    ON XB.PICK.I + 1 GOSUB XB.CMD.TESTSAY, XB.CMD.TESTYN, XB.CMD.TESTINPUT, XB.CMD.TESTLIST, XB.CMD.TESTCOMBO, XB.CMD.TESTTHEME
    RETURN
