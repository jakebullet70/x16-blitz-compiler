## MENUTO.VERT regression. Keys go in through kbdbuf_put, because -bas paste
## cannot drive a program that sits in a GET loop -- the same harness
## INPTST.EXP.BL uses.
##
## What is checked here is the LOGIC -- which row a key lands on, what
## cancels, what wraps, what is skipped. The drawing is not, and neither is
## the store: MENUBUILD.EXP.BL reads back what MENU.ITEM wrote.
##
## Compile SHARED: the rows are kept in bank 62.
#INCLUDE "GPB.INC.BL"
## THE LIBRARY IN LOW MEMORY. To run a module below from a RAM bank instead,
## put its #INCLUDE inside a GP.BANKED region -- BANKED-OR-NOT.md has the rules.
#INCLUDE "BANKMGR.INC.BL"
#INCLUDE "MENU.INC.BANKED.BL"
#INCLUDE "MENU.INC.BL"
#SAVEAS "@:MENUTST.PRG"

#DEFINE KBDBUF.PUT $F09F

#DEFINE NORMAL 6 * 16 + 1
#DEFINE BRIGHT 1 * 16 + 6

CLS
COLOR 1,0
GOSUB BANKMGR.INIT

MENU.ATTR = NORMAL
MENU.HIATTR = BRIGHT
GOSUB TEST.GAME

## ---- 1. two downs and RETURN, and the highlight is GONE afterwards
MENU.FLAGS = 0
KEY.CODE = 17 : GOSUB KEY.SEND
KEY.CODE = 17 : GOSUB KEY.SEND
KEY.CODE = 13 : GOSUB KEY.SEND
GOSUB TEST.RUN
TEST.A = TEST.GOT : TEST.AK = MENU.EXITKEY

## ---- 2. hotkey, upper case. It CHOOSES, it does not merely move
KEY.CODE = 79 : GOSUB KEY.SEND
GOSUB TEST.RUN
TEST.B = TEST.GOT : TEST.BK = MENU.EXITKEY

## ---- 3. hotkey, lower case -- matched without case
KEY.CODE = 113 : GOSUB KEY.SEND
GOSUB TEST.RUN
TEST.C = TEST.GOT

## ---- 4. ESC cancels
KEY.CODE = 27 : GOSUB KEY.SEND
GOSUB TEST.RUN
TEST.D = TEST.GOT : TEST.DK = MENU.EXITKEY

## ---- 5. wrap off the top, 1 -> 4
KEY.CODE = 145 : GOSUB KEY.SEND
KEY.CODE = 13 : GOSUB KEY.SEND
GOSUB TEST.RUN
TEST.E = TEST.GOT

## ---- 6. wrap off the bottom, 4 -> 1
GP.SUB MENU.SELECTED, 4
KEY.CODE = 17 : GOSUB KEY.SEND
KEY.CODE = 13 : GOSUB KEY.SEND
GOSUB TEST.RUN
TEST.F = TEST.GOT

## ---- 7. NOWRAP holds at the top
MENU.FLAGS = MENU.NOWRAP
KEY.CODE = 145 : GOSUB KEY.SEND
KEY.CODE = 13 : GOSUB KEY.SEND
GOSUB TEST.RUN
TEST.G = TEST.GOT

## ---- 8. NOWRAP holds at the bottom
GP.SUB MENU.SELECTED, 4
KEY.CODE = 17 : GOSUB KEY.SEND
KEY.CODE = 13 : GOSUB KEY.SEND
GOSUB TEST.RUN
TEST.H = TEST.GOT

## ---- 9. MUSTSEL swallows ESC, so the RETURN after it is what lands
MENU.FLAGS = MENU.MUSTSEL
GP.SUB MENU.SELECTED, 2
KEY.CODE = 27 : GOSUB KEY.SEND
KEY.CODE = 13 : GOSUB KEY.SEND
GOSUB TEST.RUN
TEST.I = TEST.GOT

## ---- 10. KEEPMARK leaves the chosen row highlighted on the way out
MENU.FLAGS = MENU.KEEPMARK
GP.SUB MENU.SELECTED, 3
KEY.CODE = 13 : GOSUB KEY.SEND
GOSUB TEST.RUN
TEST.J = TEST.GOT

## ---- 11. no hotkeys at all: Q must be ignored, not crash
MENU.FLAGS = 0
GP.SUB MENU.BEGIN, MENU.POPUP
GP.SUB MENU.ITEM, " NEW GAME"
GP.SUB MENU.ITEM, " LOAD"
GP.SUB MENU.ITEM, " OPTIONS"
GP.SUB MENU.ITEM, " QUIT"
KEY.CODE = 81 : GOSUB KEY.SEND
KEY.CODE = 13 : GOSUB KEY.SEND
GOSUB TEST.RUN
TEST.K = TEST.GOT

## ---- 12. zero rows returns 0 and does NOT wait for a key
GP.SUB MENU.BEGIN, MENU.POPUP
GP.SUB MENU.SELECTED, 2
GOSUB TEST.RUN
TEST.L = TEST.GOT

## ---- 13. the GAMEPAD flag with no pad plugged in must not eat the
## ---- keyboard, and must not hang in the poll
GOSUB TEST.GAME
MENU.FLAGS = MENU.GAMEPAD
KEY.CODE = 17 : GOSUB KEY.SEND
KEY.CODE = 13 : GOSUB KEY.SEND
GOSUB TEST.RUN
TEST.M = TEST.GOT

## ---- 14. the default highlight: MENU.HIATTR = 0 inverts MENU.ATTR
MENU.FLAGS = MENU.KEEPMARK
MENU.HIATTR = 0
KEY.CODE = 13 : GOSUB KEY.SEND
GOSUB TEST.RUN
TEST.N = TEST.GOT
MENU.HIATTR = BRIGHT

## ---- 15..20. dead rows. A separator and a disabled row sit between 1 and 4,
## ---- and the cursor steps over both, either way.
MENU.FLAGS = 0
GP.SUB MENU.BEGIN, MENU.POPUP
GP.SUB MENU.ITEM, " &NEW GAME"
GP.SUB MENU.ITEM, "-"
GP.SUB MENU.ITEMX, " &LOAD", "", MENU.OFF
GP.SUB MENU.ITEM, " &OPTIONS"
GP.SUB MENU.ITEM, " &QUIT"

KEY.CODE = 17 : GOSUB KEY.SEND
KEY.CODE = 13 : GOSUB KEY.SEND
GOSUB TEST.RUN
TEST.O = TEST.GOT

GP.SUB MENU.SELECTED, 4
KEY.CODE = 145 : GOSUB KEY.SEND
KEY.CODE = 13 : GOSUB KEY.SEND
GOSUB TEST.RUN
TEST.P = TEST.GOT

## the hot key of a disabled row does nothing; the RETURN after it lands on 1
KEY.CODE = 76 : GOSUB KEY.SEND
KEY.CODE = 13 : GOSUB KEY.SEND
GOSUB TEST.RUN
TEST.Q = TEST.GOT

## opening on a dead row slides forward to the next live one
GP.SUB MENU.SELECTED, 3
KEY.CODE = 13 : GOSUB KEY.SEND
GOSUB TEST.RUN
TEST.R = TEST.GOT

## KEYEXIT hands back a key the menu has no use for, with the row it was on
MENU.FLAGS = MENU.KEYEXIT
GP.SUB MENU.SELECTED, 4
KEY.CODE = 29 : GOSUB KEY.SEND
GOSUB TEST.RUN
TEST.S = TEST.GOT : TEST.SK = MENU.EXITKEY

## no live row at all: the cursor must not walk for ever, and ESC still works
MENU.FLAGS = 0
GP.SUB MENU.BEGIN, MENU.POPUP
GP.SUB MENU.ITEMX, " &ONLY", "", MENU.OFF
GP.SUB MENU.ITEM, "-"
KEY.CODE = 13 : GOSUB KEY.SEND
KEY.CODE = 27 : GOSUB KEY.SEND
GOSUB TEST.RUN
TEST.T = TEST.GOT

CLS
PRINT "A";TEST.A;TEST.AK;" EXPECT 3 13"
PRINT "B";TEST.B;TEST.BK;" EXPECT 3 79"
PRINT "C";TEST.C;" EXPECT 4"
PRINT "D";TEST.D;TEST.DK;" EXPECT 0 27"
PRINT "E";TEST.E;" EXPECT 4"
PRINT "F";TEST.F;" EXPECT 1"
PRINT "G";TEST.G;" EXPECT 1"
PRINT "H";TEST.H;" EXPECT 4"
PRINT "I";TEST.I;" EXPECT 2"
PRINT "J";TEST.J;" EXPECT 3"
PRINT "K";TEST.K;" EXPECT 1"
PRINT "L";TEST.L;" EXPECT 0"
PRINT "M";TEST.M;" EXPECT 2"
PRINT "N";TEST.N;" EXPECT 1"
PRINT "O";TEST.O;" EXPECT 4"
PRINT "P";TEST.P;" EXPECT 1"
PRINT "Q";TEST.Q;" EXPECT 1"
PRINT "R";TEST.R;" EXPECT 4"
PRINT "S";TEST.S;TEST.SK;" EXPECT 4 29"
PRINT "T";TEST.T;" EXPECT 0"
PRINT "@DONE@"
POWEROFF

## ---- the four rows most cases run, N L O Q their hot keys.
TEST.GAME:
    GP.SUB MENU.BEGIN, MENU.POPUP
    GP.SUB MENU.ITEM, " &NEW GAME"
    GP.SUB MENU.ITEM, " &LOAD"
    GP.SUB MENU.ITEM, " &OPTIONS"
    GP.SUB MENU.ITEM, " &QUIT"
    RETURN

## ---- MENU.SELECTED lasts one run, so a case that sets none opens on row 1.
TEST.RUN:
    TEST.GOT = GP.FN(MENUTO.VERT, 5, 7, MENU.THIN)
    RETURN

## ---- A key straight into the KERNAL's own buffer. kbdbuf_put lives in
## ---- ROM bank 0 and compiled code runs in bank 4, hence the two POKEs.

KEY.SEND:
    POKE 1,0 : GP.CALL KBDBUF.PUT, KEY.CODE : POKE 1,4
    RETURN
