## ***********************************************************************
## **
## **  ASM.EXP.BL -- GP.ASM / GP.ENDASM, inline 65C02 assembly
## **
## **  Everything MLCALL.EXP.BL does by POKEing bytes into a bank, written
## **  as assembly instead -- and reaching BASIC's own variables directly:
## **
## **      POKE ML.INCS+0,26 : POKE ML.INCS+1,232 : GP.CALL ML.INCS,10
## **      GP.ASM / REM INC A / REM INX / GP.ENDASM
## **
## **  The assembled bytes go INTO THE PROGRAM. Nothing to POKE, no bank to
## **  reserve, nothing to keep in step with a comment saying what the
## **  numbers used to mean.
## **
## **  Build:  copy GPC-BASIC/GPB.INC.BL and this file into testing/, then
## **            python source/gpc/build_basl.py ASM.EXP.BL ASM.PRG
## **          and compile ASM.PRG with GPC.BIN.
## **
## ***********************************************************************
#INCLUDE "GPB.INC.BL"
#SYMFILE "@:ASM.SYM"
#SAVEAS "@:ASM.PRG"

## ---- #REM 1 IS REQUIRED, and it is the one thing that catches people out.
##
## The body rides in REM statements because BASLOAD stores remark text byte for byte --
## ORA, AND, EOR and ROR reach the compiler intact, where outside a REM they tokenise
## into keywords. Braces survive too, which is what makes {VAR} possible.
##
## BASLOAD's default is #REM 0, which strips them first. GP.ASM and GP.ENDASM are real
## keywords rather than REMs precisely so the block is still THERE to be found empty:
## GPC says BLOCK MISMATCH instead of compiling a program that contains no code.
##
## Every block below is bracketed by its own pair. One switch at the top of the file
## would work as well, but pairing it says what the switch is FOR and keeps ordinary
## REMs out of the tokenised PRG.

## ---- 1. Assembly, in the program, with nothing to set up first.

PRINT "1. ";
#REM 1
GP.ASM
REM LDA #72               ; H
REM JSR $FFD2             ; KERNAL CHROUT
REM LDA #73               ; I
REM JSR $FFD2
GP.ENDASM
#REM 0
PRINT

## ---- 2. {VAR} -- READING AND WRITING BASIC'S OWN VARIABLES.
##
## {VAR} is THE ADDRESS OF THE VARIABLE'S SLOT, which is what makes reading and writing
## the same thing.
##
## IT NEEDS #SYMFILE. BASLOAD crunches N% to A% in the CODE -- that is how it offers 64
## character names on a two character BASIC -- but keeps REM text byte for byte, the
## very property that lets an assembly body survive. So the code says A% and the REM
## still says {N%}; #SYMFILE writes that mapping down. Name it to match the PRG, ASM.PRG
## reading ASM.SYM, or the compile stops with NO SYMBOL FILE FOR {}.
##
## M% IS ASSIGNED FIRST ON PURPOSE: {VAR} never CREATES a variable, the opposite of an
## ordinary BASIC reference, so an unused name is UNKNOWN VARIABLE IN {}.

N% = 65
M% = 0
PRINT "2. ";
#REM 1
GP.ASM
REM LDA {N%}               ; N% is A% by the time BASLOAD is done with it
REM CLC
REM ADC #1
REM STA {M%}               ; M% = N% + 1, in BASIC'S OWN SLOT
GP.ENDASM
#REM 0
PRINT "N=";N%;" M=";M%

## ---- 3. Labels and branches.
##
## NAME: on its own line or in front of an instruction, six characters significant, and
## belonging to its block -- the same name in two blocks is two labels, neither able to
## branch to the other. A branch further than 127 bytes is OUT OF RANGE at COMPILE time,
## while the line number is still known.

PRINT "3. ";
#REM 1
GP.ASM
REM LDX #5
REM LOOP: LDA #42         ; *
REM JSR $FFD2
REM DEX
REM BNE LOOP
GP.ENDASM
#REM 0
PRINT

## ---- 4. JMP and JSR take a label too, and those are real addresses -- the
## ---- compiler fills them in once it knows where the program will run.

PRINT "4. ";
#REM 1
GP.ASM
REM JMP OVER
REM LDA #88               ; X -- jumped over, never printed
REM JSR $FFD2
REM OVER: LDA #79         ; O
REM JSR $FFD2
REM LDA #75               ; K
REM JSR $FFD2
GP.ENDASM
#REM 0
PRINT

## ---- 5. There is no expression syntax. {N%}+1 and LABEL+2 are not things.
##
## Use an index register instead, which is what the 6502 wants anyway:
##
##     LDX #1
##     LDA {N%},X           the HIGH byte of an int16
##
## ---- 6. Zero page or absolute is decided by THE OPERAND, not by the
## ---- instruction and not by you:
##
##       LDA $34          zero page      A5 34
##       LDA $0034        absolute       AD 34 00
##       LDA 52           zero page      A5 34     -- decimal under 256
##       LDA 300          absolute       AD 2C 01
##
## so write $0034 when you mean the long form. Every 65C02 mode is available, including
## the two the NMOS 6502 lacks -- LDA ($34) unindexed, and JMP ($1234,X). Only
## BBR/BBS/RMB/SMB are missing, being Rockwell additions nothing here uses.

PRINT "DONE"

END
