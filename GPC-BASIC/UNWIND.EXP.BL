## ***********************************************************************
## **
## **  UNWIND.EXP.BL -- a GOTO may leave a GP.SELECT or a GP.DO
## **
## **  GP.DO is the only block that opens a stack frame now, and GP.LOOP is
## **  what releases it -- so a GOTO that jumps past one used to leak it,
## **  one per pass, until the 4K frame stack ran out. It does not any more:
## **  the compiler puts an .unwind in front of any GOTO that leaves a loop
## **  and FixBranches fills in how many frames it closes. A select keeps
## **  NOTHING alive (since 01/09/26 the selector is a plain variable that
## **  each GP.CASE re-reads), so a GOTO out of one has nothing to leak and
## **  needs no unwinding at all.
## **
## **  This is the regression test as much as the example, and the counts
## **  are chosen so it FAILS if either half ever stops working. The select
## **  legs (1, 3) run 1200 GOTOs out of and inside case bodies and must
## **  disturb nothing; the GP.DO legs (2, 4) leak a real loop frame per
## **  pass if the unwind breaks, and 800+ leaks against a 4K stack is
## **  OUT OF MEMORY. Getting to the end is the proof.
## **
## **  Build:  copy GPC-BASIC/GPB.INC.BL and this file into testing/, then
## **            python source/gpc/build_basl.py UNWIND.EXP.BL UNWIND.PRG
## **          and compile UNWIND.PRG with GPC.BIN.
## **
## **  Compile-only: the ROM cannot RUN a PRG containing GP tokens.
## **
## ***********************************************************************
#INCLUDE "GPB.INC.BL"
#SAVEAS "@:UNWIND.PRG"
#AUTONUM 1
#REM 0

REM ---- 1. GOTO out of a case body, 1200 times ----
UT.N = 0
UT.HIT = 0
UT.OTH = 0
UT.LOOP:
  UT.N = UT.N + 1
  UT.SEL = UT.N - INT(UT.N / 3) * 3
GP.SELECT UT.SEL
GP.CASE 0
  GOTO UT.BACK
GP.CASE 1
  UT.HIT = UT.HIT + 1
GP.OTHER
  UT.OTH = UT.OTH + 1
GP.ENDSEL
UT.BACK:
  IF UT.N < 1200 THEN GOTO UT.LOOP
PRINT "SELECT N=";UT.N;" HIT=";UT.HIT;" OTH=";UT.OTH

REM ---- 2. GOTO out of a GP.DO body, 1200 times ----
UT.M = 0
UT.DLOOP:
  UT.M = UT.M + 1
GP.DO 5
  GOTO UT.DBACK
GP.LOOP
UT.DBACK:
  IF UT.M < 1200 THEN GOTO UT.DLOOP
PRINT "DO M=";UT.M

REM ---- 3. a GOTO that stays INSIDE its block must not close anything ----
REM      If it did, GP.ENDSEL would find no frame and raise BLOCK MISMATCH.
UT.IN = 0
UT.SEL = 1
GP.SELECT UT.SEL
GP.CASE 1
  GOTO UT.SAME
UT.SAME:
  UT.IN = 99
GP.ENDSEL
PRINT "INSIDE IN=";UT.IN

REM ---- 4. nested: a GOTO leaving a select inside a GP.DO leaves BOTH ----
UT.K = 0
UT.NLOOP:
  UT.K = UT.K + 1
UT.SEL = 7
GP.DO 5
GP.SELECT UT.SEL
GP.CASE 7
  GOTO UT.NBACK
GP.ENDSEL
GP.LOOP
UT.NBACK:
  IF UT.K < 800 THEN GOTO UT.NLOOP
PRINT "NESTED K=";UT.K

REM ---- 5. the frame stack must still be healthy afterwards ----
REM      A leak would have died above; this proves the stack is not merely
REM      un-full but actually usable to its normal depth.
UT.SUM = 0
FOR UT.I = 1 TO 20
  GOSUB UT.SUB
NEXT UT.I
PRINT "STACK SUM=";UT.SUM

REM ---- 6. one-line GP.CASE: does "GP.CASE n : <statement>" work today? ----
UT.ONE = 0
UT.KEY = 29
GP.SELECT UT.KEY
  GP.CASE 157 : GOSUB UT.LEFT
  GP.CASE 29 : GOSUB UT.RIGHT
  GP.OTHER : GOSUB UT.NONE
GP.ENDSEL
PRINT "ONELINE ONE=";UT.ONE;" (want 2)"

PRINT "UNWIND OK"
END

UT.SUB:
  UT.SUM = UT.SUM + 1
  RETURN
UT.LEFT:
  UT.ONE = 1
  RETURN
UT.RIGHT:
  UT.ONE = 2
  RETURN
UT.NONE:
  UT.ONE = 3
  RETURN
