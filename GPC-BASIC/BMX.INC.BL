## ***********************************************************************
## **
## **  BMX.INC.BL -- load a BMX bitmap into VERA.
## **
## **      BMX.OPEN    open the file and read its 32 byte header
## **      BMX.PAINT   palette and pixels into VRAM, then close
## **      BMX.SHOW    both, for when you already trust the file
## **      BMX.CLOSE   abandon a file opened by BMX.OPEN
## **      BMX.RESTORE put the machine's own palette back
## **
## **  Usage, the short way -- a title screen:
## **
## **      BMX.FILE$ = "TITLE.BMX"
## **      SCREEN 128
## **      GOSUB BMX.SHOW
## **      IF BMX.ERROR$ <> "" THEN PRINT BMX.ERROR$
## **
## **  Usage, the careful way -- when you want the size before you commit
## **  to a screen mode, or want to report a bad file without the display
## **  already torn down:
## **
## **      BMX.FILE$ = F$
## **      GOSUB BMX.OPEN
## **      IF BMX.ERROR$ <> "" THEN GOTO COMPLAIN
## **      ... BMX.WIDTH, BMX.HEIGHT, BMX.PALUSED are readable here ...
## **      SCREEN 128
## **      GOSUB BMX.PAINT
## **
## **  SET THE SCREEN MODE BEFORE BMX.PAINT, NOT AFTER. SCREEN reloads the
## **  default palette, so a mode change after painting throws the image's
## **  colours away and leaves you looking at the right pixels in the wrong
## **  colours -- which reads as a corrupt file rather than a mistake.
## **
## **  8 bits per pixel, uncompressed. That is what SCREEN 128 can show
## **  without a decompressor. Anything else is reported, not attempted.
## **
## **  THE PALETTE IS BORROWED, NOT TAKEN. BMX.PAINT writes the picture's
## **  colours over the machine's, and nothing else on the X16 puts them
## **  back -- neither SCREEN nor the KERNAL's screen_mode restores the
## **  palette, which is measured, not assumed. So BMX.PAINT stashes all
## **  256 entries in spare VRAM first, and BMX.RESTORE writes them back:
## **
## **      BMX.FILE$ = "TITLE.BMX"
## **      SCREEN 128
## **      GOSUB BMX.SHOW
## **      ... the title screen ...
## **      GOSUB BMX.RESTORE
## **
## **  A caller that owns the machine can simply never call it. One that
## **  hands the machine back -- to BASIC, or to the next program in a
## **  chain -- calls it and is done, and never learns where the palette
## **  lives or how many entries the picture claimed. That is the point:
## **  the range comes from the file's own header, so it is knowledge this
## **  file already has and the caller would otherwise have to copy by hand.
## **
## **  BOTH HALVES ARE ONE KERNAL CALL, not a loop. memory_copy leaves an
## **  address in $9F00-$9FFF unstepped, so with VERA's TWO address ports
## **  pointed at the palette and at the stash, source $9F23 and target
## **  $9F24 copy inside VRAM while VERA walks both ends itself. The KERNAL
## **  chapter names this exact use. 512 bytes, twice a run, unmeasurable.
## **
## **  BMX.STASH IS SPARE VRAM AND THE DEFAULT ASSUMES A TITLE SCREEN --
## **  $13000, just above the 320x240 framebuffer. That region is free in
## **  the mode this file paints into, but a caller with tiles, sprites or
## **  a second bitmap up there must move it or switch it off:
## **
## **      BMX.STASH = -1     keep nothing; BMX.RESTORE becomes a no-op
## **
## **  Minus one and not zero, because zero is what the variable holds
## **  before anyone has touched it, and BMX.INIT has to be able to tell
## **  "not set" from "set to off" -- it runs at the first BMX.OPEN, long
## **  after a caller would have written the line.
## **
## **  It is checked, not trusted: a stash inside the bitmap or running
## **  into the PSG registers at $1F9C0 is reported and nothing is painted.
## **
## **  WHY THIS IS NOT A KEYWORD. It is one KERNAL call in a loop and some
## **  arithmetic -- no bulk data handling that BASIC would be bad at, since
## **  MACPTR moves the bytes -- so by the rule the whole GP set is built on
## **  it belongs in BASIC, and only programs that want it pay for it.
## **
## **  The whole BMX.* name space belongs to this file.
## **
## ***********************************************************************
#IFNDEF BMX.DEFS
#DEFINE BMX.DEFS 1

## KERNAL entries. MACPTR is the fast block reader: it moves up to .A bytes
## from the open channel to the address in .X/.Y and reports how many it
## actually moved back in .X/.Y. WITH CARRY SET the address is NOT stepped,
## which is what lets it fire a whole row straight at a VERA data port --
## and that is the difference between an image that appears and one you
## watch fill in.

#DEFINE BMXK.MACPTR $FF44
#DEFINE BMXK.CHKIN $FFC6
#DEFINE BMXK.CLRCHN $FFCC

## memory_copy. Source and target both live in $9F00-$9FFF here, so neither
## is stepped and both ends are VERA data ports -- see BMX.PALCOPY.
#DEFINE BMXK.MEMCOPY $FEE7

#DEFINE BMXK.VCTRL $9F25
#DEFINE BMXK.VLO $9F20
#DEFINE BMXK.VMID $9F21
#DEFINE BMXK.VHI $9F22

## $9F23 and $9F24 are VERA data ports 0 and 1, split into the bytes the
## 16 bit ABI registers want. Two ports is what makes a VRAM to VRAM copy
## one call instead of a loop.
##
## PORTLO.B, AND NOT THE OBVIOUS NAME ENDING IN A ONE: a #DEFINE name may
## not contain a digit ANYWHERE, and BASLOAD rejects the whole FILE rather
## than the line -- ERROR: INVALID PARAMETER, naming the #DEFINE. It is the
## same rule that stops VERA's own register names being used here.
#DEFINE BMXK.PORTLO 35
#DEFINE BMXK.PORTLO.B 36
#DEFINE BMXK.PORTHI 159

## The logical file number. Change it here if it collides with yours.
#DEFINE BMXK.LFN 4

GOTO BMX.MODULE.END

## ***********************************************************************
## **  BMX.INIT -- allocate the buffers. Called on demand, so there is
## **  nothing for a caller to forget.
## **
## **  GP.STRPTR returns the address of [ActLen][Data], so the bytes start
## **  one later -- and because a string block is real RAM, the KERNAL can
## **  write straight into it. That is the whole trick, and it is why this
## **  needs no fixed scratch address: $0400 would have been the obvious
## **  one and is NOT free, because a compiled GPC program keeps runtime
## **  state there and corrupts it quietly.
## **
## **  BMX.PALBASE is VRAM $1FA00, and it is a variable rather than a
## **  #DEFINE because #DEFINE takes an INT16 (BASLOAD.MD:313) and 129536
## **  does not fit. Every VRAM address past $FFFF has the same problem.
## **  BMX.STASH is $13000 and is a variable for that reason too -- and
## **  because a caller with its own data up there has to be able to move
## **  it. See the note at the top of the file.
## ***********************************************************************

BMX.INIT:
    BMX.PALBASE = 129536
    BMX.KEPT = 0

## ---- ONLY IF THE CALLER HAS NOT ALREADY SET IT. BMX.INIT runs on demand,
## ---- at the first BMX.OPEN, which is AFTER the caller's own setup -- so
## ---- assigning the default unconditionally would quietly undo a stash
## ---- address that had been set the obvious way, at the top of a program.
## ---- Zero therefore means "never set" and cannot also mean "switched
## ---- off"; -1 is what says keep nothing.

    IF BMX.STASH = 0 THEN BMX.STASH = 77824
    BMX.HEADER$ = RPT$(32, 32)
    BMX.PTR = GP.STRPTR(BMX.HEADER$) + 1
    BMX.SCRATCH$ = RPT$(32, 255)
    BMX.SCRATCH = GP.STRPTR(BMX.SCRATCH$) + 1
    RETURN

## ***********************************************************************
## **  BMX.OPEN -- open BMX.FILE$ and read its header.
## **
## **   in   BMX.FILE$
## **   out  BMX.ERROR$    empty if the file is one we can paint
## **        BMX.WIDTH  BMX.HEIGHT  BMX.DEPTH  BMX.VERSION
## **        BMX.PALUSED  BMX.PALFIRST  BMX.DATAOFF  BMX.PACKED
## **
## **  ON SUCCESS THE CHANNEL IS LEFT OPEN, standing exactly where the
## **  palette begins -- which is why nothing in this file ever seeks. On
## **  failure it is closed for you.
## ***********************************************************************

BMX.OPEN:
    IF BMX.PTR = 0 THEN GOSUB BMX.INIT
    BMX.ERROR$ = ""
    OPEN BMXK.LFN, 8, 4, BMX.FILE$ + ",S,R"
    GP.CALL BMXK.CHKIN, 0, BMXK.LFN, 0, 0
    BMX.ADDR = BMX.PTR
    GOSUB BMX.SPLIT
    GP.CALL BMXK.MACPTR, 32, BMX.LO, BMX.HI, 0
    BMX.STEP = GP.X + GP.Y * 256
    IF BMX.STEP < 32 THEN BMX.ERROR$ = "CANNOT READ " + BMX.FILE$
    IF BMX.ERROR$ = "" THEN GOSUB BMX.PARSE
    IF BMX.ERROR$ <> "" THEN GOSUB BMX.CLOSE
    RETURN

## ***********************************************************************
## **  BMX.PAINT -- palette and pixels into VRAM, then close.
## **
## **  The screen mode must ALREADY be set (see the note at the top).
## **
## **  A FULL WIDTH image goes in as ONE block -- the framebuffer is linear,
## **  so 320 wide rows at x=0 are contiguous however tall the picture is.
## **  Anything narrower goes in a row at a time, four pokes a row, which is
## **  what buys centring of any size with no framebuffer cursor calls.
## **
## **  That split is worth five times the speed on a full screen: 19 jiffies
## **  against 93 for a 320x240x8 file. See the note at the branch below.
## ***********************************************************************

BMX.PAINT:
    GOSUB BMX.KEEP
    IF BMX.ERROR$ <> "" THEN GOTO BMX.PAINT.END

    BMX.ADDR = BMX.PALBASE + BMX.PALFIRST * 2
    GOSUB BMX.VERA
    BMX.COUNT = BMX.PALUSED * 2
    GOSUB BMX.STREAM
    IF BMX.ERROR$ <> "" THEN GOTO BMX.PAINT.END

## ---- The header names where the image data starts. Normally that is
## ---- right after the palette, but honour it rather than assume it.

    BMX.SKIP = BMX.DATAOFF - 32 - BMX.PALUSED * 2
    IF BMX.SKIP > 0 THEN GOSUB BMX.DISCARD

    BMX.X0 = INT((320 - BMX.WIDTH) / 2)
    IF BMX.X0 < 0 THEN BMX.X0 = 0
    BMX.Y0 = INT((240 - BMX.HEIGHT) / 2)
    IF BMX.Y0 < 0 THEN BMX.Y0 = 0
    BMX.ROWS = BMX.HEIGHT
    IF BMX.ROWS > 240 THEN BMX.ROWS = 240

## ---- A FULL WIDTH IMAGE IS ONE BLOCK, and taking it as one is worth five
## ---- times the speed. The 320x240x8 framebuffer is linear -- row n is at
## ---- exactly n*320 -- so rows that are 320 wide and start at x=0 run
## ---- together with no gap, whatever y they start at. Set the address
## ---- once and stream the lot.
## ----
## ---- MEASURED on CANDLE.BMX, 320x240x8, 76,800 bytes: 93 jiffies row by
## ---- row against 19 as one block. The bytes are not the cost -- 0.32s of
## ---- that is MACPTR actually moving them, and the other 1.23s was 240
## ---- times (a float multiply, BMX.SPLIT's two divides, four POKEs) plus
## ---- the second MACPTR call every row, because 320 is 255 + 65 and the
## ---- tail call moves a quarter of a chunk for a whole call's overhead.
## ----
## ---- Narrower or centred images still go a row at a time. That path is
## ---- unchanged and is what buys centring of any size.

    BMX.ONEBLOCK = 0
    IF BMX.WIDTH = 320 THEN BMX.ONEBLOCK = 1
    IF BMX.X0 <> 0 THEN BMX.ONEBLOCK = 0
    IF BMX.ONEBLOCK = 0 THEN GOTO BMX.PAINT.ROWS

    BMX.ADDR = BMX.Y0 * 320
    GOSUB BMX.VERA
    BMX.COUNT = BMX.WIDTH * BMX.ROWS
    GOSUB BMX.STREAM
    GOTO BMX.PAINT.END

BMX.PAINT.ROWS:
    FOR BMX.ROW = 0 TO BMX.ROWS - 1
        BMX.ADDR = (BMX.Y0 + BMX.ROW) * 320 + BMX.X0
        GOSUB BMX.VERA
        BMX.COUNT = BMX.WIDTH
        GOSUB BMX.STREAM
        IF BMX.ERROR$ <> "" THEN GOTO BMX.PAINT.END
    NEXT

BMX.PAINT.END:
    GOSUB BMX.CLOSE : RETURN

## ---- Both halves, for a file you already trust. The screen mode must be
## ---- set first, so a bad file is reported with the display already in
## ---- graphics -- use BMX.OPEN and BMX.PAINT separately if that matters.

BMX.SHOW:
    GOSUB BMX.OPEN
    IF BMX.ERROR$ <> "" THEN RETURN
    GOSUB BMX.PAINT : RETURN

## ---- Hand the channel back. Safe to call twice; also the way to abandon
## ---- a file opened by BMX.OPEN without painting it.

BMX.CLOSE:
    GP.CALL BMXK.CLRCHN : CLOSE BMXK.LFN : RETURN

## ***********************************************************************
## **  BMX.KEEP -- the machine's palette into spare VRAM. Called by
## **  BMX.PAINT, so a caller never has to remember it.
## **
## **  ALL 256 ENTRIES, not the range the picture claims. Taking the lot
## **  costs the same single KERNAL call and makes the stash independent
## **  of the file: paint a second picture with a different BMX.PALFIRST
## **  and one BMX.RESTORE still puts back exactly what the machine had.
## **  Snapshotting only the claimed range would leave the first picture's
## **  leftovers behind, and the caller would have no way to know.
## **
## **  ONCE PER RUN. The guard is what makes a slideshow correct -- the
## **  original palette is kept, not the previous picture's.
## ***********************************************************************

BMX.KEEP:
    IF BMX.PTR = 0 THEN GOSUB BMX.INIT
    IF BMX.KEPT = 1 THEN RETURN
    IF BMX.STASH < 0 THEN RETURN : REM switched off by the caller; nothing kept, nothing to put back

## ---- Checked, not trusted. The default is free in the mode this file
## ---- paints into, but the caller can move it and a bad address would be
## ---- silent: below the framebuffer top it would be painted over by the
## ---- picture itself, and $1F9C0 up is the PSG, where a 512 byte write
## ---- is audible rather than merely wrong.

    IF BMX.STASH < 76800 THEN BMX.ERROR$ = "BMX.STASH IS INSIDE THE BITMAP"
    IF BMX.STASH > 128960 THEN BMX.ERROR$ = "BMX.STASH RUNS INTO THE PSG REGISTERS"
    IF BMX.ERROR$ <> "" THEN RETURN

    BMX.SRC = BMX.PALBASE : BMX.DST = BMX.STASH
    GOSUB BMX.PALCOPY
    BMX.KEPT = 1
    RETURN

## ***********************************************************************
## **  BMX.RESTORE -- the machine's palette back, and the stash released.
## **
## **  Safe to call at any time: nothing kept means nothing to do, so a
## **  program whose picture failed to load can call it unconditionally on
## **  the way out and does not have to remember whether it got that far.
## ***********************************************************************

BMX.RESTORE:
    IF BMX.KEPT = 0 THEN RETURN
    BMX.SRC = BMX.STASH : BMX.DST = BMX.PALBASE
    GOSUB BMX.PALCOPY
    BMX.KEPT = 0
    RETURN

## ***********************************************************************
## **  BMX.PALCOPY -- 512 bytes from BMX.SRC to BMX.DST, inside VRAM.
## **
## **  VERA has TWO address ports and they step independently, so pointing
## **  one at each end turns a copy into a single memory_copy: both r0 and
## **  r1 land in $9F00-$9FFF, where the KERNAL does not increment, and
## **  VERA walks both addresses itself. The KERNAL chapter names this use
## **  exactly -- "copying data inside VERA (source $9F23, destination
## **  $9F24)". A VPEEK/VPOKE loop would be some five jiffies each way; the
## **  loop overhead, not the bytes, is what that would have paid for.
## **
## **  Poking $02..$07 direct is safe from a compiled program: r0..r15 live
## **  at $02..$21 and GPC's own zero page starts at $22.
## ***********************************************************************

BMX.PALCOPY:
    BMX.ADDR = BMX.SRC
    GOSUB BMX.VERA : REM data port 0 -> the source, stepping by one

    BMX.ADDR = BMX.DST
    GOSUB BMX.SPLIT
    POKE BMXK.VCTRL, 1 : REM VERA CTRL bit 0, ADDRSEL = 1: $9F20-$9F22 are port 1's now
    POKE BMXK.VLO, BMX.LO : REM ADDR1_L
    POKE BMXK.VMID, BMX.HI : REM ADDR1_M
    POKE BMXK.VHI, BMX.BANK + 16 : REM ADDR1_H: bank in bit 0, increment 1 in the top nibble
    POKE BMXK.VCTRL, 0 : REM ADDRSEL back to 0, so the streaming path finds port 0 selected

    POKE 2, BMXK.PORTLO : REM r0L = $9F23, VERA DATA0 -- the source, and NOT stepped
    POKE 3, BMXK.PORTHI : REM r0H
    POKE 4, BMXK.PORTLO.B : REM r1L = $9F24, VERA DATA1 -- the target, and NOT stepped
    POKE 5, BMXK.PORTHI : REM r1H
    POKE 6, 0 : REM r2L = byte count low: 512, the whole 256 entry palette
    POKE 7, 2 : REM r2H
    GP.CALL BMXK.MEMCOPY : REM r2 is destroyed, r0 and r1 are not
    RETURN

## ***********************************************************************
## **  BMX.PARSE -- the 32 byte header, read straight out of the string.
## **
## **   0-2  "BMX"           6-7  width         12-13 image data offset
## **     3  version         8-9  height           14 compression
## **     4  bits per pixel   10  palette entries used, 0 meaning 256
## **     5  VERA depth reg   11  first palette index
## ***********************************************************************

BMX.PARSE:
    BMX.VERSION = PEEK(BMX.PTR + 3)
    BMX.DEPTH = PEEK(BMX.PTR + 4)
    BMX.WIDTH = PEEK(BMX.PTR + 6) + PEEK(BMX.PTR + 7) * 256
    BMX.HEIGHT = PEEK(BMX.PTR + 8) + PEEK(BMX.PTR + 9) * 256
    BMX.PALUSED = PEEK(BMX.PTR + 10)
    IF BMX.PALUSED = 0 THEN BMX.PALUSED = 256
    BMX.PALFIRST = PEEK(BMX.PTR + 11)
    BMX.DATAOFF = PEEK(BMX.PTR + 12) + PEEK(BMX.PTR + 13) * 256
    BMX.PACKED = PEEK(BMX.PTR + 14)

    BMX.BAD = 0
    IF PEEK(BMX.PTR) <> 66     THEN BMX.BAD = 1
    IF PEEK(BMX.PTR + 1) <> 77 THEN BMX.BAD = 1
    IF PEEK(BMX.PTR + 2) <> 88 THEN BMX.BAD = 1
    IF BMX.BAD = 1 THEN BMX.ERROR$ = BMX.FILE$ + " IS NOT A BMX FILE"
    IF BMX.BAD = 1 THEN RETURN

    IF BMX.VERSION <> 1 THEN BMX.ERROR$ = "BMX VERSION" + STR$(BMX.VERSION) + " IS NOT SUPPORTED"
    IF BMX.ERROR$ <> "" THEN RETURN

## ---- Bit depth is a SPARSE selector -- 1, 2, 4, 8 and nothing else --
## ---- which is what GP.SELECT is for. ON x GOSUB cannot index it. The 8
## ---- case is deliberately empty: a match falls straight out of the
## ---- select, which is exactly what "this one is fine" should cost.

    GP.SELECT BMX.DEPTH
        GP.CASE 8
        GP.CASE 1, 2, 4
            BMX.ERROR$ = STR$(BMX.DEPTH) + " BIT IMAGES NEED ANOTHER SCREEN MODE"
        GP.ELSE
            BMX.ERROR$ = "BAD BIT DEPTH IN THE HEADER"
    GP.ENDSEL
    IF BMX.ERROR$ <> "" THEN RETURN

    IF BMX.PACKED <> 0 THEN BMX.ERROR$ = "LZSA COMPRESSED FILES ARE NOT SUPPORTED"
    RETURN

## ***********************************************************************
## **  BMX.SPLIT -- a 17 bit VRAM (or 16 bit RAM) address into bytes.
## **
## **    in  BMX.ADDR    out  BMX.LO  BMX.HI  BMX.BANK
## **
## **  Arithmetic, not AND: AND is 16 bit SIGNED in GPC, so a VRAM address
## **  above 32767 -- which every screen row past the top eighth is --
## **  raises OUT OF RANGE rather than masking.
## ***********************************************************************

BMX.SPLIT:
    BMX.BANK = INT(BMX.ADDR / 65536) : BMX.REST = BMX.ADDR - BMX.BANK * 65536
    BMX.HI = INT(BMX.REST / 256) : BMX.LO = BMX.REST - BMX.HI * 256
    RETURN

## ---- Point VERA data port 0 at BMX.ADDR, stepping by one. The high byte
## ---- carries the increment in its top nibble, so 16 is "add 1 per byte"
## ---- and the bank bit rides in bit 0.

BMX.VERA:
    GOSUB BMX.SPLIT
    POKE BMXK.VCTRL, 0
    POKE BMXK.VLO, BMX.LO
    POKE BMXK.VMID, BMX.HI
    POKE BMXK.VHI, BMX.BANK + 16
    RETURN

## ***********************************************************************
## **  BMX.STREAM -- BMX.COUNT bytes from the channel into VERA.
## **
## **  Carry SET on the GP.CALL is the point: MACPTR then leaves its target
## **  address alone, so every byte lands on the same data port and VERA
## **  does the stepping.
## **
## **  A zero length transfer means the file ran out. Without that test the
## **  loop would spin for ever on a truncated file.
## ***********************************************************************

BMX.STREAM:
    BMX.GOT = 0
BMX.STREAM.MORE:
    BMX.CHUNK = BMX.COUNT - BMX.GOT
    IF BMX.CHUNK > 255 THEN BMX.CHUNK = 255
    GP.CALL BMXK.MACPTR, BMX.CHUNK, BMXK.PORTLO, BMXK.PORTHI, 1
    BMX.STEP = GP.X + GP.Y * 256
    IF BMX.STEP = 0 THEN BMX.ERROR$ = BMX.FILE$ + " ENDED EARLY"
    IF BMX.ERROR$ <> "" THEN RETURN
    BMX.GOT = BMX.GOT + BMX.STEP
    IF BMX.GOT < BMX.COUNT THEN GOTO BMX.STREAM.MORE
    RETURN

## ---- Throw away BMX.SKIP bytes. Carry CLEAR this time, so MACPTR walks
## ---- the scratch string's storage rather than hammering one address.

BMX.DISCARD:
    BMX.ADDR = BMX.SCRATCH
    GOSUB BMX.SPLIT
BMX.DISCARD.MORE:
    BMX.CHUNK = BMX.SKIP
    IF BMX.CHUNK > 255 THEN BMX.CHUNK = 255
    GP.CALL BMXK.MACPTR, BMX.CHUNK, BMX.LO, BMX.HI, 0
    BMX.STEP = GP.X + GP.Y * 256
    IF BMX.STEP = 0 THEN RETURN
    BMX.SKIP = BMX.SKIP - BMX.STEP
    IF BMX.SKIP > 0 THEN GOTO BMX.DISCARD.MORE
    RETURN

BMX.MODULE.END:
#ENDIF
