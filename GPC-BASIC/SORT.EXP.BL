## ***********************************************************************
## **
## **  SORT.EXP.BL -- the regression test for SORT.INC.BL.
## **
## **  Run it and read the last two lines: "FAILS 0" and "DONE". Anything
## **  else names the case that broke.
## **
## **  HOW TO READ IT. A BASL subroutine takes no arguments, so every helper reads named
## **  variables the caller sets first, and each case is the same three steps:
## **
## **      GOSUB T.LOAD.WORDS         <- put known, UNSORTED data in
## **      ... sort it ...
## **      GOSUB T.CHECK.WORDS        <- assert what came out
## **
## **  T.LOAD.WORDS EXISTS BECAUSE THE SORT IS IN PLACE: cases 1, 2 and 3 all sort
## **  T.WORD$, so without reloading, case 2 would be sorting case 1's answer. It also
## **  checksums the words on the way in, and T.CHECK.WORDS checksums them again --
## **  because ORDER ALONE IS NOT ENOUGH. A sort that reads the wrong element leaves the
## **  array beautifully ordered with one string twice and another gone. The checksum is
## **  position weighted, so a swapped pair differs from an unswapped one.
## **
## **  THE VARIABLES:
## **
## **      T.SOURCE$()    the twenty words, never modified -- the master
## **      T.WORD$()      the working copy, which is what gets sorted
## **      T.SUM.BEFORE   checksum of T.WORD$ as loaded
## **      T.SUM.AFTER    checksum of T.WORD$ after sorting
## **      T.ORDER        0 ascending, 1 descending  (set before T.CHECK.WORDS)
## **      T.FOLD         0 case sensitive, 1 case blind
## **      T.BAD          how many things were wrong in the case just run
## **      T.CASE$        its name, for the PASS/FAIL line
## **      T.FAILS        how many cases have failed so far
## **
## **  THE ANSWERS ARE NOT WRITTEN OUT, because shell sort is not stable: which of two
## **  EQUAL keys lands first is not a promise the module makes and must not be a test.
## **  Order is checked with BASIC's own comparisons, and the folded pass with GP.COMP.
## **  The first run of this file used GP.SORT itself as the oracle, keyword against
## **  module, and every case matched before the keyword was deleted.
## **
## **  Build:  copy GPB.INC.BL, SORT.INC.BL and this file into testing/,
## **          then
## **            python source/gpc/build_basl.py SORT.EXP.BL SORT.PRG
## **          and compile SORT.PRG with GPC.BIN.
## **
## ***********************************************************************
#SAVEAS "@:SORT.PRG"
#SYMFILE "@:SORT.SYM"
#INCLUDE "GPB.INC.BL"
#INCLUDE "SORT.INC.BL"

T.FAILS = 0

DIM T.SOURCE$(19) : DIM T.WORD$(19)
DIM T.BIG$(199)

## ---- Mixed case on purpose: cases 1 and 2 are case SENSITIVE, so every lower case word
## ---- must sort after every upper case one, and case 3 proves folding changes that.
T.SOURCE$(0) = "PEAR"   : T.SOURCE$(1) = "APPLE"  : T.SOURCE$(2) = "FIG"
T.SOURCE$(3) = "DATE"   : T.SOURCE$(4) = "plum"   : T.SOURCE$(5) = "CHERRY"
T.SOURCE$(6) = "apple"  : T.SOURCE$(7) = "KIWI"   : T.SOURCE$(8) = "LIME"
T.SOURCE$(9) = "MANGO"  : T.SOURCE$(10) = "OLIVE" : T.SOURCE$(11) = "PEACH"
T.SOURCE$(12) = "grape" : T.SOURCE$(13) = "LEMON" : T.SOURCE$(14) = "BERRY"
T.SOURCE$(15) = "MELON" : T.SOURCE$(16) = "NUT"   : T.SOURCE$(17) = "OAT"
T.SOURCE$(18) = "RICE"  : T.SOURCE$(19) = "ZERO"

## =======================================================================
## 1. ASCENDING, case sensitive.
## =======================================================================
GOSUB T.LOAD.WORDS
SORT.PTR = GP.ARRPTR(T.WORD$()) : SORT.DESCEND = 0 : SORT.NOCASE = 0
GOSUB SORT.RUN
PRINT "OK "; SORT.OK; " COUNT "; SORT.COUNT
T.CASE$ = "ASCENDING" : T.ORDER = 0 : T.FOLD = 0
GOSUB T.CHECK.WORDS

## =======================================================================
## 2. DESCENDING. Same array, which is why case 1 does not leak into it.
## =======================================================================
GOSUB T.LOAD.WORDS
SORT.PTR = GP.ARRPTR(T.WORD$()) : SORT.DESCEND = 1 : SORT.NOCASE = 0
GOSUB SORT.RUN
T.CASE$ = "DESCENDING" : T.ORDER = 1 : T.FOLD = 0
GOSUB T.CHECK.WORDS

## =======================================================================
## 3. CASE FOLDED, ascending. Checked with GP.COMP, which is the same
##    case-blind comparison the assembly does character by character.
## =======================================================================
GOSUB T.LOAD.WORDS
SORT.PTR = GP.ARRPTR(T.WORD$()) : SORT.DESCEND = 0 : SORT.NOCASE = 1
GOSUB SORT.RUN
T.CASE$ = "CASE FOLDED" : T.ORDER = 0 : T.FOLD = 1
GOSUB T.CHECK.WORDS

## =======================================================================
## 4. EMPTIES. Four of twenty are assigned; the other sixteen are null pointers, which
##    the sort must read as "" and put at the front rather than follow to whatever lives
##    at address 2. Its own array, because the point is elements NEVER written.
## =======================================================================
DIM T.SPARSE$(19)
T.SPARSE$(3) = "ZULU" : T.SPARSE$(9) = "ALPHA"
T.SPARSE$(0) = "MIKE" : T.SPARSE$(19) = "BRAVO"
SORT.PTR = GP.ARRPTR(T.SPARSE$()) : SORT.DESCEND = 0 : SORT.NOCASE = 0
GOSUB SORT.RUN
T.BAD = 0
FOR T.I = 0 TO 15
    IF T.SPARSE$(T.I) <> "" THEN T.BAD = T.BAD + 1
NEXT T.I
IF T.SPARSE$(16) <> "ALPHA" THEN T.BAD = T.BAD + 1
IF T.SPARSE$(17) <> "BRAVO" THEN T.BAD = T.BAD + 1
IF T.SPARSE$(18) <> "MIKE" THEN T.BAD = T.BAD + 1
IF T.SPARSE$(19) <> "ZULU" THEN T.BAD = T.BAD + 1
T.CASE$ = "EMPTIES" : GOSUB T.REPORT

## =======================================================================
## 5. TWO HUNDRED ELEMENTS. THIS IS THE ONE THAT MATTERS MOST: element 128 is where the
##    doubled index stops fitting in a byte, and an address routine that drops that carry
##    reads every element from there on 256 bytes low. Twenty words would never find it.
##    The keys are generated so their order is not one the fill could have left behind.
## =======================================================================
T.SEED = 1 : T.SUM.BEFORE = 0
FOR T.I = 0 TO 199
    T.SEED = T.SEED * 37 + 11
    T.SEED = T.SEED - INT(T.SEED / 251) * 251
    T.KEY$ = CHR$(65 + T.SEED - INT(T.SEED / 26) * 26)
    T.KEY$ = T.KEY$ + CHR$(65 + INT(T.SEED / 26) - INT(T.SEED / 234) * 9)
    T.KEY$ = T.KEY$ + RIGHT$("000" + STR$(T.I), 3)
    T.BIG$(T.I) = T.KEY$
    T.TEXT$ = T.KEY$ : GOSUB T.CHECKSUM : T.SUM.BEFORE = T.SUM.BEFORE + T.SUM
NEXT T.I

SORT.PTR = GP.ARRPTR(T.BIG$()) : SORT.DESCEND = 0 : SORT.NOCASE = 0
GOSUB SORT.RUN
PRINT "BIG OK "; SORT.OK; " COUNT "; SORT.COUNT

T.SUM.AFTER = 0
FOR T.I = 0 TO 199
    T.TEXT$ = T.BIG$(T.I) : GOSUB T.CHECKSUM : T.SUM.AFTER = T.SUM.AFTER + T.SUM
NEXT T.I
T.BAD = 0
FOR T.I = 1 TO 199
    IF T.BIG$(T.I - 1) > T.BIG$(T.I) THEN T.BAD = T.BAD + 1
NEXT T.I
IF T.SUM.BEFORE <> T.SUM.AFTER THEN T.BAD = T.BAD + 1000
T.CASE$ = "200 ELEMENTS" : GOSUB T.REPORT
PRINT "  FIRST "; T.BIG$(0); " AT128 "; T.BIG$(128); " LAST "; T.BIG$(199)
PRINT "  SUM BEFORE "; T.SUM.BEFORE; " AFTER "; T.SUM.AFTER

## =======================================================================
## 6. TWO ELEMENTS, and ONE. The smallest arrays the gap loop can see --
##    with one element it returns before the first pass.
## =======================================================================
DIM T.PAIR$(1)
T.PAIR$(0) = "BETA" : T.PAIR$(1) = "ALPHA"
SORT.PTR = GP.ARRPTR(T.PAIR$()) : SORT.DESCEND = 0 : SORT.NOCASE = 0
GOSUB SORT.RUN
T.BAD = 0
IF T.PAIR$(0) <> "ALPHA" THEN T.BAD = T.BAD + 1
IF T.PAIR$(1) <> "BETA" THEN T.BAD = T.BAD + 1
T.CASE$ = "TWO ELEMENTS" : GOSUB T.REPORT

DIM T.ONE$(0)
T.ONE$(0) = "SOLO"
SORT.PTR = GP.ARRPTR(T.ONE$()) : GOSUB SORT.RUN
T.BAD = 0
IF T.ONE$(0) <> "SOLO" THEN T.BAD = T.BAD + 1
IF SORT.OK <> 1 THEN T.BAD = T.BAD + 1
T.CASE$ = "ONE ELEMENT" : GOSUB T.REPORT

## =======================================================================
## 7. A FLOAT ARRAY IS REFUSED, rather than sorted as if its six byte
##    elements were 2 byte pointers. SORT.OK = 0 is the whole assertion.
## =======================================================================
DIM T.NUMBER(9)
T.NUMBER(0) = 5
SORT.PTR = GP.ARRPTR(T.NUMBER()) : GOSUB SORT.RUN
T.BAD = 0
IF SORT.OK <> 0 THEN T.BAD = T.BAD + 1
T.CASE$ = "NOT A STRING ARRAY" : GOSUB T.REPORT

PRINT "FAILS "; T.FAILS
PRINT "DONE"
END

## ***********************************************************************
## **  T.LOAD.WORDS -- the twenty words into T.WORD$, UNSORTED, and their checksum into
## **  T.SUM.BEFORE. Call it before every case that sorts T.WORD$.
## ***********************************************************************

T.LOAD.WORDS:
    T.SUM.BEFORE = 0
    FOR T.I = 0 TO 19
        T.WORD$(T.I) = T.SOURCE$(T.I)
        T.TEXT$ = T.SOURCE$(T.I) : GOSUB T.CHECKSUM
        T.SUM.BEFORE = T.SUM.BEFORE + T.SUM
    NEXT T.I
    RETURN

## ***********************************************************************
## **  T.CHECK.WORDS -- assert T.WORD$ is in order AND still holds the
## **  same twenty words.
## **
## **   in   T.ORDER   0 wanted ascending, 1 wanted descending
## **        T.FOLD    1 to compare case-blind, with GP.COMP
## **        T.CASE$   the name to print
## ***********************************************************************

T.CHECK.WORDS:
    T.BAD = 0
    FOR T.I = 1 TO 19
        IF T.FOLD = 1 THEN GOSUB T.CHECK.FOLDED
        IF T.FOLD = 0 AND T.ORDER = 0 THEN IF T.WORD$(T.I - 1) > T.WORD$(T.I) THEN T.BAD = T.BAD + 1
        IF T.FOLD = 0 AND T.ORDER = 1 THEN IF T.WORD$(T.I - 1) < T.WORD$(T.I) THEN T.BAD = T.BAD + 1
    NEXT T.I

## ---- and that it is still the same twenty words, not nineteen and a
## ---- duplicate. See the header: order alone would not notice.
    T.SUM.AFTER = 0
    FOR T.I = 0 TO 19
        T.TEXT$ = T.WORD$(T.I) : GOSUB T.CHECKSUM
        T.SUM.AFTER = T.SUM.AFTER + T.SUM
    NEXT T.I
    IF T.SUM.BEFORE <> T.SUM.AFTER THEN T.BAD = T.BAD + 1000

    GOSUB T.REPORT
    PRINT "  ["; T.WORD$(0); "]["; T.WORD$(1); "]["; T.WORD$(18); "]["; T.WORD$(19); "]"
    RETURN

## ---- one folded comparison, split out only because the line above it
## ---- would otherwise carry three nested IFs
T.CHECK.FOLDED:
    IF GP.COMP(T.WORD$(T.I - 1), T.WORD$(T.I)) > 0 THEN T.BAD = T.BAD + 1
    RETURN

## ***********************************************************************
## **  T.REPORT -- one PASS or FAIL line.
## **   in   T.BAD    0 = passed;  T.CASE$  the name
## ***********************************************************************

T.REPORT:
    IF T.BAD = 0 THEN PRINT "PASS "; T.CASE$
    IF T.BAD <> 0 THEN PRINT "FAIL "; T.CASE$; " BAD "; T.BAD : T.FAILS = T.FAILS + 1
    RETURN

## ***********************************************************************
## **  T.CHECKSUM -- T.TEXT$ in, T.SUM out.
## **
## **  Position weighted, so "AB" and "BA" differ -- a plain sum of the codes would not,
## **  and two elements swapped is exactly the damage this is here to catch.
## ***********************************************************************

T.CHECKSUM:
    T.SUM = LEN(T.TEXT$) * 7
    IF LEN(T.TEXT$) < 1 THEN RETURN
    FOR T.CI = 1 TO LEN(T.TEXT$)
        T.SUM = T.SUM + ASC(MID$(T.TEXT$, T.CI, 1)) * T.CI
    NEXT T.CI
    RETURN
