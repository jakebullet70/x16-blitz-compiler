## ***********************************************************************
## **
## **  THEME.INC.BL -- named colour roles, in five themes.
## **
## **  The colours are an array, read by BASIC for COLOR and the GP drawing
## **  commands, so they save and load like any other.
## **
## **      THEME.ID   0 X16       blue page, white text -- the default
## **                  1 DARK      black page, light grey text
## **                  2 LIGHT     white page, black text
## **                  3 GRAY      dark grey page, light blue frames
## **                  4 CUSTOM    whatever THEME.CLR already holds
## **
## **  THEME.NEXT cycles to the following one and loads it, which is what a
## **  program binds to a key. THEME.RESET reloads the one already selected.
## **
## **  CUSTOM loads nothing, leaving THEME.CLR as it stands, so a program that lets
## **  the user change colours carries those changes into it. Selected before any
## **  other theme it takes X16's values.
## **
## **  Usage:
## **      THEME.ID = 1 : GOSUB THEME.SELECT
## **      GP.BOX 4,2,30,8, 2, THEME.CLR(THEME.BORDER)
## **      GP.PRINTAT 6,3, "TITLE", THEME.CLR(THEME.TITLE)
## **
## **  The values are packed attributes, background * 16 + foreground, as the GP
## **  drawing commands take them. For COLOR, which wants the halves separately,
## **  use THEME.SET.
## **
## ***********************************************************************
#IFNDEF THEME.DEFS
#DEFINE THEME.DEFS 1

## The roles. Add one here and to ALL FIVE palettes below, and raise SLOTS.
##
## FOCUS IS NOT HILITE, and it exists because it could not be. HILITE is the
## text colour reversed in three of the four palettes, and a GUI button is drawn
## as the panel reversed, so a focused button came out identical to a plain one.
## FOCUS is yellow-backed in every theme for that reason: whatever a palette
## does, nothing else in it is yellow.

#DEFINE THEME.PAGE 0
#DEFINE THEME.TEXT 1
#DEFINE THEME.TITLE 2
#DEFINE THEME.BORDER 3
#DEFINE THEME.HILITE 4
#DEFINE THEME.DIMMED 5
#DEFINE THEME.WARN 6
#DEFINE THEME.FOCUS 7
#DEFINE THEME.SLOTS 8

## How many themes THEME.NEXT cycles through.
#DEFINE THEME.COUNT 5

## X16 palette indices, for reading the tables below.
##   0 black    1 white   2 red     3 cyan     4 purple  5 green
##   6 blue     7 yellow  8 orange  9 brown   10 pink   11 dk grey
##  12 md grey 13 lt green 14 lt blue 15 lt grey

GOTO THEME.SKIP

## THEME.SELECT -- fill THEME.CLR from THEME.ID.
##
## THEME.CLR is DIMmed here, because DIMming an array GPC has already auto-dimensioned
## is an error. No DATA statement, because READ walks every DATA in the whole program
## in order and a library owning one would derail the caller's READs.

THEME.SELECT.BODY:
    THEME.FIRST = 0
    IF THEME.READY = 0 THEN DIM THEME.CLR(THEME.SLOTS) : THEME.READY = -1 : THEME.FIRST = -1
    IF THEME.ID = 1 THEN GOTO THEME.SELECT.DARK
    IF THEME.ID = 2 THEN GOTO THEME.SELECT.LIGHT
    IF THEME.ID = 3 THEN GOTO THEME.SELECT.GRAY
    IF THEME.ID = 4 THEN GOTO THEME.SELECT.CUSTOM

THEME.SELECT.X16:
    THEME.CLR(THEME.PAGE)   = 6 * 16 + 6
    THEME.CLR(THEME.TEXT)   = 6 * 16 + 1
    THEME.CLR(THEME.TITLE)  = 6 * 16 + 3
    THEME.CLR(THEME.BORDER) = 6 * 16 + 14
    THEME.CLR(THEME.HILITE) = 1 * 16 + 6
    THEME.CLR(THEME.DIMMED) = 6 * 16 + 12
    THEME.CLR(THEME.WARN)   = 6 * 16 + 13
    THEME.CLR(THEME.FOCUS)  = 7 * 16 + 6
    RETURN

THEME.SELECT.DARK:
    THEME.CLR(THEME.PAGE)   = 0 * 16 + 0
    THEME.CLR(THEME.TEXT)   = 0 * 16 + 15
    THEME.CLR(THEME.TITLE)  = 0 * 16 + 1
    THEME.CLR(THEME.BORDER) = 0 * 16 + 11
    THEME.CLR(THEME.HILITE) = 15 * 16 + 0
    THEME.CLR(THEME.DIMMED) = 0 * 16 + 12
    THEME.CLR(THEME.WARN)   = 0 * 16 + 8
    THEME.CLR(THEME.FOCUS)  = 7 * 16 + 0
    RETURN

## A white page. DIMMED is mid grey rather than dark grey so that reversing it
## for a status bar still leaves the text readable on it.
THEME.SELECT.LIGHT:
    THEME.CLR(THEME.PAGE)   = 1 * 16 + 1
    THEME.CLR(THEME.TEXT)   = 1 * 16 + 0
    THEME.CLR(THEME.TITLE)  = 1 * 16 + 6
    THEME.CLR(THEME.BORDER) = 1 * 16 + 11
    THEME.CLR(THEME.HILITE) = 0 * 16 + 1
    THEME.CLR(THEME.DIMMED) = 1 * 16 + 12
    THEME.CLR(THEME.WARN)   = 1 * 16 + 2
    THEME.CLR(THEME.FOCUS)  = 7 * 16 + 0
    RETURN

## From the XFMGR file manager's theme module. DIMMED and WARN are not in it.
##
## WARN IS LIGHT RED, NOT RED. This is the only theme with a dark grey page, and
## plain red on it is barely legible -- which shows up on the BAR, where WARN is
## what tints the hotkey letter, before it shows up on any warning.
THEME.SELECT.GRAY:
    THEME.CLR(THEME.PAGE)   = 11 * 16 + 11
    THEME.CLR(THEME.TEXT)   = 11 * 16 + 1
    THEME.CLR(THEME.TITLE)  = 11 * 16 + 7
    THEME.CLR(THEME.BORDER) = 11 * 16 + 14
    THEME.CLR(THEME.HILITE) = 14 * 16 + 1
    THEME.CLR(THEME.DIMMED) = 11 * 16 + 12
    THEME.CLR(THEME.WARN)   = 11 * 16 + 10
    THEME.CLR(THEME.FOCUS)  = 7 * 16 + 11
    RETURN

## THEME.FIRST is set only when THEME.SELECT created the array, the one case with
## nothing to keep.
THEME.SELECT.CUSTOM:  IF THEME.FIRST = 0 THEN RETURN
    GOTO THEME.SELECT.X16

## THEME.NEXT -- the following theme, selected. It GOTOs THEME.SELECT rather than
## GOSUBing it, so THEME.SELECT's RETURN is the one the caller gets.
THEME.NEXT:  THEME.ID = THEME.ID + 1 : IF THEME.ID >= THEME.COUNT THEN THEME.ID = 0
    GOTO THEME.SELECT

## THEME.RESET -- the selected theme's shipped values, throwing away any changes.
## CUSTOM has none of its own, so it resets to X16.
THEME.RESET:  IF THEME.ID = 4 THEN GOTO THEME.SELECT.X16
    GOTO THEME.SELECT

## THEME.SET -- make THEME.ATTR the colour PRINT uses.
##
##   in   THEME.ATTR   a packed attribute, e.g. THEME.CLR(THEME.TEXT)
##
## WARNING: AND 15 is safe only because a packed attribute is 0..255. AND is 16-bit
## signed and raises OUT OF RANGE above 32767.

THEME.SET:  COLOR THEME.ATTR AND 15, INT(THEME.ATTR / 16) : RETURN

## THEME.HI -- the inverse of a packed attribute, for pre-drawing a row that should
## already look selected.
##
##   in   THEME.ATTR   packed attribute      out  THEME.INV

THEME.HI:  THEME.INV = (THEME.ATTR AND 15) * 16 + INT(THEME.ATTR / 16) : RETURN

THEME.SKIP:
#ENDIF
