## ***********************************************************************
## **
## **  THEME.INC.BL -- named colour roles, light and dark.
## **
## **  A theme costs NO KEYWORDS AND NO RUNTIME BYTES. The colours are read by BASIC, for
## **  COLOR and the GP drawing commands -- assembly never touches them -- so a runtime
## **  version would have bought nothing and spent two keyword slots. As data they also save
## **  and load like any array, so "switch to dark" is reloading one.
## **
## **  #DEFINE substitutes at TRANSLATION time, so THEME.CLR(THEME.TITLE) compiles to
## **  THEME.CLR(2): no variable, no lookup, and a one-byte constant index.
## **
## **  Usage:
## **      THEME.DARK = 1 : GOSUB THEME.LOAD
## **      GP.BOX 4,2,30,8, 2, THEME.CLR(THEME.BORDER)
## **      GP.PRINTAT 6,3, "TITLE", THEME.CLR(THEME.TITLE)
## **
## **  THE VALUES ARE PACKED ATTRIBUTES -- background * 16 + foreground -- which is what
## **  the GP drawing commands take and what the KERNAL keeps at $0376. For COLOR, which
## **  wants the halves separately, use THEME.SET.
## **
## ***********************************************************************
#IFNDEF THEME.DEFS
#DEFINE THEME.DEFS 1

## The roles. Add one here and to BOTH palettes below, and raise SLOTS.

#DEFINE THEME.PAGE 0
#DEFINE THEME.TEXT 1
#DEFINE THEME.TITLE 2
#DEFINE THEME.BORDER 3
#DEFINE THEME.HILITE 4
#DEFINE THEME.DIMMED 5
#DEFINE THEME.WARN 6
#DEFINE THEME.SLOTS 7

## X16 palette indices, for reading the tables below.
##   0 black    1 white   2 red     3 cyan     4 purple  5 green
##   6 blue     7 yellow  8 orange  9 brown   10 pink   11 dk grey
##  12 md grey 13 lt green 14 lt blue 15 lt grey

GOTO THEME.SKIP

## THEME.LOAD -- fill THEME.CLR from THEME.DARK (0 light, non-zero dark).
##
## THEME.CLR is DIMmed here rather than left implicit: an implicit array is 0..10 and
## DIMming one GPC already auto-dimensioned is an error, so the module owns it outright.
##
## NO DATA STATEMENT, on purpose: READ walks every DATA in the whole program in order,
## so a library owning one would silently derail the caller's own READs.

THEME.LOAD:
    IF THEME.READY = 0 THEN DIM THEME.CLR(THEME.SLOTS) : THEME.READY = 1
    IF THEME.DARK <> 0 THEN GOTO THEME.LOAD.DARK

    THEME.CLR(THEME.PAGE)   = 6 * 16 + 6
    THEME.CLR(THEME.TEXT)   = 6 * 16 + 1
    THEME.CLR(THEME.TITLE)  = 6 * 16 + 7
    THEME.CLR(THEME.BORDER) = 6 * 16 + 14
    THEME.CLR(THEME.HILITE) = 1 * 16 + 6
    THEME.CLR(THEME.DIMMED) = 6 * 16 + 12
    THEME.CLR(THEME.WARN)   = 6 * 16 + 2
    RETURN

THEME.LOAD.DARK:
    THEME.CLR(THEME.PAGE)   = 0 * 16 + 0
    THEME.CLR(THEME.TEXT)   = 0 * 16 + 15
    THEME.CLR(THEME.TITLE)  = 0 * 16 + 1
    THEME.CLR(THEME.BORDER) = 0 * 16 + 11
    THEME.CLR(THEME.HILITE) = 15 * 16 + 0
    THEME.CLR(THEME.DIMMED) = 0 * 16 + 12
    THEME.CLR(THEME.WARN)   = 0 * 16 + 8
    RETURN

## THEME.SET -- make THEME.ATTR the colour PRINT uses.
##
##   in   THEME.ATTR   a packed attribute, e.g. THEME.CLR(THEME.TEXT)
##
## Splits it for COLOR, which takes the two halves separately. AND 15 is safe ONLY
## because a packed attribute is 0..255: AND is 16-bit SIGNED in GPC and raises OUT OF
## RANGE above 32767.

THEME.SET:
    COLOR THEME.ATTR AND 15, INT(THEME.ATTR / 16)
    RETURN

## THEME.HI -- the inverse of a packed attribute, for pre-drawing a row that should
## already look selected.
##
##   in   THEME.ATTR   packed attribute      out  THEME.INV

THEME.HI:
    THEME.INV = (THEME.ATTR AND 15) * 16 + INT(THEME.ATTR / 16)
    RETURN

THEME.SKIP:
#ENDIF
