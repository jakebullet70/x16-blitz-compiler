## MENUDEMO -- MENUHELP drawn the way an application would draw it.
##
## Cursor keys move, RETURN chooses, N L O C Q are hotkeys, ESC cancels,
## and the SNES pad in port 1 drives it too. KEEPMARK leaves the chosen row
## highlighted after it returns.
#INCLUDE "GPB.INC.BL"
#INCLUDE "THEME.INC.BL"
#INCLUDE "MENUHELP.INC.BL"
#SAVEAS "@:MENUDEMO.PRG"

#DEFINE MENU.LEFT 8
#DEFINE MENU.TOP 6
#DEFINE MENU.WIDE 24
#DEFINE MENU.COUNT 5

THEME.DARK = 0
GOSUB THEME.LOAD

DIM MENUHELP.ITEM$(MENU.COUNT)
MENUHELP.ITEM$(1) = " NEW GAME"
MENUHELP.ITEM$(2) = " LOAD"
MENUHELP.ITEM$(3) = " OPTIONS"
MENUHELP.ITEM$(4) = " CREDITS"
MENUHELP.ITEM$(5) = " QUIT"

## ---- The page, the title bar and the frame. None of this is the menu's
## ---- business: MENUHELP draws ROWS, so the border is GP.BOX and the
## ---- application keeps its own look.

GP.FILL 0, 0, 80, 30, ASC(" "), THEME.CLR(THEME.PAGE)
GP.FILL 0, 0, 80, 1, ASC(" "), THEME.CLR(THEME.TITLE)
GP.PRINTAT 2, 0, "GP.BASIC DEMONSTRATION", THEME.CLR(THEME.TITLE)
GP.BOX MENU.LEFT - 1, MENU.TOP - 1, MENU.WIDE + 2, MENU.COUNT + 2, 2, THEME.CLR(THEME.BORDER)
GP.PRINTAT 2, 20, "CURSOR KEYS, RETURN, OR N L O C Q", THEME.CLR(THEME.DIMMED)

MENUHELP.X = MENU.LEFT : MENUHELP.Y = MENU.TOP
MENUHELP.WIDTH = MENU.WIDE : MENUHELP.COUNT = MENU.COUNT
MENUHELP.ATTR = THEME.CLR(THEME.TEXT)
MENUHELP.HIATTR = THEME.CLR(THEME.HILITE)
MENUHELP.HOT$ = "NLOCQ"
MENUHELP.FLAGS = MENUHELP.KEEPMARK + MENUHELP.GAMEPAD
MENUHELP.SEL = 1

GOSUB MENUHELP.RUN

GP.PRINTAT 2, 22, "CHOSE" + MENUHELP.ITEM$(MENUHELP.SEL), THEME.CLR(THEME.WARN)
END
