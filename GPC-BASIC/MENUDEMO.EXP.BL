## MENUDEMO -- MENUVERT drawn the way an application would draw it.
##
## Cursor keys move, RETURN chooses, N L O C Q are hotkeys, ESC cancels,
## and the SNES pad in port 1 drives it too. KEEPMARK leaves the chosen row
## highlighted after it returns.
#INCLUDE "GPB.INC.BL"
## THE LOW MEMORY FORM OF THE LIBRARY. Every module below has a banked twin
## named XXX.BANK.INC.BL, whose entry points are .BODY labels reached through
## the shims in SHIM.GUIBANK.INC.BL. One form or the other, never both --
## BANKED-OR-NOT.md says how to choose.
#INCLUDE "THEME.INC.BL"
#INCLUDE "MENUVERT.INC.BL"
#SAVEAS "@:MENUDEMO.PRG"

#DEFINE MENU.LEFT 8
#DEFINE MENU.TOP 6
#DEFINE MENU.WIDE 24
#DEFINE MENU.COUNT 5

THEME.ID = 0
GOSUB THEME.SELECT

DIM MENUVERT.ITEM$(MENU.COUNT)
MENUVERT.ITEM$(1) = " NEW GAME"
MENUVERT.ITEM$(2) = " LOAD"
MENUVERT.ITEM$(3) = " OPTIONS"
MENUVERT.ITEM$(4) = " CREDITS"
MENUVERT.ITEM$(5) = " QUIT"

## ---- The page, the title bar and the frame. None of this is the menu's
## ---- business: MENUVERT draws ROWS, so the border is GP.BOX and the
## ---- application keeps its own look.

GP.FILL 0, 0, 80, 30, ASC(" "), THEME.CLR(THEME.PAGE)
GP.FILL 0, 0, 80, 1, ASC(" "), THEME.CLR(THEME.TITLE)
GP.PRINTAT 2, 0, "GP.BASIC DEMONSTRATION", THEME.CLR(THEME.TITLE)
GP.BOX MENU.LEFT - 1, MENU.TOP - 1, MENU.WIDE + 2, MENU.COUNT + 2, 1, THEME.CLR(THEME.BORDER)
GP.PRINTAT 2, 20, "CURSOR KEYS, RETURN, OR N L O C Q", THEME.CLR(THEME.DIMMED)

MENUVERT.X = MENU.LEFT : MENUVERT.Y = MENU.TOP
MENUVERT.WIDTH = MENU.WIDE : MENUVERT.COUNT = MENU.COUNT
MENUVERT.ATTR = THEME.CLR(THEME.TEXT)
MENUVERT.HIATTR = THEME.CLR(THEME.HILITE)
MENUVERT.HOT$ = "NLOCQ"
MENUVERT.FLAGS = MENUVERT.KEEPMARK + MENUVERT.GAMEPAD
MENUVERT.SEL = 1

GOSUB MENUVERT.RUN

GP.PRINTAT 2, 22, "CHOSE" + MENUVERT.ITEM$(MENUVERT.SEL), THEME.CLR(THEME.WARN)
END
