## GUI.INC.BL -- dialog and form engine behind GUI-DIALOGS.INC.BL.
## Needs GPB, STASH, STASHVRAM, THEME, LINEINPUT before it; COMBO and CHECK after it.
## GUI.SAVEMODE% says where a box keeps the cells it covers: GUI.SAVE.VRAM, or 0, in
## STASHVRAM; GUI.SAVE.BANK in GUI.STASHSIZE% bytes at GUI.STASHADDR in bank GUI.BANK%.
## WARNING: upper case text only; charset 2 lands lower case on the graphics half.
#IFNDEF GUI.DEFS
#DEFINE GUI.DEFS 1

## KERNAL screen_mode; carry set reads mode, cols, rows
#DEFINE GUI.SCRMODE $FF5F
#DEFINE GUI.SAVE.VRAM 1
#DEFINE GUI.SAVE.BANK 2
## GP.BOX style 2: single line, rounded corners
#DEFINE GUI.LINEBOX 2
## air inside the frame
#DEFINE GUI.PADX 2
#DEFINE GUI.PADY 1
#DEFINE GUI.ESCAPE 27
#DEFINE GUI.STOP 3
#DEFINE GUI.RETURN 13
#DEFINE GUI.SPACE 32
## cells between two buttons
#DEFINE GUI.BTN.GAP 4
## controls per form, buttons included
#DEFINE GUI.FORM.MAX 32
## control types and flags
#DEFINE GUI.CT.BUTTON 1
#DEFINE GUI.CT.FIELD 2
#DEFINE GUI.CT.LIST 3
#DEFINE GUI.CT.COMBO 4
#DEFINE GUI.CT.CHECK 5
#DEFINE GUI.CT.RADIO 6
#DEFINE GUI.CT.VALUE 7
#DEFINE GUI.CF.DEFAULT 1
#DEFINE GUI.CF.NOFOCUS 2
#DEFINE GUI.CF.CHECKED 4
#DEFINE GUI.CF.MULTI 8
## item store: the count at GUI.ITEM.BASE, offset table entries 2 bytes on, the text after
#DEFINE GUI.ITEM.MAX 256
## verdicts a control returns to GUI.FORM.ACT
#DEFINE GUI.NAV.STAY 0
#DEFINE GUI.NAV.NEXT 1
#DEFINE GUI.NAV.PREV 2
#DEFINE GUI.NAV.PRESS 3
#DEFINE GUI.NAV.DEFAULT 4
#DEFINE GUI.NAV.CANCEL 5
## nav keys. GUI.K.* because GUI.LEFT% is a variable. SHTAB not probed on hardware
#DEFINE GUI.K.TAB 9
#DEFINE GUI.K.SHTAB 24
#DEFINE GUI.K.DOWN 17
#DEFINE GUI.K.UP 145
#DEFINE GUI.K.RIGHT 29
#DEFINE GUI.K.LEFT 157

GOTO GUI.MODULE.END

## GUI.BUTTON -- draw "< label >"; "&" lights the next letter
## in GUI.BTN.TEXT$ .X .Y .ATTR .HI .DEF    out GUI.BTN.KEY (0 = no letter)
GUI.BUTTON:
    GUI.BTN.KEY% = 0
    GUI.BTN.AMP% = GP.INSTR(GUI.BTN.TEXT$, "&")
    GP.IF GUI.BTN.AMP% = 0 THEN
        GP.PRINTAT GUI.BTN.X%, GUI.BTN.Y%, "< " + GUI.BTN.TEXT$ + " >", GUI.BTN.ATTR%
        GOSUB GUI.BTN.EDGES : RETURN
    GP.ENDIF
    GUI.BTN.HEAD$ = LEFT$(GUI.BTN.TEXT$, GUI.BTN.AMP% - 1)
    GUI.BTN.MARK$ = MID$(GUI.BTN.TEXT$, GUI.BTN.AMP% + 1, 1)
    GUI.BTN.TAIL$ = MID$(GUI.BTN.TEXT$, GUI.BTN.AMP% + 2)
    IF GUI.BTN.MARK$ <> "" THEN GUI.BTN.KEY% = ASC(GUI.BTN.MARK$)
    ## one attribute per GP.PRINTAT, so three prints
    GP.PRINTAT GUI.BTN.X%, GUI.BTN.Y%, "< " + GUI.BTN.HEAD$, GUI.BTN.ATTR%
    GUI.BTN.AT% = GUI.BTN.X% + 2 + LEN(GUI.BTN.HEAD$)
    IF GUI.BTN.MARK$ <> "" THEN GP.PRINTAT GUI.BTN.AT%, GUI.BTN.Y%, GUI.BTN.MARK$, GUI.BTN.HI%
    GP.PRINTAT GUI.BTN.AT% + LEN(GUI.BTN.MARK$), GUI.BTN.Y%, GUI.BTN.TAIL$ + " >", GUI.BTN.ATTR%
    GOSUB GUI.BTN.EDGES
    RETURN

## GUI.BTN.EDGES -- "<<" ">>" over the default button, same width
GUI.BTN.EDGES:
    IF GUI.BTN.DEF% = 0 THEN RETURN
    GUI.BTN.RIGHT% = GUI.BTN.X% + LEN(GUI.BTN.TEXT$) + 2
    IF GUI.BTN.AMP% > 0 THEN GUI.BTN.RIGHT% = GUI.BTN.RIGHT% - 1
    GP.PRINTAT GUI.BTN.X%, GUI.BTN.Y%, "<<", GUI.BTN.HI%
    GP.PRINTAT GUI.BTN.RIGHT%, GUI.BTN.Y%, ">>", GUI.BTN.HI%
    RETURN

## GUI.BTN.PAIR -- GUI.BTN.OF% to GUI.BTN.UC% and .LC; non-letters unchanged.
## A PETSCII shifted letter, 193 to 218, pairs with 65 to 90 as well.
GUI.BTN.PAIR:
    GUI.BTN.UC% = GUI.BTN.OF% : GUI.BTN.LC% = GUI.BTN.OF%
    IF GUI.BTN.OF% > 96 AND GUI.BTN.OF% < 123 THEN GUI.BTN.UC% = GUI.BTN.OF% - 32
    IF GUI.BTN.OF% > 64 AND GUI.BTN.OF% < 91 THEN GUI.BTN.LC% = GUI.BTN.OF% + 32
    IF GUI.BTN.OF% > 192 AND GUI.BTN.OF% < 219 THEN GUI.BTN.LC% = GUI.BTN.OF% - 128
    RETURN

## GUI.BUTTON.SIZE -- row width for GUI.BODY.WIDTH%, before GUI.OPEN
## The row is one, two or three buttons, and an empty label ends it, so a caller that wants
## two leaves GUI.BTN.THREE$ alone and nothing here changes for it.
## out GUI.BTN.TOTAL%  GUI.BTN.W.ONE%  GUI.BTN.W.TWO%  GUI.BTN.W.THREE%
GUI.BUTTON.SIZE:
    GUI.BTN.TEXT$ = GUI.BTN.ONE$ : GOSUB GUI.BUTTON.WIDE
    GUI.BTN.W.ONE% = GUI.BTN.WIDE% : GUI.BTN.W.TWO% = 0 : GUI.BTN.W.THREE% = 0
    GUI.BTN.TOTAL% = GUI.BTN.W.ONE% : IF GUI.BTN.TWO$ = "" THEN RETURN
    GUI.BTN.TEXT$ = GUI.BTN.TWO$ : GOSUB GUI.BUTTON.WIDE
    GUI.BTN.W.TWO% = GUI.BTN.WIDE% : GUI.BTN.TOTAL% = GUI.BTN.TOTAL% + GUI.BTN.GAP + GUI.BTN.W.TWO%
    IF GUI.BTN.THREE$ = "" THEN RETURN
    GUI.BTN.TEXT$ = GUI.BTN.THREE$ : GOSUB GUI.BUTTON.WIDE
    GUI.BTN.W.THREE% = GUI.BTN.WIDE% : GUI.BTN.TOTAL% = GUI.BTN.TOTAL% + GUI.BTN.GAP + GUI.BTN.W.THREE%
    RETURN

## label + 4, less 1 for the "&"
GUI.BUTTON.WIDE:
    GUI.BTN.WIDE% = LEN(GUI.BTN.TEXT$) + 4
    IF GP.INSTR(GUI.BTN.TEXT$, "&") > 0 THEN GUI.BTN.WIDE% = GUI.BTN.WIDE% - 1
    RETURN

## GUI.BUTTON.ROW -- draw the buttons centred on GUI.BTN.Y% and add them to the form
## One, two or three of them. GUI.DEFAULT% names the one that starts focused and answers
## RETURN, and is clamped here to the buttons that actually exist.
GUI.BUTTON.ROW:
    GUI.BTN.FOCUSED% = 0 : GOSUB GUI.BTN.COLOURS
    GUI.BTN.X% = GUI.INNER.LEFT% + INT((GUI.INNER.WIDTH% - GUI.BTN.TOTAL%) / 2)
    IF GUI.BTN.X% < GUI.INNER.LEFT% THEN GUI.BTN.X% = GUI.INNER.LEFT%
    ## GUI.DEFAULT% is sticky: a row of one must default to button 1
    IF GUI.DEFAULT% < 1 THEN GUI.DEFAULT% = 1
    IF GUI.BTN.THREE$ = "" AND GUI.DEFAULT% > 2 THEN GUI.DEFAULT% = 2
    IF GUI.BTN.TWO$ = "" THEN GUI.DEFAULT% = 1
    GUI.BTN.KEY.ONE% = 0 : GUI.BTN.KEY.TWO% = 0 : GUI.BTN.KEY.THREE% = 0
    GUI.BTN.N% = 1 : GUI.BTN.TEXT$ = GUI.BTN.ONE$ : GUI.ADD.W% = GUI.BTN.W.ONE%
    GOSUB GUI.BTN.PLACE : GUI.BTN.KEY.ONE% = GUI.BTN.KEY%
    IF GUI.BTN.TWO$ = "" THEN RETURN
    GUI.BTN.N% = 2 : GUI.BTN.TEXT$ = GUI.BTN.TWO$ : GUI.ADD.W% = GUI.BTN.W.TWO%
    GOSUB GUI.BTN.PLACE : GUI.BTN.KEY.TWO% = GUI.BTN.KEY%
    IF GUI.BTN.THREE$ = "" THEN RETURN
    GUI.BTN.N% = 3 : GUI.BTN.TEXT$ = GUI.BTN.THREE$ : GUI.ADD.W% = GUI.BTN.W.THREE%
    GOSUB GUI.BTN.PLACE : GUI.BTN.KEY.THREE% = GUI.BTN.KEY%
    RETURN

## one button of the row: draw it, record it, move the pen past it
GUI.BTN.PLACE:
    GUI.BTN.DEF% = 0
    IF GUI.DEFAULT% = GUI.BTN.N% THEN GUI.BTN.DEF% = -1
    GOSUB GUI.BUTTON : GOSUB GUI.FORM.ADD.BUTTON
    GUI.BTN.X% = GUI.BTN.X% + GUI.ADD.W% + GUI.BTN.GAP
    RETURN

## GUI.BTN.COLOURS -- GUI.BTN.ATTR% and .HI, plain or focused (GUI.BTN.FOCUSED%)
GUI.BTN.COLOURS:
    GUI.BTN.ATTR% = GUI.PANEL% : GUI.BTN.HI% = (GUI.PANEL% AND 240) + (THEME.CLR%(THEME.BORDER) AND 15)
    IF GUI.BTN.FOCUSED% <> 0 THEN GUI.BTN.ATTR% = THEME.CLR%(THEME.HILITE) : GUI.BTN.HI% = GUI.BTN.ATTR%
    RETURN

## GUI.FORM.INIT -- DIM the control arrays once per program
## SEL COUNT FIRST ROWS SCROLL are the state of a list, combo or radio.
GUI.FORM.INIT:
    IF GUI.FORM.DIMMED% <> 0 THEN RETURN
    DIM GUI.CTRL.TYPE%(GUI.FORM.MAX)
    DIM GUI.CTRL.X%(GUI.FORM.MAX)
    DIM GUI.CTRL.Y%(GUI.FORM.MAX)
    DIM GUI.CTRL.W%(GUI.FORM.MAX)
    DIM GUI.CTRL.KEY%(GUI.FORM.MAX)
    DIM GUI.CTRL.FLAGS%(GUI.FORM.MAX)
    DIM GUI.CTRL.TEXT$(GUI.FORM.MAX)
    DIM GUI.CTRL.SEL%(GUI.FORM.MAX)
    DIM GUI.CTRL.COUNT%(GUI.FORM.MAX)
    DIM GUI.CTRL.FIRST%(GUI.FORM.MAX)
    DIM GUI.CTRL.ROWS%(GUI.FORM.MAX)
    DIM GUI.CTRL.SCROLL%(GUI.FORM.MAX)
    GUI.FORM.DIMMED% = -1
    RETURN

## GUI.FORM.BEGIN -- empty control list; call after GUI.OPEN
GUI.FORM.BEGIN:
    GOSUB GUI.FORM.INIT
    GUI.CTRL.N% = 0
    GUI.FORM.DEFN% = 0
    GUI.FOCUS% = 1
    GUI.FORM.PAINTED% = 0
    GUI.FORM.WATCH% = 0
    GUI.FORM.RESUME% = 0
    GUI.ITEM.OWNER% = 0
    RETURN

## GUI.ITEM.BEGIN -- empty the item store at GUI.ITEM.BASE in bank GUI.ITEM.BANK%.
## It takes 2 + 2 * GUI.ITEM.MAX bytes of table, then a byte more than each item's text.
## The store is the GP.BSTR image layout, so GUI.LIST.FETCH reads it as it reads a
## GP.BANKEDSTR bank. A list, combo or radio owns a run of it, FIRST% for COUNT%.
GUI.ITEM.BEGIN:
    GUI.ITEM.COUNT% = 0
    GUI.ITEM.NEXT = GUI.ITEM.BASE + 2 + 2 * GUI.ITEM.MAX
    GUI.ITEM.OWNER% = 0
    RETURN

## GUI.ITEM.CLAIM -- control GUI.CTRL.N% owns the items added after it.
## The owner before it has all its items, and is sealed.
GUI.ITEM.CLAIM:
    GOSUB GUI.ITEM.SEAL
    GUI.ITEM.OWNER% = GUI.CTRL.N%
    GUI.CTRL.FIRST%(GUI.ITEM.OWNER%) = GUI.ITEM.COUNT%
    GUI.CTRL.COUNT%(GUI.ITEM.OWNER%) = 0
    RETURN

## GUI.ITEM.ADD -- GUI.LIST.TEXT$ onto the end of the store, and of GUI.ITEM.OWNER%.
## A radio grows a row an item, and as wide as its widest. GUI.LIST.ADDR .LEN .PTR .C
## are the reader's names for the same bytes, and are scratch here.
## WARNING: GP.LOBYTE, not AND 255. AND raises OUT OF RANGE above 32,767.
GUI.ITEM.ADD:
    STASH.PEEKBANK = GUI.ITEM.BANK%
    GOSUB STASH.SELECT
    GUI.LIST.ADDR = GUI.ITEM.BASE + 2 + 2 * GUI.ITEM.COUNT%
    POKE GUI.LIST.ADDR, GP.LOBYTE(GUI.ITEM.NEXT - GUI.ITEM.BASE)
    POKE GUI.LIST.ADDR + 1, GP.HIBYTE(GUI.ITEM.NEXT - GUI.ITEM.BASE)
    GUI.LIST.LEN% = LEN(GUI.LIST.TEXT$)
    POKE GUI.ITEM.NEXT, GUI.LIST.LEN%
    IF GUI.LIST.LEN% = 0 THEN GOTO GUI.ITEM.STORED
    GUI.LIST.PTR = GP.STRPTR(GUI.LIST.TEXT$)
    FOR GUI.LIST.C = 1 TO GUI.LIST.LEN%
        POKE GUI.ITEM.NEXT + GUI.LIST.C, PEEK(GUI.LIST.PTR + GUI.LIST.C)
    NEXT GUI.LIST.C
GUI.ITEM.STORED:
    GUI.ITEM.NEXT = GUI.ITEM.NEXT + GUI.LIST.LEN% + 1
    GUI.ITEM.COUNT% = GUI.ITEM.COUNT% + 1
    IF GUI.ITEM.OWNER% = 0 THEN RETURN
    GUI.CTRL.COUNT%(GUI.ITEM.OWNER%) = GUI.CTRL.COUNT%(GUI.ITEM.OWNER%) + 1
    IF GUI.CTRL.TYPE%(GUI.ITEM.OWNER%) <> GUI.CT.RADIO THEN RETURN
    GUI.CTRL.ROWS%(GUI.ITEM.OWNER%) = GUI.CTRL.COUNT%(GUI.ITEM.OWNER%)
    IF GUI.LIST.LEN% + 4 > GUI.CTRL.W%(GUI.ITEM.OWNER%) THEN GUI.CTRL.W%(GUI.ITEM.OWNER%) = GUI.LIST.LEN% + 4
    RETURN

## GUI.ITEM.SEAL -- the owner has all its items: clamp its choice, clear its marks, draw it
GUI.ITEM.SEAL:
    IF GUI.ITEM.OWNER% = 0 THEN RETURN
    GUI.PAINT.N% = GUI.ITEM.OWNER%
    GUI.ITEM.OWNER% = 0
    IF GUI.CTRL.SEL%(GUI.PAINT.N%) > GUI.CTRL.COUNT%(GUI.PAINT.N%) THEN GUI.CTRL.SEL%(GUI.PAINT.N%) = GUI.CTRL.COUNT%(GUI.PAINT.N%)
    IF GUI.CTRL.SEL%(GUI.PAINT.N%) < 1 THEN GUI.CTRL.SEL%(GUI.PAINT.N%) = 1
    IF (GUI.CTRL.FLAGS%(GUI.PAINT.N%) AND GUI.CF.MULTI) <> 0 THEN GUI.CTRL.TEXT$(GUI.PAINT.N%) = RPT$(48, GUI.CTRL.COUNT%(GUI.PAINT.N%))
    IF GUI.PAINT.N% = GUI.FOCUS% THEN GUI.FORM.PAINTED% = GUI.PAINT.N%
    GOTO GUI.FORM.PAINT

## GUI.ITEM.FETCH -- item GUI.ITEM.AT%, 1 up, of control GUI.ITEM.CTRL% into GUI.LIST.TEXT$
## It changes GUI.LIST.BANK% .BASE and .INDEX. A list reloads them before it reads a row.
GUI.ITEM.FETCH:
    GUI.LIST.BANK% = GUI.ITEM.BANK%
    GUI.LIST.BASE = GUI.ITEM.BASE
    GUI.LIST.INDEX% = GUI.CTRL.FIRST%(GUI.ITEM.CTRL%) + GUI.ITEM.AT% - 1
    GOTO GUI.LIST.FETCH.INDEX

## GUI.FORM.ADD.FIELD -- add and draw a field from LINEINPUT.X .Y .LEN .TEXT$
## the text lives in GUI.CTRL.TEXT$(n); read it there after GUI.FORM.RUN
GUI.FORM.ADD.FIELD:
    IF GUI.CTRL.N% >= GUI.FORM.MAX THEN RETURN
    GUI.CTRL.N% = GUI.CTRL.N% + 1
    GUI.CTRL.TYPE%(GUI.CTRL.N%) = GUI.CT.FIELD
    GUI.CTRL.X%(GUI.CTRL.N%) = LINEINPUT.X : GUI.CTRL.Y%(GUI.CTRL.N%) = LINEINPUT.Y
    GUI.CTRL.W%(GUI.CTRL.N%) = LINEINPUT.LEN
    GUI.CTRL.TEXT$(GUI.CTRL.N%) = LINEINPUT.TEXT$
    GUI.CTRL.KEY%(GUI.CTRL.N%) = 0 : GUI.CTRL.FLAGS%(GUI.CTRL.N%) = 0
    GUI.PAINT.N% = GUI.CTRL.N%
    GOSUB GUI.FIELD.DRAW
    RETURN

## GUI.FIELD.DRAW -- control GUI.PAINT.N% as a field without a cursor
GUI.FIELD.DRAW:
    LINEINPUT.X = GUI.CTRL.X%(GUI.PAINT.N%) : LINEINPUT.Y = GUI.CTRL.Y%(GUI.PAINT.N%) : LINEINPUT.LEN = GUI.CTRL.W%(GUI.PAINT.N%)
    LINEINPUT.TEXT$ = GUI.CTRL.TEXT$(GUI.PAINT.N%)
    GOSUB LINEINPUT.RENDER : GP.FILL LINEINPUT.X, LINEINPUT.Y, LINEINPUT.LEN, 1, GUI.SPACE, LINEINPUT.ATTR
    IF LINEINPUT.SHOW$ <> "" THEN GP.PRINTAT LINEINPUT.X, LINEINPUT.Y, LINEINPUT.SHOW$, LINEINPUT.ATTR
    RETURN

## GUI.LIST.MEASURE -- footer note width; call before GUI.OPEN
GUI.LIST.MEASURE:
    GUI.LIST.DIGITS% = LEN(MID$(STR$(GUI.LIST.COUNT%), 2)) : GUI.LIST.NOTE$ = ""
    IF GUI.LIST.COUNT% > GUI.LIST.ROWS% THEN GUI.LIST.NOTE$ = " " + MID$(STR$(GUI.LIST.COUNT%), 2) + " ITEMS "
    IF GUI.LIST.MULTI% <> 0 THEN GUI.LIST.NOTE$ = " " + MID$(STR$(GUI.LIST.COUNT%), 2) + " SELECTED OF " + MID$(STR$(GUI.LIST.COUNT%), 2) + " "
    GUI.LIST.NOTEW% = LEN(GUI.LIST.NOTE$)
    RETURN

## GUI.FORM.ADD.LIST -- add a list: GUI.LIST.X% .Y .W .ROWS .COUNT .SEL .FIRST .BANK
## GUI.LIST.MULTI% non-zero marks rows with SPACE, in GUI.CTRL.TEXT$(n) as "0"/"1".
## out GUI.LIST.CTRL%. A list of no rows is drawn when GUI.ITEM.SEAL seals it.
GUI.FORM.ADD.LIST:
    IF GUI.CTRL.N% >= GUI.FORM.MAX THEN RETURN
    GUI.CTRL.N% = GUI.CTRL.N% + 1
    GUI.LIST.CTRL% = GUI.CTRL.N%
    GUI.CTRL.TYPE%(GUI.LIST.CTRL%) = GUI.CT.LIST
    GUI.CTRL.X%(GUI.LIST.CTRL%) = GUI.LIST.X%
    GUI.CTRL.Y%(GUI.LIST.CTRL%) = GUI.LIST.Y%
    GUI.CTRL.W%(GUI.LIST.CTRL%) = GUI.LIST.W%
    GUI.CTRL.TEXT$(GUI.LIST.CTRL%) = ""
    GUI.CTRL.KEY%(GUI.LIST.CTRL%) = 0
    GUI.CTRL.FLAGS%(GUI.LIST.CTRL%) = 0
    IF GUI.LIST.MULTI% <> 0 THEN GUI.CTRL.FLAGS%(GUI.LIST.CTRL%) = GUI.CF.MULTI
    GUI.CTRL.ROWS%(GUI.LIST.CTRL%) = GUI.LIST.ROWS%
    GUI.CTRL.COUNT%(GUI.LIST.CTRL%) = GUI.LIST.COUNT%
    GUI.CTRL.FIRST%(GUI.LIST.CTRL%) = GUI.LIST.FIRST%
    GUI.CTRL.SEL%(GUI.LIST.CTRL%) = GUI.LIST.SEL%
    GUI.CTRL.SCROLL%(GUI.LIST.CTRL%) = 0
    GUI.ITEM.BANK% = GUI.LIST.BANK%
    GUI.ITEM.BASE = GUI.LIST.BASE
    GUI.LIST.NOTE.LEFT% = GUI.LEFT% + INT((GUI.WIDTH% - GUI.LIST.NOTEW%) / 2)
    IF GUI.LIST.COUNT% < 1 THEN RETURN
    GUI.ITEM.OWNER% = GUI.LIST.CTRL%
    GOTO GUI.ITEM.SEAL

## GUI.LIST.LOAD -- list control GUI.LIST.CTRL%'s state into the GUI.LIST scalars,
## scrolled the least that shows its choice
GUI.LIST.LOAD:
    GUI.LIST.X% = GUI.CTRL.X%(GUI.LIST.CTRL%)
    GUI.LIST.Y% = GUI.CTRL.Y%(GUI.LIST.CTRL%)
    GUI.LIST.W% = GUI.CTRL.W%(GUI.LIST.CTRL%)
    GUI.LIST.ROWS% = GUI.CTRL.ROWS%(GUI.LIST.CTRL%)
    GUI.LIST.COUNT% = GUI.CTRL.COUNT%(GUI.LIST.CTRL%)
    GUI.LIST.FIRST% = GUI.CTRL.FIRST%(GUI.LIST.CTRL%)
    GUI.LIST.SEL% = GUI.CTRL.SEL%(GUI.LIST.CTRL%)
    GUI.LIST.SCROLL% = GUI.CTRL.SCROLL%(GUI.LIST.CTRL%)
    GUI.LIST.BANK% = GUI.ITEM.BANK%
    GUI.LIST.BASE = GUI.ITEM.BASE
    GUI.LIST.MARKP = 0
    IF (GUI.CTRL.FLAGS%(GUI.LIST.CTRL%) AND GUI.CF.MULTI) <> 0 THEN GUI.LIST.MARKP = GP.STRPTR(GUI.CTRL.TEXT$(GUI.LIST.CTRL%))
    GOTO GUI.LIST.FOLLOW

## GUI.LIST.PAINT -- list control GUI.PAINT.N%, rows and footer
GUI.LIST.PAINT:
    GUI.LIST.CTRL% = GUI.PAINT.N%
    GOSUB GUI.LIST.LOAD
    GOSUB GUI.LIST.COUNTMARKS
    GOSUB GUI.LIST.FOOT
    GOTO GUI.LIST.DRAW

## GUI.LIST.DRAW -- every visible row; HILITE when focused, FOCUS when not
## test GUI.LIST.CTRL%, not GUI.PAINT.N%: PAINT.N is stale on a scroll
GUI.LIST.DRAW:
    GUI.LIST.HI% = THEME.CLR%(THEME.FOCUS)
    IF GUI.LIST.CTRL% = GUI.FOCUS% THEN GUI.LIST.HI% = THEME.CLR%(THEME.HILITE)
    FOR GUI.LIST.EACH = 1 TO GUI.LIST.ROWS%
        GUI.LIST.ROW% = GUI.LIST.EACH : GUI.LIST.ATTR% = GUI.PANEL%
        IF GUI.LIST.SCROLL% + GUI.LIST.EACH = GUI.LIST.SEL% THEN GUI.LIST.ATTR% = GUI.LIST.HI%
        GOSUB GUI.LIST.PAINT.ROW
    NEXT GUI.LIST.EACH
    RETURN

## GUI.LIST.PAINT.ROW -- screen row GUI.LIST.ROW% in GUI.LIST.ATTR%; off-window is a no-op
GUI.LIST.PAINT.ROW:
    IF GUI.LIST.ROW% < 1 THEN RETURN
    IF GUI.LIST.ROW% > GUI.LIST.ROWS% THEN RETURN
    GUI.LIST.DRAWY% = GUI.LIST.Y% + GUI.LIST.ROW% - 1 : GUI.LIST.AT% = GUI.LIST.SCROLL% + GUI.LIST.ROW%
    GP.FILL GUI.LIST.X%, GUI.LIST.DRAWY%, GUI.LIST.W%, 1, GUI.SPACE, GUI.LIST.ATTR%
    IF GUI.LIST.AT% > GUI.LIST.COUNT% THEN RETURN
    GOSUB GUI.LIST.FETCH
    GP.PRINTAT GUI.LIST.X%, GUI.LIST.DRAWY%, LEFT$(GUI.LIST.TEXT$, GUI.LIST.W%), GUI.LIST.ATTR%
    IF GUI.LIST.MARKP = 0 THEN RETURN
    ## mark cell: 49 is "1", 42 is "*"
    GP.FILL GUI.LIST.X% - 2, GUI.LIST.DRAWY%, 2, 1, GUI.SPACE, GUI.LIST.ATTR%
    IF PEEK(GUI.LIST.MARKP + GUI.LIST.AT%) <> 49 THEN RETURN
    GP.FILL GUI.LIST.X% - 2, GUI.LIST.DRAWY%, 1, 1, 42, GUI.LIST.ATTR%
    RETURN

## GUI.LIST.FETCH -- row GUI.LIST.AT% into GUI.LIST.TEXT$, from the list's source.
## GUI.LIST.BANK% 0 is GUI.LIST.ITEM$(); any other is a bank holding a GP.BSTR image at
## GUI.LIST.BASE, whose row 1 is string GUI.LIST.FIRST%. A GP.BANKEDSTR group's is $A000.
GUI.LIST.FETCH:
    GP.IF GUI.LIST.BANK% = 0 THEN
        GUI.LIST.TEXT$ = GUI.LIST.ITEM$(GUI.LIST.AT%)
        RETURN
    GP.ENDIF
    GUI.LIST.INDEX% = GUI.LIST.FIRST% + GUI.LIST.AT% - 1

## GUI.LIST.FETCH.INDEX -- string GUI.LIST.INDEX% of bank GUI.LIST.BANK% into GUI.LIST.TEXT$.
## The bytes are POKEd into a string the right length: one string, no concatenation.
GUI.LIST.FETCH.INDEX:
    GOSUB GUI.LIST.RECORD : GUI.LIST.TEXT$ = "" : IF GUI.LIST.LEN% = 0 THEN RETURN
    GUI.LIST.TEXT$ = RPT$(32, GUI.LIST.LEN%) : GUI.LIST.PTR = GP.STRPTR(GUI.LIST.TEXT$)
    FOR GUI.LIST.C = 1 TO GUI.LIST.LEN%
        POKE GUI.LIST.PTR + GUI.LIST.C, PEEK(GUI.LIST.ADDR + GUI.LIST.C)
    NEXT GUI.LIST.C
    RETURN

## GUI.LIST.WIDTH -- GUI.LIST.LEN%, the length of row GUI.LIST.AT%, without reading it
GUI.LIST.WIDTH:
    GP.IF GUI.LIST.BANK% = 0 THEN
        GUI.LIST.LEN% = LEN(GUI.LIST.ITEM$(GUI.LIST.AT%))
        RETURN
    GP.ENDIF
    GUI.LIST.INDEX% = GUI.LIST.FIRST% + GUI.LIST.AT% - 1
    GOSUB GUI.LIST.RECORD
    RETURN

## GUI.LIST.RECORD -- GUI.LIST.ADDR at string GUI.LIST.INDEX%'s length byte in the bank,
## GUI.LIST.LEN% that length. GUI.LIST.BASE + 2 holds a 16-bit offset from BASE per string.
## STASH.SELECT runs the BANK statement a region may not; the PEEKs honour it.
GUI.LIST.RECORD:
    STASH.PEEKBANK = GUI.LIST.BANK% : GOSUB STASH.SELECT
    GUI.LIST.ADDR = GUI.LIST.BASE + 2 + 2 * GUI.LIST.INDEX%
    GUI.LIST.ADDR = GUI.LIST.BASE + PEEK(GUI.LIST.ADDR) + 256 * PEEK(GUI.LIST.ADDR + 1)
    GUI.LIST.LEN% = PEEK(GUI.LIST.ADDR)
    RETURN

## GUI.LIST.FOLLOW -- scroll the least that shows GUI.LIST.SEL%
GUI.LIST.FOLLOW:
    IF GUI.LIST.SEL% - GUI.LIST.SCROLL% < 1 THEN GUI.LIST.SCROLL% = GUI.LIST.SEL% - 1
    IF GUI.LIST.SEL% - GUI.LIST.SCROLL% > GUI.LIST.ROWS% THEN GUI.LIST.SCROLL% = GUI.LIST.SEL% - GUI.LIST.ROWS%
    IF GUI.LIST.SCROLL% > GUI.LIST.COUNT% - GUI.LIST.ROWS% THEN GUI.LIST.SCROLL% = GUI.LIST.COUNT% - GUI.LIST.ROWS%
    IF GUI.LIST.SCROLL% < 0 THEN GUI.LIST.SCROLL% = 0
    RETURN

## GUI.LIST.COUNTMARKS -- GUI.LIST.MARKED% from the marks string
GUI.LIST.COUNTMARKS:
    GUI.LIST.MARKED% = 0 : IF GUI.LIST.MARKP = 0 THEN RETURN
    FOR GUI.LIST.I = 1 TO GUI.LIST.COUNT%
        IF PEEK(GUI.LIST.MARKP + GUI.LIST.I) = 49 THEN GUI.LIST.MARKED% = GUI.LIST.MARKED% + 1
    NEXT GUI.LIST.I
    RETURN

## GUI.LIST.TOGGLE -- flip the mark at GUI.LIST.SEL%; 97 - c swaps "0" and "1"
GUI.LIST.TOGGLE:
    POKE GUI.LIST.MARKP + GUI.LIST.SEL%, 97 - PEEK(GUI.LIST.MARKP + GUI.LIST.SEL%)
    GUI.LIST.MARKED% = GUI.LIST.MARKED% - 1
    IF PEEK(GUI.LIST.MARKP + GUI.LIST.SEL%) = 49 THEN GUI.LIST.MARKED% = GUI.LIST.MARKED% + 2
    GUI.LIST.ROW% = GUI.LIST.SEL% - GUI.LIST.SCROLL%
    GUI.LIST.ATTR% = GUI.LIST.HI%
    GOSUB GUI.LIST.PAINT.ROW : GOSUB GUI.LIST.FOOT
    GUI.FORM.CHANGED% = GUI.LIST.CTRL%
    RETURN

## GUI.LIST.FOOT -- item or marked count in the bottom edge; padded, not centred
GUI.LIST.FOOT:
    IF GUI.LIST.NOTEW% = 0 THEN RETURN
    GUI.LIST.EDGE$ = GUI.LIST.NOTE$
    IF GUI.LIST.MARKP = 0 THEN GOTO GUI.LIST.FOOT.DRAW
    GUI.LIST.NUM$ = MID$(STR$(GUI.LIST.MARKED%), 2)
    IF LEN(GUI.LIST.NUM$) < GUI.LIST.DIGITS% THEN GUI.LIST.NUM$ = " " + GUI.LIST.NUM$
    IF LEN(GUI.LIST.NUM$) < GUI.LIST.DIGITS% THEN GUI.LIST.NUM$ = " " + GUI.LIST.NUM$
    GUI.LIST.EDGE$ = " " + GUI.LIST.NUM$ + " SELECTED OF " + MID$(STR$(GUI.LIST.COUNT%), 2) + " "
GUI.LIST.FOOT.DRAW:
    GP.PRINTAT GUI.LIST.NOTE.LEFT%, GUI.TOP% + GUI.HEIGHT% - 1, GUI.LIST.EDGE$, GUI.BORDER%
    RETURN

## GUI.FORM.ADD.BUTTON -- record the button GUI.BUTTON drew; width in GUI.ADD.W%
GUI.FORM.ADD.BUTTON:
    IF GUI.CTRL.N% >= GUI.FORM.MAX THEN RETURN
    GUI.CTRL.N% = GUI.CTRL.N% + 1 : GUI.CTRL.TYPE%(GUI.CTRL.N%) = GUI.CT.BUTTON
    GUI.CTRL.X%(GUI.CTRL.N%) = GUI.BTN.X% : GUI.CTRL.Y%(GUI.CTRL.N%) = GUI.BTN.Y%
    GUI.CTRL.W%(GUI.CTRL.N%) = GUI.ADD.W% : GUI.CTRL.TEXT$(GUI.CTRL.N%) = GUI.BTN.TEXT$ : GUI.CTRL.KEY%(GUI.CTRL.N%) = GUI.BTN.KEY%
    GUI.CTRL.FLAGS%(GUI.CTRL.N%) = 0
    IF GUI.BTN.DEF% = 0 THEN RETURN
    GUI.CTRL.FLAGS%(GUI.CTRL.N%) = GUI.CF.DEFAULT
    GUI.FOCUS% = GUI.CTRL.N% : GUI.FORM.DEFN% = GUI.CTRL.N%
    RETURN

## GUI.FORM.PAINT -- draw control GUI.PAINT.N% in its current state
## Every case is GOSUB: COMBO, CHECK and RADIO painters live in another region.
## GP.SELECT cannot take an array element, hence GUI.STEP.TYPE%.
GUI.FORM.PAINT:
    GUI.STEP.TYPE% = GUI.CTRL.TYPE%(GUI.PAINT.N%)
    GP.SELECT GUI.STEP.TYPE%
        GP.CASE GUI.CT.FIELD
            GOSUB GUI.FIELD.DRAW
        GP.CASE GUI.CT.LIST
            GOSUB GUI.LIST.PAINT
        GP.CASE GUI.CT.VALUE
            GOSUB GUI.VALUE.DRAW
        GP.CASE GUI.CT.COMBO
            GOSUB COMBO.DRAW
        GP.CASE GUI.CT.CHECK
            GOSUB CHECK.DRAW
        GP.CASE GUI.CT.RADIO
            GOSUB RADIO.DRAW
        GP.OTHER
            GOSUB GUI.BUTTON.PAINT
    GP.ENDSEL
    RETURN

## GUI.BUTTON.PAINT -- button control GUI.PAINT.N%
GUI.BUTTON.PAINT:
    GUI.BTN.X% = GUI.CTRL.X%(GUI.PAINT.N%) : GUI.BTN.Y% = GUI.CTRL.Y%(GUI.PAINT.N%)
    GUI.BTN.TEXT$ = GUI.CTRL.TEXT$(GUI.PAINT.N%)
    GUI.BTN.DEF% = GUI.CTRL.FLAGS%(GUI.PAINT.N%) AND GUI.CF.DEFAULT
    GUI.BTN.FOCUSED% = 0
    IF GUI.PAINT.N% = GUI.FOCUS% THEN GUI.BTN.FOCUSED% = -1
    IF GUI.CTRL.TYPE%(GUI.FOCUS%) = GUI.CT.BUTTON THEN GUI.BTN.DEF% = GUI.BTN.FOCUSED%
    GOSUB GUI.BTN.COLOURS : GOSUB GUI.BUTTON
    RETURN

## GUI.FORM.ADD.VALUE -- add and draw read-only text from LINEINPUT.X .Y .LEN .TEXT$,
## the field's inputs. out GUI.VALUE.CTRL%, 0 if the form is full. It never takes the focus.
GUI.FORM.ADD.VALUE:
    GUI.VALUE.CTRL% = 0
    IF GUI.CTRL.N% >= GUI.FORM.MAX THEN RETURN
    GUI.CTRL.N% = GUI.CTRL.N% + 1
    GUI.VALUE.CTRL% = GUI.CTRL.N%
    GUI.CTRL.TYPE%(GUI.VALUE.CTRL%) = GUI.CT.VALUE
    GUI.CTRL.X%(GUI.VALUE.CTRL%) = LINEINPUT.X
    GUI.CTRL.Y%(GUI.VALUE.CTRL%) = LINEINPUT.Y
    GUI.CTRL.W%(GUI.VALUE.CTRL%) = LINEINPUT.LEN
    GUI.CTRL.TEXT$(GUI.VALUE.CTRL%) = LINEINPUT.TEXT$
    GUI.CTRL.KEY%(GUI.VALUE.CTRL%) = 0
    GUI.CTRL.FLAGS%(GUI.VALUE.CTRL%) = GUI.CF.NOFOCUS
    GUI.PAINT.N% = GUI.VALUE.CTRL%
    GOTO GUI.VALUE.DRAW

## GUI.VALUE.DRAW -- value control GUI.PAINT.N%, its text cut to its width, in the frame's colour
## LINEINPUT.X .Y .LEN are scratch here, as in GUI.FIELD.DRAW.
GUI.VALUE.DRAW:
    LINEINPUT.X = GUI.CTRL.X%(GUI.PAINT.N%)
    LINEINPUT.Y = GUI.CTRL.Y%(GUI.PAINT.N%)
    LINEINPUT.LEN = GUI.CTRL.W%(GUI.PAINT.N%)
    GP.FILL LINEINPUT.X, LINEINPUT.Y, LINEINPUT.LEN, 1, GUI.SPACE, GUI.PANEL%
    IF GUI.CTRL.TEXT$(GUI.PAINT.N%) = "" THEN RETURN
    GP.PRINTAT LINEINPUT.X, LINEINPUT.Y, LEFT$(GUI.CTRL.TEXT$(GUI.PAINT.N%), LINEINPUT.LEN), GUI.BORDER%
    RETURN

## GUI.FORM.DRAIN -- drop every key waiting. GUI.TYPEAHEAD% non-zero keeps them, for a
## program that queues a box's keys before it opens.
GUI.FORM.DRAIN:
    IF GUI.TYPEAHEAD% <> 0 THEN RETURN
    GP.DO
        GET GUI.PRESSED$
        IF GP.ISEMPTY(GUI.PRESSED$) THEN GP.EXITDO
    GP.LOOP
    RETURN

## GUI.FORM.RUN -- key loop until a control ends it; out GUI.FORM.HIT% .KEY .DONE
## GUI.FORM.WATCH% non-zero also ends it when a control's value changes, with
## GUI.FORM.DONE% 0 and the control in GUI.FORM.CHANGED%. Call again to go on.
GUI.FORM.RUN:
    GOSUB GUI.FORM.INIT : GUI.FORM.HIT% = 0 : GUI.FORM.DONE% = 0
    IF GUI.FOCUS% < 1 THEN GUI.FOCUS% = 1
    IF GUI.FOCUS% > GUI.CTRL.N% THEN GUI.FOCUS% = 1
    GUI.PAINT.N% = GUI.FOCUS%
    ## a control already drawn in this focus state is not drawn again: a banked
    ## list costs a PEEK a character, and the second pass is visible
    IF GUI.FOCUS% <> GUI.FORM.PAINTED% THEN GOSUB GUI.FORM.PAINT
    ## ---- drop what was queued before the box opened, and typed while it drew.
    ## ---- A form opened on a queued RETURN answers itself and closes unseen.
    ## ---- A resumed run keeps what was typed while the program worked.
    IF GUI.FORM.RESUME% = 0 THEN GOSUB GUI.FORM.DRAIN
GUI.FORM.LOOP:
    GUI.FORM.CHANGED% = 0
    GOSUB GUI.FORM.STEP
    IF GUI.FORM.DONE% <> 0 THEN GOTO GUI.FORM.CLOSING
    IF GUI.FORM.WATCH% = 0 THEN GOTO GUI.FORM.LOOP
    IF GUI.FORM.CHANGED% = 0 THEN GOTO GUI.FORM.LOOP
    GUI.FORM.PAINTED% = GUI.FOCUS%
    GUI.FORM.RESUME% = -1
    RETURN
GUI.FORM.CLOSING:
    ## ---- and drop the repeats of the key that closed it. A held ESC shuts the
    ## ---- box and its repeat lands in the program's own key loop after it.
    GOSUB GUI.FORM.DRAIN
    RETURN

## GUI.FORM.STEP -- focused control reads a key, GUI.FORM.ACT acts on the verdict
## GP.SELECT cannot take an array element, hence GUI.STEP.TYPE%
GUI.FORM.STEP:
    GUI.STEP.TYPE% = GUI.CTRL.TYPE%(GUI.FOCUS%)
    GP.SELECT GUI.STEP.TYPE%
        GP.CASE GUI.CT.FIELD
            GOSUB GUI.FORM.DO.FIELD
        GP.CASE GUI.CT.LIST
            GOSUB GUI.FORM.DO.LIST
        GP.CASE GUI.CT.COMBO
            GOSUB COMBO.KEY
        GP.CASE GUI.CT.CHECK
            GOSUB CHECK.KEY
        GP.CASE GUI.CT.RADIO
            GOSUB RADIO.KEY
        GP.OTHER
            GOSUB GUI.FORM.DO.BUTTON
    GP.ENDSEL
    GOSUB GUI.FORM.ACT
    RETURN

## GUI.FORM.DO.FIELD -- run LINEINPUT.GET, map its exit key to a verdict
## The position is read from the control: a FORM.SETTEXT repaint moves LINEINPUT.X .Y.
GUI.FORM.DO.FIELD:
    LINEINPUT.X = GUI.CTRL.X%(GUI.FOCUS%)
    LINEINPUT.Y = GUI.CTRL.Y%(GUI.FOCUS%)
    LINEINPUT.LEN = GUI.CTRL.W%(GUI.FOCUS%)
    LINEINPUT.TEXT$ = GUI.CTRL.TEXT$(GUI.FOCUS%)
    GOSUB LINEINPUT.GET
    IF LINEINPUT.TEXT$ <> GUI.CTRL.TEXT$(GUI.FOCUS%) THEN GUI.FORM.CHANGED% = GUI.FOCUS%
    GUI.CTRL.TEXT$(GUI.FOCUS%) = LINEINPUT.TEXT$
    GUI.FORM.KEY% = LINEINPUT.KEY
    GUI.FORM.NAV% = GUI.NAV.STAY
    GP.SELECT GUI.FORM.KEY%
        GP.CASE LINEINPUT.TAB, LINEINPUT.DOWN
            GUI.FORM.NAV% = GUI.NAV.NEXT
        GP.CASE LINEINPUT.UP, LINEINPUT.SHTAB
            GUI.FORM.NAV% = GUI.NAV.PREV
        GP.CASE GUI.RETURN  
            GUI.FORM.NAV% = GUI.NAV.DEFAULT
        GP.CASE GUI.ESCAPE, GUI.STOP
            GUI.FORM.NAV% = GUI.NAV.CANCEL
    GP.ENDSEL
    RETURN

## GUI.FORM.DO.LIST -- the focused list's keys, from and back to its own state
GUI.FORM.DO.LIST:
    GUI.LIST.CTRL% = GUI.FOCUS%
    GOSUB GUI.LIST.LOAD
    GOSUB GUI.LIST.KEYS
    GUI.CTRL.SEL%(GUI.LIST.CTRL%) = GUI.LIST.SEL%
    GUI.CTRL.SCROLL%(GUI.LIST.CTRL%) = GUI.LIST.SCROLL%
    RETURN

## GUI.LIST.KEYS -- move and scroll in place; leave with a verdict, or on a change
## when GUI.FORM.WATCH% is set. A change is a mark, or a new row in a pick-one list.
GUI.LIST.KEYS:
    GUI.FORM.NAV% = GUI.NAV.STAY
GUI.LIST.KEYS.NEXT:
    ## ---- drop what was typed during the redraw: a held arrow outruns the paint
    GOSUB GUI.FORM.DRAIN
    GOSUB GUI.FORM.GETKEY : GUI.LIST.WAS% = GUI.LIST.SEL%
    GUI.LIST.WAS.SCROLL% = GUI.LIST.SCROLL%
    GUI.LIST.HI% = THEME.CLR%(THEME.HILITE)
    ## 130 PgUp, 2 PgDn, 19 HOME, 4 END
    GP.SELECT GUI.FORM.KEY%
        GP.CASE GUI.K.UP : GUI.LIST.SEL% = GUI.LIST.SEL% - 1
        GP.CASE GUI.K.DOWN : GUI.LIST.SEL% = GUI.LIST.SEL% + 1
        GP.CASE 130 : GUI.LIST.SEL% = GUI.LIST.SEL% - GUI.LIST.ROWS%
        GP.CASE 2   : GUI.LIST.SEL% = GUI.LIST.SEL% + GUI.LIST.ROWS%
        GP.CASE 19  : GUI.LIST.SEL% = 1
        GP.CASE 4   : GUI.LIST.SEL% = GUI.LIST.COUNT%
        GP.CASE GUI.SPACE
            IF GUI.LIST.MARKP <> 0 THEN GOSUB GUI.LIST.TOGGLE
        GP.CASE GUI.K.TAB
            GUI.FORM.NAV% = GUI.NAV.NEXT
        GP.CASE GUI.K.SHTAB
            GUI.FORM.NAV% = GUI.NAV.PREV
        GP.CASE GUI.RETURN
            GUI.FORM.NAV% = GUI.NAV.DEFAULT
        GP.CASE GUI.ESCAPE, GUI.STOP
            GUI.FORM.NAV% = GUI.NAV.CANCEL
        GP.OTHER : GOSUB GUI.FORM.ACCEL
    GP.ENDSEL
    IF GUI.FORM.NAV% <> GUI.NAV.STAY THEN RETURN
    IF GUI.LIST.SEL% < 1 THEN GUI.LIST.SEL% = 1
    IF GUI.LIST.SEL% > GUI.LIST.COUNT% THEN GUI.LIST.SEL% = GUI.LIST.COUNT%
    GOSUB GUI.LIST.FOLLOW
    GP.IF GUI.LIST.SCROLL% <> GUI.LIST.WAS.SCROLL% THEN
        GOSUB GUI.LIST.DRAW
        GOTO GUI.LIST.KEYS.MOVED
    GP.ENDIF
    IF GUI.LIST.SEL% = GUI.LIST.WAS% THEN GOTO GUI.LIST.KEYS.MOVED
    GUI.LIST.ROW% = GUI.LIST.WAS% - GUI.LIST.SCROLL%
    GUI.LIST.ATTR% = GUI.PANEL%
    GOSUB GUI.LIST.PAINT.ROW
    GUI.LIST.ROW% = GUI.LIST.SEL% - GUI.LIST.SCROLL%
    GUI.LIST.ATTR% = GUI.LIST.HI%
    GOSUB GUI.LIST.PAINT.ROW
GUI.LIST.KEYS.MOVED:
    IF GUI.LIST.MARKP = 0 AND GUI.LIST.SEL% <> GUI.LIST.WAS% THEN GUI.FORM.CHANGED% = GUI.LIST.CTRL%
    IF GUI.FORM.WATCH% = 0 THEN GOTO GUI.LIST.KEYS.NEXT
    IF GUI.FORM.CHANGED% = 0 THEN GOTO GUI.LIST.KEYS.NEXT
    RETURN

## GUI.FORM.DO.BUTTON -- map a key to a verdict; unclaimed keys try the accelerators
GUI.FORM.DO.BUTTON:
    GOSUB GUI.FORM.GETKEY
    GUI.FORM.NAV% = GUI.NAV.STAY
    GP.SELECT GUI.FORM.KEY%
        GP.CASE GUI.K.TAB, GUI.K.RIGHT, GUI.K.DOWN
            GUI.FORM.NAV% = GUI.NAV.NEXT
        GP.CASE GUI.K.SHTAB, GUI.K.LEFT, GUI.K.UP
            GUI.FORM.NAV% = GUI.NAV.PREV
        GP.CASE GUI.RETURN, GUI.SPACE
            GUI.FORM.NAV% = GUI.NAV.PRESS
        GP.CASE GUI.ESCAPE, GUI.STOP
            GUI.FORM.NAV% = GUI.NAV.CANCEL
    GP.ENDSEL
    IF GUI.FORM.NAV% = GUI.NAV.STAY THEN GOSUB GUI.FORM.ACCEL
    RETURN

## GUI.FORM.GETKEY -- wait for a key into GUI.FORM.KEY%
GUI.FORM.GETKEY:
    GET GUI.PRESSED$ : IF GP.ISEMPTY(GUI.PRESSED$) THEN GOTO GUI.FORM.GETKEY
    GUI.FORM.KEY% = ASC(GUI.PRESSED$)
    RETURN

## GUI.FORM.ACCEL -- a marked letter, either case, presses its control
GUI.FORM.ACCEL:
    IF GUI.CTRL.N% < 1 THEN RETURN
    FOR GUI.SCAN = 1 TO GUI.CTRL.N%
        GP.IF GUI.CTRL.KEY%(GUI.SCAN) <> 0 AND GUI.FORM.NAV% = GUI.NAV.STAY THEN
            GUI.BTN.OF% = GUI.CTRL.KEY%(GUI.SCAN)
            GOSUB GUI.BTN.PAIR
            GP.IF GUI.FORM.KEY% = GUI.BTN.UC% OR GUI.FORM.KEY% = GUI.BTN.LC% THEN
                GUI.FOCUS% = GUI.SCAN
                GUI.FORM.NAV% = GUI.NAV.PRESS
            GP.ENDIF
        GP.ENDIF
    NEXT GUI.SCAN
    RETURN

## GUI.FORM.ACT -- apply GUI.FORM.NAV%; DEFAULT with no default button is a cancel
GUI.FORM.ACT:
    GP.SELECT GUI.FORM.NAV%
        GP.CASE GUI.NAV.NEXT
            GUI.MOVE.BY% = 1  : GOSUB GUI.FORM.MOVE
        GP.CASE GUI.NAV.PREV
            GUI.MOVE.BY% = -1 : GOSUB GUI.FORM.MOVE
        GP.CASE GUI.NAV.PRESS
            GUI.FORM.HIT% = GUI.FOCUS% : GUI.FORM.DONE% = -1
        GP.CASE GUI.NAV.DEFAULT
            GUI.FORM.HIT% = 0
            FOR GUI.SCAN = 1 TO GUI.CTRL.N%
                IF (GUI.CTRL.FLAGS%(GUI.SCAN) AND GUI.CF.DEFAULT) <> 0 THEN GUI.FORM.HIT% = GUI.SCAN
            NEXT GUI.SCAN
            GUI.FORM.DONE% = -1
        GP.CASE GUI.NAV.CANCEL
            GUI.FORM.HIT% = 0 : GUI.FORM.DONE% = -1
    GP.ENDSEL
    RETURN

## GUI.FORM.MOVE -- focus by GUI.MOVE.BY (1 or -1), wrapping, skipping NOFOCUS
GUI.FORM.MOVE:
    IF GUI.CTRL.N% < 2 THEN RETURN
    GUI.MOVE.WAS% = GUI.FOCUS% : GUI.MOVE.TRIES% = 0
GUI.FORM.MOVE.ON:
    GUI.FOCUS% = GUI.FOCUS% + GUI.MOVE.BY%
    IF GUI.FOCUS% > GUI.CTRL.N% THEN GUI.FOCUS% = 1
    IF GUI.FOCUS% < 1 THEN GUI.FOCUS% = GUI.CTRL.N%
    GUI.MOVE.TRIES% = GUI.MOVE.TRIES% + 1
    IF GUI.MOVE.TRIES% >= GUI.CTRL.N% THEN GOTO GUI.FORM.MOVE.DONE
    IF (GUI.CTRL.FLAGS%(GUI.FOCUS%) AND GUI.CF.NOFOCUS) <> 0 THEN GOTO GUI.FORM.MOVE.ON
GUI.FORM.MOVE.DONE:
    IF GUI.FOCUS% = GUI.MOVE.WAS% THEN RETURN
    GUI.PAINT.N% = GUI.MOVE.WAS% : GOSUB GUI.FORM.PAINT
    GUI.PAINT.N% = GUI.FOCUS%    : GOSUB GUI.FORM.PAINT
    IF GUI.FORM.DEFN% = 0 THEN RETURN
    GUI.PAINT.N% = GUI.FORM.DEFN%
    GOSUB GUI.FORM.PAINT
    RETURN

## GUI.OPEN -- size, place, save, draw the frame and message
## in GUI.BODY.ROWS% .BODY.WIDTH    out GUI.INNER.LEFT% .INNER.TOP .INNER.WIDTH
GUI.OPEN:
    GOSUB GUI.SIZE : GOSUB GUI.PLACE.BOX
    ## shadow sized before the save, so the save covers it
    GUI.SH.W% = 0 : GUI.SH.H% = 0
    IF GUI.SHADOW% <> 0 THEN GOSUB GUI.SHADOW.FIT
    GUI.STASHED% = 0
    GUI.SAVE.W% = GUI.WIDTH% + GUI.SH.W% : GUI.SAVE.H% = GUI.HEIGHT% + GUI.SH.H%
    IF GUI.SAVEMODE% = GUI.SAVE.BANK THEN GOTO GUI.OPEN.SAVEBANK
    GOSUB SV.START
    IF SV.READY% = 0 THEN GOTO GUI.OPEN.DRAW
    SV.X% = GUI.LEFT% : SV.Y% = GUI.TOP% : SV.W% = GUI.SAVE.W% : SV.H% = GUI.SAVE.H%
    GOSUB SV.SAVE
    GUI.STASHED% = SV.HND%
    GOTO GUI.OPEN.DRAW
GUI.OPEN.SAVEBANK:
    IF GUI.BANK% = 0 THEN GOTO GUI.OPEN.DRAW
    IF 4 + 2 * GUI.SAVE.W% * GUI.SAVE.H% > GUI.STASHSIZE% THEN GOTO GUI.OPEN.DRAW
    STASH.SLOT = GUI.STASHADDR - $A000
    STASH.BANK = GUI.BANK% : STASH.X = GUI.LEFT% : STASH.Y = GUI.TOP% : STASH.W = GUI.SAVE.W% : STASH.H = GUI.SAVE.H%
    GOSUB STASH.SAVE : GUI.STASHED% = STASH.OK
GUI.OPEN.DRAW:  GUI.BOX.STYLE = GUI.STYLE
    IF GUI.BOX.STYLE = 0 THEN GUI.BOX.STYLE = GUI.LINEBOX
    GUI.PANEL% = GUI.PANEL.IN% :   IF GUI.PANEL% = 0 THEN GUI.PANEL% = THEME.CLR%(THEME.TEXT)
    GUI.BORDER% = GUI.BORDER.IN% : IF GUI.BORDER% = 0 THEN GUI.BORDER% = THEME.CLR%(THEME.BORDER)
    IF GUI.SHADOW% <> 0 THEN GOSUB GUI.SHADOW.DRAW
    GP.FILL GUI.LEFT%, GUI.TOP%, GUI.WIDTH%, GUI.HEIGHT%, GUI.SPACE, GUI.PANEL%
    IF GUI.GLYPH% <> 0 THEN GOSUB GUI.FRAME : GOTO GUI.OPEN.TITLE
## WARNING: GUI.STYLE and GUI.BOX.STYLE stay untyped. A style of 256 or more is a glyph
## address, an int16 holds one over 32,767 as negative, and GP.BOX then draws nothing.
    GP.BOX GUI.LEFT%, GUI.TOP%, GUI.WIDTH%, GUI.HEIGHT%, GUI.BOX.STYLE, GUI.BORDER%
GUI.OPEN.TITLE:
    IF GUI.TITLE$ <> "" THEN GUI.TITLE.LEFT% = GUI.LEFT% + INT((GUI.WIDTH% - LEN(GUI.TITLE$) - 2) / 2) : GP.PRINTAT GUI.TITLE.LEFT%, GUI.TOP%, " " + GUI.TITLE$ + " ", THEME.CLR%(THEME.TITLE)
    GUI.INNER.LEFT% = GUI.LEFT% + 1 + GUI.PADX : GUI.INNER.TOP% = GUI.TOP% + 1 + GUI.PADY
    IF GUI.MSG$ <> "" THEN GP.PRINTAT GUI.INNER.LEFT%, GUI.INNER.TOP%, GUI.MSG$, GUI.PANEL% : GUI.INNER.TOP% = GUI.INNER.TOP% + 1
    IF GUI.MSG2$ <> "" THEN GP.PRINTAT GUI.INNER.LEFT%, GUI.INNER.TOP%, GUI.MSG2$, GUI.PANEL% : GUI.INNER.TOP% = GUI.INNER.TOP% + 1
    IF GUI.MSG3$ <> "" THEN GP.PRINTAT GUI.INNER.LEFT%, GUI.INNER.TOP%, GUI.MSG3$, GUI.PANEL% : GUI.INNER.TOP% = GUI.INNER.TOP% + 1
    IF GUI.HEAD.ROWS% > 0 THEN GUI.INNER.TOP% = GUI.INNER.TOP% + 1
    RETURN

## GUI.SHADOW.FIT -- GUI.SH.W% (0-2) and GUI.SH.H% (0-1) trimmed to the screen
GUI.SHADOW.FIT:  GUI.SH.W% = GUI.SCREEN.COLS% - GUI.LEFT% - GUI.WIDTH%
    IF GUI.SH.W% > 2 THEN GUI.SH.W% = 2
    IF GUI.SH.W% < 0 THEN GUI.SH.W% = 0
    GUI.SH.H% = 1
    IF GUI.TOP% + GUI.HEIGHT% >= GUI.SCREEN.ROWS% THEN GUI.SH.H% = 0
    RETURN

## GUI.SHADOW.DRAW -- solid shadow right and below; GUI.CLOSE restores it
GUI.SHADOW.DRAW:
    IF GUI.SH.W% > 0 AND GUI.HEIGHT% > 1 THEN GP.FILL GUI.LEFT% + GUI.WIDTH%, GUI.TOP% + 1, GUI.SH.W%, GUI.HEIGHT% - 1, GUI.SPACE, GUI.SHADOW.ATTR%
    IF GUI.SH.H% = 0 THEN RETURN
    GUI.SH.BW% = GUI.WIDTH% + GUI.SH.W% - 2
    IF GUI.LEFT% + 2 + GUI.SH.BW% > GUI.SCREEN.COLS% THEN GUI.SH.BW% = GUI.SCREEN.COLS% - GUI.LEFT% - 2
    IF GUI.SH.BW% > 0 THEN GP.FILL GUI.LEFT% + 2, GUI.TOP% + GUI.HEIGHT%, GUI.SH.BW%, 1, GUI.SPACE, GUI.SHADOW.ATTR%
    RETURN

## GUI.FRAME -- GP.BOX from the six caller glyphs; tile indices, not PETSCII
GUI.FRAME:
    IF GUI.WIDTH% < 2 THEN RETURN
    IF GUI.HEIGHT% < 2 THEN RETURN
    GUI.RIGHT% = GUI.LEFT% + GUI.WIDTH% - 1 : GUI.BOTTOM% = GUI.TOP% + GUI.HEIGHT% - 1
    IF LEN(GUI.GLYPH$) <> 8 THEN GOSUB GUI.GLYPHS
    GP.BOX GUI.LEFT%, GUI.TOP%, GUI.WIDTH%, GUI.HEIGHT%, GP.STRPTR(GUI.GLYPH$) + 1, GUI.BORDER%
    RETURN

## GUI.GLYPHS -- pack TR TL BR BL H H V V into GUI.GLYPH$; set "" to rebuild
GUI.GLYPHS:  
    GUI.GLYPH$ = CHR$(GUI.CORNER.TR%) + CHR$(GUI.CORNER.TL%) + CHR$(GUI.CORNER.BR%) + CHR$(GUI.CORNER.BL%)
    GUI.GLYPH$ = GUI.GLYPH$ + CHR$(GUI.EDGE.H%) + CHR$(GUI.EDGE.H%) + CHR$(GUI.EDGE.V%) + CHR$(GUI.EDGE.V%)
    RETURN

## GUI.CLOSE -- restore the covered cells, if saved
GUI.CLOSE:
    IF GUI.STASHED% = 0 THEN RETURN
    IF GUI.SAVEMODE% = GUI.SAVE.BANK THEN GOTO GUI.CLOSE.BANK
    SV.HND% = GUI.STASHED% : SV.MOVE% = 0
    GOSUB SV.RESTORE
    GOSUB SV.FREE
    GUI.STASHED% = 0
    RETURN
GUI.CLOSE.BANK:
    STASH.SLOT = GUI.STASHADDR - $A000
    STASH.BANK = GUI.BANK% : STASH.MOVE = 0 : GOSUB STASH.RESTORE
    RETURN

## GUI.SIZE -- GUI.WIDTH% and GUI.HEIGHT% from the message and body
GUI.SIZE:  
    GUI.HEAD.ROWS% = 0
    IF GUI.MSG$ <> "" THEN GUI.HEAD.ROWS% = 1
    IF GUI.MSG2$ <> "" THEN GUI.HEAD.ROWS% = 2
    IF GUI.MSG3$ <> "" THEN GUI.HEAD.ROWS% = 3
    GUI.INNER.WIDTH% = GUI.BODY.WIDTH%
    IF LEN(GUI.MSG$) > GUI.INNER.WIDTH% THEN GUI.INNER.WIDTH% = LEN(GUI.MSG$)
    IF LEN(GUI.MSG2$) > GUI.INNER.WIDTH% THEN GUI.INNER.WIDTH% = LEN(GUI.MSG2$)
    IF LEN(GUI.MSG3$) > GUI.INNER.WIDTH% THEN GUI.INNER.WIDTH% = LEN(GUI.MSG3$)
    IF LEN(GUI.TITLE$) + 2 > GUI.INNER.WIDTH% THEN GUI.INNER.WIDTH% = LEN(GUI.TITLE$) + 2
    GUI.GAP.ROWS% = 0 : IF GUI.HEAD.ROWS% > 0 THEN GUI.GAP.ROWS% = 1
    GUI.WIDTH% = GUI.INNER.WIDTH% + GUI.PADX * 2 + 2 : GUI.HEIGHT% = GUI.HEAD.ROWS% + GUI.GAP.ROWS% + GUI.BODY.ROWS% + GUI.PADY * 2 + 2
    RETURN

## GUI.PLACE.BOX -- centre, or GUI.X%/GUI.Y%; clamp at 0
GUI.PLACE.BOX:  
    GOSUB GUI.SCREEN
    IF GUI.PLACE% <> 0 THEN GUI.LEFT% = GUI.X% : GUI.TOP% = GUI.Y% : GOTO GUI.PLACE.SCROLL
    GUI.LEFT% = INT((GUI.SCREEN.COLS% - GUI.WIDTH%) / 2) : GUI.TOP% = INT((GUI.SCREEN.ROWS% - GUI.HEIGHT%) / 2)
    IF GUI.LEFT% < 0 THEN GUI.LEFT% = 0
    IF GUI.TOP% < 0 THEN GUI.TOP% = 0
## row offset last, on both paths
GUI.PLACE.SCROLL:  GUI.TOP% = GUI.TOP% + GUI.ROW.OFFSET% : RETURN

## GUI.SCREEN -- GUI.SCREEN.COLS% and .ROWS from the KERNAL; 80x60 if nonsense
GUI.SCREEN:  
    GP.CALL GUI.SCRMODE, 0, 0, 0, 1
    GUI.SCREEN.COLS% = GP.X : GUI.SCREEN.ROWS% = GP.Y
    IF GUI.SCREEN.COLS% < 20 THEN GUI.SCREEN.COLS% = 80
    IF GUI.SCREEN.ROWS% < 8 THEN GUI.SCREEN.ROWS% = 60
    RETURN

GUI.MODULE.END:
#ENDIF
