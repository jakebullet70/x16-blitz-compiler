## ***********************************************************************
## **
## **  MENU.EXP.BL -- a whole small application, in the shape the GP set
## **  was designed for.
## **
## **  MENUVERT.*  the menu itself, in BASIC
## **  THEME.*     colour roles, in BASIC data
## **  APPSYS.*   leave the user's screen as you found it
## **  STASH.INC.BL  a dialog over the display, and the display back
## **
## **  Build:  copy GPB.INC.BL, THEME.INC.BL, APPSYS.INC.BL,
## **          MENUVERT.INC.BL and this file
## **          into testing/, then
## **            python source/gpc/build_basl.py MENU.EXP.BL MENU.PRG
## **          and compile MENU.PRG with GPC.BIN.
## **
## **  THE SPLIT IS THE POINT, and the menu has moved across it: this is all BASIC,
## **  because a menu waits on a HUMAN and the speed argument that puts sorting and
## **  screen copying in assembly does not apply. What stays in assembly is what BASIC is
## **  genuinely bad at -- GP.FILL and GP.PRINTAT pushing cells at VERA.
## **
## ***********************************************************************
## STASH.INC.BL reaches BASIC's variables from assembly through {VAR}, and
## that needs BASLOAD's record of the crunched names. Without this line the
## compile stops with "NO SYMBOL FILE FOR {}".
#SYMFILE "@:MENU.SYM"
#INCLUDE "GPB.INC.BL"
#INCLUDE "THEME.INC.BL"
#INCLUDE "APPSYS.INC.BL"
#INCLUDE "MENUVERT.INC.BL"
#INCLUDE "STASH.INC.BL"
#SAVEAS "@:MENU.PRG"

## #DEFINE substitutes at translation time, so these cost nothing at all --
## no variable, no lookup, and each compiles to a short constant.

#DEFINE MENU.LEFT 8
#DEFINE MENU.TOP 6
#DEFINE MENU.WIDE 24
#DEFINE MENU.COUNT 4

## ---- Remember the user's screen BEFORE changing anything, and lay out from what it
## ---- reports: the X16 boots 80x60 but SCREEN 0 is 40x30, so nothing below assumes.

GOSUB APPSYS.STARTUP

THEME.DARK = 0
GOSUB THEME.LOAD

DIM MENUVERT.ITEM$(MENU.COUNT)
MENUVERT.ITEM$(1) = " NEW GAME"
MENUVERT.ITEM$(2) = " LOAD"
MENUVERT.ITEM$(3) = " OPTIONS"
MENUVERT.ITEM$(4) = " QUIT"

MENUVERT.X = MENU.LEFT : MENUVERT.Y = MENU.TOP
MENUVERT.WIDTH = MENU.WIDE : MENUVERT.COUNT = MENU.COUNT
MENUVERT.ATTR = THEME.CLR(THEME.TEXT)
MENUVERT.HIATTR = THEME.CLR(THEME.HILITE)
MENUVERT.HOT$ = "NLOQ"
MENUVERT.FLAGS = MENUVERT.GAMEPAD

## ---- The main loop. MENUVERT.SEL is 0 when the user pressed ESC; here
## ---- there is nothing to back out to, so it just redraws.

MENU.MAIN:
    GOSUB MENU.DRAW
    GOSUB MENUVERT.RUN
    MENU.PICK = MENUVERT.SEL
    IF MENU.PICK = 0 THEN GOTO MENU.MAIN
    IF MENU.PICK = MENU.COUNT THEN GOTO MENU.QUIT
    GOSUB MENU.DIALOG
    GOTO MENU.MAIN

MENU.QUIT:
    GOSUB APPSYS.RESTORE
    PRINT "BYE"
    END

## ---- Drawing. Note there is no colour arithmetic anywhere: every colour
## ---- is a NAMED ROLE, so re-skinning the whole application is
## ---- THEME.DARK = 1 and nothing else.

MENU.DRAW:
    GP.FILL 0, 0, APPSYS.COLS, APPSYS.ROWS, ASC(" "), THEME.CLR(THEME.PAGE)
    GP.FILL 0, 0, APPSYS.COLS, 1, ASC(" "), THEME.CLR(THEME.TITLE)
    GP.PRINTAT 2, 0, "GP.BASIC DEMONSTRATION", THEME.CLR(THEME.TITLE)
    GP.BOX MENU.LEFT - 1, MENU.TOP - 1, MENU.WIDE + 2, MENU.COUNT + 2, 1, THEME.CLR(THEME.BORDER)
    GP.PRINTAT 2, APPSYS.ROWS - 1, "CURSOR KEYS, RETURN, OR N L O Q", THEME.CLR(THEME.DIMMED)
    RETURN

## ---- A dialog over the display. STASH.SAVE copies what is underneath into a RAM bank
## ---- and STASH.RESTORE puts it back, so the application never redraws itself -- the
## ---- entire reason the pair exists. The stash carries its own w, h, x and y, so the
## ---- restore is told nothing but the bank. This was GP.STASH / GP.RESTR until
## ---- 2026-09-01, when they moved into GP.ASM as GPC-BASIC/STASH.INC.BL.

MENU.DIALOG:
    STASH.BANK = 1
    STASH.X = 20 : STASH.Y = 10 : STASH.W = 36 : STASH.H = 5
    GOSUB STASH.SAVE
    GP.FILL 20, 10, 36, 5, ASC(" "), THEME.CLR(THEME.WARN)
    GP.BOX 20, 10, 36, 5, 3, THEME.CLR(THEME.WARN)
    GP.PRINTAT 22, 12, "CHOSE" + MENUVERT.ITEM$(MENU.PICK), THEME.CLR(THEME.WARN)
    GP.PRINTAT 22, 13, "PRESS ANY KEY", THEME.CLR(THEME.WARN)
MENU.DIALOG.WAIT:
    GET MENU.KEY$
    IF MENU.KEY$ = "" THEN GOTO MENU.DIALOG.WAIT
    GOSUB STASH.RESTORE
    RETURN
