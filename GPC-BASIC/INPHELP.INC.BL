## ***********************************************************************
## **
## **  INPHELP.INC.BL -- a positioned, length-limited entry field.
## **
## **      INPHELP.GET     edit a string in a field at x, y
## **      INPHELP.ASK     a label, then a field after it
## **
## **  What INPUT and LINPUT cannot do: both own the whole bottom of the screen, scroll
## **  it, echo in whatever colour is current and accept any length. A field stays where
## **  you put it, in the colour you give it, and stops at the width you allow.
## **
## **  Usage:
## **      INPHELP.X = 10 : INPHELP.Y = 6
## **      INPHELP.LEN = 20
## **      INPHELP.ATTR = THEME.CLR(THEME.TEXT)
## **      INPHELP.TEXT$ = ""
## **      GOSUB INPHELP.GET
## **      IF INPHELP.KEY = 27 THEN <cancelled>
## **
## **   in   INPHELP.X  INPHELP.Y     top left of the field
## **        INPHELP.LEN               how many characters fit
## **        INPHELP.ATTR              packed attribute, background * 16 + fg
## **        INPHELP.TEXT$             the starting value, edited in place
## **        INPHELP.MASK              non-zero shows asterisks
## **        INPHELP.LABEL$            INPHELP.ASK only
## **
## **   out  INPHELP.TEXT$             what was typed. ESC restores what it
## **                                  was when you called, so a cancelled
## **                                  field is not a silently emptied one
## **        INPHELP.KEY               the key that ended it:
## **                                     13  RETURN, finished
## **                                     27  ESC, cancelled (3 is STOP)
## **                                     17  cursor down / 145 up / 9 TAB
## **                                         -- left the field, text kept
## **
## **  So a form is a loop: call the field, look at INPHELP.KEY, move the focus. The
## **  field never scrolls -- when full, further characters are refused and the cursor
## **  sits on the last one rather than off the end.
## **
## **  THE CARET MOVES: LEFT and RIGHT walk it, HOME and END jump to the ends, typing
## **  INSERTS where it stands and DEL rubs out what is before it. It starts after the
## **  last character, so a caller that never presses an arrow sees exactly the old
## **  append-and-rub-out field.
## **
## **   also out  INPHELP.POS   where the caret ended up, 0..LEN(TEXT$)
## **
## **  The whole INPHELP.* name space belongs to this file.
## **
## ***********************************************************************
#IFNDEF INPHELP.DEFS
#DEFINE INPHELP.DEFS 1

#DEFINE INPHELP.RETURN 13
#DEFINE INPHELP.DELETE 20
#DEFINE INPHELP.ESCAPE 27
#DEFINE INPHELP.STOP 3
#DEFINE INPHELP.SPACE 32
#DEFINE INPHELP.STAR 42

## The keys that LEAVE a field without cancelling it, so a form can move between
## fields. The text is kept -- only ESC puts it back -- and INPHELP.KEY says which way
## to go. Without these RETURN would have to mean both "next field" and "done", and a
## form could never go back up.
#DEFINE INPHELP.DOWN 17
#DEFINE INPHELP.UP 145
#DEFINE INPHELP.TAB 9

## The keys that move the CARET inside the field, as opposed to leaving it.
#DEFINE INPHELP.LEFT 157
#DEFINE INPHELP.RIGHT 29
#DEFINE INPHELP.HOME 19
#DEFINE INPHELP.END 4

## Jiffies between cursor flips: 60 to the second, so 15 is four a second.
#DEFINE INPHELP.BLINK 15

GOTO INPHELP.MODULE.END

## ***********************************************************************
## **  INPHELP.GET -- the field.
## ***********************************************************************

INPHELP.GET:
    INPHELP.INV = (INPHELP.ATTR AND 15) * 16 + INT(INPHELP.ATTR / 16)
    INPHELP.WAS$ = INPHELP.TEXT$
    INPHELP.POS = LEN(INPHELP.TEXT$)
    INPHELP.DONE = 0 : INPHELP.KEY = 0
    INPHELP.LIT = 1  : INPHELP.TICK = TI

INPHELP.REDRAW:
    GOSUB INPHELP.RENDER
    GP.FILL INPHELP.X, INPHELP.Y, INPHELP.LEN, 1, INPHELP.SPACE, INPHELP.ATTR
    IF INPHELP.SHOW$ <> "" THEN GP.PRINTAT INPHELP.X, INPHELP.Y, INPHELP.SHOW$, INPHELP.ATTR
    GOSUB INPHELP.CURSOR

## ---- GET returns immediately with "" when nothing is pressed, so the blink runs off
## ---- TI rather than a delay loop, which would swallow keys pressed during it.

INPHELP.WAIT:
    GET INPHELP.K$
    IF INPHELP.K$ <> "" THEN GOTO INPHELP.KEYED
    IF TI < INPHELP.TICK THEN GOTO INPHELP.WAIT
    INPHELP.TICK = TI + INPHELP.BLINK
    INPHELP.LIT = 1 - INPHELP.LIT
    GOSUB INPHELP.CURSOR : GOTO INPHELP.WAIT

## ---- Seven control codes scattered across 256, which ON x GOSUB cannot index: the
## ---- sparse selector GP.SELECT exists for. INPHELP.DONE is tested AFTER GP.ENDSEL
## ---- rather than jumping out of the select -- one comparison, and it cannot leak.

INPHELP.KEYED:
    INPHELP.CODE = ASC(INPHELP.K$)
    GP.SELECT INPHELP.CODE
        GP.CASE INPHELP.RETURN
            INPHELP.DONE = 1
        GP.CASE INPHELP.ESCAPE, INPHELP.STOP
            INPHELP.TEXT$ = INPHELP.WAS$
            INPHELP.POS = LEN(INPHELP.TEXT$)
            INPHELP.DONE = 1
        GP.CASE INPHELP.DOWN, INPHELP.UP, INPHELP.TAB
            INPHELP.DONE = 1
        GP.CASE INPHELP.LEFT
            IF INPHELP.POS > 0 THEN INPHELP.POS = INPHELP.POS - 1
        GP.CASE INPHELP.RIGHT
            IF INPHELP.POS < LEN(INPHELP.TEXT$) THEN INPHELP.POS = INPHELP.POS + 1
        GP.CASE INPHELP.HOME
            INPHELP.POS = 0
        GP.CASE INPHELP.END
            INPHELP.POS = LEN(INPHELP.TEXT$)
        GP.CASE INPHELP.DELETE
            GOSUB INPHELP.RUBOUT
        GP.OTHER
            GOSUB INPHELP.TYPED
    GP.ENDSEL
    INPHELP.KEY = INPHELP.CODE
    IF INPHELP.DONE = 0 THEN GOTO INPHELP.REDRAW

## ---- Redraw once with no cursor, so a finished field is not still blinking at a user
## ---- who has moved on.

    INPHELP.LIT = 0
    GOSUB INPHELP.RENDER
    GP.FILL INPHELP.X, INPHELP.Y, INPHELP.LEN, 1, INPHELP.SPACE, INPHELP.ATTR
    IF INPHELP.SHOW$ <> "" THEN GP.PRINTAT INPHELP.X, INPHELP.Y, INPHELP.SHOW$, INPHELP.ATTR
    RETURN

## ---- A label, then a field after it. INPHELP.X is put back on the way out, so calling
## ---- this in a loop does not walk the field across the screen.

## ---- INPHELP.SAVEX, NOT INPHELP.HOME: that name is #DEFINEd as 19, so this line
## ---- compiled as "19 = INPHELP.X" -- a syntax error, which DEFERS. The compile said
## ---- OK CODE and ASK would have thrown SYNTAX ERROR the first time it was called.
## ---- Nothing in the tree calls ASK, which is the only reason it went unseen.
INPHELP.ASK:
    INPHELP.SAVEX = INPHELP.X
    GP.PRINTAT INPHELP.X, INPHELP.Y, INPHELP.LABEL$, INPHELP.ATTR
    INPHELP.X = INPHELP.X + LEN(INPHELP.LABEL$)
    GOSUB INPHELP.GET
    INPHELP.X = INPHELP.SAVEX
    RETURN

## ***********************************************************************
## **  INPHELP.TYPED -- accept a printable character, if there is room.
## **
## **  Written as separate IFs rather than one ANDed condition on purpose:
## **  AND sits BELOW the comparisons in the precedence table, so a single
## **  line would be reading correctly by luck rather than by design, and it
## **  is the kind of thing that only shows up on the one code it gets
## **  wrong. $80-$9F are the PETSCII control codes -- colours, cursor
## **  moves, reverse on and off -- and putting one in a string means it
## **  takes effect on the way out, which is why they are refused here.
## ***********************************************************************

INPHELP.TYPED:
    IF LEN(INPHELP.TEXT$) >= INPHELP.LEN THEN RETURN
    IF INPHELP.CODE < 32 THEN RETURN
    IF INPHELP.CODE = 127 THEN RETURN
    INPHELP.BAR = 0
    IF INPHELP.CODE > 127 THEN INPHELP.BAR = 1
    IF INPHELP.CODE > 159 THEN INPHELP.BAR = 0
    IF INPHELP.BAR = 1 THEN RETURN

## ---- INSERTED AT THE CARET, not appended. With the caret at the end --
## ---- where it starts, and where it stays unless someone moves it --
## ---- LEFT$ is the whole string and MID$ past the end is "", so this is
## ---- the old append with two joins nobody asked for. That is the price
## ---- of the caret, and it is paid per keystroke, on a human's timescale.
    INPHELP.TEXT$ = LEFT$(INPHELP.TEXT$, INPHELP.POS) + INPHELP.K$ + MID$(INPHELP.TEXT$, INPHELP.POS + 1)
    INPHELP.POS = INPHELP.POS + 1
    RETURN

## ***********************************************************************
## **  INPHELP.RUBOUT -- DEL takes the character BEFORE the caret.
## **
## **  Which is what DEL has always meant, and what the old code did by
## **  accident: with the caret at the end, "before the caret" IS "off the
## **  end". At the start of the field there is nothing before it, so DEL
## **  is ignored rather than wrapping round to eat the last character.
## ***********************************************************************

INPHELP.RUBOUT:
    IF INPHELP.POS = 0 THEN RETURN
    INPHELP.TEXT$ = LEFT$(INPHELP.TEXT$, INPHELP.POS - 1) + MID$(INPHELP.TEXT$, INPHELP.POS + 1)
    INPHELP.POS = INPHELP.POS - 1
    RETURN

## ---- What the field displays, which is not always what it holds.
## ---- RPT$ raises an error on a count of zero, hence the guard.

INPHELP.RENDER:
    INPHELP.SHOW$ = INPHELP.TEXT$
    IF INPHELP.MASK = 0 THEN RETURN
    INPHELP.SHOW$ = ""
    IF LEN(INPHELP.TEXT$) > 0 THEN INPHELP.SHOW$ = RPT$(INPHELP.STAR, LEN(INPHELP.TEXT$))
    RETURN

## ***********************************************************************
## **  INPHELP.CURSOR -- one cell, drawn twice a blink.
## **
## **  With room left it is an inverse space after the text. With the field
## **  full there is no cell after the text, so it inverts the LAST
## **  CHARACTER instead of blanking it -- printing the character back in
## **  the inverse attribute, which says "full" without losing anything off
## **  the display.
## ***********************************************************************

INPHELP.CURSOR:
    INPHELP.FILLED = LEN(INPHELP.SHOW$)
    INPHELP.CP = INPHELP.POS
    IF INPHELP.CP > INPHELP.FILLED THEN INPHELP.CP = INPHELP.FILLED
    INPHELP.CX = INPHELP.X + INPHELP.CP
    INPHELP.CELL$ = " "

## ---- ON a character, the cursor IS that character, drawn inverse on the
## ---- lit half of the blink and normal on the other -- so the blink puts
## ---- back exactly what it covered and nothing has to be remembered.
    IF INPHELP.CP < INPHELP.FILLED THEN INPHELP.CELL$ = MID$(INPHELP.SHOW$, INPHELP.CP + 1, 1)
    IF INPHELP.CP >= INPHELP.LEN THEN INPHELP.CX = INPHELP.X + INPHELP.LEN - 1
    IF INPHELP.CP >= INPHELP.LEN THEN INPHELP.CELL$ = RIGHT$(INPHELP.SHOW$, 1)
    INPHELP.CA = INPHELP.ATTR
    IF INPHELP.LIT = 1 THEN INPHELP.CA = INPHELP.INV
    GP.PRINTAT INPHELP.CX, INPHELP.Y, INPHELP.CELL$, INPHELP.CA
    RETURN

INPHELP.MODULE.END:
#ENDIF
