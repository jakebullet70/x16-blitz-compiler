## ***********************************************************************
## **
## **  MENUHELP.INC.BL -- a vertical menu, in BASIC.
## **
## **      MENUHELP.RUN    draw it, drive it, return the row chosen
## **      MENUHELP.DRAW   draw it without driving it
## **      MENUHELP.ROW    one row, in whichever attribute you name
## **
## **  THIS REPLACES THE GP.MENU KEYWORD, 462 bytes of assembly in a block every GPB
## **  program carried. It was assembly because the highlight had to move without the
## **  runtime knowing what text lay under it, so it swapped attribute nibbles rather
## **  than redrawing -- and a menu written in BASIC OWNS the item array, so it can
## **  just print the row again. Redrawing two rows costs about a millisecond against
## **  the swap's half, on a 16.7ms frame.
## **
## **  Usage:
## **      MENUHELP.X = 8 : MENUHELP.Y = 6
## **      MENUHELP.WIDTH = 24
## **      MENUHELP.COUNT = 4
## **      MENUHELP.ITEM$(1) = " NEW GAME"    ... and so on
## **      MENUHELP.ATTR = THEME.CLR(THEME.TEXT)
## **      MENUHELP.HIATTR = THEME.CLR(THEME.HILITE)
## **      MENUHELP.HOT$ = "NLOQ"
## **      MENUHELP.HOTATTR = THEME.CLR(THEME.TITLE)
## **      MENUHELP.FLAGS = MENUHELP.GAMEPAD
## **      GOSUB MENUHELP.RUN
## **      IF MENUHELP.SEL = 0 THEN <cancelled>
## **
## **   in   MENUHELP.X        top left of the FIRST ROW, not of a frame. Draw the box
## **        MENUHELP.Y        yourself, so the menu owes nothing to one border style
## **        MENUHELP.WIDTH    cells wide -- the width of the HIGHLIGHT, and so of the
## **                          menu, whatever the text happens to do
## **        MENUHELP.COUNT    how many rows
## **        MENUHELP.ITEM$()  the rows, 1..COUNT. THE CALLER OWNS THE DIM, below
## **        MENUHELP.ATTR     packed attribute, background * 16 + fg
## **        MENUHELP.HIATTR   the same for the highlighted row. 0 means "invert
## **                          MENUHELP.ATTR", which is what GP.MENU always did
## **        MENUHELP.HOT$     one character a row, "" for none. Matched WITHOUT case,
## **                          and a hotkey CHOOSES its row rather than moving to it
## **        MENUHELP.HOTATTR  paint the hotkey LETTER in this attribute, so the
## **                          shortcut is visible instead of secret. 0 is off and is
## **                          the default. The letter is found in the row's own text,
## **                          so " START" with hotkey S needs no markup, and a row
## **                          not containing its hotkey is left alone. ONLY ROWS IN
## **                          THE NORMAL ATTRIBUTE ARE TINTED -- on the selected row
## **                          the highlight IS the message, and it also means this
## **                          never has to guess how to invert a caller's HIATTR
## **        MENUHELP.FLAGS    added together, see below
## **        MENUHELP.SEL      the row to start on; 0 starts at 1
## **
## **   out  MENUHELP.SEL      1..COUNT, or 0 if cancelled -- and under KEYEXIT,
## **                          whatever row was highlighted when the key arrived
## **        MENUHELP.KEY      the key that ended it: 13 chose, 27 cancelled, the
## **                          hotkey itself, or the key KEYEXIT is handing back
## **
## **  THE CALLER OWNS THE DIM, deliberately: a module cannot be handed an array, and
## **  DIMming one itself would mean guessing a bound and failing the caller who wanted
## **  more. Leave MENUHELP.ITEM$ undimensioned and GPC's implicit DIM gives 0..10 -- a
## **  ten row menu free. DIM it for more. What you must NOT do is both.
## **
## **  The whole MENUHELP.* name space belongs to this file.
## **
## ***********************************************************************
#IFNDEF MENUHELP.DEFS
#DEFINE MENUHELP.DEFS 1

## Flags. MUSTSEL takes ESC away, for a menu with nothing behind it. KEEPMARK leaves
## the chosen row highlighted, for a menu that stays up while the choice happens.
## NOWRAP stops at the ends, which suits a list that reads as a range. GAMEPAD ADDS the
## SNES pad in port 1 to the keyboard rather than replacing it, so a program never has
## to ask which the user has.
##
## KEYEXIT hands back a key this menu has no use for instead of swallowing it. A
## vertical menu ignores LEFT and RIGHT because they mean nothing on its axis -- but a
## caller that has put one UNDER A MENU BAR wants exactly those, and only the caller
## knows that. The key ends the menu with MENUHELP.KEY set and MENUHELP.SEL left ALONE.
## MENUBAR.DOWNEXIT is the same idea pointing the other way; between them a bar and its
## dropdown drive each other with neither module knowing the other exists. Off by
## default, because swallowing them is right for a menu that is only a menu.

#DEFINE MENUHELP.MUSTSEL 1
#DEFINE MENUHELP.KEEPMARK 2
#DEFINE MENUHELP.NOWRAP 4
#DEFINE MENUHELP.GAMEPAD 8
#DEFINE MENUHELP.KEYEXIT 64

## PETSCII, as GET reports it.

#DEFINE MENUHELP.DOWN 17
#DEFINE MENUHELP.UP 145
#DEFINE MENUHELP.ENTER 13
#DEFINE MENUHELP.ESCAPE 27
#DEFINE MENUHELP.STOP 3
#DEFINE MENUHELP.SPACE 32

## SNES port 1. Port 0 is the keyboard pretending to be a joystick, which would read the
## cursor keys twice.

#DEFINE MENUHELP.PORT 1

## The bits of JOY's low byte, already active high. Left and right are ignored rather
## than mapped to something invented.
##   $80 B   $10 START   $08 UP   $04 DOWN   $02 LEFT   $01 RIGHT

#DEFINE MENUHELP.PAD.UP 8
#DEFINE MENUHELP.PAD.DOWN 4
#DEFINE MENUHELP.PAD.B 128
#DEFINE MENUHELP.PAD.START 16

GOTO MENUHELP.MODULE.END

## ***********************************************************************
## **  MENUHELP.RUN -- the whole thing.
## ***********************************************************************

MENUHELP.RUN:
    MENUHELP.KEY = 0
    IF MENUHELP.COUNT < 1 THEN MENUHELP.SEL = 0 : RETURN

## ---- 0 for the highlight means "invert the normal attribute", as GP.MENU did.

    MENUHELP.HIGHLIGHT = MENUHELP.HIATTR
    IF MENUHELP.HIATTR = 0 THEN MENUHELP.HIGHLIGHT = (MENUHELP.ATTR AND 15) * 16 + INT(MENUHELP.ATTR / 16)

    IF MENUHELP.SEL < 1 THEN MENUHELP.SEL = 1
    IF MENUHELP.SEL > MENUHELP.COUNT THEN MENUHELP.SEL = MENUHELP.COUNT

    MENUHELP.PADHELD = 0 : GOSUB MENUHELP.DRAW
    MENUHELP.DRAWROW = MENUHELP.SEL : MENUHELP.DRAWATTR = MENUHELP.HIGHLIGHT
    GOSUB MENUHELP.ROW

## ---- GET returns immediately with "" when nothing is pressed, so the pad is polled in
## ---- the same loop. The keyboard is read FIRST, so a plugged-in pad never costs a
## ---- keystroke its response.

MENUHELP.WAIT:
    GET MENUHELP.INCHAR$
    IF MENUHELP.INCHAR$ <> "" THEN MENUHELP.CODE = ASC(MENUHELP.INCHAR$) : GOTO MENUHELP.KEYED
    IF (MENUHELP.FLAGS AND MENUHELP.GAMEPAD) = 0 THEN GOTO MENUHELP.WAIT
    GOSUB MENUHELP.PADKEY
    IF MENUHELP.CODE = 0 THEN GOTO MENUHELP.WAIT

## ---- One key: five control codes scattered across 256 with everything else falling
## ---- through to the hotkeys, which is the sparse selector GP.SELECT exists for.
## ---- MENUHELP.DONE is tested AFTER GP.ENDSEL rather than jumping out of the select --
## ---- one comparison, and it cannot leak whatever the runtime does later.

MENUHELP.KEYED:
    MENUHELP.DONE = 0
    MENUHELP.PREVSEL = MENUHELP.SEL
    GP.SELECT MENUHELP.CODE
        GP.CASE MENUHELP.UP
            MENUHELP.SEL = MENUHELP.SEL - 1
            IF MENUHELP.SEL < 1 THEN GOSUB MENUHELP.WRAPTOP
        GP.CASE MENUHELP.DOWN
            MENUHELP.SEL = MENUHELP.SEL + 1
            IF MENUHELP.SEL > MENUHELP.COUNT THEN GOSUB MENUHELP.WRAPBOT
        GP.CASE MENUHELP.ENTER
            MENUHELP.DONE = 1
        GP.CASE MENUHELP.ESCAPE, MENUHELP.STOP
            GOSUB MENUHELP.CANCEL
        GP.OTHER
            GOSUB MENUHELP.HOTKEY
            IF MENUHELP.DONE = 0 THEN GOSUB MENUHELP.KEYBACK
    GP.ENDSEL

## ---- Move the highlight only if it actually moved: two rows, and the old one goes back
## ---- to exactly what MENUHELP.DRAW put there, both coming from MENUHELP.ROW.

    IF MENUHELP.SEL = MENUHELP.PREVSEL THEN GOTO MENUHELP.SETTLE
    IF MENUHELP.PREVSEL < 1 THEN GOTO MENUHELP.SETTLE
    MENUHELP.DRAWROW = MENUHELP.PREVSEL : MENUHELP.DRAWATTR = MENUHELP.ATTR
    GOSUB MENUHELP.ROW
    IF MENUHELP.SEL < 1 THEN GOTO MENUHELP.SETTLE
    MENUHELP.DRAWROW = MENUHELP.SEL : MENUHELP.DRAWATTR = MENUHELP.HIGHLIGHT
    GOSUB MENUHELP.ROW

MENUHELP.SETTLE:
    IF MENUHELP.DONE = 0 THEN GOTO MENUHELP.WAIT
    MENUHELP.KEY = MENUHELP.CODE

## ---- Unless KEEPMARK is set the highlight comes off, so a menu that has done its job
## ---- is not still claiming the user's attention.

    IF (MENUHELP.FLAGS AND MENUHELP.KEEPMARK) <> 0 THEN RETURN
    IF MENUHELP.SEL < 1 THEN RETURN
    MENUHELP.DRAWROW = MENUHELP.SEL : MENUHELP.DRAWATTR = MENUHELP.ATTR
    GOSUB MENUHELP.ROW
    RETURN

## ***********************************************************************
## **  The three things the selector's cases needed a subroutine for. Wrapping is one
## **  because the no-wrap answer is not "stay put" but "go to the end you are at", and
## **  MENUHELP.SEL has already been stepped past it -- two statements either way.
## ***********************************************************************

MENUHELP.WRAPTOP:
    MENUHELP.SEL = MENUHELP.COUNT
    IF (MENUHELP.FLAGS AND MENUHELP.NOWRAP) <> 0 THEN MENUHELP.SEL = 1
    RETURN

MENUHELP.WRAPBOT:
    MENUHELP.SEL = 1
    IF (MENUHELP.FLAGS AND MENUHELP.NOWRAP) <> 0 THEN MENUHELP.SEL = MENUHELP.COUNT
    RETURN

## ---- MUSTSEL swallows ESC entirely, without a beep or a flash: a menu that cannot be
## ---- left says so by not leaving.

MENUHELP.CANCEL:
    IF (MENUHELP.FLAGS AND MENUHELP.MUSTSEL) <> 0 THEN RETURN
    MENUHELP.SEL = 0 : MENUHELP.DONE = 1 : RETURN

## ---- KEYEXIT leaves MENUHELP.SEL ALONE, which is the whole difference from ESC
## ---- returning 0: it lets a caller tell "went elsewhere, from row 3" from
## ---- "cancelled". Reached only when the hotkeys did not claim the key.

MENUHELP.KEYBACK:
    IF (MENUHELP.FLAGS AND MENUHELP.KEYEXIT) <> 0 THEN MENUHELP.DONE = 1
    RETURN

## ***********************************************************************
## **  MENUHELP.HOTKEY -- anything that was not a cursor key.
## **
## **  Matched without case by folding both sides to upper -- the same a-z-only fold
## **  GP.COMP uses, so digits, punctuation and PETSCII graphics can all be hotkeys.
## **
## **  The scan stops at MENUHELP.COUNT even when MENUHELP.HOT$ is longer, so a hotkey
## **  string left over from a longer menu cannot select a row that is not on screen.
## ***********************************************************************

MENUHELP.HOTKEY:
    IF MENUHELP.HOT$ = "" THEN RETURN
    MENUHELP.HOTLAST = LEN(MENUHELP.HOT$)
    IF MENUHELP.HOTLAST > MENUHELP.COUNT THEN MENUHELP.HOTLAST = MENUHELP.COUNT
    MENUHELP.WANTCODE = MENUHELP.CODE
    IF MENUHELP.WANTCODE > 96 THEN GOSUB MENUHELP.FOLDWANT
    FOR MENUHELP.SCAN = 1 TO MENUHELP.HOTLAST
        MENUHELP.HOTCODE = ASC(MID$(MENUHELP.HOT$, MENUHELP.SCAN, 1))
        IF MENUHELP.HOTCODE > 96 THEN GOSUB MENUHELP.FOLDHC
        IF MENUHELP.HOTCODE = MENUHELP.WANTCODE THEN MENUHELP.SEL = MENUHELP.SCAN : MENUHELP.DONE = 1
    NEXT
    RETURN

## ---- A GUARDED SUBROUTINE, NOT ONE ANDed LINE: AND sits BELOW the comparisons in the
## ---- precedence table, so the single line version would be right by luck. The caller
## ---- has already established the value is above 96.

MENUHELP.FOLDWANT:
    IF MENUHELP.WANTCODE < 123 THEN MENUHELP.WANTCODE = MENUHELP.WANTCODE - 32
    RETURN

MENUHELP.FOLDHC:
    IF MENUHELP.HOTCODE < 123 THEN MENUHELP.HOTCODE = MENUHELP.HOTCODE - 32
    RETURN

## ***********************************************************************
## **  MENUHELP.PADKEY -- the SNES pad as a key code.
## **
## **  ONLY NEW PRESSES ACT. Without the edge test a held direction runs the menu round
## **  and round at the speed of the BASIC loop, far too fast to stop where you meant.
## **  B and START both choose, whichever a player reaches for.
## **
## **  out  MENUHELP.CODE   a PETSCII code, or 0 for nothing new
## ***********************************************************************

MENUHELP.PADKEY:
    MENUHELP.CODE = 0
    GOSUB MENUHELP.PADREAD
    MENUHELP.PADNEW = MENUHELP.PADNOW AND (255 - MENUHELP.PADHELD)
    MENUHELP.PADHELD = MENUHELP.PADNOW
    IF (MENUHELP.PADNEW AND MENUHELP.PAD.UP) <> 0 THEN MENUHELP.CODE = MENUHELP.UP : RETURN
    IF (MENUHELP.PADNEW AND MENUHELP.PAD.DOWN) <> 0 THEN MENUHELP.CODE = MENUHELP.DOWN : RETURN
    IF (MENUHELP.PADNEW AND MENUHELP.PAD.B) <> 0 THEN MENUHELP.CODE = MENUHELP.ENTER : RETURN
    IF (MENUHELP.PADNEW AND MENUHELP.PAD.START) <> 0 THEN MENUHELP.CODE = MENUHELP.ENTER
    RETURN

## ---- JOY IS A GPC BUILT IN and does all of this: joystick_get, the no-hardware test,
## ---- and inverting both bytes so what comes back is active HIGH.
## ----
## ---- NEGATIVE MEANS NO PAD, and it has to be tested: with no pad the raw bytes are
## ---- $FF, inverted that is 0, and the value would look like a pad with nothing
## ---- pressed -- right only by accident.
## ----
## ---- The low byte is extracted by DIVISION, not "AND 255": AND is 16-bit SIGNED in
## ---- GPC and both pad bytes together run past 32767.

MENUHELP.PADREAD:
    MENUHELP.PADNOW = 0 : MENUHELP.PADRAW = JOY(MENUHELP.PORT)
    IF MENUHELP.PADRAW < 0 THEN RETURN
    MENUHELP.PADNOW = MENUHELP.PADRAW - INT(MENUHELP.PADRAW / 256) * 256
    RETURN

## ***********************************************************************
## **  MENUHELP.DRAW -- every row, unhighlighted.
## **
## **  Public, for a caller that put a dialog over the menu without stashing what was
## **  underneath. ROWS ONLY, never a frame, so calling it again cannot damage a border.
## ***********************************************************************

MENUHELP.DRAW:
    FOR MENUHELP.EACH = 1 TO MENUHELP.COUNT
        MENUHELP.DRAWROW = MENUHELP.EACH : MENUHELP.DRAWATTR = MENUHELP.ATTR
        GOSUB MENUHELP.ROW
    NEXT
    RETURN

## ***********************************************************************
## **  MENUHELP.ROW -- one row, filled then printed.
## **
## **   in   MENUHELP.DRAWROW    the row, 1..N        MENUHELP.DRAWATTR   the attribute
## **
## **  THE FILL IS WHAT MAKES THE HIGHLIGHT FULL WIDTH, and why no padded string is
## **  built: GP.FILL colours all W cells at 31 cycles each, where
## **  LEFT$(item$ + "        ", W) would allocate a string on every keystroke.
## **
## **  Text longer than W is cut, and ONLY then -- the trim costs an allocation. Without
## **  it the overflow does not stop at the menu's edge; VERA carries on into the next
## **  cells, which is the next line of the screen.
## ***********************************************************************

MENUHELP.ROW:
    MENUHELP.DRAWY = MENUHELP.Y + MENUHELP.DRAWROW - 1
    GP.FILL MENUHELP.X, MENUHELP.DRAWY, MENUHELP.WIDTH, 1, MENUHELP.SPACE, MENUHELP.DRAWATTR
    MENUHELP.DRAWTEXT$ = MENUHELP.ITEM$(MENUHELP.DRAWROW)
    IF MENUHELP.DRAWTEXT$ = "" THEN RETURN
    IF LEN(MENUHELP.DRAWTEXT$) > MENUHELP.WIDTH THEN MENUHELP.DRAWTEXT$ = LEFT$(MENUHELP.DRAWTEXT$, MENUHELP.WIDTH)
    GP.PRINTAT MENUHELP.X, MENUHELP.DRAWY, MENUHELP.DRAWTEXT$, MENUHELP.DRAWATTR

## ---- The hotkey letter over the row just printed: one cell, and only when asked for --
## ---- a menu with no HOTATTR pays one compare a row. The highlighted row is skipped by
## ---- testing the attribute it was drawn in; see the interface block for why.

    IF MENUHELP.HOTATTR = 0 THEN RETURN
    IF MENUHELP.DRAWATTR <> MENUHELP.ATTR THEN RETURN
    GOSUB MENUHELP.HOTFIND
    IF MENUHELP.HOTAT = 0 THEN RETURN
    GP.PRINTAT MENUHELP.X + MENUHELP.HOTAT - 1, MENUHELP.DRAWY, MID$(MENUHELP.DRAWTEXT$, MENUHELP.HOTAT, 1), MENUHELP.HOTATTR
    RETURN

## ***********************************************************************
## **  MENUHELP.HOTFIND -- where this row's hotkey letter sits in its text.
## **
## **   in   MENUHELP.DRAWROW  MENUHELP.DRAWTEXT$
## **   out  MENUHELP.HOTAT    1 based position, or 0 for "do not tint"
## **
## **  Zero for every ordinary reason a tint should not happen: no hotkey string, none
## **  for THIS row, or a row whose text does not contain its own hotkey -- that last
## **  being a caller's choice, since " QUIT" with hotkey X still works as a hotkey.
## **
## **  ITS OWN SCAN VARIABLES, not MENUHELP.HOTKEY's. The two never run at once today,
## **  but sharing a loop counter is a trap set for whoever changes that order.
## ***********************************************************************

MENUHELP.HOTFIND:
    MENUHELP.HOTAT = 0
    IF MENUHELP.HOT$ = "" THEN RETURN
    IF MENUHELP.DRAWROW > LEN(MENUHELP.HOT$) THEN RETURN
    MENUHELP.HOTWANT = ASC(MID$(MENUHELP.HOT$, MENUHELP.DRAWROW, 1))
    IF MENUHELP.HOTWANT > 96 THEN GOSUB MENUHELP.FOLDHOTWANT
    FOR MENUHELP.HOTSCAN = 1 TO LEN(MENUHELP.DRAWTEXT$)
        MENUHELP.HOTHERE = ASC(MID$(MENUHELP.DRAWTEXT$, MENUHELP.HOTSCAN, 1))
        IF MENUHELP.HOTHERE > 96 THEN GOSUB MENUHELP.FOLDHOTHERE
        IF MENUHELP.HOTHERE = MENUHELP.HOTWANT AND MENUHELP.HOTAT = 0 THEN MENUHELP.HOTAT = MENUHELP.HOTSCAN
    NEXT
    RETURN

## ---- Guarded subroutines, not ANDed lines -- see the note at MENUHELP.FOLDWANT.

MENUHELP.FOLDHOTWANT:
    IF MENUHELP.HOTWANT < 123 THEN MENUHELP.HOTWANT = MENUHELP.HOTWANT - 32
    RETURN

MENUHELP.FOLDHOTHERE:
    IF MENUHELP.HOTHERE < 123 THEN MENUHELP.HOTHERE = MENUHELP.HOTHERE - 32
    RETURN

MENUHELP.MODULE.END:
#ENDIF
