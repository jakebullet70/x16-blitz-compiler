# *******************************************************************************************
# *******************************************************************************************
#
#       Name :      commands.def
#       Purpose :   Command processor
#       Date :      16th April 2023
#       Author :    Paul Robson T(paul@robsons.org.uk)
#
# *******************************************************************************************
# *******************************************************************************************
#
#		Routines do all the work
#
GO 				X:CommandGOAlt N
GOTO 			X:CommandGOTO N
GOSUB 			X:CommandGOSUB N
RESTORE 		X:CommandRESTORE N
LET 			X:CommandLET N
INPUT 			X:CommandINPUT N
INPUT# 			C:CommandINPUTStream N
PRINT 			X:CommandPRINT N
PRINT# 			C:CommandPRINT N
REM 			X:CommandREM N
FOR 			X:CommandFOR N
NEXT 			X:CommandNEXT N
GET 			X:CommandGET N
DATA 			X:CommandDATA N
READ 			X:CommandREAD N
DIM 			X:CommandDIM N
DEF 			X:CommandDEF N
#
#		Routine supported
#
IF 				# X:CommandIF N
WAIT 			#,# X:CommandWAIT N
ON 				# T X:CommandON N
#
#		Controls
#
SYS 			# T N
POKE 			#,# T N
#
#		Token only
#
RETURN 			T N
STOP 			T N
END 			T N
#
#		CLR clears every variable and array (and resets the string heap and BASIC stack) at
#		runtime. The runtime handler (CommandClr -> ClearMemory) already existed and is already
#		vectored via its ;; [!CLR] marker -- this command-table line, emitting the shifted CLR
#		token, was the only missing piece. Token only, no operands, like RETURN/STOP/END.
#
CLR 			X:CommandClrCompile T N
#
#		GP.BASIC counted loop -- GP.DO <count> ... GP.LOOP, modelled on prog8's "repeat" and
#		named after CBM BASIC 7.0's DO/LOOP. Both are pure table entries: no compiler routine
#		exists for either, because neither has anything to compile beyond its argument.
#
#		GP.DO reuses OptionalNumberCompile (the bare-SLEEP helper) verbatim: it pushes 0 when
#		the count is omitted, and a count of 0 is exactly what the runtime reads as "forever".
#
GP.DO 			X:OptionalNumberCompile T X:BlockDepthUp N
GP.LOOP 		T X:BlockDepthDown N
#
#		GP.EXITDO has no "T": .exitdo is a SYSTEM token carrying a two byte branch offset, and the
#		table cannot reserve operand space. CommandExitDoCompile writes token and placeholder both.
#
GP.EXITDO 		X:CommandExitDoCompile N
#
#		GP.BASIC multi-way branch, modelled on prog8's "when". Like GP.EXITDO, none of these can
#		carry a "T": three write a system token with an inline branch offset, and GP.CASE writes
#		a variable number of tokens depending on how many alternatives it is given, so each
#		routine writes everything itself.
#
GP.SELECT 		X:CommandSelectCompile N
GP.CASE 		X:CommandCaseCompile N
GP.OTHER 		X:CommandOtherCompile N
GP.ENDSEL 		X:CommandEndSelectCompile N

#
#		GP.BASIC block IF -- GP.IF <expr> THEN / GP.ELSEIF <expr> THEN / GP.ELSE / GP.ENDIF,
#		each ALONE ON ITS LINE; the THEN is required and nothing may follow it. Like GP.SELECT
#		none of these can carry a "T": two write a SYSTEM token with an inline branch offset,
#		and the other two are markers written by hand beside them. No stack frame -- see
#		commands/gpif.asm for why, and for why GP.ELSEIF is what forces gp.if to exist.
#
GP.IF 			X:CommandIfCompile N
GP.ELSEIF 		X:CommandElseIfCompile N
GP.ELSE 		X:CommandElseCompile N
GP.ENDIF 		X:CommandEndIfCompile N

#
#		GP.ASM / GP.ENDASM -- inline 65C02 assembly. The body rides in REM statements, one
#		instruction per line, and is assembled at compile time. GP.ASM reads its own source
#		lines through to the GP.ENDASM, so GP.ENDASM's entry here is only ever reached by a
#		stray one and exists to name that as an error rather than let it fall through to a
#		syntax error that says nothing.
#
#		No "T" on either: neither writes a keyword token: the block lowers onto opcodes that
#		already exist and whose handlers are all below GPBase, so a program whose only
#		GP.BASIC keyword is GP.ASM stays GP OUT and pays nothing for the GP runtime block.
#
GP.ASM 			X:CommandAsmCompile N
GP.ENDASM 		X:CommandEndAsmCompile N
#
#		GP.BANKED <bank> / GP.ENDBANKED -- mark a run of p-code as belonging at $A000 in a RAM
#		bank. NO "#" ON GP.BANKED: its operand is a DECIMAL CONSTANT read by the handler, not an
#		expression compiled to p-code -- the number is patched into the program's bootstrap.
#		Compile time markers, alone on their line, no operand. No "T" on either: they write no
#		keyword token at all, so ScanGPUsage cannot see them and a program whose only GP.BASIC
#		keyword is GP.BANKED stays GP OUT -- GP.ASM's argument, for the same reason.
#
GP.BANKED 		X:CommandGPBankedCompile N
GP.ENDBANKED 	X:CommandGPEndBankedCompile N
#
#		GP.CALL <addr> [,a] [,x] [,y] [,c] -- call machine code with the registers set. Results
#		come back through the GP.A/GP.X/GP.Y/GP.C value words (x16_unary.def), which are ordinary
#		tokens, NOT variables: nothing lets the runtime write a variable by name, and X16's own
#		ST/MX/MY are tokens for exactly the same reason.
#
GP.CALL 		# X:OptionalZeroCompile X:OptionalZeroCompile X:OptionalZeroCompile X:OptionalZeroCompile T N
#
#		GP.TRIM / GP.LTRIM / GP.RTRIM / GP.UPPER / GP.LOWER were here, and are
#		GPC-BASIC/STRCASE.INC.BL now -- GP.ASM, driven by GP.STRPTR. They were 188 bytes of the
#		block, with one caller in the tree outside their own example. X:StringVariableCompile
#		went with them; the guarantee it gave -- a literal can never reach the handler -- is the
#		one thing the move gives up, because a GOSUB has no call site for the compiler to check.
#
#
#		GP.SORT was here. It is GPC-BASIC/SORT.INC.BL now, written in GP.ASM, because the GP block
#		is all or nothing and 408 of its bytes were a sort that most programs never call. The
#		module is the same shell sort with the same Ciura gaps and is checked element for element
#		against what this keyword used to produce (GPC-BASIC/SORT.EXP.BL).
#
#		It was the only caller of X:StringArrayCompile, which has gone with it. X:AnyArrayCompile
#		in unary.def is the survivor of that pair and is what GP.ARRPTR uses.
