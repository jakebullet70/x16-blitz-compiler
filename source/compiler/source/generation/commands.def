# *******************************************************************************************
# *******************************************************************************************
#
#       Name :      commands.def
#       Purpose :   Command processor
#       Date :      16th April 2023
#       Author :    Paul Robson T(paul@robsons.org.uk)
#
# *******************************************************************************************
# *******************************************************************************************
#
#		Routines do all the work
#
GO 				X:CommandGOAlt N
GOTO 			X:CommandGOTO N
GOSUB 			X:CommandGOSUB N
RESTORE 		X:CommandRESTORE N
LET 			X:CommandLET N
INPUT 			X:CommandINPUT N
INPUT# 			C:CommandINPUTStream N
PRINT 			X:CommandPRINT N
PRINT# 			C:CommandPRINT N
REM 			X:CommandREM N
FOR 			X:CommandFOR N
NEXT 			X:CommandNEXT N
GET 			X:CommandGET N
DATA 			X:CommandDATA N
READ 			X:CommandREAD N
DIM 			X:CommandDIM N
DEF 			X:CommandDEF N
#
#		Routine supported
#
IF 				# X:CommandIF N
WAIT 			#,# X:CommandWAIT N
ON 				# T X:CommandON N
#
#		Controls
#
SYS 			# T N
POKE 			#,# T N
#
#		Token only
#
RETURN 			T N
STOP 			T N
END 			T N
#
#		CLR clears every variable and array (and resets the string heap and BASIC stack) at
#		runtime. The runtime handler (CommandClr -> ClearMemory) already existed and is already
#		vectored via its ;; [!CLR] marker -- this command-table line, emitting the shifted CLR
#		token, was the only missing piece. Token only, no operands, like RETURN/STOP/END.
#
CLR 			X:CommandClrCompile T N
#
#		GP.BASIC counted loop -- GP.DO <count> ... GP.LOOP, modelled on prog8's "repeat" and
#		named after CBM BASIC 7.0's DO/LOOP. Both are pure table entries: no compiler routine
#		exists for either, because neither has anything to compile beyond its argument.
#
#		GP.DO reuses OptionalNumberCompile (the bare-SLEEP helper) verbatim: it pushes 0 when
#		the count is omitted, and a count of 0 is exactly what the runtime reads as "forever".
#
GP.DO 			X:OptionalNumberCompile T N
GP.LOOP 		T N
#
#		GP.EXITDO has no "T": .exitdo is a SYSTEM token carrying a two byte branch offset, and the
#		table cannot reserve operand space. CommandExitDoCompile writes token and placeholder both.
#
GP.EXITDO 		X:CommandExitDoCompile N
#
#		GP.CALL <addr> [,a] [,x] [,y] [,c] -- call machine code with the registers set. Results
#		come back through the GP.A/GP.X/GP.Y/GP.C value words (x16_unary.def), which are ordinary
#		tokens, NOT variables: nothing lets the runtime write a variable by name, and X16's own
#		ST/MX/MY are tokens for exactly the same reason.
#
GP.CALL 		# X:OptionalZeroCompile X:OptionalZeroCompile X:OptionalZeroCompile X:OptionalZeroCompile T N
#
#		GP.BASIC in-place string statements. StringVariableCompile both VALIDATES (a plain string
#		variable, never a literal or a temporary) and emits the read, so the runtime gets the
#		block address and checks nothing.
#
#		These three all shrink or rewrite in place. There is deliberately NO GP.PAD: growing a
#		string needs the variable slot, not the block, and a handler never gets it -- so padding
#		lives in BASL as STRHELP.PAD (GPC-BASIC/STRHELP.INC.BL), where assignment reallocates.
#
GP.TRIM 		X:StringVariableCompile T N
GP.LTRIM 		X:StringVariableCompile T N
GP.RTRIM 		X:StringVariableCompile T N
GP.UPPER 		X:StringVariableCompile T N
GP.LOWER 		X:StringVariableCompile T N
#
#		GP.SORT a$() [,descending] [,foldcase] -- shell sort in place, swapping the 2 byte element
#		pointers. The parentheses are REQUIRED: A$ and A$() are different variables, so without them
#		the compiler would find the scalar and sort nothing.
#
GP.SORT 		X:StringArrayCompile X:OptionalZeroCompile X:OptionalZeroCompile T N
