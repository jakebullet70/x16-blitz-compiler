SGN 			(#) T N
INT 			(#) T N
ABS 			(#) T N
USR 			(#) T N
FRE 			(#) T N
POS 			(#) T N
SQR 			(#) T N
RND 			(#) T N
LOG 			(#) T N
EXP 			(#) T N
COS 			(#) T N
SIN 			(#) T N
TAN 			(#) T N
ATN 			(#) T N
PEEK 			(#) T N
LEN 			($) T N
STR$ 			(#) T S
VAL 			($) T N
ASC				($) T N
CHR$ 			(#) T S
LEFT$			($,#) T S
RIGHT$ 			($,#) T S
MID$			($,# X:OptionalParameterCompile ) T S
NOT 			X:NotUnaryCompile N
FN 				X:FNCompile N
PI 				T N

# 	GP.BASIC strings. GP.INSTR is the gap that matters -- GPC has no string search at all. Its
# 	start position reuses OptionalZeroCompile, since 0 is not a legal 1-based position and so
# 	needs no sentinel. GP.STRPTR is a retype, not a computation: read_string.asm already pushes
# 	the block address + 2, which is exactly what it returns.

GP.INSTR 		($,$ X:OptionalZeroCompile) T N
GP.STRPTR 		($) T N
