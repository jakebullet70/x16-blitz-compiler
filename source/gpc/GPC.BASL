#INCLUDE "GPB.INC.BL"
#SAVEAS "@:GPC.SRC.PRG"
#SYMFILE "@:GPC.SRC.SYM"
#AUTONUM 5
#REM 0

REM --------------------------------------------------------
REM ---> GPC FRONT-END (BASLOAD SOURCE)
REM ---> 
REM ---> SADLOGIC, JULY 2026, KHERSON UKRAINE!
REM --------------------------------------------------------
REM ---> GP.BASIC THROUGHOUT, THE SAME WAY GPC.ERR.BASL IS:
REM ---> GP.IF/GP.ELSEIF/GP.ELSE/GP.ENDIF FOR THE BRANCHES,
REM ---> GP.DO/GP.LOOP/GP.EXITDO FOR THE KEY WAITS, AND
REM ---> GP.ISEMPTY FOR THE BARE-RETURN TESTS. NO GOTO LEFT.
REM ---> 
REM ---> SO THIS SOURCE TOKENISES TO GPC.SRC.PRG, WHICH THE
REM ---> ROM CANNOT RUN -- NOTHING IN BASIC IS BEHIND $CE7X.
REM ---> IT IS COMPILED WITH GPC.BIN INTO GPC.PRG, AND THAT
REM ---> IS THE FRONT END YOU LAUNCH. THE BUILD DOES BOTH
REM ---> STEPS: SEE source/gpc/Makefile.
REM --------------------------------------------------------

REM --------------------------------------------------------
REM ---> THE VERSION BELOW IS THE RELEASE ONLY -- MAJOR.MINOR.
REM ---> NO BUILD NUMBER HERE ON PURPOSE. A BUILD NUMBER IN
REM ---> THIS FILE BUMPED ONLY WHEN THE FRONT END WAS REBUILT,
REM ---> SO IT NEVER MOVED WHEN THE COMPILER ITSELF CHANGED --
REM ---> USELESS FOR TELLING WHICH ENGINE YOU RUN.
REM ---> GPC.BIN PRINTS THE FULL V0.9.NNN ITSELF, NEXT
REM ---> TO "GPC SQUEALING...". SEE source/application/buildnum.txt
REM ---> KEEP THIS IN STEP WITH THAT FILE'S MAJOR.MINOR.
REM --------------------------------------------------------
PRINT : PRINT
PRINT "GPC... A BLITZ INSPIRED X16 COMPILER"
PRINT "           V1.0 - SUMMER 2026"
PRINT
GOSUB CLEAR.KB


REM ---- INPUT FILE (BARE RETURN = QUIT) ----
PR$="INPUT  FILE: " : GOSUB READLINE
GP.IF GP.ISEMPTY(NM$) THEN
  PRINT : PRINT "BYE, EXITING" : END
GP.ENDIF
SRC$=NM$

REM ---- THE SOURCE MUST EXIST, AND MUST BE A PRG, BEFORE WE ASK FOR AN
REM ---- OUTPUT NAME OR SCRATCH ANYTHING.
GOSUB FILE.CHECK
GP.IF EX=0 THEN
  PRINT : PRINT "INPUT FILE NOT FOUND" : END
GP.ELSEIF PG=0 THEN
  PRINT : PRINT "NOT A BASIC PRG FILE" 
  PRINT "COMPILE THE .PRG, NOT THE .BASL SOURCE."
  END
GP.ENDIF

REM ---- OUTPUT FILE (BARE RETURN = C.+SOURCE) ----
PR$="OUTPUT FILE: " : GOSUB READLINE
OBJ$=NM$
GP.IF GP.ISEMPTY(NM$) THEN
  OBJ$="C."+SRC$
GP.ENDIF

REM ---- DEBUG MAP? (YES = M.+SOURCE) ----
PR$="MAKE A DEBUG MAP? " : GOSUB YESNO
MAP$=""
GP.IF YN=1 THEN
  MAP$="M."+SRC$
GP.ENDIF

REM ---- SHARED RUNTIME? ----
PR$="SHARED RUNTIME? " : GOSUB YESNO
SH=YN

REM ---- DELETE LAST TIME'S OBJECT + MAP (DOS WON'T OVERWRITE) ----
OPEN 15,8,15
PRINT#15,"S:"+OBJ$
GP.IF LEN(MAP$)>0 THEN
  PRINT#15,"S:"+MAP$
GP.ENDIF
CLOSE 15

REM --- WRITE GPC.INPUT: CR-TERMINATED LINES 1..4 ----
OPEN 1,8,2,"@:GPC.INPUT,S,W"
PRINT#1,SRC$
PRINT#1,OBJ$
PRINT#1,MAP$
GP.IF SH=1 THEN
  PRINT#1,"SHARED"
GP.ENDIF
CLOSE 1

GOSUB CLEAR.KB
REM --- HAND OFF TO THE COMPILER ENGINE  ---
GP.IF SH=1 THEN
  PRINT"** SHARED RUNTIME SELECTED, REMEMBER TO INCLUDE IT **"
GP.ENDIF
REM ---- NO ",8" HERE. COMPILED LOAD TAKES THE NAME AND NOTHING ELSE
REM ---- (LOAD $ IN x16_command.def); IT CHAIN-LOADS EXACTLY AS STOCK
REM ---- BASIC DOES INSIDE A RUNNING PROGRAM, AND VARIABLES SURVIVE.
LOAD "GPC.BIN"
END : REM THIS LINE DOES NOT MATTER


REM =====================================================================
REM READLINE: PROMPT PR$, READ A FILENAME INTO NM$.
REM   RETURN ENDS; DEL($14) ERASES; PRINTABLE PETSCII KEPT; CONTROL IGNORED
REM   THE INNER GP.DO IS THE KEY WAIT; ITS GP.EXITDO LEAVES ONLY THAT
REM   ONE, BECAUSE GP.EXITDO ALWAYS MEANS THE INNERMOST GP.DO.
REM =====================================================================
READLINE:
  PRINT PR$; : NM$=""
  GP.DO
    GP.DO
      GET K$
      GP.IF K$<>"" THEN
        GP.EXITDO
      GP.ENDIF
    GP.LOOP
    K=ASC(K$)
    GP.IF K=13 THEN
      PRINT
      GP.EXITDO
    GP.ELSEIF K=20 THEN
      GP.IF LEN(NM$)>0 THEN
        NM$=LEFT$(NM$,LEN(NM$)-1) : PRINT CHR$(20);
      GP.ENDIF
    GP.ELSEIF K>=32 AND (K<128 OR K>=160) AND LEN(NM$)<39 THEN
      NM$=NM$+K$ : PRINT K$;
    GP.ENDIF
  GP.LOOP
  RETURN


REM =====================================================================
REM YESNO: PROMPT PR$, SET YN=1 (Y) OR 0 (N / BARE RETURN); ECHO YES/NO.
REM   AN UNRECOGNISED KEY -- AND THE EMPTY STRING GET RETURNS WHEN NOTHING
REM   IS WAITING -- FALLS OFF THE END OF THE GP.IF AND ROUND AGAIN.
REM =====================================================================
YESNO:
  PRINT PR$;
  GP.DO
    GET K$
    GP.IF K$="Y" OR K$="y" THEN
      PRINT "YES" : YN=1
      GP.EXITDO
    GP.ELSEIF K$="N" OR K$="n" OR K$=CHR$(13) THEN
      PRINT "NO" : YN=0
      GP.EXITDO
    GP.ENDIF
  GP.LOOP
  RETURN


REM =====================================================================
REM FILE.CHECK: EX=1 IF SRC$ EXISTS (DOS ERROR CHANNEL), ELSE 0.
REM   PG=1 IF IT ALSO LOOKS LIKE A TOKENISED BASIC PROGRAM, ELSE 0.
REM
REM   THE COMPILER READS ITS INPUT AS TOKENISED BASIC, AND HANDED ANYTHING
REM   ELSE IT DOES NOT NOTICE -- IT TAKES THE FIRST TWO BYTES AS A LOAD
REM   ADDRESS AND THEN FOLLOWS WHATEVER COMES NEXT AS A LINK POINTER, OFF
REM   INTO THE FILE. THAT SHOWS UP AS A HANG OR A DISK ERROR AND SAYS
REM   NOTHING ABOUT THE REAL PROBLEM.
REM
REM   AN EASY MISTAKE TO MAKE: DIR.BASL IS BASLOAD SOURCE, PLAIN TEXT, AND
REM   DIR.PRG IS WHAT BASLOAD MAKES OF IT. ONLY THE SECOND COMPILES.
REM
REM   THE TEST IS THE LOAD ADDRESS. AN X16 BASIC PROGRAM STARTS AT $0801,
REM   SO THE FIRST TWO BYTES READ 1 AND 8 OR IT IS NOT A PROGRAM. GPC.BIN
REM   MAKES THE SAME CHECK (VALIDATESOURCEFILE, FILE-IO/CONTROL.ASM) -- IT
REM   HAS TO, SINCE GPC.INPUT CAN BE WRITTEN BY HAND AND THE ENGINE RUN ON
REM   ITS OWN. THIS ONE IS SO YOU FIND OUT AT THE PROMPT INSTEAD.
REM
REM   COMPARED AS STRINGS, NOT WITH ASC(): ASC("") IS AN ERROR, AND ON A
REM   MISSING OR EMPTY FILE THAT IS EXACTLY WHAT GET# HANDS BACK. BASIC'S
REM   "AND" EVALUATES BOTH SIDES, SO A LEN() GUARD WOULD NOT SAVE IT.
REM =====================================================================
FILE.CHECK:
  EX=0 : PG=0
  OPEN 15,8,15
  OPEN 2,8,3,SRC$+",P,R"
  GET#2,LO$
  GET#2,HI$
  INPUT#15,EN,EM$,ET,ES
  CLOSE 2 : CLOSE 15
  IF EN < 20 THEN EX=1
  IF LO$=CHR$(1) AND HI$=CHR$(8) THEN PG=1
  RETURN

CLEAR.KB:
  GP.DO
    GET K$
    GP.IF GP.ISEMPTY(K$) THEN
      GP.EXITDO
    GP.ENDIF
  GP.LOOP
  RETURN
