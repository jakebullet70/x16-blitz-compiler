#INCLUDE "GPB.INC.BL"
#SAVEAS "@:GPC.SRC.PRG"
#SYMFILE "@:GPC.SRC.SYM"
#REM 0

REM --------------------------------------------------------
REM ---> GPC FRONT-END (BASLOAD SOURCE)
REM ---> 
REM ---> SADLOGIC, JULY 2026, KHERSON UKRAINE!
REM --------------------------------------------------------
REM ---> GP.BASIC THROUGHOUT, THE SAME WAY GPC.ERR.BASL IS:
REM ---> GP.IF/GP.ELSEIF/GP.ELSE/GP.ENDIF FOR THE BRANCHES,
REM ---> GP.DO/GP.LOOP/GP.EXITDO FOR THE KEY WAITS, AND
REM ---> GP.ISEMPTY FOR THE BARE-RETURN TESTS. NO GOTO LEFT.
REM ---> 
REM ---> SO THIS SOURCE TOKENISES TO GPC.SRC.PRG, WHICH THE
REM ---> ROM CANNOT RUN -- NOTHING IN BASIC IS BEHIND $CE7X.
REM ---> IT IS COMPILED WITH GPC.BIN INTO GPC.PRG, AND THAT
REM ---> IS THE FRONT END YOU LAUNCH. THE BUILD DOES BOTH
REM ---> STEPS: SEE source/gpc/Makefile.
REM --------------------------------------------------------

REM --------------------------------------------------------
REM ---> THE VERSION BELOW IS THE RELEASE ONLY -- MAJOR.MINOR.
REM ---> NO BUILD NUMBER HERE ON PURPOSE. A BUILD NUMBER IN
REM ---> THIS FILE BUMPED ONLY WHEN THE FRONT END WAS REBUILT,
REM ---> SO IT NEVER MOVED WHEN THE COMPILER ITSELF CHANGED --
REM ---> USELESS FOR TELLING WHICH ENGINE YOU RUN.
REM ---> GPC.BIN PRINTS THE FULL VERSION ITSELF, NEXT
REM ---> TO "GPC SQUEALING...". SEE source/application/buildnum.txt
REM ---> KEEP THIS IN STEP WITH THAT FILE'S MAJOR.MINOR.
REM --------------------------------------------------------
PRINT : PRINT
PRINT "GPC... A BLITZ INSPIRED X16 COMPILER"
PRINT "           V1.2 - FALL 2026"
PRINT
GOSUB CLEAR.KB


REM ---- INPUT FILE (BARE RETURN = QUIT) ----
PR$="INPUT  FILE: " : GOSUB READLINE
GP.IF GP.ISEMPTY(NM$) THEN
  PRINT : PRINT "BYE, EXITING" : END
GP.ENDIF
SRC$=NM$

REM ---- THE SOURCE MUST EXIST, AND MUST BE A PRG, BEFORE WE ASK FOR AN
REM ---- OUTPUT NAME OR SCRATCH ANYTHING.
GOSUB FILE.CHECK
GP.IF EX=0 THEN
  PRINT : PRINT "INPUT FILE NOT FOUND" : END
GP.ELSEIF PG=0 THEN
  PRINT : PRINT "NOT A BASIC PRG FILE" 
  PRINT "COMPILE THE .PRG, NOT THE .BASL SOURCE."
  END
GP.ENDIF
GOSUB DIRECTIVES.READ

REM ---- OUTPUT FILE (BARE RETURN = C.+SOURCE) ----
GP.IF GP.ISEMPTY(DIRECTIVE.OBJECT$) THEN
  PR$="OUTPUT FILE: " : GOSUB READLINE
  OBJ$=NM$
  GP.IF GP.ISEMPTY(NM$) THEN
    OBJ$="C."+SRC$
  GP.ENDIF
GP.ELSE
  OBJ$=DIRECTIVE.OBJECT$
  PRINT "OUTPUT FILE: ";OBJ$;" (SOURCE)"
GP.ENDIF

REM ---- DEBUG MAP? (YES = SOURCE WITH .MAP FOR ITS SUFFIX) ----
REM ---- GPC.ERR FINDS THE MAP WITH A FILE PICKER RATHER THAN A
REM ---- TYPED NAME, AND A PICKER FILTERS ON THE SUFFIX. SO THE
REM ---- NAME CARRIES THE SUFFIX: "GPC.HELP.SRC.PRG" MAKES
REM ---- "GPC.HELP.MAP", BESIDE THE "GPC.HELP.SRC.SYM" BASLOAD
REM ---- WROTE. THE OLD NAME WAS "M."+SOURCE.
GP.IF GP.ISEMPTY(DIRECTIVE.MAP$) THEN
  YD=0
  PR$="MAKE A DEBUG MAP? " : GOSUB YESNO
  MAP$=""
  GP.IF YN=1 THEN
    MAP$=SRC$
    IF RIGHT$(MAP$,4)=".PRG" THEN MAP$=LEFT$(MAP$,LEN(MAP$)-4)
    IF RIGHT$(MAP$,4)=".SRC" THEN MAP$=LEFT$(MAP$,LEN(MAP$)-4)
    MAP$=MAP$+".MAP"
  GP.ENDIF
GP.ELSE
  MAP$=DIRECTIVE.MAP$
  PRINT "MAKE A DEBUG MAP? ";MAP$;" (SOURCE)"
GP.ENDIF

REM ---- SHARED RUNTIME? ----
GP.IF GP.ISEMPTY(DIRECTIVE.MODE$) THEN
  YD=0
  PR$="SHARED RUNTIME? " : GOSUB YESNO
  SH=YN
GP.ELSE
  SH=0
  IF DIRECTIVE.MODE$="SHARED" THEN SH=1
  PRINT "SHARED RUNTIME? ";DIRECTIVE.MODE$;" (SOURCE)"
GP.ENDIF
MD$=""
GP.IF SH=1 THEN
  MD$="SHARED"
GP.ENDIF

REM ---- REMOVE DEAD CODE? (YES = D.+SOURCE LISTS THE LINES REMOVED) ----
REM ---- A BARE RETURN IS YES. NO WRITES NOSTRIP ON LINE 5.
GP.IF DIRECTIVE.NOSTRIP%=1 THEN
  DC$="NOSTRIP"
  PRINT "REMOVE DEAD CODE? NO (SOURCE)"
GP.ELSEIF LEN(DIRECTIVE.DEADLIST$)>0 THEN
  DC$=DIRECTIVE.DEADLIST$
  PRINT "REMOVE DEAD CODE? YES, ";DC$;" (SOURCE)"
GP.ELSE
  YD=1
  PR$="REMOVE DEAD CODE? " : GOSUB YESNO
  DC$="NOSTRIP"
  GP.IF YN=1 THEN
    DC$="D."+SRC$
  GP.ENDIF
GP.ENDIF

REM ---- DELETE LAST TIME'S OBJECT, MAP + LIST (DOS WON'T OVERWRITE) ----
OPEN 15,8,15
PRINT#15,"S:"+OBJ$
GP.IF LEN(MAP$)>0 THEN
  PRINT#15,"S:"+MAP$
GP.ENDIF
IF DC$<>"NOSTRIP" THEN PRINT#15,"S:"+DC$
CLOSE 15

REM --- WRITE GPC.INPUT: CR-TERMINATED LINES 1..5 ----
REM --- LINE 4 GOES OUT EVEN EMPTY, SO LINE 5 KEEPS ITS SLOT
OPEN 1,8,2,"@:GPC.INPUT,S,W"
PRINT#1,SRC$
PRINT#1,OBJ$
PRINT#1,MAP$
PRINT#1,MD$
PRINT#1,DC$
CLOSE 1

GOSUB CLEAR.KB
REM --- HAND OFF TO THE COMPILER ENGINE  ---
GP.IF SH=1 THEN
  PRINT"** SHARED RUNTIME SELECTED, REMEMBER TO INCLUDE IT **"
GP.ENDIF
REM ---- NO ",8" HERE. COMPILED LOAD TAKES THE NAME AND NOTHING ELSE
REM ---- (LOAD $ IN x16_command.def). THE LOADED PROGRAM STARTS
REM ---- CLEAN, SO GPC.INPUT ABOVE IS HOW THE TWO HALVES TALK.
GOSUB FIND.ENGINE
LOAD ENGINE.NAME$
END : REM THIS LINE DOES NOT MATTER


REM =====================================================================
REM READLINE: PROMPT PR$, READ A FILENAME INTO NM$.
REM   RETURN ENDS; DEL($14) ERASES; PRINTABLE PETSCII KEPT; CONTROL IGNORED
REM   THE INNER GP.DO IS THE KEY WAIT; ITS GP.EXITDO LEAVES ONLY THAT
REM   ONE, BECAUSE GP.EXITDO ALWAYS MEANS THE INNERMOST GP.DO.
REM =====================================================================
READLINE:
  PRINT PR$; : NM$=""
  GP.DO
    GP.DO
      GET K$
      GP.IF K$<>"" THEN
        GP.EXITDO
      GP.ENDIF
    GP.LOOP
    K=ASC(K$)
    GP.IF K=13 THEN
      PRINT
      GP.EXITDO
    GP.ELSEIF K=20 THEN
      GP.IF LEN(NM$)>0 THEN
        NM$=LEFT$(NM$,LEN(NM$)-1) : PRINT CHR$(20);
      GP.ENDIF
    GP.ELSEIF K>=32 AND (K<128 OR K>=160) AND LEN(NM$)<39 THEN
      NM$=NM$+K$ : PRINT K$;
    GP.ENDIF
  GP.LOOP
  RETURN


REM =====================================================================
REM YESNO: PROMPT PR$, SET YN=1 (Y) OR 0 (N); A BARE RETURN GIVES YD.
REM   AN UNRECOGNISED KEY -- AND THE EMPTY STRING GET RETURNS WHEN NOTHING
REM   IS WAITING -- FALLS OFF THE END OF THE GP.IF AND ROUND AGAIN.
REM =====================================================================
YESNO:
  PRINT PR$;
  GP.DO
    GET K$
    GP.IF K$="Y" OR K$="y" OR (K$=CHR$(13) AND YD=1) THEN
      PRINT "YES" : YN=1
      GP.EXITDO
    GP.ELSEIF K$="N" OR K$="n" OR K$=CHR$(13) THEN
      PRINT "NO" : YN=0
      GP.EXITDO
    GP.ENDIF
  GP.LOOP
  RETURN


REM =====================================================================
REM FILE.CHECK: EX=1 IF SRC$ EXISTS (DOS ERROR CHANNEL), ELSE 0.
REM   PG=1 IF IT ALSO LOOKS LIKE A TOKENISED BASIC PROGRAM, ELSE 0.
REM
REM   THE COMPILER READS ITS INPUT AS TOKENISED BASIC, AND HANDED ANYTHING
REM   ELSE IT DOES NOT NOTICE -- IT TAKES THE FIRST TWO BYTES AS A LOAD
REM   ADDRESS AND THEN FOLLOWS WHATEVER COMES NEXT AS A LINK POINTER, OFF
REM   INTO THE FILE. THAT SHOWS UP AS A HANG OR A DISK ERROR AND SAYS
REM   NOTHING ABOUT THE REAL PROBLEM.
REM
REM   AN EASY MISTAKE TO MAKE: DIR.BASL IS BASLOAD SOURCE, PLAIN TEXT, AND
REM   DIR.PRG IS WHAT BASLOAD MAKES OF IT. ONLY THE SECOND COMPILES.
REM
REM   THE TEST IS THE LOAD ADDRESS. AN X16 BASIC PROGRAM STARTS AT $0801,
REM   SO THE FIRST TWO BYTES READ 1 AND 8 OR IT IS NOT A PROGRAM. GPC.BIN
REM   MAKES THE SAME CHECK (VALIDATESOURCEFILE, FILE-IO/CONTROL.ASM) -- IT
REM   HAS TO, SINCE GPC.INPUT CAN BE WRITTEN BY HAND AND THE ENGINE RUN ON
REM   ITS OWN. THIS ONE IS SO YOU FIND OUT AT THE PROMPT INSTEAD.
REM
REM   COMPARED AS STRINGS, NOT WITH ASC(): ASC("") IS AN ERROR, AND ON A
REM   MISSING OR EMPTY FILE THAT IS EXACTLY WHAT GET# HANDS BACK. BASIC'S
REM   "AND" EVALUATES BOTH SIDES, SO A LEN() GUARD WOULD NOT SAVE IT.
REM =====================================================================
FILE.CHECK:
  EX=0 : PG=0
  OPEN 15,8,15
  OPEN 2,8,3,SRC$+",P,R"
  GET#2,LO$
  GET#2,HI$
  INPUT#15,EN,EM$,ET,ES
  CLOSE 2 : CLOSE 15
  IF EN < 20 THEN EX=1
  IF LO$=CHR$(1) AND HI$=CHR$(8) THEN PG=1
  RETURN

REM =====================================================================
REM DIRECTIVES.READ: THE PROGRAM-WIDE #GPC WORDS AT THE HEAD OF SRC$, READ
REM   AS COMPILER/DIRECTIVES.ASM READS THEM. OUT: DIRECTIVE.OBJECT$, .MAP$,
REM   .DEADLIST$, .MODE$ (SHARED OR EMBEDDED), EMPTY FOR NONE; DIRECTIVE.NOSTRIP%.
REM =====================================================================
DIRECTIVES.READ:
  DIRECTIVE.OBJECT$=""
  DIRECTIVE.MAP$=""
  DIRECTIVE.DEADLIST$=""
  DIRECTIVE.MODE$=""
  DIRECTIVE.NOSTRIP%=0
  DIRECTIVE.STATUS%=0
  DIRECTIVE.NOMORE%=0
  DIRECTIVE.HEADENDED%=0
  OPEN 2,8,3,SRC$+",P,R"
  GOSUB DIRECTIVES.NEXTBYTE
  GOSUB DIRECTIVES.NEXTBYTE
  GP.DO
    GOSUB DIRECTIVES.NEXTBYTE
    DIRECTIVE.LINKLOW%=DIRECTIVE.BYTE%
    GOSUB DIRECTIVES.NEXTBYTE
    IF DIRECTIVE.NOMORE%=1 THEN GP.EXITDO
    IF DIRECTIVE.LINKLOW%+DIRECTIVE.BYTE%=0 THEN GP.EXITDO
    GOSUB DIRECTIVES.NEXTBYTE
    GOSUB DIRECTIVES.NEXTBYTE
    DIRECTIVE.LINE$=""
    GP.DO
      GOSUB DIRECTIVES.NEXTBYTE
      IF DIRECTIVE.NOMORE%=1 THEN GP.EXITDO
      IF DIRECTIVE.BYTE%=0 THEN GP.EXITDO
      IF LEN(DIRECTIVE.LINE$)<127 THEN DIRECTIVE.LINE$=DIRECTIVE.LINE$+CHR$(DIRECTIVE.BYTE%)
    GP.LOOP
    IF DIRECTIVE.NOMORE%=1 THEN GP.EXITDO
    GOSUB DIRECTIVES.PARSE
    IF DIRECTIVE.HEADENDED%=1 THEN GP.EXITDO
  GP.LOOP
  CLOSE 2
  RETURN

DIRECTIVES.NEXTBYTE:
  DIRECTIVE.BYTE%=0
  IF DIRECTIVE.STATUS%<>0 THEN DIRECTIVE.NOMORE%=1
  IF DIRECTIVE.NOMORE%=1 THEN RETURN
  GET#2,DIRECTIVE.RAW$
  DIRECTIVE.STATUS%=ST
  REM GET# HANDS BACK "" FOR A ZERO BYTE, SO THE CHR$(0) MAKES IT READ AS 0.
  DIRECTIVE.BYTE%=ASC(DIRECTIVE.RAW$+CHR$(0))
  RETURN

DIRECTIVES.PARSE:
  DIRECTIVE.SCAN%=1
  GP.DO
    GOSUB DIRECTIVES.CHARAT
    IF DIRECTIVE.CHAR%<>32 AND DIRECTIVE.CHAR%<>58 THEN GP.EXITDO
    DIRECTIVE.SCAN%=DIRECTIVE.SCAN%+1
  GP.LOOP
  IF DIRECTIVE.CHAR%=0 THEN RETURN
  GP.IF DIRECTIVE.CHAR%<>143 THEN
    DIRECTIVE.HEADENDED%=1
    RETURN
  GP.ENDIF
  DIRECTIVE.SCAN%=DIRECTIVE.SCAN%+1
  GOSUB DIRECTIVES.SKIPSPACES
  FOR DIRECTIVE.TAGINDEX=1 TO 4
    GOSUB DIRECTIVES.CHARAT
    IF DIRECTIVE.UPPER%<>ASC(MID$("#GPC",DIRECTIVE.TAGINDEX,1)) THEN RETURN
    DIRECTIVE.SCAN%=DIRECTIVE.SCAN%+1
  NEXT
  GOSUB DIRECTIVES.CHARAT
  IF DIRECTIVE.CHAR%<>32 THEN RETURN
  GOSUB DIRECTIVES.SKIPSPACES
  DIRECTIVE.WORD$=""
  GP.DO
    GOSUB DIRECTIVES.CHARAT
    IF DIRECTIVE.CHAR%=0 OR DIRECTIVE.CHAR%=32 OR DIRECTIVE.CHAR%=58 THEN GP.EXITDO
    DIRECTIVE.WORD$=DIRECTIVE.WORD$+CHR$(DIRECTIVE.UPPER%)
    DIRECTIVE.SCAN%=DIRECTIVE.SCAN%+1
  GP.LOOP
  IF DIRECTIVE.WORD$="SHARED" THEN DIRECTIVE.MODE$="SHARED"
  IF DIRECTIVE.WORD$="EMBEDDED" THEN DIRECTIVE.MODE$="EMBEDDED"
  IF DIRECTIVE.WORD$="NOSTRIP" THEN DIRECTIVE.NOSTRIP%=1
  IF DIRECTIVE.WORD$<>"OBJECT" AND DIRECTIVE.WORD$<>"MAP" AND DIRECTIVE.WORD$<>"DEADLIST" THEN RETURN
  GOSUB DIRECTIVES.QUOTEDNAME
  IF DIRECTIVE.NAMEFOUND%=0 THEN RETURN
  IF DIRECTIVE.WORD$="OBJECT" THEN DIRECTIVE.OBJECT$=DIRECTIVE.NAME$
  IF DIRECTIVE.WORD$="MAP" THEN DIRECTIVE.MAP$=DIRECTIVE.NAME$
  IF DIRECTIVE.WORD$="DEADLIST" THEN DIRECTIVE.DEADLIST$=DIRECTIVE.NAME$
  RETURN

DIRECTIVES.QUOTEDNAME:
  DIRECTIVE.NAMEFOUND%=0
  GOSUB DIRECTIVES.SKIPSPACES
  IF DIRECTIVE.CHAR%<>34 THEN RETURN
  DIRECTIVE.SCAN%=DIRECTIVE.SCAN%+1
  DIRECTIVE.NAME$=""
  GP.DO
    GOSUB DIRECTIVES.CHARAT
    IF DIRECTIVE.CHAR%=0 THEN RETURN
    IF DIRECTIVE.CHAR%=34 THEN GP.EXITDO
    DIRECTIVE.NAME$=DIRECTIVE.NAME$+CHR$(DIRECTIVE.UPPER%)
    DIRECTIVE.SCAN%=DIRECTIVE.SCAN%+1
  GP.LOOP
  IF LEN(DIRECTIVE.NAME$)=0 OR LEN(DIRECTIVE.NAME$)>63 THEN RETURN
  DIRECTIVE.NAMEFOUND%=1
  RETURN

DIRECTIVES.SKIPSPACES:
  GP.DO
    GOSUB DIRECTIVES.CHARAT
    IF DIRECTIVE.CHAR%<>32 THEN GP.EXITDO
    DIRECTIVE.SCAN%=DIRECTIVE.SCAN%+1
  GP.LOOP
  RETURN

DIRECTIVES.CHARAT:
  DIRECTIVE.CHAR%=0
  IF DIRECTIVE.SCAN%<=LEN(DIRECTIVE.LINE$) THEN DIRECTIVE.CHAR%=ASC(MID$(DIRECTIVE.LINE$,DIRECTIVE.SCAN%,1))
  DIRECTIVE.UPPER%=DIRECTIVE.CHAR%
  IF DIRECTIVE.CHAR%>=193 AND DIRECTIVE.CHAR%<=218 THEN DIRECTIVE.UPPER%=DIRECTIVE.CHAR%-128
  IF DIRECTIVE.CHAR%>=97 AND DIRECTIVE.CHAR%<=122 THEN DIRECTIVE.UPPER%=DIRECTIVE.CHAR%-32
  RETURN

REM =====================================================================
REM FIND.ENGINE: ENGINE.NAME$ IS GPC.BIN IN THIS FOLDER IF IT IS THERE,
REM   ELSE /GPC/GPC.BIN IN THE TOOL HOME. A LOAD OF A MISSING FILE STOPS
REM   THE PROGRAM, SO THE DOS ERROR CHANNEL IS ASKED FIRST.
REM =====================================================================
FIND.ENGINE:
  ENGINE.NAME$="GPC.BIN"
  OPEN 15,8,15
  OPEN 2,8,3,ENGINE.NAME$+",P,R"
  INPUT#15,EN,EM$,ET,ES
  CLOSE 2 : CLOSE 15
  IF EN >= 20 THEN ENGINE.NAME$="/GPC/GPC.BIN"
  RETURN

CLEAR.KB:
  GP.DO
    GET K$
    GP.IF GP.ISEMPTY(K$) THEN
      GP.EXITDO
    GP.ENDIF
  GP.LOOP
  RETURN
