; ************************************************************************************************
; ************************************************************************************************
;
;		Name:		00rt.header
;		Purpose:	Entry header for the standalone resident runtime, GPC.RT.<build>.BIN
;		Created:	17th July 2026
;		Reviewed: 	No
;
; ************************************************************************************************
; ************************************************************************************************
;
;		This is linked FIRST in the "gpc-rt" make target (in front of runtime/common/ifloat32/
;		polynomials), with -D CodeStart set to RTBASE, so its first byte lands there and the whole
;		image assembles up from there. The result is a headerless-to-BASIC raw PRG (load address =
;		RTBASE, no SYS stub) that a shared-mode program's bootstrap loads there with secondary
;		address 1 and enters via RT_ENTRY. scripts/rtname.py installs it as GPC.RT.<build>.BIN,
;		named from the ENGINE BUILD NUMBER -- so build the engine first and the runtime after, or
;		you produce a runtime no compiled program asks for.
;
;		Layout at RTBASE:
;			RTBASE+0 : "GPC" + digit    resident magic + ABI ordinal. NOT the build number in the
;			                          file name -- this answers only "runtime already resident and
;			                          safe to enter?", so a resident runtime from another build of
;			                          the same ABI is deliberately reused. Bump the digit (RT_ABI
;			                          in common.inc) whenever the layout or entry contract changes.
;			RTBASE+4 : jmp StartRuntime RT_ENTRY -- a stable trampoline, so a program enters at a
;			                          fixed address regardless of where StartRuntime floats to.
;
;		NB the extension is deliberately not .asm/.inc: common-scripts/build.py globs those into
;		_library.asm, and this header must be linked explicitly, exactly once, at the front. Same
;		reason 00main.header / 10object.divider / zzfree.footer are named as they are.
;
; ************************************************************************************************

		.section code

RTHeader:
		.cerror RTHeader != RTBASE, "runtime header not at RTBASE - check -D CodeStart vs RTBASE"
		;
		;		Resident magic + ABI ordinal (RTBASE..RTBASE+3). This is the ABI ordinal, NOT the
		;		build number that names the file: it decides whether an already-resident runtime
		;		can be entered, so it moves only on a layout/entry change. The bootstrap compares all four
		;		bytes, so this and its copy in bootstrap.asm must agree -- both are now built from
		;		RT_ABI (common.inc) rather than spelled out, so they cannot drift apart.
		;
		;		The ordinal is TWO ASCII digits as of 17th August 2026 (RT_ABI 10). It was one, and
		;		"GPC" + digit ran out at 9 -- a fifth byte would have written over the RT_ENTRY jmp
		;		at RTBASE+4, which is why both ends carried a .cerror rather than silently growing.
		;		Dropping the "C" keeps the magic exactly 4 bytes and buys room to ABI 99.
		;
		.cerror RT_ABI > 99, "RT_ABI > 99: the magic's last two bytes are ASCII digits - widen it here AND in bootstrap.asm"
		.text 	"GP"						; magic (RTBASE..RTBASE+1)
		.byte 	(RT_ABI / 10) + '0' 		; ABI ordinal as two digits (RTBASE+2..RTBASE+3)
		.byte 	(RT_ABI - (RT_ABI / 10) * 10) + '0'
RTEntryVec: 								; == RT_ENTRY (RTBASE+4)
		jmp 	StartRuntime 				; stable trampoline into the (floating) real entry

		.send code

