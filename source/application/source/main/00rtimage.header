; ************************************************************************************************
; ************************************************************************************************
;
;		Name:		00rtimage.header
;		Purpose:	$0801 entry for the RUNTIME IMAGE -- the file a compiled program carries.
;		Created:	30th August 2026
;
; ************************************************************************************************
; ************************************************************************************************
;
;		This is the head of GPC.IMG.nnn.BIN: BASIC stub, then straight into the runtime. It is
;		never executed by the compiler -- the compiler streams this file into OBJECT.PRG and
;		OBJECT.PRG is what runs it.
;
;		It is 00main.header's other half. That file used to be both entries at once: it started
;		"jmp CompileCode", and PatchOutCompile overwrote those three bytes with NOPs in RAM just
;		before WriteObjectCode copied them to disk, so the saved program fell through into the
;		runtime instead of into the compiler. With the two images now linked separately there is
;		nothing to patch out -- the NOPs are simply assembled here, and PatchOutCompile is gone.
;
;		The three immediates ARE still patched, but into the byte stream rather than into RAM:
;		genrtimage.py records their offsets from $0801 and object.asm substitutes as the bytes
;		go past. They are assembled as zero to make an unpatched image obvious rather than
;		plausible. RunBankPage is the exception: its zero means the copy is made, see StartCode.
;
;		LAYOUT IS LOAD-BEARING. $0815 is where the BASIC stub SYSes to, in this file and in
;		00main.header alike, so the stub must stay byte-identical between the two.
;
; ************************************************************************************************

		.section code

; ************************************************************************************************
;
;								Run program from here
;
; ************************************************************************************************

StartBasicProgram:
		.word 	$0813 						; offset to next.
		.word 	10 							; line #
		.byte 	$9E 						; token for 'SYS'
		.text 	' 2069'						; space, $0815 in decimal
		.byte 	$3A 						; ':' statement separator
		.byte 	$8F 						; token for 'REM'
		.text 	' GPC!'						; compiler signature -- shows on LIST
		.byte  	0 							; end of line
		.word 	0 							; end of program

; ************************************************************************************************
;
;								We actually enter here (SYS 2069)
;
; ************************************************************************************************

StartCode: 									; three bytes, matching the "jmp CompileCode" that
		nop 								; 00main.header has at this address. There is nothing
		nop 								; to compile in a saved program, so it falls through.
		nop
		;
		;		The bank code follows the p-code in the file, from the next page. It goes to bank 1
		;		before the runtime takes the workspace it sits in, whole pages at a time, so the
		;		bytes past its end land in bank 1 unused. The copy zeroes the page operand: a RUN
		;		after END, whose workspace no longer holds the bank code, keeps the copy made.
		;
RunBankPage:
		lda 	#0 							; page of the bank code, zero once copied (operand +1)
		beq 	_SCInBank
		sta 	zTemp0+1
		stz 	zTemp0
		stz 	zTemp1
		lda 	#RTImgBankHeader >> 8
		sta 	zTemp1+1
		lda 	SelectRAMBank 				; BASIC's bank, selected again before the runtime
		pha
		lda 	#HANDLER_BANK
		sta 	SelectRAMBank
		ldx 	#(RTImgBankEnd - RTImgBankHeader + $FF) >> 8
		ldy 	#0
_SCCopy:
		lda 	(zTemp0),y
		sta 	(zTemp1),y
		iny
		bne 	_SCCopy
		inc 	zTemp0+1
		inc 	zTemp1+1
		dex
		bne 	_SCCopy
		pla
		sta 	SelectRAMBank
		stz 	RunBankPage+1
_SCInBank:
		;
		;		AND THE OVERLAY FOLLOWS THE BANK CODE, from the page after it. It describes itself --
		;		a bank byte, a page count, that many pages, and BXOVLEND after the last region -- so
		;		this walks it where it lies and copies each region into its bank. It is the walk
		;		bootstrap2.asm does for a shared program, reading RAM instead of a file: an embedded
		;		program has no .OVL beside it, because the compiler appended it to the object.
		;
		;		NOTHING IS CHECKED HERE, and bootstrap2.asm checks at every page. What it guards
		;		against is a file that is missing, stale or cut, and there is no file: these bytes
		;		came in with the p-code, and if they did not arrive neither did the program.
		;
		;		THE REGIONS SIT IN THE WORKSPACE -- above the bank code, below $9F00 -- which the
		;		runtime clears the moment it starts. So the copy happens first, and the page operand
		;		is zeroed after it, exactly as RunBankPage's is: a RUN after END finds the banks
		;		still filled and the overlay long since overwritten.
		;
RunOvlPage:
		lda 	#0 							; page of the overlay, zero once read (operand +1)
		beq 	_SCNoOvl
		sta 	zTemp0+1
		stz 	zTemp0
		lda 	SelectRAMBank 				; BASIC's bank, as the copy above
		pha
_SCRegion:
		lda 	(zTemp0) 					; the region's bank, or the end marker
		cmp 	#BXOVLEND
		beq 	_SCOvlIn
		sta 	SelectRAMBank
		ldy 	#1
		lda 	(zTemp0),y 					; and how many pages of it to copy
		tax
		clc 								; the data starts after those two header bytes, so the source
		lda 	zTemp0 						; is two bytes further on for every region already read
		adc 	#2 							; and its low byte is NOT zero
		sta 	zTemp0
		bcc 	_SCOvlHdr
		inc 	zTemp0+1
_SCOvlHdr:
		stz 	zTemp1 						; every region starts at $A000 in its own bank
		lda 	#$A0
		sta 	zTemp1+1
_SCOvlPage:
		ldy 	#0
_SCOvlCopy:
		lda 	(zTemp0),y
		sta 	(zTemp1),y
		iny
		bne 	_SCOvlCopy
		inc 	zTemp0+1
		inc 	zTemp1+1
		dex
		bne 	_SCOvlPage
		bra 	_SCRegion
_SCOvlIn:
		pla
		sta 	SelectRAMBank
		stz 	RunOvlPage+1
_SCNoOvl:
		;
		;		AND THE BANK THE PROGRAM STARTS IN, which is the last GP.BANKED region's. A program
		;		that falls into a region from the line above reaches it by a plain GOTO, and a GOTO
		;		selects no bank. bootstrap2.asm's BXRun does the same thing for the same reason.
		;
		;		OUTSIDE THE WALK, because a second RUN skips the walk and still starts there. Zero is
		;		a program with no region at all: no region may use bank 0 or bank 1, so zero is free
		;		to mean leave the bank alone.
		;
RunStartBank:
		lda 	#0 							; bank selected at the handover, 0 = none (operand +1)
		beq 	_SCNoBank
		sta 	SelectRAMBank
_SCNoBank:


RunCodePage:
		lda 	#0 							; page of the object code to run.      (operand +1)
RunWorkspacePage:
		ldx 	#0 							; first page of workspace.             (operand +1)
		ldy 	#$9F 						; byte after the last page ($9F00 is I/O).
		jmp 	StartRuntime 				; and go do it !

		.send code

; ************************************************************************************************
;
;									Changes and Updates
;
; ************************************************************************************************
;
;		Date			Notes
;		==== 			=====
;		30/08/26		Split out of 00main.header when the runtime became a separate file.
;		15/09/26		StartCode copies the embedded bank code to bank 1.
;
; ************************************************************************************************
