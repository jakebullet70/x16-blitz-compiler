; ************************************************************************************************
; ************************************************************************************************
;
;		Name:		00main.header
;		Purpose:	$0801 entry for the COMPILER.
;		Created:	9th October 2023
;		Reviewed: 	No
;		Author:		Paul Robson (paul@robsons.org.uk)
;
; ************************************************************************************************
; ************************************************************************************************
;
;		GPC.BLITZ.BIN starts here, and does one thing: compile. It used to be the head of a
;		single image that was compiler AND runtime -- $0801 runtime, ObjectBase compiler,
;		FreeMemory object buffer -- which meant 14,079 bytes of runtime sat in low RAM for the
;		whole compile so that WriteObjectCode could copy them into the output. Every one of
;		those bytes came off the object buffer, i.e. off the largest program that could be
;		built. The runtime is GPC.IMG.nnn.BIN now (00rtimage.header), streamed from disk, and
;		this image is the compiler alone.
;
;		So StartCode, RunCodePage, RunWorkspacePage and PatchOutCompile have all gone to
;		00rtimage.header, where they belong: they were only ever the SAVED program's entry, and
;		the saved program no longer gets them from here.
;
;		The one thing that has to stay in step is that the BASIC stub is byte-identical in both
;		files, because both SYS 2069 -- $0815 -- to whatever follows it.
;
;		Losing PatchOutCompile also retires the "RUN a second time" path, which ran the freshly
;		compiled object out of the compiler's own memory. It cannot work without a resident
;		runtime, it was a dev convenience only (a saved OBJECT.PRG was never affected), and
;		TODO.md had it parked as a cleanup with a size ceiling of its own.
;
; ************************************************************************************************

		.section code

; ************************************************************************************************
;
;								Run program from here
;
; ************************************************************************************************

StartBasicProgram:
		.word 	$0813 						; offset to next.
		.word 	10 							; line #
		.byte 	$9E 						; token for 'SYS'
		.text 	' 2069'						; space, $0815 in decimal
		.byte 	$3A 						; ':' statement separator
		.byte 	$8F 						; token for 'REM'
		.text 	' GPC!'						; compiler signature -- shows on LIST
		.byte  	0 							; end of line
		.word 	0 							; end of program

; ************************************************************************************************
;
;								We actually enter here (SYS 2069)
;
; ************************************************************************************************

StartCode:
		jmp 	CompileCode 				; three bytes, matching the NOPs 00rtimage.header
											; assembles at this address.

		.send code


; ************************************************************************************************
;
;									Changes and Updates
;
; ************************************************************************************************
;
;		Date			Notes
;		==== 			=====
;		30/08/26		Runtime split into its own file; the saved program's entry moved to
;						00rtimage.header and PatchOutCompile retired with it.
;
; ************************************************************************************************
