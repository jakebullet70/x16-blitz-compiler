#SAVEAS "@:BASLOAD.PRG"
#REM 0

REM --------------------------------------------------------
REM ---> BASLOAD FRONT END (BASLOAD SOURCE)
REM --------------------------------------------------------
REM ---> BASLOAD.BIN IS THE STREAMING TOKENISER, AND ITS ONLY
REM ---> INTERFACE IS AN ABI: THE SOURCE NAME AT $BF00 IN RAM
REM ---> BANK 0, ITS LENGTH IN R0L, THE DEVICE IN R0H, THEN
REM ---> SYS $6000. THAT IS A CONTRACT FOR A CALLING PROGRAM,
REM ---> NOT SOMETHING A PERSON CAN USE. THE ROM'S OWN
REM ---> BASLOAD "FILE" COMMAND PARSED THE NAME OUT OF THE
REM ---> BASIC LINE; THE FORK TO A PRG DROPPED IT.
REM ---> 
REM ---> THIS IS THAT FRONT END BACK. IT ASKS FOR A NAME,
REM ---> POKES IT, CALLS THE ENGINE, AND PRINTS WHAT COMES
REM ---> BACK -- THEN ASKS AGAIN, SO A RUN OF FILES COSTS ONE
REM ---> LOAD OF THE ENGINE. THE POKED-NAME PATH IS UNTOUCHED:
REM ---> runtest.py AND build_basl.py STILL CALL IT DIRECTLY.
REM --------------------------------------------------------
REM ---> PLAIN X16 BASIC, NOT GP.BASIC. IT HAS TO RUN FROM THE
REM ---> READY. PROMPT WITH NOTHING ON THE DISK BUT ITSELF AND
REM ---> BASLOAD.BIN, SO IT CANNOT WANT GPC.BIN OR A RUNTIME.
REM --------------------------------------------------------

REM ---- THE ENGINE, LOADED ONCE ----
REM ---- LOAD INSIDE A RUNNING PROGRAM RESTARTS IT AND CLEARS
REM ---- THE VARIABLES, SO THE RE-ENTRY GUARD IS A POKED BYTE.
REM ---- $0400 IS GOLDEN RAM, WHICH THE ENGINE BACKS UP AND
REM ---- RESTORES AROUND EVERY RUN, SO THE 42 SURVIVES A
REM ---- TOKENISE AND THE LOOP BELOW NEVER RELOADS.
REM ---- THE SECOND TEST IS THE ENGINE'S OWN FIRST BYTE -- ITS
REM ---- ENTRY IS A JMP, $4C -- SO A COLD BOOT THAT HAPPENS TO
REM ---- HAVE 42 SITTING AT $0400 STILL CANNOT SYS INTO NOTHING.
IF PEEK(1024)=42 AND PEEK(24576)=76 THEN GOTO ENGINE.UP
POKE 1024,42
LOAD "BASLOAD.BIN",8,1

ENGINE.UP:
PRINT
PRINT "BASLOAD --> BASIC SOURCE TO TOKENISED PRG (GPC VERSION)"
PRINT "BASLOAD.BIN WAS BUILT FROM GIT SOURCE, SEPT 2026"
PRINT "BASLOAD IS (C)2021-2023, STEFAN JAKOBSSON"

ASK.AGAIN:
PRINT
GOSUB FLUSH.KEYS
PR$="SOURCE FILE: "
GOSUB GETNAME
IF NM$="" THEN GOTO QUIT
GOSUB TOKENISE
GOTO ASK.AGAIN

QUIT:
PRINT
PRINT "AND... BYE!"
END


REM =====================================================================
REM TOKENISE: RUN THE ENGINE OVER NM$ AND REPORT WHAT IT SAYS.
REM
REM   BANK 0, NOT POKE 0,0. X16 BASIC SAVES AND RESTORES THE RAM BANK
REM   AROUND EVERY PEEK AND POKE, SO POKE 0,0 SELECTS NOTHING AND THE
REM   NAME LANDS IN WHICHEVER BANK WAS LIVE. THE SYMPTOM IS SILENT: SYS
REM   RETURNS CLEANLY, NO FILE IS WRITTEN, AND $BF00 STILL READS BACK
REM   WHAT YOU POKED.
REM
REM   THE NAME HAS TO BE RE-POKED EVERY TIME. THE ENGINE ANSWERS IN THE
REM   SAME BUFFER IT WAS ASKED IN -- THE MESSAGE AT $BF00 OVERWRITES THE
REM   NAME -- SO THE SECOND FILE OF A SESSION WOULD OTHERWISE COMPILE
REM   THE FIRST ONE'S STATUS LINE.
REM
REM   THE OUTPUT NAME IS NOT ASKED FOR AND CANNOT BE: IT IS THE SOURCE'S
REM   OWN #SAVEAS. WITHOUT ONE THE RUN FAILS WITH FILENAME NOT SPECIFIED,
REM   BECAUSE STREAMING HAS NOWHERE ELSE TO PUT THE PROGRAM.
REM =====================================================================
TOKENISE:
  PRINT
  PRINT "TOKENISING ";NM$;" ..."
  BANK 0Q
  FOR I=1 TO LEN(NM$)
    POKE 48896+I-1,ASC(MID$(NM$,I,1))
  NEXT
  POKE 2,LEN(NM$) : POKE 3,8
  SYS 24576
  REM ---- THE ENGINE RETURNS WITH BANK 1 SELECTED, SO SELECT 0 AGAIN
  REM ---- BEFORE READING THE MESSAGE IT LEFT BEHIND.
  BANK 0
  MS$="" : I=0
MSG.NEXT:
  C=PEEK(48896+I)
  IF C=0 THEN GOTO MSG.END
  MS$=MS$+CHR$(C)
  I=I+1
  IF I<80 THEN GOTO MSG.NEXT
MSG.END:
  REM ---- THE SOURCE LINE NUMBER IS 24 BITS IN R1H..R2H, AND IT IS ZERO
  REM ---- WHEN THE FAULT HAS NO LINE TO NAME -- SYMBOL TABLE FULL, SAY.
  REM ---- A MESSAGE THAT ENDS IN A COLON IS THE ONE EXPECTING A NUMBER.
  LN=PEEK(5)+PEEK(6)*256+PEEK(7)*65536
  PRINT
  IF LN=0 THEN GOTO SHOW.MSG
  PRINT MS$;MID$(STR$(LN),2)
  RETURN
SHOW.MSG:
  PRINT MS$
  RETURN


REM =====================================================================
REM GETNAME: PROMPT PR$, READ A FILE NAME INTO NM$.
REM   RETURN ENDS IT, DEL ($14) ERASES, PRINTABLE PETSCII IS KEPT AND
REM   EVERYTHING ELSE IGNORED. AN EMPTY ANSWER IS THE CALLER'S QUIT.
REM
REM   NOT INPUT: INPUT SPLITS THE NAME ON A COMMA, ANSWERS A BARE RETURN
REM   BY LEAVING THE VARIABLE ALONE RATHER THAN EMPTYING IT, AND PRINTS
REM   ?REDO FROM START AT ITS OWN DISCRETION. THIS IS THE SAME READER
REM   GPC.BASL USES, WRITTEN OUT IN PLAIN BASIC.
REM =====================================================================
GETNAME:
  PRINT PR$;
  NM$=""
GETNAME.KEY:
  GET K$
  IF K$="" THEN GOTO GETNAME.KEY
  K=ASC(K$)
  IF K=13 THEN GOTO GETNAME.END
  IF K=20 THEN GOTO GETNAME.DEL
  IF K<32 THEN GOTO GETNAME.KEY
  IF K>=128 AND K<160 THEN GOTO GETNAME.KEY
  IF LEN(NM$)>=39 THEN GOTO GETNAME.KEY
  NM$=NM$+K$
  PRINT K$;
  GOTO GETNAME.KEY
GETNAME.DEL:
  IF LEN(NM$)=0 THEN GOTO GETNAME.KEY
  NM$=LEFT$(NM$,LEN(NM$)-1)
  PRINT CHR$(20);
  GOTO GETNAME.KEY
GETNAME.END:
  PRINT
  RETURN


REM =====================================================================
REM FLUSH.KEYS: EMPTY THE KEYBOARD BUFFER BEFORE A PROMPT, SO A KEY HELD
REM   DOWN WHILE THE ENGINE RAN DOES NOT TYPE ITSELF INTO THE NEXT NAME.
REM =====================================================================
FLUSH.KEYS:
  GET K$
  IF K$<>"" THEN GOTO FLUSH.KEYS
  RETURN
