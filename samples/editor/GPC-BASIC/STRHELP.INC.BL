## ***********************************************************************
## **
## **  STRHELP.INC.BL -- string helpers that belong in BASIC, not ASM.
## **
## **  Modelled on prog8's strings module: one dotted namespace, one routine per job.
## **  Unlike GPB.INC.BL this file contains CODE -- call the routines with GOSUB. It is
## **  position independent (the module jumps over itself), so #INCLUDE it anywhere.
## **
## **  prog8 passes arguments in registers; BASL has none, so the module owns named
## **  parameter variables instead:
## **
## **      STRHELP.STR$    the string, in and out
## **      STRHELP.WIDTH   the field width  (PADR / PADL / PADC)
## **      STRHELP.DELIM$  the separator    (SPLIT)
## **      STRHELP.MAX     field array size (SPLIT, 0 means 10)
## **      STRHELP.FIND$   what to look for (REPLACE)
## **      STRHELP.REPL$   what to put back (REPLACE)
## **      STRHELP.PET     a PETSCII code   (PET2SCR)
## **
## **  Clobbered (prog8 would say "clobbers"):
## **      STRHELP.GAP     STRHELP.HALF          by the pad routines
## **      STRHELP.REST$   STRHELP.AT            by SPLIT and REPLACE
## **      STRHELP.LIM     STRHELP.N             by SPLIT
## **      STRHELP.OUT$                          by REPLACE
## **      STRHELP.SCR     the result            of PET2SCR
## **
## **  Usage:
## **      STRHELP.STR$ = NAME$ : STRHELP.WIDTH = 20
## **      GOSUB STRHELP.PADR
## **      NAME$ = STRHELP.STR$
## **
## **  THE PAD ROUTINES PAD, THEY NEVER TRUNCATE -- a string already at or past the
## **  width is left alone. Use STRCASE.RTRIM to go the other way. The padded result
## **  must fit a BASIC string; not checked, as in prog8, because checking costs more
## **  than the mistake.
## **
## ***********************************************************************
#IFNDEF STRHELP.DEFS
#DEFINE STRHELP.DEFS 1

GOTO STRHELP.SKIP

## STRHELP.PADR -- pad on the RIGHT to STRHELP.WIDTH: left justify, the
## text-in-a-column case.
##
## This was GP.PAD in ASM and moved here ON PURPOSE, not to save space: an in-place
## handler only ever gets the string's BLOCK, never the variable slot, so it cannot GROW
## one past the capacity it was born with. Padding "HI" to a 20 column field raised OUT
## OF RANGE -- and padding to a field is the entire point. BASIC assignment reallocates.

STRHELP.PADR:
    IF LEN(STRHELP.STR$) < STRHELP.WIDTH THEN STRHELP.STR$ = STRHELP.STR$ + RPT$(32, STRHELP.WIDTH - LEN(STRHELP.STR$))
    RETURN

## STRHELP.PADL -- pad on the LEFT to STRHELP.WIDTH: right justify, the
## numbers-in-a-column case.

STRHELP.PADL:
    IF LEN(STRHELP.STR$) < STRHELP.WIDTH THEN STRHELP.STR$ = RPT$(32, STRHELP.WIDTH - LEN(STRHELP.STR$)) + STRHELP.STR$
    RETURN

## STRHELP.PADC -- pad BOTH sides to STRHELP.WIDTH: centre, for headings
## and menu titles. An odd gap puts the extra space on the RIGHT.
##
## THE TWO GUARDS ARE LOAD BEARING, not defensive padding: RPT$ raises ILLEGAL QUANTITY
## on a count of ZERO rather than returning "", so a gap of 1 (half = 0) fails on the
## left call. The right one is always safe -- after the left pad the remainder is >= 1.

STRHELP.PADC:
    STRHELP.GAP = STRHELP.WIDTH - LEN(STRHELP.STR$)
    IF STRHELP.GAP < 1 THEN RETURN
    STRHELP.HALF = INT(STRHELP.GAP / 2)
    IF STRHELP.HALF > 0 THEN STRHELP.STR$ = RPT$(32, STRHELP.HALF) + STRHELP.STR$
    STRHELP.STR$ = STRHELP.STR$ + RPT$(32, STRHELP.WIDTH - LEN(STRHELP.STR$))
    RETURN

## STRHELP.SPLIT -- cut STRHELP.STR$ into fields on STRHELP.DELIM$.
##
##   in    STRHELP.STR$    the string (READ ONLY -- unlike the pad routines
##                         this one does not modify it)
##         STRHELP.DELIM$  the separator, one character or several
##         STRHELP.MAX     how many fields the array holds; 0 means 10
##   out   STRHELP.N       how many fields were produced, always >= 1
##         STRHELP.FIELD$  the fields, 1..STRHELP.N
##   clobbers  STRHELP.REST$  STRHELP.AT  STRHELP.LIM
##
## Composition, not bulk data, so it stays in BASIC. GP.INSTR does the searching, which
## is the only slow part -- the MID$ loop it replaces allocated a temporary per
## character compared.
##
## STRHELP.FIELD$ is NOT dimensioned here: leave it and GPC's implicit DIM gives 0..10,
## or DIM it yourself BEFORE the first call and set STRHELP.MAX to match. DIMming one
## GPC already auto-dimensioned is an error, so it is one or the other.
##
## Reaching the limit loses nothing -- the last field gets the whole unsplit remainder.
## EMPTY FIELDS ARE PRESERVED, which is what makes it safe for data rows: "A,,C" is
## three fields, "A," is two. Splitting an empty string gives one empty field, not zero.

STRHELP.SPLIT:
    STRHELP.N = 0 : STRHELP.LIM = STRHELP.MAX
    IF STRHELP.LIM < 1 THEN STRHELP.LIM = 10
    STRHELP.REST$ = STRHELP.STR$
STRHELP.SPLIT.NEXT:
    STRHELP.N = STRHELP.N + 1
    IF STRHELP.N >= STRHELP.LIM THEN STRHELP.FIELD$(STRHELP.N) = STRHELP.REST$ : RETURN
    STRHELP.AT = GP.INSTR(STRHELP.REST$, STRHELP.DELIM$)
    IF STRHELP.AT = 0 THEN STRHELP.FIELD$(STRHELP.N) = STRHELP.REST$ : RETURN
    STRHELP.FIELD$(STRHELP.N) = LEFT$(STRHELP.REST$, STRHELP.AT - 1)
    STRHELP.REST$ = MID$(STRHELP.REST$, STRHELP.AT + LEN(STRHELP.DELIM$))
    GOTO STRHELP.SPLIT.NEXT

## STRHELP.REPLACE -- replace EVERY occurrence of STRHELP.FIND$ in
## STRHELP.STR$ with STRHELP.REPL$.
##
##   in    STRHELP.STR$    the string, MODIFIED IN PLACE like the pad
##                         routines (SPLIT is the odd one out there)
##         STRHELP.FIND$   what to look for. Case SENSITIVE, because
##                         GP.INSTR compares raw bytes
##         STRHELP.REPL$   what to put in its place. May be shorter,
##                         longer, or "" to DELETE every occurrence
##   clobbers  STRHELP.OUT$  STRHELP.REST$  STRHELP.AT
##
## IT BUILDS A NEW STRING RATHER THAN EDITING IN PLACE, which is what makes it safe when
## the replacement CONTAINS what is being replaced: "A" -> "AA" would never terminate if
## the output were re-scanned, but everything emitted has moved into STRHELP.OUT$ and
## only STRHELP.REST$ -- shrinking by at least LEN(FIND$) a pass -- is searched again.
## In place is not available anyway: a longer replacement GROWS the string.
##
## An EMPTY STRHELP.FIND$ leaves the string alone rather than looping forever, and no
## guard here does it -- GP.INSTR reports "not found" for a zero length needle, so the
## first pass takes the exit branch.
##
## NOT LENGTH CHECKED, as with the pad routines.

STRHELP.REPLACE:
    STRHELP.OUT$ = "" : STRHELP.REST$ = STRHELP.STR$
STRHELP.REPLACE.NEXT:
    STRHELP.AT = GP.INSTR(STRHELP.REST$, STRHELP.FIND$)
    IF STRHELP.AT = 0 THEN STRHELP.STR$ = STRHELP.OUT$ + STRHELP.REST$ : RETURN
    STRHELP.OUT$ = STRHELP.OUT$ + LEFT$(STRHELP.REST$, STRHELP.AT - 1) + STRHELP.REPL$
    STRHELP.REST$ = MID$(STRHELP.REST$, STRHELP.AT + LEN(STRHELP.FIND$))
    GOTO STRHELP.REPLACE.NEXT

## STRHELP.PET2SCR -- a PETSCII code to the SCREEN code the tile map holds.
##
##   in    STRHELP.PET     0..255, what ASC() gives you
##   out   STRHELP.SCR     the screen code TILE, TDATA and VPOKE want
##   clobbers  nothing
##
## GP.PRINTAT and GP.FILL do this internally, so you only need it when writing the map
## yourself -- TILE X,Y,STRHELP.SCR, or a VPOKE for a whole row at once.
##
## IN BASIC ON PURPOSE, and not for the byte count: the ASM GPDrawPet2Scr sits at NO
## FIXED ADDRESS. The resident runtime pins two things only, the magic at RTBASE and the
## entry jmp at RTBASE+4; everything else floats from build to build, so a GP.CALL to an
## address read out of code.lbl works until the next build and then writes somewhere
## else. Nine lines here cannot rot.
##
## A compare chain rather than an offset table, because a table needs a DATA statement --
## and READ walks every DATA in the whole program in order.
##
## $FF is the one value the arithmetic gets wrong: pi is screen code 94, not 127.
## CHR$(222) is the same character and needs no special case.
##
## Nothing converts to 160..191, the reverse-video glyphs: PETSCII says "reverse" with a
## control code, not a character. Swap the colour attribute instead.

STRHELP.PET2SCR:
    STRHELP.SCR = STRHELP.PET
    IF STRHELP.PET = 255 THEN STRHELP.SCR = 94 : RETURN
    IF STRHELP.PET < 32 THEN STRHELP.SCR = STRHELP.PET + 128 : RETURN
    IF STRHELP.PET < 64 THEN RETURN
    IF STRHELP.PET < 96 THEN STRHELP.SCR = STRHELP.PET - 64 : RETURN
    IF STRHELP.PET < 128 THEN STRHELP.SCR = STRHELP.PET - 32 : RETURN
    IF STRHELP.PET < 160 THEN STRHELP.SCR = STRHELP.PET + 64 : RETURN
    IF STRHELP.PET < 192 THEN STRHELP.SCR = STRHELP.PET - 64 : RETURN
    STRHELP.SCR = STRHELP.PET - 128
    RETURN

STRHELP.SKIP:
#ENDIF
