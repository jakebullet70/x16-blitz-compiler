#SAVEAS "@:EDITOR.PRG"
#AUTONUM 1
#REM 0
#SYMFILE "@:EDITOR.SYM"
#DEFINE ED.KBDBUF $F09F
## kbdbuf_get_modifiers. Bit 1 is Alt. A character code cannot carry a modifier, and in
## ISO mode the driver sends no Commodore+letter codes at all, so this is how ALT is seen.
#DEFINE ED.KBDMOD $FEC0
#DEFINE ED.MOD.ALT 2
## The single-line box, as TILE INDICES: GUI.FRAME draws it with GP.BOX, whose custom
## glyphs reach the cell unconverted. ED.PETFONT is what parks them here.
#DEFINE ED.GL.H 192
#DEFINE ED.GL.V 193
#DEFINE ED.GL.TL 194
#DEFINE ED.GL.TR 195
#DEFINE ED.GL.BL 196
#DEFINE ED.GL.BR 197

## The RAM bank GUI.INC.BL saves a dialog's cells into. Not a spare one lying around:
## the document store gave it up and starts its own arena at 5 instead.
#DEFINE ED.GUI.BANK 4

REM Index 0 is transparent BY HARDWARE, and the chrome now has the document behind it. So
REM black needs an index that is not 0. Five is free in both themes, in either nibble.
#DEFINE ED.BLK 5

#INCLUDE "GPB.INC.BL"
#INCLUDE "THEME.INC.BL"
#INCLUDE "APPSYS.INC.BL"
REM STASH.INC.BL saves the cells a dialog covers -- GP.STASH and GP.RESTR until they left
REM the GP block on 01/09/26. The #SYMFILE above is for it: it reaches BASIC's variables
REM from assembly through {VAR}, and by then BASLOAD has crunched every name.
#INCLUDE "STASH.INC.BL"
#INCLUDE "MENUVERT.INC.BL"
#INCLUDE "MENUBAR.INC.BL"
#INCLUDE "LINEINPUT.INC.BL"
#INCLUDE "GUI.INC.BL"

REM ============================================================================
REM EDITOR.BASL -- GPC EDIT, an MS-DOS-EDIT-styled text / Markdown editor for the
REM Commander X16, written in BASLOAD and compiled by GPC.
REM
REM NOTHING GOES THROUGH THE KERNAL. Every cell -- text area and chrome alike -- is
REM written straight into VERA's text map. CHROUT is a fixed ROM cost compiling cannot
REM touch, and padding a bar a space at a time was O(n^2). The document lives in banked
REM RAM behind the DOC.* layer in STORE.BASL, #INCLUDEd at the bottom.
REM
REM THE TWO RENDERERS ARE INLINE ASSEMBLY. ED.RENDER.ROW draws text, ED.PUT.FIELD draws
REM chrome, and each is one GP.ASM block reaching BASIC's variables through {VAR}. That
REM is the whole speed story; EDBENCH.BASL measures both against their BASIC versions.
REM
REM GP.ASM COSTS NO RUNTIME BYTES. What does is GP.SELECT in the key dispatch: one core
REM keyword pulls in the whole 2 KB GP block, which is why this compiles GP-BASIC IN --
REM readability bought knowingly. The main loop's GP.DO then rides in free.
REM
REM Colours (like DETOK): blue bars, black text area, white text, cyan prompts,
REM white-on-red errors.
REM ============================================================================

DEBUG.MODE = 0 : REM 1 = run the self-check to the log and stop. 0 = interactive.
ED.SCREEN.MODE = 1 : REM 1 = 80x30, 3 = 40x30 (see KERNAL screen_mode $FF5F)
ED.DARK = 0 : REM 0 = the DETOK light palette, 1 = the dark one (see ED.THEME)

GOSUB ED.INIT
DOC.FILE.NAME$ = "TEST.MD"
GOSUB DOC.LOADFILE
GOSUB ED.OPEN.DONE
GOSUB ED.RENDER.ALL
GOSUB ED.L0.ON

IF DEBUG.MODE = 1 THEN GOSUB ED.SELFCHECK : END

REM ---- main loop ----
REM
GP.DO
  GET ED.KEY$
  GP.IF ED.KEY$ <> "" THEN 
    ED.KEY = ASC(ED.KEY$)  
    GOSUB ED.READ.MODS
    GOSUB ED.DISPATCH.KEY
  GP.ENDIF
GP.LOOP


ED.DISPATCH.KEY:
  REM ALT modifies whatever key arrived rather than being one, so it is tested before the
  REM selector rather than sitting in it as a code.
  IF ED.MODS.ALT <> 0 THEN GOSUB ED.ALT.MENU : RETURN
  GP.SELECT ED.KEY
    GP.CASE 27  : MENU.ACTIVE = 0 : GOSUB ED.OPEN.MENUBAR
    GP.CASE 157 : GOSUB ED.MOVE.LEFT
    GP.CASE 29  : GOSUB ED.MOVE.RIGHT
    GP.CASE 145 : GOSUB ED.MOVE.UP
    GP.CASE 17  : GOSUB ED.MOVE.DOWN
    GP.CASE 19  : GOSUB ED.MOVE.HOME
    GP.CASE 4   : GOSUB ED.MOVE.END
    GP.CASE 130 : GOSUB ED.MOVE.PAGEUP
    GP.CASE 2   : GOSUB ED.MOVE.PAGEDOWN
    GP.CASE 13  : GOSUB ED.DO.ENTER
    GP.CASE 20  : GOSUB ED.DO.BACKSPACE
    GP.CASE 25  : GOSUB ED.DO.DELETE
    GP.CASE 148 : GOSUB ED.TOGGLE.INSERT
    GP.CASE 137 : GOSUB ED.CMD.SAVE
    GP.CASE 134 : GOSUB ED.FIND.NEXT
    GP.OTHER    : GOSUB ED.KEY.RANGE
  GP.ENDSEL
  RETURN

REM Asked while the key is still down. $FEC0 is below the $FF00 jump table, so it is not
REM mirrored across ROM banks and the call needs the KERNAL paged in.
ED.READ.MODS:
  POKE 1, 0 : GP.CALL ED.KBDMOD : POKE 1, 4
  ED.MODS = GP.A : ED.MODS.ALT = 0
  IF (ED.MODS AND ED.MOD.ALT) <> 0 THEN ED.MODS.ALT = 1
  RETURN

ED.KEY.RANGE:
  REM ASCII, because ED.INIT declares ISO encoding -- see the $0372 poke there. Under
  REM PETSCII this had to case-swap every letter.
  IF ED.KEY >= 32 AND ED.KEY <= 126 THEN GOSUB ED.DO.INSERT
  RETURN


ED.QUIT:
  POKE 40761, 0 : POKE 40762, 0 : REM undo any hardware VSCROLL before returning to BASIC
  REM layer 0 off again, and palette 5 back to whatever it was
  POKE 40754, 0 : POKE 40755, 0 : POKE 40741, 0 : POKE 40745, PEEK(40745) AND 239
  VPOKE 1, 64010, ED.PAL5.LO : VPOKE 1, 64011, ED.PAL5.HI
  GOSUB ED.ALTKEYS.OFF : REM and the keyboard layout, which outlives the program
  REM APPSYS.RESTORE hands back the mode, charset and colour APPSYS.STARTUP found -- the
  REM user's, not a hardcoded 3, so someone who started in upper case is not dropped into
  REM lower. Re-uploading the charset is also what undoes ED.PETFONT's re-ordering, so
  REM NOTHING MAY BE PRINTED BEFORE THIS LINE or it comes out in the wrong glyphs.
  GOSUB APPSYS.RESTORE
  PRINT CHR$(147);
  PRINT "BYE."
  END



REM ============================================================================
REM ASCII-ORDER CHARSET (ED.PETFONT)
REM
REM THE RENDERERS WRITE DOCUMENT BYTES STRAIGHT INTO VERA, and a tile index is a SCREEN
REM code, not a character code. Charset 3 gives PETSCII glyphs in both cases but is in
REM screen-code order, so re-order it in VRAM instead: glyph N becomes the glyph for code
REM N, and both renderers stay as they are -- no table, no lookup, zero cycles a cell.
REM Translating in the renderer would have cost 6 cycles on a 31-cycle cell.
REM
REM ASCII ORDER, NOT PETSCII, and that is the whole reason it works: BASLOAD writes string
REM literals through as the source bytes, so every name, prompt and message here is ASCII.
REM PETSCII order case-swaps all of them and stops find matching its own needles -- which
REM the self-check caught. PETSCII belongs at the DISK boundary, in STORE.BASL.
REM
REM ALMOST NOTHING MOVES: $20-$3F and $41-$5A are already where ASCII wants them, so only
REM 38 glyphs shift.
REM
REM   ASCII $40  @     <- screen $00        ASCII $60  `     <- screen $40
REM   ASCII $5B-$5F    <- screen $1B-$1F    ASCII $61-$7A a-z <- screen $01-$1A
REM   ASCII $7B-$7F    <- screen $5B-$5F
REM
REM Two of those read from a run another one writes, so ORDER MATTERS: $60 before $40, and
REM $7B-$7F before $5B-$5F. Nothing forms a cycle, so no staging buffer is needed.
REM ============================================================================
REM ============================================================================
REM GUI.INC.BL SETUP
REM ============================================================================
REM Done ONCE: four facts about this program the library cannot work out for itself.
REM
REM GUI.GLYPH IS WHY THE DIALOGS WORK HERE. GP.BOX's built-in styles come from a runtime
REM table at the screen codes the STOCK charset uses, and ED.PETFONT has just moved every
REM one of them -- style 2 would draw "p @ B". GUI.FRAME takes the six glyphs named here
REM instead, the ones ED.PETFONT rescued into $C0-$C5, and hands them to GP.BOX as a
REM custom set. MUST RUN AFTER ED.PETFONT, or it names glyphs that are not there yet.
ED.GUI.SETUP:
  GUI.BANK = ED.GUI.BANK
  GUI.ROW.OFFSET = 0

  REM THE COLOURS, because ED.THEME re-points the roles the library assumes: BORDER is the
  REM hotkey letter here, and PAGE a grey it never uses. Left alone a dialog came up as a
  REM grey slab with a blue edge in a black editor. Both go to THEME.TEXT, the document's
  REM own white on black and what the dropdown frames with, so the two match.
  GUI.PANEL.IN = THEME.CLR(THEME.TEXT)
  GUI.BORDER.IN = THEME.CLR(THEME.TEXT)

  GUI.GLYPH = 1
  GUI.EDGE.H    = ED.GL.H  : GUI.EDGE.V    = ED.GL.V
  GUI.CORNER.TL = ED.GL.TL : GUI.CORNER.TR = ED.GL.TR
  GUI.CORNER.BL = ED.GL.BL : GUI.CORNER.BR = ED.GL.BR
  GUI.ROW.OFFSET = 0 : REM layer 1 does not scroll: a screen row IS a map row
  RETURN

ED.PETFONT:
  ED.FONT = 61440 : REM $1:F000, the KERNAL's 2 KB charset (VERA bank 1)
  REM ---- THE SINGLE-LINE BOX, RESCUED BEFORE THE RE-ORDER RUNS OVER IT ----
  REM Charset 3 keeps its box drawing at $40-$7D, which is most of what the re-order below
  REM buries under ASCII letters -- no corners survive at all, which is why GP.BOX's own
  REM styles draw "p @ B" here. So copy the six up into $C0-$C5 FIRST, the one region the
  REM re-order never touches and nothing else writes. Being ahead of every other copy is
  REM what keeps each source pristine.
  ED.FS = 64  : ED.FD = ED.GL.H  : ED.FN = 1 : GOSUB ED.FCOPY : REM $40 horizontal
  ED.FS = 93  : ED.FD = ED.GL.V  : ED.FN = 1 : GOSUB ED.FCOPY : REM $5D vertical
  ED.FS = 112 : ED.FD = ED.GL.TL : ED.FN = 1 : GOSUB ED.FCOPY : REM $70 top left
  ED.FS = 110 : ED.FD = ED.GL.TR : ED.FN = 1 : GOSUB ED.FCOPY : REM $6E top right
  ED.FS = 109 : ED.FD = ED.GL.BL : ED.FN = 1 : GOSUB ED.FCOPY : REM $6D bottom left
  ED.FS = 125 : ED.FD = ED.GL.BR : ED.FN = 1 : GOSUB ED.FCOPY : REM $7D bottom right
  REM ---- and now the ASCII re-order itself ----
  ED.FS = 64  : ED.FD = 96  : ED.FN = 1  : GOSUB ED.FCOPY
  ED.FS = 91  : ED.FD = 123 : ED.FN = 5  : GOSUB ED.FCOPY
  ED.FS = 0   : ED.FD = 64  : ED.FN = 1  : GOSUB ED.FCOPY
  ED.FS = 27  : ED.FD = 91  : ED.FN = 5  : GOSUB ED.FCOPY
  ED.FS = 1   : ED.FD = 97  : ED.FN = 26 : GOSUB ED.FCOPY
  RETURN


REM Copy ED.FN glyphs, 8 bytes each, from screen code ED.FS to code ED.FD. GP.DO takes its
REM count once up front rather than re-evaluating a FOR's TO every pass -- but GP.DO 0
REM loops FOREVER, so a zero count would hang here rather than do nothing.
ED.FCOPY:
  ED.FCOUNT = ED.FN * 8
  ED.FI = 0
  GP.DO ED.FCOUNT
    VPOKE 1, ED.FONT + ED.FD * 8 + ED.FI, VPEEK(1, ED.FONT + ED.FS * 8 + ED.FI)
    ED.FI = ED.FI + 1
  GP.LOOP
  RETURN

REM ============================================================================
REM THEME -- every colour in one place, as named roles
REM
REM The editor's own values, not THEME.LOAD's: the library's palette is a blue-page app
REM look and this is DETOK's. The ROLES are what is shared, not the colours.
REM
REM   PAGE    dropdown panel        TITLE   menu bar, status bar, messages
REM   TEXT    the document          BORDER  the hotkey letter in a menu title
REM   HILITE  caret, active title   DIMMED  prompts        WARN  errors
REM
REM An attribute is background * 16 + foreground, which is what VERA and every GP command
REM already take.
REM ============================================================================
ED.THEME:
  REM THEME.LOAD owns the DIM: GPC rejects a second DIM of the same array even when only
  REM one can run (ARRAY REDEFINED), so call it and then overwrite the slots.
  THEME.DARK = ED.DARK
  GOSUB THEME.LOAD
  IF ED.DARK <> 0 THEN GOTO ED.THEME.DARK
  THEME.CLR(THEME.PAGE)   = 15 * 16 + ED.BLK : REM black on light grey -- unused: the dropdown is TEXT
  THEME.CLR(THEME.TEXT)   = ED.BLK * 16 + 1 : REM white on black -- the document
  THEME.CLR(THEME.TITLE)  =  6 * 16 + 1 : REM white on blue -- bars and messages
  THEME.CLR(THEME.BORDER) =  6 * 16 + 7 : REM yellow on blue -- the hotkey letter
  THEME.CLR(THEME.HILITE) =  1 * 16 + ED.BLK : REM black on white -- caret, active title
  THEME.CLR(THEME.DIMMED) = ED.BLK * 16 + 3 : REM cyan on black -- prompts
  THEME.CLR(THEME.WARN)   =  2 * 16 + 1 : REM white on red -- errors
  RETURN

ED.THEME.DARK:
  THEME.CLR(THEME.PAGE)   = 11 * 16 + 15
  THEME.CLR(THEME.TEXT)   = ED.BLK * 16 + 15
  THEME.CLR(THEME.TITLE)  = 11 * 16 + 1
  THEME.CLR(THEME.BORDER) = 11 * 16 + 7
  THEME.CLR(THEME.HILITE) = 15 * 16 + ED.BLK
  THEME.CLR(THEME.DIMMED) = ED.BLK * 16 + 12
  THEME.CLR(THEME.WARN)   =  2 * 16 + 1
  RETURN


REM ============================================================================
REM SETUP
REM ============================================================================
ED.INIT:
  REM FIRST, before any mode or colour of our own: APPSYS.STARTUP records the state as it
  REM FINDS it and ED.QUIT hands that back. Anything changed above this line is lost.
  GOSUB APPSYS.STARTUP
  GOSUB ED.THEME
  REM GP.CALL, not SYS: A, X, Y and CARRY as arguments, results in GP.A / GP.X / GP.Y,
  REM against SYS's four statements through the POKE 780..783 slots. Free here -- the GP
  REM block is already paid for by the GP.SELECT in the key dispatch.
  GP.CALL APPSYS.SCRMODE, ED.SCREEN.MODE, 0, 0, 0 : REM carry CLEAR sets the mode
  GP.CALL APPSYS.SETCHR, 3, 0, 0, 0 : REM charset 3, PET upper/lower
  PRINT CHR$(147);
  GOSUB ED.PETFONT : REM ...then re-index it so a VERA tile index IS a character code
  REM ...and DECLARE it, with bit 6 of $0372: "text is ASCII", which is now simply true of
  REM the re-ordered font. POKED, NOT CHR$(15) -- CHR$(15) would upload the ISO font too
  REM and throw the PETSCII glyphs away. Three things follow, all wanted: the keyboard
  REM returns ASCII, PRINT stops translating, and GP.PRINTAT skips its PETSCII step, which
  REM is what lets the GP commands (and MENUVERT, built on them) work here at all.
  POKE 882, PEEK(882) OR 64
  GOSUB ED.GUI.SETUP : REM ...and tell GUI.INC.BL where the frame glyphs ended up
  REM The same entry point with CARRY SET, which makes screen_mode REPORT instead: mode in
  REM A, columns in X, rows in Y, replacing $FFED. Asked AFTER the mode is set, and NOT the
  REM size APPSYS.STARTUP holds -- that one is the user's 80x60, kept for ED.QUIT to give
  REM back. This is the 80x30 the editor just chose and every renderer lays out in.
  GP.CALL APPSYS.SCRMODE, 0, 0, 0, 1
  SCREEN.COLS = GP.X : SCREEN.ROWS = GP.Y
  IF SCREEN.COLS < 20 THEN SCREEN.COLS = 80
  IF SCREEN.ROWS < 8 THEN SCREEN.ROWS = 60
  ED.TEXT.WIDTH  = SCREEN.COLS
  ED.TEXT.BOTTOM = SCREEN.ROWS - 2
  ED.TEXT.ROWS   = SCREEN.ROWS - 2
  ED.ATTR.TEXT   = THEME.CLR(THEME.TEXT)
  ED.ATTR.CARET  = THEME.CLR(THEME.HILITE)
  ED.QUIET = 0 : ED.SIM.MODE = 0 : ED.EXIT.FLAG = 0 : ED.LAST.MSG$ = ""
  REM ---- hardware vertical scroll setup (see ED.DO.SCROLL) ----
  REM VERA's L1_VSCROLL ($9F39/$9F3A, map pixels, 8 a text row) scrolls the layer, so a
  REM one-line move repaints 3 rows and not the screen. Screen row R is map row
  REM R + ED.MAP.TOP, and ED.MAP.TOP = VSCROLL/8. Map height comes from L1_CONFIG bits 7:6
  REM (32<<n); ED.MAP.TOP is kept inside [0, MAP.H - SCREEN.ROWS] so the window never
  REM crosses the map's edge -- no reliance on VERA's wrap, we rewind and repaint instead.
  ED.MAP.TOP = 0
  POKE 40761, 0 : POKE 40762, 0 : REM L1 never scrolls again -- see ED.LAYERS
  ED.MAP.CFG = PEEK(40756) : ED.MAP.HB = INT(ED.MAP.CFG / 64) : ED.MAP.H = 32
  IF ED.MAP.HB = 1 THEN ED.MAP.H = 64
  IF ED.MAP.HB = 2 THEN ED.MAP.H = 128
  IF ED.MAP.HB = 3 THEN ED.MAP.H = 256
  ED.MAP.MAXTOP = ED.MAP.H - SCREEN.ROWS
  ED.HW.OK = 0 : IF ED.MAP.MAXTOP >= 4 THEN ED.HW.OK = 1
  GOSUB ED.LAYERS
  MENU.ACTIVE = 0 - 1 : GOSUB ED.MENU.SETUP : GOSUB ED.ALTKEYS
  RETURN

REM VSCROLL moves a whole LAYER, so with one layer the bars slid with the document and had
REM to be redrawn at their new map row every line. Layer 0 takes the document and scrolls
REM alone; layer 1 keeps the bars, the dropdown and the dialogs at fixed SCREEN rows. The
REM seam was already there: every GP command addresses layer 1 only, and the document is
REM drawn by assembly that takes its address from a variable.
ED.LAYERS:
  POKE 40741, 0 : REM DCSEL 0, or $9F29 is an FX register instead of DC_VIDEO
  ED.PAL5.LO = VPEEK(1, 64010) : ED.PAL5.HI = VPEEK(1, 64011)
  VPOKE 1, 64010, 0 : VPOKE 1, 64011, 0 : REM palette 5 = $000, an opaque black
  REM L0: config and tilebase copied from L1, map at $00000, and the only scroll left.
  POKE 40749, PEEK(40756) : POKE 40750, 0 : POKE 40751, PEEK(40758)
  POKE 40754, 0 : POKE 40755, 0
  GOSUB ED.CLEAR.OVERLAY
  RETURN

REM Layer 0 is switched on AFTER the first full render, not here, and it is never cleared:
REM VRAM comes up with whatever was in it, but a row is always painted before it can be
REM seen -- ED.RENDER.ALL paints the whole window, and a scroll paints the row it exposes.
REM The map rows under the bars are never visible at all; the bars are opaque.
ED.L0.ON:
  POKE 40741, 0 : POKE 40745, PEEK(40745) OR 16 : REM DC_VIDEO bit 4
  RETURN

REM Layer 1's text region back to transparent. Attribute 0 is the transparent one.
ED.CLEAR.OVERLAY:
  GP.FILL 0, 1, SCREEN.COLS, ED.TEXT.ROWS, 32, 0
  RETURN

REM ============================================================================
REM ALT+letter, by making the LAYOUT produce the letter
REM
REM In ISO mode the ALT table does not hand back the letter. Measured: ALT+S arrives as
REM 223 (eszett) and ALT+F arrives as NOTHING AT ALL, its slot being empty -- so the
REM character can never say which key was hit. kbdbuf_get_modifiers says ALT was down but
REM not what it was down WITH.
REM
REM The layout is writable, so write it. Eleven 128-byte tables live at $A000 on RAM bank
REM 0: byte 0 an ID, bytes 1..127 the code each KEYNUM produces, ID $80 plain ISO and $C6
REM ISO+Alt. Find a menu's initial in the plain table -- the index IS that key's keynum --
REM and write the upper case letter at the same index of the ALT table.
REM
REM FOUND BY SEARCH, NOT A HARDCODED KEYNUM, so it holds for whatever layout is loaded and
REM follows the menu names: rename a menu and its accelerator moves with it. Every byte is
REM saved and put back by ED.ALTKEYS.OFF -- the tables outlive the program.
REM
REM BANK 0, NOT POKE 0: PEEK/POKE restore the bank around every access, so a POKE to the
REM bank register is undone by the same POKE that made it. The document layer's banks
REM start at 1, so borrowing 0 here disturbs nothing.
ED.ALTKEYS:
  ED.NALT = 0
  BANK 0
  ED.TPLAIN = 0 : ED.TALT = 0
  FOR ED.TI = 0 TO 10
    ED.TB = 40960 + 128 * ED.TI
    IF PEEK(ED.TB) = 128 THEN ED.TPLAIN = ED.TB
    IF PEEK(ED.TB) = 198 THEN ED.TALT = ED.TB
  NEXT ED.TI
  IF ED.TPLAIN = 0 THEN RETURN
  IF ED.TALT = 0 THEN RETURN
  FOR MENU.I = 0 TO MENU.COUNT - 1
    ED.WANT = ASC(LEFT$(MENU.NAME$(MENU.I), 1))
    FOR ED.KI = 1 TO 127
      IF PEEK(ED.TPLAIN + ED.KI) = ED.WANT + 32 THEN GOSUB ED.ALTKEY.SET
    NEXT ED.KI
  NEXT MENU.I
  RETURN

ED.ALTKEY.SET:
  ED.ALTK(ED.NALT) = ED.TALT + ED.KI
  ED.ALTV(ED.NALT) = PEEK(ED.TALT + ED.KI)
  POKE ED.TALT + ED.KI, ED.WANT : ED.NALT = ED.NALT + 1
  RETURN

ED.ALTKEYS.OFF:
  IF ED.NALT = 0 THEN RETURN
  BANK 0
  FOR ED.AI = 0 TO ED.NALT - 1
    POKE ED.ALTK(ED.AI), ED.ALTV(ED.AI)
  NEXT ED.AI
  ED.NALT = 0
  RETURN

ED.OPEN.DONE:
  ED.TOP.LINE = 0 : ED.LEFT.COL = 0 : ED.CUR.ROW = 0 :  ED.CUR.COL = 0 : ED.INSERT.MODE = 1 : ED.DOC.DIRTY = 0
  GOSUB ED.LOAD.LIVE
  RETURN


REM ---- menu tables (data-driven) ----
REM The bar's layout is MENUBAR.INC.BL's: MENUBAR.WHERE works out a title's column from the
REM item text on demand, which is what ED.DRAW.DROPDOWN hangs the panel from. MENU.WIDTH
REM stays because it is the DROPDOWN's width, and a bar has no column width.
ED.MENU.SETUP:
  MENU.COUNT = 3
  DIM MENU.NAME$(3) : DIM MENU.ITEMS(3) : DIM MENU.WIDTH(3)
  DIM MENU.ITEMHOT$(3) : REM one accelerator letter per ITEM, one string per menu
  DIM MENU.ITEM$(24) : REM flat: menu * 8 + item
  DIM MENUVERT.ITEM$(8) : REM MENUVERT leaves its item array to the caller
  DIM ED.ALTK(8) : DIM ED.ALTV(8) : REM layout bytes ED.ALTKEYS overwrites, to put back
  MENU.NAME$(0) = "File" : MENU.ITEMS(0) = 5
  MENU.ITEM$(0) = "New" : MENU.ITEM$(1) = "Open..." : MENU.ITEM$(2) = "Save"
  MENU.ITEM$(3) = "Save As..." : MENU.ITEM$(4) = "Exit"
  MENU.NAME$(1) = "Search" : MENU.ITEMS(1) = 2
  MENU.ITEM$(8) = "Find..." : MENU.ITEM$(9) = "Go to Line..."
  MENU.NAME$(2) = "Help" : MENU.ITEMS(2) = 1
  MENU.ITEM$(16) = "About"
  MENU.HOT$ = "FSH" : REM the initials, for the bar's accelerator tint and its hotkeys
  REM ONE LETTER PER ITEM, IN ITEM ORDER, and it does not have to be the initial: Save
  REM and Save As... both start with S, so the second takes its A. MENUVERT matches
  REM without case and tints the letter at a word start where it can find one -- the A
  REM of "As", not the a of "Save". A letter not in the item at all is still a working
  REM accelerator; it just does not light up.
  MENU.ITEMHOT$(0) = "NOSAX" : REM New Open Save saveAs eXit
  MENU.ITEMHOT$(1) = "FG"    : REM Find, Go to line
  MENU.ITEMHOT$(2) = "A"     : REM About
  FOR MENU.I = 0 TO MENU.COUNT - 1
    MENU.W = LEN(MENU.NAME$(MENU.I))
    FOR MENU.J = 0 TO MENU.ITEMS(MENU.I) - 1
      IF LEN(MENU.ITEM$(MENU.I * 8 + MENU.J)) > MENU.W THEN MENU.W = LEN(MENU.ITEM$(MENU.I * 8 + MENU.J))
    NEXT MENU.J
    MENU.WIDTH(MENU.I) = MENU.W + 2
  NEXT MENU.I
  RETURN


REM ---- the bar's items, into the array MENUBAR reads ----
REM MENUBAR and MENUVERT share MENUVERT.ITEM$ on purpose, so it holds whichever of the two
REM is being drawn and this routine and ED.DRAW.DROPDOWN each load their own first. Cheap;
REM keeping two copies in step would not be.
REM
REM AN ITEM IS " NAME " AND THE SPACES ARE THE LAYOUT -- MENUBAR makes each item exactly as
REM wide as its text, so the air around a title, and the highlight's margin, has to be in
REM the title itself.
ED.MENU.BAR.ITEMS:
  FOR MENU.I = 0 TO MENU.COUNT - 1
    MENUVERT.ITEM$(MENU.I + 1) = " " + MENU.NAME$(MENU.I) + " "
  NEXT MENU.I
  MENUVERT.COUNT = MENU.COUNT : MENUVERT.X = 0 : MENUVERT.Y = 0
  MENUVERT.ATTR = THEME.CLR(THEME.TITLE)
  MENUVERT.HIATTR = THEME.CLR(THEME.HILITE)
  MENUVERT.HOT$ = MENU.HOT$
  MENUVERT.HOTATTR = THEME.CLR(THEME.BORDER)
  MENUBAR.X = 0 : MENUBAR.Y = 0 : MENUBAR.GAP = 0
  RETURN



REM ============================================================================
REM LIVE LINE
REM ============================================================================
ED.LOAD.LIVE:
  LINE.INDEX = ED.CUR.ROW : GOSUB DOC.LOAD
  ED.CUR.LINE$ = LINE.TEXT$ : ED.CUR.DIRTY = 0
  RETURN

ED.COMMIT.LIVE:
  IF ED.CUR.DIRTY = 0 THEN RETURN
  LINE.TEXT$ = ED.CUR.LINE$ : LINE.INDEX = ED.CUR.ROW : GOSUB DOC.STORE
  ED.CUR.DIRTY = 0
  RETURN

ED.CLAMP.COL:
  IF ED.CUR.COL > LEN(ED.CUR.LINE$) THEN ED.CUR.COL = LEN(ED.CUR.LINE$)
  RETURN



REM ============================================================================
REM CURSOR MOVEMENT
REM ============================================================================
ED.MOVE.LEFT:
  IF ED.CUR.COL > 0 THEN ED.CUR.COL = ED.CUR.COL - 1 : GOSUB ED.CARET.REFRESH : RETURN
  IF ED.CUR.ROW = 0 THEN RETURN
  GOSUB ED.COMMIT.LIVE
  ED.CUR.ROW = ED.CUR.ROW - 1 :    GOSUB ED.LOAD.LIVE
  ED.CUR.COL = LEN(ED.CUR.LINE$) : GOSUB ED.CARET.REFRESH
  RETURN

ED.MOVE.RIGHT:
  IF ED.CUR.COL < LEN(ED.CUR.LINE$) THEN ED.CUR.COL = ED.CUR.COL + 1 : GOSUB ED.CARET.REFRESH : RETURN
  IF ED.CUR.ROW >= LINE.COUNT - 1 THEN RETURN
  GOSUB ED.COMMIT.LIVE
  ED.CUR.ROW = ED.CUR.ROW + 1 : GOSUB ED.LOAD.LIVE
  ED.CUR.COL = 0 : GOSUB ED.CARET.REFRESH
  RETURN

ED.MOVE.UP:
  IF ED.CUR.ROW = 0 THEN RETURN
  GOSUB ED.COMMIT.LIVE
  ED.CUR.ROW = ED.CUR.ROW - 1 : GOSUB ED.LOAD.LIVE : GOSUB ED.CLAMP.COL
  GOSUB ED.CARET.REFRESH
  RETURN

ED.MOVE.DOWN:
  IF ED.CUR.ROW >= LINE.COUNT - 1 THEN RETURN
  GOSUB ED.COMMIT.LIVE
  ED.CUR.ROW = ED.CUR.ROW + 1 : GOSUB ED.LOAD.LIVE : GOSUB ED.CLAMP.COL
  GOSUB ED.CARET.REFRESH
  RETURN

ED.MOVE.HOME:
  ED.CUR.COL = 0 : GOSUB ED.CARET.REFRESH
  RETURN

ED.MOVE.END:
  ED.CUR.COL = LEN(ED.CUR.LINE$) : GOSUB ED.CARET.REFRESH
  RETURN

ED.MOVE.PAGEUP:
  GOSUB ED.COMMIT.LIVE :  ED.CUR.ROW = ED.CUR.ROW - ED.TEXT.ROWS
  IF ED.CUR.ROW < 0 THEN ED.CUR.ROW = 0
  GOSUB ED.LOAD.LIVE : GOSUB ED.CLAMP.COL : GOSUB ED.CARET.REFRESH
  RETURN

ED.MOVE.PAGEDOWN:
  GOSUB ED.COMMIT.LIVE : ED.CUR.ROW = ED.CUR.ROW + ED.TEXT.ROWS
  IF ED.CUR.ROW > LINE.COUNT - 1 THEN ED.CUR.ROW = LINE.COUNT - 1
  GOSUB ED.LOAD.LIVE : GOSUB ED.CLAMP.COL : GOSUB ED.CARET.REFRESH
  RETURN

REM ============================================================================
REM EDITING
REM ============================================================================
ED.DO.INSERT:
  IF LEN(ED.CUR.LINE$) >= 250 THEN RETURN
  ED.CH$ = CHR$(ED.KEY)
  IF ED.INSERT.MODE = 0 AND ED.CUR.COL < LEN(ED.CUR.LINE$) THEN GOTO ED.INS.OVER
  ED.CUR.LINE$ = LEFT$(ED.CUR.LINE$, ED.CUR.COL) + ED.CH$ + MID$(ED.CUR.LINE$, ED.CUR.COL + 1, 250)
  GOTO ED.INS.DONE
ED.INS.OVER:
  ED.CUR.LINE$ = LEFT$(ED.CUR.LINE$, ED.CUR.COL) + ED.CH$ + MID$(ED.CUR.LINE$, ED.CUR.COL + 2, 250)
ED.INS.DONE:
  ED.CUR.COL = ED.CUR.COL + 1 : ED.CUR.DIRTY = 1 : ED.DOC.DIRTY = 1
  GOSUB ED.REFRESH.INTRA
  RETURN

ED.DO.BACKSPACE:
  IF ED.CUR.COL = 0 THEN GOTO ED.BS.JOIN
  ED.CUR.LINE$ = LEFT$(ED.CUR.LINE$, ED.CUR.COL - 1) + MID$(ED.CUR.LINE$, ED.CUR.COL + 1, 250)
  ED.CUR.COL = ED.CUR.COL - 1 : ED.CUR.DIRTY = 1 : ED.DOC.DIRTY = 1
  GOSUB ED.REFRESH.INTRA
  RETURN

ED.BS.JOIN:
  IF ED.CUR.ROW = 0 THEN RETURN
  LINE.INDEX = ED.CUR.ROW - 1 : GOSUB DOC.LOAD
  ED.JOIN.COL = LEN(LINE.TEXT$) : ED.CUR.LINE$ = LEFT$(LINE.TEXT$ + ED.CUR.LINE$, 250)
  LINE.TEXT$ = ED.CUR.LINE$ : LINE.INDEX = ED.CUR.ROW - 1 : GOSUB DOC.STORE
  LINE.INDEX = ED.CUR.ROW : GOSUB DOC.DELETE.SLOT
  ED.CUR.ROW = ED.CUR.ROW - 1 : ED.CUR.COL = ED.JOIN.COL
  ED.CUR.DIRTY = 0 : ED.DOC.DIRTY = 1  : GOSUB ED.REFRESH.FULL
  RETURN

ED.DO.DELETE:
  IF ED.CUR.COL < LEN(ED.CUR.LINE$) THEN GOTO ED.DEL.CHAR
  IF ED.CUR.ROW >= LINE.COUNT - 1 THEN RETURN
  LINE.INDEX = ED.CUR.ROW + 1 : GOSUB DOC.LOAD
  ED.CUR.LINE$ = LEFT$(ED.CUR.LINE$ + LINE.TEXT$, 250)
  LINE.TEXT$ = ED.CUR.LINE$ : LINE.INDEX = ED.CUR.ROW : GOSUB DOC.STORE
  LINE.INDEX = ED.CUR.ROW + 1 : GOSUB DOC.DELETE.SLOT
  ED.CUR.DIRTY = 0 : ED.DOC.DIRTY = 1 : GOSUB ED.REFRESH.FULL
  RETURN
  
ED.DEL.CHAR:
  ED.CUR.LINE$ = LEFT$(ED.CUR.LINE$, ED.CUR.COL) + MID$(ED.CUR.LINE$, ED.CUR.COL + 2, 250)
  ED.CUR.DIRTY = 1 : ED.DOC.DIRTY = 1 : GOSUB ED.REFRESH.INTRA
  RETURN

ED.DO.ENTER:
  ED.LEFT.HALF$ = LEFT$(ED.CUR.LINE$, ED.CUR.COL)
  ED.RIGHT.HALF$ = MID$(ED.CUR.LINE$, ED.CUR.COL + 1, 250)
  LINE.TEXT$ = ED.LEFT.HALF$ : LINE.INDEX = ED.CUR.ROW : GOSUB DOC.STORE
  LINE.INDEX = ED.CUR.ROW + 1 : GOSUB DOC.INSERT.SLOT
  LINE.TEXT$ = ED.RIGHT.HALF$ : LINE.INDEX = ED.CUR.ROW + 1 : GOSUB DOC.STORE
  ED.CUR.ROW = ED.CUR.ROW + 1 : ED.CUR.COL = 0
  ED.CUR.LINE$ = ED.RIGHT.HALF$ : ED.CUR.DIRTY = 0 : ED.DOC.DIRTY = 1
  GOSUB ED.REFRESH.FULL
  RETURN

ED.TOGGLE.INSERT:
  ED.INSERT.MODE = 1 - ED.INSERT.MODE : GOSUB ED.RENDER.STATUS
  RETURN

REM ============================================================================
REM MENUS
REM ============================================================================
ED.ALT.MENU:
  REM Whatever letter arrived with ALT down, folded to upper. No PETSCII Commodore code to
  REM decode in ISO mode -- ED.READ.MODS has already asked the KERNAL about the modifier.
  ED.ALT.CH = ED.KEY
  IF ED.ALT.CH >= 97 AND ED.ALT.CH <= 122 THEN ED.ALT.CH = ED.ALT.CH - 32
  FOR MENU.I = 0 TO MENU.COUNT - 1
    GP.IF ASC(LEFT$(MENU.NAME$(MENU.I), 1)) = ED.ALT.CH THEN 
      MENU.ACTIVE = MENU.I 
      GOSUB ED.OPEN.MENUBAR  
      RETURN
    GP.ENDIF
  NEXT MENU.I
  REM No menu with that initial. SAY WHAT ARRIVED: ALT+letter is the one path nothing
  REM headless can drive (kbdbuf_put sets no modifiers), so the machine reporting its own
  REM key and modifier bytes is the only instrument there is.
  ED.MSG$ = "ALT: key=" + MID$(STR$(ED.KEY), 2) + " mods=" + MID$(STR$(ED.MODS), 2)
  GOSUB ED.INFO.MSG
  RETURN

REM THE DROPDOWN'S KEY LOOP IS MENUVERT.RUN'S. What the editor needs on top of it is that
REM this is a dropdown UNDER A BAR: LEFT and RIGHT walk the bar with the panel still open,
REM and a letter jumps to that menu. A vertical menu rightly ignores all three, and used to
REM swallow them.
REM
REM MENUVERT.KEYEXIT is the answer, and it is a library change rather than a workaround
REM here: a key the menu has no use for ends it with MENUVERT.KEY set and MENUVERT.SEL
REM untouched, and the caller says what it meant. It mirrors MENUBAR.DOWNEXIT, so a bar and
REM its dropdown drive each other with neither module knowing the other is there.
REM
REM So the loop below is about the BAR, not about keys: one label, and every path either
REM returns to it having moved which menu is open, or returns.
REM
REM MENU.ACTIVE and MENU.SEL are 0 based (MENU.ITEM$ is flat, MENU.ACTIVE * 8 + MENU.SEL);
REM MENUBAR.SEL and MENUVERT.SEL are 1 based. Converted at the boundary and nowhere else.
ED.OPEN.MENUBAR:
  MENU.SEL = 0 : GOSUB ED.RENDER.MENUBAR
ED.MENU.OPEN:
  GOSUB ED.DRAW.DROPDOWN : MENUVERT.SEL = MENU.SEL + 1
  MENUVERT.FLAGS = MENUVERT.KEYEXIT
  REM A letter is now an ITEM's accelerator first and a MENU's second: MENUVERT gets the
  REM open menu's letters, and only a key its hotkeys did NOT claim is handed back below
  REM to ED.MENU.LETTER. MENUVERT.HOTHIT is how the two are told apart -- both exits leave
  REM KEY holding the character.
  REM ED.DRAW.DROPDOWN above set MENUVERT.HOT$ to this menu's accelerator letters.
  GOSUB MENUVERT.RUN
  IF MENUVERT.SEL = 0 THEN GOSUB ED.MENU.CANCEL : RETURN
  MENU.SEL = MENUVERT.SEL - 1
  IF MENUVERT.HOTHIT = 1 THEN GOSUB ED.MENU.SELECT : RETURN
  IF MENUVERT.KEY = 13 THEN GOSUB ED.MENU.SELECT : RETURN
  REM ED.RENDER.MENUBAR IS NOT IN THIS LOOP, and that is the point: it bands the whole row
  REM and re-prints the document name, eighty cells to move a highlight two. The movers
  REM below repaint the two titles that changed, as MENUBAR.SETTLE does.
  IF MENUVERT.KEY = 157 THEN GOSUB ED.MENU.LEFT : GOTO ED.MENU.OPEN
  IF MENUVERT.KEY = 29 THEN GOSUB ED.MENU.RIGHT : GOTO ED.MENU.OPEN
  ED.KEY = MENUVERT.KEY : GOSUB ED.MENU.LETTER
  GOTO ED.MENU.OPEN

REM A letter while the bar is open jumps to that menu, folded to upper so f and F both
REM reach File. NO REDRAW HERE -- ED.MENU.OPEN does it on the way round -- so this only
REM erases the panel about to move, and a letter matching nothing leaves everything alone.
ED.MENU.LETTER:
  ED.ML.CH = ED.KEY
  IF ED.ML.CH >= 97 AND ED.ML.CH <= 122 THEN ED.ML.CH = ED.ML.CH - 32
  ED.ML.HIT = 0 - 1
  FOR MENU.I = 0 TO MENU.COUNT - 1
    IF ASC(LEFT$(MENU.NAME$(MENU.I), 1)) = ED.ML.CH THEN ED.ML.HIT = MENU.I
  NEXT MENU.I
  REM Nothing to do is the common case -- every key that is not an arrow or RETURN lands
  REM here -- so it must not repaint.
  IF ED.ML.HIT < 0 THEN RETURN
  IF ED.ML.HIT = MENU.ACTIVE THEN RETURN
  GOSUB ED.ERASE.DROPDOWN : ED.MENU.WAS = MENU.ACTIVE
  MENU.ACTIVE = ED.ML.HIT : MENU.SEL = 0
  GOSUB ED.MENU.BAR.MOVE
  RETURN

ED.MENU.SELECT:
  MENU.CHOICE.MENU = MENU.ACTIVE : MENU.CHOICE.ITEM = MENU.SEL
  MENU.ACTIVE = 0 - 1 : GOSUB ED.MENU.CLOSE : GOSUB ED.MENU.DISPATCH
  RETURN

ED.MENU.CANCEL:
  MENU.ACTIVE = 0 - 1 : GOSUB ED.MENU.CLOSE
  RETURN

REM Putting the document back is taking the panel away: it never covered anything the
REM hardware cares about. Two rows of chrome instead of a 28-row repaint.
ED.MENU.CLOSE:
  GOSUB ED.ERASE.DROPDOWN : GOSUB ED.RENDER.MENUBAR : GOSUB ED.PLACE.CARET
  RETURN

REM Only the two keys that cross the panel's axis are here; moving the highlight INSIDE it
REM is MENUVERT.RUN's job.
REM
REM ERASE BEFORE MOVING. ED.ERASE.DROPDOWN works from the ED.DD.* geometry the last
REM ED.DRAW.DROPDOWN left behind -- the panel actually on screen -- so it has to run while
REM MENU.ACTIVE still names that panel.
ED.MENU.LEFT:
  GOSUB ED.ERASE.DROPDOWN
  ED.MENU.WAS = MENU.ACTIVE : MENU.ACTIVE = MENU.ACTIVE - 1
  IF MENU.ACTIVE < 0 THEN MENU.ACTIVE = MENU.COUNT - 1
  MENU.SEL = 0 : GOSUB ED.MENU.BAR.MOVE
  RETURN

ED.MENU.RIGHT:
  GOSUB ED.ERASE.DROPDOWN
  ED.MENU.WAS = MENU.ACTIVE : MENU.ACTIVE = MENU.ACTIVE + 1
  IF MENU.ACTIVE >= MENU.COUNT THEN MENU.ACTIVE = 0
  MENU.SEL = 0
  GOSUB ED.MENU.BAR.MOVE
  RETURN

REM ---- the two titles that changed, and nothing else ----
REM ED.MENU.BAR.ITEMS first, because ED.DRAW.DROPDOWN has since pointed MENUVERT.X, .Y,
REM .WIDTH, .ATTR and .HIATTR at the PANEL -- and MENUBAR.ITEM and MENUBAR.MARK both reach
REM MENUVERT.ROW through those.
ED.MENU.BAR.MOVE:
  GOSUB ED.MENU.BAR.ITEMS
  MENUBAR.DRAWN = ED.MENU.WAS + 1 : MENUBAR.PAINT = MENUVERT.ATTR : GOSUB MENUBAR.ITEM
  MENUBAR.SEL = MENU.ACTIVE + 1 : GOSUB MENUBAR.MARK
  RETURN

REM ---- take the panel away, which is all "putting the document back" means now ----
REM The document is on layer 0 and was never covered, so this clears the panel's OWN
REM rectangle on the overlay -- rows 1..ED.DD.FH at the columns it occupied -- back to
REM transparent. Erasing by repainting document rows stopped working the moment they moved
REM to layer 0: the panel is on the other layer, and three of them piled up on screen.
ED.ERASE.DROPDOWN:
  ED.DDE.LAST = ED.DD.FH
  IF ED.DDE.LAST > ED.TEXT.BOTTOM THEN ED.DDE.LAST = ED.TEXT.BOTTOM
  IF ED.DDE.LAST < 1 THEN RETURN
  GP.FILL ED.DD.BX, 1, ED.DD.FW, ED.DDE.LAST, 32, 0
  RETURN

ED.MENU.DISPATCH:
  ON MENU.CHOICE.MENU + 1 GOSUB ED.DISP.FILE, ED.DISP.SEARCH, ED.CMD.ABOUT
  RETURN

ED.DISP.FILE:
  ON MENU.CHOICE.ITEM + 1 GOSUB ED.CMD.NEW, ED.CMD.OPEN, ED.CMD.SAVE, ED.CMD.SAVEAS, ED.CMD.EXIT
  RETURN

ED.DISP.SEARCH:
  ON MENU.CHOICE.ITEM + 1 GOSUB ED.CMD.FIND, ED.CMD.GOTO
  RETURN



REM ============================================================================
REM COMMANDS
REM ============================================================================
ED.CMD.NEW:
  GOSUB ED.CONFIRM.DISCARD
  IF ED.DISCARD.OK = 0 THEN GOSUB ED.REFRESH.FULL : RETURN
  GOSUB DOC.INIT
  LINE.TEXT$ = "" : LINE.INDEX = 0 : GOSUB DOC.STORE : LINE.COUNT = 1
  DOC.FILE.NAME$ = "UNTITLED" : ED.MB.FORCE = 1
  GOSUB ED.OPEN.DONE : GOSUB ED.REFRESH.FULL
  RETURN

ED.OPEN.FILE:
  ED.MB.FORCE = 1 : REM the bar carries the name, which the numeric guard cannot see
  GOSUB DOC.LOADFILE
  IF LINE.COUNT = 0 THEN LINE.TEXT$ = "" : LINE.INDEX = 0 : GOSUB DOC.STORE : LINE.COUNT = 1
  GOSUB ED.OPEN.DONE : GOSUB ED.REFRESH.FULL
  RETURN

ED.CMD.OPEN:
  GOSUB ED.CONFIRM.DISCARD
  IF ED.DISCARD.OK = 0 THEN GOSUB ED.REFRESH.FULL : RETURN
  ED.PROMPT.MSG$ = "Open file: " : GOSUB ED.PROMPT
  IF ED.PROMPT.OK = 0 THEN GOSUB ED.REFRESH.FULL : RETURN
  DOC.FILE.NAME$ = ED.INPUT$
  GOSUB ED.OPEN.FILE
  RETURN

ED.SAVE.FILE:
  GOSUB ED.COMMIT.LIVE : GOSUB DOC.SAVEFILE : ED.DOC.DIRTY = 0
  RETURN

ED.CMD.SAVE:
  IF DOC.FILE.NAME$ = "UNTITLED" THEN GOSUB ED.CMD.SAVEAS : RETURN
  GOSUB ED.SAVE.FILE : GOSUB ED.REFRESH.FULL
  ED.MSG$ = "Saved " + DOC.FILE.NAME$ : GOSUB ED.INFO.MSG
  RETURN

ED.CMD.SAVEAS:
  ED.PROMPT.MSG$ = "Save as: " : GOSUB ED.PROMPT
  IF ED.PROMPT.OK = 0 THEN GOSUB ED.REFRESH.FULL : RETURN
  DOC.FILE.NAME$ = ED.INPUT$ : ED.MB.FORCE = 1
  GOSUB ED.SAVE.FILE : GOSUB ED.REFRESH.FULL
  ED.MSG$ = "Saved " + DOC.FILE.NAME$ : GOSUB ED.INFO.MSG
  RETURN

ED.CMD.EXIT:
  IF ED.DOC.DIRTY = 0 THEN GOTO ED.CMD.EXIT.GO
  ED.PROMPT.MSG$ = "Discard changes?" : GOSUB ED.PROMPT.YN
  IF ED.YN = 0 THEN GOSUB ED.REFRESH.FULL : RETURN
ED.CMD.EXIT.GO:
  IF ED.SIM.MODE = 1 THEN ED.EXIT.FLAG = 1 : RETURN
  GOTO ED.QUIT
ED.CMD.ABOUT:
  ED.MSG$ = "GPC EDIT -- a simple X16 text editor" : GOSUB ED.INFO.MSG
  RETURN

ED.CONFIRM.DISCARD:
  ED.DISCARD.OK = 1
  IF ED.DOC.DIRTY = 0 THEN RETURN
  ED.PROMPT.MSG$ = "Discard changes?" : GOSUB ED.PROMPT.YN
  ED.DISCARD.OK = ED.YN
  RETURN

ED.CMD.FIND:
  ED.PROMPT.MSG$ = "Find: " : GOSUB ED.PROMPT
  IF ED.PROMPT.OK = 0 THEN GOSUB ED.REFRESH.FULL : RETURN
  ED.FIND$ = ED.INPUT$ : GOSUB ED.FIND.NEXT
  RETURN

ED.CMD.GOTO:
  ED.PROMPT.MSG$ = "Go to line: " : GOSUB ED.PROMPT
  IF ED.PROMPT.OK = 0 THEN GOSUB ED.REFRESH.FULL : RETURN
  ED.GOTO.N = VAL(ED.INPUT$)
  IF ED.GOTO.N < 1 THEN ED.GOTO.N = 1
  IF ED.GOTO.N > LINE.COUNT THEN ED.GOTO.N = LINE.COUNT
  GOSUB ED.COMMIT.LIVE
  ED.CUR.ROW = ED.GOTO.N - 1 : ED.CUR.COL = 0
  GOSUB ED.LOAD.LIVE : GOSUB ED.REFRESH.FULL
  ED.MSG$ = "Line " + MID$(STR$(ED.GOTO.N), 2) : GOSUB ED.INFO.MSG
  RETURN

REM ---- forward, wrapping, case-insensitive substring search for ED.FIND$ ----
REM A CASE-BLIND SEARCH THAT ALLOCATES NOTHING. This used to fold the needle and every
REM line into NEW strings -- ED.FOLD.IN$, ED.FOLD.OUT$, ED.HAY$ -- and then walk the line
REM with MID$ per position, which allocates on every comparison. Three ~250 byte blocks
REM stayed owned for the rest of the run: a single search cost 579 bytes of the workspace,
REM measured, and that is what the dialogs later ran out of.
REM
REM Now the fold happens IN PLACE through GP.STRPTR and the search is GP.INSTR, which takes
REM a 1-based start of its own. LINE.TEXT$ is the scratch copy DOC.LOAD already makes and
REM upper-casing it harms nothing -- the document itself lives in the bank, untouched.
ED.FIND.NEXT:
  IF LEN(ED.FIND$) = 0 THEN RETURN
  REM The needle is folded on a COPY: ED.FIND$ is what both messages below print back.
  ED.NEEDLE$ = ED.FIND$
  ED.UP.PTR% = GP.STRPTR(ED.NEEDLE$) : ED.UP.LEN% = LEN(ED.NEEDLE$) : GOSUB ED.UPPER
  GOSUB ED.COMMIT.LIVE
  ED.FR = ED.CUR.ROW : ED.FROM = ED.CUR.COL + 2 : ED.SCANNED = 0
ED.FN.LOOP:
  IF ED.SCANNED > LINE.COUNT THEN GOTO ED.FN.NONE
  LINE.INDEX = ED.FR : GOSUB DOC.LOAD
  ED.UP.PTR% = GP.STRPTR(LINE.TEXT$) : ED.UP.LEN% = LEN(LINE.TEXT$) : GOSUB ED.UPPER
  ED.FOUND.AT = GP.INSTR(LINE.TEXT$, ED.NEEDLE$, ED.FROM)
  IF ED.FOUND.AT > 0 THEN GOTO ED.FN.HIT
  ED.FR = ED.FR + 1
  IF ED.FR > LINE.COUNT - 1 THEN ED.FR = 0
  ED.FROM = 1 : ED.SCANNED = ED.SCANNED + 1
  GOTO ED.FN.LOOP
ED.FN.HIT:
  ED.CUR.ROW = ED.FR : ED.CUR.COL = ED.FOUND.AT - 1
  GOSUB ED.LOAD.LIVE : GOSUB ED.REFRESH.FULL
  ED.MSG$ = "Found: " + ED.FIND$ : GOSUB ED.INFO.MSG
  RETURN

ED.FN.NONE:
  ED.MSG$ = "Not found: " + ED.FIND$ : GOSUB ED.ERR.MSG
  RETURN

REM Upper-case ED.UP.LEN% characters at ED.UP.PTR%, IN PLACE. ASCII lower case is $61-$7A,
REM and ASCII is what the document and the literals are -- PETSCII lives only on disk.
REM Y counts DOWN from the length, so offset 0 (the length byte) is never touched. A zero
REM length must not reach the loop at all: DEY would wrap and rewrite 255 bytes of heap.
ED.UPPER:
  IF ED.UP.LEN% = 0 THEN RETURN
  #REM 1
  GP.ASM
  REM LDA {ED.UP.PTR%}
  REM LDX #1
  REM STA UPS,X
  REM STA UPD,X
  REM LDA {ED.UP.PTR%},X
  REM LDX #2
  REM STA UPS,X
  REM STA UPD,X
  REM LDY {ED.UP.LEN%}
  REM UPS: LDA $FFFF,Y
  REM CMP #$61
  REM BCC UPN
  REM CMP #$7B
  REM BCS UPN
  REM SEC
  REM SBC #$20
  REM UPD: STA $FFFF,Y
  REM UPN: DEY
  REM BNE UPS
  GP.ENDASM
  #REM 0
  RETURN



REM ============================================================================
REM PROMPTS (cyan line input; sim hook for the headless self-check)
REM ============================================================================
REM Both were hand-rolled on the bottom row once and are now GUI.INC.BL, which brought a
REM caret that moves, a field that cannot be typed past, and a box that puts back the cells
REM it covered. The interface did not change -- ED.PROMPT.MSG$ in, ED.INPUT$ + ED.PROMPT.OK
REM or ED.YN out -- so all six call sites and the ED.SIM.MODE short circuit are untouched.

ED.PROMPT:
  IF ED.SIM.MODE = 1 THEN ED.INPUT$ = ED.SIM.INPUT$ : ED.PROMPT.OK = 1 : RETURN
  GUI.TITLE$ = "" : GUI.MSG2$ = "" : GUI.MASK = 0
  GUI.MSG$ = ED.PROMPT.MSG$
  REM Wide enough for a path, and the box sizes itself around it. The old bottom-row field
  REM ran to 60 because it had the whole screen; a centred dialog does not.
  GUI.LEN = 40 : GUI.INPUT$ = "" : GOSUB GUI.TEXT
  ED.INPUT$ = GUI.INPUT$ : ED.PROMPT.OK = GUI.OK
  REM A cancel hands back "", as it always did. GUI.TEXT restores what was passed in, which
  REM here is "" anyway, so this is belt and braces at the cost of one store.
  IF ED.PROMPT.OK = 0 THEN ED.INPUT$ = ""
  RETURN

ED.PROMPT.YN:
  IF ED.SIM.MODE = 1 THEN ED.YN = ED.SIM.YN : RETURN
  GUI.TITLE$ = "" : GUI.MSG2$ = "" : GUI.OKCANCEL = 0 : GUI.HINT$ = ""
  GUI.MSG$ = ED.PROMPT.MSG$
  GOSUB GUI.YN
  ED.YN = GUI.ANSWER
  RETURN




REM ============================================================================
REM MESSAGES
REM ============================================================================
ED.INFO.MSG:
  ED.LAST.MSG$ = ED.MSG$ : IF ED.QUIET = 1 THEN RETURN
  ED.PS.ROW = SCREEN.ROWS - 1 : ED.PS.COL = 0 : ED.PS.WIDTH = SCREEN.COLS
  ED.PS$ = " " + ED.MSG$ : ED.PS.ATTR = THEME.CLR(THEME.TITLE) : GOSUB ED.PUT.FIELD
  RETURN

ED.ERR.MSG:
  ED.LAST.MSG$ = ED.MSG$ : IF ED.QUIET = 1 THEN RETURN
  ED.PS.ROW = SCREEN.ROWS - 1 : ED.PS.COL = 0 : ED.PS.WIDTH = SCREEN.COLS
  ED.PS$ = " " + ED.MSG$ : ED.PS.ATTR = THEME.CLR(THEME.WARN) : GOSUB ED.PUT.FIELD
  RETURN


REM ============================================================================
REM RENDERING
REM ============================================================================
ED.REFRESH.FULL:
  IF ED.QUIET = 1 THEN RETURN
  GOSUB ED.ENSURE.VISIBLE : GOSUB ED.RENDER.ALL
  RETURN
ED.REFRESH.INTRA:
  IF ED.QUIET = 1 THEN RETURN
  GOSUB ED.ENSURE.VISIBLE
  IF ED.SCROLLED = 1 THEN GOSUB ED.DO.SCROLL : RETURN
  ED.SCREEN.ROW = ED.CUR.ROW - ED.TOP.LINE + 1 : ED.DOC.LINE = ED.CUR.ROW
  GOSUB ED.RENDER.ROW: GOSUB ED.PLACE.CARET : GOSUB ED.RENDER.STATUS
  RETURN

REM Cheap cursor move: restore the old caret cell, invert the new one, repaint the status
REM line -- about 2 cells, not a screen. Only an actual scroll falls back to a full repaint.
ED.CARET.REFRESH:
  IF ED.QUIET = 1 THEN RETURN
  GOSUB ED.UNCARET : GOSUB ED.ENSURE.VISIBLE
  IF ED.SCROLLED = 1 THEN GOSUB ED.DO.SCROLL : RETURN
  GOSUB ED.PLACE.CARET : GOSUB ED.RENDER.STATUS
  RETURN

ED.ENSURE.VISIBLE:
  ED.SCROLLED = 0 : ED.HSCROLLED = 0 : ED.EV.OLDTOP = ED.TOP.LINE
  IF ED.CUR.ROW < ED.TOP.LINE THEN ED.TOP.LINE = ED.CUR.ROW
  IF ED.CUR.ROW > ED.TOP.LINE + ED.TEXT.ROWS - 1 THEN ED.TOP.LINE = ED.CUR.ROW - ED.TEXT.ROWS + 1
  IF ED.CUR.COL < ED.LEFT.COL THEN ED.LEFT.COL = ED.CUR.COL : ED.HSCROLLED = 1
  IF ED.CUR.COL > ED.LEFT.COL + ED.TEXT.WIDTH - 1 THEN ED.LEFT.COL = ED.CUR.COL - ED.TEXT.WIDTH + 1 : ED.HSCROLLED = 1
  ED.VDELTA = ED.TOP.LINE - ED.EV.OLDTOP
  IF ED.VDELTA <> 0 THEN ED.SCROLLED = 1
  IF ED.HSCROLLED = 1 THEN ED.SCROLLED = 1
  RETURN

REM A one-row move is served by VERA: bump L0_VSCROLL and paint the ONE newly-exposed row.
REM The bars are on layer 1 and did not move. Anything else -- a multi-line jump, any
REM horizontal scroll -- is a full repaint at the current map offset.
ED.DO.SCROLL:
  IF ED.HW.OK = 0 THEN GOSUB ED.RENDER.ALL : RETURN
  IF ED.HSCROLLED = 1 THEN GOSUB ED.RENDER.ALL : RETURN
  IF ED.VDELTA = 1 THEN GOSUB ED.HW.SCROLL.DOWN : RETURN
  IF ED.VDELTA = 0 - 1 THEN GOSUB ED.HW.SCROLL.UP : RETURN
  GOSUB ED.RENDER.ALL
  RETURN

REM scroll down one line: content slides up, a new line appears at the bottom text row.
ED.HW.SCROLL.DOWN:
  ED.MAP.TOP = ED.MAP.TOP + 1
  IF ED.MAP.TOP > ED.MAP.MAXTOP THEN ED.MAP.TOP = 0 : GOSUB ED.SET.VSCROLL : GOSUB ED.RENDER.ALL : RETURN
  GOSUB ED.SET.VSCROLL
  ED.SCREEN.ROW = ED.TEXT.BOTTOM : ED.DOC.LINE = ED.TOP.LINE + ED.SCREEN.ROW - 1 : GOSUB ED.RENDER.ROW
  GOSUB ED.RENDER.STATUS : GOSUB ED.PLACE.CARET
  RETURN

REM scroll up one line: content slides down, a new line appears at the top text row (1).
ED.HW.SCROLL.UP:
  ED.MAP.TOP = ED.MAP.TOP - 1
  IF ED.MAP.TOP < 0 THEN ED.MAP.TOP = ED.MAP.MAXTOP : GOSUB ED.SET.VSCROLL : GOSUB ED.RENDER.ALL : RETURN
  GOSUB ED.SET.VSCROLL
  ED.SCREEN.ROW = 1 : ED.DOC.LINE = ED.TOP.LINE + ED.SCREEN.ROW - 1 : GOSUB ED.RENDER.ROW
  GOSUB ED.RENDER.STATUS : GOSUB ED.PLACE.CARET
  RETURN

ED.SET.VSCROLL:
  ED.VSP = ED.MAP.TOP * 8
  POKE 40754, ED.VSP - INT(ED.VSP / 256) * 256 : REM $9F32 L0 VSCROLL (7:0)
  POKE 40755, INT(ED.VSP / 256)                : REM $9F33 L0 VSCROLL (11:8)
  RETURN

ED.RENDER.ALL:
  GOSUB ED.RENDER.MENUBAR
  FOR ED.SCREEN.ROW = 1 TO ED.TEXT.BOTTOM
    ED.DOC.LINE = ED.TOP.LINE + ED.SCREEN.ROW - 1
    GOSUB ED.RENDER.ROW
  NEXT ED.SCREEN.ROW
  GOSUB ED.RENDER.STATUS : GOSUB ED.PLACE.CARET
  RETURN

REM Rows render through ONE inline-assembly block: VERA setup, the cell loop, teardown.
REM
REM WHY ASSEMBLY. The VERA path was already the fast one; the loop around it was the cost --
REM two POKEs a cell, each a push / dispatch / bank-save-restore through the p-code VM, about
REM 800 cycles a cell against the ~20 the same compare-load-store takes native.
REM
REM THE VERA METHOD IS UNCHANGED. FX 32-bit cache write: one DATA0 write flushes 4 VRAM
REM bytes = 2 cells [char,attr,char,attr]. Every cell in a row shares an attribute, so the
REM two attr slots are loaded ONCE and the loop writes only the two char slots plus a flush.
REM Increment +4 walks two cells a flush, and ED.TEXT.WIDTH is even.
REM
REM FX regs: $9F25 CTRL bits 6:1 = DCSEL; DCSEL 2 -> FX_CTRL $9F29 bit 6 cache-write-enable;
REM DCSEL 6 -> FX_CACHE L/M/H/U $9F29-2C = [char0, attr0, char1, attr1].
REM
REM THE SOURCE IS ONE OF THREE THINGS, and ED.ASM.MODE% tells the block which:
REM   a stored line    MODE 0, ED.ASM.SRC% is its address in the $A000 window (BANK is set)
REM   the edited line  MODE 1, read out of ED.CUR.LINE$ itself, past its 3-byte header
REM   past the end     MODE 0 with ED.ASM.VIS% = 0 -- every cell is a space, and the source
REM                    address is never dereferenced, so what it holds does not matter
ED.RENDER.ROW:
  ED.ASM.BASE% = (ED.SCREEN.ROW + ED.MAP.TOP) * 256 : REM layer 0's map, VRAM $00000
  ED.ASM.ATTR% = ED.ATTR.TEXT : ED.ASM.WIDTH% = ED.TEXT.WIDTH : ED.ASM.MODE% = 0 : ED.ASM.VIS% = 0
  IF ED.DOC.LINE >= LINE.COUNT THEN GOTO ED.ROW.STREAM
  IF ED.DOC.LINE = ED.CUR.ROW THEN GOTO ED.ROW.LIVE
  LINE.INDEX = ED.DOC.LINE : GOSUB DOC.SLOT.READ
  BANK DOC.GOT.BANK
  ED.VIS = PEEK(DOC.GOT.OFF) - ED.LEFT.COL : REM visible chars after horizontal scroll
  IF ED.VIS > 0 THEN ED.ASM.VIS% = ED.VIS
  ED.ASM.SRC% = DOC.GOT.OFF + 1 + ED.LEFT.COL
  GOTO ED.ROW.STREAM
ED.ROW.LIVE:
  ED.ASM.MODE% = 1 : ED.VIS = LEN(ED.CUR.LINE$) - ED.LEFT.COL
  IF ED.VIS > 0 THEN ED.ASM.VIS% = ED.VIS
  ED.ASM.OFS% = 3 + ED.LEFT.COL : REM past [MaxLen][control][ActLen] to the text
ED.ROW.STREAM:
  #REM 1
  GP.ASM
  REM ; ---- VERA: address, +4 increment, FX cache write on, both attribute slots ----
  REM LDA {ED.ASM.BASE%}
  REM STA $9F20
  REM LDX #1
  REM LDA {ED.ASM.BASE%},X
  REM STA $9F21
  REM LDA #48                  ; bank 0 (layer 0's map), increment +4 = two cells a flush
  REM STA $9F22
  REM LDA #4                   ; DCSEL 2
  REM STA $9F25
  REM LDA #64                  ; FX_CTRL: cache write enable
  REM STA $9F29
  REM LDA #12                  ; DCSEL 6 -- the cache itself
  REM STA $9F25
  REM LDA {ED.ASM.ATTR%}
  REM STA $9F2A                ; attr0
  REM STA $9F2C                ; attr1
  REM ; ---- aim the two fetches at the source, whichever kind of source it is ----
  REM ; There is no expression syntax, so the address goes INTO the operand of the LDA
  REM ; that reads it: STA RGA,X with X=1 patches the low byte, X=2 the high one.
  REM LDA {ED.ASM.MODE%}
  REM BNE RSTR
  REM LDA {ED.ASM.SRC%}        ; the banked store: already a plain address
  REM LDX #1
  REM STA RGA,X
  REM STA RGB,X
  REM LDA {ED.ASM.SRC%},X
  REM BRA RHI
  REM RSTR: CLC                ; ED.CUR.LINE$: the slot holds the block address...
  REM LDA {ED.CUR.LINE$}
  REM ADC {ED.ASM.OFS%}        ; ...and the text starts 3 bytes into the block
  REM LDX #1
  REM STA RGA,X
  REM STA RGB,X
  REM LDA {ED.CUR.LINE$},X
  REM ADC #0
  REM RHI: LDX #2
  REM STA RGA,X
  REM STA RGB,X
  REM ; ---- two cells a pass: char0, char1, one flush ----
  REM LDY #0
  REM RLP: CPY {ED.ASM.VIS%}
  REM BCS RSP1
  REM RGA: LDA $FFFF,Y         ; operand patched above
  REM BRA RPUT1
  REM RSP1: LDA #32
  REM RPUT1: STA $9F29
  REM INY
  REM CPY {ED.ASM.VIS%}
  REM BCS RSP2
  REM RGB: LDA $FFFF,Y         ; operand patched above
  REM BRA RPUT2
  REM RSP2: LDA #32
  REM RPUT2: STA $9F2B
  REM STZ $9F23                ; flush the cache: two cells written
  REM INY
  REM CPY {ED.ASM.WIDTH%}
  REM BCC RLP
  REM ; ---- FX off and DCSEL back to 0, so ordinary VERA writes work again ----
  REM LDA #4
  REM STA $9F25
  REM STZ $9F29
  REM STZ $9F25
  GP.ENDASM
  #REM 0
  RETURN

REM Caret = one inverted attribute cell, remembered so a cursor move can restore it
REM (ED.UNCARET) instead of repainting the screen.
ED.PLACE.CARET:
  ED.CARET.SROW = ED.CUR.ROW - ED.TOP.LINE + 1
  ED.CARET.SCOL = ED.CUR.COL - ED.LEFT.COL
  ED.CARET.VALID = 0
  IF ED.CARET.SROW < 1 OR ED.CARET.SROW > ED.TEXT.BOTTOM THEN RETURN
  IF ED.CARET.SCOL < 0 OR ED.CARET.SCOL >= ED.TEXT.WIDTH THEN RETURN
  ED.CARET.ADDR = (ED.CARET.SROW + ED.MAP.TOP) * 256 + ED.CARET.SCOL * 2 + 1
  VPOKE 0, ED.CARET.ADDR, ED.ATTR.CARET : ED.CARET.VALID = 1
  RETURN

ED.UNCARET:
  IF ED.CARET.VALID = 0 THEN RETURN
  VPOKE 0, ED.CARET.ADDR, ED.ATTR.TEXT : ED.CARET.VALID = 0
  RETURN


REM ---- menu bar (layer 1, screen row 0). Attr = bg*16+fg. ----
REM MENUBAR.INC.BL draws the titles; the editor's own two things are the full width band
REM and the document name at the right.
REM
REM DRAWN ONLY WHEN IT WOULD COME OUT DIFFERENT -- the body blanks the whole row and draws
REM the items back over it, which flickers. The two tests are the star and which title is
REM highlighted; the FILENAME is a string, so it uses a flag rather than a key string,
REM because a string built per keystroke is an allocation per keystroke.
ED.RENDER.MENUBAR:
  IF ED.MB.FORCE = 1 THEN GOTO ED.MB.DRAW
  IF ED.DOC.DIRTY <> ED.MB.D THEN GOTO ED.MB.DRAW
  IF MENU.ACTIVE <> ED.MB.M THEN GOTO ED.MB.DRAW
  RETURN
ED.MB.DRAW:
  ED.MB.FORCE = 0 : ED.MB.D = ED.DOC.DIRTY : ED.MB.M = MENU.ACTIVE
  ED.PS.ROW = 0 : ED.PS.COL = 0 : ED.PS.WIDTH = SCREEN.COLS
  ED.PS$ = "" : ED.PS.ATTR = THEME.CLR(THEME.TITLE) : GOSUB ED.PUT.FIELD
  GOSUB ED.MENU.BAR.ITEMS : GOSUB MENUBAR.DRAW
  IF MENU.ACTIVE >= 0 THEN MENUBAR.SEL = MENU.ACTIVE + 1 : GOSUB MENUBAR.MARK
  ED.NAME$ = DOC.FILE.NAME$ : IF ED.DOC.DIRTY = 1 THEN ED.NAME$ = ED.NAME$ + " *"
  ED.NCOL = SCREEN.COLS - LEN(ED.NAME$) - 1
  IF ED.NCOL > 1 THEN ED.PS.ROW = 0 : ED.PS.COL = ED.NCOL - 1 : ED.PS.WIDTH = LEN(ED.NAME$) : ED.PS$ = ED.NAME$ : ED.PS.ATTR = THEME.CLR(THEME.TITLE) : GOSUB ED.PUT.FIELD
  RETURN


REM The accelerator letter's colour is MENUVERT.ROW's hotkey tint: MENU.HOT$ names the
REM letters and MENUVERT.HOTATTR is the colour, so no title is painted in two pieces here.



REM ---- dropdown (VERA rows 1..) ----
REM MENUVERT.ROW draws one row: GP.FILL for the background, GP.PRINTAT for the text. Both
REM need the ISO flag ED.INIT sets, or GP.PRINTAT converts ASCII as though it were PETSCII
REM and every letter comes out case-swapped.
REM
REM WHERE IT HANGS FROM IS MENUBAR'S ANSWER: MENUBAR.WHERE walks the item text left of
REM MENUBAR.SEL and leaves the column in MENUBAR.SELX. The panel starts one cell IN from
REM the item's left edge, which lines the item text up under the title text -- both are a
REM leading space wide.
REM
REM ED.MENU.BAR.ITEMS first, because MENUBAR.WHERE measures MENUVERT.ITEM$ and this routine
REM is about to fill that same array with the dropdown's items.
ED.DRAW.DROPDOWN:
  ED.DD.N = MENU.ITEMS(MENU.ACTIVE)
  GOSUB ED.MENU.BAR.ITEMS
  MENUBAR.SEL = MENU.ACTIVE + 1 : GOSUB MENUBAR.WHERE
  ED.DD.COL = MENUBAR.SELX + 1  : ED.DD.W = MENU.WIDTH(MENU.ACTIVE)

  ED.DD.BX = ED.DD.COL - 1 : IF ED.DD.BX < 0 THEN ED.DD.BX = 0
  REM EVERY Y HERE IS A MAP ROW, NOT A SCREEN ROW. The GP commands know nothing about the
  REM editor's hardware scroll -- they write at map row = whatever Y they are given -- so
  REM the offset is added here, or the panel lands ED.MAP.TOP rows from the bar it hangs
  REM from: invisible at the top of the document and further adrift the further you scroll.
  ED.DD.FW = ED.DD.W + 2 : ED.DD.FH = ED.DD.N + 2
  ED.DD.TY = 1 : ED.DD.BY = ED.DD.TY + ED.DD.FH - 1
  ED.DD.RX = ED.DD.BX + ED.DD.FW - 1 : ED.DD.FC = THEME.CLR(THEME.TEXT)
  REM GUI.FRAME, so the dropdown and the dialogs share one frame drawer -- and it is the
  REM only one that can draw a box here, since GP.BOX's built-in styles are built from
  REM screen codes this font no longer has. Setting GUI.BORDER does not disturb a later
  REM dialog: GUI.OPEN settles it from GUI.BORDER.IN on every call.
  GUI.LEFT = ED.DD.BX : GUI.TOP = ED.DD.TY 
  GUI.WIDTH = ED.DD.FW  : GUI.HEIGHT = ED.DD.FH : GUI.BORDER = ED.DD.FC
  GOSUB GUI.FRAME

  REM THE WHOLE INTERFACE, the way MENUDEMO.EXP.BL drives it -- not three fields and a
  REM hand-rolled loop over MENUVERT.ROW. ROW reads MENUVERT.ATTR itself, so a caller that
  REM leaves COUNT, ATTR and HIATTR at zero is guessing at the routine rather than calling
  REM it. Set the documented inputs and let MENUVERT.DRAW walk the rows.
  MENUVERT.X = ED.DD.COL
  MENUVERT.Y = 2 : REM layer 1, a screen row
  MENUVERT.WIDTH = ED.DD.W : MENUVERT.COUNT = ED.DD.N
  REM The DOCUMENT's own attribute, not a page colour of its own, so the panel reads as a
  REM framed hole in the document rather than a card laid on it. Only the selected row
  REM breaks it, which is the point of a highlight bar.
  MENUVERT.ATTR    = THEME.CLR(THEME.TEXT) : MENUVERT.HIATTR  = THEME.CLR(THEME.TITLE)
  REM THE ACCELERATOR LETTERS BELONG TO THE OPEN MENU'S ITEMS, and they must be set BEFORE
  REM the rows are drawn -- MENUVERT.ROW tints from MENUVERT.HOT$ as it prints each row, so
  REM setting them at the call to RUN is one draw too late and tints nothing.
  MENUVERT.HOT$ = MENU.ITEMHOT$(MENU.ACTIVE)
  REM BORDER's FOREGROUND over the ROW's OWN BACKGROUND. Taking the whole attribute would
  REM paint one cell of the bar's blue into a black row -- a gap in the row, not a hotkey.
  MENUVERT.HOTATTR = THEME.CLR(THEME.TEXT) - MOD(THEME.CLR(THEME.TEXT), 16) + MOD(THEME.CLR(THEME.BORDER), 16)
  REM MENUVERT.ITEM$ is 1 based, MENU.SEL 0 based off the flat MENU.ITEM$ table. Converted
  REM once here rather than at each use.
  FOR ED.DD.I = 1 TO ED.DD.N
    MENUVERT.ITEM$(ED.DD.I) = " " + MENU.ITEM$(MENU.ACTIVE * 8 + ED.DD.I - 1)
  NEXT ED.DD.I
  GOSUB MENUVERT.DRAW : MENUVERT.DRAWROW = MENU.SEL + 1 : MENUVERT.DRAWATTR = MENUVERT.HIATTR
  GOSUB MENUVERT.ROW
  RETURN

ED.RENDER.STATUS:
  ED.MARK$ = "   " : IF ED.DOC.DIRTY   = 1 THEN ED.MARK$ = " * "
  ED.MODE$ = "INS" : IF ED.INSERT.MODE = 0 THEN ED.MODE$ = "OVR"
  ED.BAR$ = ED.MARK$ + "L" + MID$(STR$(ED.CUR.ROW + 1), 2) + " C" + MID$(STR$(ED.CUR.COL + 1), 2) + "  " + ED.MODE$ + "  LINES=" + MID$(STR$(LINE.COUNT), 2) + "   ESC=MENU (F/S/H)  F2=SAVE  F3=FIND"
  ED.PS.ROW = SCREEN.ROWS - 1 : ED.PS.COL = 0 : ED.PS.WIDTH = SCREEN.COLS
  ED.PS$ = ED.BAR$ : ED.PS.ATTR = THEME.CLR(THEME.TITLE) : GOSUB ED.PUT.FIELD
  RETURN

REM ---- write ED.PS$ into the VERA text map at 0-based (ED.PS.ROW, ED.PS.COL), attribute
REM ED.PS.ATTR, padded with spaces to ED.PS.WIDTH and truncated past it ----
REM
REM VERA AUTO-INCREMENT: the address and a +1 step are programmed ONCE, then
REM char,attr,char,attr streams to DATA0. Char and attr are adjacent and cells follow each
REM other, so +1 walks the whole field with no per-cell address arithmetic.
REM
REM Assembly for ED.RENDER.ROW's reason: this draws all the chrome, on every keystroke.
REM The width guard matters because the block's test is at the BOTTOM -- without it a
REM width of 0 would write one cell, where the FOR loop it replaced wrote none.
ED.PUT.FIELD:
  IF ED.PS.WIDTH < 1 THEN RETURN
  ED.ASM.BASE% = 45056 + ED.PS.ROW * 256 + ED.PS.COL * 2 : REM layer 1, a SCREEN row
  ED.ASM.ATTR% = ED.PS.ATTR : ED.ASM.WIDTH% = ED.PS.WIDTH : ED.ASM.VIS% = LEN(ED.PS$)
  #REM 1
  GP.ASM
  REM ; ---- VERA: address, +1 increment, ordinary (non-FX) writes ----
  REM LDA {ED.ASM.BASE%}
  REM STA $9F20
  REM LDX #1
  REM LDA {ED.ASM.BASE%},X
  REM STA $9F21
  REM LDA #17                  ; bank 1, address increment +1
  REM STA $9F22
  REM ; ---- aim the fetch at ED.PS$'s text, 3 bytes into its block ----
  REM CLC
  REM LDA {ED.PS$}
  REM ADC #3
  REM LDX #1
  REM STA FGA,X
  REM LDA {ED.PS$},X
  REM ADC #0
  REM LDX #2
  REM STA FGA,X
  REM ; ---- one cell a pass: char then attribute, both to DATA0 ----
  REM LDY #0
  REM FLP: CPY {ED.ASM.VIS%}
  REM BCS FSP
  REM FGA: LDA $FFFF,Y         ; operand patched above
  REM BRA FPUT
  REM FSP: LDA #32
  REM FPUT: STA $9F23          ; char -- VERA steps to the attribute byte
  REM LDA {ED.ASM.ATTR%}
  REM STA $9F23                ; attr -- VERA steps to the next cell
  REM INY
  REM CPY {ED.ASM.WIDTH%}
  REM BCC FLP
  GP.ENDASM
  #REM 0
  RETURN


REM ============================================================================
REM ============================================================================
REM ============================================================================
REM ============================================================================
REM ============================================================================
REM ============================================================================
REM ============================================================================






REM ============================================================================
REM HEADLESS SELF-CHECK (DEBUG.MODE=1): drive menu dispatch + commands.
REM ============================================================================
ED.SELFCHECK:
  ED.QUIET = 1
  ED.SIM.MODE = 1
  DOC.FILE.NAME$ = "TEST.MD" : GOSUB ED.OPEN.FILE

  REM go to line 3 (row 2)
  ED.SIM.INPUT$ = "3" : GOSUB ED.CMD.GOTO
  PRINT "GOTO ROW=";ED.CUR.ROW;" COL=";ED.CUR.COL

  REM find "bullet" (row 2), then find-next (row 3)
  ED.SIM.INPUT$ = "bullet" : GOSUB ED.CMD.FIND
  PRINT "FIND1 ROW=";ED.CUR.ROW;" COL=";ED.CUR.COL;" MSG=";ED.LAST.MSG$
  GOSUB ED.FIND.NEXT
  PRINT "FIND2 ROW=";ED.CUR.ROW;" COL=";ED.CUR.COL

  REM find "markdown" -- must wrap around to row 0, case-insensitive
  ED.SIM.INPUT$ = "markdown" : GOSUB ED.CMD.FIND
  PRINT "FINDM ROW=";ED.CUR.ROW;" COL=";ED.CUR.COL

  REM a miss
  ED.SIM.INPUT$ = "zzq" : GOSUB ED.CMD.FIND
  PRINT "FINDZ MSG=";ED.LAST.MSG$

  REM discard-confirm: decline blocks New, accept resets
  ED.DOC.DIRTY = 1 : ED.SIM.YN = 0
  GOSUB ED.CMD.NEW
  PRINT "DECLINE COUNT=";LINE.COUNT;" DIRTY=";ED.DOC.DIRTY
  ED.SIM.YN = 1
  GOSUB ED.CMD.NEW
  PRINT "ACCEPT COUNT=";LINE.COUNT;" NAME=";DOC.FILE.NAME$

  REM ---- verify chrome (char+attr) + text render + the O(1) caret ----
  ED.QUIET = 0
  PRINT "DIM ";SCREEN.COLS;"x";SCREEN.ROWS
  REM NO THEME COLOUR MAY USE INDEX 0, in either nibble: the chrome is on a layer with the
  REM document behind it, and 0 is transparent whichever nibble it sits in. A foreground of
  REM 0 let the document show through the letters of the active title.
  ED.Z = 0
  FOR ED.QR = 0 TO THEME.SLOTS - 1
    IF MOD(THEME.CLR(ED.QR), 16) = 0 OR INT(THEME.CLR(ED.QR) / 16) = 0 THEN ED.Z = ED.Z + 1
  NEXT ED.QR
  PRINT "THEMEZERO";ED.Z
  REM ---- what ED.ALTKEYS found. ALT+letter is the one path no headless test can PRESS,
  REM ---- but everything it depends on is readable: which tables exist, which two were
  REM ---- picked, and how many keys got rewritten.
  PRINT "ALTKEYS N=";ED.NALT;" PLAIN=";ED.TPLAIN;" ALT=";ED.TALT
  ED.IDS$ = ""
  BANK 0
  FOR ED.TI = 0 TO 10
    ED.IDS$ = ED.IDS$ + STR$(PEEK(40960 + 128 * ED.TI))
  NEXT ED.TI
  PRINT "TABLE IDS";ED.IDS$
  MENU.ACTIVE = 0 - 1 : GOSUB ED.RENDER.MENUBAR
  PRINT "MB CH=";VPEEK(1, 45058);" AT=";VPEEK(1, 45059)
  MENU.ACTIVE = 0 : MENU.SEL = 0 : GOSUB ED.DRAW.DROPDOWN
  PRINT "DD CH=";VPEEK(1, 45572);" AT=";VPEEK(1, 45573) : REM row 2 now: the frame took row 1
  REM DROPDOWN GEOMETRY, and ONE SAMPLED CELL IS NOT A TEST OF IT: the panel once shipped
  REM with the wrong height and rows missing while the line above stayed green, because the
  REM cell it looks at happened to be right. So walk the whole panel -- frame row, every
  REM item row, frame row -- reading each item's first LETTER at column ED.DD.COL + 1.
  REM File is New Open Save "Save As" Exit, so rows 1..7 must read 192 78 79 83 83 69 192.
  REM A short panel, a skipped row or a misplaced frame moves at least one of those.
  ED.DDS$ = ""
  FOR ED.QR = 1 TO MENU.ITEMS(0) + 2
    ED.DDS$ = ED.DDS$ + STR$(VPEEK(1, 45056 + ED.QR * 256 + (ED.DD.COL + 1) * 2))
  NEXT ED.QR
  PRINT "DDROWS";ED.DDS$
  REM THE ACCELERATOR TINT, WHICH NO CHARACTER READ CAN SEE -- it is an ATTRIBUTE, so DDROWS
  REM above is green whether the letters light up or not. Four cells say all of it. Row 1 is
  REM New AND the highlighted row, which MENUVERT.ROW deliberately leaves alone. Row 2 is
  REM Open, whose O is its first letter. Row 4 is "Save As...", hotkey A: its S must stay
  REM plain and the A of "As" -- column +6, not the a of "Save" at +2 -- must be the lit one.
  ED.DDT$ = ""
  ED.DDT$ = ED.DDT$ + STR$(VPEEK(1, 45056 + 2 * 256 + (ED.DD.COL + 1) * 2 + 1))
  ED.DDT$ = ED.DDT$ + STR$(VPEEK(1, 45056 + 3 * 256 + (ED.DD.COL + 1) * 2 + 1))
  ED.DDT$ = ED.DDT$ + STR$(VPEEK(1, 45056 + 5 * 256 + (ED.DD.COL + 1) * 2 + 1))
  ED.DDT$ = ED.DDT$ + STR$(VPEEK(1, 45056 + 5 * 256 + (ED.DD.COL + 2) * 2 + 1))
  ED.DDT$ = ED.DDT$ + STR$(VPEEK(1, 45056 + 5 * 256 + (ED.DD.COL + 6) * 2 + 1))
  PRINT "DDTINT";ED.DDT$;" HOT=";MENUVERT.HOTATTR;" PLAIN=";MENUVERT.ATTR
  PRINT "DDTINT W= HI HOT PL PL HOT"
  REM WALKING THE BAR MUST TAKE THE OLD PANEL DOWN, and once it did not: erasing repainted
  REM document rows, and those had moved to layer 0, so File, Search and Help stacked up on
  REM screen together. A cell inside File's panel, after stepping right: 32 and 0.
  ED.EX = ED.DD.BX + 1
  GOSUB ED.MENU.RIGHT
  PRINT "DDGONE";VPEEK(1, 45824 + ED.EX * 2);VPEEK(1, 45825 + ED.EX * 2)
  GOSUB ED.CLEAR.OVERLAY
  ED.MSG$ = "HELLO" : GOSUB ED.INFO.MSG
  ED.SR = SCREEN.ROWS - 1
  PRINT "MSG CH=";VPEEK(1, 45056 + ED.SR * 256 + 2);" AT=";VPEEK(1, 45056 + ED.SR * 256 + 3)
  REM REAL repaint path: open a file, drop the caret, sample clean cells. THE DOCUMENT IS
  REM LAYER 0 -- VPEEK bank 0, and the map starts at VRAM 0, so there is no 45056 here.
  REM Every text cell must be char + ED.ATTR.TEXT, on content rows and blank rows alike.
  DOC.FILE.NAME$ = "TEST.MD" : GOSUB ED.OPEN.FILE
  GOSUB ED.UNCARET
  PRINT "TR CH=";VPEEK(0, 256);" AT=";VPEEK(0, 257)
  PRINT "A10 AT=";VPEEK(0, 10 * 256 + 41)
  REM ...and layer 1 over the document must be TRANSPARENT, or none of it would show: 32/0.
  PRINT "A20 AT=";VPEEK(0, 20 * 256 + 61);" OVL=";VPEEK(1, 47696);VPEEK(1, 47697)
  REM caret place/restore (the O(1) cursor-move primitive)
  ED.CUR.ROW = 0 : ED.CUR.COL = 0 : ED.TOP.LINE = 0 : ED.LEFT.COL = 0
  GOSUB ED.PLACE.CARET : PRINT "CARET AT=";VPEEK(0, 257)
  GOSUB ED.UNCARET : PRINT "UNCARET AT=";VPEEK(0, 257)

  REM ---- hardware VSCROLL: register writes + map-offset render + rewind bound ----
  PRINT "MAPH=";ED.MAP.H;" MAXTOP=";ED.MAP.MAXTOP;" HWOK=";ED.HW.OK
  ED.TOP.LINE = 1 : ED.LEFT.COL = 0 : ED.CUR.ROW = 1 : ED.CUR.COL = 0
  ED.MAP.TOP = 0 : GOSUB ED.SET.VSCROLL
  GOSUB ED.HW.SCROLL.DOWN
  REM after +1: L0 VSCROLL = 8, MAP.TOP = 1 -- and THE BAR HAS NOT MOVED. That is the whole
  REM point of the split, so it is asserted at the one address it must always be: layer 1,
  REM screen row 0, where 'F' is 70. L1's own VSCROLL must read 0 forever.
  PRINT "HWD TOP=";ED.MAP.TOP;" VSL=";PEEK(40754);" VSH=";PEEK(40755)
  PRINT "HWD MB=";VPEEK(1, 45058);" L1VS=";PEEK(40761)
  GOSUB ED.HW.SCROLL.UP
  PRINT "HWU TOP=";ED.MAP.TOP;" VSL=";PEEK(40754)
  REM at the bottom bound a +1 scroll rewinds to 0 (never crosses the map edge)
  ED.MAP.TOP = ED.MAP.MAXTOP : GOSUB ED.SET.VSCROLL
  GOSUB ED.HW.SCROLL.DOWN
  PRINT "HWREW TOP=";ED.MAP.TOP;" VSL=";PEEK(40754)
  ED.MAP.TOP = 0 : GOSUB ED.SET.VSCROLL

  REM ---- end-to-end: build a tall doc, walk the cursor down through several
  REM      hardware scrolls, then confirm the visible map window holds the right
  REM      document lines at exactly the map rows VSCROLL is displaying. ----
  ED.QUIET = 0
  GOSUB DOC.INIT
  FOR ED.T = 0 TO 39
    LINE.TEXT$ = "L" + MID$(STR$(ED.T), 2) : GOSUB DOC.PUSH.LINE
  NEXT ED.T
  ED.TOP.LINE = 0 : ED.LEFT.COL = 0 : ED.CUR.ROW = 0 : ED.CUR.COL = 0
  ED.MAP.TOP = 0 : GOSUB ED.SET.VSCROLL
  GOSUB ED.LOAD.LIVE : GOSUB ED.RENDER.ALL
  FOR ED.T = 1 TO 35
    GOSUB ED.MOVE.DOWN
  NEXT ED.T
  PRINT "WALK CUR=";ED.CUR.ROW;" TOP=";ED.TOP.LINE;" MAPTOP=";ED.MAP.TOP;" VSL=";PEEK(40754)
  ED.MR = 1 + ED.MAP.TOP
  PRINT "WTOP DOC=";ED.TOP.LINE;" MAPCH=";VPEEK(0, ED.MR * 256);VPEEK(0, ED.MR * 256 + 2)
  ED.MR = ED.TEXT.BOTTOM + ED.MAP.TOP
  ED.BL = ED.TOP.LINE + ED.TEXT.BOTTOM - 1
  PRINT "WBOT DOC=";ED.BL;" MAPCH=";VPEEK(0, ED.MR * 256);VPEEK(0, ED.MR * 256 + 2)
  ED.MAP.TOP = 0 : GOSUB ED.SET.VSCROLL
  ED.QUIET = 1 : MENU.ACTIVE = 0 - 1

  REM ---- key dispatch: drive the REAL GP.SELECT table with real key codes ----
  REM ED.QUIET is 1, so the model runs and the render does not -- the render is checked
  REM above. 27 and 137 are left out: one blocks on GET, the other writes a file.
  ED.CUR.ROW = 10 : ED.CUR.COL = 0 : ED.TOP.LINE = 0 : ED.LEFT.COL = 0
  GOSUB ED.LOAD.LIVE
  ED.KEY = 17 : GOSUB ED.DISPATCH.KEY
  ED.KEY = 29 : GOSUB ED.DISPATCH.KEY
  PRINT "KEY DOWN+RIGHT ROW=";ED.CUR.ROW;" COL=";ED.CUR.COL
  ED.KEY = 145 : GOSUB ED.DISPATCH.KEY
  ED.KEY = 157 : GOSUB ED.DISPATCH.KEY
  PRINT "KEY UP+LEFT ROW=";ED.CUR.ROW;" COL=";ED.CUR.COL
  ED.KEY = 4 : GOSUB ED.DISPATCH.KEY
  PRINT "KEY END COL=";ED.CUR.COL;" LINE=";ED.CUR.LINE$
  ED.KEY = 19 : GOSUB ED.DISPATCH.KEY
  PRINT "KEY HOME COL=";ED.CUR.COL
  ED.KEY = 148 : GOSUB ED.DISPATCH.KEY
  PRINT "KEY INS MODE=";ED.INSERT.MODE
  ED.KEY = 148 : GOSUB ED.DISPATCH.KEY
  REM 65 is not a case: it reaches ED.DO.INSERT through GP.OTHER and the 32..126 range
  ED.KEY = 65 : GOSUB ED.DISPATCH.KEY
  PRINT "KEY OTHER-RANGE LINE=";ED.CUR.LINE$;" COL=";ED.CUR.COL
  ED.KEY = 20 : GOSUB ED.DISPATCH.KEY
  PRINT "KEY BACKSPACE LINE=";ED.CUR.LINE$;" COL=";ED.CUR.COL
  REM 1 matches no case and falls outside both ranges: GP.OTHER must do nothing
  ED.KEY = 1 : GOSUB ED.DISPATCH.KEY
  PRINT "KEY UNBOUND ROW=";ED.CUR.ROW;" COL=";ED.CUR.COL;" LINE=";ED.CUR.LINE$

  REM 400 selects back to back: GP.ENDSEL releases the selector's frame, so a case that
  REM jumped out instead of falling through would leak one a pass and show up here.
  FOR ED.T = 1 TO 200
    ED.KEY = 17 : GOSUB ED.DISPATCH.KEY
    ED.KEY = 145 : GOSUB ED.DISPATCH.KEY
  NEXT ED.T
  PRINT "KEY 400 SELECTS ROW=";ED.CUR.ROW;" COL=";ED.CUR.COL

  REM ---- the MENU's loop, 600 opens: MENUVERT.RUN's select driven through ED.MENU.OPEN,
  REM ---- which re-enters it once per keystroke handed back rather than once per open.
  REM ---- 600 is chosen against the 4 KB stack -- a leaked GOSUB and GP.DO is 17 bytes and
  REM ---- would blow it after ~240, so a leak CANNOT reach the PRINT below. That is the
  REM ---- point of the count: what leaks is invisible on screen.
  REM ----
  REM ---- Keys go in through kbdbuf_put, because ED.OPEN.MENUBAR waits on GET. 27 cancels;
  REM ---- 13 chooses, and MENU.ACTIVE 2 is Help, whose one item is About -- so the choosing
  REM ---- path runs a real ED.MENU.DISPATCH without going near a file.
  ED.QUIET = 1
  FOR ED.QI = 1 TO 600
    MENU.ACTIVE = 2 : MENU.SEL = 0
    ED.QK = 27
    IF ED.QI - INT(ED.QI / 2) * 2 = 0 THEN ED.QK = 13
    POKE 1, 0 : GP.CALL ED.KBDBUF, ED.QK : POKE 1, 4
    GOSUB ED.OPEN.MENUBAR
  NEXT ED.QI
  PRINT "MENU 600 OPENS MSG=";ED.LAST.MSG$

  REM ---- a LETTER opens its menu, and since ISO mode killed ALT+letter it is the only way
  REM ---- in. Open on File, press H, press RETURN: MENU.CHOICE.MENU must be 2. If the H is
  REM ---- swallowed, RETURN chooses File's first item and this reads 0.
  ED.DOC.DIRTY = 0 : MENU.ACTIVE = 0 : MENU.SEL = 0
  ED.QK = 72 : POKE 1, 0 : GP.CALL ED.KBDBUF, ED.QK : POKE 1, 4
  ED.QK = 13 : POKE 1, 0 : GP.CALL ED.KBDBUF, ED.QK : POKE 1, 4
  GOSUB ED.OPEN.MENUBAR
  PRINT "MENU LETTER H -> ";MENU.CHOICE.MENU;" (want 2)"

  REM ============================================================================
  REM ---- GUI.INC.BL, driven for real ----
  REM
  REM Nothing above this line touches a dialog -- ED.PROMPT and ED.PROMPT.YN short-circuit
  REM on ED.SIM.MODE, which is what makes the rest fast and what makes it blind to the
  REM library. So SIM goes OFF and the keys go in through kbdbuf_put. Four things could be
  REM wrong here and none of them is a compile error:
  REM
  REM   the frame drawn from GP.BOX's own table -- a box of letters;
  REM   the box centred on the SCREEN while we draw on a SCROLLED map -- and it still looks
  REM     right in a screenshot at rest;
  REM   the covered cells not put back -- a hole in the document;
  REM   the caret not moving -- typing that lands in the wrong order.
  ED.QUIET = 1 : ED.SIM.MODE = 0
  REM LONG lines, deliberately: the centred box lands around column 32, and the "L0".."L39"
  REM used above are three characters wide -- so it would cover blank document and a
  REM restore that did nothing would score the same sum. Fill the width instead.
  GOSUB DOC.INIT
  FOR ED.T = 0 TO 39
    LINE.TEXT$ = MID$(STR$(ED.T), 2) + " ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    GOSUB DOC.PUSH.LINE
  NEXT ED.T
  ED.TOP.LINE = 0 : ED.LEFT.COL = 0 : ED.CUR.ROW = 0 : ED.CUR.COL = 0
  ED.MAP.TOP = 0 : GOSUB ED.SET.VSCROLL
  ED.QUIET = 0 : GOSUB ED.LOAD.LIVE : GOSUB ED.RENDER.ALL

  REM ---- the frame. Open a box by hand, read its corner and its edges, close it.
  REM ---- ED.PETFONT parked the six line glyphs at 192..197, which is what ED.GL.x now
  REM ---- names, so those are the tiles that must come back. Anything in 64..125 means
  REM ---- GP.BOX drew one of its built-in styles, and those glyphs are letters here.
  REM ----
  REM ---- READ THE MAP BEFORE PRINTING ANYTHING: PRINT goes through the KERNAL, which
  REM ---- SCROLLS the same map every VPEEK below addresses. The first version of this test
  REM ---- printed between the draw and the read, and one extra PRINT line shifted the
  REM ---- answer by a row. So repaint, draw, read into strings, close, then speak.
  GOSUB ED.RENDER.ALL
  GUI.TITLE$ = "" : GUI.MSG$ = "FRAME" : GUI.MSG2$ = ""
  GUI.BODY.ROWS = 1 : GUI.BODY.WIDTH = 10
  GOSUB GUI.OPEN
  ED.DDS$ = ""
  FOR ED.GX = 0 TO GUI.WIDTH - 1
    ED.DDS$ = ED.DDS$ + STR$(VPEEK(1, 45056 + GUI.TOP * 256 + (GUI.LEFT + ED.GX) * 2))
  NEXT ED.GX
  ED.DDS2$ = ""
  FOR ED.GR = 0 TO GUI.HEIGHT - 1
    ED.DDS2$ = ED.DDS2$ + STR$(VPEEK(1, 45056 + (GUI.TOP + ED.GR) * 256 + GUI.LEFT * 2))
  NEXT ED.GR
  GOSUB GUI.CLOSE
  PRINT "GUI BOX X=";GUI.LEFT;" Y=";GUI.TOP;" W=";GUI.WIDTH;" H=";GUI.HEIGHT;" STASH=";GUI.STASHED
  PRINT "GUI TOPROW";ED.DDS$
  PRINT "GUI TOPWANT 194 192 x14 195"
  PRINT "GUI LEFTCOL";ED.DDS2$
  PRINT "GUI LEFTWANT 194 193 x5 196"

  REM ---- the restore. Sum the chars over the whole rectangle, open and close a second box
  REM ---- of the same size, sum again -- every cell the dialog could have eaten, because
  REM ---- one sampled cell is not a test of a panel. The repaint first is what makes it
  REM ---- mean anything: on a screen the PRINTs above have scrolled to blank, before and
  REM ---- after are equal whatever happens.
  GOSUB ED.RENDER.ALL
  GOSUB ED.GUI.SUM : ED.GWAS = ED.GSUM
  GOSUB GUI.OPEN : GOSUB GUI.CLOSE
  GOSUB ED.GUI.SUM : ED.GNOW = ED.GSUM
  PRINT "GUI RESTORE WAS=";ED.GWAS;" NOW=";ED.GNOW;" (want equal, and not 3584)"

  REM ---- the scrolled map. VSCROLL down four rows and the box must follow: the same
  REM ---- centred row plus ED.MAP.TOP. Without GUI.ROW.OFFSET it comes back unchanged, and
  REM ---- the dialog is four rows off the top of what the user can see.
  ED.GBY = GUI.TOP
  ED.MAP.TOP = 4 : GOSUB ED.SET.VSCROLL : GOSUB ED.RENDER.ALL
  GOSUB GUI.OPEN : GOSUB GUI.CLOSE
  PRINT "GUI SCROLLED Y=";GUI.TOP;" WAS=";ED.GBY;" MAPTOP=";ED.MAP.TOP;" (want WAS+4)"
  ED.MAP.TOP = 0 : GOSUB ED.SET.VSCROLL : GOSUB ED.RENDER.ALL

  REM ---- GUI.YN through the editor's own wrapper, which is what every call site uses.
  ED.PROMPT.MSG$ = "Discard changes?"
  ED.QK = 89 : GOSUB ED.PUSHKEY
  GOSUB ED.PROMPT.YN
  PRINT "GUI YN Y ->";ED.YN;" (want 1)"
  ED.QK = 27 : GOSUB ED.PUSHKEY
  GOSUB ED.PROMPT.YN
  PRINT "GUI YN ESC ->";ED.YN;" (want 0)"

  REM ---- GUI.TEXT, and with it the caret. Type A B C, LEFT, X: the X must land BETWEEN B
  REM ---- and C. A swallowed arrow reads ABCX; one that left the field reads ABC, OK=0.
  REM ---- The 130 is a PETSCII CONTROL code, and LINEINPUT.TYPED must refuse it: if it
  REM ---- ever lands in the field this reads five characters instead of four.
  ED.PROMPT.MSG$ = "Open file: "
  ED.QK = 65 : GOSUB ED.PUSHKEY
  ED.QK = 130 : GOSUB ED.PUSHKEY
  ED.QK = 66 : GOSUB ED.PUSHKEY
  ED.QK = 67 : GOSUB ED.PUSHKEY
  ED.QK = 157 : GOSUB ED.PUSHKEY
  ED.QK = 88 : GOSUB ED.PUSHKEY
  REM ---- Z then DEL: RUBOUT takes the character BEFORE the caret, so the pair cancels
  REM ---- out and the answer is still ABXC. DELETE is otherwise never driven.
  ED.QK = 90 : GOSUB ED.PUSHKEY
  ED.QK = 20 : GOSUB ED.PUSHKEY
  ED.QK = 13 : GOSUB ED.PUSHKEY
  GOSUB ED.PROMPT
  PRINT "GUI TEXT ->";ED.INPUT$;" OK=";ED.PROMPT.OK;" (want ABXC 1)"

  REM ---- and ESC still throws the typing away rather than returning it
  ED.QK = 90 : GOSUB ED.PUSHKEY
  ED.QK = 27 : GOSUB ED.PUSHKEY
  GOSUB ED.PROMPT
  PRINT "GUI TEXT ESC ->";ED.INPUT$;"/ OK=";ED.PROMPT.OK;" (want / 0)"

  REM ---- GUI.MENU, over the same MENUVERT.ITEM$ the bar uses. Row 1, down, RETURN: 2, 13.
  MENUVERT.ITEM$(1) = " ONE" : MENUVERT.ITEM$(2) = " TWO"
  GUI.COUNT = 2 : GUI.SEL = 1 : GUI.FLAGS = 0
  GUI.TITLE$ = "PICK" : GUI.MSG$ = "" : GUI.MSG2$ = ""
  ED.QK = 17 : GOSUB ED.PUSHKEY
  ED.QK = 13 : GOSUB ED.PUSHKEY
  GOSUB GUI.MENU
  PRINT "GUI MENU SEL=";GUI.SEL;" KEY=";GUI.KEY;" (want 2 13)"
  ED.SIM.MODE = 1

  PRINT "M4 OK"
  RETURN

REM ---- one key into the KERNAL's buffer, so a GET loop can be driven headlessly ----
REM POKE 1 is the ROM/RAM bank byte: 0 pages the KERNAL in for the JSR, 4 puts BASIC back.
ED.PUSHKEY:
  POKE 1, 0 : GP.CALL ED.KBDBUF, ED.QK : POKE 1, 4
  RETURN

REM ---- add up every character cell the dialog box covers ----
REM Chars only: a restore that put the text back in the wrong colour is a different bug.
REM The rectangle is whatever the last GUI.OPEN worked out.
ED.GUI.SUM:
  ED.GSUM = 0
  FOR ED.GR = 0 TO GUI.HEIGHT - 1
    FOR ED.GX = 0 TO GUI.WIDTH - 1
      ED.GSUM = ED.GSUM + VPEEK(1, 45056 + (GUI.TOP + ED.GR) * 256 + (GUI.LEFT + ED.GX) * 2)
    NEXT ED.GX
  NEXT ED.GR
  RETURN

REM --- this read / writes BANKS (line-pointer table + banked memory)
#INCLUDE "STORE.BASL"
