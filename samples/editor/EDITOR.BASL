#SAVEAS "@:EDITOR.PRG"
#AUTONUM 1
#REM 0
#SYMFILE "@:EDITOR.SYM"
#DEFINE ED.KBDBUF $F09F
## kbdbuf_get_modifiers. Bit 1 is Alt (the Commodore key). This is the documented way to
## see a modifier the character code cannot carry -- the KERNAL reference names Ctrl+Esc
## and Alt+F1 as the cases it exists for -- and it is how ALT+letter reaches the menus in
## ISO mode, where the driver no longer sends PETSCII Commodore+letter codes at all.
#DEFINE ED.KBDMOD $FEC0
#DEFINE ED.MOD.ALT 2
## The single-line box, and these are TILE INDICES: GUI.FRAME draws with GP.BOX, whose
## custom glyphs go straight to the cell. They were $80-$85 while GP.FILL drew the frame,
## because GP.FILL converts and for $80-$9F that adds $40 -- so the glyphs had to be parked
## at $C0-$C5 and asked for 64 lower. The bias is gone; the numbers now say where the
## glyphs actually are.
#DEFINE ED.GL.H 192
#DEFINE ED.GL.V 193
#DEFINE ED.GL.TL 194
#DEFINE ED.GL.TR 195
#DEFINE ED.GL.BL 196
#DEFINE ED.GL.BR 197

## The RAM bank GUI.INC.BL saves a dialog's cells into. It is NOT a spare
## one lying around -- the document store owns every bank from 1 upward --
## so STORE.BASL now starts its content arena at 5 and this is the bank it
## gave up. 8K holds 4094 cells and the largest dialog here is well under
## 40x10, so one bank is one dialog with room to spare.
#DEFINE ED.GUI.BANK 4

#INCLUDE "GPB.INC.BL"
#INCLUDE "THEME.INC.BL"
#INCLUDE "APPHELP.INC.BL"
REM STASH.INC.BL is what GUI.OPEN saves the covered cells with. It was GP.STASH and
REM GP.RESTR until 01/09/26, when the pair left the GP runtime block for GP.ASM -- 329
REM bytes that every program using any GP keyword was carrying whether it stashed
REM anything or not. The #SYMFILE above is there for this: the module reaches BASIC's
REM variables from inside assembly through {VAR}, and BASLOAD has crunched every name
REM by then.
#INCLUDE "STASH.INC.BL"
#INCLUDE "MENUHELP.INC.BL"
#INCLUDE "MENUBAR.INC.BL"
#INCLUDE "INPHELP.INC.BL"
#INCLUDE "GUI.INC.BL"

REM ============================================================================
REM EDITOR.BASL -- GPC EDIT, an MS-DOS-EDIT-styled text / Markdown editor for the
REM Commander X16, written in BASLOAD and compiled by GPC.
REM
REM NOTHING GOES THROUGH THE KERNAL. Every cell on the screen -- the text area
REM AND the chrome: menu bar, dropdowns, status bar, prompts, messages -- is
REM written straight into VERA's text map. LOCATE / COLOR / PRINT were taken out:
REM CHROUT is a fixed ROM cost that compiling cannot touch, and padding a bar a
REM space at a time was O(n^2). The document lives in banked RAM through the DOC.*
REM storage layer in STORE.BASL, #INCLUDEd at the bottom.
REM
REM THE TWO RENDERERS ARE INLINE ASSEMBLY. ED.RENDER.ROW draws a row of text and
REM ED.PUT.FIELD draws every piece of chrome, and both are one GP.ASM block each:
REM 65C02 assembled into the program at compile time, reaching BASIC's own
REM variables through {VAR}. That is the whole speed story, and it is measured --
REM EDBENCH.BASL runs the BASIC version and the assembly version of both against
REM each other in one program. See readme.md for the numbers.
REM
REM GP.ASM ITSELF COSTS NO RUNTIME BYTES -- a block is five bytes of p-code plus
REM your instructions, and every handler it uses is in every compiled program
REM already. The assembly here is free. What is NOT free is GP.SELECT in the key
REM dispatch: that is a core keyword, and one core keyword pulls in the whole 2 KB
REM GP block, which is why this compiles GP-BASIC IN. Readability bought with 2,048 bytes,
REM knowingly. Now that the block is paid for, the main loop's GP.DO rides in free --
REM it is taking BOTH back out that would make this GP-BASIC OUT again.
REM
REM Colours (like DETOK): blue bars, black text area, white text, cyan prompts,
REM white-on-red errors.
REM ============================================================================

DEBUG.MODE = 0 : REM 1 = run the self-check to the log and stop. 0 = interactive.
ED.SCREEN.MODE = 1 : REM 1 = 80x30, 3 = 40x30 (see KERNAL screen_mode $FF5F)
ED.DARK = 0 : REM 0 = the DETOK light palette, 1 = the dark one (see ED.THEME)

GOSUB ED.INIT
DOC.FILE.NAME$ = "TEST.MD"
GOSUB DOC.LOADFILE
GOSUB ED.OPEN.DONE
GOSUB ED.RENDER.ALL

IF DEBUG.MODE = 1 THEN GOSUB ED.SELFCHECK : END

REM ---- main loop ----
REM
GP.DO
  GET ED.KEY$
  GP.IF ED.KEY$ <> "" THEN 
    ED.KEY = ASC(ED.KEY$)  
    GOSUB ED.READ.MODS
    GOSUB ED.DISPATCH.KEY
  GP.ENDIF
GP.LOOP


ED.DISPATCH.KEY:
  REM ALT is a MODIFIER on whatever key arrived, not a key of its own, so it is tested
  REM before the selector rather than sitting in it as a code.
  IF ED.MODS.ALT <> 0 THEN GOSUB ED.ALT.MENU : RETURN
  GP.SELECT ED.KEY
    GP.CASE 27  
      MENU.ACTIVE = 0 
      GOSUB ED.OPEN.MENUBAR
    GP.CASE 157 : GOSUB ED.MOVE.LEFT
    GP.CASE 29  : GOSUB ED.MOVE.RIGHT
    GP.CASE 145 : GOSUB ED.MOVE.UP
    GP.CASE 17  : GOSUB ED.MOVE.DOWN
    GP.CASE 19  : GOSUB ED.MOVE.HOME
    GP.CASE 4   : GOSUB ED.MOVE.END
    GP.CASE 130 : GOSUB ED.MOVE.PAGEUP
    GP.CASE 2   : GOSUB ED.MOVE.PAGEDOWN
    GP.CASE 13  : GOSUB ED.DO.ENTER
    GP.CASE 20  : GOSUB ED.DO.BACKSPACE
    GP.CASE 25  : GOSUB ED.DO.DELETE
    GP.CASE 148 : GOSUB ED.TOGGLE.INSERT
    GP.CASE 137 : GOSUB ED.CMD.SAVE
    GP.CASE 134 : GOSUB ED.FIND.NEXT
    GP.OTHER    : GOSUB ED.KEY.RANGE
  GP.ENDSEL
  RETURN

REM Asked with the keystroke, while the key is still down. Banked to 0 the way MENUTST
REM banks for kbdbuf_put: $FEC0 is below the $FF00 jump table, so it is not mirrored
REM across ROM banks and the call has to be made with the KERNAL paged in.
ED.READ.MODS:
  POKE 1, 0 : GP.CALL ED.KBDMOD : POKE 1, 4
  ED.MODS = GP.A
  ED.MODS.ALT = 0
  IF (ED.MODS AND ED.MOD.ALT) <> 0 THEN ED.MODS.ALT = 1
  RETURN

ED.KEY.RANGE:
  REM The keyboard hands back ASCII, because ED.INIT declares ISO encoding -- see the
  REM note beside the $0372 poke there. Before that this had to case-swap every letter,
  REM since PETSCII gives $41-$5A for LOWER case and $C1-$DA for upper.
  IF ED.KEY >= 32 AND ED.KEY <= 126 THEN GOSUB ED.DO.INSERT
  RETURN


ED.QUIT:
  POKE 40761, 0 : POKE 40762, 0 : REM undo any hardware VSCROLL before returning to BASIC
  GOSUB ED.ALTKEYS.OFF : REM and the keyboard layout, which outlives the program
  REM APPHELP.RESTORE puts back the screen mode, the CHARSET and the text colour the
  REM user had when the editor started -- the state APPHELP.STARTUP recorded before we
  REM touched any of it. Leaving someone in 80x30 white-on-blue because that is what
  REM suited us is the rudeness the whole APPHELP module exists to stop.
  REM
  REM THE CHARSET MATTERS TWICE OVER HERE. It is what the user chose -- the machine
  REM boots on 2, upper/graphics, and this used to hardcode 3, so anyone who started in
  REM upper case was dropped back into lower case on the way out. And re-uploading it is
  REM also what undoes ED.PETFONT's re-ordering, so the PRINT below comes out in the
  REM right glyphs. Nothing may be PRINTed before this line.
  GOSUB APPHELP.RESTORE
  PRINT CHR$(147);
  PRINT "BYE."
  END



REM ============================================================================
REM ASCII-ORDER CHARSET (ED.PETFONT)
REM
REM THE RENDERERS WRITE DOCUMENT BYTES STRAIGHT INTO VERA, and a VERA tile index is a
REM SCREEN code, not a character code. Under ISO that never showed: the ISO font happens
REM to be in ASCII order, so the index and the code were the same number. Charset 3 (PET
REM upper/lower) gives us PETSCII glyphs with both cases, but it is in SCREEN-code order.
REM
REM So give the index its meaning back instead of translating every cell: re-order the
REM charset in VRAM so glyph N is the glyph for code N. Both GP.ASM renderers then stay
REM exactly as they are -- no table, no lookup, ZERO cycles a cell. Translating in the
REM renderer instead would have cost TAX + LDA table,X = 6 cycles on a 31-cycle cell,
REM about 19%, on every character of every repaint.
REM
REM IN ASCII ORDER, NOT PETSCII ORDER, and that distinction is the whole reason this
REM works. BASLOAD writes string literals through as the bytes that were in the source,
REM so every literal in this file -- every menu name, prompt and message -- is ASCII.
REM Ordering the font by PETSCII renders all of them case-swapped AND stops find matching
REM its own needles, which is exactly what the self-check caught. PETSCII belongs at the
REM DISK boundary, and STORE.BASL is where it happens.
REM
REM ALMOST NOTHING MOVES. In charset 3 the digits and punctuation at $20-$3F and the
REM capitals at $41-$5A are ALREADY where ASCII wants them, so only 38 glyphs shift:
REM
REM   ASCII $40  @     <- screen $00        ASCII $60  `     <- screen $40
REM   ASCII $5B-$5F    <- screen $1B-$1F    ASCII $61-$7A a-z <- screen $01-$1A
REM   ASCII $7B-$7F    <- screen $5B-$5F
REM
REM Two of those read from a run that another one writes, so order matters: $60 before
REM $40, and $7B-$7F before $5B-$5F. Nothing forms a CYCLE -- screen $01-$1A and $1B-$1F
REM are only ever sources, never destinations -- so unlike a PETSCII-ordered permutation
REM this needs no staging buffer at all.
REM ============================================================================
REM ============================================================================
REM GUI.INC.BL SETUP
REM ============================================================================
REM Done ONCE, and it is four facts about this program that the library cannot
REM work out for itself.
REM
REM GUI.GLYPH IS THE WHOLE REASON THE DIALOGS WORK HERE. GP.BOX takes its border
REM glyphs from a table in the RUNTIME, at the screen codes the stock charset puts
REM them at -- and ED.PETFONT has just moved every one of them. Style 2 would draw
REM "p @ B", the same way it did in the dropdown before that was rewritten as eight
REM GP.FILLs. GUI.FRAME is those eight fills, in the library, and this is where it
REM is told which glyphs to use: the six ED.PETFONT rescued into $C0-$C5, named as
REM GP.FILL arguments (ED.GL.x, i.e. tile - $40 -- see the note at the top).
REM
REM MUST RUN AFTER ED.PETFONT. Before it, ED.GL.x names glyphs that are not there
REM yet; the values would be the same and the frame would be garbage.
ED.GUI.SETUP:
  GUI.BANK = ED.GUI.BANK
  GUI.ROW.OFFSET = 0

  REM THE COLOURS, because this program's theme roles do not mean what the library
  REM assumes. GUI paints its panel with THEME.TEXT and its frame with THEME.BORDER,
  REM which is right for a program using the roles as named. ED.THEME re-points them:
  REM BORDER is the hotkey letter (yellow on blue) and PAGE is a light grey it says
  REM itself it never uses. Left alone, a dialog came up as a grey slab with a blue
  REM edge in the middle of a black editor. Both go to THEME.TEXT -- the document's
  REM own white on black, and the same attribute ED.DRAW.DROPDOWN frames with, so a
  REM dialog and a dropdown are visibly the same program.
  GUI.PANEL.IN = THEME.CLR(THEME.TEXT)
  GUI.BORDER.IN = THEME.CLR(THEME.TEXT)

  GUI.GLYPH = 1
  GUI.EDGE.H    = ED.GL.H  : GUI.EDGE.V    = ED.GL.V
  GUI.CORNER.TL = ED.GL.TL : GUI.CORNER.TR = ED.GL.TR
  GUI.CORNER.BL = ED.GL.BL : GUI.CORNER.BR = ED.GL.BR
  RETURN

REM Where a dialog goes, asked FRESH at every call, because the answer moves.
REM
REM The document is scrolled by VERA, not by repainting: ED.DO.SCROLL bumps
REM L1_VSCROLL and ED.MAP.TOP is the map row now showing as screen row 0. Every
REM GP drawing command in this program addresses the MAP -- that is why the
REM dropdown draws at "2 + ED.MAP.TOP" -- and GUI.INC.BL centres against the
REM SCREEN, which is the right thing for a program that does not scroll. One
REM number reconciles them, and it is only right for as long as the view stays
REM put, so it is set here rather than in ED.GUI.SETUP.
ED.GUI.WHERE:
  GUI.ROW.OFFSET = ED.MAP.TOP
  RETURN

ED.PETFONT:
  ED.FONT = 61440 : REM $1:F000, the KERNAL's 2 KB charset (VERA bank 1)
  REM ---- THE SINGLE-LINE BOX, RESCUED BEFORE THE RE-ORDER RUNS OVER IT ----
  REM Charset 3 keeps its box drawing at $40 - $7D, which is most of what the re-order
  REM below overwrites with ASCII letters, so by the time it finishes the only line
  REM glyphs left in the whole font are a horizontal at $60 and a vertical at $7D -- both
  REM survivors by accident, both sitting on ` and }, and NO CORNERS AT ALL. That is why
  REM GP.BOX style 2 draws "p @ B" here and why style 0's solid $A0 was the only one that
  REM worked: $80-$FF is the one region the re-order never touches.
  REM
  REM So the six are copied up there FIRST, into $C0-$C5. Nothing else uses that region:
  REM the document is ASCII, so no cell above $7F is ever written except by the frame.
  REM Being ahead of every other copy is what keeps each source pristine.
  ED.FS = 64  : ED.FD = ED.GL.H  : ED.FN = 1 : GOSUB ED.FCOPY : REM $40 horizontal
  ED.FS = 93  : ED.FD = ED.GL.V  : ED.FN = 1 : GOSUB ED.FCOPY : REM $5D vertical
  ED.FS = 112 : ED.FD = ED.GL.TL : ED.FN = 1 : GOSUB ED.FCOPY : REM $70 top left
  ED.FS = 110 : ED.FD = ED.GL.TR : ED.FN = 1 : GOSUB ED.FCOPY : REM $6E top right
  ED.FS = 109 : ED.FD = ED.GL.BL : ED.FN = 1 : GOSUB ED.FCOPY : REM $6D bottom left
  ED.FS = 125 : ED.FD = ED.GL.BR : ED.FN = 1 : GOSUB ED.FCOPY : REM $7D bottom right
  REM ---- and now the ASCII re-order itself ----
  ED.FS = 64  : ED.FD = 96  : ED.FN = 1  : GOSUB ED.FCOPY
  ED.FS = 91  : ED.FD = 123 : ED.FN = 5  : GOSUB ED.FCOPY
  ED.FS = 0   : ED.FD = 64  : ED.FN = 1  : GOSUB ED.FCOPY
  ED.FS = 27  : ED.FD = 91  : ED.FN = 5  : GOSUB ED.FCOPY
  ED.FS = 1   : ED.FD = 97  : ED.FN = 26 : GOSUB ED.FCOPY
  RETURN


REM Copy ED.FN glyphs, 8 bytes each, from screen code ED.FS to code ED.FD.
REM
REM GP.DO takes its count once, up front, so the limit is not re-evaluated every pass
REM the way a FOR's TO expression is. The count is put in a variable first because
REM GP.DO 0 loops FOREVER -- every caller here passes 1, 5 or 26, but a zero reaching
REM it would hang rather than do nothing, which is the opposite of what FOR does.
ED.FCOPY:
  ED.FCOUNT = ED.FN * 8
  ED.FI = 0
  GP.DO ED.FCOUNT
    VPOKE 1, ED.FONT + ED.FD * 8 + ED.FI, VPEEK(1, ED.FONT + ED.FS * 8 + ED.FI)
    ED.FI = ED.FI + 1
  GP.LOOP
  RETURN

REM ============================================================================
REM THEME -- every colour in one place, as named roles
REM
REM These are the editor's own values, not THEME.LOAD's. The library's default palette
REM is a blue-page app look; this is DETOK's, and it is what the sample has always
REM drawn. The roles are what is shared, not the colours -- which is the point of
REM having roles at all.
REM
REM   PAGE    dropdown panel        TITLE   menu bar, status bar, messages
REM   TEXT    the document          BORDER  the hotkey letter in a menu title
REM   HILITE  caret, active title   DIMMED  prompts        WARN  errors
REM
REM An attribute is background * 16 + foreground, which is what VERA's colour byte and
REM every GP drawing command already take.
REM ============================================================================
ED.THEME:
  REM THEME.LOAD owns the DIM -- GPC rejects a second DIM of the same array even when
  REM only one of them can ever run (ARRAY REDEFINED), so this calls the library rather
  REM than repeating it, and then overwrites the slots with the editor's own values.
  THEME.DARK = ED.DARK
  GOSUB THEME.LOAD
  IF ED.DARK <> 0 THEN GOTO ED.THEME.DARK
  THEME.CLR(THEME.PAGE)   = 15 * 16 + 0 : REM black on light grey -- unused: the dropdown is TEXT
  THEME.CLR(THEME.TEXT)   =  0 * 16 + 1 : REM white on black -- the document
  THEME.CLR(THEME.TITLE)  =  6 * 16 + 1 : REM white on blue -- bars and messages
  THEME.CLR(THEME.BORDER) =  6 * 16 + 7 : REM yellow on blue -- the hotkey letter
  THEME.CLR(THEME.HILITE) =  1 * 16 + 0 : REM black on white -- caret, active title
  THEME.CLR(THEME.DIMMED) =  0 * 16 + 3 : REM cyan on black -- prompts
  THEME.CLR(THEME.WARN)   =  2 * 16 + 1 : REM white on red -- errors
  RETURN

ED.THEME.DARK:
  THEME.CLR(THEME.PAGE)   = 11 * 16 + 15
  THEME.CLR(THEME.TEXT)   =  0 * 16 + 15
  THEME.CLR(THEME.TITLE)  = 11 * 16 + 1
  THEME.CLR(THEME.BORDER) = 11 * 16 + 7
  THEME.CLR(THEME.HILITE) = 15 * 16 + 0
  THEME.CLR(THEME.DIMMED) =  0 * 16 + 12
  THEME.CLR(THEME.WARN)   =  2 * 16 + 1
  RETURN


REM ============================================================================
REM SETUP
REM ============================================================================
ED.INIT:
  REM FIRST, before any screen mode or colour of our own: APPHELP.STARTUP records the
  REM state as it FINDS it, and ED.QUIT hands exactly that back. Anything changed before
  REM this line is what the user would be left with instead.
  GOSUB APPHELP.STARTUP
  GOSUB ED.THEME
  REM GP.CALL, not SYS. SYS can only pass registers through the POKE 780..783 slots and
  REM hand results back the same way, so a KERNAL call was four statements and three
  REM magic addresses. GP.CALL takes A, X, Y and CARRY as arguments and returns them as
  REM GP.A / GP.X / GP.Y, which is the difference between reading a call and decoding
  REM one. It costs nothing here: GP.CALL and GP.X are GP block keywords, and the block
  REM is already bought and paid for by the GP.SELECT in the key dispatch.
  GP.CALL APPHELP.SCRMODE, ED.SCREEN.MODE, 0, 0, 0 : REM carry CLEAR sets the mode
  GP.CALL APPHELP.SETCHR, 3, 0, 0, 0 : REM charset 3, PET upper/lower
  PRINT CHR$(147);
  GOSUB ED.PETFONT : REM ...then re-index it so a VERA tile index IS a character code
  REM ...and DECLARE that, by setting bit 6 of $0372. The flag means "text is ASCII,
  REM not PETSCII", which is exactly what the re-ordered font now expects, so it is a
  REM statement of fact rather than a trick. Poked directly and not via CHR$(15),
  REM because CHR$(15) would also upload the ISO font and throw away the PETSCII glyphs
  REM that are the whole point. Three things follow, and all three are wanted:
  REM   the KEYBOARD returns ASCII, so nothing has to case-swap a keystroke;
  REM   CHR$()/PRINT stop translating, so KERNAL output lands on the right glyphs;
  REM   GP.PRINTAT skips its PETSCII-to-screen step, which is what lets the GP drawing
  REM   commands -- and MENUHELP, which is built on them -- work at all here.
  POKE 882, PEEK(882) OR 64
  GOSUB ED.GUI.SETUP : REM ...and tell GUI.INC.BL where the frame glyphs ended up
  REM The SAME entry point again, but with CARRY SET, which makes screen_mode REPORT
  REM instead of set: mode in A, columns in X, rows in Y. That replaces $FFED entirely,
  REM so the whole routine now speaks to one KERNAL address rather than three. It has to
  REM be asked AFTER the mode is set, and it is NOT the size APPHELP.STARTUP already
  REM recorded. That one is the mode the USER had -- measured 80x60 -- and it is kept
  REM untouched so ED.QUIT can give it back. This one is the mode the editor just chose,
  REM 80x30, which is what every renderer below has to lay itself out in. Two different
  REM sizes, both needed, so both are asked for.
  GP.CALL APPHELP.SCRMODE, 0, 0, 0, 1
  SCREEN.COLS = GP.X : SCREEN.ROWS = GP.Y
  IF SCREEN.COLS < 20 THEN SCREEN.COLS = 80
  IF SCREEN.ROWS < 8 THEN SCREEN.ROWS = 60
  ED.TEXT.WIDTH  = SCREEN.COLS
  ED.TEXT.BOTTOM = SCREEN.ROWS - 2
  ED.TEXT.ROWS   = SCREEN.ROWS - 2
  ED.ATTR.TEXT   = THEME.CLR(THEME.TEXT)
  ED.ATTR.CARET  = THEME.CLR(THEME.HILITE)
  ED.QUIET = 0 : ED.SIM.MODE = 0 : ED.EXIT.FLAG = 0 : ED.LAST.MSG$ = ""
  REM ---- hardware vertical scroll setup (see ED.DO.SCROLL) ----
  REM The text-map layer is scrolled by VERA's L1_VSCROLL ($9F39/$9F3A, in map pixels,
  REM 8 per text row) so a 1-line move repaints 3 rows instead of the whole screen. Every
  REM screen row is drawn at map row (screen_row + ED.MAP.TOP); ED.MAP.TOP = VSCROLL/8.
  REM Read the map height from L1_CONFIG bits 7:6 (32<<n) and keep ED.MAP.TOP in
  REM [0, MAP.H - SCREEN.ROWS] so the visible window never crosses the map's bottom edge
  REM -- that means we never rely on VERA's vertical wrap; at the bound we rewind + repaint.
  ED.MAP.TOP = 0
  POKE 40761, 0 : POKE 40762, 0
  ED.MAP.CFG = PEEK(40756)
  ED.MAP.HB = INT(ED.MAP.CFG / 64)
  ED.MAP.H = 32
  IF ED.MAP.HB = 1 THEN ED.MAP.H = 64
  IF ED.MAP.HB = 2 THEN ED.MAP.H = 128
  IF ED.MAP.HB = 3 THEN ED.MAP.H = 256
  ED.MAP.MAXTOP = ED.MAP.H - SCREEN.ROWS
  ED.HW.OK = 0
  IF ED.MAP.MAXTOP >= 4 THEN ED.HW.OK = 1
  MENU.ACTIVE = 0 - 1
  GOSUB ED.MENU.SETUP
  GOSUB ED.ALTKEYS
  RETURN

REM ============================================================================
REM ALT+letter, by making the LAYOUT produce the letter
REM
REM In ISO mode the ALT table does not hand back the letter. Measured on the machine:
REM ALT+S arrives as 223, which is eszett, and ALT+F arrives as NOTHING AT ALL because
REM its slot in that table is empty. So the character can never say which key was hit --
REM and for F there is not even a keystroke to look at. kbdbuf_get_modifiers tells us ALT
REM was down (ED.READ.MODS) but it cannot tell us what it was down WITH.
REM
REM The layout itself is writable, so write it. The tables live in banked RAM at $A000 on
REM RAM bank 0: eleven of 128 bytes, byte 0 an ID, bytes 1..127 the code each KEYNUM
REM produces. ID $80 is ISO with no modifier, $C6 is ISO+Alt. Find each menu's initial in
REM the plain table -- the index it sits at IS that key's keynum -- and write the upper
REM case letter into the same index of the ALT table.
REM
REM FOUND BY SEARCH, NOT BY A HARDCODED KEYNUM, so this holds for whatever layout is
REM loaded rather than only for ABC/X16, and it follows the menu names: rename a menu and
REM its accelerator moves with it. Every byte overwritten is saved and put back by
REM ED.ALTKEYS.OFF, because the layout tables outlive the program.
REM BANK 0, NOT POKE 0. GPC's PEEK/POKE save the RAM bank, switch to the one the BANK
REM statement named, access, and switch BACK -- see x16_peekpoke.asm -- so a POKE to the
REM bank register at $00 is undone by the same POKE that made it, every time. STORE.BASL
REM says it plainly at the top: "the runtime's PEEK/POKE honour the last BANK statement".
REM The document layer sets BANK before each of its own accesses and its banks start at 1,
REM so borrowing bank 0 here disturbs nothing.
ED.ALTKEYS:
  ED.NALT = 0
  BANK 0
  ED.TPLAIN = 0 : ED.TALT = 0
  FOR ED.TI = 0 TO 10
    ED.TB = 40960 + 128 * ED.TI
    IF PEEK(ED.TB) = 128 THEN ED.TPLAIN = ED.TB
    IF PEEK(ED.TB) = 198 THEN ED.TALT = ED.TB
  NEXT ED.TI
  IF ED.TPLAIN = 0 THEN RETURN
  IF ED.TALT = 0 THEN RETURN
  FOR MENU.I = 0 TO MENU.COUNT - 1
    ED.WANT = ASC(LEFT$(MENU.NAME$(MENU.I), 1))
    FOR ED.KI = 1 TO 127
      IF PEEK(ED.TPLAIN + ED.KI) = ED.WANT + 32 THEN GOSUB ED.ALTKEY.SET
    NEXT ED.KI
  NEXT MENU.I
  RETURN

ED.ALTKEY.SET:
  ED.ALTK(ED.NALT) = ED.TALT + ED.KI
  ED.ALTV(ED.NALT) = PEEK(ED.TALT + ED.KI)
  POKE ED.TALT + ED.KI, ED.WANT
  ED.NALT = ED.NALT + 1
  RETURN

ED.ALTKEYS.OFF:
  IF ED.NALT = 0 THEN RETURN
  BANK 0
  FOR ED.AI = 0 TO ED.NALT - 1
    POKE ED.ALTK(ED.AI), ED.ALTV(ED.AI)
  NEXT ED.AI
  ED.NALT = 0
  RETURN

ED.OPEN.DONE:
  ED.TOP.LINE = 0 : ED.LEFT.COL = 0
  ED.CUR.ROW = 0 :  ED.CUR.COL = 0
  ED.INSERT.MODE = 1 : ED.DOC.DIRTY = 0
  GOSUB ED.LOAD.LIVE
  RETURN


REM ---- menu tables (data-driven) ----
REM THE BAR'S LAYOUT IS MENUBAR.INC.BL'S NOW, and the MENU.COL table that used to hold it
REM is gone. That table was this program computing, and then remembering, what
REM MENUBAR.COLUMN works out from the item text on demand -- a running sum of the widths
REM to the left. MENUBAR.WHERE hands back the same answer as MENUBAR.SELX, which is what
REM ED.DRAW.DROPDOWN now hangs the panel from.
REM
REM MENU.WIDTH STAYS. That is the DROPDOWN's width, the longest item plus two, and it is
REM this program's business: a vertical panel has a column width, and the bar above it
REM does not.
ED.MENU.SETUP:
  MENU.COUNT = 3
  DIM MENU.NAME$(3) : DIM MENU.ITEMS(3)
  DIM MENU.WIDTH(3)
  DIM MENU.ITEM$(24) : REM flat: menu * 8 + item
  DIM MENUHELP.ITEM$(8) : REM MENUHELP leaves its item array to the caller
  DIM ED.ALTK(8) : DIM ED.ALTV(8) : REM layout bytes ED.ALTKEYS overwrites, to put back
  MENU.NAME$(0) = "File" : MENU.ITEMS(0) = 5
  MENU.ITEM$(0) = "New" : MENU.ITEM$(1) = "Open..." : MENU.ITEM$(2) = "Save"
  MENU.ITEM$(3) = "Save As..." : MENU.ITEM$(4) = "Exit"
  MENU.NAME$(1) = "Search" : MENU.ITEMS(1) = 2
  MENU.ITEM$(8) = "Find..." : MENU.ITEM$(9) = "Go to Line..."
  MENU.NAME$(2) = "Help" : MENU.ITEMS(2) = 1
  MENU.ITEM$(16) = "About"
  MENU.HOT$ = "FSH" : REM the initials, for the bar's accelerator tint and its hotkeys
  FOR MENU.I = 0 TO MENU.COUNT - 1
    MENU.W = LEN(MENU.NAME$(MENU.I))
    FOR MENU.J = 0 TO MENU.ITEMS(MENU.I) - 1
      IF LEN(MENU.ITEM$(MENU.I * 8 + MENU.J)) > MENU.W THEN MENU.W = LEN(MENU.ITEM$(MENU.I * 8 + MENU.J))
    NEXT MENU.J
    MENU.WIDTH(MENU.I) = MENU.W + 2
  NEXT MENU.I
  RETURN


REM ---- the bar's items, into the array MENUBAR reads.
REM
REM MENUBAR AND MENUHELP SHARE MENUHELP.ITEM$ ON PURPOSE -- a program with a bar and a
REM dropdown wants one convention, not two -- so the array holds whichever of the two is
REM being drawn, and this routine and ED.DRAW.DROPDOWN each load their own before use.
REM Loading it is cheap; keeping two copies in step would not be.
REM
REM AN ITEM IS " NAME ", and the spaces are the layout. MENUBAR makes each item exactly as
REM wide as its text, so the air around a title has to be IN the title -- which is also
REM what gives the highlight its margin. With MENUBAR.X = 0 and no gap that puts File at
REM column 1, Search at 7 and Help at 15, which is cell for cell where the hand-rolled bar
REM put them.
ED.MENU.BAR.ITEMS:
  FOR MENU.I = 0 TO MENU.COUNT - 1
    MENUHELP.ITEM$(MENU.I + 1) = " " + MENU.NAME$(MENU.I) + " "
  NEXT MENU.I
  MENUHELP.COUNT = MENU.COUNT
  MENUHELP.X = 0 : MENUHELP.Y = 0
  MENUHELP.ATTR = THEME.CLR(THEME.TITLE)
  MENUHELP.HIATTR = THEME.CLR(THEME.HILITE)
  MENUHELP.HOT$ = MENU.HOT$
  MENUHELP.HOTATTR = THEME.CLR(THEME.BORDER)
  MENUBAR.X = 0 : MENUBAR.Y = ED.MAP.TOP : MENUBAR.GAP = 0
  RETURN



REM ============================================================================
REM LIVE LINE
REM ============================================================================
ED.LOAD.LIVE:
  LINE.INDEX = ED.CUR.ROW : GOSUB DOC.LOAD
  ED.CUR.LINE$ = LINE.TEXT$
  ED.CUR.DIRTY = 0
  RETURN

ED.COMMIT.LIVE:
  IF ED.CUR.DIRTY = 0 THEN RETURN
  LINE.TEXT$ = ED.CUR.LINE$ : LINE.INDEX = ED.CUR.ROW : GOSUB DOC.STORE
  ED.CUR.DIRTY = 0
  RETURN

ED.CLAMP.COL:
  IF ED.CUR.COL > LEN(ED.CUR.LINE$) THEN ED.CUR.COL = LEN(ED.CUR.LINE$)
  RETURN



REM ============================================================================
REM CURSOR MOVEMENT
REM ============================================================================
ED.MOVE.LEFT:
  IF ED.CUR.COL > 0 THEN ED.CUR.COL = ED.CUR.COL - 1 : GOSUB ED.CARET.REFRESH : RETURN
  IF ED.CUR.ROW = 0 THEN RETURN
  GOSUB ED.COMMIT.LIVE
  ED.CUR.ROW = ED.CUR.ROW - 1 : GOSUB ED.LOAD.LIVE
  ED.CUR.COL = LEN(ED.CUR.LINE$)
  GOSUB ED.CARET.REFRESH
  RETURN

ED.MOVE.RIGHT:
  IF ED.CUR.COL < LEN(ED.CUR.LINE$) THEN ED.CUR.COL = ED.CUR.COL + 1 : GOSUB ED.CARET.REFRESH : RETURN
  IF ED.CUR.ROW >= LINE.COUNT - 1 THEN RETURN
  GOSUB ED.COMMIT.LIVE
  ED.CUR.ROW = ED.CUR.ROW + 1 : GOSUB ED.LOAD.LIVE
  ED.CUR.COL = 0 : GOSUB ED.CARET.REFRESH
  RETURN

ED.MOVE.UP:
  IF ED.CUR.ROW = 0 THEN RETURN
  GOSUB ED.COMMIT.LIVE
  ED.CUR.ROW = ED.CUR.ROW - 1 : GOSUB ED.LOAD.LIVE : GOSUB ED.CLAMP.COL
  GOSUB ED.CARET.REFRESH
  RETURN

ED.MOVE.DOWN:
  IF ED.CUR.ROW >= LINE.COUNT - 1 THEN RETURN
  GOSUB ED.COMMIT.LIVE
  ED.CUR.ROW = ED.CUR.ROW + 1 : GOSUB ED.LOAD.LIVE : GOSUB ED.CLAMP.COL
  GOSUB ED.CARET.REFRESH
  RETURN

ED.MOVE.HOME:
  ED.CUR.COL = 0 : GOSUB ED.CARET.REFRESH
  RETURN

ED.MOVE.END:
  ED.CUR.COL = LEN(ED.CUR.LINE$) : GOSUB ED.CARET.REFRESH
  RETURN

ED.MOVE.PAGEUP:
  GOSUB ED.COMMIT.LIVE
  ED.CUR.ROW = ED.CUR.ROW - ED.TEXT.ROWS
  IF ED.CUR.ROW < 0 THEN ED.CUR.ROW = 0
  GOSUB ED.LOAD.LIVE : GOSUB ED.CLAMP.COL : GOSUB ED.CARET.REFRESH
  RETURN

ED.MOVE.PAGEDOWN:
  GOSUB ED.COMMIT.LIVE
  ED.CUR.ROW = ED.CUR.ROW + ED.TEXT.ROWS
  IF ED.CUR.ROW > LINE.COUNT - 1 THEN ED.CUR.ROW = LINE.COUNT - 1
  GOSUB ED.LOAD.LIVE : GOSUB ED.CLAMP.COL : GOSUB ED.CARET.REFRESH
  RETURN

REM ============================================================================
REM EDITING
REM ============================================================================
ED.DO.INSERT:
  IF LEN(ED.CUR.LINE$) >= 250 THEN RETURN
  ED.CH$ = CHR$(ED.KEY)
  IF ED.INSERT.MODE = 0 AND ED.CUR.COL < LEN(ED.CUR.LINE$) THEN GOTO ED.INS.OVER
  ED.CUR.LINE$ = LEFT$(ED.CUR.LINE$, ED.CUR.COL) + ED.CH$ + MID$(ED.CUR.LINE$, ED.CUR.COL + 1, 250)
  GOTO ED.INS.DONE
ED.INS.OVER:
  ED.CUR.LINE$ = LEFT$(ED.CUR.LINE$, ED.CUR.COL) + ED.CH$ + MID$(ED.CUR.LINE$, ED.CUR.COL + 2, 250)
ED.INS.DONE:
  ED.CUR.COL = ED.CUR.COL + 1
  ED.CUR.DIRTY = 1 : ED.DOC.DIRTY = 1
  GOSUB ED.REFRESH.INTRA
  RETURN

ED.DO.BACKSPACE:
  IF ED.CUR.COL = 0 THEN GOTO ED.BS.JOIN
  ED.CUR.LINE$ = LEFT$(ED.CUR.LINE$, ED.CUR.COL - 1) + MID$(ED.CUR.LINE$, ED.CUR.COL + 1, 250)
  ED.CUR.COL = ED.CUR.COL - 1
  ED.CUR.DIRTY = 1 : ED.DOC.DIRTY = 1
  GOSUB ED.REFRESH.INTRA
  RETURN

ED.BS.JOIN:
  IF ED.CUR.ROW = 0 THEN RETURN
  LINE.INDEX = ED.CUR.ROW - 1 : GOSUB DOC.LOAD
  ED.JOIN.COL = LEN(LINE.TEXT$)
  ED.CUR.LINE$ = LEFT$(LINE.TEXT$ + ED.CUR.LINE$, 250)
  LINE.TEXT$ = ED.CUR.LINE$ : LINE.INDEX = ED.CUR.ROW - 1 : GOSUB DOC.STORE
  LINE.INDEX = ED.CUR.ROW : GOSUB DOC.DELETE.SLOT
  ED.CUR.ROW = ED.CUR.ROW - 1
  ED.CUR.COL = ED.JOIN.COL
  ED.CUR.DIRTY = 0 : ED.DOC.DIRTY = 1
  GOSUB ED.REFRESH.FULL
  RETURN

ED.DO.DELETE:
  IF ED.CUR.COL < LEN(ED.CUR.LINE$) THEN GOTO ED.DEL.CHAR
  IF ED.CUR.ROW >= LINE.COUNT - 1 THEN RETURN
  LINE.INDEX = ED.CUR.ROW + 1 : GOSUB DOC.LOAD
  ED.CUR.LINE$ = LEFT$(ED.CUR.LINE$ + LINE.TEXT$, 250)
  LINE.TEXT$ = ED.CUR.LINE$ : LINE.INDEX = ED.CUR.ROW : GOSUB DOC.STORE
  LINE.INDEX = ED.CUR.ROW + 1 : GOSUB DOC.DELETE.SLOT
  ED.CUR.DIRTY = 0 : ED.DOC.DIRTY = 1
  GOSUB ED.REFRESH.FULL
  RETURN
  
ED.DEL.CHAR:
  ED.CUR.LINE$ = LEFT$(ED.CUR.LINE$, ED.CUR.COL) + MID$(ED.CUR.LINE$, ED.CUR.COL + 2, 250)
  ED.CUR.DIRTY = 1 : ED.DOC.DIRTY = 1
  GOSUB ED.REFRESH.INTRA
  RETURN

ED.DO.ENTER:
  ED.LEFT.HALF$ = LEFT$(ED.CUR.LINE$, ED.CUR.COL)
  ED.RIGHT.HALF$ = MID$(ED.CUR.LINE$, ED.CUR.COL + 1, 250)
  LINE.TEXT$ = ED.LEFT.HALF$ : LINE.INDEX = ED.CUR.ROW : GOSUB DOC.STORE
  LINE.INDEX = ED.CUR.ROW + 1 : GOSUB DOC.INSERT.SLOT
  LINE.TEXT$ = ED.RIGHT.HALF$ : LINE.INDEX = ED.CUR.ROW + 1 : GOSUB DOC.STORE
  ED.CUR.ROW = ED.CUR.ROW + 1
  ED.CUR.COL = 0
  ED.CUR.LINE$ = ED.RIGHT.HALF$ : ED.CUR.DIRTY = 0 : ED.DOC.DIRTY = 1
  GOSUB ED.REFRESH.FULL
  RETURN

ED.TOGGLE.INSERT:
  ED.INSERT.MODE = 1 - ED.INSERT.MODE
  GOSUB ED.RENDER.STATUS
  RETURN

REM ============================================================================
REM MENUS
REM ============================================================================
ED.ALT.MENU:
  REM Whatever letter the driver sent with ALT down, folded to upper. This no longer
  REM decodes a PETSCII Commodore code, because in ISO mode there is not one to decode --
  REM ED.READ.MODS has already asked the KERNAL whether ALT was actually held.
  ED.ALT.CH = ED.KEY
  IF ED.ALT.CH >= 97 AND ED.ALT.CH <= 122 THEN ED.ALT.CH = ED.ALT.CH - 32
  FOR MENU.I = 0 TO MENU.COUNT - 1
    GP.IF ASC(LEFT$(MENU.NAME$(MENU.I), 1)) = ED.ALT.CH THEN 
      MENU.ACTIVE = MENU.I 
      GOSUB ED.OPEN.MENUBAR  
      RETURN
    GP.ENDIF
  NEXT MENU.I
  REM No menu with that initial. SAY WHAT ARRIVED, because ALT+letter is the one path
  REM nothing headless can drive -- kbdbuf_put fills the buffer but sets no modifiers --
  REM so the machine reporting its own key and modifier bytes is the only instrument
  REM there is. A silent no-op here would just look like ALT being broken again.
  ED.MSG$ = "ALT: key=" + MID$(STR$(ED.KEY), 2) + " mods=" + MID$(STR$(ED.MODS), 2)
  GOSUB ED.INFO.MSG
  RETURN

REM THE DROPDOWN'S KEY LOOP IS MENUHELP.RUN'S NOW. This used to be a GP.DO / GP.SELECT
REM here, waiting on GET and dispatching six keys itself -- which is precisely the loop
REM MENUHELP already owns, written a second time so that the two lines the editor needed
REM on top of it could exist.
REM
REM WHAT THE EDITOR NEEDED, and why it could not just call MENUHELP.RUN before today: this
REM is a dropdown UNDER A BAR, so LEFT and RIGHT have to walk the bar with the panel still
REM open, and a letter has to jump to the menu with that initial. A vertical menu ignores
REM all three -- correctly, they mean nothing on its axis -- and swallowed them.
REM
REM MENUHELP.KEYEXIT is the answer, and it is a library change, not a workaround here: a
REM key the menu has no use for ends it with MENUHELP.KEY set and MENUHELP.SEL untouched,
REM and the caller says what it meant. It is the mirror of MENUBAR.DOWNEXIT, which lets a
REM bar hand DOWN to whoever is going to open the panel. Between the two, a bar and its
REM dropdown drive each other and neither module knows the other is there.
REM
REM SO THE LOOP HERE IS ABOUT THE BAR, not about keys. One label, and every path either
REM comes back to it having moved which menu is open, or returns.
REM
REM MENU.ACTIVE and MENU.SEL are 0 based, because MENU.ITEM$ is a flat table indexed
REM MENU.ACTIVE * 8 + MENU.SEL. MENUBAR.SEL and MENUHELP.SEL are 1 based. Converted at the
REM boundary, in both directions, and nowhere else.
ED.OPEN.MENUBAR:
  MENU.SEL = 0
  GOSUB ED.RENDER.MENUBAR
ED.MENU.OPEN:
  GOSUB ED.DRAW.DROPDOWN
  MENUHELP.SEL = MENU.SEL + 1
  MENUHELP.FLAGS = MENUHELP.KEYEXIT
  REM No hotkeys ON THE ITEMS: a letter here means a MENU, and it is handed back below.
  REM ED.DRAW.DROPDOWN has already set HOTATTR to 0 for the same reason.
  MENUHELP.HOT$ = ""
  GOSUB MENUHELP.RUN
  IF MENUHELP.SEL = 0 THEN GOSUB ED.MENU.CANCEL : RETURN
  MENU.SEL = MENUHELP.SEL - 1
  IF MENUHELP.KEY = 13 THEN GOSUB ED.MENU.SELECT : RETURN
  REM ED.RENDER.MENUBAR IS NOT IN THIS LOOP, and that is the point. It lays a band across
  REM the whole row, draws every title and re-prints the document name -- eighty cells to
  REM move a highlight two. The movers below repaint the TWO titles that changed instead,
  REM which is what MENUBAR.RUN's own MENUBAR.SETTLE does when it is driving the bar.
  IF MENUHELP.KEY = 157 THEN GOSUB ED.MENU.LEFT : GOTO ED.MENU.OPEN
  IF MENUHELP.KEY = 29 THEN GOSUB ED.MENU.RIGHT : GOTO ED.MENU.OPEN
  ED.KEY = MENUHELP.KEY : GOSUB ED.MENU.LETTER
  GOTO ED.MENU.OPEN

REM A letter while the bar is open jumps to that menu and opens it. THIS IS NOW THE WAY
REM IN, because ALT+letter is not one any more: ED.INIT declares ISO encoding, and in ISO
REM mode the keyboard driver returns ISO-8859-15, not PETSCII. ALT+letter there produces
REM the accented and symbol characters the US layout maps -- ALT+S is ss, ALT+D is eth --
REM and F and H are not mapped at all. The 161..191 test in ED.KEY.RANGE was reading the
REM PETSCII Commodore+letter codes, which the driver no longer sends.
REM
REM Folded to upper without case, so f and F both reach File.
REM A letter jumps to the menu with that initial. NO REDRAW HERE any more -- ED.MENU.OPEN
REM does it on the way round -- so this only has to erase the panel that is about to move.
REM A letter matching nothing leaves everything alone and the loop redraws what was already
REM there, which is what "ignored" should look like.
ED.MENU.LETTER:
  ED.ML.CH = ED.KEY
  IF ED.ML.CH >= 97 AND ED.ML.CH <= 122 THEN ED.ML.CH = ED.ML.CH - 32
  ED.ML.HIT = 0 - 1
  FOR MENU.I = 0 TO MENU.COUNT - 1
    IF ASC(LEFT$(MENU.NAME$(MENU.I), 1)) = ED.ML.CH THEN ED.ML.HIT = MENU.I
  NEXT MENU.I
  REM Nothing to do is the common case -- every key that is not an arrow or RETURN arrives
  REM here -- so it must not repaint. It used to move the menu INSIDE the search loop,
  REM which meant a full screen redraw per matching letter and none of the erase below.
  IF ED.ML.HIT < 0 THEN RETURN
  IF ED.ML.HIT = MENU.ACTIVE THEN RETURN
  GOSUB ED.ERASE.DROPDOWN
  ED.MENU.WAS = MENU.ACTIVE
  MENU.ACTIVE = ED.ML.HIT : MENU.SEL = 0
  GOSUB ED.MENU.BAR.MOVE
  RETURN

ED.MENU.SELECT:
  MENU.CHOICE.MENU = MENU.ACTIVE : MENU.CHOICE.ITEM = MENU.SEL
  MENU.ACTIVE = 0 - 1
  GOSUB ED.RENDER.ALL : GOSUB ED.MENU.DISPATCH
  RETURN

ED.MENU.CANCEL:
  MENU.ACTIVE = 0 - 1
  GOSUB ED.RENDER.ALL
  RETURN

REM ED.MENU.UP and ED.MENU.DOWN are GONE: moving the highlight inside the panel is
REM MENUHELP.RUN's job and always was, and this program was doing it a second time from
REM outside. Only the two that cross the panel's axis are left, and they exist because
REM MENUHELP hands those keys back rather than guessing what a bar wants.
REM
REM ED.RENDER.ALL erases the panel that is about to move; ED.MENU.OPEN draws the new one.
REM ERASE BEFORE MOVING. ED.ERASE.DROPDOWN works from the ED.DD.* geometry the LAST
REM ED.DRAW.DROPDOWN left behind, which is the panel actually on screen -- so it has to run
REM while MENU.ACTIVE still names that panel.
ED.MENU.LEFT:
  GOSUB ED.ERASE.DROPDOWN
  ED.MENU.WAS = MENU.ACTIVE
  MENU.ACTIVE = MENU.ACTIVE - 1
  IF MENU.ACTIVE < 0 THEN MENU.ACTIVE = MENU.COUNT - 1
  MENU.SEL = 0
  GOSUB ED.MENU.BAR.MOVE
  RETURN

ED.MENU.RIGHT:
  GOSUB ED.ERASE.DROPDOWN
  ED.MENU.WAS = MENU.ACTIVE
  MENU.ACTIVE = MENU.ACTIVE + 1
  IF MENU.ACTIVE >= MENU.COUNT THEN MENU.ACTIVE = 0
  MENU.SEL = 0
  GOSUB ED.MENU.BAR.MOVE
  RETURN

REM ---- the two titles that changed, and nothing else ----
REM
REM ED.MENU.BAR.ITEMS first because ED.DRAW.DROPDOWN has since pointed MENUHELP.X, .Y,
REM .WIDTH, .ATTR and .HIATTR at the PANEL. MENUBAR.ITEM and MENUBAR.MARK both reach
REM MENUHELP.ROW through those, so drawing a title with the panel's numbers still loaded
REM would paint it at the panel's column, in the panel's colours.
ED.MENU.BAR.MOVE:
  GOSUB ED.MENU.BAR.ITEMS
  MENUBAR.DRAWN = ED.MENU.WAS + 1 : MENUBAR.PAINT = MENUHELP.ATTR : GOSUB MENUBAR.ITEM
  MENUBAR.SEL = MENU.ACTIVE + 1 : GOSUB MENUBAR.MARK
  RETURN

REM ---- put the document back where the panel was, and no further ----
REM
REM ED.RENDER.ALL was doing this: every text row, the status bar, the caret AND the whole
REM menu bar, to take down a seven row panel. The panel starts at screen row 1 and is
REM ED.DD.FH rows tall, so those are the only rows that can be dirty.
ED.ERASE.DROPDOWN:
  ED.DDE.LAST = ED.DD.FH
  IF ED.DDE.LAST > ED.TEXT.BOTTOM THEN ED.DDE.LAST = ED.TEXT.BOTTOM
  IF ED.DDE.LAST < 1 THEN RETURN
  FOR ED.SCREEN.ROW = 1 TO ED.DDE.LAST
    ED.DOC.LINE = ED.TOP.LINE + ED.SCREEN.ROW - 1
    GOSUB ED.RENDER.ROW
  NEXT ED.SCREEN.ROW
  RETURN

ED.MENU.DISPATCH:
  IF MENU.CHOICE.MENU = 0 THEN GOSUB ED.DISP.FILE : RETURN
  IF MENU.CHOICE.MENU = 1 THEN GOSUB ED.DISP.SEARCH : RETURN
  IF MENU.CHOICE.MENU = 2 THEN GOSUB ED.CMD.ABOUT : RETURN
  RETURN

ED.DISP.FILE:
  ON MENU.CHOICE.ITEM + 1 GOSUB ED.CMD.NEW, ED.CMD.OPEN, ED.CMD.SAVE, ED.CMD.SAVEAS, ED.CMD.EXIT
  RETURN

ED.DISP.SEARCH:
  ON MENU.CHOICE.ITEM + 1 GOSUB ED.CMD.FIND, ED.CMD.GOTO
  RETURN



REM ============================================================================
REM COMMANDS
REM ============================================================================
ED.CMD.NEW:
  GOSUB ED.CONFIRM.DISCARD
  IF ED.DISCARD.OK = 0 THEN GOSUB ED.REFRESH.FULL : RETURN
  GOSUB DOC.INIT
  LINE.TEXT$ = "" : LINE.INDEX = 0 : GOSUB DOC.STORE : LINE.COUNT = 1
  DOC.FILE.NAME$ = "UNTITLED"
  GOSUB ED.OPEN.DONE : GOSUB ED.REFRESH.FULL
  RETURN

ED.OPEN.FILE:
  GOSUB DOC.LOADFILE
  IF LINE.COUNT = 0 THEN LINE.TEXT$ = "" : LINE.INDEX = 0 : GOSUB DOC.STORE : LINE.COUNT = 1
  GOSUB ED.OPEN.DONE : GOSUB ED.REFRESH.FULL
  RETURN

ED.CMD.OPEN:
  GOSUB ED.CONFIRM.DISCARD
  IF ED.DISCARD.OK = 0 THEN GOSUB ED.REFRESH.FULL : RETURN
  ED.PROMPT.MSG$ = "Open file: " : GOSUB ED.PROMPT
  IF ED.PROMPT.OK = 0 THEN GOSUB ED.REFRESH.FULL : RETURN
  DOC.FILE.NAME$ = ED.INPUT$
  GOSUB ED.OPEN.FILE
  RETURN

ED.SAVE.FILE:
  GOSUB ED.COMMIT.LIVE : GOSUB DOC.SAVEFILE
  ED.DOC.DIRTY = 0
  RETURN

ED.CMD.SAVE:
  IF DOC.FILE.NAME$ = "UNTITLED" THEN GOSUB ED.CMD.SAVEAS : RETURN
  GOSUB ED.SAVE.FILE : GOSUB ED.REFRESH.FULL
  ED.MSG$ = "Saved " + DOC.FILE.NAME$ : GOSUB ED.INFO.MSG
  RETURN

ED.CMD.SAVEAS:
  ED.PROMPT.MSG$ = "Save as: " : GOSUB ED.PROMPT
  IF ED.PROMPT.OK = 0 THEN GOSUB ED.REFRESH.FULL : RETURN
  DOC.FILE.NAME$ = ED.INPUT$
  GOSUB ED.SAVE.FILE : GOSUB ED.REFRESH.FULL
  ED.MSG$ = "Saved " + DOC.FILE.NAME$ : GOSUB ED.INFO.MSG
  RETURN

ED.CMD.EXIT:
  IF ED.DOC.DIRTY = 0 THEN GOTO ED.CMD.EXIT.GO
  ED.PROMPT.MSG$ = "Discard changes?" : GOSUB ED.PROMPT.YN
  IF ED.YN = 0 THEN GOSUB ED.REFRESH.FULL : RETURN
ED.CMD.EXIT.GO:
  IF ED.SIM.MODE = 1 THEN ED.EXIT.FLAG = 1 : RETURN
  GOTO ED.QUIT
ED.CMD.ABOUT:
  ED.MSG$ = "GPC EDIT -- a simple X16 text editor" : GOSUB ED.INFO.MSG
  RETURN

ED.CONFIRM.DISCARD:
  ED.DISCARD.OK = 1
  IF ED.DOC.DIRTY = 0 THEN RETURN
  ED.PROMPT.MSG$ = "Discard changes?" : GOSUB ED.PROMPT.YN
  ED.DISCARD.OK = ED.YN
  RETURN

ED.CMD.FIND:
  ED.PROMPT.MSG$ = "Find: " : GOSUB ED.PROMPT
  IF ED.PROMPT.OK = 0 THEN GOSUB ED.REFRESH.FULL : RETURN
  ED.FIND$ = ED.INPUT$
  GOSUB ED.FIND.NEXT
  RETURN

ED.CMD.GOTO:
  ED.PROMPT.MSG$ = "Go to line: " : GOSUB ED.PROMPT
  IF ED.PROMPT.OK = 0 THEN GOSUB ED.REFRESH.FULL : RETURN
  ED.GOTO.N = VAL(ED.INPUT$)
  IF ED.GOTO.N < 1 THEN ED.GOTO.N = 1
  IF ED.GOTO.N > LINE.COUNT THEN ED.GOTO.N = LINE.COUNT
  GOSUB ED.COMMIT.LIVE
  ED.CUR.ROW = ED.GOTO.N - 1
  ED.CUR.COL = 0
  GOSUB ED.LOAD.LIVE
  GOSUB ED.REFRESH.FULL
  ED.MSG$ = "Line " + MID$(STR$(ED.GOTO.N), 2) : GOSUB ED.INFO.MSG
  RETURN

REM ---- forward, wrapping, case-insensitive substring search for ED.FIND$ ----
ED.FIND.NEXT:
  IF LEN(ED.FIND$) = 0 THEN RETURN
  ED.FOLD.IN$ = ED.FIND$ : GOSUB ED.FOLD : ED.NEEDLE$ = ED.FOLD.OUT$
  GOSUB ED.COMMIT.LIVE
  ED.FR = ED.CUR.ROW
  ED.FROM = ED.CUR.COL + 2
  ED.SCANNED = 0
ED.FN.LOOP:
  IF ED.SCANNED > LINE.COUNT THEN GOTO ED.FN.NONE
  LINE.INDEX = ED.FR : GOSUB DOC.LOAD
  ED.FOLD.IN$ = LINE.TEXT$ : GOSUB ED.FOLD : ED.HAY$ = ED.FOLD.OUT$
  GOSUB ED.STRFIND
  IF ED.FOUND.AT > 0 THEN GOTO ED.FN.HIT
  ED.FR = ED.FR + 1
  IF ED.FR > LINE.COUNT - 1 THEN ED.FR = 0
  ED.FROM = 1
  ED.SCANNED = ED.SCANNED + 1
  GOTO ED.FN.LOOP
ED.FN.HIT:
  ED.CUR.ROW = ED.FR
  ED.CUR.COL = ED.FOUND.AT - 1
  GOSUB ED.LOAD.LIVE
  GOSUB ED.REFRESH.FULL
  ED.MSG$ = "Found: " + ED.FIND$ : GOSUB ED.INFO.MSG
  RETURN

ED.FN.NONE:
  ED.MSG$ = "Not found: " + ED.FIND$ : GOSUB ED.ERR.MSG
  RETURN

REM find ED.NEEDLE$ in ED.HAY$ from 1-based ED.FROM -> ED.FOUND.AT (0 = miss)
ED.STRFIND:
  ED.FOUND.AT = 0
  ED.NLEN = LEN(ED.NEEDLE$)
  IF ED.NLEN = 0 THEN RETURN
  ED.HLEN = LEN(ED.HAY$)
  ED.SI = ED.FROM
  IF ED.SI < 1 THEN ED.SI = 1
ED.SF.LOOP:
  IF ED.SI + ED.NLEN - 1 > ED.HLEN THEN RETURN
  IF MID$(ED.HAY$, ED.SI, ED.NLEN) = ED.NEEDLE$ THEN ED.FOUND.AT = ED.SI : RETURN
  ED.SI = ED.SI + 1
  GOTO ED.SF.LOOP

REM Uppercase ED.FOLD.IN$ -> ED.FOLD.OUT$. ASCII, because ASCII is what the document
REM and the literals are -- PETSCII lives only on disk, and STORE.BASL converts at that
REM boundary. ASCII lower case is $61-$7A (97-122).
ED.FOLD:
  ED.FOLD.OUT$ = ""
  REM Same FOR 1 TO 0 trap as DOC.TOPETSCII: an empty needle would fold to CHR$(0).
  IF LEN(ED.FOLD.IN$) = 0 THEN RETURN
  FOR ED.FOLD.I = 1 TO LEN(ED.FOLD.IN$)
    ED.FOLD.CH = ASC(MID$(ED.FOLD.IN$, ED.FOLD.I, 1))
    IF ED.FOLD.CH >= 97 AND ED.FOLD.CH <= 122 THEN ED.FOLD.CH = ED.FOLD.CH - 32
    ED.FOLD.OUT$ = ED.FOLD.OUT$ + CHR$(ED.FOLD.CH)
  NEXT ED.FOLD.I
  RETURN



REM ============================================================================
REM PROMPTS (cyan line input; sim hook for the headless self-check)
REM ============================================================================
REM BOTH OF THESE USED TO BE HAND-ROLLED ON THE BOTTOM ROW, and both are now the
REM library. What went with them: a key loop that could only append and rub out from
REM the end, a Y/N reader that spelled its own answers into the prompt string, and
REM two lots of geometry. What arrived with them: a caret that moves, a field that
REM cannot be typed past, and a box that puts back the cells it covered instead of
REM leaving the caller to repaint.
REM
REM THE INTERFACE HERE DID NOT CHANGE. ED.PROMPT.MSG$ in, ED.INPUT$ + ED.PROMPT.OK
REM or ED.YN out -- so all six call sites are untouched, and so is the ED.SIM.MODE
REM short circuit the self-check drives them through.

ED.PROMPT:
  IF ED.SIM.MODE = 1 THEN ED.INPUT$ = ED.SIM.INPUT$ : ED.PROMPT.OK = 1 : RETURN
  GOSUB ED.GUI.WHERE
  GUI.TITLE$ = "" : GUI.MSG2$ = "" : GUI.MASK = 0
  GUI.MSG$ = ED.PROMPT.MSG$
  REM Wide enough for a path, and the box sizes itself around it. The old field ran
  REM to 60 because it had the whole screen width; a centred dialog does not.
  GUI.LEN = 40
  GUI.INPUT$ = ""
  GOSUB GUI.TEXT
  ED.INPUT$ = GUI.INPUT$ : ED.PROMPT.OK = GUI.OK
  REM A cancel hands back "", as it always did. GUI.TEXT restores what was passed
  REM IN, which here is "" anyway -- this is belt and braces, and it is one store.
  IF ED.PROMPT.OK = 0 THEN ED.INPUT$ = ""
  RETURN

ED.PROMPT.YN:
  IF ED.SIM.MODE = 1 THEN ED.YN = ED.SIM.YN : RETURN
  GOSUB ED.GUI.WHERE
  GUI.TITLE$ = "" : GUI.MSG2$ = "" : GUI.OKCANCEL = 0 : GUI.HINT$ = ""
  GUI.MSG$ = ED.PROMPT.MSG$
  GOSUB GUI.YN
  ED.YN = GUI.ANSWER
  RETURN




REM ============================================================================
REM MESSAGES
REM ============================================================================
ED.INFO.MSG:
  ED.LAST.MSG$ = ED.MSG$
  IF ED.QUIET = 1 THEN RETURN
  ED.PS.ROW = SCREEN.ROWS - 1 : ED.PS.COL = 0 : ED.PS.WIDTH = SCREEN.COLS
  ED.PS$ = " " + ED.MSG$ : ED.PS.ATTR = THEME.CLR(THEME.TITLE) : GOSUB ED.PUT.FIELD
  RETURN

ED.ERR.MSG:
  ED.LAST.MSG$ = ED.MSG$
  IF ED.QUIET = 1 THEN RETURN
  ED.PS.ROW = SCREEN.ROWS - 1 : ED.PS.COL = 0 : ED.PS.WIDTH = SCREEN.COLS
  ED.PS$ = " " + ED.MSG$ : ED.PS.ATTR = THEME.CLR(THEME.WARN) : GOSUB ED.PUT.FIELD
  RETURN


REM ============================================================================
REM RENDERING
REM ============================================================================
ED.REFRESH.FULL:
  IF ED.QUIET = 1 THEN RETURN
  GOSUB ED.ENSURE.VISIBLE
  GOSUB ED.RENDER.ALL
  RETURN
ED.REFRESH.INTRA:
  IF ED.QUIET = 1 THEN RETURN
  GOSUB ED.ENSURE.VISIBLE
  IF ED.SCROLLED = 1 THEN GOSUB ED.DO.SCROLL : RETURN
  ED.SCREEN.ROW = ED.CUR.ROW - ED.TOP.LINE + 1
  ED.DOC.LINE = ED.CUR.ROW
  GOSUB ED.RENDER.ROW
  GOSUB ED.PLACE.CARET
  GOSUB ED.RENDER.STATUS
  RETURN

REM Cheap cursor move (no content change): restore the old caret cell, and if the view
REM did not scroll just invert the new cell + repaint the status line. Touches ~2 cells
REM instead of the whole screen. Only an actual scroll falls back to a full repaint.
ED.CARET.REFRESH:
  IF ED.QUIET = 1 THEN RETURN
  GOSUB ED.UNCARET
  GOSUB ED.ENSURE.VISIBLE
  IF ED.SCROLLED = 1 THEN GOSUB ED.DO.SCROLL : RETURN
  GOSUB ED.PLACE.CARET
  GOSUB ED.RENDER.STATUS
  RETURN

ED.ENSURE.VISIBLE:
  ED.SCROLLED = 0 : ED.HSCROLLED = 0 : ED.EV.OLDTOP = ED.TOP.LINE
  IF ED.CUR.ROW < ED.TOP.LINE THEN ED.TOP.LINE = ED.CUR.ROW
  IF ED.CUR.ROW > ED.TOP.LINE + ED.TEXT.ROWS - 1 THEN ED.TOP.LINE = ED.CUR.ROW - ED.TEXT.ROWS + 1
  IF ED.CUR.COL < ED.LEFT.COL THEN ED.LEFT.COL = ED.CUR.COL : ED.HSCROLLED = 1
  IF ED.CUR.COL > ED.LEFT.COL + ED.TEXT.WIDTH - 1 THEN ED.LEFT.COL = ED.CUR.COL - ED.TEXT.WIDTH + 1 : ED.HSCROLLED = 1
  ED.VDELTA = ED.TOP.LINE - ED.EV.OLDTOP
  IF ED.VDELTA <> 0 THEN ED.SCROLLED = 1
  IF ED.HSCROLLED = 1 THEN ED.SCROLLED = 1
  RETURN

REM A view change (ED.SCROLLED=1) is served by hardware VERA VSCROLL when it is a single
REM text-row vertical move with no horizontal scroll: bump L1_VSCROLL by one text row and
REM repaint only the menu bar (it must stay put on screen while the map slides under it),
REM the one newly-exposed text row, and the status bar -- 3 rows, not ~28. Everything else
REM (a multi-line jump from PageUp/Down/GoTo/Find, or any horizontal scroll) is a full
REM repaint at the current map offset. The newly-exposed row is always the current row in
REM a cursor-move scroll, so ED.RENDER.ROW streams it live from ED.CUR.LINE$.
ED.DO.SCROLL:
  IF ED.HW.OK = 0 THEN GOSUB ED.RENDER.ALL : RETURN
  IF ED.HSCROLLED = 1 THEN GOSUB ED.RENDER.ALL : RETURN
  IF ED.VDELTA = 1 THEN GOSUB ED.HW.SCROLL.DOWN : RETURN
  IF ED.VDELTA = 0 - 1 THEN GOSUB ED.HW.SCROLL.UP : RETURN
  GOSUB ED.RENDER.ALL
  RETURN

REM scroll down one line: content slides up, a new line appears at the bottom text row.
ED.HW.SCROLL.DOWN:
  ED.MAP.TOP = ED.MAP.TOP + 1
  IF ED.MAP.TOP > ED.MAP.MAXTOP THEN ED.MAP.TOP = 0 : GOSUB ED.SET.VSCROLL : GOSUB ED.RENDER.ALL : RETURN
  GOSUB ED.SET.VSCROLL
  GOSUB ED.RENDER.MENUBAR
  ED.SCREEN.ROW = ED.TEXT.BOTTOM : ED.DOC.LINE = ED.TOP.LINE + ED.SCREEN.ROW - 1 : GOSUB ED.RENDER.ROW
  GOSUB ED.RENDER.STATUS
  GOSUB ED.PLACE.CARET
  RETURN

REM scroll up one line: content slides down, a new line appears at the top text row (1).
ED.HW.SCROLL.UP:
  ED.MAP.TOP = ED.MAP.TOP - 1
  IF ED.MAP.TOP < 0 THEN ED.MAP.TOP = ED.MAP.MAXTOP : GOSUB ED.SET.VSCROLL : GOSUB ED.RENDER.ALL : RETURN
  GOSUB ED.SET.VSCROLL
  GOSUB ED.RENDER.MENUBAR
  ED.SCREEN.ROW = 1 : ED.DOC.LINE = ED.TOP.LINE + ED.SCREEN.ROW - 1 : GOSUB ED.RENDER.ROW
  GOSUB ED.RENDER.STATUS
  GOSUB ED.PLACE.CARET
  RETURN

ED.SET.VSCROLL:
  ED.VSP = ED.MAP.TOP * 8
  POKE 40761, ED.VSP - INT(ED.VSP / 256) * 256 : REM $9F39 L1 VSCROLL (7:0)
  POKE 40762, INT(ED.VSP / 256)                : REM $9F3A L1 VSCROLL (11:8)
  RETURN

ED.RENDER.ALL:
  GOSUB ED.RENDER.MENUBAR
  FOR ED.SCREEN.ROW = 1 TO ED.TEXT.BOTTOM
    ED.DOC.LINE = ED.TOP.LINE + ED.SCREEN.ROW - 1
    GOSUB ED.RENDER.ROW
  NEXT ED.SCREEN.ROW
  GOSUB ED.RENDER.STATUS
  GOSUB ED.PLACE.CARET
  RETURN

REM Rows render through ONE inline-assembly block: VERA setup, the cell loop, teardown.
REM
REM WHY IT IS ASSEMBLY. The VERA path here was already the fast one and the loop around it
REM was still the whole cost: two POKEs a cell, each a push-address / push-value / dispatch
REM / bank-save-restore through the p-code VM -- about 800 cycles a cell against the ~20 the
REM same compare-load-store takes native. That is the gap this block closes, and it closes
REM it without leaving BASIC: GP.ASM assembles into the program and costs no runtime bytes.
REM (The editor is GP-BASIC IN, but not because of this -- see the note at the top of the file.)
REM
REM THE VERA METHOD IS UNCHANGED -- it was never the problem. FX 32-bit cache write, so one
REM DATA0 write flushes 4 VRAM bytes = 2 text cells [char,attr,char,attr]. Every cell in a
REM row carries the same attribute, so it is loaded into the cache's two attr slots ONCE and
REM the loop writes only the two char slots plus one flush. Address increment is +4 so DATA0
REM walks two cells per flush, and ED.TEXT.WIDTH is even.
REM
REM FX regs: $9F25 CTRL bits 6:1 = DCSEL; DCSEL 2 -> FX_CTRL $9F29 bit 6 cache-write-enable;
REM DCSEL 6 -> FX_CACHE L/M/H/U $9F29-2C = [char0, attr0, char1, attr1].
REM
REM THE SOURCE IS ONE OF THREE THINGS, and ED.ASM.MODE% tells the block which:
REM   a stored line    MODE 0, ED.ASM.SRC% is its address in the $A000 window (BANK is set)
REM   the edited line  MODE 1, read out of ED.CUR.LINE$ itself, past its 3-byte header
REM   past the end     MODE 0 with ED.ASM.VIS% = 0 -- every cell is a space, and the source
REM                    address is never dereferenced, so what it holds does not matter
ED.RENDER.ROW:
  ED.ASM.BASE% = 45056 + (ED.SCREEN.ROW + ED.MAP.TOP) * 256
  ED.ASM.ATTR% = ED.ATTR.TEXT
  ED.ASM.WIDTH% = ED.TEXT.WIDTH
  ED.ASM.MODE% = 0 : ED.ASM.VIS% = 0
  IF ED.DOC.LINE >= LINE.COUNT THEN GOTO ED.ROW.STREAM
  IF ED.DOC.LINE = ED.CUR.ROW THEN GOTO ED.ROW.LIVE
  LINE.INDEX = ED.DOC.LINE : GOSUB DOC.SLOT.READ
  BANK DOC.GOT.BANK
  ED.VIS = PEEK(DOC.GOT.OFF) - ED.LEFT.COL : REM visible chars after horizontal scroll
  IF ED.VIS > 0 THEN ED.ASM.VIS% = ED.VIS
  ED.ASM.SRC% = DOC.GOT.OFF + 1 + ED.LEFT.COL
  GOTO ED.ROW.STREAM
ED.ROW.LIVE:
  ED.ASM.MODE% = 1
  ED.VIS = LEN(ED.CUR.LINE$) - ED.LEFT.COL
  IF ED.VIS > 0 THEN ED.ASM.VIS% = ED.VIS
  ED.ASM.OFS% = 3 + ED.LEFT.COL : REM past [MaxLen][control][ActLen] to the text
ED.ROW.STREAM:
  #REM 1
  GP.ASM
  REM ; ---- VERA: address, +4 increment, FX cache write on, both attribute slots ----
  REM LDA {ED.ASM.BASE%}
  REM STA $9F20
  REM LDX #1
  REM LDA {ED.ASM.BASE%},X
  REM STA $9F21
  REM LDA #49                  ; bank 1, address increment +4 = two cells a flush
  REM STA $9F22
  REM LDA #4                   ; DCSEL 2
  REM STA $9F25
  REM LDA #64                  ; FX_CTRL: cache write enable
  REM STA $9F29
  REM LDA #12                  ; DCSEL 6 -- the cache itself
  REM STA $9F25
  REM LDA {ED.ASM.ATTR%}
  REM STA $9F2A                ; attr0
  REM STA $9F2C                ; attr1
  REM ; ---- aim the two fetches at the source, whichever kind of source it is ----
  REM ; There is no expression syntax, so the address goes INTO the operand of the LDA
  REM ; that reads it: STA RGA,X with X=1 patches the low byte, X=2 the high one.
  REM LDA {ED.ASM.MODE%}
  REM BNE RSTR
  REM LDA {ED.ASM.SRC%}        ; the banked store: already a plain address
  REM LDX #1
  REM STA RGA,X
  REM STA RGB,X
  REM LDA {ED.ASM.SRC%},X
  REM BRA RHI
  REM RSTR: CLC                ; ED.CUR.LINE$: the slot holds the block address...
  REM LDA {ED.CUR.LINE$}
  REM ADC {ED.ASM.OFS%}        ; ...and the text starts 3 bytes into the block
  REM LDX #1
  REM STA RGA,X
  REM STA RGB,X
  REM LDA {ED.CUR.LINE$},X
  REM ADC #0
  REM RHI: LDX #2
  REM STA RGA,X
  REM STA RGB,X
  REM ; ---- two cells a pass: char0, char1, one flush ----
  REM LDY #0
  REM RLP: CPY {ED.ASM.VIS%}
  REM BCS RSP1
  REM RGA: LDA $FFFF,Y         ; operand patched above
  REM BRA RPUT1
  REM RSP1: LDA #32
  REM RPUT1: STA $9F29
  REM INY
  REM CPY {ED.ASM.VIS%}
  REM BCS RSP2
  REM RGB: LDA $FFFF,Y         ; operand patched above
  REM BRA RPUT2
  REM RSP2: LDA #32
  REM RPUT2: STA $9F2B
  REM STZ $9F23                ; flush the cache: two cells written
  REM INY
  REM CPY {ED.ASM.WIDTH%}
  REM BCC RLP
  REM ; ---- FX off and DCSEL back to 0, so ordinary VERA writes work again ----
  REM LDA #4
  REM STA $9F25
  REM STZ $9F29
  REM STZ $9F25
  GP.ENDASM
  #REM 0
  RETURN

REM Caret = one inverted attribute cell. Remember the exact cell so a plain cursor move
REM can restore it (ED.UNCARET) instead of repainting the whole screen.
ED.PLACE.CARET:
  ED.CARET.SROW = ED.CUR.ROW - ED.TOP.LINE + 1
  ED.CARET.SCOL = ED.CUR.COL - ED.LEFT.COL
  ED.CARET.VALID = 0
  IF ED.CARET.SROW < 1 OR ED.CARET.SROW > ED.TEXT.BOTTOM THEN RETURN
  IF ED.CARET.SCOL < 0 OR ED.CARET.SCOL >= ED.TEXT.WIDTH THEN RETURN
  ED.CARET.ADDR = 45056 + (ED.CARET.SROW + ED.MAP.TOP) * 256 + ED.CARET.SCOL * 2 + 1
  VPOKE 1, ED.CARET.ADDR, ED.ATTR.CARET
  ED.CARET.VALID = 1
  RETURN

ED.UNCARET:
  IF ED.CARET.VALID = 0 THEN RETURN
  VPOKE 1, ED.CARET.ADDR, ED.ATTR.TEXT
  ED.CARET.VALID = 0
  RETURN


REM ---- menu bar (VERA row 0). Attr = bg*16+fg: white-on-blue bar = 97,
REM ---- yellow accelerator = 103, active title (blue-on-white) = 22. ----
REM DRAWN BY MENUBAR.INC.BL. What is left here is the two things that are the EDITOR's
REM and not a menu's: the full width band the titles sit on, and the document name at the
REM right hand end.
REM
REM MENUBAR.Y IS A MAP ROW. GP.FILL and GP.PRINTAT, which MENUBAR reaches through
REM MENUHELP.ROW, write at map row = whatever Y they are given, and the text layer is
REM hardware scrolled -- so screen row 0 is map row ED.MAP.TOP. ED.MENU.BAR.ITEMS sets it.
REM Same correction ED.PUT.FIELD, ED.RENDER.ROW, the caret and the dropdown all make.
REM
REM MENUBAR.MARK, not a second painting pass: MENUBAR.DRAW lays every title down in the
REM normal attribute and MARK puts the highlight on MENUBAR.SEL. With no menu open there
REM is nothing to mark, which is what MENU.ACTIVE < 0 means.
ED.RENDER.MENUBAR:
  ED.PS.ROW = 0 : ED.PS.COL = 0 : ED.PS.WIDTH = SCREEN.COLS
  ED.PS$ = "" : ED.PS.ATTR = THEME.CLR(THEME.TITLE) : GOSUB ED.PUT.FIELD
  GOSUB ED.MENU.BAR.ITEMS
  GOSUB MENUBAR.DRAW
  IF MENU.ACTIVE >= 0 THEN MENUBAR.SEL = MENU.ACTIVE + 1 : GOSUB MENUBAR.MARK
  ED.NAME$ = DOC.FILE.NAME$
  IF ED.DOC.DIRTY = 1 THEN ED.NAME$ = ED.NAME$ + " *"
  ED.NCOL = SCREEN.COLS - LEN(ED.NAME$) - 1
  IF ED.NCOL > 1 THEN ED.PS.ROW = 0 : ED.PS.COL = ED.NCOL - 1 : ED.PS.WIDTH = LEN(ED.NAME$) : ED.PS$ = ED.NAME$ : ED.PS.ATTR = THEME.CLR(THEME.TITLE) : GOSUB ED.PUT.FIELD
  RETURN


REM ED.DRAW.MENU.TITLE has gone the same way as MENU.COL. It painted one title in two
REM pieces to get the accelerator letter in its own colour, and that is MENUHELP.ROW's
REM hotkey tint -- MENU.HOT$ names the letters, MENUHELP.HOTATTR is the colour, and the
REM highlighted title is left alone by the same rule it always was.



REM ---- dropdown (VERA rows 1..). normal item = black-on-grey 240,
REM ---- selected = white-on-blue 97. ----
REM ED.DRAW.DROPDOWN -- the panel, now with a frame and drawn by the library.
REM
REM MENUHELP.ROW draws one row: GP.FILL for the background, GP.PRINTAT for the text.
REM Both are GP drawing commands, so both need the ISO flag ED.INIT sets -- without it
REM GP.PRINTAT would convert ASCII text as though it were PETSCII and every letter
REM would come out in the wrong case.
REM
REM THE FRAME IS GP.BOX STYLE 0, and the style is not a free choice. Styles 2 to 4 draw
REM with line glyphs from screen codes $40-$7F, and that is exactly the run ED.PETFONT
REM overwrites with ASCII lower case -- a single-line box comes out as "p @ @ ... B".
REM Style 0 borders with $A0 alone, which sits outside that run and survives untouched.
REM $A0 is a reverse space, so it paints in the FOREGROUND colour: THEME.TEXT gives a
REM black edge around the light grey panel.
REM WHERE IT HANGS FROM IS MENUBAR'S ANSWER NOW. MENUBAR.WHERE walks the item text to
REM the left of MENUBAR.SEL and leaves the column in MENUBAR.SELX -- the same running sum
REM the deleted MENU.COL table used to hold. The panel starts one cell IN from the item's
REM left edge, which is what lines the item text up under the title text: both are a
REM leading space wide.
REM
REM ED.MENU.BAR.ITEMS first, because MENUBAR.COLUMN measures MENUHELP.ITEM$ and this
REM routine is about to fill that same array with the dropdown's items.
ED.DRAW.DROPDOWN:
  ED.DD.N = MENU.ITEMS(MENU.ACTIVE)
  GOSUB ED.MENU.BAR.ITEMS
  MENUBAR.SEL = MENU.ACTIVE + 1 : GOSUB MENUBAR.WHERE
  ED.DD.COL = MENUBAR.SELX + 1
  ED.DD.W = MENU.WIDTH(MENU.ACTIVE)

  ED.DD.BX = ED.DD.COL - 1
  IF ED.DD.BX < 0 THEN ED.DD.BX = 0
  REM The frame is $A0, a REVERSE space, so only the attribute's LOW nibble shows -- and
  REM THEME.TEXT's low nibble is the document's own foreground, white. That reads against
  REM both the light grey panel and the black text area, which is what the two earlier
  REM tries (PAGE whole, then PAGE's high nibble) each failed to do.
  REM EVERY Y HERE IS A MAP ROW, NOT A SCREEN ROW, and that is the whole reason this
  REM looked wrong. The text layer is hardware-scrolled with VERA's L1_VSCROLL, so screen
  REM row R lives at MAP row R + ED.MAP.TOP -- which is why ED.PUT.FIELD, ED.RENDER.ROW
  REM and the caret all add it. GP.BOX, GP.FILL and GP.PRINTAT know nothing about the
  REM editor's scroll: they write at map row = whatever Y they are given. So the offset
  REM has to be added HERE, or the whole panel is drawn ED.MAP.TOP rows away from the
  REM menu bar it hangs from -- invisible at the top of the document, and further adrift
  REM the further down you have scrolled.
  ED.DD.FW = ED.DD.W + 2 : ED.DD.FH = ED.DD.N + 2
  ED.DD.TY = 1 + ED.MAP.TOP : ED.DD.BY = ED.DD.TY + ED.DD.FH - 1
  ED.DD.RX = ED.DD.BX + ED.DD.FW - 1
  ED.DD.FC = THEME.CLR(THEME.TEXT)
  REM GUI.FRAME, not GP.BOX, and no longer eight GP.FILLs written out here. GP.BOX
  REM picks its glyphs from a table in the RUNTIME, so it can only ever draw the six
  REM styles that table holds -- and five of the six are built from screen codes this
  REM font no longer has. The eight fills that replaced it now live in GUI.INC.BL,
  REM told the same six glyphs by ED.GUI.SETUP, so the program has ONE frame drawer
  REM where it had a library's and a copy. ED.DD.RX and ED.DD.BY are computed above
  REM exactly as GUI.FRAME computes GUI.RIGHT and GUI.BOTTOM, so it is the same rectangle
  REM either way. Setting GUI.BORDER here does not disturb a later dialog: GUI.OPEN
  REM settles it again from GUI.BORDER.IN on every call.
  GUI.LEFT = ED.DD.BX : GUI.TOP = ED.DD.TY
  GUI.WIDTH = ED.DD.FW  : GUI.HEIGHT = ED.DD.FH
  GUI.BORDER = ED.DD.FC
  GOSUB GUI.FRAME

  REM DRIVEN THE WAY MENUDEMO.EXP.BL DRIVES IT, which is the whole interface and not
  REM three fields of it. This used to set X, Y and WIDTH only and then hand-roll a loop
  REM over MENUHELP.ROW -- the module's LOWEST entry point -- leaving COUNT, ATTR and
  REM HIATTR at zero. MENUHELP.ROW reads MENUHELP.ATTR itself (it is the test that
  REM decides whether a row gets its hotkey tinted), so a caller that never sets it is
  REM not calling the routine, it is guessing at it. Set the documented inputs and let
  REM MENUHELP.DRAW walk the rows, exactly as MENUHELP.RUN does.
  MENUHELP.X = ED.DD.COL
  MENUHELP.Y = 2 + ED.MAP.TOP : REM a map row, as above
  MENUHELP.WIDTH = ED.DD.W : MENUHELP.COUNT = ED.DD.N
  REM The panel is the DOCUMENT's own attribute, not a page colour of its own: white on
  REM black, the same as the text behind it, so the dropdown reads as a framed hole in the
  REM document rather than a grey card laid on top. The frame is that attribute too, and
  REM only the selected row breaks it -- which is the whole point of a highlight bar.
  MENUHELP.ATTR    = THEME.CLR(THEME.TEXT)
  MENUHELP.HIATTR  = THEME.CLR(THEME.TITLE)
  MENUHELP.HOTATTR = 0 : REM no hotkey tint: ALT+letter opens a MENU, not an item
  REM MENUHELP.ITEM$ is 1 based and MENU.SEL is 0 based, because the menu bar indexes
  REM its flat MENU.ITEM$ table from 0. Convert once, here, rather than at each use.
  FOR ED.DD.I = 1 TO ED.DD.N
    MENUHELP.ITEM$(ED.DD.I) = " " + MENU.ITEM$(MENU.ACTIVE * 8 + ED.DD.I - 1)
  NEXT ED.DD.I
  GOSUB MENUHELP.DRAW
  MENUHELP.DRAWROW = MENU.SEL + 1 : MENUHELP.DRAWATTR = MENUHELP.HIATTR
  GOSUB MENUHELP.ROW
  RETURN

ED.RENDER.STATUS:
  ED.MARK$ = "   "
  IF ED.DOC.DIRTY = 1 THEN ED.MARK$ = " * "
  ED.MODE$ = "INS"
  IF ED.INSERT.MODE = 0 THEN ED.MODE$ = "OVR"
  ED.BAR$ = ED.MARK$ + "L" + MID$(STR$(ED.CUR.ROW + 1), 2) + " C" + MID$(STR$(ED.CUR.COL + 1), 2) + "  " + ED.MODE$ + "  LINES=" + MID$(STR$(LINE.COUNT), 2) + "   ESC=MENU (F/S/H)  F2=SAVE  F3=FIND"
  ED.PS.ROW = SCREEN.ROWS - 1 : ED.PS.COL = 0 : ED.PS.WIDTH = SCREEN.COLS
  ED.PS$ = ED.BAR$ : ED.PS.ATTR = THEME.CLR(THEME.TITLE) : GOSUB ED.PUT.FIELD
  RETURN

REM ---- write ED.PS$ into the VERA text map at 0-based (ED.PS.ROW, ED.PS.COL),
REM attribute byte ED.PS.ATTR (= bg*16 + fg), padding with spaces out to ED.PS.WIDTH
REM cells and truncating past it. No KERNAL PRINT, no O(n^2) padding.
REM
REM VERA AUTO-INCREMENT: the start address and a "+1" step are programmed ONCE, then
REM char,attr,char,attr,... stream to DATA0 ($9F23). Within a cell the char and attr
REM bytes are adjacent and consecutive cells follow, so +1 walks the whole field -- no
REM per-cell address arithmetic and no re-programming the address 160 times a row.
REM
REM Assembly for the same reason ED.RENDER.ROW is: this draws all the chrome, and it
REM runs on every keystroke (the status line) and every menu move. A width below 1
REM writes nothing, which is what the FOR loop it replaced did -- the block's test is
REM at the BOTTOM, so without the guard a width of 0 would write one cell.
ED.PUT.FIELD:
  IF ED.PS.WIDTH < 1 THEN RETURN
  ED.ASM.BASE% = 45056 + (ED.PS.ROW + ED.MAP.TOP) * 256 + ED.PS.COL * 2
  ED.ASM.ATTR% = ED.PS.ATTR
  ED.ASM.WIDTH% = ED.PS.WIDTH
  ED.ASM.VIS% = LEN(ED.PS$)
  #REM 1
  GP.ASM
  REM ; ---- VERA: address, +1 increment, ordinary (non-FX) writes ----
  REM LDA {ED.ASM.BASE%}
  REM STA $9F20
  REM LDX #1
  REM LDA {ED.ASM.BASE%},X
  REM STA $9F21
  REM LDA #17                  ; bank 1, address increment +1
  REM STA $9F22
  REM ; ---- aim the fetch at ED.PS$'s text, 3 bytes into its block ----
  REM CLC
  REM LDA {ED.PS$}
  REM ADC #3
  REM LDX #1
  REM STA FGA,X
  REM LDA {ED.PS$},X
  REM ADC #0
  REM LDX #2
  REM STA FGA,X
  REM ; ---- one cell a pass: char then attribute, both to DATA0 ----
  REM LDY #0
  REM FLP: CPY {ED.ASM.VIS%}
  REM BCS FSP
  REM FGA: LDA $FFFF,Y         ; operand patched above
  REM BRA FPUT
  REM FSP: LDA #32
  REM FPUT: STA $9F23          ; char -- VERA steps to the attribute byte
  REM LDA {ED.ASM.ATTR%}
  REM STA $9F23                ; attr -- VERA steps to the next cell
  REM INY
  REM CPY {ED.ASM.WIDTH%}
  REM BCC FLP
  GP.ENDASM
  #REM 0
  RETURN


REM ============================================================================
REM ============================================================================
REM ============================================================================
REM ============================================================================
REM ============================================================================
REM ============================================================================
REM ============================================================================






REM ============================================================================
REM HEADLESS SELF-CHECK (DEBUG.MODE=1): drive menu dispatch + commands.
REM ============================================================================
ED.SELFCHECK:
  ED.QUIET = 1
  ED.SIM.MODE = 1
  DOC.FILE.NAME$ = "TEST.MD" : GOSUB ED.OPEN.FILE

  REM go to line 3 (row 2)
  ED.SIM.INPUT$ = "3" : GOSUB ED.CMD.GOTO
  PRINT "GOTO ROW=";ED.CUR.ROW;" COL=";ED.CUR.COL

  REM find "bullet" (row 2), then find-next (row 3)
  ED.SIM.INPUT$ = "bullet" : GOSUB ED.CMD.FIND
  PRINT "FIND1 ROW=";ED.CUR.ROW;" COL=";ED.CUR.COL;" MSG=";ED.LAST.MSG$
  GOSUB ED.FIND.NEXT
  PRINT "FIND2 ROW=";ED.CUR.ROW;" COL=";ED.CUR.COL

  REM find "markdown" -- must wrap around to row 0, case-insensitive
  ED.SIM.INPUT$ = "markdown" : GOSUB ED.CMD.FIND
  PRINT "FINDM ROW=";ED.CUR.ROW;" COL=";ED.CUR.COL

  REM a miss
  ED.SIM.INPUT$ = "zzq" : GOSUB ED.CMD.FIND
  PRINT "FINDZ MSG=";ED.LAST.MSG$

  REM discard-confirm: decline blocks New, accept resets
  ED.DOC.DIRTY = 1 : ED.SIM.YN = 0
  GOSUB ED.CMD.NEW
  PRINT "DECLINE COUNT=";LINE.COUNT;" DIRTY=";ED.DOC.DIRTY
  ED.SIM.YN = 1
  GOSUB ED.CMD.NEW
  PRINT "ACCEPT COUNT=";LINE.COUNT;" NAME=";DOC.FILE.NAME$

  REM ---- verify chrome (char+attr) + text render + the O(1) caret ----
  ED.QUIET = 0
  PRINT "DIM ";SCREEN.COLS;"x";SCREEN.ROWS
  REM ---- what ED.ALTKEYS actually found in the layout. ALT+letter is the one path no
  REM ---- headless test can PRESS, but everything it depends on is readable right here:
  REM ---- which tables exist, which two were picked, and how many keys got rewritten.
  PRINT "ALTKEYS N=";ED.NALT;" PLAIN=";ED.TPLAIN;" ALT=";ED.TALT
  ED.IDS$ = ""
  BANK 0
  FOR ED.TI = 0 TO 10
    ED.IDS$ = ED.IDS$ + STR$(PEEK(40960 + 128 * ED.TI))
  NEXT ED.TI
  PRINT "TABLE IDS";ED.IDS$
  MENU.ACTIVE = 0 - 1 : GOSUB ED.RENDER.MENUBAR
  PRINT "MB CH=";VPEEK(1, 45058);" AT=";VPEEK(1, 45059)
  MENU.ACTIVE = 0 : MENU.SEL = 0 : GOSUB ED.DRAW.DROPDOWN
  PRINT "DD CH=";VPEEK(1, 45572);" AT=";VPEEK(1, 45573) : REM row 2 now: the frame took row 1
  REM DROPDOWN GEOMETRY, and ONE SAMPLED CELL IS NOT A TEST OF IT. The panel shipped with
  REM the wrong HEIGHT and rows missing, and the line above was green throughout, because
  REM the one cell it looks at happened to be right. Walk the whole panel instead: the
  REM frame row, every item row, and the frame row under them, reading the first LETTER of
  REM each item. File is New Open Save "Save As" Exit, so column ED.DD.COL + 1 -- the item
  REM text starts a cell left of it, at MENUHELP.X, because every item is " "+name -- down rows
  REM 1..7 must read 192 78 79 83 83 69 192 -- the horizontal, N O S S E, horizontal. A short
  REM panel, a skipped row or a frame in the wrong place all move at least one of those.
  ED.DDS$ = ""
  FOR ED.QR = 1 TO MENU.ITEMS(0) + 2
    ED.DDS$ = ED.DDS$ + STR$(VPEEK(1, 45056 + ED.QR * 256 + (ED.DD.COL + 1) * 2))
  NEXT ED.QR
  PRINT "DDROWS";ED.DDS$
  ED.MSG$ = "HELLO" : GOSUB ED.INFO.MSG
  ED.SR = SCREEN.ROWS - 1
  PRINT "MSG CH=";VPEEK(1, 45056 + ED.SR * 256 + 2);" AT=";VPEEK(1, 45056 + ED.SR * 256 + 3)
  REM REAL repaint path: open a file (full RENDER.ALL), drop the caret, sample clean cells.
  REM Every text cell must be char + ED.ATTR.TEXT(1) -- content rows AND blank rows.
  DOC.FILE.NAME$ = "TEST.MD" : GOSUB ED.OPEN.FILE
  GOSUB ED.UNCARET
  PRINT "TR CH=";VPEEK(1, 45312);" AT=";VPEEK(1, 45313)
  PRINT "TR2 CH=";VPEEK(1, 45568);" AT=";VPEEK(1, 45569)
  PRINT "A10 AT=";VPEEK(1, 45056 + 10 * 256 + 41)
  PRINT "A20 AT=";VPEEK(1, 45056 + 20 * 256 + 61)
  REM caret place/restore (the O(1) cursor-move primitive)
  ED.CUR.ROW = 0 : ED.CUR.COL = 0 : ED.TOP.LINE = 0 : ED.LEFT.COL = 0
  GOSUB ED.PLACE.CARET : PRINT "CARET AT=";VPEEK(1, 45313)
  GOSUB ED.UNCARET : PRINT "UNCARET AT=";VPEEK(1, 45313)

  REM ---- hardware VSCROLL: register writes + map-offset render + rewind bound ----
  PRINT "MAPH=";ED.MAP.H;" MAXTOP=";ED.MAP.MAXTOP;" HWOK=";ED.HW.OK
  ED.TOP.LINE = 1 : ED.LEFT.COL = 0 : ED.CUR.ROW = 1 : ED.CUR.COL = 0
  ED.MAP.TOP = 0 : GOSUB ED.SET.VSCROLL
  GOSUB ED.HW.SCROLL.DOWN
  REM after +1: VSCROLL = 8, MAP.TOP = 1, menu bar re-drawn at map row 1 ('F' = 70)
  PRINT "HWD TOP=";ED.MAP.TOP;" VSL=";PEEK(40761);" VSH=";PEEK(40762)
  PRINT "HWD MB=";VPEEK(1, 45056 + ED.MAP.TOP * 256 + 2)
  GOSUB ED.HW.SCROLL.UP
  REM back to 0: VSCROLL = 0, menu bar at map row 0 ('F' = 70)
  PRINT "HWU TOP=";ED.MAP.TOP;" VSL=";PEEK(40761)
  PRINT "HWU MB=";VPEEK(1, 45058)
  REM at the bottom bound a +1 scroll rewinds to 0 (never crosses the map edge)
  ED.MAP.TOP = ED.MAP.MAXTOP : GOSUB ED.SET.VSCROLL
  GOSUB ED.HW.SCROLL.DOWN
  PRINT "HWREW TOP=";ED.MAP.TOP;" VSL=";PEEK(40761)
  ED.MAP.TOP = 0 : GOSUB ED.SET.VSCROLL

  REM ---- end-to-end: build a tall doc, walk the cursor down through several
  REM      hardware scrolls, then confirm the visible map window holds the right
  REM      document lines at exactly the map rows VSCROLL is displaying. ----
  ED.QUIET = 0
  GOSUB DOC.INIT
  FOR ED.T = 0 TO 39
    LINE.TEXT$ = "L" + MID$(STR$(ED.T), 2) : GOSUB DOC.PUSH.LINE
  NEXT ED.T
  ED.TOP.LINE = 0 : ED.LEFT.COL = 0 : ED.CUR.ROW = 0 : ED.CUR.COL = 0
  ED.MAP.TOP = 0 : GOSUB ED.SET.VSCROLL
  GOSUB ED.LOAD.LIVE : GOSUB ED.RENDER.ALL
  FOR ED.T = 1 TO 35
    GOSUB ED.MOVE.DOWN
  NEXT ED.T
  PRINT "WALK CUR=";ED.CUR.ROW;" TOP=";ED.TOP.LINE;" MAPTOP=";ED.MAP.TOP;" VSL=";PEEK(40761)
  ED.MR = 1 + ED.MAP.TOP
  PRINT "WTOP DOC=";ED.TOP.LINE;" MAPCH=";VPEEK(1, 45056 + ED.MR * 256);VPEEK(1, 45056 + ED.MR * 256 + 2)
  ED.MR = ED.TEXT.BOTTOM + ED.MAP.TOP
  ED.BL = ED.TOP.LINE + ED.TEXT.BOTTOM - 1
  PRINT "WBOT DOC=";ED.BL;" MAPCH=";VPEEK(1, 45056 + ED.MR * 256);VPEEK(1, 45056 + ED.MR * 256 + 2)
  ED.MAP.TOP = 0 : GOSUB ED.SET.VSCROLL
  ED.QUIET = 1 : MENU.ACTIVE = 0 - 1

  REM ---- key dispatch: drive the REAL GP.SELECT table with real key codes ----
  REM ED.QUIET is already 1, so the model runs and the render does not -- the render
  REM is verified above. 27 (menu) and 137 (save) are left out on purpose: one blocks
  REM on GET and the other writes a file.
  ED.CUR.ROW = 10 : ED.CUR.COL = 0 : ED.TOP.LINE = 0 : ED.LEFT.COL = 0
  GOSUB ED.LOAD.LIVE
  ED.KEY = 17 : GOSUB ED.DISPATCH.KEY
  ED.KEY = 29 : GOSUB ED.DISPATCH.KEY
  PRINT "KEY DOWN+RIGHT ROW=";ED.CUR.ROW;" COL=";ED.CUR.COL
  ED.KEY = 145 : GOSUB ED.DISPATCH.KEY
  ED.KEY = 157 : GOSUB ED.DISPATCH.KEY
  PRINT "KEY UP+LEFT ROW=";ED.CUR.ROW;" COL=";ED.CUR.COL
  ED.KEY = 4 : GOSUB ED.DISPATCH.KEY
  PRINT "KEY END COL=";ED.CUR.COL;" LINE=";ED.CUR.LINE$
  ED.KEY = 19 : GOSUB ED.DISPATCH.KEY
  PRINT "KEY HOME COL=";ED.CUR.COL
  ED.KEY = 148 : GOSUB ED.DISPATCH.KEY
  PRINT "KEY INS MODE=";ED.INSERT.MODE
  ED.KEY = 148 : GOSUB ED.DISPATCH.KEY
  REM 65 is not a case: it reaches ED.DO.INSERT through GP.OTHER and the 32..126 range
  ED.KEY = 65 : GOSUB ED.DISPATCH.KEY
  PRINT "KEY OTHER-RANGE LINE=";ED.CUR.LINE$;" COL=";ED.CUR.COL
  ED.KEY = 20 : GOSUB ED.DISPATCH.KEY
  PRINT "KEY BACKSPACE LINE=";ED.CUR.LINE$;" COL=";ED.CUR.COL
  REM 1 matches no case and falls outside both ranges: GP.OTHER must do nothing
  ED.KEY = 1 : GOSUB ED.DISPATCH.KEY
  PRINT "KEY UNBOUND ROW=";ED.CUR.ROW;" COL=";ED.CUR.COL;" LINE=";ED.CUR.LINE$

  REM 400 selects back to back. GP.ENDSEL is what releases the selector's frame, so
  REM a case that jumped out instead of falling through would leak one per pass and
  REM this is where it would show -- the frame stack is finite.
  FOR ED.T = 1 TO 200
    ED.KEY = 17 : GOSUB ED.DISPATCH.KEY
    ED.KEY = 145 : GOSUB ED.DISPATCH.KEY
  NEXT ED.T
  PRINT "KEY 400 SELECTS ROW=";ED.CUR.ROW;" COL=";ED.CUR.COL

  REM ---- the MENU's loop, 600 opens. The 400 above exercise ED.DISPATCH.KEY; this is
  REM ---- the other one, and since the dropdown's loop moved into the library it is
  REM ---- MENUHELP.RUN's select being driven 600 times -- through ED.MENU.OPEN, which
  REM ---- re-enters it once per keystroke it hands back rather than once per open.
  REM ---- 600 is chosen against the 4 KB stack: a leaked GOSUB and GP.DO is 17 bytes and
  REM ---- would blow it after ~240. So a leak here CANNOT reach the PRINT below, which
  REM ---- is the point of the count -- what leaks is invisible on screen.
  REM ----
  REM ---- The keys go in through the KERNAL's kbdbuf_put, because ED.OPEN.MENUBAR waits
  REM ---- on GET and nothing headless can satisfy that otherwise -- the same harness
  REM ---- MENUTST.EXP.BL uses to drive MENUHELP. 27 cancels; 13 chooses, and MENU.ACTIVE
  REM ---- 2 is Help, whose one item is About, so the choosing path runs a real
  REM ---- ED.MENU.DISPATCH without going near a file.
  ED.QUIET = 1
  FOR ED.QI = 1 TO 600
    MENU.ACTIVE = 2 : MENU.SEL = 0
    ED.QK = 27
    IF ED.QI - INT(ED.QI / 2) * 2 = 0 THEN ED.QK = 13
    POKE 1, 0 : GP.CALL ED.KBDBUF, ED.QK : POKE 1, 4
    GOSUB ED.OPEN.MENUBAR
  NEXT ED.QI
  PRINT "MENU 600 OPENS MSG=";ED.LAST.MSG$

  REM ---- a LETTER opens its menu. ALT+letter cannot do this any more (ISO mode sends
  REM ---- ISO-8859-15, not the PETSCII Commodore codes ED.KEY.RANGE tests for), so this
  REM ---- is the only way in and it needs a test. Open on File, press H, press RETURN:
  REM ---- the letter must have moved the bar to Help, so MENU.CHOICE.MENU is 2. Without
  REM ---- it the H is swallowed and RETURN chooses File's first item, and this reads 0.
  ED.DOC.DIRTY = 0 : MENU.ACTIVE = 0 : MENU.SEL = 0
  ED.QK = 72 : POKE 1, 0 : GP.CALL ED.KBDBUF, ED.QK : POKE 1, 4
  ED.QK = 13 : POKE 1, 0 : GP.CALL ED.KBDBUF, ED.QK : POKE 1, 4
  GOSUB ED.OPEN.MENUBAR
  PRINT "MENU LETTER H -> ";MENU.CHOICE.MENU;" (want 2)"

  REM ============================================================================
  REM ---- GUI.INC.BL, driven for real ----
  REM
  REM Nothing above this line touches a dialog: ED.PROMPT and ED.PROMPT.YN both
  REM short-circuit on ED.SIM.MODE, which is exactly what makes the rest of the
  REM self-check fast and exactly what makes it blind to the library. So SIM goes
  REM OFF here and the keys go in through kbdbuf_put, the same way the 600 menu
  REM opens above are driven. These are the four things that could be wrong, and
  REM none of them shows up as a compile error:
  REM
  REM   the frame drawn from GP.BOX's table instead of ours -- a box of letters;
  REM   the box centred on the SCREEN while we draw on a SCROLLED map -- a box
  REM     somewhere else entirely, and correct-looking in a screenshot at rest;
  REM   the covered cells not put back -- a hole in the document;
  REM   the caret not moving -- typing that lands in the wrong order.
  ED.QUIET = 1 : ED.SIM.MODE = 0
  REM LONG lines, deliberately. The centred box lands around column 32, and the
  REM "L0".."L39" the tests above use are three characters wide -- so the rectangle it
  REM covers is blank document, and a restore that did nothing whatever would score an
  REM identical sum. Fill the width and the check has something to fail on.
  GOSUB DOC.INIT
  FOR ED.T = 0 TO 39
    LINE.TEXT$ = MID$(STR$(ED.T), 2) + " ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    GOSUB DOC.PUSH.LINE
  NEXT ED.T
  ED.TOP.LINE = 0 : ED.LEFT.COL = 0 : ED.CUR.ROW = 0 : ED.CUR.COL = 0
  ED.MAP.TOP = 0 : GOSUB ED.SET.VSCROLL
  ED.QUIET = 0 : GOSUB ED.LOAD.LIVE : GOSUB ED.RENDER.ALL

  REM ---- the frame. Open a box by hand, read its corner and its edges, close it.
  REM ---- ED.PETFONT parked the six line glyphs at $C0-$C5 = 192..197, and GP.FILL
  REM ---- adds $40 to what it is given, so ED.GL.H(128) must show as tile 192,
  REM ---- ED.GL.V(129) as 193 and ED.GL.TL(130) as 194. Anything in the 64..125
  REM ---- range means GP.BOX drew it, and GP.BOX's glyphs are letters here.
  REM ---- READ THE MAP BEFORE PRINTING ANYTHING. PRINT goes through the KERNAL,
  REM ---- which SCROLLS the text map -- the same map every GP drawing command and
  REM ---- every VPEEK below addresses. A PRINT between the draw and the read moves
  REM ---- the picture out from under the read, and the first version of this test
  REM ---- did exactly that: adding one more PRINT line shifted the answer by one
  REM ---- row, which is how it was caught. So: repaint, draw, read into strings,
  REM ---- close, and only then say anything.
  GOSUB ED.RENDER.ALL
  GOSUB ED.GUI.WHERE
  GUI.TITLE$ = "" : GUI.MSG$ = "FRAME" : GUI.MSG2$ = ""
  GUI.BODY.ROWS = 1 : GUI.BODY.WIDTH = 10
  GOSUB GUI.OPEN
  ED.DDS$ = ""
  FOR ED.GX = 0 TO GUI.WIDTH - 1
    ED.DDS$ = ED.DDS$ + STR$(VPEEK(1, 45056 + GUI.TOP * 256 + (GUI.LEFT + ED.GX) * 2))
  NEXT ED.GX
  ED.DDS2$ = ""
  FOR ED.GR = 0 TO GUI.HEIGHT - 1
    ED.DDS2$ = ED.DDS2$ + STR$(VPEEK(1, 45056 + (GUI.TOP + ED.GR) * 256 + GUI.LEFT * 2))
  NEXT ED.GR
  GOSUB GUI.CLOSE
  PRINT "GUI BOX X=";GUI.LEFT;" Y=";GUI.TOP;" W=";GUI.WIDTH;" H=";GUI.HEIGHT;" STASH=";GUI.STASHED
  PRINT "GUI TOPROW";ED.DDS$
  PRINT "GUI TOPWANT 194 192 x14 195"
  PRINT "GUI LEFTCOL";ED.DDS2$
  PRINT "GUI LEFTWANT 194 193 x5 196"

  REM ---- the restore. Sum the char codes over the whole rectangle the box covers,
  REM ---- open and close a second box of the same size, and sum again. ONE SAMPLED
  REM ---- CELL IS NOT A TEST OF A PANEL -- that lesson cost a shipped dropdown with
  REM ---- rows missing -- so this walks every cell the dialog could have eaten. The
  REM ---- repaint first is what makes it mean anything: on a screen the PRINTs above
  REM ---- have scrolled to blank, "before" and "after" are equal whatever happens.
  GOSUB ED.RENDER.ALL
  GOSUB ED.GUI.SUM : ED.GWAS = ED.GSUM
  GOSUB GUI.OPEN : GOSUB GUI.CLOSE
  GOSUB ED.GUI.SUM : ED.GNOW = ED.GSUM
  PRINT "GUI RESTORE WAS=";ED.GWAS;" NOW=";ED.GNOW;" (want equal, and not 3584)"

  REM ---- the scrolled map. VSCROLL down four rows and the box must follow it: same
  REM ---- centred row, plus ED.MAP.TOP. Without GUI.ROW.OFFSET this comes back unchanged
  REM ---- and the dialog is drawn four rows off the top of what the user can see.
  ED.GBY = GUI.TOP
  ED.MAP.TOP = 4 : GOSUB ED.SET.VSCROLL : GOSUB ED.RENDER.ALL
  GOSUB ED.GUI.WHERE
  GOSUB GUI.OPEN : GOSUB GUI.CLOSE
  PRINT "GUI SCROLLED Y=";GUI.TOP;" WAS=";ED.GBY;" MAPTOP=";ED.MAP.TOP;" (want WAS+4)"
  ED.MAP.TOP = 0 : GOSUB ED.SET.VSCROLL : GOSUB ED.RENDER.ALL

  REM ---- GUI.YN, answered with a keystroke, through the editor's own wrapper. The
  REM ---- wrapper is what every call site uses, so testing it tests them all.
  ED.PROMPT.MSG$ = "Discard changes?"
  ED.QK = 89 : GOSUB ED.PUSHKEY
  GOSUB ED.PROMPT.YN
  PRINT "GUI YN Y ->";ED.YN;" (want 1)"
  ED.QK = 27 : GOSUB ED.PUSHKEY
  GOSUB ED.PROMPT.YN
  PRINT "GUI YN ESC ->";ED.YN;" (want 0)"

  REM ---- GUI.TEXT, and with it the caret. Type A B C, press LEFT, type X: the X
  REM ---- lands BETWEEN B and C, which the old append-only field could not do. If
  REM ---- the arrow were still being swallowed this would read ABCX, and if it were
  REM ---- leaving the field it would read ABC with OK=0.
  ED.PROMPT.MSG$ = "Open file: "
  ED.QK = 65 : GOSUB ED.PUSHKEY
  ED.QK = 66 : GOSUB ED.PUSHKEY
  ED.QK = 67 : GOSUB ED.PUSHKEY
  ED.QK = 157 : GOSUB ED.PUSHKEY
  ED.QK = 88 : GOSUB ED.PUSHKEY
  ED.QK = 13 : GOSUB ED.PUSHKEY
  GOSUB ED.PROMPT
  PRINT "GUI TEXT ->";ED.INPUT$;" OK=";ED.PROMPT.OK;" (want ABXC 1)"

  REM ---- and ESC still throws the typing away rather than returning it
  ED.QK = 90 : GOSUB ED.PUSHKEY
  ED.QK = 27 : GOSUB ED.PUSHKEY
  GOSUB ED.PROMPT
  PRINT "GUI TEXT ESC ->";ED.INPUT$;"/ OK=";ED.PROMPT.OK;" (want / 0)"

  REM ---- GUI.MENU, over the SAME MENUHELP.ITEM$ the menu bar uses. Start on row 1,
  REM ---- press down, press RETURN: row 2, key 13.
  MENUHELP.ITEM$(1) = " ONE" : MENUHELP.ITEM$(2) = " TWO"
  GUI.COUNT = 2 : GUI.SEL = 1 : GUI.FLAGS = 0
  GUI.TITLE$ = "PICK" : GUI.MSG$ = "" : GUI.MSG2$ = ""
  GOSUB ED.GUI.WHERE
  ED.QK = 17 : GOSUB ED.PUSHKEY
  ED.QK = 13 : GOSUB ED.PUSHKEY
  GOSUB GUI.MENU
  PRINT "GUI MENU SEL=";GUI.SEL;" KEY=";GUI.KEY;" (want 2 13)"
  ED.SIM.MODE = 1

  PRINT "M4 OK"
  RETURN

REM ---- one key into the KERNAL's buffer, so a GET loop can be driven headlessly ----
REM POKE 1 is the ROM/RAM bank byte: 0 pages the KERNAL in for the JSR and 4 puts BASIC
REM back. The same three statements appear inline above; they became a routine when the
REM GUI checks needed six keys in a row.
ED.PUSHKEY:
  POKE 1, 0 : GP.CALL ED.KBDBUF, ED.QK : POKE 1, 4
  RETURN

REM ---- add up every character cell the dialog box covers ----
REM Chars only, not attributes: a restore that put the text back in the wrong colour
REM would be a different bug and is not what this is watching for. GUI.LEFT/BY/W/H are
REM whatever the last GUI.OPEN worked out, which is the rectangle in question.
ED.GUI.SUM:
  ED.GSUM = 0
  FOR ED.GR = 0 TO GUI.HEIGHT - 1
    FOR ED.GX = 0 TO GUI.WIDTH - 1
      ED.GSUM = ED.GSUM + VPEEK(1, 45056 + (GUI.TOP + ED.GR) * 256 + (GUI.LEFT + ED.GX) * 2)
    NEXT ED.GX
  NEXT ED.GR
  RETURN

REM --- this read / writes BANKS (line-pointer table + banked memory)
#INCLUDE "STORE.BASL"
