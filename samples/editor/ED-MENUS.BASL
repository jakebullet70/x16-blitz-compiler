REM ============================================================================
REM ED-MENUS.BASL -- the editor's menu bar and its dropdowns, on MENU.INC.BL,
REM MENUPULL.INC.BL and MENUKEY.INC.BL. #INCLUDEd inline like ED-STORE.BASL: one
REM global symbol table.
REM
REM Every title's rows are stored once, here. MENU.KEY sees each key first: ESC or
REM ALT+letter opens the bar, and it hands back the row chosen. Colours come from THEME.
REM ============================================================================

ED.MENU.SETUP:
  GP.SUB MENU.SAVESCREEN, MENU.SAVE.VRAM
  GOSUB MENU.THEME
  GP.SUB MENU.BEGIN, MENU.BAR
  GP.SUB MENU.ITEM, " &File "
  GP.SUB MENU.ITEM, " &Search "
  GP.SUB MENU.ITEM, " &Help "
  REM A hot key need not be the initial: Save and Save As both start with S, so the
  REM second takes its A. The leading space insets the text; the trailing one pads.
  GP.SUB MENU.BEGIN, MENU.DROP + 1
  GP.SUB MENU.ITEM, " &New "
  GP.SUB MENU.ITEM, " &Open... "
  GP.SUB MENU.ITEM, " &Save "
  GP.SUB MENU.ITEM, " Save &As... "
  GP.SUB MENU.ITEM, " E&xit "
  GP.SUB MENU.BEGIN, MENU.DROP + 2
  GP.SUB MENU.ITEM, " &Find... "
  GP.SUB MENU.ITEM, " &Go to Line... "
  GP.SUB MENU.BEGIN, MENU.DROP + 3
  GP.SUB MENU.ITEM, " &About "
  RETURN

REM ---- the titles, none lit. ED.RENDER.MENUBAR draws the band and filename around 
REM ---- them. Just the top line
ED.MENU.DRAW.BAR:
  GP.SUB MENU.DRAWBAR, 0, 0, MENU.NOBOX
  RETURN

REM ---- every key comes here first. ED.MENU.PICK is -1 when it was not a menu key.
ED.MENU.KEY:
  ED.MENU.PICK = GP.FN(MENU.KEY, ED.KEY)
  IF ED.MENU.PICK < 0 THEN RETURN
  ## 
  GOSUB ED.PLACE.CARET
  IF ED.MENU.PICK > 0 THEN GOSUB ED.MENU.DISPATCH
  RETURN

## ---- ED.CMD.* live in EDITOR.BASL, reached through the one global symbol table.
## --- Menu bar 1st, then calls drop down menu
ED.MENU.DISPATCH:
  ON MENU.PICKBAR GOSUB ED.DROPDOWN.FILE, ED.DROPDOWN.SEARCH, ED.CMD.ABOUT
  RETURN

## ---- File menu
ED.DROPDOWN.FILE:
  ON ED.MENU.PICK GOSUB ED.CMD.NEW, ED.CMD.OPEN, ED.CMD.SAVE, ED.CMD.SAVEAS, ED.CMD.EXIT
  RETURN

## --- Search menu
ED.DROPDOWN.SEARCH:
  ON ED.MENU.PICK GOSUB ED.CMD.FIND, ED.CMD.GOTO
  RETURN
