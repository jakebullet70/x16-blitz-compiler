## ***********************************************************************
## **
## **  MENUBAR.INC.BL -- a horizontal menu, in BASIC.
## **
## **      MENUBAR.RUN     draw it, drive it, return the item chosen
## **      MENUBAR.DRAW    draw it without driving it
## **      MENUBAR.ITEM    one item, in whichever attribute you name
## **
## **  MENUVERT.INC.BL is the VERTICAL menu; this is the other axis. Items sit side by
## **  side, each as wide as its own text, and left and right are what move.
## **
## **  REQUIRES, and does not #INCLUDE for you:
## **      GPB.INC.BL        GP.FILL, GP.PRINTAT
## **      MENUVERT.INC.BL   MENUVERT.ROW draws the items and tints the
## **                        hotkeys; this file owns the layout and the keys
## **
## **  A SEPARATE FILE, NOT A FLAG ON MENUVERT: a BASL module has no dead code
## **  elimination, so a horizontal path inside MENUVERT would be carried by every
## **  vertical menu ever written. STASHFILE.INC.BL was split off for the same reason.
## **
## **  IT SHARES MENUVERT'S ARRAY AND COLOURS -- MENUVERT.ITEM$, .ATTR, .HIATTR,
## **  .HOTATTR, .HOT$ -- because a program with a bar and a dropdown wants one
## **  convention, and copying an array between name spaces per call would be worse.
## **
## **  Usage:
## **      MENUVERT.ITEM$(1) = " FILE "     ... and so on
## **      MENUVERT.COUNT = 3
## **      MENUVERT.ATTR = THEME.CLR(THEME.TITLE)
## **      MENUVERT.HIATTR = THEME.CLR(THEME.HILITE)
## **      MENUBAR.X = 0 : MENUBAR.Y = 0
## **      GOSUB MENUBAR.RUN
## **      IF MENUBAR.SEL = 0 THEN <cancelled>
## **
## **   in   MENUBAR.X  MENUBAR.Y   where the bar starts
## **        MENUBAR.GAP            cells BETWEEN items. 0 is the default,
## **                               because the space belongs in the item
## **                               text -- " FILE " is how you get a
## **                               highlight with air in it, exactly as a
## **                               vertical menu's " NEW GAME" does
## **        MENUBAR.FLAGS          added together, see below
## **        MENUBAR.SEL            the item to start on; 0 starts at 1
## **        and MENUVERT.COUNT, MENUVERT.ITEM$(), MENUVERT.ATTR,
## **        MENUVERT.HIATTR, MENUVERT.HOT$, MENUVERT.HOTATTR
## **
## **   out  MENUBAR.SEL     1..COUNT, or 0 if cancelled
## **        MENUBAR.KEY     what ended it: 13 chose, 27 cancelled, 17 or
## **                        145 if the cross-axis flags are on, or the
## **                        hotkey itself
## **        MENUBAR.SELX    the COLUMN the chosen item starts at, and
## **        MENUBAR.SELW    how wide it is -- so a caller can drop a panel
## **                        under it without working the layout out again
## **
## **  THE WIDTH OF AN ITEM IS THE LENGTH OF ITS TEXT -- no column width, no
## **  MENUBAR.WIDTH. A bar reading "FILE SEARCH HELP" with every item as wide as the
## **  longest is a row of buttons, not a menu bar. That is the real difference from
## **  MENUVERT, and why this could not have been a flag.
## **
## **  UP AND DOWN ARE OPTIONAL EXITS, off by default. A bar over dropdowns wants DOWN
## **  to end it so the caller can open the panel and come back; a bar that is only a
## **  bar wants them ignored. Neither is the general case, so off means "an arrow
## **  across the grain does nothing".
## **
## **  The whole MENUBAR.* name space belongs to this file.
## **
## ***********************************************************************
#IFNDEF MENUBAR.DEFS
#DEFINE MENUBAR.DEFS 1

## Flags. The first three are MENUVERT's, meaning the same on this axis; GAMEPAD reads
## the pad's LEFT and RIGHT where the vertical menu reads UP and DOWN. DOWNEXIT and
## UPEXIT are this file's own -- the cross-axis exits described above.

#DEFINE MENUBAR.MUSTSEL 1
#DEFINE MENUBAR.KEEPMARK 2
#DEFINE MENUBAR.NOWRAP 4
#DEFINE MENUBAR.GAMEPAD 8
#DEFINE MENUBAR.DOWNEXIT 16
#DEFINE MENUBAR.UPEXIT 32

## PETSCII, as GET reports it. LEFT and RIGHT are the movement keys here;
## UP and DOWN are the optional exits.

#DEFINE MENUBAR.LEFT 157
#DEFINE MENUBAR.RIGHT 29
#DEFINE MENUBAR.UP 145
#DEFINE MENUBAR.DOWN 17
#DEFINE MENUBAR.ENTER 13
#DEFINE MENUBAR.ESCAPE 27
#DEFINE MENUBAR.STOP 3

## SNES port 1, active high, same bits MENUVERT names -- but this menu
## reads the ones that menu ignores.
##   $80 B   $10 START   $08 UP   $04 DOWN   $02 LEFT   $01 RIGHT

#DEFINE MENUBAR.PORT 1
#DEFINE MENUBAR.PAD.LEFT 2
#DEFINE MENUBAR.PAD.RIGHT 1
#DEFINE MENUBAR.PAD.B 128
#DEFINE MENUBAR.PAD.START 16

GOTO MENUBAR.MODULE.END

## ***********************************************************************
## **  MENUBAR.RUN -- the whole thing.
## ***********************************************************************

MENUBAR.RUN.BODY:
    IF MENUBAR.SEL < 1 THEN MENUBAR.SEL = 1
    IF MENUBAR.SEL > MENUVERT.COUNT THEN MENUBAR.SEL = MENUVERT.COUNT
    MENUBAR.KEY = 0 : GOSUB MENUBAR.DRAW : GOSUB MENUBAR.MARK

MENUBAR.WAIT:
    GET MENUBAR.IN$
    IF MENUBAR.IN$ <> "" THEN MENUBAR.CODE = ASC(MENUBAR.IN$) : GOTO MENUBAR.KEYED
    IF (MENUBAR.FLAGS AND MENUBAR.GAMEPAD) = 0 THEN GOTO MENUBAR.WAIT
    GOSUB MENUBAR.PADKEY : IF MENUBAR.CODE = 0 THEN GOTO MENUBAR.WAIT

## ---- MENUBAR.WAS is what the highlight lifts off, taken BEFORE anything can move:
## ---- redrawing from a stale index is how a bar grows a second highlight.

MENUBAR.KEYED:
    MENUBAR.WAS = MENUBAR.SEL
    IF MENUBAR.CODE = MENUBAR.LEFT THEN MENUBAR.SEL = MENUBAR.SEL - 1 : GOTO MENUBAR.SETTLE
    IF MENUBAR.CODE = MENUBAR.RIGHT THEN MENUBAR.SEL = MENUBAR.SEL + 1 : GOTO MENUBAR.SETTLE
    IF MENUBAR.CODE = MENUBAR.ENTER THEN GOTO MENUBAR.CHOSE
    IF MENUBAR.CODE = MENUBAR.ESCAPE THEN GOTO MENUBAR.CANCEL
    IF MENUBAR.CODE = MENUBAR.STOP THEN GOTO MENUBAR.CANCEL

## ---- the cross-axis exits, and only if asked for ----
    IF MENUBAR.CODE = MENUBAR.DOWN AND (MENUBAR.FLAGS AND MENUBAR.DOWNEXIT) <> 0 THEN GOTO MENUBAR.CHOSE
    IF MENUBAR.CODE = MENUBAR.UP AND (MENUBAR.FLAGS AND MENUBAR.UPEXIT) <> 0 THEN GOTO MENUBAR.CHOSE

    GOSUB MENUBAR.HOTKEY
    IF MENUBAR.HIT > 0 THEN MENUBAR.SEL = MENUBAR.HIT : GOTO MENUBAR.CHOSE
    GOTO MENUBAR.WAIT

## ---- moved: wrap or stop, then lift the old highlight and lay the new ----

MENUBAR.SETTLE:
    IF MENUBAR.SEL < 1 THEN GOTO MENUBAR.WRAPLEFT
    IF MENUBAR.SEL > MENUVERT.COUNT THEN GOTO MENUBAR.WRAPRIGHT
MENUBAR.SETTLE.GO:
    IF MENUBAR.SEL = MENUBAR.WAS THEN GOTO MENUBAR.WAIT
    MENUBAR.DRAWN = MENUBAR.WAS : MENUBAR.PAINT = MENUVERT.ATTR : GOSUB MENUBAR.ITEM
    GOSUB MENUBAR.MARK : GOTO MENUBAR.WAIT

MENUBAR.WRAPLEFT:
    MENUBAR.SEL = MENUVERT.COUNT
    IF (MENUBAR.FLAGS AND MENUBAR.NOWRAP) <> 0 THEN MENUBAR.SEL = 1
    GOTO MENUBAR.SETTLE.GO

MENUBAR.WRAPRIGHT:
    MENUBAR.SEL = 1 : IF (MENUBAR.FLAGS AND MENUBAR.NOWRAP) <> 0 THEN MENUBAR.SEL = MENUVERT.COUNT
    GOTO MENUBAR.SETTLE.GO

## ---- ESC. MUSTSEL is for a bar with nothing behind it to go back to ----

MENUBAR.CANCEL:
    IF (MENUBAR.FLAGS AND MENUBAR.MUSTSEL) <> 0 THEN GOTO MENUBAR.WAIT
    MENUBAR.KEY = MENUBAR.CODE : MENUBAR.DRAWN = MENUBAR.SEL : MENUBAR.PAINT = MENUVERT.ATTR : GOSUB MENUBAR.ITEM
    MENUBAR.SEL = 0 : RETURN

## ---- chosen, by RETURN, a hotkey, or a cross-axis arrow. The highlight comes off
## ---- unless KEEPMARK says otherwise, and SELX / SELW point at the item either way.

MENUBAR.CHOSE:
    MENUBAR.KEY = MENUBAR.CODE : GOSUB MENUBAR.WHERE
    IF (MENUBAR.FLAGS AND MENUBAR.KEEPMARK) <> 0 THEN RETURN
    MENUBAR.DRAWN = MENUBAR.SEL : MENUBAR.PAINT = MENUVERT.ATTR : GOSUB MENUBAR.ITEM
    RETURN

## ***********************************************************************
## **  MENUBAR.HOTKEY -- a letter that chooses its item.
## **
## **   out  MENUBAR.HIT   the item, or 0
## **
## **  Matched without case, and it CHOOSES rather than moves to -- MENUVERT's rule.
## ***********************************************************************

MENUBAR.HOTKEY:
    MENUBAR.HIT = 0 : IF MENUVERT.HOT$ = "" THEN RETURN
    MENUBAR.WANT = MENUBAR.CODE
    IF MENUBAR.WANT > 96 AND MENUBAR.WANT < 123 THEN MENUBAR.WANT = MENUBAR.WANT - 32
    FOR MENUBAR.HK = 1 TO LEN(MENUVERT.HOT$)
        IF MENUBAR.HK > MENUVERT.COUNT THEN GOTO MENUBAR.HOTDONE
        MENUBAR.HC = ASC(MID$(MENUVERT.HOT$, MENUBAR.HK, 1))
        IF MENUBAR.HC > 96 AND MENUBAR.HC < 123 THEN MENUBAR.HC = MENUBAR.HC - 32
        IF MENUBAR.HC = MENUBAR.WANT THEN MENUBAR.HIT = MENUBAR.HK
    NEXT MENUBAR.HK
MENUBAR.HOTDONE:
    RETURN

## ***********************************************************************
## **  MENUBAR.PADKEY -- the SNES pad, as a key code.
## **
## **  LEFT and RIGHT where the vertical menu reads UP and DOWN, B for RETURN, START for
## **  ESC. It WAITS FOR THE RELEASE: a pad reads as a level, not an event, and without
## **  that one press walks the whole bar.
## ***********************************************************************

MENUBAR.PADKEY:
    MENUBAR.CODE = 0 : GOSUB MENUBAR.PADREAD
    IF MENUBAR.PAD = 0 THEN RETURN
    IF (MENUBAR.PAD AND MENUBAR.PAD.LEFT) <> 0 THEN MENUBAR.CODE = MENUBAR.LEFT
    IF (MENUBAR.PAD AND MENUBAR.PAD.RIGHT) <> 0 THEN MENUBAR.CODE = MENUBAR.RIGHT
    IF (MENUBAR.PAD AND MENUBAR.PAD.B) <> 0 THEN MENUBAR.CODE = MENUBAR.ENTER
    IF (MENUBAR.PAD AND MENUBAR.PAD.START) <> 0 THEN MENUBAR.CODE = MENUBAR.ESCAPE
    IF MENUBAR.CODE = 0 THEN RETURN
MENUBAR.PADRELEASE:
    GOSUB MENUBAR.PADREAD : IF MENUBAR.PAD <> 0 THEN GOTO MENUBAR.PADRELEASE
    RETURN

MENUBAR.PADREAD:
    MENUBAR.PAD = JOY(MENUBAR.PORT) AND 255 : RETURN

## ***********************************************************************
## **  MENUBAR.DRAW -- every item, unhighlighted.
## ***********************************************************************

MENUBAR.DRAW.BODY:
    FOR MENUBAR.EACH = 1 TO MENUVERT.COUNT
        MENUBAR.DRAWN = MENUBAR.EACH : MENUBAR.PAINT = MENUVERT.ATTR
        GOSUB MENUBAR.ITEM
    NEXT MENUBAR.EACH
    RETURN

## ---- the highlight, on whatever MENUBAR.SEL now is. HIATTR of 0 means "invert ATTR",
## ---- as MENUVERT does.

MENUBAR.MARK.BODY:
    MENUBAR.PAINT = MENUVERT.HIATTR
    IF MENUBAR.PAINT = 0 THEN MENUBAR.PAINT = (MENUVERT.ATTR AND 15) * 16 + INT(MENUVERT.ATTR / 16)
    MENUBAR.DRAWN = MENUBAR.SEL
    GOSUB MENUBAR.ITEM : RETURN

## ***********************************************************************
## **  MENUBAR.ITEM -- one item, at its own column and its own width.
## **
## **   in   MENUBAR.DRAWN   the item, 1..COUNT
## **        MENUBAR.PAINT   the attribute
## **
## **  IT AIMS MENUVERT.ROW SIDEWAYS rather than repeating it: that routine fills the
## **  highlight, cuts overlong text and tints the hotkey, none of which is about which
## **  way a menu runs. The one vertical thing in it is DRAWY = Y + DRAWROW - 1, so this
## **  sets MENUVERT.Y to make that sum land on the bar's row -- a deliberate use of its
## **  arithmetic, and if that line changes this breaks loudly on the first draw.
## ***********************************************************************

MENUBAR.ITEM.BODY:
    MENUBAR.FIND = MENUBAR.DRAWN : GOSUB MENUBAR.COLUMN
    MENUVERT.X = MENUBAR.AT : MENUVERT.WIDTH = MENUBAR.WIDE : MENUVERT.Y = MENUBAR.Y - MENUBAR.DRAWN + 1
    MENUVERT.DRAWROW = MENUBAR.DRAWN : MENUVERT.DRAWATTR = MENUBAR.PAINT
    GOSUB MENUVERT.ROW : RETURN

## ***********************************************************************
## **  MENUBAR.COLUMN -- where item MENUBAR.FIND starts, and how wide.
## **
## **   in   MENUBAR.FIND    the item, 1..COUNT
## **   out  MENUBAR.AT      its column
## **        MENUBAR.WIDE    its width, which is the length of its text
## **
## **  Walked from the left every time rather than cached: O(n) an item, O(n squared) a
## **  bar, which for the eight or ten items a bar ever has is a few dozen additions on
## **  a path about to wait for a human. An array would have to be DIMmed by the caller,
## **  which is MENUVERT.ITEM$'s problem and not one worth having twice.
## ***********************************************************************

MENUBAR.COLUMN:
    MENUBAR.AT = MENUBAR.X : MENUBAR.WIDE = LEN(MENUVERT.ITEM$(MENUBAR.FIND))

## ---- THE GUARD IS NOT OPTIONAL. "FOR 1 TO 0" RUNS ONCE in this BASIC -- the test is
## ---- at the NEXT -- so without it item 1 sums its own width and starts where item 2
## ---- should. Measured: item 1 came back at column 8 instead of 2.
    IF MENUBAR.FIND < 2 THEN RETURN

    FOR MENUBAR.CI = 1 TO MENUBAR.FIND - 1
        MENUBAR.AT = MENUBAR.AT + LEN(MENUVERT.ITEM$(MENUBAR.CI)) + MENUBAR.GAP
    NEXT MENUBAR.CI
    RETURN

## ---- where the chosen item sits, for a caller about to open something under it. Set
## ---- on the way out of MENUBAR.CHOSE, so it survives the highlight being lifted.

MENUBAR.WHERE.BODY:
    MENUBAR.FIND = MENUBAR.SEL : GOSUB MENUBAR.COLUMN
    MENUBAR.SELX = MENUBAR.AT : MENUBAR.SELW = MENUBAR.WIDE : RETURN

MENUBAR.MODULE.END:
#ENDIF
