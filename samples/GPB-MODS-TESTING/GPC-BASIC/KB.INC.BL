## ***********************************************************************
## **
## **  KB.INC.BL -- the keyboard buffer, emptied.
## **
## **      KB.CLEARKB     throw away whatever is already typed
## **
## **  Requires GPB.INC.BL, and does not #INCLUDE it for you.
## **
## ***********************************************************************
#IFNDEF KB.DEFS
#DEFINE KB.DEFS 1

GOTO KB.MODULE.END

## KB.CLEARKB -- throw away whatever is already typed.
##
## Call it before opening a dialog, and after a keystroke that redraws. A dialog opened
## with a key still queued reads it, answers itself and closes; a held arrow repeats
## faster than a page can be drawn and scrolls on after the key is let go.

KB.CLEARKB:
    GP.DO
        GET KB.K$
        IF GP.ISEMPTY(KB.K$) THEN GP.EXITDO
    GP.LOOP
    RETURN

KB.MODULE.END:
#ENDIF
