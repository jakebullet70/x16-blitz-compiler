## ***********************************************************************
## **
## **  STASHFILE.INC.BL -- a saved text rectangle, through a file.
## **
## **      STASH.FILE.SAVE   a rectangle of the screen, out to a file
## **      STASH.FILE.LOAD   a saved file, back where it came from
## **      STASH.FILE.PUT    a saved file, pasted somewhere else
## **
## **  Requires, and does not #INCLUDE for you:
## **      GPB.INC.BL      GP.ASM
## **      STASH.INC.BL    which does the copying, and wants a #SYMFILE
## **
## **  Usage:
## **      STASH.BANK = 8 : STASH.FILE$ = "PANEL.BIN"
## **      STASH.X = 10 : STASH.Y = 4 : STASH.W = 30 : STASH.H = 8
## **      GOSUB STASH.FILE.SAVE
## **      ...
## **      GOSUB STASH.FILE.LOAD
## **
## **   in   STASH.FILE$    the name
## **        STASH.DEV      the device. 0 means 8
## **        STASH.BANK     the bank to stage through
## **        and, for SAVE, the geometry STASH.SAVE wants
## **
## **  The four header bytes go out with the cells, so loading one back needs
## **  nothing but the name.
## **
## **  BSAVE's end address is EXCLUSIVE, so this writes the header and the cells
## **  and no padding. The length is w * h * 2 + 4.
## **
## ***********************************************************************
#IFNDEF STASHFILE.DEFS
#DEFINE STASHFILE.DEFS 1

GOTO STASHFILE.MODULE.END

STASH.FILE.SAVE:
    GOSUB STASH.FILE.HOLD
    IF STASH.DEV = 0 THEN STASH.DEV = 8
    GOSUB STASH.SAVE
    IF STASH.OK = 0 THEN GOTO STASH.FILE.DONE
    STASH.LAST = STASH.WINDOW + STASH.HEADER + STASH.W * STASH.H * 2
    BSAVE STASH.FILE$, STASH.DEV, STASH.BANK, STASH.WINDOW, STASH.LAST
    GOTO STASH.FILE.DONE

STASH.FILE.LOAD:
    GOSUB STASH.FILE.HOLD
    IF STASH.DEV = 0 THEN STASH.DEV = 8
    BLOAD STASH.FILE$, STASH.DEV, STASH.BANK, STASH.WINDOW
    STASH.MOVE = 0
    GOSUB STASH.RESTORE
    GOTO STASH.FILE.DONE

## ---- the same file stamped anywhere. MOVE is cleared on the way out, being an input a
## ---- caller sets once that would otherwise leak into the next restore.

STASH.FILE.PUT:
    GOSUB STASH.FILE.HOLD
    IF STASH.DEV = 0 THEN STASH.DEV = 8
    BLOAD STASH.FILE$, STASH.DEV, STASH.BANK, STASH.WINDOW
    STASH.MOVE = -1
    GOSUB STASH.RESTORE
    STASH.MOVE = 0

## STASH.FILE.DONE -- the one exit all three leave by.
##
## WARNING: BLOAD, BSAVE and BVERIFY write the bank register and leave it there, so
## STASH.INC.BL's own restore does not cover this file. STASH.SAVE puts the caller's
## bank back and BSAVE then takes it away again; on LOAD and PUT the BLOAD runs before
## STASH.RESTORE, so what RESTORE captured to put back was BLOAD's bank, not the
## caller's.

STASH.FILE.DONE:
    BANK STASH.FWAS
    RETURN

## STASH.FILE.HOLD -- the caller's bank, before any of this touches it.
##
## A variable of its own: STASH.WAS% belongs to STASH.SAVE and STASH.RESTORE, which
## call STASH.BANK.HOLD themselves and would overwrite it half way through.

STASH.FILE.HOLD:
    GOSUB STASH.BANK.HOLD
    STASH.FWAS = STASH.WAS%
    RETURN

STASHFILE.MODULE.END:
#ENDIF
