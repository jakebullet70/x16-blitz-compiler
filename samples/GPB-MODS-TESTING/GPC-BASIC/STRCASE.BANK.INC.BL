## ***********************************************************************
## **
## **  STRCASE.INC.BL -- case, rewriting a string in place.
## **
## **      STRCASE.PTR = GP.STRPTR(LINE$)
## **      STRCASE.MODE = STRCASE.UPPER
## **      GOSUB STRCASE.GO
## **
## **   in   STRCASE.PTR    GP.STRPTR of the string
## **        STRCASE.MODE   one of the two constants
## **   out  the string itself
## **
## **      STRCASE.UPPER   a-z -> A-Z, everything else untouched
## **      STRCASE.LOWER   A-Z -> a-z, everything else untouched
## **
## **  An unrecognised mode does LOWER. A zero length string is not a special case.
## **
## **  Trimming is STR.TRIM / STR.LTRIM / STR.RTRIM in STRINGS.INC.BL.
## **
## **  STRCASE.MODE is sticky: an ordinary variable, not an argument, so a call that
## **  does not set it repeats the last one. Set both inputs every call, as with
## **  SORT.DESCEND and STASH.MOVE.
## **
## **  ONE-LINE CALLS. Three verbs say the same thing in one statement, and every
## **  argument is written at the call, so the sticky mode above cannot bite:
## **
## **      GP.SUB STRCASE.APPLY, GP.STRPTR(LINE$), STRCASE.UPPER
## **      A$ = GP.FN(STR.UCASE, A$)
## **      PRINT GP.FN(STR.LCASE, N$)
## **
## **  STRCASE.APPLY is STRCASE.GO with both inputs as arguments. STR.UCASE and
## **  STR.LCASE take a string and give back a cased COPY, which is a different
## **  interface: they rewrite the copy, never the caller's string, so A$ = GP.FN(...)
## **  is what changes A$. A literal is SAFE in those two -- the argument is copied
## **  into the formal on the way in and the copy is what gets rewritten -- where it
## **  is not safe in STRCASE.APPLY, which is handed an address.
## **
## **  WARNING: one call to the SAME verb per expression. A string result is passed
## **  by address, so GP.FN(STR.UCASE,A$) + GP.FN(STR.UCASE,B$) reads one variable
## **  twice and gives the second answer both times. Two DIFFERENT verbs are fine, so
## **  UCASE and LCASE may be mixed in one expression.
## **
## **  The verbs need GPB.INC.BL, and a program that has no GP block does not want
## **  them; STRCASE.GO is the whole module without them.
## **
## **  The module needs a #SYMFILE, before the #INCLUDEs and named after the source PRG.
## **  Without one the compile stops with "NO SYMBOL FILE FOR {}", which names the cause
## **  but not the file.
## **
## **      #SYMFILE "@:MYPROG.SYM"
## **      #INCLUDE "STRCASE.INC.BL"
## **
## **  WARNING: pass a variable, never a literal. GP.STRPTR("hello") is an address
## **  inside the p-code, and folding it EDITS THE PROGRAM.
## **
## **  #REM 1 is load bearing: without it BASLOAD strips the body and the block reaches
## **  the compiler empty, refused as "block mismatch". #REM 0 restores the default.
## **
## **  The whole STRCASE.* name space belongs to this file, except the two verbs
## **  STR.UCASE and STR.LCASE, named for STRINGS.INC.BL, which they merge into later.
## **
## **  THIS IS THE BANKED FORM. Every entry point carries a .BODY suffix,
## **  because a banked routine cannot select its own bank: the public name
## **  has to be a shim in low memory, and SHIM.UTILBANK.INC.BL holds it.
## **  Put this file inside the GP.BANKED region, with that shim above it.
## **
## **  The low memory twin is STRCASE.INC.BL. Include one or the other,
## **  never both. GPC-BASIC/BANKED-OR-NOT.md says how to choose.
## **
## ***********************************************************************
#IFNDEF STRCASE.DEFS
#DEFINE STRCASE.DEFS 1

#DEFINE STRCASE.UPPER 0
#DEFINE STRCASE.LOWER 1

GOTO STRCASE.MODULE.END

## STRCASE.ADDR% and STRCASE.OP% are the 16-bit integer slots {VAR} needs, named apart
## from STRCASE.PTR / STRCASE.MODE because BASLOAD's symbol file does not record the
## sigil -- X and X% would be one entry.

STRCASE.GO.BODY:
    STRCASE.ADDR% = STRCASE.PTR
    STRCASE.OP% = STRCASE.MODE
    #REM 1
    GP.ASM
    REM CLD                      ; SYS enters with the caller's flags
    REM LDA {STRCASE.ADDR%}      ; zTemp0 -> the length byte, text from +1
    REM STA $2C
    REM LDX #1
    REM LDA {STRCASE.ADDR%},X
    REM STA $2D
    REM LDA {STRCASE.OP%}        ; one test, at entry, never inside a loop
    REM BNE SCLO
    REM ; ---- upper: a-z is a bit 5 clear once the range is known, so
    REM ; ---- digits and PETSCII graphics pass through. Y counts DOWN from
    REM ; ---- the length, so offset 0, the length byte, is never written.
    REM LDA ($2C)
    REM BEQ SCUPX
    REM TAY
    REM SCUPL: LDA ($2C),Y
    REM CMP #97                  ; lower case a
    REM BCC SCUPN
    REM CMP #123                 ; one past lower case z
    REM BCS SCUPN
    REM AND #$DF                 ; clear bit 5
    REM STA ($2C),Y
    REM SCUPN: DEY
    REM BNE SCUPL
    REM SCUPX: RTS
    REM ; ---- lower: the same walk, range and bit the other way. Written
    REM ; ---- out rather than shared, because sharing would test the mode
    REM ; ---- once per character.
    REM SCLO: LDA ($2C)
    REM BEQ SCLOX
    REM TAY
    REM SCLOL: LDA ($2C),Y
    REM CMP #65                  ; upper case A
    REM BCC SCLON
    REM CMP #91                  ; one past upper case Z
    REM BCS SCLON
    REM ORA #$20                 ; set bit 5
    REM STA ($2C),Y
    REM SCLON: DEY
    REM BNE SCLOL
    REM SCLOX: RTS
    GP.ENDASM
    #REM 0
    RETURN

## The verbs' bodies. THE GP.DEFPROC DECLARATIONS ARE NOT HERE -- they are in
## SHIM.UTILBANK.INC.BL, which is in low memory, because a verb's call site is compiled
## into a jump to the body and a jump out of low memory has to select the bank
## first. See that file's header. The third verb was never built:
## GP.DEFPROC STRCASE.APPLY, STRCASE.PTR, STRCASE.MODE : GOSUB STRCASE.GO

## STRCASE.S$ is the argument AND the result. The argument copy is the working copy,
## so a second string variable would only be a second copy of the same bytes.
STR.UCASE.BODY:
    STRCASE.PTR = GP.STRPTR(STRCASE.S$)
    STRCASE.MODE = STRCASE.UPPER
    GOSUB STRCASE.GO.BODY
    RETURN

STR.LCASE.BODY:
    STRCASE.PTR = GP.STRPTR(STRCASE.S$)
    STRCASE.MODE = STRCASE.LOWER
    GOSUB STRCASE.GO.BODY
    RETURN

STRCASE.MODULE.END:
#ENDIF
