## ***********************************************************************
## **
## **  LIBBANK.INC.BL -- the low memory front door to a banked library.
## **
## **      THEME.LOAD
## **      MENUVERT.RUN    MENUVERT.DRAW   MENUVERT.ROW
## **      MENUBAR.RUN     MENUBAR.DRAW    MENUBAR.ITEM
## **      MENUBAR.MARK    MENUBAR.WHERE
## **      LINEINPUT.GET   LINEINPUT.ASK
## **      GUI.SAY         GUI.YN          GUI.MENU        GUI.TEXT
## **      GUI.OPEN        GUI.CLOSE       GUI.LISTBOX
## **
## **  Eighteen shims and nothing else. Each selects the code bank and calls
## **  the body, which lives at $A000 in that bank; the bodies are the same
## **  routines under a .BODY name, in their own modules unchanged but for
## **  their label lines.
## **
## **  WHY A SHIM AT ALL: a banked routine cannot select its own bank. By the
## **  time its first instruction is fetched the wrong bank is already selected
## **  and the fetch has already read rubbish. Something in LOW memory has to
## **  set the bank before the call, and that is the whole job of this file.
## **
## **  Usage -- the caller says nothing it did not say before:
## **
## **      #INCLUDE "LIBBANK.INC.BL"        ' before the region
## **      GOTO MY.LIBEND
## **      GP.BANKED LIB.CODEBANK
## **      #INCLUDE "THEME.INC.BL"
## **      #INCLUDE "MENUVERT.INC.BL"
## **      #INCLUDE "MENUBAR.INC.BL"
## **      #INCLUDE "LINEINPUT.INC.BL"
## **      #INCLUDE "GUI.INC.BL"
## **      #INCLUDE "GUI2.INC.BL"
## **      GP.ENDBANKED
## **      MY.LIBEND:
## **
## **  ALL SIX MODULES ARE REQUIRED, even by a program that calls only one of
## **  them. This file shims every entry point, and BASLOAD resolves every label
## **  in a file rather than the ones a path reaches -- so leaving MENUBAR out
## **  because you never draw a bar stops the build with LABEL NOT FOUND. It is
## **  GUI.INC.BL's rule about MENUVERT and LINEINPUT, one level up, and it costs
## **  BANK space rather than low memory.
## **
## **  ORDER INSIDE THE REGION IS THE ORDER THE MODULES ALREADY WANT --
## **  MENUVERT before MENUBAR, both before GUI. Banking changes none of that.
## **  THEME goes first because everything else reads THEME.CLR.
## **
## **  THEME IS THE CHEAPEST MODULE IN HERE: 480 bytes behind ONE shim, because
## **  THEME.LOAD is the only label anything outside the file ever calls.
## **
## **  THE GOTO OVER THE REGION IS NOT OPTIONAL. GP.BANKED leaves a bridge so
## **  that falling into the region still works, and at program start it does
## **  work -- the bootstrap copies the code up and leaves that bank selected.
## **  Relying on it means every module's GOTO ... MODULE.END runs from the
## **  bank for no reason, and stops working the day anything selects another
## **  bank before the includes are reached. Jump over it instead.
## **
## **  WHAT CANNOT GO IN THE REGION, and it is not a matter of taste:
## **
## **      STASH       four BANK statements. The compiler REFUSES a BANK
## **                  inside a region, because code fetched from the window
## **                  cannot be running when the window changes
## **      STASHFILE   a BANK, and eleven BLOAD / BSAVE
## **      APPSYS      a BSAVE, which leaves the register where it ended
## **
## **  Anything that selects a bank stays in low memory. Everything the GUI
## **  needs of those three it reaches by an ordinary GOSUB downwards, which
## **  works because low memory does not care which bank is selected -- and
## **  comes BACK into the bank correctly because STASH restores the caller's
## **  bank for itself.
## **
## **  ONE #DEFINE, USED TWICE: GP.BANKED takes a decimal constant and #DEFINE
## **  substitutes at translation time, so GP.BANKED LIB.CODEBANK and the BANK
## **  in every shim below cannot drift apart. Claim it from BANKMGR as well,
## **  or something else will hand it out:
## **
## **      BANKMGR.WANT = LIB.CODEBANK : GOSUB BANKMGR.CLAIM
## **
## **  AND IT IS NOT GUI.BANK. That one is scratch, where GUI.OPEN stashes the
## **  cells a dialog covers. Point the two at one bank and the dialog writes
## **  the screen over its own code.
## **
## **  A CALL LEAVES THE CODE BANK SELECTED, and that is safe rather than
## **  merely tolerated. Nothing in BASIC can read the bank back -- PEEK and
## **  POKE select and restore around every access -- BLOAD, BSAVE and BVERIFY
## **  take the bank as an argument, and STASH puts the caller's bank back for
## **  itself.
## **
## **  THE ONE THING THAT WOULD CARE IS A SECOND CODE BANK, and the compiler
## **  now allows up to eight. A program with two regions must select the bank
## **  before EVERY call into either -- which is exactly what the shims below
## **  do, so a library built this way is already correct. What it must not do
## **  is call from one region into another: both run at $A000 and the branch
## **  has no distance, so the compiler refuses it with NOT IMPLEMENTED.
## **
## **  The shims do NOT restore the caller's bank, deliberately. It would need
## **  a variable to hold it, and these routines call each other through this
## **  file, so a single variable would be overwritten by the inner call and
## **  the outer one would put back the wrong bank -- worse than not trying.
## **
## **  CALLS BETWEEN BANKED MODULES COME BACK OUT THROUGH HERE and go straight
## **  back in: MENUBAR.ITEM reaches MENUVERT.ROW that way, and so does every
## **  row GUI2 repaints. Both are already in the bank, so it is two GOSUBs
## **  neither needed. It is left that way because the alternative is editing
## **  call sites inside a module to say .BODY, and MENUVERT.ROW is the one
## **  routine where that would be worth measuring first.
## **
## **  This file owns LIB.CODEBANK and the eighteen labels above, and nothing
## **  else. Each name space still belongs to its own module.
## **
## ***********************************************************************
#IFNDEF LIBBANK.DEFS
#DEFINE LIBBANK.DEFS 1

## The bank the library runs in. One of the 63 a 512K machine has.
#DEFINE LIB.CODEBANK 4

GOTO LIBBANK.MODULE.END

## ---- THEME ----

THEME.LOAD:   BANK LIB.CODEBANK :  GOSUB THEME.LOAD.BODY :  RETURN

## ---- MENUVERT ----

MENUVERT.RUN:   BANK LIB.CODEBANK :  GOSUB MENUVERT.RUN.BODY :  RETURN

MENUVERT.DRAW:   BANK LIB.CODEBANK :  GOSUB MENUVERT.DRAW.BODY :  RETURN

MENUVERT.ROW:   BANK LIB.CODEBANK :  GOSUB MENUVERT.ROW.BODY :  RETURN

## ---- MENUBAR ----

MENUBAR.RUN:   BANK LIB.CODEBANK :  GOSUB MENUBAR.RUN.BODY :  RETURN

MENUBAR.DRAW:   BANK LIB.CODEBANK :  GOSUB MENUBAR.DRAW.BODY :  RETURN

MENUBAR.ITEM:   BANK LIB.CODEBANK :  GOSUB MENUBAR.ITEM.BODY :  RETURN

MENUBAR.MARK:   BANK LIB.CODEBANK :  GOSUB MENUBAR.MARK.BODY :  RETURN

MENUBAR.WHERE:   BANK LIB.CODEBANK :  GOSUB MENUBAR.WHERE.BODY :  RETURN

## ---- LINEINPUT ----

LINEINPUT.GET:   BANK LIB.CODEBANK :  GOSUB LINEINPUT.GET.BODY :  RETURN

LINEINPUT.ASK:   BANK LIB.CODEBANK :  GOSUB LINEINPUT.ASK.BODY :  RETURN

## ---- GUI and GUI2 ----

GUI.SAY:   BANK LIB.CODEBANK :  GOSUB GUI.SAY.BODY :  RETURN

GUI.YN:   BANK LIB.CODEBANK :  GOSUB GUI.YN.BODY :  RETURN

GUI.MENU:   BANK LIB.CODEBANK :  GOSUB GUI.MENU.BODY :  RETURN

GUI.TEXT:   BANK LIB.CODEBANK :  GOSUB GUI.TEXT.BODY :  RETURN

GUI.OPEN:   BANK LIB.CODEBANK :  GOSUB GUI.OPEN.BODY :  RETURN

GUI.CLOSE:   BANK LIB.CODEBANK :  GOSUB GUI.CLOSE.BODY :  RETURN

GUI.LISTBOX:   BANK LIB.CODEBANK :  GOSUB GUI.LISTBOX.BODY :  RETURN

LIBBANK.MODULE.END:
#ENDIF
