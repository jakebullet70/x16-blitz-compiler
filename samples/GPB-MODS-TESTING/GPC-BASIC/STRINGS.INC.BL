## ***********************************************************************
## **
## **  STRINGS.INC.BL -- string helpers, in BASIC.
## **
## **  Position independent, so #INCLUDE it anywhere. Call with GOSUB.
## **
## **   in   STR.STR$    the string, in and out
## **        STR.WIDTH   the field width  (PADR / PADL / PADC)
## **        STR.DELIM$  the separator    (SPLIT)
## **        STR.MAX     field array size (SPLIT, 0 means 10)
## **        STR.FIND$   what to look for (REPLACE)
## **        STR.REPL$   what to put back (REPLACE)
## **        STR.PET     a PETSCII code   (PET2SCR)
## **
## **  clobbers  STR.GAP STR.HALF      the pad routines
## **            STR.REST$ STR.AT      SPLIT and REPLACE
## **            STR.LIM STR.N         SPLIT
## **            STR.OUT$              REPLACE
## **            STR.SCR               PET2SCR
## **
## **  Usage:
## **      STR.STR$ = NAME$ : STR.WIDTH = 20
## **      GOSUB STR.PADR
## **      NAME$ = STR.STR$
## **
## **  The pad routines pad and never truncate: a string at or past the width is
## **  left alone. Trimming is STRCASE.RTRIM. Lengths are not checked.
## **
## ***********************************************************************
#IFNDEF STR.DEFS
#DEFINE STR.DEFS 1

GOTO STR.SKIP

## STR.PADR -- pad on the RIGHT to STR.WIDTH. Left justify.

STR.PADR:
    IF LEN(STR.STR$) < STR.WIDTH THEN STR.STR$ = STR.STR$ + RPT$(32, STR.WIDTH - LEN(STR.STR$))
    RETURN

## STR.PADL -- pad on the LEFT to STR.WIDTH. Right justify.

STR.PADL:
    IF LEN(STR.STR$) < STR.WIDTH THEN STR.STR$ = RPT$(32, STR.WIDTH - LEN(STR.STR$)) + STR.STR$
    RETURN

## STR.PADC -- pad BOTH sides to STR.WIDTH. An odd gap puts the extra space on the right.
##
## WARNING: the two guards are load bearing. RPT$ raises ILLEGAL QUANTITY on a count of
## zero rather than returning "", so a gap of 1 fails on the left call.

STR.PADC:
    STR.GAP = STR.WIDTH - LEN(STR.STR$)
    IF STR.GAP < 1 THEN RETURN
    STR.HALF = INT(STR.GAP / 2)
    IF STR.HALF > 0 THEN STR.STR$ = RPT$(32, STR.HALF) + STR.STR$
    STR.STR$ = STR.STR$ + RPT$(32, STR.WIDTH - LEN(STR.STR$))
    RETURN

## STR.SPLIT -- cut STR.STR$ into fields on STR.DELIM$.
##
##   in    STR.STR$    the string, read only -- SPLIT is the one routine here that
##                         does not modify it
##         STR.DELIM$  the separator, one character or several
##         STR.MAX     how many fields the array holds; 0 means 10
##   out   STR.N       how many fields were produced, always >= 1
##         STR.FIELD$  the fields, 1..STR.N
##
## STR.FIELD$ is not dimensioned here. Either leave it to GPC's implicit DIM, which
## gives 0..10, or DIM it yourself before the first call and set STR.MAX to match --
## DIMming one GPC already auto-dimensioned is an error.
##
## Empty fields are preserved: "A,,C" is three fields, "A," is two, "" is one. At the
## limit the last field takes the whole unsplit remainder.

STR.SPLIT:
    STR.N = 0 : STR.LIM = STR.MAX
    IF STR.LIM < 1 THEN STR.LIM = 10
    STR.REST$ = STR.STR$
STR.SPLIT.NEXT:
    STR.N = STR.N + 1
    IF STR.N >= STR.LIM THEN STR.FIELD$(STR.N) = STR.REST$ : RETURN
    STR.AT = GP.INSTR(STR.REST$, STR.DELIM$)
    IF STR.AT = 0 THEN STR.FIELD$(STR.N) = STR.REST$ : RETURN
    STR.FIELD$(STR.N) = LEFT$(STR.REST$, STR.AT - 1)
    STR.REST$ = MID$(STR.REST$, STR.AT + LEN(STR.DELIM$))
    GOTO STR.SPLIT.NEXT

## STR.REPLACE -- replace every occurrence of STR.FIND$ with STR.REPL$.
##
##   in    STR.STR$    the string, modified in place
##         STR.FIND$   what to look for. Case sensitive; GP.INSTR compares raw bytes
##         STR.REPL$   what to put in its place. Shorter, longer, or "" to delete
##
## A replacement containing what it replaces is safe -- "A" -> "AA" terminates, because
## only the unsearched remainder is scanned again. An empty STR.FIND$ leaves the string
## alone: GP.INSTR reports not found for a zero length needle.

STR.REPLACE:
    STR.OUT$ = "" : STR.REST$ = STR.STR$
STR.REPLACE.NEXT:
    STR.AT = GP.INSTR(STR.REST$, STR.FIND$)
    IF STR.AT = 0 THEN STR.STR$ = STR.OUT$ + STR.REST$ : RETURN
    STR.OUT$ = STR.OUT$ + LEFT$(STR.REST$, STR.AT - 1) + STR.REPL$
    STR.REST$ = MID$(STR.REST$, STR.AT + LEN(STR.FIND$))
    GOTO STR.REPLACE.NEXT

## STR.PET2SCR -- a PETSCII code to the screen code the tile map holds.
##
##   in    STR.PET     0..255, what ASC() gives you
##   out   STR.SCR     the screen code TILE, TDATA and VPOKE want
##
## GP.PRINTAT and GP.FILL do this internally; you need it when writing the map yourself.
## Nothing converts to 160..191, the reverse-video glyphs -- PETSCII says reverse with a
## control code, not a character. Swap the colour attribute instead.

STR.PET2SCR:
    STR.SCR = STR.PET
    IF STR.PET = 255 THEN STR.SCR = 94 : RETURN
    IF STR.PET < 32 THEN STR.SCR = STR.PET + 128 : RETURN
    IF STR.PET < 64 THEN RETURN
    IF STR.PET < 96 THEN STR.SCR = STR.PET - 64 : RETURN
    IF STR.PET < 128 THEN STR.SCR = STR.PET - 32 : RETURN
    IF STR.PET < 160 THEN STR.SCR = STR.PET + 64 : RETURN
    IF STR.PET < 192 THEN STR.SCR = STR.PET - 64 : RETURN
    STR.SCR = STR.PET - 128
    RETURN

STR.SKIP:
#ENDIF
