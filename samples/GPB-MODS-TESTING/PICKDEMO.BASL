#SAVEAS "@:PICKDEMO.SRC.PRG"
#REM 0
#SYMFILE "@:PICKDEMO.SRC.SYM"

## ***********************************************************************
## **
## **  PICKDEMO.BASL -- GUI.LISTBOX in multi select, with the GUI in a bank.
## **
## **  The smallest program that does both. Twenty rows, SPACE marks, RETURN
## **  accepts, and the marked ones are printed afterwards.
## **
## **  BUILD IT SHARED. GP.BANKED refuses an embedded build and says NOT
## **  IMPLEMENTED: the copy is done by the shared bootstrap, and there is no
## **  bootstrap in an embedded object to do it.
## **
## **      python source/gpc/build_basl.py     PICKDEMO.BASL    PICKDEMO.SRC.PRG
## **      python source/gpc/compile_shared.py PICKDEMO.SRC.PRG PICKDEMO.PRG
## **
## ***********************************************************************

#INCLUDE "GPB.INC.BL"
#INCLUDE "STASH.INC.BL"

## ---- THE GUI GOES IN A BANK, AND NOTHING THAT CALLS IT CHANGES. A GOSUB
## ---- from low memory into a region selects the region's bank, and RETURN
## ---- puts the caller's back.
## ----
## ---- THE GOTO OVER THE REGION IS NOT OPTIONAL. GP.BANKED leaves a bridge so
## ---- that falling into the region still works, and at program start it does
## ---- work, because the bootstrap leaves the code bank selected. Relying on
## ---- that means every module's GOTO ... MODULE.END runs from the bank for no
## ---- reason, and stops working the day anything selects another bank first.
## ----
## ---- THE BANK NUMBERS COME FIRST. BASLOAD resolves a #DEFINE only if it has
## ---- already read it, and GP.BANKED names them.

#DEFINE PD.GUICODE 4
#DEFINE PD.THEMECODE 9
#DEFINE PD.COMBOCODE 10

GOTO PD.LIBEND

## ---- THE GUI. Copy the three #DEFINEs and the three regions, and nothing else.
GP.BANKED PD.THEMECODE
#INCLUDE "THEME.INC.BL"
GP.ENDBANKED

GP.BANKED PD.GUICODE
#INCLUDE "MENUVERT.INC.BL"
#INCLUDE "LINEINPUT.INC.BL"
#INCLUDE "GUI.INC.BL"
#INCLUDE "GUI2.INC.BL"
GP.ENDBANKED

GP.BANKED PD.COMBOCODE
#INCLUDE "COMBO.INC.BL"
GP.ENDBANKED
PD.LIBEND:

## The caller owns the DIM -- a module cannot be handed an array.
DIM MENUVERT.ITEM$(20)

## TWO DIFFERENT BANKS, AND THEY MUST NOT BE THE SAME ONE. PD.GUICODE (4)
## holds the GUI's CODE for the life of the program.
## GUI.BANK is scratch: GUI.OPEN stashes the cells the dialog covers there and
## GUI.CLOSE puts them back. Point GUI.BANK at 4 and the dialog would write
## the screen over its own code.
GUI.BANK = 3

THEME.ID = 0 : GOSUB THEME.SELECT
SCREEN 1
GP.FILL 0, 0, 80, 30, ASC(" "), THEME.CLR(THEME.PAGE)

FOR PD.I = 1 TO 20
    MENUVERT.ITEM$(PD.I) = " ROW " + MID$(STR$(PD.I), 2)
NEXT PD.I

## ---- The listbox. MARKS$ is an input as well as an output: anything that is
## ---- not COUNT characters -- "" included -- starts with none marked.

GUI.TITLE$ = " PICK SOME "
GUI.MSG$ = "SPACE MARKS A ROW, RETURN ACCEPTS THE SET."
GUI.LISTBOX.COUNT = 20
GUI.LISTBOX.ROWS = 8
GUI.LISTBOX.MULTI = 1
GUI.LISTBOX.MARKS$ = ""
GUI.LISTBOX.SEL = 0
GOSUB GUI.LISTBOX

## ---- GUI.LISTBOX.SEL is where the CURSOR was, not the answer. In multi the
## ---- marks are the answer: MARKS$ is COUNT characters and "1" means marked.

IF GUI.KEY <> 13 THEN PRINT "CANCELLED" : END

PRINT GUI.LISTBOX.MARKED; "MARKED OF"; GUI.LISTBOX.COUNT
FOR PD.I = 1 TO GUI.LISTBOX.COUNT
    IF MID$(GUI.LISTBOX.MARKS$, PD.I, 1) = "1" THEN PRINT MENUVERT.ITEM$(PD.I)
NEXT PD.I
END
