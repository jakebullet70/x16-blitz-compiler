#SAVEAS "@:GUIFRMT.SRC.PRG"
#REM 0
#SYMFILE "@:GUIFRMT.SRC.SYM"

## ***********************************************************************
## **
## **  GUIFRMT.BASL -- GUI.FORM's focus model, checked without a keyboard.
## **
## **  Twenty-four assertions against GUI.YN, GUI.SAY, GUI.INPUT and
## **  GUI.LISTBOX, with the keys pushed into the KERNAL's buffer by
## **  kbdbuf_put. That is the only way to drive a GET loop headlessly, and it
## **  sets no modifiers -- so SHIFT+TAB is tested as the CODE 24, which proves
## **  the dispatcher handles it and proves nothing about what a real keyboard
## **  sends.
## **
## **  T1 TO T8 ARE THE BUTTON ROW, T9 TO T15 THE FIELD, T16 TO T24 THE LIST.
## **  The three that matter are T14, T15 and T22: the same C is text inside a
## **  field, the CANCEL accelerator one TAB away from it, and the CANCEL
## **  accelerator from INSIDE a list -- because a list eats SPACE and nothing
## **  else printable, and a field eats everything.
## **
## **  Each line is "Tn PASS" or "Tn FAIL want got", and the verdict line is
## **  "ALL TWENTY-FOUR PASS" -- stop an automated run on that. AFTER it, one more
## **  dialog is opened and left waiting on a key, so a -gif run has something
## **  to photograph; the digit in SHOT.TXT says how many TABs away from the
## **  field that picture is taken.
## **
## **      python source/gpc/build_basl.py     GUIFRMT.BASL    GUIFRMT.SRC.PRG
## **      python source/gpc/compile_shared.py GUIFRMT.SRC.PRG GUIFRMT.PRG
## **
## ***********************************************************************

#INCLUDE "GPB.INC.BL"
#INCLUDE "STASH.INC.BL"

#DEFINE KBDBUF.PUT $F09F
#DEFINE GIF.CTL $9FB5

#DEFINE K.TAB 9
#DEFINE K.SHTAB 24
#DEFINE K.RETURN 13
#DEFINE K.ESC 27
#DEFINE K.DOWN 17
#DEFINE K.END 4
#DEFINE K.SPACE 32

GOTO GF.LIBEND

#INCLUDE "LIB.GUIBANK.INC.BL"
GP.BANKED LIB.GUIBANK
#INCLUDE "THEME.INC.BL"
#INCLUDE "MENUVERT.INC.BL"
#INCLUDE "MENUBAR.INC.BL"
#INCLUDE "LINEINPUT.INC.BL"
#INCLUDE "GUI.INC.BL"
#INCLUDE "GUI2.INC.BL"
GP.ENDBANKED
GF.LIBEND:

DIM MENUVERT.ITEM$(12)

## ---- Eight items in a four row window, so every list test scrolls.

MENUVERT.ITEM$(1) = "ALPHA"
MENUVERT.ITEM$(2) = "BRAVO"
MENUVERT.ITEM$(3) = "CHARLIE"
MENUVERT.ITEM$(4) = "DELTA"
MENUVERT.ITEM$(5) = "ECHO"
MENUVERT.ITEM$(6) = "FOXTROT"
MENUVERT.ITEM$(7) = "GOLF"
MENUVERT.ITEM$(8) = "HOTEL"

## Bank 4 is the GUI's code. GUI.BANK is scratch for the covered cells and
## must not be the same one.
GUI.BANK = 3

THEME.ID = 0
GOSUB THEME.SELECT
SCREEN 1
GP.FILL 0, 0, 80, 30, ASC(" "), THEME.CLR(THEME.PAGE)

GF.FAILED = 0

## ---- T1  RETURN presses the button focus opened on, which is the default.

GOSUB GF.RESET
GF.KEY = K.RETURN
GOSUB GF.SEND
GUI.MSG$ = "T1 RETURN ON THE DEFAULT"
GOSUB GUI.YN
GF.NAME$ = "T1"
GF.WANT = -1
GF.GOT = GUI.ANSWER
GOSUB GF.CHECK

## ---- T2  TAB moves the focus off the default, so RETURN answers NO.

GOSUB GF.RESET
GF.KEY = K.TAB
GOSUB GF.SEND
GF.KEY = K.RETURN
GOSUB GF.SEND
GUI.MSG$ = "T2 TAB THEN RETURN"
GOSUB GUI.YN
GF.NAME$ = "T2"
GF.WANT = 0
GF.GOT = GUI.ANSWER
GOSUB GF.CHECK

## ---- T3  TAB twice wraps a row of two back to where it started.

GOSUB GF.RESET
GF.KEY = K.TAB
GOSUB GF.SEND
GOSUB GF.SEND
GF.KEY = K.RETURN
GOSUB GF.SEND
GUI.MSG$ = "T3 TAB TWICE WRAPS"
GOSUB GUI.YN
GF.NAME$ = "T3"
GF.WANT = -1
GF.GOT = GUI.ANSWER
GOSUB GF.CHECK

## ---- T4  SHIFT+TAB goes the other way, and wraps at the near end.

GOSUB GF.RESET
GF.KEY = K.SHTAB
GOSUB GF.SEND
GF.KEY = K.RETURN
GOSUB GF.SEND
GUI.MSG$ = "T4 SHIFT TAB WRAPS BACK"
GOSUB GUI.YN
GF.NAME$ = "T4"
GF.WANT = 0
GF.GOT = GUI.ANSWER
GOSUB GF.CHECK

## ---- T5  A bare letter presses its own button, wherever the focus is.

GOSUB GF.RESET
GF.KEY = ASC("N")
GOSUB GF.SEND
GUI.MSG$ = "T5 THE N ACCELERATOR"
GOSUB GUI.YN
GF.NAME$ = "T5"
GF.WANT = 0
GF.GOT = GUI.ANSWER
GOSUB GF.CHECK

## ---- T6  GUI.DEFAULT 2 opens with the focus on the second button.

GOSUB GF.RESET
GUI.DEFAULT = 2
GF.KEY = K.RETURN
GOSUB GF.SEND
GUI.MSG$ = "T6 DEFAULT TWO"
GOSUB GUI.YN
GF.NAME$ = "T6"
GF.WANT = 0
GF.GOT = GUI.ANSWER
GOSUB GF.CHECK

## ---- T7  ESC cancels from anywhere, and a cancel is NO.

GOSUB GF.RESET
GF.KEY = K.TAB
GOSUB GF.SEND
GF.KEY = K.ESC
GOSUB GF.SEND
GUI.MSG$ = "T7 ESC AFTER A TAB"
GOSUB GUI.YN
GF.NAME$ = "T7"
GF.WANT = 0
GF.GOT = GUI.ANSWER
GOSUB GF.CHECK

## ---- T8  A row of ONE has nowhere to move to, and TAB must not hang it.

GOSUB GF.RESET
GF.KEY = K.TAB
GOSUB GF.SEND
GF.KEY = K.RETURN
GOSUB GF.SEND
GUI.MSG$ = "T8 TAB IN A ROW OF ONE"
GUI.BTN.ONE$ = "&OK"
GOSUB GUI.SAY
GF.NAME$ = "T8"
GF.WANT = K.RETURN
GF.GOT = GUI.KEY
GOSUB GF.CHECK

## ---- T9   RETURN typed straight into the field is OK, wherever the eye is:
## ---- the field has nothing to press, so RETURN means the default button.
## ---- T10  and what was typed comes back with it.

GOSUB GF.RESET
GF.KEY = ASC("A")
GOSUB GF.SEND
GF.KEY = ASC("B")
GOSUB GF.SEND
GF.KEY = K.RETURN
GOSUB GF.SEND
GUI.MSG$ = "T9 TYPE THEN RETURN"
GOSUB GUI.INPUT
GF.NAME$ = "T9"
GF.WANT = -1
GF.GOT = GUI.OK
GOSUB GF.CHECK
GF.NAME$ = "T10"
GF.SWANT$ = "AB"
GF.SGOT$ = GUI.TEXT$
GOSUB GF.SCHECK

## ---- T11  TAB leaves the field for OK, and RETURN presses it.

GOSUB GF.RESET
GF.KEY = K.TAB
GOSUB GF.SEND
GF.KEY = K.RETURN
GOSUB GF.SEND
GUI.MSG$ = "T11 TAB TO OK"
GOSUB GUI.INPUT
GF.NAME$ = "T11"
GF.WANT = -1
GF.GOT = GUI.OK
GOSUB GF.CHECK

## ---- T12  TAB twice reaches CANCEL, which is not the default.

GOSUB GF.RESET
GF.KEY = K.TAB
GOSUB GF.SEND
GF.KEY = K.TAB
GOSUB GF.SEND
GF.KEY = K.RETURN
GOSUB GF.SEND
GUI.MSG$ = "T12 TAB TO CANCEL"
GOSUB GUI.INPUT
GF.NAME$ = "T12"
GF.WANT = 0
GF.GOT = GUI.OK
GOSUB GF.CHECK

## ---- T13  ESC cancels from inside the field.

GOSUB GF.RESET
GF.KEY = K.ESC
GOSUB GF.SEND
GUI.MSG$ = "T13 ESC IN THE FIELD"
GOSUB GUI.INPUT
GF.NAME$ = "T13"
GF.WANT = 0
GF.GOT = GUI.OK
GOSUB GF.CHECK

## ---- T14  A BARE C IN THE FIELD IS TEXT. CANCEL marks the same letter, and
## ---- the field is what has the focus, so nothing is pressed.

GOSUB GF.RESET
GF.KEY = ASC("C")
GOSUB GF.SEND
GF.KEY = K.RETURN
GOSUB GF.SEND
GUI.MSG$ = "T14 C IS TEXT IN THE FIELD"
GOSUB GUI.INPUT
GF.NAME$ = "T14"
GF.SWANT$ = "C"
GF.SGOT$ = GUI.TEXT$
GOSUB GF.SCHECK

## ---- T15  AND THE SAME C ON THE ROW IS THE ACCELERATOR. One TAB is the whole
## ---- difference between this and T14.

GOSUB GF.RESET
GF.KEY = K.TAB
GOSUB GF.SEND
GF.KEY = ASC("C")
GOSUB GF.SEND
GUI.MSG$ = "T15 C ON THE BUTTON ROW"
GOSUB GUI.INPUT
GF.NAME$ = "T15"
GF.WANT = 0
GF.GOT = GUI.OK
GOSUB GF.CHECK

## ---- T16  THE LIST OPENS WITH THE FOCUS ON ITSELF, and RETURN there means
## ---- the default button, exactly as it does in a field.

GOSUB GF.RESET
GF.KEY = K.RETURN
GOSUB GF.SEND
GUI.MSG$ = "T16 RETURN IN THE LIST"
GOSUB GUI.LISTBOX
GF.NAME$ = "T16"
GF.WANT = 1
GF.GOT = GUI.LISTBOX.SEL
GOSUB GF.CHECK

## ---- T17  DOWN belongs to the list, not to the form. Two of them move the
## ---- cursor and leave the focus where it was.

GOSUB GF.RESET
GF.KEY = K.DOWN
GOSUB GF.SEND
GOSUB GF.SEND
GF.KEY = K.RETURN
GOSUB GF.SEND
GUI.MSG$ = "T17 DOWN TWICE"
GOSUB GUI.LISTBOX
GF.NAME$ = "T17"
GF.WANT = 3
GF.GOT = GUI.LISTBOX.SEL
GOSUB GF.CHECK

## ---- T18  ESC cancels from inside the list.

GOSUB GF.RESET
GF.KEY = K.ESC
GOSUB GF.SEND
GUI.MSG$ = "T18 ESC IN THE LIST"
GOSUB GUI.LISTBOX
GF.NAME$ = "T18"
GF.WANT = 0
GF.GOT = GUI.LISTBOX.SEL
GOSUB GF.CHECK

## ---- T19  END jumps past the bottom of a four row window, which is the
## ---- scroller doing its job with three controls on the form instead of one.

GOSUB GF.RESET
GF.KEY = K.END
GOSUB GF.SEND
GF.KEY = K.RETURN
GOSUB GF.SEND
GUI.MSG$ = "T19 END SCROLLS"
GOSUB GUI.LISTBOX
GF.NAME$ = "T19"
GF.WANT = 8
GF.GOT = GUI.LISTBOX.SEL
GOSUB GF.CHECK

## ---- T20  TAB moves the focus off the list and onto OK, and RETURN presses
## ---- the button it is standing on. The answer is the row it left behind.

GOSUB GF.RESET
GF.KEY = K.TAB
GOSUB GF.SEND
GF.KEY = K.RETURN
GOSUB GF.SEND
GUI.MSG$ = "T20 TAB TO OK"
GOSUB GUI.LISTBOX
GF.NAME$ = "T20"
GF.WANT = 1
GF.GOT = GUI.LISTBOX.SEL
GOSUB GF.CHECK

## ---- T21  One TAB further is CANCEL.

GOSUB GF.RESET
GF.KEY = K.TAB
GOSUB GF.SEND
GOSUB GF.SEND
GF.KEY = K.RETURN
GOSUB GF.SEND
GUI.MSG$ = "T21 TAB TO CANCEL"
GOSUB GUI.LISTBOX
GF.NAME$ = "T21"
GF.WANT = 0
GF.GOT = GUI.LISTBOX.SEL
GOSUB GF.CHECK

## ---- T22  AND THE PAIR THAT MATTERS FOR A LIST. A bare C with the focus
## ---- still IN the list presses CANCEL, because a list eats SPACE and
## ---- nothing else printable. T14 is the same key against a field, where it
## ---- is text -- the two together are the whole accelerator rule.

GOSUB GF.RESET
GF.KEY = ASC("C")
GOSUB GF.SEND
GUI.MSG$ = "T22 C FROM INSIDE THE LIST"
GOSUB GUI.LISTBOX
GF.NAME$ = "T22"
GF.WANT = 0
GF.GOT = GUI.LISTBOX.SEL
GOSUB GF.CHECK

## ---- T23  MULTI SELECT STILL WORKS, which is what phase 4 is checked on.
## ---- SPACE marks, DOWN moves, SPACE marks again, RETURN accepts.

GOSUB GF.RESET
GUI.LISTBOX.MULTI = 1
GF.KEY = K.SPACE
GOSUB GF.SEND
GF.KEY = K.DOWN
GOSUB GF.SEND
GF.KEY = K.SPACE
GOSUB GF.SEND
GF.KEY = K.RETURN
GOSUB GF.SEND
GUI.MSG$ = "T23 TWO MARKS"
GOSUB GUI.LISTBOX
GF.NAME$ = "T23"
GF.WANT = 2
GF.GOT = GUI.LISTBOX.MARKED
GOSUB GF.CHECK

## ---- T24  and the marks are where they were put, not just counted.

GF.NAME$ = "T24"
GF.SWANT$ = "11000000"
GF.SGOT$ = GUI.LISTBOX.MARKS$
GOSUB GF.SCHECK

PRINT
IF GF.FAILED = 0 THEN PRINT "ALL TWENTY-FOUR PASS"
IF GF.FAILED <> 0 THEN PRINT "FAILURES:"; GF.FAILED

## ---- THE PICTURE. GUI.INPUT is opened last and left waiting on a key, so a
## ---- -gif run photographs a REAL form state and not a reconstruction of one.
## ---- Which state is the digit in SHOT.TXT, counted in TABs away from the
## ---- field: 0 leaves the cursor in the field, 1 puts the focus on OK, 2 on
## ---- CANCEL. <<OK>> stays doubled in all three, because only the focus moved
## ---- and the default did not -- which is the whole of what phase 3 added.
## ----
## ---- The assertions have already printed, so an automated run stops on their
## ---- verdict line and never reaches any of this.

GOSUB GF.PICKSHOT

GOSUB GF.RESET
GUI.TITLE$ = " FOCUS "
GUI.TEXT$ = "GPC"
GUI.MSG$ = "THE CURSOR IS IN THE FIELD. NO BUTTON IS LIT."
IF GF.SHOT = 1 THEN GUI.MSG$ = "ONE TAB IN. THE FOCUS IS ON THE DEFAULT."
IF GF.SHOT = 2 THEN GUI.MSG$ = "TWO TABS IN. THE FOCUS LEFT THE DEFAULT."
GUI.MSG2$ = "<<OK>> IS DOUBLED BECAUSE IT IS THE DEFAULT."

IF GF.SHOT >= 1 THEN GOSUB GF.TAB
IF GF.SHOT >= 2 THEN GOSUB GF.TAB

POKE GIF.CTL, 2
GOSUB GUI.INPUT
END


## ***********************************************************************
## **  GF.PICKSHOT -- which picture this run is for.
## **
## **  A missing SHOT.TXT is not an error: GET# hands back "" and the shot is
## **  the field, which is the one worth having.
## ***********************************************************************

GF.PICKSHOT:
    GF.SHOT = 0
    OPEN 1, 8, 2, "SHOT.TXT,S,R"
    GET# 1, GF.CH$
    CLOSE 1
    IF GF.CH$ <> "" THEN GF.SHOT = ASC(GF.CH$) - 48
    IF GF.SHOT < 0 THEN GF.SHOT = 0
    IF GF.SHOT > 2 THEN GF.SHOT = 0
    RETURN


## ***********************************************************************
## **  GF.TAB -- one TAB into the buffer, before the dialog opens.
## **
## **  Not a FOR loop: FOR 1 TO 0 runs once here, so a shot of 0 would move
## **  the focus it is meant to photograph.
## ***********************************************************************

GF.TAB:
    GF.KEY = K.TAB
    GOSUB GF.SEND
    RETURN


## ***********************************************************************
## **  GF.RESET -- the sticky inputs, back to a known state.
## **
## **  Every GUI input is sticky by design, so a test that did not set one
## **  would inherit the previous test's value and pass for the wrong reason.
## ***********************************************************************

GF.RESET:
    GUI.TITLE$ = " GUI.FORM "
    GUI.MSG2$ = ""
    GUI.MSG3$ = ""
    GUI.DEFAULT = 1
    GUI.OKCANCEL = 0
    GUI.BTN.ONE$ = ""
    GUI.BTN.TWO$ = ""
    GUI.PLACE = 0
    GUI.SHADOW = 0
    GUI.STYLE = 0
    GUI.TEXT$ = ""
    GUI.LEN = 20
    GUI.MASK = 0
    GUI.LISTBOX.COUNT = 8
    GUI.LISTBOX.ROWS = 4
    GUI.LISTBOX.MULTI = 0
    GUI.LISTBOX.MARKS$ = ""
    GUI.LISTBOX.SEL = 0
    RETURN


## ***********************************************************************
## **  GF.SEND -- one key into the KERNAL's buffer.
## **
## **  kbdbuf_put lives in ROM bank 0 and compiled code runs in bank 4, hence
## **  the two POKEs.
## ***********************************************************************

GF.SEND:
    POKE 1, 0
    GP.CALL KBDBUF.PUT, GF.KEY
    POKE 1, 4
    RETURN


## ***********************************************************************
## **  GF.CHECK -- one assertion, printed.
## ***********************************************************************

GF.CHECK:
    IF GF.GOT = GF.WANT THEN PRINT GF.NAME$ + " PASS"
    IF GF.GOT = GF.WANT THEN RETURN
    PRINT GF.NAME$ + " FAIL WANT"; GF.WANT; "GOT"; GF.GOT
    GF.FAILED = GF.FAILED + 1
    RETURN


## ***********************************************************************
## **  GF.SCHECK -- the same assertion on a string.
## **
## **  What a field gives back is text, and GF.CHECK compares numbers.
## ***********************************************************************

GF.SCHECK:
    IF GF.SGOT$ = GF.SWANT$ THEN PRINT GF.NAME$ + " PASS"
    IF GF.SGOT$ = GF.SWANT$ THEN RETURN
    PRINT GF.NAME$ + " FAIL WANT [" + GF.SWANT$ + "] GOT [" + GF.SGOT$ + "]"
    GF.FAILED = GF.FAILED + 1
    RETURN
