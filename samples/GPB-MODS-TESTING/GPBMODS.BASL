#SAVEAS "@:GPBMODS.SRC.PRG"
#SYMFILE "@:GPBMODS.SRC.SYM"
#INCLUDE "GPB.INC.BL"
#INCLUDE "STASH.INC.BL"
#INCLUDE "STASHFILE.INC.BL"

## ---- THE PROGRAM'S LITERAL TEXT LIVES IN A BANK. Every GP.BANKEDSTR block below
## ---- names this, and it is CLAIMED from BANKMGR at startup for the same reason
#DEFINE GM.TEXTBANK 5

## ---- A SECOND TEXT BANK
#DEFINE GM.TEXTBANKB 6

## ---- THE GUI RUNS FROM A RAM BANK, AND SO DO THE UTILITIES AND THE FILE
## ---- MODULES. Each region below is preceded by the one file that opens it:
## ---- LIB.UTILBANK.INC.BL, LIB.GUIBANK.INC.BL, LIB.FUTILBANK.INC.BL. A front
## ---- door is a shim an entry point, selecting the bank and calling the body,
## ---- and it names the bank as well -- the #DEFINE lives there, not here. To
## ---- lift a bank into another program, copy the front door and the modules
## ---- listed under it, and nothing else.
## ----
## ---- THREE REGIONS AND NOT ONE, because a region may not call another: they
## ---- all live at $A000, so the branch has no distance to travel and the
## ---- compiler refuses it. They are independent here -- the only call the
## ---- GUI bank makes downwards is to STASH, which is in low memory.
## ----
## ---- THE GOTO JUMPS EACH REGION rather than falling into it through the
## ---- bridge GP.BANKED leaves; see the front doors for why that matters. The
## ---- shims sit inside the jumped span too, and each front door repeats the
## ---- jump internally, so they are skipped either way.
## ----
## ---- WHAT STAYS IN LOW RAM is what holds a BANK statement, which the
## ---- compiler refuses inside a region: STASH, STASHFILE, and the three
## ---- front doors themselves. GPB.INC.BL is definitions and no code.

GOTO GM.LIBEND

## ---- THE UTILITIES. Copy LIB.UTILBANK.INC.BL and these seven.
#INCLUDE "LIB.UTILBANK.INC.BL"
GP.BANKED LIB.UTILBANK
#INCLUDE "APPSYS.INC.BL"
#INCLUDE "BANKMGR.INC.BL"
#INCLUDE "STRCASE.INC.BL"
#INCLUDE "STRINGS.INC.BL"
#INCLUDE "STRUSING.INC.BL"
#INCLUDE "SORT.INC.BL"
#INCLUDE "STASHVRAM.INC.BL"
GP.ENDBANKED

## ----  GUI crap in a bank! Copy LIB.GUIBANK.INC.BL and these six
#INCLUDE "LIB.GUIBANK.INC.BL"
GP.BANKED LIB.GUIBANK
#INCLUDE "THEME.INC.BL"
#INCLUDE "MENUVERT.INC.BL"
#INCLUDE "MENUBAR.INC.BL"
#INCLUDE "LINEINPUT.INC.BL"
#INCLUDE "GUI.INC.BL"
#INCLUDE "GUI2.INC.BL"
GP.ENDBANKED

## ---- File utils in a bank! Copy LIB.FUTILBANK.INC.BL and these two.
#INCLUDE "LIB.FUTILBANK.INC.BL"
GP.BANKED LIB.FUTILBANK
#INCLUDE "FILEIO.INC.BL"
#INCLUDE "FILEDIR.INC.BL"
GP.ENDBANKED


GP.BANKEDSTR GM.TEXTBANK BS.LIBEND
  "CODE BANK IS ALREADY TAKEN"
  "NO SCRATCH BANK LEFT"
  "NOTHING RUN YET"
  "TEXT BANK IS ALREADY TAKEN"
  "NO DIRECTORY BANK LEFT"
  "UTILITY BANK IS ALREADY TAKEN"
  "FILEDIR BANK IS ALREADY TAKEN"
GP.ENDBANKEDSTR
GM.LIBEND:

## ***********************************************************************
## **
## **  GPBMODS.BASL -- a development harness for the GPC-BASIC library.
## **
## **  Nine bar items, one dropdown each, and every item in a dropdown is one
## **  library entry point.
## **
## **  THERE ARE NO STUBS. Every menu item calls the library for real and shows what
## **  came back, on the panel and again on the LAST line of the page.
## **
## **  FILES WRITES TO THE DRIVE. Four of its rows do, everything they make is
## **  named GPBFILE.* or GPBDIR, and the two files are scratched by the row
## **  that made them. The directory is not: FILEIO has no RMDIR.
## **
## **  The shell is itself a test of three modules: MENUBAR drives the bar,
## **  MENUVERT every dropdown, and STASH puts the screen back under a closed one.
## **
## **  It also holds every module at once, which is what the p-code map is
## **  read off. See PLAN.md.
## **
## **  Keys:
## **      LEFT RIGHT    walk the bar
## **      DOWN RETURN   open the dropdown under the marked item
## **      LEFT RIGHT    with a dropdown open, move to the next one
## **      UP DOWN       walk the dropdown, RETURN chooses
## **      ESC           closes the dropdown, then leaves the program
## **
## **  FIVE BANKS. Two are picked while the object is written and so are named
## **  in the source -- 4 for the GUI and FILEDIR code, 5 and 6 for the literal
## **  text -- and are CLAIMED from BANKMGR so nothing else is handed them.
## **  Three are asked for at run time and could be any number that is free:
## **  the cells under an open dropdown, the cells under a dialog, and the
## **  buffer one directory listing is read into. ABOUT / BANK MAP and
## **  ABOUT / MEMORY read all five back.
## **
## **  UPPER CASE LITERALS ONLY. GP.PRINTAT converts PETSCII and BASLOAD passes
## **  literals through as source bytes, so lower case lands on the graphics
## **  half of the default font.
## **
## ***********************************************************************

## The screen this is laid out for. 1 is 80x30, 0 is 80x60.
#DEFINE GM.MODE 1

## The bar sits on row 0 and the first item starts here.
#DEFINE GM.BARX 1

## PETSCII, as GET reports it -- the two keys MENUVERT.KEYEXIT hands back.
#DEFINE GM.LEFT 157
#DEFINE GM.RIGHT 29

## The caller owns the DIM. Thirty-two covers the bar's nine, the longest
## dropdown, and the twenty-four row list GUI.LISTBOX is shown with. Do not
## also leave it implicit.
DIM MENUVERT.ITEM$(32)

## STR.SPLIT's fields, and STR.MAX is set to match at every call site. GPC's implicit
## DIM is documented to give 0..10 and does not reach this one: without the DIM the
## first STR.SPLIT writes wild and the string heap comes back as machine code.
DIM STR.FIELD$(10)

## The ten words DATA sorts, and the array GP.ARRPTR is shown reading the
## header of. Ten because the panel gives it one row each under a heading.
DIM GM.SORT$(9)

## THE INPUT PANELS' FIELD TABLE. Four entries, three of them used: an
## undimensioned array is 0..10 whatever it holds, and an untyped element is
## SIX bytes, so leaving these four implicit spent 220 bytes of the string
## heap on eleven slots to hold three fields. Dimensioned and typed they are
## 32. % rather than plain because a screen row, a length and a flag are all
## small whole numbers -- see GMX.I.RUNFORM.
DIM GM.FY%(3)
DIM GM.FLEN%(3)
DIM GM.FMASK%(3)
DIM GM.FLD$(3)

## FILE.LINE$() is the caller's DIM, like MENUVERT.ITEM$. Sixteen because
## FILES / SAVEARRAY + LOADARRAY sets FILE.MAX to 16 to show a load coming
## back short; the implicit DIM would only give 10.
DIM FILE.LINE$(16)

## APPSYS.STARTUP first, before any SCREEN of our own: it records the screen
## the user had, and that is what APPSYS.RESTORE puts back.
GOSUB APPSYS.STARTUP
SCREEN GM.MODE

## Asked after the mode change, not before. APPSYS.STARTUP reported the size
## of the screen the user had, not the one just set.
GP.CALL APPSYS.SCRMODE, 0, 0, 0, 1
APPSYS.COLS = GP.X : APPSYS.ROWS = GP.Y

THEME.ID = 0 : GOSUB THEME.SELECT

## A CODE BANK IS CLAIMED AND A DATA BANK IS ALLOCATED, and the difference is
## not a style choice. GP.BANKED takes a decimal constant read while the object
## is being written, so the COMPILER picks the code bank and the manager is only
## TOLD -- which is what stops a later GET.FREE.BANK handing that bank to a
## panel that would then write screen cells over the GUI's own code.
##
## The two scratch banks are the opposite: nothing needs their numbers before
## the program runs, so nothing names them. They are whatever is free.
GOSUB BANKMGR.INIT : GM.BANKFAIL$ = ""

BANKMGR.SET.BANK = LIB.GUIBANK : GOSUB BANKMGR.CLAIM
IF BANKMGR.OK = 0 THEN GM.BANKFAIL$ = GP.BSTR(BS.LIBEND, 0)

BANKMGR.SET.BANK = GM.TEXTBANK : GOSUB BANKMGR.CLAIM
IF BANKMGR.OK = 0 THEN GM.BANKFAIL$ = GP.BSTR(BS.LIBEND, 3)

BANKMGR.SET.BANK = GM.TEXTBANKB : GOSUB BANKMGR.CLAIM
IF BANKMGR.OK = 0 THEN GM.BANKFAIL$ = GP.BSTR(BS.LIBEND, 3)

BANKMGR.SET.BANK = LIB.UTILBANK : GOSUB BANKMGR.CLAIM
IF BANKMGR.OK = 0 THEN GM.BANKFAIL$ = GP.BSTR(BS.LIBEND, 5)

BANKMGR.SET.BANK = LIB.FUTILBANK : GOSUB BANKMGR.CLAIM
IF BANKMGR.OK = 0 THEN GM.BANKFAIL$ = GP.BSTR(BS.LIBEND, 6)

GOSUB BANKMGR.GET.FREE.BANK : GM.DDBANK% = BANKMGR.BANK
GOSUB BANKMGR.GET.FREE.BANK : GM.GUIBANK% = BANKMGR.BANK
IF GM.GUIBANK% = 0 THEN GM.BANKFAIL$ = GP.BSTR(BS.LIBEND, 1)

## A whole bank for one directory listing, read in one go and then walked
## without going near the drive again. See FILES / FILE.DIR.OPEN.
GOSUB BANKMGR.GET.FREE.BANK : GM.DIRBANK% = BANKMGR.BANK
IF GM.DIRBANK% = 0 THEN GM.BANKFAIL$ = GP.BSTR(BS.LIBEND, 4)

IF GM.BANKFAIL$ <> "" THEN GOTO GM.BANKSTOP

## STASHVRAM KEEPS ITS HANDLE TABLE IN THE CALLER'S ARRAYS, so the caller
## dims them, and SV.MAX has to agree with the DIM or SV.RESET walks off the
## end. Eight is what the panel needs and the table costs 2 bytes an entry.
SV.MAX = 8
DIM SV.PAGE%(SV.MAX)
DIM SV.PAGES%(SV.MAX)
GOSUB SV.INIT
IF SV.OK = 0 THEN GM.BANKFAIL$ = SV.ERROR$

## FILEDIR sizes FILE.NAME$ here and keeps the block's address. Nothing may
## assign a longer name afterwards -- see FILEDIR.INC.BL, "assign either
## after FILE.DIR.INIT".
GOSUB FILE.DIR.INIT

GM.SEL% = 1 : GM.OPEN% = 0

## Where a panel writes what it got back, and what stands there before one has run.
GM.RESY% = APPSYS.ROWS - 3 : GM.RESULT$ = GP.BSTR(BS.LIBEND, 2)

GOSUB GMX.CHROME

## ---- The shell. GM.OPEN% is set by a dropdown that ended on LEFT or RIGHT,
## ---- and it means "the bar has already moved, go straight back down".
## ----
## ---- GM.DODROP% IS WHAT A REFUSED QUIT NEEDS. ESC on the bar returns SEL 0,
## ---- and answering NO to the prompt leaves that 0 standing -- so GM.SEL% must
## ---- not be written from it, and the dropdown must not open on it. The flag
## ---- is the only thing that separates "chose nothing" from "chose item n".

GP.DO
  GM.DODROP% = 1
  GP.IF GM.OPEN% = 0 THEN
    GOSUB GMX.BAR
    GP.IF MENUBAR.SEL = 0 THEN
      GOSUB GMX.QUIT
      GP.IF GM.QUIT% <> 0 THEN
        GP.EXITDO
      GP.ENDIF
      GM.DODROP% = 0
    GP.ELSE
      GM.SEL% = MENUBAR.SEL
    GP.ENDIF
  GP.ENDIF
  GM.OPEN% = 0
  GP.IF GM.DODROP% = 1 THEN
    GOSUB GMX.DROP
  GP.ENDIF
GP.LOOP

GOSUB APPSYS.RESTORE
END


## ***********************************************************************
## **  GMX.QUIT -- ESC on the bar asks before it leaves.
## **
## **  GUI.YN PUTS THE SCREEN BACK ITSELF, so a NO needs nothing repainted:
## **  the loop goes straight round to GMX.BAR with the bar exactly as the
## **  dialog found it.
## **
## **  GUI.ANSWER IS -1 FOR YES, not 1. Tested against 0 rather than 1 for
## **  that reason -- see the note under GMX.D.YN.
## ***********************************************************************


GP.BANKEDSTR GM.TEXTBANKB BS.QUIT
  " QUIT "
  "LEAVE GPB-MODS-TESTING?"
  "ESC AND NO BOTH STAY HERE."
GP.ENDBANKEDSTR
GMX.QUIT:
  GOSUB GMX.D.RESET
  GUI.TITLE$ = GP.BSTR(BS.QUIT, 0)
  GUI.MSG$ = GP.BSTR(BS.QUIT, 1)
  GUI.MSG2$ = GP.BSTR(BS.QUIT, 2)
  GOSUB GUI.YN
  GM.QUIT% = GUI.ANSWER
  RETURN


## ***********************************************************************
## **  GMX.CHROME -- the page, the bar row and the key line.
## **
## **  Redrawn whole rather than patched: a theme change repaints everything
## **  from here, and nothing is left behind by a shorter string.
## **
## **  IT PUTS THE BAR BACK ITSELF. The second GP.FILL blanks row 0, and a
## **  panel that repaints the chrome and then waits for a key -- GMX.THEME
## **  does exactly that, on purpose -- would sit there with an empty bar
## **  until the next GMX.BAR redrew it.
## ***********************************************************************


GP.BANKEDSTR GM.TEXTBANK BS.CHROME
  "GPB-MODS-TESTING -- A DEVELOPMENT HARNESS FOR THE GPC-BASIC LIBRARY"
  "<- ->  BAR   DOWN  OPEN   TAB  FOCUS   RETURN  CHOOSE   ESC  BACK / QUIT"
GP.ENDBANKEDSTR
GP.BANKEDSTR GM.TEXTBANK BS.HEAP
  "HEAP  FRE(0) "
  "   LOWEST THIS RUN "
GP.ENDBANKEDSTR
GMX.CHROME:
  GP.FILL 0, 0, APPSYS.COLS, APPSYS.ROWS, ASC(" "), THEME.CLR(THEME.PAGE)
  GP.FILL 0, 0, APPSYS.COLS, 1, ASC(" "), THEME.CLR(THEME.TITLE)
  GP.PRINTAT 2, 2, GP.BSTR(BS.CHROME, 0), THEME.CLR(THEME.TEXT)
  GM.KEYS$ = GP.BSTR(BS.CHROME, 1)
  GP.PRINTAT 2, APPSYS.ROWS - 1, GM.KEYS$, THEME.CLR(THEME.DIMMED)
  GOSUB GMX.BARDRAW
  GOSUB GMX.RESULT
  GOSUB GMX.HEAP
  RETURN


## ***********************************************************************
## **  GMX.HEAP -- the string heap, on the footer, in the title colour.
## **
## **  FRE(0) IS THE STRING HEAP AND NOT MUCH ELSE. The p-code, the workspace
## **  and the arrays are all fixed at compile or DIM time; what moves while
## **  the program runs is string blocks, and a concrete one is never freed --
## **  only flagged dead and re-fitted. So a panel that builds long temporaries
## **  can spend the heap and never give it back, and OUT OF MEMORY arrives at
## **  whatever routine next asks for one rather than at the one that spent it.
## **
## **  LOW IS THE POINT. A single figure says nothing; the lowest seen this
## **  session is what shows a panel eating the heap and not returning it.
## ***********************************************************************

GMX.HEAP:
  GM.FRE = FRE(0) : IF GM.FRELOW = 0 THEN GM.FRELOW = GM.FRE
  IF GM.FRE < GM.FRELOW THEN GM.FRELOW = GM.FRE
  GM.HEAP$ = GP.BSTR(BS.HEAP, 0) + MID$(STR$(GM.FRE), 2) + GP.BSTR(BS.HEAP, 1) + MID$(STR$(GM.FRELOW), 2)
  GP.FILL 2, APPSYS.ROWS - 2, APPSYS.COLS - 4, 1, ASC(" "), THEME.CLR(THEME.PAGE)
  GP.PRINTAT 2, APPSYS.ROWS - 2, GM.HEAP$, THEME.CLR(THEME.TITLE)
  RETURN


## ---- GMX.BARDRAW -- every bar item, and the highlight if there is one to
## ---- put. GM.BARWAS% is what is highlighted ON SCREEN right now, which is
## ---- what lets GMX.DROP repaint two items instead of nine. Cleared first,
## ---- so a GP.STOP between the two draws leaves it honest.
## ----
## ---- GM.SEL% is 0 before the first pass round the shell, and MENUBAR.MARK on
## ---- item 0 would read MENUVERT.ITEM$(0), which nothing fills.

GMX.BARDRAW:
  GOSUB GMX.BAR.LOAD : GM.BARWAS% = 0 : GOSUB MENUBAR.DRAW
  GP.IF GM.SEL% > 0 THEN
    MENUBAR.SEL = GM.SEL%
    GOSUB MENUBAR.MARK
    GM.BARWAS% = GM.SEL%
  GP.ENDIF
  RETURN


## ***********************************************************************
## **  GMX.RESULT -- what the last panel came back with.
## **
## **  Its own row, so a panel says what it returned without opening a second
## **  dialog to say it. GMX.CHROME calls it, so a repaint keeps it. No label
## **  in front of it -- the row is always the last answer and never anything
## **  else, so naming it only ate six columns.
## ***********************************************************************


GMX.RESULT:
  GP.FILL 2, GM.RESY%, APPSYS.COLS - 4, 1, ASC(" "), THEME.CLR(THEME.PAGE)
  GP.PRINTAT 2, GM.RESY%, GM.RESULT$, THEME.CLR(THEME.WARN)
  RETURN


## ***********************************************************************
## **  GMX.BAR -- draw the bar and drive it.
## **
## **   out  MENUBAR.SEL   the item, or 0 if ESC ended it
## **
## **  DOWNEXIT is what makes this a bar over dropdowns: DOWN ends the call
## **  so the caller can open the panel. KEEPMARK leaves the highlight on
## **  while it is open.
## ***********************************************************************

GMX.BAR:
  GOSUB GMX.BAR.LOAD : MENUBAR.FLAGS = MENUBAR.DOWNEXIT + MENUBAR.KEEPMARK
  MENUBAR.SEL = GM.SEL% : GOSUB MENUBAR.RUN
  GM.BARWAS% = MENUBAR.SEL
  RETURN


## ---- The bar's own array. MENUBAR and MENUVERT share it, so it is reloaded
## ---- on every use of either. An item's width is its text, which is why the
## ---- padding is in the string.


GP.BANKEDSTR GM.TEXTBANK BS.BAR.LOAD
  "DLISGATBF"
  " DIALOG "
  " LISTS "
  " INPUT "
  " SCREEN "
  " STRINGS "
  " DATA "
  " THEME "
  " ABOUT "
  " FILES "
GP.ENDBANKEDSTR
GMX.BAR.LOAD:

## The hotkey string is index 0, where a dropdown keeps its title. A hotkey need
## not be an item's initial -- SCREEN and STRINGS both start S, so STRINGS answers
## to G. HOTATTR tints whichever letter it finds.
  MENUVERT.HOT$ = GP.BSTR(BS.BAR.LOAD, 0)
  MENUVERT.COUNT = GP.BSTRCOUNT(BS.BAR.LOAD) - 1

## GM.BARN% is the same number, kept. MENUVERT.COUNT is the dropdown's by the time
## GMX.DROP walks sideways off one, so the bar's own count has to survive that.
  GM.BARN% = MENUVERT.COUNT
  FOR GM.I = 1 TO MENUVERT.COUNT
    MENUVERT.ITEM$(GM.I) = GP.BSTR(BS.BAR.LOAD, GM.I)
  NEXT GM.I
  MENUVERT.ATTR = THEME.CLR(THEME.TEXT)
  MENUVERT.HIATTR = THEME.CLR(THEME.HILITE)
  MENUVERT.HOTATTR = THEME.CLR(THEME.TITLE)
  MENUBAR.X = GM.BARX : MENUBAR.Y = 0 : MENUBAR.GAP = 0
  RETURN


## ***********************************************************************
## **  GMX.DROP -- the dropdown under the marked bar item.
## **
## **  Re-marks the bar first, so this is the same whether it was reached from
## **  MENUBAR.RUN or from a sideways exit out of another dropdown.
## **  MENUBAR.WHERE then reports the column and width of the item.
## **
## **  TWO ITEMS, NOT NINE. A sideways exit comes straight back here, so this
## **  is the walk when a dropdown is open, and redrawing the whole bar a step
## **  makes it crawl. GM.BARWAS% says what the highlight is sitting on, so the
## **  bar only has to be drawn whole when nothing is on it.
## **
## **  KEYEXIT hands LEFT and RIGHT back instead of swallowing them, which is
## **  the other half of MENUBAR.DOWNEXIT.
## ***********************************************************************

GMX.DROP:
  GOSUB GMX.BAR.LOAD : MENUBAR.SEL = GM.SEL%
  GP.IF GM.BARWAS% = 0 THEN
    GOSUB MENUBAR.DRAW
  GP.ELSE
    MENUBAR.DRAWN = GM.BARWAS% : MENUBAR.PAINT = MENUVERT.ATTR
    GOSUB MENUBAR.ITEM
  GP.ENDIF
  GOSUB MENUBAR.MARK : GM.BARWAS% = GM.SEL% : GOSUB MENUBAR.WHERE : GOSUB GMX.DD.LOAD

## ---- the highlight is one cell wider than the longest row ----
  GM.DDW% = 0
  FOR GM.I = 1 TO MENUVERT.COUNT
    IF LEN(MENUVERT.ITEM$(GM.I)) > GM.DDW% THEN GM.DDW% = LEN(MENUVERT.ITEM$(GM.I))
  NEXT GM.I
  GM.DDW% = GM.DDW% + 1

  GM.DDX% = MENUBAR.SELX : GM.DDY% = 1
  IF GM.DDX% + GM.DDW% + 2 > APPSYS.COLS THEN GM.DDX% = APPSYS.COLS - GM.DDW% - 2

## ---- what the frame and the rows will cover, saved before either is drawn ----
  STASH.BANK = GM.DDBANK%
  STASH.X = GM.DDX% : STASH.Y = GM.DDY%
  STASH.W = GM.DDW% + 2 : STASH.H = MENUVERT.COUNT + 2
  GOSUB STASH.SAVE

  GP.FILL GM.DDX%, GM.DDY%, GM.DDW% + 2, MENUVERT.COUNT + 2, ASC(" "), THEME.CLR(THEME.TEXT)
  GP.BOX GM.DDX%, GM.DDY%, GM.DDW% + 2, MENUVERT.COUNT + 2, 2, THEME.CLR(THEME.BORDER)

  MENUVERT.X = GM.DDX% + 1 :MENUVERT.Y = GM.DDY% + 1
  MENUVERT.WIDTH = GM.DDW% : MENUVERT.FLAGS = MENUVERT.KEYEXIT
  MENUVERT.SEL = 0 : GOSUB MENUVERT.RUN

## ---- the screen back, before anything else draws on it ----
  STASH.BANK = GM.DDBANK% : STASH.MOVE = 0 : GOSUB STASH.RESTORE

  GP.SELECT MENUVERT.KEY
  GP.CASE GM.LEFT
    GM.SEL% = GM.SEL% - 1 : IF GM.SEL% < 1 THEN GM.SEL% = GM.BARN%
    GM.OPEN% = 1
  GP.CASE GM.RIGHT
    GM.SEL% = GM.SEL% + 1 : IF GM.SEL% > GM.BARN% THEN GM.SEL% = 1
    GM.OPEN% = 1
  GP.OTHER
    IF MENUVERT.SEL > 0 THEN GOSUB GMX.DISPATCH
  GP.ENDSEL
  RETURN


## ***********************************************************************
## **  GMX.DD.LOAD -- one dropdown's rows, and the bar item's name.
## **
## **  MENUVERT.HOT$ IS EMPTIED. The bar's letters are still in it otherwise,
## **  and MENUVERT.HOTKEY would match them against these rows.
## ***********************************************************************


## ---- ONE BLOCK A DROPDOWN, and index 0 is the title. The bar's own block is
## ---- beside GMX.BAR.LOAD and has the same shape, with its hotkey string in
## ---- place of a title.
## ----
## ---- ADD OR DROP A ROW BY EDITING THE BLOCK AND NOTHING ELSE. The count comes
## ---- from GP.BSTRCOUNT, the rows are read by a loop, and no other menu moves.

GP.BANKEDSTR GM.TEXTBANK BS.DD.DIALOG
  "DIALOG"
  " GUI.SAY"
  " OK MESSAGE BOX"
  " GUI.YN"
  " GUI.MENU"
  " GUI.INPUT"
  " GUI.LISTBOX  ONE"
  " GUI.LISTBOX  MANY"
  " GUI.OPEN + GUI.CLOSE"
  " BOX STYLES 0-3"
  " GUI.SHADOW"
  " TAB AND THE FOCUS"
GP.ENDBANKEDSTR

GP.BANKEDSTR GM.TEXTBANK BS.DD.LISTS
  "LISTS"
  " MENUVERT.RUN"
  " MENUVERT.DRAW"
  " MENUVERT.ROW"
  " MENUBAR.RUN"
  " HOTKEYS"
  " FLAGS"
GP.ENDBANKEDSTR

GP.BANKEDSTR GM.TEXTBANK BS.DD.INPUT
  "INPUT"
  " LINEINPUT.GET"
  " LINEINPUT.ASK"
  " THREE FIELDS"
  " LENGTH LIMITS"
GP.ENDBANKEDSTR

GP.BANKEDSTR GM.TEXTBANK BS.DD.SCREEN
  "SCREEN"
  " GP.BOX"
  " GP.FILL"
  " GP.PRINTAT"
  " GP.CHAR"
  " STASH SAVE + RESTORE"
  " STASH MOVE"
  " STASH TO A FILE"
  " STASHVRAM  SAVE + STAMP"
GP.ENDBANKEDSTR

GP.BANKEDSTR GM.TEXTBANK BS.DD.STRINGS
  "STRINGS"
  " STR.PADR"
  " STR.PADL"
  " STR.PADC"
  " STR.SPLIT"
  " STR.REPLACE"
  " STRCASE  UPPER/LOWER"
  " STR.USING"
  " STR.USING.FIX"
GP.ENDBANKEDSTR

GP.BANKEDSTR GM.TEXTBANK BS.DD.DATA
  "DATA"
  " SORT.RUN"
  " ARRAYS"
GP.ENDBANKEDSTR

GP.BANKEDSTR GM.TEXTBANK BS.DD.THEME
  "THEME"
  " X-SIXTEEN"
  " DARK"
  " LIGHT"
  " GRAY"
  " CUSTOM"
GP.ENDBANKEDSTR

GP.BANKEDSTR GM.TEXTBANK BS.DD.ABOUT
  "ABOUT"
  " PROGRAM"
  " MEMORY"
  " MODULE SIZES"
  " BANK MAP"
GP.ENDBANKEDSTR

GP.BANKEDSTR GM.TEXTBANKB BS.DD.FILES
  "FILES"
  " FILE.DIR.OPEN"
  " DIR  BY PATTERN"
  " DIR  DIRECTORIES"
  " FILE.STATUS"
  " FILE.EXISTS"
  " SAVEARRAY + LOADARRAY"
  " RENAME + DELETE"
  " MKDIR + CHDIR"
GP.ENDBANKEDSTR
GMX.DD.LOAD:
  MENUVERT.HOT$ = "" : MENUVERT.HOTATTR = 0
  MENUVERT.ATTR = THEME.CLR(THEME.TEXT) : MENUVERT.HIATTR = THEME.CLR(THEME.HILITE)

  GP.SELECT GM.SEL%
  GP.CASE 1
    MENUVERT.COUNT = GP.BSTRCOUNT(BS.DD.DIALOG) - 1
    FOR GM.I = 1 TO MENUVERT.COUNT
      MENUVERT.ITEM$(GM.I) = GP.BSTR(BS.DD.DIALOG, GM.I)
    NEXT GM.I
  GP.CASE 2
    MENUVERT.COUNT = GP.BSTRCOUNT(BS.DD.LISTS) - 1
    FOR GM.I = 1 TO MENUVERT.COUNT
      MENUVERT.ITEM$(GM.I) = GP.BSTR(BS.DD.LISTS, GM.I)
    NEXT GM.I
  GP.CASE 3
    MENUVERT.COUNT = GP.BSTRCOUNT(BS.DD.INPUT) - 1
    FOR GM.I = 1 TO MENUVERT.COUNT
      MENUVERT.ITEM$(GM.I) = GP.BSTR(BS.DD.INPUT, GM.I)
    NEXT GM.I
  GP.CASE 4
    MENUVERT.COUNT = GP.BSTRCOUNT(BS.DD.SCREEN) - 1
    FOR GM.I = 1 TO MENUVERT.COUNT
      MENUVERT.ITEM$(GM.I) = GP.BSTR(BS.DD.SCREEN, GM.I)
    NEXT GM.I
  GP.CASE 5
    MENUVERT.COUNT = GP.BSTRCOUNT(BS.DD.STRINGS) - 1
    FOR GM.I = 1 TO MENUVERT.COUNT
      MENUVERT.ITEM$(GM.I) = GP.BSTR(BS.DD.STRINGS, GM.I)
    NEXT GM.I
  GP.CASE 6
    MENUVERT.COUNT = GP.BSTRCOUNT(BS.DD.DATA) - 1
    FOR GM.I = 1 TO MENUVERT.COUNT
      MENUVERT.ITEM$(GM.I) = GP.BSTR(BS.DD.DATA, GM.I)
    NEXT GM.I
  GP.CASE 7
    MENUVERT.COUNT = GP.BSTRCOUNT(BS.DD.THEME) - 1
    FOR GM.I = 1 TO MENUVERT.COUNT
      MENUVERT.ITEM$(GM.I) = GP.BSTR(BS.DD.THEME, GM.I)
    NEXT GM.I
  GP.CASE 8
    MENUVERT.COUNT = GP.BSTRCOUNT(BS.DD.ABOUT) - 1
    FOR GM.I = 1 TO MENUVERT.COUNT
      MENUVERT.ITEM$(GM.I) = GP.BSTR(BS.DD.ABOUT, GM.I)
    NEXT GM.I
  GP.OTHER
    MENUVERT.COUNT = GP.BSTRCOUNT(BS.DD.FILES) - 1
    FOR GM.I = 1 TO MENUVERT.COUNT
      MENUVERT.ITEM$(GM.I) = GP.BSTR(BS.DD.FILES, GM.I)
    NEXT GM.I
  GP.ENDSEL
  RETURN


## ***********************************************************************
## **  GMX.DISPATCH -- the chosen row, to its panel.
## **
## **  ONE SELECT ON ONE COORDINATE. A panel is identified by BAR ITEM and
## **  ROW, and this half only knows the item: each bar item has a router of
## **  its own that reads MENUVERT.SEL. Two shallow selects rather than one
## **  nested on both.
## ***********************************************************************

GMX.DISPATCH:
  GP.SELECT GM.SEL%
  GP.CASE 1 : GOSUB GMX.DIALOG
  GP.CASE 2 : GOSUB GMX.LISTS
  GP.CASE 3 : GOSUB GMX.INPUT
  GP.CASE 4 : GOSUB GMX.SCREEN
  GP.CASE 5 : GOSUB GMX.STRINGS
  GP.CASE 6 : GOSUB GMX.DATA
  GP.CASE 7 : GOSUB GMX.THEME
  GP.CASE 8 : GOSUB GMX.ABOUT
  GP.OTHER  : GOSUB GMX.FILES
  GP.ENDSEL
  RETURN


## ***********************************************************************
## **  GMX.BANKMAP -- ABOUT / BANK MAP. What BANKMGR thinks it owns.
## **
## **  SEVEN BANKS ARE SPOKEN FOR AND THE PANEL SPLITS THEM BY WHO CHOSE.
## **
## **  AT RUN TIME are the three BANKMGR handed out, and each is named for what
## **  it holds rather than only numbered: SCREEN keeps the screen under an open
## **  dropdown, DIALOG the screen under a dialog, DIR the buffer a directory
## **  listing is read into. Ask on a different machine and the numbers differ.
## **
## **  COMPILED IN are the five written into the source as constants. CODE is
## **  the three GP.BANKED regions -- LIB.GUIBANK carries the GUI, LIB.UTILBANK
## **  the utilities, LIB.FUTILBANK the file modules -- and TEXT the two
## **  GP.BANKEDSTR pools, GM.TEXTBANK and
## **  GM.TEXTBANKB. Nothing chooses these: GP.BANKED takes a decimal constant,
## **  so they are the same numbers in every run. They still need a
## **  BANKMGR.CLAIM, which is what keeps the run-time three off them.
## **
## **  ONE WORD EACH, not the sentences they stand for: GUI.SAY sizes the box
## **  to its longest line, and spelling them out ran it off the right edge.
## **
## **  MID$(STR$(N), 2) drops the leading space STR$ puts on a positive number.
## **  It is ONLY for a value that cannot be negative: STR$ puts no leading space
## **  on one that is, so the same MID$ eats the minus and -1 prints as 1. Use
## **  GMX.SIGNED for anything that can go below zero, every -1 flag included.
## ***********************************************************************


GP.BANKEDSTR GM.TEXTBANK BS.BANKMAP
  " BANK MAP "
  "TOTAL BANKS "
  "   UNUSED "
  "AT RUN TIME  SCREEN #"
  "   DIALOG #"
  "   DIR #"
  "COMPILED IN  CODE #"
  " #"
  "   TEXT #"
GP.ENDBANKEDSTR
GMX.BANKMAP:
  GOSUB BANKMGR.COUNT : GOSUB GMX.D.RESET
  GUI.TITLE$ = GP.BSTR(BS.BANKMAP, 0)
  GUI.MSG$ = GP.BSTR(BS.BANKMAP, 1) + MID$(STR$(BANKMGR.BANKS), 2) + GP.BSTR(BS.BANKMAP, 2) + MID$(STR$(BANKMGR.SPARE), 2)
  GUI.MSG2$ = GP.BSTR(BS.BANKMAP, 3) + MID$(STR$(GM.DDBANK%), 2) + GP.BSTR(BS.BANKMAP, 4) + MID$(STR$(GM.GUIBANK%), 2)
  GUI.MSG2$ = GUI.MSG2$ + GP.BSTR(BS.BANKMAP, 5) + MID$(STR$(GM.DIRBANK%), 2)
  GUI.MSG3$ = GP.BSTR(BS.BANKMAP, 6) + MID$(STR$(LIB.GUIBANK), 2) + GP.BSTR(BS.BANKMAP, 7) + MID$(STR$(LIB.UTILBANK), 2) + GP.BSTR(BS.BANKMAP, 7) + MID$(STR$(LIB.FUTILBANK), 2)
  GUI.MSG3$ = GUI.MSG3$ + GP.BSTR(BS.BANKMAP, 8) + MID$(STR$(GM.TEXTBANK), 2) + GP.BSTR(BS.BANKMAP, 7) + MID$(STR$(GM.TEXTBANKB), 2)
  GOSUB GUI.SAY
  RETURN


## ***********************************************************************
## **  GMX.DIALOG -- the DIALOG dropdown, one item a demonstration.
## **
## **  Every item leaves its answer in GM.RESULT$, and the page is repainted
## **  afterwards because the box styles item draws on the page rather than in
## **  a dialog that puts the screen back for itself.
## ***********************************************************************

GMX.DIALOG:
  GP.SELECT MENUVERT.SEL
  GP.CASE 1 : GOSUB GMX.D.SAY
  GP.CASE 2 : GOSUB GMX.D.SAYOK
  GP.CASE 3 : GOSUB GMX.D.YN
  GP.CASE 4 : GOSUB GMX.D.MENU
  GP.CASE 5 : GOSUB GMX.D.INPUT
  GP.CASE 6 : GOSUB GMX.D.LIST.ONE
  GP.CASE 7 : GOSUB GMX.D.LIST.MANY
  GP.CASE 8 : GOSUB GMX.D.PANEL
  GP.CASE 9 : GOSUB GMX.D.STYLES
  GP.CASE 10 : GOSUB GMX.D.SHADOW
  GP.OTHER  : GOSUB GMX.D.FOCUS
  GP.ENDSEL
  GOSUB GMX.CHROME
  RETURN


## ***********************************************************************
## **  GMX.D.RESET -- the whole GUI interface, back to its defaults.
## **
## **  EVERY FIELD, not the three a demonstration happens to vary. The inputs
## **  are ordinary variables and all of them are sticky, so a panel setting
## **  only what it cares about inherits the last panel's title, hint and mask.
## ***********************************************************************

GMX.D.RESET:
  GUI.BANK = GM.GUIBANK%
  GUI.MSG$ = "" : GUI.MSG2$ = "" : GUI.MSG3$ = "" : GUI.TITLE$ = "" : GUI.BTN.ONE$ = "" : GUI.BTN.TWO$ = ""
  GUI.STYLE = 0 : GUI.GLYPH = 0 : GUI.PLACE = 0 : GUI.X = 0 : GUI.Y = 0
  GUI.ROW.OFFSET = 0 : GUI.PANEL.IN = 0 : GUI.BORDER.IN = 0 : GUI.OKCANCEL = 0
  GUI.DEFAULT = 1
  GUI.SHADOW = 0 : GUI.SHADOW.ATTR = 0
  GUI.LEN = 0 : GUI.MASK = 0 : GUI.FLAGS = 0 : GUI.SEL = 0 : GUI.COUNT = 0
  RETURN


## ---- GMX.SIGNED -- a number as text, MINUS SIGN AND ALL.
## ----
## ---- MID$(STR$(N), 2) drops the leading SPACE that STR$ puts on a POSITIVE
## ---- number. On a negative one there is no leading space and it drops the
## ---- MINUS instead, so -1 prints as 1 -- and every boolean in this library is
## ---- -1 for true, which is exactly the value a panel wants to show.

GMX.SIGNED:
  GM.NUM$ = MID$(STR$(GM.NUM%), 2) : IF GM.NUM% < 0 THEN GM.NUM$ = "-" + GM.NUM$
  RETURN


## ---- A key, for the two demonstrations that draw and then wait ----

GMX.WAIT:
  GP.DO
    GET GM.K$
    IF GM.K$ <> "" THEN GP.EXITDO
  GP.LOOP
  RETURN


## ---- Twenty-four rows, for the two listbox demonstrations ----


GP.BANKEDSTR GM.TEXTBANK BS.D.FILL
  " ITEM "
GP.ENDBANKEDSTR
GMX.D.FILL:
  FOR GM.I = 1 TO 24
    MENUVERT.ITEM$(GM.I) = GP.BSTR(BS.D.FILL, 0) + MID$(STR$(GM.I), 2)
  NEXT GM.I
  RETURN


## ***********************************************************************
## **  GMX.D.SAY -- GUI.SAY. One message, one way out.
## ***********************************************************************


GP.BANKEDSTR GM.TEXTBANK BS.D.SAY
  " GUI.SAY "
  "SOMETHING TO SAY, AND ONE WAY OUT."
  "GUI.MSG2$ IS THE SECOND LINE."
  "GUI.SAY CLOSED ON KEY "
GP.ENDBANKEDSTR
GMX.D.SAY:
  GOSUB GMX.D.RESET
  GUI.TITLE$ = GP.BSTR(BS.D.SAY, 0) : GUI.MSG$ = GP.BSTR(BS.D.SAY, 1) : GUI.MSG2$ = GP.BSTR(BS.D.SAY, 2)
  GUI.BTN.ONE$ = "&OK" : GOSUB GUI.SAY
  GM.RESULT$ = GP.BSTR(BS.D.SAY, 3) + MID$(STR$(GUI.KEY), 2)
  RETURN


## ***********************************************************************
## **  GMX.D.SAYOK -- the smallest message box there is.
## **
## **  GUI.BTN.ONE$ IS LEFT EMPTY ON PURPOSE, which is the whole point of this
## **  one next to GMX.D.SAY above. GUI.SAY takes "&OK" when the label is "",
## **  so the button, its brackets, its lit letter and its key all arrive
## **  without being asked for -- and being the only button it is the default,
## **  so its brackets come out doubled too.
## **
## **  RETURN, SPACE, ESC, STOP and O all close it, and GUI.KEY says which.
## ***********************************************************************

GP.BANKEDSTR GM.TEXTBANK BS.D.SAYOK
  " NOTICE "
  "ONE MESSAGE, ONE BUTTON, NOTHING SET."
  "RETURN, SPACE, ESC, STOP OR O CLOSES IT."
  "CLOSED ON KEY "
GP.ENDBANKEDSTR
GMX.D.SAYOK:
  GOSUB GMX.D.RESET
  GUI.TITLE$ = GP.BSTR(BS.D.SAYOK, 0) : GUI.MSG$ = GP.BSTR(BS.D.SAYOK, 1) : GUI.MSG2$ = GP.BSTR(BS.D.SAYOK, 2)
  GOSUB GUI.SAY : GM.RESULT$ = GP.BSTR(BS.D.SAYOK, 3) + MID$(STR$(GUI.KEY), 2)
  RETURN


## ***********************************************************************
## **  GMX.D.YN -- GUI.YN, both ways round. YES/NO, then OK/CANCEL.
## ***********************************************************************


GP.BANKEDSTR GM.TEXTBANK BS.D.YN
  " GUI.YN "
  "DELETE THE FILE?"
  "RETURN PRESSES THE <<DOUBLED>> BUTTON."
  " GUI.YN - OKCANCEL "
  "THE SAME DIALOG, ASKING OK OR CANCEL."
  "RETURN ACCEPTS, ESC AND STOP CANCEL."
  "GUI.YN  YESNO"
  "   OKCANCEL"
GP.ENDBANKEDSTR
GMX.D.YN:
  GOSUB GMX.D.RESET
  GUI.TITLE$ = GP.BSTR(BS.D.YN, 0) : GUI.MSG$ = GP.BSTR(BS.D.YN, 1) : GUI.MSG2$ = GP.BSTR(BS.D.YN, 2)

## ---- THE DESTRUCTIVE ANSWER IS NOT THE DEFAULT. RETURN on a question that
## ---- deletes something should say no, and this is the flag that says so.
  GUI.DEFAULT = 2
  GOSUB GUI.YN
  GM.YESNO% = GUI.ANSWER

  GOSUB GMX.D.RESET
  GUI.TITLE$ = GP.BSTR(BS.D.YN, 3) : GUI.MSG$ = GP.BSTR(BS.D.YN, 4) : GUI.MSG2$ = GP.BSTR(BS.D.YN, 5)
  GUI.OKCANCEL = 1 : GOSUB GUI.YN
## ---- STR$ WHOLE, not MID$(STR$(N), 2). That idiom drops the leading space STR$ puts
## ---- on a POSITIVE number, and a flag is -1: it would print the minus away and say 1.
  GM.RESULT$ = GP.BSTR(BS.D.YN, 6) + STR$(GM.YESNO%) + GP.BSTR(BS.D.YN, 7) + STR$(GUI.ANSWER)
  RETURN


## ***********************************************************************
## **  GMX.D.MENU -- GUI.MENU. MENUVERT.RUN inside a frame.
## ***********************************************************************


GP.BANKEDSTR GM.TEXTBANK BS.D.MENU
  " NEW GAME"
  " LOAD"
  " OPTIONS"
  " QUIT"
  " GUI.MENU "
  "CHOOSE A ROW."
  "GUI.MENU SEL "
  "GUI.MENU CANCELLED"
GP.ENDBANKEDSTR
GMX.D.MENU:
  GOSUB GMX.D.RESET
  MENUVERT.ITEM$(1) = GP.BSTR(BS.D.MENU, 0)
  MENUVERT.ITEM$(2) = GP.BSTR(BS.D.MENU, 1)
  MENUVERT.ITEM$(3) = GP.BSTR(BS.D.MENU, 2)
  MENUVERT.ITEM$(4) = GP.BSTR(BS.D.MENU, 3)
  GUI.COUNT = 4 : GUI.TITLE$ = GP.BSTR(BS.D.MENU, 4) : GUI.MSG$ = GP.BSTR(BS.D.MENU, 5)
  GOSUB GUI.MENU
  GM.RESULT$ = GP.BSTR(BS.D.MENU, 6) + MID$(STR$(GUI.SEL), 2)
  IF GUI.SEL = 0 THEN GM.RESULT$ = GP.BSTR(BS.D.MENU, 7)
  RETURN


## ***********************************************************************
## **  GMX.D.INPUT -- GUI.INPUT, plain then masked.
## **
## **  The answer is GUI.TEXT$ and not GUI.INPUT$: GUI.INPUT is the routine's
## **  own label, and BASLOAD stops with DUPLICATE SYMBOL on a string of that
## **  name beside it -- the $ does not separate the two.
## ***********************************************************************


GP.BANKEDSTR GM.TEXTBANK BS.D.INPUT
  " GUI.INPUT "
  "TYPE A NAME."
  " GUI.INPUT - MASKED "
  "AND THE SAME FIELD AS A PASSWORD."
  "GUI.INPUT OK "
GP.ENDBANKEDSTR
GMX.D.INPUT:
  GOSUB GMX.D.RESET
  GUI.TITLE$ = GP.BSTR(BS.D.INPUT, 0) : GUI.MSG$ = GP.BSTR(BS.D.INPUT, 1)
  GUI.LEN = 20 : GUI.TEXT$ = "GPC"
  GOSUB GUI.INPUT
  GM.TYPED$ = GUI.TEXT$ : GM.TYPED.OK = GUI.OK

  GOSUB GMX.D.RESET
  GUI.TITLE$ = GP.BSTR(BS.D.INPUT, 2) : GUI.MSG$ = GP.BSTR(BS.D.INPUT, 3)
  GUI.LEN = 12 : GUI.TEXT$ = "" : GUI.MASK = 1
  GOSUB GUI.INPUT
  GM.NUM% = GM.TYPED.OK : GOSUB GMX.SIGNED
  GM.RESULT$ = GP.BSTR(BS.D.INPUT, 4) + GM.NUM$ + "  [" + GM.TYPED$ + "]"
  RETURN


## ***********************************************************************
## **  GMX.D.LIST.ONE -- GUI.LISTBOX, one answer from a list that scrolls.
## ***********************************************************************


GP.BANKEDSTR GM.TEXTBANK BS.D.LIST.ONE
  " GUI.LISTBOX "
  "ONE OF TWENTY-FOUR, IN A BOX EIGHT ROWS DEEP."
  "LISTBOX SEL "
  "LISTBOX CANCELLED"
GP.ENDBANKEDSTR
GMX.D.LIST.ONE:
  GOSUB GMX.D.RESET
  GOSUB GMX.D.FILL
  GUI.TITLE$ = GP.BSTR(BS.D.LIST.ONE, 0) : GUI.MSG$ = GP.BSTR(BS.D.LIST.ONE, 1)
  GUI.LISTBOX.COUNT = 24 : GUI.LISTBOX.ROWS = 8 : GUI.LISTBOX.MULTI = 0 : GUI.LISTBOX.SEL = 0
  GOSUB GUI.LISTBOX
  GM.RESULT$ = GP.BSTR(BS.D.LIST.ONE, 2) + MID$(STR$(GUI.LISTBOX.SEL), 2)
  IF GUI.LISTBOX.SEL = 0 THEN GM.RESULT$ = GP.BSTR(BS.D.LIST.ONE, 3)
  RETURN


## ***********************************************************************
## **  GMX.D.LIST.MANY -- GUI.LISTBOX in multi select. SPACE marks a row.
## ***********************************************************************


GP.BANKEDSTR GM.TEXTBANK BS.D.LIST.MANY
  " GUI.LISTBOX - MULTI "
  "SPACE MARKS A ROW, RETURN ACCEPTS THE SET."
  "LISTBOX MARKED "
  " OF 24"
GP.ENDBANKEDSTR
GMX.D.LIST.MANY:
  GOSUB GMX.D.RESET
  GOSUB GMX.D.FILL
  GUI.TITLE$ = GP.BSTR(BS.D.LIST.MANY, 0) : GUI.MSG$ = GP.BSTR(BS.D.LIST.MANY, 1)
  GUI.LISTBOX.COUNT = 24 : GUI.LISTBOX.ROWS = 8
  GUI.LISTBOX.MULTI = 1 : GUI.LISTBOX.MARKS$ = "" : GUI.LISTBOX.SEL = 0
  GOSUB GUI.LISTBOX
  GM.RESULT$ = GP.BSTR(BS.D.LIST.MANY, 2) + MID$(STR$(GUI.LISTBOX.MARKED), 2) + GP.BSTR(BS.D.LIST.MANY, 3)
  RETURN


## ***********************************************************************
## **  GMX.D.PANEL -- GUI.OPEN and GUI.CLOSE, with the caller drawing inside.
## **
## **  GUI.BODY.ROWS and .WIDTH say what the caller needs under the message;
## **  GUI.INNER.LEFT, .TOP and .WIDTH are where it may put it. This is the
## **  entry point a fifth kind of dialog is built on.
## ***********************************************************************


GP.BANKEDSTR GM.TEXTBANK BS.D.PANEL
  " GUI.OPEN "
  "THE BOX, WITH NO DIALOG INSIDE IT."
  "THE CALLER DREW THESE FOUR ROWS"
  "AT GUI.INNER.LEFT AND .TOP."
  "GUI.STASHED ="
  "PRESS A KEY."
  "GUI.OPEN BOX "
GP.ENDBANKEDSTR
GMX.D.PANEL:
  GOSUB GMX.D.RESET
  GUI.TITLE$ = GP.BSTR(BS.D.PANEL, 0) :  GUI.MSG$ = GP.BSTR(BS.D.PANEL, 1)
  GUI.BODY.ROWS = 4 : GUI.BODY.WIDTH = 32
  GOSUB GUI.OPEN
  GP.PRINTAT GUI.INNER.LEFT, GUI.INNER.TOP, GP.BSTR(BS.D.PANEL, 2), GUI.PANEL
  GP.PRINTAT GUI.INNER.LEFT, GUI.INNER.TOP + 1, GP.BSTR(BS.D.PANEL, 3), GUI.PANEL
  GP.PRINTAT GUI.INNER.LEFT, GUI.INNER.TOP + 2, GP.BSTR(BS.D.PANEL, 4) + STR$(GUI.STASHED), GUI.PANEL
  GP.PRINTAT GUI.INNER.LEFT, GUI.INNER.TOP + 3, GP.BSTR(BS.D.PANEL, 5), THEME.CLR(THEME.WARN)
  GOSUB GMX.WAIT : GOSUB GUI.CLOSE
  GM.RESULT$ = GP.BSTR(BS.D.PANEL, 6) + MID$(STR$(GUI.WIDTH), 2) + " X " + MID$(STR$(GUI.HEIGHT), 2)
  GM.RESULT$ = GM.RESULT$ + " AT " + MID$(STR$(GUI.LEFT), 2) + "," + MID$(STR$(GUI.TOP), 2)
  RETURN


## ***********************************************************************
## **  GMX.D.STYLES -- GP.BOX, all four of them.
## **
## **  FOUR, NOT SIX. The runtime table holds 0 solid, 1 single line, 2 single
## **  line with rounded corners, 3 thick line. GPD_STYLES is 4, so 4 to 255 is
## **  BAD STYLE, and 256 or more is an address -- eight screen codes of the
## **  caller's own.
## ***********************************************************************


GP.BANKEDSTR GM.TEXTBANK BS.D.STYLES
  "STYLE "
  "FOUR STYLES, 0 TO 3. PRESS A KEY."
  "GP.BOX DREW STYLES 0 TO 3"
GP.ENDBANKEDSTR
GMX.D.STYLES:
  GP.FILL 0, 7, APPSYS.COLS, 11, ASC(" "), THEME.CLR(THEME.PAGE)
  FOR GM.I = 0 TO 3
    GM.BOXX% = 4 + GM.I * 18
    GP.BOX GM.BOXX%, 8, 14, 6, GM.I, THEME.CLR(THEME.BORDER)
    GP.PRINTAT GM.BOXX% + 4, 10, GP.BSTR(BS.D.STYLES, 0) + MID$(STR$(GM.I), 2), THEME.CLR(THEME.TEXT)
  NEXT GM.I
  GP.PRINTAT 4, 16, GP.BSTR(BS.D.STYLES, 1), THEME.CLR(THEME.WARN)
  GOSUB GMX.WAIT : GM.RESULT$ = GP.BSTR(BS.D.STYLES, 2)
  RETURN


## ***********************************************************************
## **  GMX.D.SHADOW -- GUI.SHADOW. The same dialog twice, off and then on.
## **
## **  THE PAGE IS FILLED FIRST, and that is the whole demonstration. A shadow
## **  is drawn OUTSIDE the box, so it is also the one part a stash of the box
## **  alone would not put back -- the dots coming back under BOTH dialogs is
## **  what says GUI.OPEN grew its saved rectangle to match.
## ***********************************************************************


GP.BANKEDSTR GM.TEXTBANKB BS.D.SHADOW
  " GUI.SHADOW = 0 "
  "THE PLAIN BOX, ON SOMETHING WORTH COVERING."
  "LOOK AT ITS RIGHT EDGE AND ITS BOTTOM."
  " GUI.SHADOW = 1 "
  "THE SAME BOX, LIFTED OFF THE PAGE."
  "ONE ROW UNDER IT AND TWO COLUMNS RIGHT."
  "GUI.SHADOW  DRAWN, THEN PUT BACK"
GP.ENDBANKEDSTR
GMX.D.SHADOW:
  GOSUB GMX.CLEARPANEL
  GP.FILL 2, GM.PANELTOP%, APPSYS.COLS - 4, GM.PANELROWS% - 2, ASC("."), THEME.CLR(THEME.DIMMED)

  GOSUB GMX.D.RESET
  GUI.TITLE$ = GP.BSTR(BS.D.SHADOW, 0) : GUI.MSG$ = GP.BSTR(BS.D.SHADOW, 1) : GUI.MSG2$ = GP.BSTR(BS.D.SHADOW, 2)
  GUI.BTN.ONE$ = "&OK"
  GOSUB GUI.SAY

## ---- The only line that differs. Everything else is set the same way twice
## ---- so that the two boxes are the same box.

  GOSUB GMX.D.RESET
  GUI.SHADOW = 1
  GUI.TITLE$ = GP.BSTR(BS.D.SHADOW, 3) : GUI.MSG$ = GP.BSTR(BS.D.SHADOW, 4) : GUI.MSG2$ = GP.BSTR(BS.D.SHADOW, 5)
  GUI.BTN.ONE$ = "&OK"
  GOSUB GUI.SAY

  GM.RESULT$ = GP.BSTR(BS.D.SHADOW, 6)
  RETURN


## ***********************************************************************
## **  GMX.D.FOCUS -- TAB, the focus, and the default button.
## **
## **  THREE BOXES, ONE RULE EACH, and each one is the rule live rather than a
## **  sentence about it:
## **
## **    1  the model, in words, so the two that follow have something to be
## **       measured against
## **    2  GUI.YN with GUI.DEFAULT = 2, so <<NO>> carries the double brackets
## **       and RETURN answers no. Nothing else about the call changes
## **    3  GUI.INPUT, where the focus opens in the FIELD and the default sits
## **       on OK -- the two are not the same thing, and this is the only
## **       shape in the library that shows it
## **
## **  GUI.INPUT WRITES GUI.DEFAULT ITSELF, to 1. That is why box 2 is a
## **  GUI.YN: a dialog with a field always defaults to OK, so the moved
## **  default and the split focus have to be two different boxes.
## **
## **  The accelerators are live in box 2 and dead in box 3 while the eye is in
## **  the field, which is the whole accelerator rule and is why Y and N are
## **  marked in one and O and C are marked but inert in the other.
## ***********************************************************************


GP.BANKEDSTR GM.TEXTBANK BS.D.FOCUS
  " THE FOCUS "
  "TAB MOVES THE FOCUS, SHIFT+TAB GOES BACK."
  "THE DEFAULT IS DRAWN <<LIKE THIS>>, AND RETURN"
  "PRESSES IT FROM WHEREVER THE FOCUS IS."
  " A MOVED DEFAULT "
  "GUI.DEFAULT = 2, SO NO IS THE DEFAULT HERE."
  "RETURN ANSWERS NO. Y AND N STILL WORK."
  " FOCUS IS NOT DEFAULT "
  "THE FOCUS OPENS IN THE FIELD. THE DEFAULT IS"
  "OK. TAB TO REACH THE BUTTONS; O AND C ARE"
  "MARKED BUT INERT WHILE THE FIELD HAS THE KEYS."
  "ANSWER "
  "   GUI.OK "
  "   TEXT ["
  "]"
GP.ENDBANKEDSTR
GMX.D.FOCUS:
  GOSUB GMX.D.RESET
  GUI.TITLE$ = GP.BSTR(BS.D.FOCUS, 0)
  GUI.MSG$ = GP.BSTR(BS.D.FOCUS, 1)
  GUI.MSG2$ = GP.BSTR(BS.D.FOCUS, 2)
  GUI.MSG3$ = GP.BSTR(BS.D.FOCUS, 3)
  GOSUB GUI.SAY

## ---- The default moves, and nothing else does.

  GOSUB GMX.D.RESET
  GUI.TITLE$ = GP.BSTR(BS.D.FOCUS, 4)
  GUI.MSG$ = GP.BSTR(BS.D.FOCUS, 5)
  GUI.MSG2$ = GP.BSTR(BS.D.FOCUS, 6)
  GUI.DEFAULT = 2
  GOSUB GUI.YN
  GM.NUM% = GUI.ANSWER : GOSUB GMX.SIGNED
  GM.FOCUS$ = GP.BSTR(BS.D.FOCUS, 11) + GM.NUM$

## ---- And the focus starts somewhere the default is not.

  GOSUB GMX.D.RESET
  GUI.TITLE$ = GP.BSTR(BS.D.FOCUS, 7)
  GUI.MSG$ = GP.BSTR(BS.D.FOCUS, 8)
  GUI.MSG2$ = GP.BSTR(BS.D.FOCUS, 9)
  GUI.MSG3$ = GP.BSTR(BS.D.FOCUS, 10)
  GUI.LEN = 16 : GUI.TEXT$ = ""
  GOSUB GUI.INPUT
  GM.NUM% = GUI.OK : GOSUB GMX.SIGNED
  GM.RESULT$ = GM.FOCUS$ + GP.BSTR(BS.D.FOCUS, 12) + GM.NUM$ + GP.BSTR(BS.D.FOCUS, 13) + GUI.TEXT$ + GP.BSTR(BS.D.FOCUS, 14)
  RETURN


## ***********************************************************************
## **  GMX.SCREEN -- the SCREEN dropdown. The drawing keywords, then STASH.
## **
## **  Every item repaints the page afterwards. These draw ON the page rather
## **  than in a dialog that puts the screen back for itself.
## ***********************************************************************

GMX.SCREEN:
  GP.SELECT MENUVERT.SEL
  GP.CASE 1
    GOSUB GMX.S.BOX
  GP.CASE 2
    GOSUB GMX.S.FILL
  GP.CASE 3
    GOSUB GMX.S.PRINTAT
  GP.CASE 4
    GOSUB GMX.S.CHAR
  GP.CASE 5
    GOSUB GMX.S.STASH
  GP.CASE 6
    GOSUB GMX.S.MOVE
  GP.CASE 7
    GOSUB GMX.S.FILE
  GP.OTHER
    GOSUB GMX.S.VRAM
  GP.ENDSEL
  GOSUB GMX.CHROME
  RETURN


## ---- GMX.CLEARPANEL -- blank the rows a SCREEN panel draws in, and say
## ---- where they are. Rows 0 to 6 are chrome; the bottom five carry GM.RESY%
## ---- -- ROWS-3 -- and the key line. So a panel owns 7 to ROWS-6, which is
## ---- the 7 and the ROWS-12 below. GM.PANELTOP% and GM.PANELROWS% are left set
## ---- for GMX.TELL, whose prompt goes on the last row of the panel.

GMX.CLEARPANEL:
  GM.PANELTOP% = 7 : GM.PANELROWS% = APPSYS.ROWS - 12
  GP.FILL 0, GM.PANELTOP%, APPSYS.COLS, GM.PANELROWS%, ASC(" "), THEME.CLR(THEME.PAGE)
  RETURN


## ---- A prompt on the last row of the work area, then a key ----

GMX.TELL:
  GP.FILL 0, GM.PANELTOP% + GM.PANELROWS% - 1, APPSYS.COLS, 1, ASC(" "), THEME.CLR(THEME.PAGE)
  GP.PRINTAT 4, GM.PANELTOP% + GM.PANELROWS% - 1, GM.TELL$, THEME.CLR(THEME.WARN)
  GOSUB GMX.WAIT
  RETURN


## ***********************************************************************
## **  GMX.BANKNOW -- which RAM bank is actually selected, into GM.BANKNOW.
## **
## **  STASH.BANK.HOLD, borrowed. It is the blob that reads $00, and BASIC
## **  cannot: PEEK selects and restores around every access, so PEEK(0)
## **  reads back what BANK last set rather than what the hardware holds.
## **  Borrowing it rather than writing a second blob also means the panel
## **  measures the module with the module.
## **
## **  STASH.WAS% IS SAFE TO CLOBBER between STASH calls -- it is live only
## **  from a STASH entry point to its exit.
## ***********************************************************************

GMX.BANKNOW:
  GOSUB STASH.BANK.HOLD : GM.BANKNOW% = STASH.WAS%
  RETURN


## ---- Something worth saving: a frame, a label and a run of colour ----


GP.BANKEDSTR GM.TEXTBANK BS.S.PATTERN
  "THIRTY BY EIGHT"
  "CELLS, AND THE"
  "COLOUR GOES TOO"
GP.ENDBANKEDSTR
GMX.S.PATTERN:
  GP.FILL 10, 9, 30, 8, ASC("."), THEME.CLR(THEME.DIMMED)
  GP.BOX 10, 9, 30, 8, 1, THEME.CLR(THEME.BORDER)
  GP.PRINTAT 12, 11, GP.BSTR(BS.S.PATTERN, 0), THEME.CLR(THEME.TEXT)
  GP.PRINTAT 12, 12, GP.BSTR(BS.S.PATTERN, 1), THEME.CLR(THEME.TEXT)
  GP.PRINTAT 12, 13, GP.BSTR(BS.S.PATTERN, 2), THEME.CLR(THEME.WARN)
  FOR GM.I = 0 TO 13
    GP.CHAR 12 + GM.I, 15, ASC("*"), GM.I * 16 + 15
  NEXT GM.I
  RETURN


## ***********************************************************************
## **  GMX.S.BOX -- GP.BOX, and the eight glyphs of your own.
## **
## **  The four built-in styles are DIALOG / BOX STYLES. This is the other
## **  form: a style of 256 or more is an ADDRESS, and GP.STRPTR + 1 is the
## **  cheapest way to carry eight bytes -- the pointer is at the length
## **  byte and the text starts after it.
## **
## **  IT IS ALSO THE ISO ANSWER. GP.BOX does no translation, so the built-in
## **  styles are PETSCII screen codes and come out as letters in ISO mode;
## **  there, a tile index is a character code and + - | make a frame.
## ***********************************************************************


GP.BANKEDSTR GM.TEXTBANK BS.S.BOX
  "STYLE 1, BUILT IN"
  "++++--||"
  "EIGHT GLYPHS OF"
  "THE CALLERS OWN, IN"
  "ORDER TR TL BR BL"
  "TOP BOTTOM LEFT RIGHT"
  "GP.BOX DRAWS THE FRAME ONLY. PRESS A KEY."
  "GP.BOX  STYLE 1 AND AN EIGHT GLYPH TABLE"
GP.ENDBANKEDSTR
GMX.S.BOX:
  GOSUB GMX.CLEARPANEL
  GP.BOX 4, 9, 22, 7, 1, THEME.CLR(THEME.BORDER)
  GP.PRINTAT 6, 12, GP.BSTR(BS.S.BOX, 0), THEME.CLR(THEME.TEXT)

  GM.GLYPH$ = GP.BSTR(BS.S.BOX, 1)
  GP.BOX 32, 9, 22, 7, GP.STRPTR(GM.GLYPH$) + 1, THEME.CLR(THEME.BORDER)
  GP.PRINTAT 34, 11, GP.BSTR(BS.S.BOX, 2), THEME.CLR(THEME.TEXT)
  GP.PRINTAT 34, 12, GP.BSTR(BS.S.BOX, 3), THEME.CLR(THEME.TEXT)
  GP.PRINTAT 34, 13, GP.BSTR(BS.S.BOX, 4), THEME.CLR(THEME.DIMMED)
  GP.PRINTAT 34, 14, GP.BSTR(BS.S.BOX, 5), THEME.CLR(THEME.DIMMED)

  GM.TELL$ = GP.BSTR(BS.S.BOX, 6) : GOSUB GMX.TELL
  GM.RESULT$ = GP.BSTR(BS.S.BOX, 7)
  RETURN


## ***********************************************************************
## **  GMX.S.FILL -- GP.FILL, three rectangles deep.
## **
## **  The char is PETSCII, which is why it is written ASC(" ") and not 32.
## ***********************************************************************


GP.BANKEDSTR GM.TEXTBANK BS.S.FILL
  "GP.FILL X,Y,W,H,CHAR,COL"
  "THE CHAR IS PETSCII, SO IT"
  "IS WRITTEN ASC OF SOMETHING."
  "A SPACE FILL BLANKS A"
  "REGION, AND IT IS"
  "RIGHT IN ISO MODE TOO."
  "THREE RECTANGLES, THE LAST BLANK. PRESS A KEY."
  "GP.FILL  THREE RECTANGLES"
GP.ENDBANKEDSTR
GMX.S.FILL:
  GOSUB GMX.CLEARPANEL
  GP.FILL 4, 9, 26, 9, ASC("."), THEME.CLR(THEME.DIMMED)
  GP.FILL 8, 11, 18, 5, ASC("+"), THEME.CLR(THEME.BORDER)
  GP.FILL 12, 12, 10, 3, ASC(" "), THEME.CLR(THEME.HILITE)

  GP.PRINTAT 36, 9, GP.BSTR(BS.S.FILL, 0), THEME.CLR(THEME.TITLE)
  GP.PRINTAT 36, 11, GP.BSTR(BS.S.FILL, 1), THEME.CLR(THEME.TEXT)
  GP.PRINTAT 36, 12, GP.BSTR(BS.S.FILL, 2), THEME.CLR(THEME.TEXT)
  GP.PRINTAT 36, 14, GP.BSTR(BS.S.FILL, 3), THEME.CLR(THEME.TEXT)
  GP.PRINTAT 36, 15, GP.BSTR(BS.S.FILL, 4), THEME.CLR(THEME.TEXT)
  GP.PRINTAT 36, 16, GP.BSTR(BS.S.FILL, 5), THEME.CLR(THEME.TEXT)

  GM.TELL$ = GP.BSTR(BS.S.FILL, 6)
  GOSUB GMX.TELL
  GM.RESULT$ = GP.BSTR(BS.S.FILL, 7)
  RETURN


## ***********************************************************************
## **  GMX.S.PRINTAT -- GP.PRINTAT, in three colours.
## **
## **  NOTHING IS CLIPPED is stated rather than shown: drawing past the right
## **  edge wraps onto the next row, and past the bottom writes off the end of
## **  the screen map, which would take the chrome with it.
## ***********************************************************************


GP.BANKEDSTR GM.TEXTBANK BS.S.PRINTAT
  "GP.PRINTAT WRITES STRAIGHT TO VERA."
  "NO KERNAL CALL PER CHARACTER, SO IT IS"
  "SEVERAL TIMES FASTER THAN PRINT."
  "IT DOES NOT MOVE THE CURSOR PRINT USES, SO"
  "THEY NEED A LOCATE BETWEEN THEM."
  "NOTHING IS CLIPPED. THE RIGHT EDGE WRAPS ONTO"
  "THE NEXT ROW, AND THE BOTTOM OFF THE MAP."
  "PRESS A KEY."
  "GP.PRINTAT  SEVEN LINES IN THREE COLOURS"
GP.ENDBANKEDSTR
GMX.S.PRINTAT:
  GOSUB GMX.CLEARPANEL
  GP.PRINTAT 4, 9, GP.BSTR(BS.S.PRINTAT, 0), THEME.CLR(THEME.TITLE)
  GP.PRINTAT 4, 11, GP.BSTR(BS.S.PRINTAT, 1), THEME.CLR(THEME.TEXT)
  GP.PRINTAT 4, 12, GP.BSTR(BS.S.PRINTAT, 2), THEME.CLR(THEME.TEXT)
  GP.PRINTAT 4, 14, GP.BSTR(BS.S.PRINTAT, 3), THEME.CLR(THEME.DIMMED)
  GP.PRINTAT 4, 15, GP.BSTR(BS.S.PRINTAT, 4), THEME.CLR(THEME.DIMMED)
  GP.PRINTAT 4, 17, GP.BSTR(BS.S.PRINTAT, 5), THEME.CLR(THEME.WARN)
  GP.PRINTAT 4, 18, GP.BSTR(BS.S.PRINTAT, 6), THEME.CLR(THEME.WARN)

  GM.TELL$ = GP.BSTR(BS.S.PRINTAT, 7) : GOSUB GMX.TELL
  GM.RESULT$ = GP.BSTR(BS.S.PRINTAT, 8)
  RETURN


## ***********************************************************************
## **  GMX.S.CHAR -- GP.CHAR, one cell at a time.
## **
## **  FREE: it is GP.PRINTAT in shape and GP.FILL underneath, a 1x1 fill.
## ***********************************************************************


GP.BANKEDSTR GM.TEXTBANK BS.S.CHAR
  "ONE CELL A CALL,"
  "IN GP.PRINTAT SHAPE"
  "RUNNING GP.FILL."
  "SIXTEEN LETTERS AND SIXTEEN BACKGROUNDS. PRESS A KEY."
  "GP.CHAR  THIRTY-TWO SINGLE CELLS"
GP.ENDBANKEDSTR
GMX.S.CHAR:
  GOSUB GMX.CLEARPANEL
  FOR GM.I = 0 TO 15
    GP.CHAR 6 + GM.I * 3, 9 + GM.I, ASC("A") + GM.I, THEME.CLR(THEME.TEXT)
    GP.CHAR 7 + GM.I * 3, 9 + GM.I, ASC("*"), GM.I * 16 + 15
  NEXT GM.I
  GP.PRINTAT 56, 12, GP.BSTR(BS.S.CHAR, 0), THEME.CLR(THEME.TITLE)
  GP.PRINTAT 56, 13, GP.BSTR(BS.S.CHAR, 1), THEME.CLR(THEME.TEXT)
  GP.PRINTAT 56, 14, GP.BSTR(BS.S.CHAR, 2), THEME.CLR(THEME.TEXT)

  GM.TELL$ = GP.BSTR(BS.S.CHAR, 3) : GOSUB GMX.TELL
  GM.RESULT$ = GP.BSTR(BS.S.CHAR, 4)
  RETURN


## ***********************************************************************
## **  GMX.S.STASH -- STASH.SAVE and STASH.RESTORE, over a scribble.
## **
## **  THE DROPDOWN BANK IS FREE HERE. GMX.DROP restores the screen under the
## **  dropdown BEFORE it dispatches, so nothing in bank GM.DDBANK% is wanted
## **  by the time a panel runs.
## **
## **  The bank is read back at the end because STASH selects one and used to
## **  leave it selected. It must report the bank this panel had, not GM.DDBANK.
## ***********************************************************************


GP.BANKEDSTR GM.TEXTBANK BS.S.STASH
  "SAVED TO A BANK. PRESS A KEY TO SCRIBBLE OVER IT."
  "GONE. PRESS A KEY TO PUT IT BACK."
  "BACK, COLOUR AND ALL. PRESS A KEY."
  "STASH  OK"
  "   BANK AFTER "
  "  (STASHED IN "
GP.ENDBANKEDSTR
GMX.S.STASH:
  GOSUB GMX.CLEARPANEL : GOSUB GMX.S.PATTERN

  STASH.BANK = GM.DDBANK%
  STASH.X = 10 : STASH.Y = 9 : STASH.W = 30 : STASH.H = 8
  GOSUB STASH.SAVE : GM.SOK% = STASH.OK

  GM.TELL$ = GP.BSTR(BS.S.STASH, 0) : GOSUB GMX.TELL
  GP.FILL 10, 9, 30, 8, ASC("X"), THEME.CLR(THEME.WARN)

  GM.TELL$ = GP.BSTR(BS.S.STASH, 1) : GOSUB GMX.TELL
  STASH.BANK = GM.DDBANK% : STASH.MOVE = 0
  GOSUB STASH.RESTORE : GOSUB GMX.BANKNOW

  GM.TELL$ = GP.BSTR(BS.S.STASH, 2) : GOSUB GMX.TELL
  GM.RESULT$ = GP.BSTR(BS.S.STASH, 3) + STR$(GM.SOK%)
  GM.RESULT$ = GM.RESULT$ + GP.BSTR(BS.S.STASH, 4) + MID$(STR$(GM.BANKNOW%), 2)
  GM.RESULT$ = GM.RESULT$ + GP.BSTR(BS.S.STASH, 5) + MID$(STR$(GM.DDBANK%), 2) + ")"
  RETURN


## ***********************************************************************
## **  GMX.S.MOVE -- STASH.MOVE, which makes a saved rectangle a stamp.
## **
## **  RESTORE reads the size out of the four header bytes, so MOVE needs only
## **  a new X and Y. MOVE IS CLEARED ON THE WAY OUT: it is an input a caller
## **  sets once, and it would otherwise leak into the next restore.
## ***********************************************************************


GP.BANKEDSTR GM.TEXTBANK BS.S.MOVE
  "STAMP"
  "12 X 4"
  "SAVED. PRESS A KEY TO STAMP IT FIVE TIMES."
  "ONE RECTANGLE, SIX PLACES. PRESS A KEY."
  "STASH.MOVE  FIVE STAMPS   BANK AFTER "
GP.ENDBANKEDSTR
GMX.S.MOVE:
  GOSUB GMX.CLEARPANEL
  GP.FILL 4, 9, 12, 4, ASC("."), THEME.CLR(THEME.DIMMED)
  GP.BOX 4, 9, 12, 4, 2, THEME.CLR(THEME.BORDER)
  GP.PRINTAT 6, 10, GP.BSTR(BS.S.MOVE, 0), THEME.CLR(THEME.WARN)
  GP.PRINTAT 6, 11, GP.BSTR(BS.S.MOVE, 1), THEME.CLR(THEME.TEXT)

  STASH.BANK = GM.DDBANK% 
  STASH.X = 4 : STASH.Y = 9 : STASH.W = 12 : STASH.H = 4
  GOSUB STASH.SAVE

  GM.TELL$ = GP.BSTR(BS.S.MOVE, 2) : GOSUB GMX.TELL

  FOR GM.I = 1 TO 5
    STASH.BANK = GM.DDBANK% : STASH.MOVE = 1
    STASH.X = 20 + GM.I * 9 : STASH.Y = 9 + GM.I * 2
    GOSUB STASH.RESTORE
  NEXT GM.I
  STASH.MOVE = 0
  GOSUB GMX.BANKNOW

  GM.TELL$ = GP.BSTR(BS.S.MOVE, 3) : GOSUB GMX.TELL
  GM.RESULT$ = GP.BSTR(BS.S.MOVE, 4) + MID$(STR$(GM.BANKNOW%), 2)
  RETURN


## ***********************************************************************
## **  GMX.S.FILE -- STASHFILE. Save, load back, and stamp elsewhere.
## **
## **  BANK 1 FIRST, AND IT IS THE POINT OF THE ROW. BLOAD and BSAVE write the
## **  RAM bank register directly and leave it where the transfer ended, so
## **  each of the three is asked afterwards which bank is selected. All three
## **  must answer 1 -- the bank this row chose -- and not GM.DDBANK%, which is
## **  the one the file was staged through.
## **
## **  THE NAME CARRIES @: so a second run overwrites rather than failing on an
## **  existing file.
## ***********************************************************************


GP.BANKEDSTR GM.TEXTBANK BS.S.FILE
  "@:PANEL.BIN"
  "WRITTEN. PRESS A KEY TO BLANK IT."
  "BLANK. PRESS A KEY TO LOAD IT BACK."
  "PANEL.BIN"
  "BACK. PRESS A KEY TO STAMP IT ELSEWHERE."
  "PRESS A KEY."
  "STASHFILE OK"
  "   BANK AFTER"
  " SAVE "
  " LOAD "
  " PUT "
  "   WANT 1 1 1"
GP.ENDBANKEDSTR
GMX.S.FILE:
  GOSUB GMX.CLEARPANEL : GOSUB GMX.S.PATTERN
  BANK 1

  STASH.BANK = GM.DDBANK% : STASH.DEV = 8
  STASH.FILE$ = GP.BSTR(BS.S.FILE, 0)
  STASH.X = 10 : STASH.Y = 9 : STASH.W = 30 : STASH.H = 8
  GOSUB STASH.FILE.SAVE : GM.SOK% = STASH.OK
  GOSUB GMX.BANKNOW     : GM.BSAVE% = GM.BANKNOW%

  GM.TELL$ = GP.BSTR(BS.S.FILE, 1) : GOSUB GMX.TELL
  GP.FILL 10, 9, 30, 8, ASC(" "), THEME.CLR(THEME.PAGE)

  GM.TELL$ = GP.BSTR(BS.S.FILE, 2) : GOSUB GMX.TELL
  STASH.FILE$ = GP.BSTR(BS.S.FILE, 3)
  GOSUB STASH.FILE.LOAD : GOSUB GMX.BANKNOW
  GM.BLOAD% = GM.BANKNOW%

  GM.TELL$ = GP.BSTR(BS.S.FILE, 4) : GOSUB GMX.TELL
  STASH.X = 44 : STASH.Y = 13
  GOSUB STASH.FILE.PUT : GOSUB GMX.BANKNOW

  GM.TELL$ = GP.BSTR(BS.S.FILE, 5)
  GOSUB GMX.TELL
  GM.RESULT$ = GP.BSTR(BS.S.FILE, 6) + STR$(GM.SOK%) + GP.BSTR(BS.S.FILE, 7)
  GM.RESULT$ = GM.RESULT$ + GP.BSTR(BS.S.FILE, 8) + MID$(STR$(GM.BSAVE%), 2)
  GM.RESULT$ = GM.RESULT$ + GP.BSTR(BS.S.FILE, 9) + MID$(STR$(GM.BLOAD%), 2)
  GM.RESULT$ = GM.RESULT$ + GP.BSTR(BS.S.FILE, 10) + MID$(STR$(GM.BANKNOW%), 2)
  GM.RESULT$ = GM.RESULT$ + GP.BSTR(BS.S.FILE, 11)
  RETURN


## ***********************************************************************
## **  GMX.S.VRAM -- STASHVRAM, which keeps the cells in VRAM instead.
## **
## **  THE SAME DEMONSTRATION AS STASH, ON PURPOSE. Save a rectangle, scribble
## **  over it, put it back, then stamp it somewhere else -- so the two rows
## **  can be read against each other. What differs is where the cells go and
## **  what it costs: STASH spends a whole 8K RAM bank, this spends VRAM pages
## **  above the layer 1 map, and the cells never travel through low memory
## **  because one VERA data port reads while the other writes.
## **
## **  IT NEEDS NO BANK, which is why it is in bank 7 with the rest of the
## **  utilities and STASH is not -- the compiler refuses BANK inside a region.
## **
## **  SV.MOVE IS CLEARED ON THE WAY OUT, as STASH.MOVE is: it is an input a
## **  caller sets once and it would otherwise leak into the next restore.
## **
## **  THE HANDLE IS FREED. Allocation is a bump pointer released LIFO, so a
## **  panel that kept its handle would walk the window down the drive of the
## **  program's life; this one gives it straight back.
## ***********************************************************************


GP.BANKEDSTR GM.TEXTBANKB BS.S.VRAM
  "IN VRAM. PRESS A KEY TO SCRIBBLE OVER IT."
  "GONE. PRESS A KEY TO PUT IT BACK."
  "BACK. PRESS A KEY TO STAMP IT LOWER DOWN."
  "ONE RECTANGLE, TWO PLACES, NO RAM BANK. PRESS A KEY."
  "SV  OK"
  "   HANDLE "
  "   PAGES "
GP.ENDBANKEDSTR
GMX.S.VRAM:
  GOSUB GMX.CLEARPANEL : GOSUB GMX.S.PATTERN

  SV.X = 10 : SV.Y = 9 : SV.W = 30 : SV.H = 8
  GOSUB SV.SAVE : GM.SOK% = SV.OK : GM.SHND% = SV.HND
  GM.SPAGES% = SV.PAGES%(SV.HND)

  GM.TELL$ = GP.BSTR(BS.S.VRAM, 0) : GOSUB GMX.TELL
  GP.FILL 10, 9, 30, 8, ASC("X"), THEME.CLR(THEME.WARN)

  GM.TELL$ = GP.BSTR(BS.S.VRAM, 1) : GOSUB GMX.TELL
  SV.HND = GM.SHND% : SV.MOVE = 0 :  GOSUB SV.RESTORE

  GM.TELL$ = GP.BSTR(BS.S.VRAM, 2) : GOSUB GMX.TELL
  SV.HND = GM.SHND% : SV.MOVE = -1
  SV.X = 44 : SV.Y = 13 : GOSUB SV.RESTORE
  SV.MOVE = 0

  SV.HND = GM.SHND%
  GOSUB SV.FREE

  GM.TELL$ = GP.BSTR(BS.S.VRAM, 3)
  GOSUB GMX.TELL
  GM.RESULT$ = GP.BSTR(BS.S.VRAM, 4) + STR$(GM.SOK%)
  GM.RESULT$ = GM.RESULT$ + GP.BSTR(BS.S.VRAM, 5) + MID$(STR$(GM.SHND%), 2)
  GM.RESULT$ = GM.RESULT$ + GP.BSTR(BS.S.VRAM, 6) + MID$(STR$(GM.SPAGES%), 2)
  RETURN


## ***********************************************************************
## **  GMX.LISTS -- the LISTS dropdown. MENUVERT, MENUBAR, and the one row
## **  painter underneath both of them.
## ***********************************************************************

GMX.LISTS:
  GP.SELECT MENUVERT.SEL
  GP.CASE 1
    GOSUB GMX.L.RUN
  GP.CASE 2
    GOSUB GMX.L.DRAW
  GP.CASE 3
    GOSUB GMX.L.ROW
  GP.CASE 4
    GOSUB GMX.L.BAR
  GP.CASE 5
    GOSUB GMX.L.HOT
  GP.OTHER
    GOSUB GMX.L.FLAGS
  GP.ENDSEL
  GOSUB GMX.CHROME
  RETURN


## ***********************************************************************
## **  GMX.L.LOAD -- six rows and the whole MENUVERT interface, every time.
## **
## **  HOT$ AND HOTATTR ARE CLEARED HERE. They are sticky, the bar leaves its
## **  own letters in them, and MENUVERT.HOTKEY would match those against
## **  these rows.
## ***********************************************************************


GP.BANKEDSTR GM.TEXTBANK BS.L.LOAD
  " NEW GAME"
  " LOAD"
  " SAVE"
  " OPTIONS"
  " CREDITS"
  " QUIT"
GP.ENDBANKEDSTR
GMX.L.LOAD:
  MENUVERT.ITEM$(1) = GP.BSTR(BS.L.LOAD, 0)
  MENUVERT.ITEM$(2) = GP.BSTR(BS.L.LOAD, 1)
  MENUVERT.ITEM$(3) = GP.BSTR(BS.L.LOAD, 2)
  MENUVERT.ITEM$(4) = GP.BSTR(BS.L.LOAD, 3)
  MENUVERT.ITEM$(5) = GP.BSTR(BS.L.LOAD, 4)
  MENUVERT.ITEM$(6) = GP.BSTR(BS.L.LOAD, 5)
  MENUVERT.COUNT = 6 : MENUVERT.HOT$ = "" : MENUVERT.HOTATTR = 0
  MENUVERT.ATTR = THEME.CLR(THEME.TEXT)
  MENUVERT.HIATTR = THEME.CLR(THEME.HILITE)
  MENUVERT.FLAGS = 0 : MENUVERT.SEL = 0
  MENUVERT.X = 6 : MENUVERT.Y = 10
  MENUVERT.WIDTH = 20
  RETURN


## ---- The frame the demonstrations draw round the six rows. MENUVERT owns the
## ---- rows and nothing else, which is why this is here and not in the module.

GMX.L.FRAME:  GP.BOX 5, 9, 22, 8, 1, THEME.CLR(THEME.BORDER)
  RETURN


## ***********************************************************************
## **  GMX.L.RUN -- MENUVERT.RUN. Draws it, drives it, returns the row.
## ***********************************************************************


GP.BANKEDSTR GM.TEXTBANK BS.L.RUN
  "DRAWS IT AND DRIVES IT."
  "UP DOWN RETURN, ESC CANCELS."
  "THE FRAME IS THE CALLERS."
  "MENUVERT OWNS THE ROWS ONLY,"
  "SO IT OWES NOTHING TO ONE"
  "STYLE OF BORDER."
  "MENUVERT.RUN  SEL "
  "  KEY "
  "MENUVERT.RUN  CANCELLED"
GP.ENDBANKEDSTR
GMX.L.RUN:
  GOSUB GMX.CLEARPANEL : GOSUB GMX.L.LOAD : GOSUB GMX.L.FRAME
  GP.PRINTAT 32, 10, GP.BSTR(BS.L.RUN, 0), THEME.CLR(THEME.TEXT)
  GP.PRINTAT 32, 11, GP.BSTR(BS.L.RUN, 1), THEME.CLR(THEME.TEXT)
  GP.PRINTAT 32, 13, GP.BSTR(BS.L.RUN, 2), THEME.CLR(THEME.DIMMED)
  GP.PRINTAT 32, 14, GP.BSTR(BS.L.RUN, 3), THEME.CLR(THEME.DIMMED)
  GP.PRINTAT 32, 15, GP.BSTR(BS.L.RUN, 4), THEME.CLR(THEME.DIMMED)
  GP.PRINTAT 32, 16, GP.BSTR(BS.L.RUN, 5), THEME.CLR(THEME.DIMMED)
  GOSUB MENUVERT.RUN
  GM.RESULT$ = GP.BSTR(BS.L.RUN, 6) + MID$(STR$(MENUVERT.SEL), 2)
  GM.RESULT$ = GM.RESULT$ + GP.BSTR(BS.L.RUN, 7) + MID$(STR$(MENUVERT.KEY), 2)
  IF MENUVERT.SEL = 0 THEN GM.RESULT$ = GP.BSTR(BS.L.RUN, 8)
  RETURN


## ***********************************************************************
## **  GMX.L.DRAW -- MENUVERT.DRAW. The rows, and no key loop at all.
## ***********************************************************************


GP.BANKEDSTR GM.TEXTBANK BS.L.DRAW
  "PAINTS THE ROWS AND RETURNS."
  "NO KEYS, NO HIGHLIGHT, NO"
  "WAIT."
  "FOR A MENU THAT IS PART OF A"
  "PAGE RATHER THAN A CHOICE."
  "NOTHING IS DRIVING IT. PRESS A KEY."
  "MENUVERT.DRAW  SIX ROWS, NO KEY LOOP"
GP.ENDBANKEDSTR
GMX.L.DRAW:
  GOSUB GMX.CLEARPANEL : GOSUB GMX.L.LOAD : GOSUB GMX.L.FRAME : GOSUB MENUVERT.DRAW
  GP.PRINTAT 32, 10, GP.BSTR(BS.L.DRAW, 0), THEME.CLR(THEME.TEXT)
  GP.PRINTAT 32, 11, GP.BSTR(BS.L.DRAW, 1), THEME.CLR(THEME.TEXT)
  GP.PRINTAT 32, 12, GP.BSTR(BS.L.DRAW, 2), THEME.CLR(THEME.TEXT)
  GP.PRINTAT 32, 14, GP.BSTR(BS.L.DRAW, 3), THEME.CLR(THEME.DIMMED)
  GP.PRINTAT 32, 15, GP.BSTR(BS.L.DRAW, 4), THEME.CLR(THEME.DIMMED)
  GM.TELL$ = GP.BSTR(BS.L.DRAW, 5)
  GOSUB GMX.TELL
  GM.RESULT$ = GP.BSTR(BS.L.DRAW, 6)
  RETURN


## ***********************************************************************
## **  GMX.L.ROW -- MENUVERT.ROW, the one primitive under both modules.
## **
## **  MENUBAR aims this same routine sideways rather than repeating it, which
## **  is why a stale MENUVERT.SCROLL once corrupted the BAR as well as the
## **  dropdowns. Inputs are DRAWROW and DRAWATTR; everything else it reads is
## **  the interface the menu was already set up with.
## ***********************************************************************


GP.BANKEDSTR GM.TEXTBANK BS.L.ROW
  "ONE ROW, IN WHICHEVER"
  "ATTRIBUTE YOU NAME."
  "MENUBAR AIMS THIS SAME"
  "ROUTINE SIDEWAYS, WHICH IS"
  "THE WHOLE OF THAT MODULE."
  "ROWS 2 AND 5 REPAINTED. PRESS A KEY."
  "MENUVERT.ROW  TWO ROWS REPAINTED IN PLACE"
GP.ENDBANKEDSTR
GMX.L.ROW:
  GOSUB GMX.CLEARPANEL
  GOSUB GMX.L.LOAD : GOSUB GMX.L.FRAME : GOSUB MENUVERT.DRAW
  GP.PRINTAT 32, 10, GP.BSTR(BS.L.ROW, 0), THEME.CLR(THEME.TEXT)
  GP.PRINTAT 32, 11, GP.BSTR(BS.L.ROW, 1), THEME.CLR(THEME.TEXT)
  GP.PRINTAT 32, 13, GP.BSTR(BS.L.ROW, 2), THEME.CLR(THEME.DIMMED)
  GP.PRINTAT 32, 14, GP.BSTR(BS.L.ROW, 3), THEME.CLR(THEME.DIMMED)
  GP.PRINTAT 32, 15, GP.BSTR(BS.L.ROW, 4), THEME.CLR(THEME.DIMMED)

  MENUVERT.DRAWROW = 2
  MENUVERT.DRAWATTR = THEME.CLR(THEME.WARN)
  GOSUB MENUVERT.ROW
  MENUVERT.DRAWROW = 5
  MENUVERT.DRAWATTR = THEME.CLR(THEME.HILITE)
  GOSUB MENUVERT.ROW

  GM.TELL$ = GP.BSTR(BS.L.ROW, 5)
  GOSUB GMX.TELL
  GM.RESULT$ = GP.BSTR(BS.L.ROW, 6)
  RETURN


## ***********************************************************************
## **  GMX.L.BAR -- MENUBAR.RUN, on its own rather than as the shell's bar.
## **
## **  It reports the COLUMN and WIDTH of what was chosen, which is what lets
## **  a caller drop a panel under an item without working the layout out
## **  again -- GMX.DROP is built on exactly that.
## ***********************************************************************


GP.BANKEDSTR GM.TEXTBANK BS.L.BAR
  " FILE "
  " EDIT "
  " SEARCH "
  " HELP "
  "AN ITEM IS AS WIDE AS ITS TEXT. THERE IS NO"
  "COLUMN WIDTH, SO THE PADDING SPACES ARE"
  "INSIDE THE STRINGS."
  "LEFT RIGHT MOVE, RETURN PICKS, ESC EXITS."
  "MENUBAR.RUN  SEL "
  "  COLUMN "
  "  WIDTH "
  "MENUBAR.RUN  CANCELLED"
GP.ENDBANKEDSTR
GMX.L.BAR:
  GOSUB GMX.CLEARPANEL
  MENUVERT.ITEM$(1) = GP.BSTR(BS.L.BAR, 0)
  MENUVERT.ITEM$(2) = GP.BSTR(BS.L.BAR, 1)
  MENUVERT.ITEM$(3) = GP.BSTR(BS.L.BAR, 2)
  MENUVERT.ITEM$(4) = GP.BSTR(BS.L.BAR, 3)
  MENUVERT.COUNT = 4
  MENUVERT.HOT$ = "" : MENUVERT.HOTATTR = 0
  MENUVERT.ATTR = THEME.CLR(THEME.TITLE)
  MENUVERT.HIATTR = THEME.CLR(THEME.HILITE)
  MENUBAR.X = 6
  MENUBAR.Y = 10 : MENUBAR.GAP = 0 : MENUBAR.FLAGS = 0
  MENUBAR.SEL = 0

  GP.PRINTAT 6, 13, GP.BSTR(BS.L.BAR, 4), THEME.CLR(THEME.DIMMED)
  GP.PRINTAT 6, 14, GP.BSTR(BS.L.BAR, 5), THEME.CLR(THEME.DIMMED)
  GP.PRINTAT 6, 15, GP.BSTR(BS.L.BAR, 6), THEME.CLR(THEME.DIMMED)
  GP.PRINTAT 6, 17, GP.BSTR(BS.L.BAR, 7), THEME.CLR(THEME.TEXT)

  GOSUB MENUBAR.RUN
  GM.RESULT$ = GP.BSTR(BS.L.BAR, 8) + MID$(STR$(MENUBAR.SEL), 2)
  GM.RESULT$ = GM.RESULT$ + GP.BSTR(BS.L.BAR, 9) + MID$(STR$(MENUBAR.SELX), 2)
  GM.RESULT$ = GM.RESULT$ + GP.BSTR(BS.L.BAR, 10) + MID$(STR$(MENUBAR.SELW), 2)
  IF MENUBAR.SEL = 0 THEN GM.RESULT$ = GP.BSTR(BS.L.BAR, 11)
  RETURN


## ***********************************************************************
## **  GMX.L.HOT -- MENUVERT.HOT$. One letter a row, matched without case.
## **
## **  The letter is found in the ROW'S OWN TEXT, so " OPTIONS" with hotkey O
## **  needs no markup. A row not containing its hotkey is left alone, and only
## **  rows in the normal attribute are tinted -- on the selected row the
## **  highlight is already the message.
## ***********************************************************************


GP.BANKEDSTR GM.TEXTBANK BS.L.HOT
  "NLSOCQ"
  "ONE LETTER A ROW, TINTED"
  "WHERE IT ALREADY SITS IN THE"
  "ROWS OWN TEXT."
  "A HOTKEY CHOOSES ITS ROW"
  "RATHER THAN MOVING TO IT, SO"
  "N L S O C OR Q ENDS IT."
  "HOTKEYS  SEL "
  "  KEY "
GP.ENDBANKEDSTR
GMX.L.HOT:
  GOSUB GMX.CLEARPANEL
  GOSUB GMX.L.LOAD
  MENUVERT.HOT$ = GP.BSTR(BS.L.HOT, 0)
  MENUVERT.HOTATTR = THEME.CLR(THEME.WARN)
  GOSUB GMX.L.FRAME
  GP.PRINTAT 32, 10, GP.BSTR(BS.L.HOT, 1), THEME.CLR(THEME.TEXT)
  GP.PRINTAT 32, 11, GP.BSTR(BS.L.HOT, 2), THEME.CLR(THEME.TEXT)
  GP.PRINTAT 32, 12, GP.BSTR(BS.L.HOT, 3), THEME.CLR(THEME.TEXT)
  GP.PRINTAT 32, 14, GP.BSTR(BS.L.HOT, 4), THEME.CLR(THEME.DIMMED)
  GP.PRINTAT 32, 15, GP.BSTR(BS.L.HOT, 5), THEME.CLR(THEME.DIMMED)
  GP.PRINTAT 32, 16, GP.BSTR(BS.L.HOT, 6), THEME.CLR(THEME.DIMMED)
  GOSUB MENUVERT.RUN
  GM.RESULT$ = GP.BSTR(BS.L.HOT, 7) + MID$(STR$(MENUVERT.SEL), 2)
  GM.RESULT$ = GM.RESULT$ + GP.BSTR(BS.L.HOT, 8) + MID$(STR$(MENUVERT.KEY), 2)
  RETURN


## ***********************************************************************
## **  GMX.L.FLAGS -- KEEPMARK and NOWRAP, then MUSTSEL. Two menus.
## **
## **  MUSTSEL IS SHOWN SECOND AND ON ITS OWN because it is the one that
## **  changes what the user can do rather than how it looks: ESC stops
## **  working, and a menu is not leaving until an item is chosen.
## ***********************************************************************


GP.BANKEDSTR GM.TEXTBANK BS.L.FLAGS
  "THIS MENU HAS TWO FLAGS SET."
  "NOWRAP -- THE HIGHLIGHT STOPS AT"
  "THE ENDS INSTEAD OF WRAPPING."
  "KEEPMARK -- THE CHOSEN ITEM STAYS"
  "LIT AFTER THE MENU RETURNS."
  " IS STILL LIT. THAT IS KEEPMARK. PRESS A KEY."
  "ESC CHOSE NOTHING, SO KEEPMARK HAS NOTHING TO LEAVE LIT. PRESS A KEY."
  "THIS MENU HAS ONE FLAG SET, ON ITS OWN."
  "MUSTSEL -- ESC STOPS WORKING, SO"
  "THE MENU CANNOT BE LEFT WITHOUT"
  "CHOOSING SOMETHING."
  "TRY ESC. IT WILL NOT LEAVE"
  "UNTIL AN ITEM IS CHOSEN."
  "FLAGS  KEEPMARK SEL "
  "   MUSTSEL SEL "
GP.ENDBANKEDSTR
GMX.L.FLAGS:
  GOSUB GMX.CLEARPANEL : GOSUB GMX.L.LOAD
  MENUVERT.FLAGS = MENUVERT.NOWRAP + MENUVERT.KEEPMARK
  GOSUB GMX.L.FRAME
  GP.PRINTAT 32, 9, GP.BSTR(BS.L.FLAGS, 0), THEME.CLR(THEME.TITLE)
  GP.PRINTAT 32, 11, GP.BSTR(BS.L.FLAGS, 1), THEME.CLR(THEME.TEXT)
  GP.PRINTAT 32, 12, GP.BSTR(BS.L.FLAGS, 2), THEME.CLR(THEME.TEXT)
  GP.PRINTAT 32, 14, GP.BSTR(BS.L.FLAGS, 3), THEME.CLR(THEME.TEXT)
  GP.PRINTAT 32, 15, GP.BSTR(BS.L.FLAGS, 4), THEME.CLR(THEME.TEXT)
  GOSUB MENUVERT.RUN
  GM.KEPT% = MENUVERT.SEL

## ---- KEEPMARK only has something to keep if something was chosen. ESC sets
## ---- MENUVERT.SEL to 0 and takes the highlight off with it, which is right --
## ---- nothing was picked, so nothing should still be claiming attention. The
## ---- prompt said STILL LIT either way, over a menu with nothing lit on it.
  GP.IF GM.KEPT% > 0 THEN
    GM.TELL$ = MID$(MENUVERT.ITEM$(GM.KEPT%), 2) + GP.BSTR(BS.L.FLAGS, 5)
  GP.ELSE
    GM.TELL$ = GP.BSTR(BS.L.FLAGS, 6)
  GP.ENDIF
  GOSUB GMX.TELL

  GOSUB GMX.CLEARPANEL : GOSUB GMX.L.LOAD
  MENUVERT.FLAGS = MENUVERT.MUSTSEL
  GOSUB GMX.L.FRAME
  GP.PRINTAT 32, 9, GP.BSTR(BS.L.FLAGS, 7), THEME.CLR(THEME.TITLE)
  GP.PRINTAT 32, 11, GP.BSTR(BS.L.FLAGS, 8), THEME.CLR(THEME.TEXT)
  GP.PRINTAT 32, 12, GP.BSTR(BS.L.FLAGS, 9), THEME.CLR(THEME.TEXT)
  GP.PRINTAT 32, 13, GP.BSTR(BS.L.FLAGS, 10), THEME.CLR(THEME.TEXT)
  GP.PRINTAT 32, 15, GP.BSTR(BS.L.FLAGS, 11), THEME.CLR(THEME.WARN)
  GP.PRINTAT 32, 16, GP.BSTR(BS.L.FLAGS, 12), THEME.CLR(THEME.WARN)
  GOSUB MENUVERT.RUN

  GM.RESULT$ = GP.BSTR(BS.L.FLAGS, 13) + MID$(STR$(GM.KEPT%), 2)
  GM.RESULT$ = GM.RESULT$ + GP.BSTR(BS.L.FLAGS, 14) + MID$(STR$(MENUVERT.SEL), 2)
  RETURN


## ***********************************************************************
## **  GMX.INPUT -- the INPUT dropdown. LINEINPUT, one field and then several.
## ***********************************************************************

GMX.INPUT:
  GP.SELECT MENUVERT.SEL
  GP.CASE 1 : GOSUB GMX.I.GET
  GP.CASE 2 : GOSUB GMX.I.ASK
  GP.CASE 3 : GOSUB GMX.I.FORM
  GP.OTHER  : GOSUB GMX.I.LIMITS
  GP.ENDSEL
  GOSUB GMX.CHROME
  RETURN


## ---- The whole LINEINPUT interface, every time. Every field of it is sticky,
## ---- so a demonstration setting only what it varies inherits the last one's
## ---- mask and label -- which is how a plain field comes up full of asterisks.

GMX.I.RESET:
  LINEINPUT.X = 12 : LINEINPUT.Y = 11
  LINEINPUT.LEN = 20
  LINEINPUT.ATTR = THEME.CLR(THEME.HILITE)
  LINEINPUT.MASK = 0 : LINEINPUT.LABEL$ = ""
  LINEINPUT.LABELATTR = 0 : LINEINPUT.TEXT$ = ""
  RETURN


## ---- What a field answered, in the shape every row here reports it ----


GP.BANKEDSTR GM.TEXTBANK BS.I.SAID
  "]  KEY "
GP.ENDBANKEDSTR
GMX.I.SAID:
  GM.SAID$ = "[" + LINEINPUT.TEXT$ + GP.BSTR(BS.I.SAID, 0) + MID$(STR$(LINEINPUT.KEY), 2)
  RETURN


## ***********************************************************************
## **  GMX.I.GET -- LINEINPUT.GET. One field, and what ESC does to it.
## ***********************************************************************


GP.BANKEDSTR GM.TEXTBANK BS.I.GET
  "A FIELD THAT STAYS WHERE YOU PUT IT, IN THE COLOUR YOU"
  "GIVE IT. ESC PUTS BACK WHAT IT WAS RATHER THAN EMPTYING IT."
  "LINEINPUT.GET  "
  "  POS "
GP.ENDBANKEDSTR
GMX.I.GET:
  GOSUB GMX.CLEARPANEL
  GOSUB GMX.I.RESET
  GP.PRINTAT 6, 9, GP.BSTR(BS.I.GET, 0), THEME.CLR(THEME.DIMMED)
  GP.PRINTAT 6, 10, GP.BSTR(BS.I.GET, 1), THEME.CLR(THEME.DIMMED)
  GP.PRINTAT 6, 11, "NAME", THEME.CLR(THEME.TEXT)
  LINEINPUT.TEXT$ = "GPC"
  GOSUB LINEINPUT.GET
  GOSUB GMX.I.SAID
  GM.RESULT$ = GP.BSTR(BS.I.GET, 2) + GM.SAID$ + GP.BSTR(BS.I.GET, 3) + MID$(STR$(LINEINPUT.POS), 2)
  RETURN


## ***********************************************************************
## **  GMX.I.ASK -- LINEINPUT.ASK. The label, then the field after it.
## ***********************************************************************


GP.BANKEDSTR GM.TEXTBANK BS.I.ASK
  "ASK PRINTS THE LABEL AND PUTS THE FIELD AFTER IT."
  "FILE NAME: "
  "LINEINPUT.ASK  "
GP.ENDBANKEDSTR
GMX.I.ASK:
  GOSUB GMX.CLEARPANEL
  GOSUB GMX.I.RESET
  GP.PRINTAT 6, 9, GP.BSTR(BS.I.ASK, 0), THEME.CLR(THEME.DIMMED)
  LINEINPUT.X = 6
  LINEINPUT.LEN = 16
  LINEINPUT.LABEL$ = GP.BSTR(BS.I.ASK, 1)
  LINEINPUT.LABELATTR = THEME.CLR(THEME.TEXT)
  GOSUB LINEINPUT.ASK
  GOSUB GMX.I.SAID
  GM.RESULT$ = GP.BSTR(BS.I.ASK, 2) + GM.SAID$
  RETURN


## ***********************************************************************
## **  GMX.I.RUNFORM -- the focus loop. Both multi-field rows use it.
## **
## **  THIS IS WHAT LINEINPUT.KEY IS FOR. UP, DOWN and TAB leave a field
## **  WITHOUT cancelling it and say which way the focus went; only ESC puts
## **  the text back. That is why RETURN does not have to mean both "next
## **  field" and "done", and why a form can go back up.
## **
## **  CALLING LINEINPUT.GET IN A ROW INSTEAD IS A BUG, and it was one here:
## **  three plain calls treat every exit key as "next", so UP goes forward,
## **  ESC goes forward, and DOWN on the last field falls out of the panel.
## **
## **   in   GM.FCOUNT%   how many fields
## **        GM.FY%()  GM.FLEN%()  GM.FMASK%()   one entry a field
## **        GM.FLD$()   the text, edited in place
## **   out  GM.FLD$()   what was typed, and GM.FKEY% 13 accepted / 27 abandoned
## **
## **  THE FOUR ARRAYS ARE DIMMED AT THE TOP, with the others. They were left
## **  implicit, which works and costs 220 bytes of string heap for eleven
## **  slots holding three fields.
## ***********************************************************************

GMX.I.RUNFORM:
  GM.FOCUS% = 1
  GP.DO
    GOSUB GMX.I.RESET
    LINEINPUT.Y = GM.FY%(GM.FOCUS%)
    LINEINPUT.LEN = GM.FLEN%(GM.FOCUS%)
    LINEINPUT.MASK = GM.FMASK%(GM.FOCUS%)
    LINEINPUT.TEXT$ = GM.FLD$(GM.FOCUS%)
    GOSUB LINEINPUT.GET
    GM.FLD$(GM.FOCUS%) = LINEINPUT.TEXT$
    GM.FKEY% = LINEINPUT.KEY
    IF GM.FKEY% = 13 THEN GP.EXITDO
    IF GM.FKEY% = 27 THEN GP.EXITDO
    IF GM.FKEY% = 145 THEN GM.FOCUS% = GM.FOCUS% - 1
    IF GM.FKEY% <> 145 THEN GM.FOCUS% = GM.FOCUS% + 1
    IF GM.FOCUS% < 1 THEN GM.FOCUS% = GM.FCOUNT%
    IF GM.FOCUS% > GM.FCOUNT% THEN GM.FOCUS% = 1
  GP.LOOP
  RETURN


## ***********************************************************************
## **  GMX.I.FORM -- three fields of one size. The plain form.
## ***********************************************************************


GP.BANKEDSTR GM.TEXTBANK BS.I.FORM
  "UP DOWN AND TAB MOVE AND KEEP THE TEXT. RETURN ACCEPTS,"
  "ESC ABANDONS."
  "FORM  ["
  "FORM ABANDONED"
GP.ENDBANKEDSTR
GMX.I.FORM:
  GOSUB GMX.CLEARPANEL
  GP.PRINTAT 6, 9, GP.BSTR(BS.I.FORM, 0), THEME.CLR(THEME.DIMMED)
  GP.PRINTAT 6, 10, GP.BSTR(BS.I.FORM, 1), THEME.CLR(THEME.DIMMED)
  GP.PRINTAT 6, 12, "NAME", THEME.CLR(THEME.TEXT)
  GP.PRINTAT 6, 13, "CITY", THEME.CLR(THEME.TEXT)
  GP.PRINTAT 6, 14, "CODE", THEME.CLR(THEME.TEXT)

  GM.FCOUNT% = 3
  FOR GM.I = 1 TO GM.FCOUNT%
    GM.FLD$(GM.I) = ""
    GM.FY%(GM.I) = 11 + GM.I
    GM.FLEN%(GM.I) = 18
    GM.FMASK%(GM.I) = 0
  NEXT GM.I
  GOSUB GMX.I.RUNFORM

  GM.RESULT$ = GP.BSTR(BS.I.FORM, 2) + GM.FLD$(1) + "] [" + GM.FLD$(2) + "] [" + GM.FLD$(3) + "]"
  IF GM.FKEY% = 27 THEN GM.RESULT$ = GP.BSTR(BS.I.FORM, 3)
  RETURN


## ***********************************************************************
## **  GMX.I.LIMITS -- the same three fields at different widths, and a mask.
## **
## **  A FIELD NEVER SCROLLS. Full, it refuses the character and leaves the
## **  caret on the last one rather than off the end.
## ***********************************************************************


GP.BANKEDSTR GM.TEXTBANK BS.I.LIMITS
  "FULL, A FIELD REFUSES THE KEY. NO SCROLL."
  "UP DOWN TAB MOVE, RETURN ACCEPTS, ESC QUITS."
  "LEN 4"
  "LEN 30"
  "MASKED"
  "LIMITS  4 ["
  "   30 TOOK "
  "   MASKED ["
  "LIMITS ABANDONED"
GP.ENDBANKEDSTR
GMX.I.LIMITS:
  GOSUB GMX.CLEARPANEL
  GP.PRINTAT 6, 9, GP.BSTR(BS.I.LIMITS, 0), THEME.CLR(THEME.DIMMED)
  GP.PRINTAT 6, 10, GP.BSTR(BS.I.LIMITS, 1), THEME.CLR(THEME.DIMMED)
  GP.PRINTAT 6, 12, GP.BSTR(BS.I.LIMITS, 2), THEME.CLR(THEME.TEXT)
  GP.PRINTAT 6, 13, GP.BSTR(BS.I.LIMITS, 3), THEME.CLR(THEME.TEXT)
  GP.PRINTAT 6, 14, GP.BSTR(BS.I.LIMITS, 4), THEME.CLR(THEME.TEXT)

  GM.FCOUNT% = 3
  FOR GM.I = 1 TO GM.FCOUNT%
    GM.FLD$(GM.I) = ""
    GM.FY%(GM.I) = 11 + GM.I
    GM.FMASK%(GM.I) = 0
  NEXT GM.I
  GM.FLEN%(1) = 4
  GM.FLEN%(2) = 30
  GM.FLEN%(3) = 12
  GM.FMASK%(3) = 1
  GOSUB GMX.I.RUNFORM

  GM.RESULT$ = GP.BSTR(BS.I.LIMITS, 5) + GM.FLD$(1) + "]"
  GM.RESULT$ = GM.RESULT$ + GP.BSTR(BS.I.LIMITS, 6) + MID$(STR$(LEN(GM.FLD$(2))), 2)
  GM.RESULT$ = GM.RESULT$ + GP.BSTR(BS.I.LIMITS, 7) + GM.FLD$(3) + "]"
  IF GM.FKEY% = 27 THEN GM.RESULT$ = GP.BSTR(BS.I.LIMITS, 8)
  RETURN


## ***********************************************************************
## **  GMX.STRINGS -- one item a STRINGS.INC.BL routine.
## **
## **  Every item does the call on a real string and shows what came back.
## **  The prose is two lines an item and printed by GMX.G.SAY: banked text is
## **  free of low RAM but NOT of the object, and this program is close to
## **  the ceiling the file itself has. See the note above GMX.G.SAY.
## ***********************************************************************

GMX.STRINGS:
  GP.SELECT MENUVERT.SEL
  GP.CASE 1
    GOSUB GMX.G.PADR
  GP.CASE 2
    GOSUB GMX.G.PADL
  GP.CASE 3
    GOSUB GMX.G.PADC
  GP.CASE 4
    GOSUB GMX.G.SPLIT
  GP.CASE 5
    GOSUB GMX.G.REPLACE
  GP.CASE 6
    GOSUB GMX.G.CASE
  GP.CASE 7
    GOSUB GMX.G.USING
  GP.OTHER
    GOSUB GMX.G.USINGFIX
  GP.ENDSEL
  GOSUB GMX.CHROME
  RETURN


## ***********************************************************************
## **  GMX.G.SAY -- a heading and a line under it, from one group.
## **
## **   in   GM.GRP%   the group's first index, as GP.BSTR would take it
## **
## **  IT TAKES A FLAT INDEX AND NOT A GROUP NAME, which is the one place in
## **  this program that does. A group name is resolved while the program
## **  compiles, so it cannot be passed to a shared routine -- and five panels
## **  each spelling out four GP.PRINTATs cost more than the indirection does.
## **  BS.G.SAY is the group every panel below reads through it.
## ***********************************************************************

## ---- TWO LINES A PANEL -- a heading and one line under it, read as a pair, so
## ---- a panel's index into this group is always even. STRINGS filled the first
## ---- eight pairs and DATA and ABOUT took the next five. They are in one group
## ---- because GMX.G.SAY names one group, and a group name cannot be passed.
## ----
## ---- IN BANK 6, NOT BANK 5, and that is the only reason it is: bank 5's pool
## ---- is a full 8,192 bytes and this group is ~830 of them. Which bank a group
## ---- is in costs the call site nothing, so moving one is how a full pool is
## ---- answered.

GP.BANKEDSTR GM.TEXTBANKB BS.G.SAY
  "STR.PADR  PAD ON THE RIGHT"
  "STR.WIDTH IS HOW WIDE THE ANSWER IS."
  "STR.PADL  PAD ON THE LEFT"
  "STR.WIDTH IS HOW WIDE THE ANSWER IS."
  "STR.PADC  PAD BOTH ENDS"
  "AN ODD GAP FAVOURS THE RIGHT."
  "STR.SPLIT  ONE STRING INTO A FIELD ARRAY"
  ""
  "STR.REPLACE  EVERY OCCURRENCE, IN ONE PASS"
  "SHORTER, LONGER, OR EMPTY. CASE SENSITIVE."
  "STRCASE.GO  CASE, IN PLACE"
  "IT REWRITES IN PLACE, SO IT TAKES AN ADDRESS."
  "SORT.RUN  A STRING ARRAY, IN PLACE"
  ""
  "GP.ARRPTR  THE ADDRESS OF ELEMENT ZERO"
  "THE COUNT AND THE TYPE ARE THE THREE BYTES BELOW IT."
  "MEMORY  WHAT IS LEFT, RIGHT NOW"
  "FRE(0) IS READ NOW. THE P-CODE SIZES ARE FROM THE BUILD."
  "MODULE SIZES  P-CODE BYTES PER MODULE"
  "FROM THE MAP FILE AGAINST THE SYM."
  "STR.USING  A NUMBER THROUGH A MASK"
  "THE RESULT IS THE MASK'S WIDTH, ALWAYS."
  "STR.USING.FIX  DECIMAL PLACES, NO MASK"
  "AS WIDE AS THE NUMBER NEEDS. NO PADDING."
GP.ENDBANKEDSTR

##  The strings the STRINGS rows work ON, and the labels they print with.
##  Kept apart from BS.G.SAY so the panel prose can change length without
##  renumbering any of this.
GP.BANKEDSTR GM.TEXTBANK BS.G.DATA
  "GPC-BASIC"
  "ALPHA,BRAVO,CHARLIE,DELTA"
  "ONE FISH TWO FISH RED FISH"
  "FISH"
  "BIRD"
  "GPC BASIC"
  "PRESS A KEY."
  "  FOUR FIELD WIDTHS"
  "STR.SPLIT  FIELDS: "
  "STR.REPLACE  THREE OCCURRENCES"
  "STRCASE.GO  DOWN AND BACK, UNCHANGED"
  "THE FONT HAS NO LOWER CASE, SO ONLY THE BYTES SHOW IT."
  "FIRST BYTE  START "
  "  LOWER "
  "  UPPER "
GP.ENDBANKEDSTR
GMX.G.SAY:
  GOSUB GMX.CLEARPANEL
  GP.PRINTAT 4, 9, GP.BSTR(BS.G.SAY, GM.GRP%), THEME.CLR(THEME.TITLE)

## ---- The second line is OPTIONAL, and left empty where the panel below it already
## ---- shows what the sentence would have said. The pair stays either way: GM.GRP% is
## ---- the ordinal doubled, written as a constant at nine call sites, so dropping a
## ---- string would renumber all of them.

  GM.SAY2$ = GP.BSTR(BS.G.SAY, GM.GRP% + 1)
  IF GM.SAY2$ <> "" THEN GP.PRINTAT 4, 11, GM.SAY2$, THEME.CLR(THEME.DIMMED)
  RETURN



## The three pads differ only in the routine they call, so they share a body.

GMX.G.PADR:
  GM.PADOP% = 0
  GOTO GMX.G.PADS

GMX.G.PADL:
  GM.PADOP% = 1
  GOTO GMX.G.PADS

GMX.G.PADC:
  GM.PADOP% = 2

GMX.G.PADS:
  GM.GRP% = GM.PADOP% * 2
  GOSUB GMX.G.SAY
  FOR GM.I = 1 TO 4
    STR.STR$ = GP.BSTR(BS.G.DATA, 0)
    GM.PADW% = 6 + GM.I * 4
    STR.WIDTH = GM.PADW%
    IF GM.PADOP% = 0 THEN GOSUB STR.PADR
    IF GM.PADOP% = 1 THEN GOSUB STR.PADL
    IF GM.PADOP% = 2 THEN GOSUB STR.PADC
    GM.PADSHOW$ = MID$(STR$(GM.PADW%), 2) + "  [" + STR.STR$ + "]"
    GP.PRINTAT 6, 14 + GM.I, GM.PADSHOW$, THEME.CLR(THEME.TEXT)
  NEXT GM.I
  GM.TELL$ = GP.BSTR(BS.G.DATA, 6)
  GOSUB GMX.TELL
  GM.RESULT$ = GP.BSTR(BS.G.SAY, GM.GRP%) + GP.BSTR(BS.G.DATA, 7)
  RETURN


## ***********************************************************************
## **  GMX.G.SPLIT -- one string into STR.FIELD$, and the count in STR.N.
## ***********************************************************************

GMX.G.SPLIT:
  GM.GRP% = 6
  GOSUB GMX.G.SAY
  STR.STR$ = GP.BSTR(BS.G.DATA, 1)
  STR.DELIM$ = ","
  STR.MAX = 8
  GOSUB STR.SPLIT
  GP.PRINTAT 4, 14, STR.STR$, THEME.CLR(THEME.WARN)
  FOR GM.I = 1 TO STR.N
    GP.PRINTAT 6, 15 + GM.I, "[" + STR.FIELD$(GM.I) + "]", THEME.CLR(THEME.TEXT)
  NEXT GM.I
  GM.TELL$ = GP.BSTR(BS.G.DATA, 6)
  GOSUB GMX.TELL
  GM.RESULT$ = GP.BSTR(BS.G.DATA, 8) + MID$(STR$(STR.N), 2)
  RETURN


## ***********************************************************************
## **  GMX.G.REPLACE -- every occurrence, in one pass.
## ***********************************************************************

GMX.G.REPLACE:
  GM.GRP% = 8
  GOSUB GMX.G.SAY
  STR.STR$ = GP.BSTR(BS.G.DATA, 2)
  GP.PRINTAT 6, 15, STR.STR$, THEME.CLR(THEME.WARN)
  STR.FIND$ = GP.BSTR(BS.G.DATA, 3)
  STR.REPL$ = GP.BSTR(BS.G.DATA, 4)
  GOSUB STR.REPLACE
  GP.PRINTAT 6, 17, STR.STR$, THEME.CLR(THEME.TEXT)
  GM.TELL$ = GP.BSTR(BS.G.DATA, 6)
  GOSUB GMX.TELL
  GM.RESULT$ = GP.BSTR(BS.G.DATA, 9)
  RETURN


## ***********************************************************************
## **  GMX.G.CASE -- STRCASE, which rewrites the block where it lies.
## **
## **  SHOWN AS BYTE VALUES AND NOT AS TEXT, because the default font draws
## **  lower case on its graphics half: a lower-cased string prints as symbols
## **  even though its bytes are perfectly right. So the round trip is proved
## **  with ASC and only the upper form is put on the screen.
## **
## **  The string is a VARIABLE, never a literal. GP.STRPTR of a literal is an
## **  address inside the p-code, and rewriting it edits the program.
## ***********************************************************************

GMX.G.CASE:
  GM.GRP% = 10
  GOSUB GMX.G.SAY
  GP.PRINTAT 4, 14, GP.BSTR(BS.G.DATA, 11), THEME.CLR(THEME.DIMMED)

  GM.CASE$ = GP.BSTR(BS.G.DATA, 5)
  STRCASE.PTR = GP.STRPTR(GM.CASE$)
  GM.SHOW$ = GP.BSTR(BS.G.DATA, 12) + MID$(STR$(ASC(GM.CASE$)), 2)
  STRCASE.MODE = STRCASE.LOWER
  GOSUB STRCASE.GO
  GM.SHOW$ = GM.SHOW$ + GP.BSTR(BS.G.DATA, 13) + MID$(STR$(ASC(GM.CASE$)), 2)
  STRCASE.MODE = STRCASE.UPPER
  GOSUB STRCASE.GO
  GM.SHOW$ = GM.SHOW$ + GP.BSTR(BS.G.DATA, 14) + MID$(STR$(ASC(GM.CASE$)), 2)
  GP.PRINTAT 6, 17, GM.SHOW$, THEME.CLR(THEME.TEXT)
  GP.PRINTAT 6, 18, GM.CASE$, THEME.CLR(THEME.WARN)

  GM.TELL$ = GP.BSTR(BS.G.DATA, 6)
  GOSUB GMX.TELL
  GM.RESULT$ = GP.BSTR(BS.G.DATA, 10)
  RETURN


## ***********************************************************************
## **  GMX.G.USING -- STR.USING, one mask over six magnitudes.
## **
## **  THE VALUE CLIMBS BY A DIGIT A ROW, so the column proves the two things
## **  the mask is for: every result is the same width and lines up on the
## **  point, and the last one does not fit and fills with "*". Grown
## **  arithmetically rather than read from a table -- six literals would say
## **  no more and would need somewhere to live.
## **
## **  THE MASK IS READ FROM A BANKED STRING and assigned to STR.USING.MASK$
## **  once. GP.BSTR builds a temporary on every call, and a string block is
## **  never freed, so a fetch inside the loop would spend six blocks saying
## **  the same eight characters.
## ***********************************************************************


GP.BANKEDSTR GM.TEXTBANKB BS.G.USING
  "#,##0.00"
  "  MASK        VALUE            RESULT"
  "PRESS A KEY."
  "STR.USING  SIX MAGNITUDES, ONE MASK"
  "  PLACES "
  "STR.USING.FIX  FIVE WIDTHS OF ONE VALUE"
GP.ENDBANKEDSTR
GMX.G.USING:
  GM.GRP% = 20
  GOSUB GMX.G.SAY
  GP.PRINTAT 4, 12, GP.BSTR(BS.G.USING, 1), THEME.CLR(THEME.DIMMED)

  STR.USING.MASK$ = GP.BSTR(BS.G.USING, 0)
  GM.UVAL = 0.5
  GM.SROW% = 14
  FOR GM.I = 1 TO 6
    STR.USING.NUM = GM.UVAL
    GOSUB STR.USING
    GP.PRINTAT 6, GM.SROW%, STR.USING.MASK$, THEME.CLR(THEME.DIMMED)
    GP.PRINTAT 20, GM.SROW%, MID$(STR$(GM.UVAL), 2), THEME.CLR(THEME.TEXT)
    GP.PRINTAT 40, GM.SROW%, STR.USING.STR$, THEME.CLR(THEME.TITLE)
    GM.SROW% = GM.SROW% + 1
    GM.UVAL = GM.UVAL * 10 + GM.I
  NEXT GM.I

  GM.TELL$ = GP.BSTR(BS.G.USING, 2)
  GOSUB GMX.TELL
  GM.RESULT$ = GP.BSTR(BS.G.USING, 3)
  RETURN


## ***********************************************************************
## **  GMX.G.USINGFIX -- STR.USING.FIX, the same value at five widths.
## **
## **  NO MASK AND NO PADDING: the result is as wide as the number needs, so
## **  a column of these does NOT line up. That is the difference the row is
## **  here to show, and it is why STR.USING exists on top of it.
## **
## **  ROUNDING IS HALF AWAY FROM ZERO. 1234.56789 at nought places is 1235,
## **  not 1234.
## ***********************************************************************

GMX.G.USINGFIX:
  GM.GRP% = 22
  GOSUB GMX.G.SAY
  GM.SROW% = 14
  FOR GM.I = 0 TO 4
    STR.USING.NUM = 1234.56789
    STR.USING.DP = GM.I
    GOSUB STR.USING.FIX
    GP.PRINTAT 6, GM.SROW%, GP.BSTR(BS.G.USING, 4) + MID$(STR$(GM.I), 2), THEME.CLR(THEME.DIMMED)
    GP.PRINTAT 24, GM.SROW%, STR.USING.STR$, THEME.CLR(THEME.TITLE)
    GM.SROW% = GM.SROW% + 1
  NEXT GM.I

  GM.TELL$ = GP.BSTR(BS.G.USING, 2)
  GOSUB GMX.TELL
  GM.RESULT$ = GP.BSTR(BS.G.USING, 5)
  RETURN


## ***********************************************************************
## **  GMX.DATA -- the DATA dropdown.
## ***********************************************************************

GMX.DATA:
  GP.SELECT MENUVERT.SEL
  GP.CASE 1
    GOSUB GMX.A.SORT
  GP.OTHER
    GOSUB GMX.A.ARRAY
  GP.ENDSEL
  GOSUB GMX.CHROME
  RETURN


## ***********************************************************************
## **  GMX.A.SORT -- SORT.RUN, three columns of the same ten words.
## **
## **  THE ARRAY IS RELOADED BEFORE EACH SORT. SORT.RUN moves the pointers in
## **  place, so there is no before to go back to once it has run -- the only
## **  way to show as-built beside sorted is to build it again.
## **
## **  SORT.NOCASE IS SET AND NOT DEMONSTRATED. Folding case needs a mixed-case
## **  word on the screen, and lower case lands on the graphics half of the
## **  default font, so the column would be drawn as shapes.
## ***********************************************************************


## ---- Ten words, the three column headings, then the two things the panel can
## ---- have to report. Deliberately not in order, and not reverse order either.

GP.BANKEDSTR GM.TEXTBANK BS.A.SORT
  "DELTA"
  "ALPHA"
  "ECHO"
  "BRAVO"
  "GOLF"
  "CHARLIE"
  "JULIET"
  "FOXTROT"
  "HOTEL"
  "INDIA"
  "AS BUILT"
  "ASCENDING"
  "DESCENDING"
  "SORT.RUN  ELEMENTS SORTED: "
  "SORT.RUN  REFUSED THE ARRAY"
GP.ENDBANKEDSTR
GMX.A.SORT:
  GM.GRP% = 12
  GOSUB GMX.G.SAY
  SORT.PTR = GP.ARRPTR(GM.SORT$())
  SORT.NOCASE = 0

  GM.COLX% = 6 : GM.COLG% = 10
  GOSUB GMX.A.LOAD
  GOSUB GMX.A.COL

  GM.COLX% = 26 : GM.COLG% = 11
  GOSUB GMX.A.LOAD
  SORT.DESCEND = 0
  GOSUB SORT.RUN
  GOSUB GMX.A.COL

  GM.COLX% = 46 : GM.COLG% = 12
  GOSUB GMX.A.LOAD
  SORT.DESCEND = -1
  GOSUB SORT.RUN
  GOSUB GMX.A.COL

  GM.TELL$ = GP.BSTR(BS.G.DATA, 6)
  GOSUB GMX.TELL
  GM.RESULT$ = GP.BSTR(BS.A.SORT, 13) + MID$(STR$(SORT.COUNT), 2)
  IF SORT.OK = 0 THEN GM.RESULT$ = GP.BSTR(BS.A.SORT, 14)
  RETURN


## ---- The array back to as-built, and one column of it on the screen ----

GMX.A.LOAD:
  FOR GM.I = 0 TO 9
    GM.SORT$(GM.I) = GP.BSTR(BS.A.SORT, GM.I)
  NEXT GM.I
  RETURN

GMX.A.COL:
  GP.PRINTAT GM.COLX%, 12, GP.BSTR(BS.A.SORT, GM.COLG%), THEME.CLR(THEME.WARN)
  FOR GM.I = 0 TO 9
    GP.PRINTAT GM.COLX%, 13 + GM.I, GM.SORT$(GM.I), THEME.CLR(THEME.TEXT)
  NEXT GM.I
  RETURN


## ***********************************************************************
## **  GMX.A.ARRAY -- GP.ARRPTR, and the three bytes below what it returns.
## **
## **  WHAT THE MACHINE REPORTS, not what the header file says it should. The
## **  count and the type are PEEKed back out of the array and printed as
## **  found -- which is the same reading SORT.RUN does to decide whether it
## **  will touch the array at all.
## **
## **  The type byte off the screen: bit 7 set marks a SUB-ARRAY. It is left out
## **  of the panel because 128 sitting beside the 64 this array reports reads as
## **  a contradiction rather than a second fact.
## ***********************************************************************


GP.BANKEDSTR GM.TEXTBANK BS.A.ARRAY
  "GM.SORT$()  ELEMENT ZERO AT "
  "COUNT LOW   AT "
  "COUNT HIGH  AT "
  "TYPE        AT "
  "  IS "
  "COUNT IS "
  " + "
  " * 256 = "
  " ELEMENTS"
  "TYPE 64 IS A STRING ARRAY. A NUMBER ARRAY IS 0."
  "AN ELEMENT IS 2 BYTES FOR $ AND %, 6 FOR A PLAIN DIM."
GP.ENDBANKEDSTR
GMX.A.ARRAY:
  GM.GRP% = 14
  GOSUB GMX.G.SAY
  GM.PTR = GP.ARRPTR(GM.SORT$())
  GM.B0 = PEEK(GM.PTR - 3)
  GM.B1 = PEEK(GM.PTR - 2)
  GM.B2 = PEEK(GM.PTR - 1)

  GP.PRINTAT 4, 13, GP.BSTR(BS.A.ARRAY, 0) + MID$(STR$(GM.PTR), 2), THEME.CLR(THEME.WARN)
  GP.PRINTAT 6, 15, GP.BSTR(BS.A.ARRAY, 1) + MID$(STR$(GM.PTR - 3), 2) + GP.BSTR(BS.A.ARRAY, 4) + MID$(STR$(GM.B0), 2), THEME.CLR(THEME.TEXT)
  GP.PRINTAT 6, 16, GP.BSTR(BS.A.ARRAY, 2) + MID$(STR$(GM.PTR - 2), 2) + GP.BSTR(BS.A.ARRAY, 4) + MID$(STR$(GM.B1), 2), THEME.CLR(THEME.TEXT)
  GP.PRINTAT 6, 17, GP.BSTR(BS.A.ARRAY, 3) + MID$(STR$(GM.PTR - 1), 2) + GP.BSTR(BS.A.ARRAY, 4) + MID$(STR$(GM.B2), 2), THEME.CLR(THEME.TEXT)
  GP.PRINTAT 6, 19, GP.BSTR(BS.A.ARRAY, 5) + MID$(STR$(GM.B0), 2) + GP.BSTR(BS.A.ARRAY, 6) + MID$(STR$(GM.B1), 2) + GP.BSTR(BS.A.ARRAY, 7) + MID$(STR$(GM.B0 + GM.B1 * 256), 2) + GP.BSTR(BS.A.ARRAY, 8), THEME.CLR(THEME.HILITE)
  GP.PRINTAT 4, 21, GP.BSTR(BS.A.ARRAY, 9), THEME.CLR(THEME.DIMMED)
  GP.PRINTAT 4, 22, GP.BSTR(BS.A.ARRAY, 10), THEME.CLR(THEME.DIMMED)

  GM.TELL$ = GP.BSTR(BS.G.DATA, 6)
  GOSUB GMX.TELL
  GM.RESULT$ = GP.BSTR(BS.A.ARRAY, 0) + MID$(STR$(GM.PTR), 2)
  RETURN


## ***********************************************************************
## **  GMX.THEME -- select a theme, and repaint the program under it.
## **
## **  THE REPAINT IS THE DEMONSTRATION. Every colour in this program is read
## **  from THEME.CLR, so filling that array and drawing again is the whole of
## **  changing theme -- there is nothing else to tell.
## **
## **  The roles are then listed twice, once in THEME.TEXT and once each in
## **  its own attribute, because a repaint shows that something moved without
## **  saying which role moved where. Twice rather than a blank swatch: an
## **  attribute is a background AND a foreground, and a run of spaces only
## **  ever shows the background half.
## **
## **  CHROME IS REPAINTED BEFORE the panel rather than after it, unlike every
## **  other panel here. The point is to be looking at the new colours while
## **  the swatches explain them.
## ***********************************************************************

GP.BANKEDSTR GM.TEXTBANK BS.THEME
  "THEME.SELECT "
  "THE EIGHT ROLES, EACH IN ITS OWN ATTRIBUTE"
  "EVERY DRAW READS ITS COLOUR FROM THEME.CLR."
  "A THEME REFILLS THAT ARRAY. NOTHING ELSE."
  "PAGE"
  "TEXT"
  "TITLE"
  "BORDER"
  "HILITE"
  "DIMMED"
  "WARN"
  "FOCUS"
GP.ENDBANKEDSTR
GMX.THEME:
  THEME.ID = MENUVERT.SEL - 1
  GOSUB THEME.SELECT
  GM.RESULT$ = GP.BSTR(BS.THEME, 0) + GP.BSTR(BS.DD.THEME, MENUVERT.SEL)
  GOSUB GMX.CHROME

  GOSUB GMX.CLEARPANEL
  GP.PRINTAT 4, 9, GP.BSTR(BS.THEME, 1), THEME.CLR(THEME.TITLE)
  GP.PRINTAT 4, 11, GP.BSTR(BS.THEME, 2), THEME.CLR(THEME.DIMMED)
  GP.PRINTAT 4, 12, GP.BSTR(BS.THEME, 3), THEME.CLR(THEME.DIMMED)

  FOR GM.I = 0 TO THEME.SLOTS - 1
    GP.PRINTAT 6, 14 + GM.I, GP.BSTR(BS.THEME, 4 + GM.I), THEME.CLR(THEME.TEXT)
    GP.PRINTAT 20, 14 + GM.I, GP.BSTR(BS.THEME, 4 + GM.I), THEME.CLR(GM.I)
  NEXT GM.I

  GM.TELL$ = GP.BSTR(BS.G.DATA, 6)
  GOSUB GMX.TELL
  RETURN


## ***********************************************************************
## **  GMX.ABOUT -- the ABOUT dropdown.
## ***********************************************************************

GMX.ABOUT:
  GP.SELECT MENUVERT.SEL
  GP.CASE 1
    GOSUB GMX.B.PROGRAM
  GP.CASE 2
    GOSUB GMX.B.MEMORY
  GP.CASE 3
    GOSUB GMX.B.SIZES
  GP.OTHER
    GOSUB GMX.BANKMAP
  GP.ENDSEL
  GOSUB GMX.CHROME
  RETURN


## ***********************************************************************
## **  GMX.B.PROGRAM -- what this is and how big it is on the drive.
## **
## **  THE SIZE IS ASKED FOR, NOT WRITTEN DOWN. ABOUT / MODULE SIZES and the
## **  last two rows of ABOUT / MEMORY are literals that go stale on the next
## **  build; GP.FN(FILE.SIZE, ...) asks the drive, so this one is right by
## **  construction. Blocks, not bytes -- see its header for why there is no
## **  byte count to be had.
## **
## **  THE NAME IS PULLED OUT OF THE BANK FIRST, into GM.PNAME$, rather than
## **  written inline as GP.FN(FILE.SIZE, GP.BSTR(...)). Every GP.BSTR selects
## **  the text bank and the verb selects its own, so keeping them in separate
## **  statements keeps them from arguing over an argument -- and the panel
## **  needs the name a second time anyway.
## **
## **  NOT FINDING IT IS NOT AN ERROR. A program started from a build directory
## **  that has since moved still runs, and the panel says so instead.
## ***********************************************************************

GP.BANKEDSTR GM.TEXTBANK BS.B.PROGRAM
  " PROGRAM "
  "GPBMODS.PRG"
  "FILE     "
  "SIZE     "
  " BLOCKS"
  "NOT ON THE DRIVE"
  "VERSION  1.0.0"
GP.ENDBANKEDSTR
GMX.B.PROGRAM:
  GOSUB GMX.D.RESET
  GM.PNAME$ = GP.BSTR(BS.B.PROGRAM, 1)
  GM.PBLK% = GP.FN(FILE.SIZE, GM.PNAME$)
  GUI.TITLE$ = GP.BSTR(BS.B.PROGRAM, 0)
  GUI.MSG$ = GP.BSTR(BS.B.PROGRAM, 2) + GM.PNAME$
  GUI.MSG2$ = GP.BSTR(BS.B.PROGRAM, 3) + GP.BSTR(BS.B.PROGRAM, 5)
  IF GM.PBLK% > 0 THEN GUI.MSG2$ = GP.BSTR(BS.B.PROGRAM, 3) + MID$(STR$(GM.PBLK%), 2) + GP.BSTR(BS.B.PROGRAM, 4)
  GUI.MSG3$ = GP.BSTR(BS.B.PROGRAM, 6)
  GOSUB GUI.SAY
  RETURN


## ***********************************************************************
## **  GMX.B.MEMORY -- what is left, asked at the moment the row is chosen.
## **
## **  EVERY NUMBER HERE IS A RUN-TIME ONE. FRE and BANKMGR.COUNT are asked
## **  now; the two bank numbers are compile-time constants and are shown as
## **  such. The size of the p-code is not on this panel at all, because
## **  nothing running can measure it -- see GMX.B.SIZES.
## **
## **  THE SELECTED BANK IS READ FIRST. Every GP.BSTR below it selects the text
## **  bank to fetch its string, so asking afterwards would only ever report
## **  GM.TEXTBANK back.
## **
## **  THE LAST TWO ROWS ARE WRITTEN OUT, not worked out. Nothing running can
## **  measure the object it was loaded from, so they are literals, and they
## **  are only true of the build they were taken from -- the same bargain as
## **  ABOUT / MODULE SIZES. Their number fields are a fixed width, so
## **  correcting one after a rebuild costs the text bank nothing.
## **
## **  ONE OVERLAY FILE A BANK. Every GP.BANKED region and every GP.BANKEDSTR
## **  bank is written as its own .Bnn beside the .PRG and loaded to $A000,
## **  so the count is the number of banks named in the source, not a
## **  property of the program's size. This one names four: 4 and 7 for code,
## **  5 and 6 for text.
## ***********************************************************************


GP.BANKEDSTR GM.TEXTBANK BS.B.MEM
  "FRE(0)  BYTES FREE  "
  "TOTAL BANKS "
  "   UNUSED "
  "CODE BANKS #"
  "  TEXT BANKS #"
  "BANK SELECTED NOW  #"
  "RESIDENT P-CODE  14080    MAP TOTAL  24421"
  "OVERLAYS 4  .B04 6914 .B05 7682 .B06 3330 .B07 4866"
GP.ENDBANKEDSTR
GMX.B.MEMORY:
  GM.GRP% = 16
  GOSUB GMX.G.SAY
  GOSUB GMX.BANKNOW
  GOSUB BANKMGR.COUNT

  GP.PRINTAT 4, 13, GP.BSTR(BS.B.MEM, 0) + MID$(STR$(FRE(0)), 2), THEME.CLR(THEME.WARN)
  GP.PRINTAT 4, 15, GP.BSTR(BS.B.MEM, 1) + MID$(STR$(BANKMGR.BANKS), 2) + GP.BSTR(BS.B.MEM, 2) + MID$(STR$(BANKMGR.SPARE), 2), THEME.CLR(THEME.TEXT)
## Three code banks and two text ones, built in two halves: one line naming all
## five runs past BASLOAD's line length.
  GM.BMEM$ = GP.BSTR(BS.B.MEM, 3) + MID$(STR$(LIB.GUIBANK), 2) + " #" + MID$(STR$(LIB.UTILBANK), 2) + " #" + MID$(STR$(LIB.FUTILBANK), 2)
  GM.BMEM$ = GM.BMEM$ + GP.BSTR(BS.B.MEM, 4) + MID$(STR$(GM.TEXTBANK), 2) + " #" + MID$(STR$(GM.TEXTBANKB), 2)
  GP.PRINTAT 4, 16, GM.BMEM$, THEME.CLR(THEME.TEXT)
  GP.PRINTAT 4, 17, GP.BSTR(BS.B.MEM, 5) + MID$(STR$(GM.BANKNOW%), 2), THEME.CLR(THEME.TEXT)
  GP.PRINTAT 4, 19, GP.BSTR(BS.B.MEM, 6), THEME.CLR(THEME.TEXT)
  GP.PRINTAT 4, 20, GP.BSTR(BS.B.MEM, 7), THEME.CLR(THEME.TEXT)

  GM.TELL$ = GP.BSTR(BS.G.DATA, 6)
  GOSUB GMX.TELL
  GM.RESULT$ = GP.BSTR(BS.B.MEM, 0) + MID$(STR$(FRE(0)), 2)
  RETURN


## ***********************************************************************
## **  GMX.B.SIZES -- p-code bytes per module.
## **
## **  A STATIC TABLE, AND IT HAS TO BE. The p-code is written while the
## **  program compiles and nothing is left in the object saying which include
## **  a byte came from, so a running program cannot count this. The numbers
## **  come from differencing GPBMODS.MAP against GPBMODS.SRC.SYM -- see
## **  docs/memory/measure-pcode-per-module.md -- and they are only true of the
## **  build they were taken from. REMEASURE AFTER EDITING ANY OF IT.
## **
## **  THE THREE COLUMNS ARE THE THREE PLACES P-CODE CAN LIVE, which is the
## **  whole point of the panel. The left column is resident: it is loaded at
## **  $0801 and it is what has to fit under the runtime. The other two are
## **  GP.BANKED regions, written to GPBMODS.B04 and GPBMODS.B07 and loaded to
## **  $A000 in banks 4 and 7 -- neither costs low RAM. They are drawn in the
## **  title colour rather than the text colour so the split reads at a glance.
## **
## **  SIX ENTRIES IN THE LEFT COLUMN AGAINST FIFTEEN ON THE RIGHT, AND THAT
## **  IS THE POINT OF BANK 7. What is left down there is what could not go:
## **  STASH and STASHFILE hold BANK statements, which the compiler refuses
## **  inside a region, and the three LIB* files are the shim layer that
## **  reaches the other two columns.
## **
## **  The literal text is in no column at all. It is not p-code, so the map
## **  cannot see it; ABOUT / MEMORY carries the four overlay sizes instead.
## ***********************************************************************


## ---- THREE HEADINGS, then the names on their own. The numbers are a group of
## ---- their own beside them, in step, which is what lets the panel LAY THE
## ---- COLUMN OUT rather than have it typed in: the alignment used to be spaces
## ---- inside each literal, so a name one character longer bent the column and a
## ---- figure gaining a digit pushed past it.

GP.BANKEDSTR GM.TEXTBANK BS.B.SIZES
  "IN LOW RAM  --  AT $0801"
  "IN BANK 4  --  .B04"
  "IN BANK 7  --  .B07"
  "TOTAL"
  "STASH"
  "STASHFILE"
  "LIB.GUIBANK"
  "LIB.FUTILBANK"
  "LIB.UTILBANK"
  "GPBMODS"
  "THEME"
  "MENUVERT"
  "MENUBAR"
  "LINEINPUT"
  "GUI"
  "GUI2"
  "FILEDIR"
  "APPSYS"
  "BANKMGR"
  "STRCASE"
  "STRINGS"
  "STRUSING"
  "SORT"
  "STASHVRAM"
  "FILEIO"
GP.ENDBANKEDSTR

## ---- The same order, and the ONLY thing that changes between builds. Read off
## ---- GPBMODS.MAP against GPBMODS.SRC.SYM -- readme.md gives the method, and
## ---- the trap: charge a module from its own first label to the next module's
## ---- WITHIN one region, because an overlay file is padded up to a whole page
## ---- and the padding lands on whichever module came last.

GP.BANKEDSTR GM.TEXTBANK BS.B.NUMS
  "431"
  "171"
  "184"
  "34"
  "359"
  "11537"
  "479"
  "1104"
  "826"
  "780"
  "1857"
  "1360"
  "431"
  "114"
  "586"
  "54"
  "511"
  "726"
  "189"
  "1681"
  "1007"
  "24421"
GP.ENDBANKEDSTR
GMX.B.SIZES:
  GM.GRP% = 18
  GOSUB GMX.G.SAY

  ## ---- THE TWO GROUPS ARE FOUR APART, NOT LEVEL. BS.B.SIZES opens with the
  ## ---- three column headings and TOTAL, so the first module name is index 4
  ## ---- while its figure is index 0. Leaving both at 0 printed every name
  ## ---- against the figure four modules along, headings and all.
  GM.SNAME% = 4 : GM.SNUM% = 0

  GM.SX% = 4  : GM.SHEAD% = 0 : GM.SN% = 6 : GM.SATTR% = THEME.CLR(THEME.TEXT)  : GOSUB GMX.B.COL
  GM.SX% = 30 : GM.SHEAD% = 1 : GM.SN% = 7 : GM.SATTR% = THEME.CLR(THEME.TITLE) : GOSUB GMX.B.COL
  GM.SX% = 54 : GM.SHEAD% = 2 : GM.SN% = 8 : GM.SATTR% = THEME.CLR(THEME.TITLE) : GOSUB GMX.B.COL

  GM.SNAME% = 3 : GM.SX% = 4 : GM.SROW% = 23 : GM.SATTR% = THEME.CLR(THEME.WARN)
  GOSUB GMX.B.ROW
  GM.RESULT$ = GM.SLINE$

  GM.TELL$ = GP.BSTR(BS.G.DATA, 6)
  GOSUB GMX.TELL
  RETURN


## ---- ONE COLUMN. GM.SNAME% and GM.SNUM% each walk on by one a row, so the four
## ---- places between them hold across all three columns and the total falls out
## ---- at the end, with GM.SNUM% already standing on it.

GMX.B.COL:
  GP.PRINTAT GM.SX%, 13, GP.BSTR(BS.B.SIZES, GM.SHEAD%), THEME.CLR(THEME.WARN)
  GM.SROW% = 14
  FOR GM.I = 1 TO GM.SN%
    GOSUB GMX.B.ROW
    GM.SROW% = GM.SROW% + 1
  NEXT GM.I
  RETURN


## ---- ONE ROW, laid out by the library this program exists to exercise:
## ---- STR.PADR takes the name to a fixed column and STR.USING right justifies
## ---- the figure in five, which is what makes the digits line up whatever the
## ---- name beside them is. GM.SNAME% is left where it stops, so the caller can
## ---- point it at the TOTAL row and call this again.

GMX.B.ROW:
  STR.STR$ = GP.BSTR(BS.B.SIZES, GM.SNAME%)
  STR.WIDTH = 11
  GOSUB STR.PADR
  STR.USING.NUM = VAL(GP.BSTR(BS.B.NUMS, GM.SNUM%))
  STR.USING.MASK$ = "#####"
  GOSUB STR.USING
  GM.SLINE$ = STR.STR$ + STR.USING.STR$
  GP.PRINTAT GM.SX%, GM.SROW%, GM.SLINE$, GM.SATTR%
  GM.SNAME% = GM.SNAME% + 1 : GM.SNUM% = GM.SNUM% + 1
  RETURN


## ***********************************************************************
## **  GMX.FILES -- the FILES dropdown. FILEIO and FILEDIR, one item each.
## **
## **  THE DRIVE IS REAL, and four of these write to it. Everything they
## **  make is named GPBFILE.* or GPBDIR, and every one of them is removed by
## **  the row that made it -- the directory by FILE.RMDIR, after the drive
## **  has come back up out of it.
## **
## **  FILE.NAME$ IS ASSIGNED BY FIVE ROWS HERE and written in place by
## **  FILEDIR, which is only safe because none of them assigns a name longer
## **  than the 32 FILE.DIR.INIT sized it to. A string block never shrinks, so
## **  a shorter name reuses the block FILEDIR holds the pointer to; a longer
## **  one would reallocate and leave that pointer aimed at freed heap. The
## **  typed field is GUI.LEN 24 for that reason and not for the look of it.
## ***********************************************************************

GMX.FILES:
  GP.SELECT MENUVERT.SEL
  GP.CASE 1
    GOSUB GMX.F.DIR
  GP.CASE 2
    GOSUB GMX.F.PATTERN
  GP.CASE 3
    GOSUB GMX.F.DIRS
  GP.CASE 4
    GOSUB GMX.F.STATUS
  GP.CASE 5
    GOSUB GMX.F.EXISTS
  GP.CASE 6
    GOSUB GMX.F.ARRAY
  GP.CASE 7
    GOSUB GMX.F.RENAME
  GP.OTHER
    GOSUB GMX.F.MKDIR
  GP.ENDSEL
  GOSUB GMX.CHROME
  RETURN


## ---- A line in the work area, and the row after it ----

GMX.F.SAY:
  GP.PRINTAT 6, GM.FROW%, GM.FTXT$, THEME.CLR(THEME.TEXT)
  GM.FROW% = GM.FROW% + 1
  RETURN


## ---- What the drive said to the last thing asked of it. An error number
## ---- under FILE.OKMAX is success, and 0 is the only one that is silent.


GP.BANKEDSTR GM.TEXTBANKB BS.F.DRIVE
  "  --  ERR "
GP.ENDBANKEDSTR
GMX.F.DRIVE:
  GM.FTXT$ = GM.FSTEP$ + GP.BSTR(BS.F.DRIVE, 0) + MID$(STR$(FILE.ERR), 2) + "  " + FILE.MSG$
  GOSUB GMX.F.SAY
  RETURN


## ***********************************************************************
## **  GMX.F.READ -- one listing, walked into MENUVERT.ITEM$ for a listbox.
## **
## **   in   GM.FPAT$    the drive's pattern, or empty for everything
## **        GM.FONLY%    FILE.DIR.ALL, FILE.DIR.FILES or FILE.DIR.DIRS
## **   out  GM.FSEEN%    entries in the listing
## **        GM.FSHOWN%   how many of them reached the array
## **
## **  READ ONCE, WALK ONCE. The whole listing comes back in one go into the
## **  bank BANKMGR handed out -- 8,192 bytes at $A000, about 250 entries --
## **  and FILE.DIR.NEXT then walks that buffer without going near the drive.
## **
## **  FILE.NAME$ IS ONE STRING, written in place by every FILE.DIR.NEXT, so
## **  the name is copied into the array here rather than kept a pointer to.
## **
## **  The walk stops FILLING at 24 because MENUVERT.ITEM$ is DIMmed 32 and
## **  GUI.LISTBOX reads that array. GM.FSEEN% keeps counting past it, so the
## **  panel can still say how many entries were left out.
## ***********************************************************************

GMX.F.READ:
  FILE.DIR.BANK = GM.DIRBANK%
  FILE.DIR.PATTERN$ = GM.FPAT$
  FILE.DIR.ONLY = GM.FONLY%
  GOSUB FILE.DIR.OPEN
  GM.FSEEN% = 0
  GM.FSHOWN% = 0
  GP.DO
    GOSUB FILE.DIR.NEXT
    IF FILE.DIR.MORE = 0 THEN GP.EXITDO
    GM.FSEEN% = GM.FSEEN% + 1
    IF GM.FSHOWN% < 24 THEN GOSUB GMX.F.KEEP
  GP.LOOP
  RETURN


## ---- One entry into the array: the name in a column, then the block count
## ---- and the three characters of type.

GMX.F.KEEP:
  STR.STR$ = FILE.NAME$
  STR.WIDTH = 26
  GOSUB STR.PADR
  STR.STR$ = STR.STR$ + STR$(FILE.BLOCKS)
  STR.WIDTH = 32
  GOSUB STR.PADR
  GM.FSHOWN% = GM.FSHOWN% + 1
  MENUVERT.ITEM$(GM.FSHOWN%) = " " + STR.STR$ + "  " + FILE.TYPE$
  RETURN


## ***********************************************************************
## **  GMX.F.LIST -- what GMX.F.READ found, in a listbox.
## **
## **  The row picked is thrown away. This panel is about the READ; choosing
## **  from a list is GUI.LISTBOX's own row under DIALOG.
## ***********************************************************************


GP.BANKEDSTR GM.TEXTBANKB BS.F.LIST
  " ENTRIES, "
  " OF THEM SHOWN."
  "NAME, BLOCKS AND TYPE, ALL THREE FROM FILE.DIR.NEXT."
  "FILEDIR  "
  " ENTRIES IN "
  " BYTES"
  "  BUFFER FULL"
GP.ENDBANKEDSTR
GMX.F.LIST:
  IF GM.FSHOWN% = 0 THEN GOTO GMX.F.NONE
  GOSUB GMX.D.RESET
  GUI.TITLE$ = GM.FTITLE$
  GUI.MSG$ = MID$(STR$(GM.FSEEN%), 2) + GP.BSTR(BS.F.LIST, 0) + MID$(STR$(GM.FSHOWN%), 2) + GP.BSTR(BS.F.LIST, 1)
  GUI.MSG2$ = GP.BSTR(BS.F.LIST, 2)
  GUI.LISTBOX.COUNT = GM.FSHOWN%
  GUI.LISTBOX.ROWS = 12
  GUI.LISTBOX.MULTI = 0
  GUI.LISTBOX.SEL = 0
  GOSUB GUI.LISTBOX
  GM.RESULT$ = GP.BSTR(BS.F.LIST, 3) + MID$(STR$(GM.FSEEN%), 2) + GP.BSTR(BS.F.LIST, 4) + MID$(STR$(FILE.DIR.GOT), 2) + GP.BSTR(BS.F.LIST, 5)
  IF FILE.DIR.FULL = 1 THEN GM.RESULT$ = GM.RESULT$ + GP.BSTR(BS.F.LIST, 6)
  RETURN


GP.BANKEDSTR GM.TEXTBANKB BS.F.NONE
  "NOTHING TO LIST."
  "FILEDIR  NOTHING FOUND"
GP.ENDBANKEDSTR
GMX.F.NONE:
  GOSUB GMX.D.RESET
  GUI.TITLE$ = GM.FTITLE$
  GUI.MSG$ = GP.BSTR(BS.F.NONE, 0)
  GUI.MSG2$ = "ERR " + MID$(STR$(FILE.ERR), 2) + "  " + FILE.MSG$
  GOSUB GUI.SAY
  GM.RESULT$ = GP.BSTR(BS.F.NONE, 1)
  RETURN


## ***********************************************************************
## **  GMX.F.DIR -- FILEDIR, everything on the drive.
## ***********************************************************************


GP.BANKEDSTR GM.TEXTBANKB BS.F.DIR
  " DIRECTORY "
GP.ENDBANKEDSTR
GMX.F.DIR:
  GM.FPAT$ = ""
  GM.FONLY% = FILE.DIR.ALL
  GOSUB GMX.F.READ
  GM.FTITLE$ = GP.BSTR(BS.F.DIR, 0)
  GOSUB GMX.F.LIST
  RETURN


## ***********************************************************************
## **  GMX.F.PATTERN -- the same read, with the DRIVE doing the filtering.
## **
## **  The pattern rides on the name the listing is opened with, so * and ?
## **  are the drive's and a filtered listing is also a smaller buffer. There
## **  is no matcher in the module and there should not be one here.
## ***********************************************************************


GP.BANKEDSTR GM.TEXTBANKB BS.F.PATTERN
  " DIRECTORY PATTERN "
  "A PATTERN FOR THE DRIVE TO MATCH."
  "FILE.DIR.ONLY IS SET TO FILES, SO NO DIRECTORIES ARE RETURNED."
  "*.PRG"
  " PATTERN "
GP.ENDBANKEDSTR
GMX.F.PATTERN:
  GOSUB GMX.D.RESET
  GUI.TITLE$ = GP.BSTR(BS.F.PATTERN, 0)
  GUI.MSG$ = GP.BSTR(BS.F.PATTERN, 1)
  GUI.MSG2$ = GP.BSTR(BS.F.PATTERN, 2)
  GUI.LEN = 20
  GUI.TEXT$ = GP.BSTR(BS.F.PATTERN, 3)
  GOSUB GUI.INPUT
  IF GUI.OK = 0 THEN GOTO GMX.F.PATOFF
  GM.FPAT$ = GUI.TEXT$
  GM.FONLY% = FILE.DIR.FILES
  GOSUB GMX.F.READ
  GM.FTITLE$ = GP.BSTR(BS.F.PATTERN, 4) + GM.FPAT$ + " "
  GOSUB GMX.F.LIST
  RETURN


GP.BANKEDSTR GM.TEXTBANKB BS.F.PATOFF
  "DIRECTORY PATTERN CANCELLED"
GP.ENDBANKEDSTR
GMX.F.PATOFF:
  GM.RESULT$ = GP.BSTR(BS.F.PATOFF, 0)
  RETURN


## ***********************************************************************
## **  GMX.F.DIRS -- FILE.DIR.DIRS. The subdirectories and nothing else.
## **
## **  MKDIR + CHDIR + UP leaves GPBDIR behind, so once that row has been run
## **  this one has something to find.
## ***********************************************************************


GP.BANKEDSTR GM.TEXTBANKB BS.F.DIRS
  " DIRECTORIES "
GP.ENDBANKEDSTR
GMX.F.DIRS:
  GM.FPAT$ = ""
  GM.FONLY% = FILE.DIR.DIRS
  GOSUB GMX.F.READ
  GM.FTITLE$ = GP.BSTR(BS.F.DIRS, 0)
  GOSUB GMX.F.LIST
  RETURN


## ***********************************************************************
## **  GMX.F.STATUS -- FILE.STATUS. The command channel, read for its own sake.
## **
## **  The drive holds its error state until channel 15 is read, which is why
## **  every routine in FILEIO ends by reading it. This row is that read on its
## **  own, and the four fields it fills are what DS and DS$ would have said on
## **  a machine that had them.
## ***********************************************************************


GP.BANKEDSTR GM.TEXTBANKB BS.F.STATUS
  "FILE.STATUS OPENS CHANNEL 15 WITH NO COMMAND AND READS IT."
  "STATUS"
  "TRACK "
  "    SECTOR "
  "DEVICE "
  "    AN ERROR NUMBER UNDER 20 IS SUCCESS"
  "PRESS A KEY."
  "FILE.STATUS  ERR "
GP.ENDBANKEDSTR
GMX.F.STATUS:
  GOSUB GMX.CLEARPANEL
  GM.FROW% = 8
  GM.FTXT$ = GP.BSTR(BS.F.STATUS, 0)
  GOSUB GMX.F.SAY
  GM.FROW% = GM.FROW% + 1
  GOSUB FILE.STATUS
  GM.FSTEP$ = GP.BSTR(BS.F.STATUS, 1)
  GOSUB GMX.F.DRIVE
  GM.FTXT$ = GP.BSTR(BS.F.STATUS, 2) + MID$(STR$(FILE.TRK), 2) + GP.BSTR(BS.F.STATUS, 3) + MID$(STR$(FILE.SEC), 2)
  GOSUB GMX.F.SAY
  GM.FTXT$ = GP.BSTR(BS.F.STATUS, 4) + MID$(STR$(FILE.DEVICE), 2) + GP.BSTR(BS.F.STATUS, 5)
  GOSUB GMX.F.SAY
  GM.TELL$ = GP.BSTR(BS.F.STATUS, 6)
  GOSUB GMX.TELL
  GM.RESULT$ = GP.BSTR(BS.F.STATUS, 7) + MID$(STR$(FILE.ERR), 2) + "  " + FILE.MSG$
  RETURN


## ***********************************************************************
## **  GMX.F.EXISTS -- FILE.EXISTS, on a name you type.
## **
## **  It opens the file for reading and reads the command channel while that
## **  file is still open, so the answer is the drive's answer to THAT open.
## **  62 is FILE NOT FOUND, and it is the ordinary no.
## ***********************************************************************


GP.BANKEDSTR GM.TEXTBANKB BS.F.EXISTS
  " FILE.EXISTS "
  "A NAME TO LOOK FOR ON THE DRIVE."
  "GPBMODS.PRG"
  "  IS NOT ON THE DRIVE."
  "  IS ON THE DRIVE."
  "FILE.OK "
  "    ERR "
  "FILE.EXISTS  "
  "  OK "
GP.ENDBANKEDSTR
GMX.F.EXISTS:
  GOSUB GMX.D.RESET
  GUI.TITLE$ = GP.BSTR(BS.F.EXISTS, 0)
  GUI.MSG$ = GP.BSTR(BS.F.EXISTS, 1)
  GUI.LEN = 24
  GUI.TEXT$ = GP.BSTR(BS.F.EXISTS, 2)
  GOSUB GUI.INPUT
  IF GUI.OK = 0 THEN GOTO GMX.F.EXOFF
  GM.FNAME$ = GUI.TEXT$
  FILE.NAME$ = GM.FNAME$
  GOSUB FILE.EXISTS
  GOSUB GMX.D.RESET
  GUI.TITLE$ = GP.BSTR(BS.F.EXISTS, 0)
  GUI.MSG$ = GM.FNAME$ + GP.BSTR(BS.F.EXISTS, 3)
  IF FILE.OK <> 0 THEN GUI.MSG$ = GM.FNAME$ + GP.BSTR(BS.F.EXISTS, 4)
  GM.NUM% = FILE.OK : GOSUB GMX.SIGNED
  GUI.MSG2$ = GP.BSTR(BS.F.EXISTS, 5) + GM.NUM$ + GP.BSTR(BS.F.EXISTS, 6) + MID$(STR$(FILE.ERR), 2) + "  " + FILE.MSG$
  GOSUB GUI.SAY
  GM.RESULT$ = GP.BSTR(BS.F.EXISTS, 7) + GM.FNAME$ + GP.BSTR(BS.F.EXISTS, 8) + GM.NUM$
  RETURN


GP.BANKEDSTR GM.TEXTBANKB BS.F.EXOFF
  "FILE.EXISTS CANCELLED"
GP.ENDBANKEDSTR
GMX.F.EXOFF:
  GM.RESULT$ = GP.BSTR(BS.F.EXOFF, 0)
  RETURN


## ***********************************************************************
## **  GMX.F.ARRAY -- FILE.SAVEARRAY and FILE.LOADARRAY, out and back.
## **
## **  FILE.ROWS IS AN INPUT TO THE SAVE AND AN OUTPUT FROM THE LOAD, which is
## **  the one thing about this pair worth carrying away. FILE.MAX is how many
## **  rows the array can hold, and FILE.ROWS coming back equal to it means the
## **  file may have held more.
## **
## **  A BLANK LAST ROW WOULD NOT SURVIVE THE TRIP. The CR that ends the last
## **  row is also the last byte of the file, so end of file and an empty line
## **  are the same thing to the reader. Five rows with text in them come back
## **  as five.
## ***********************************************************************


## ---- NO COUNT IS SPELLED INTO A LITERAL HERE. "SAVEARRAY 5 ROWS" was, and it
## ---- said five whatever happened, which is exactly the line you would read to
## ---- find out which half of a round trip went wrong.

GP.BANKEDSTR GM.TEXTBANKB BS.F.ARRAY
  "THREE"
  "GPBFILE.DAT"
  "SAVEARRAY  "
  " ROWS TO "
  "LOADARRAY  "
  " ROWS BACK"
  "PRESS A KEY TO SCRATCH GPBFILE.DAT."
  "DELETE"
  "PRESS A KEY."
  "ARRAY  "
  " ROWS OUT, "
  " BACK"
  "  ST "
GP.ENDBANKEDSTR
GMX.F.ARRAY:
  GOSUB GMX.CLEARPANEL
  GM.FROW% = 8
  FILE.LINE$(1) = "ONE"
  FILE.LINE$(2) = "TWO"
  FILE.LINE$(3) = GP.BSTR(BS.F.ARRAY, 0)
  FILE.LINE$(4) = "FOUR"
  FILE.LINE$(5) = "FIVE"
  FILE.ROWS = 5
  FILE.NAME$ = GP.BSTR(BS.F.ARRAY, 1)
  GOSUB FILE.SAVEARRAY
  GM.FSENT% = FILE.ROWS
  GM.FSTEP$ = GP.BSTR(BS.F.ARRAY, 2) + MID$(STR$(GM.FSENT%), 2) + GP.BSTR(BS.F.ARRAY, 3) + FILE.NAME$
  GOSUB GMX.F.DRIVE

## ---- emptied, so what comes back can only have come off the drive ----
  FOR GM.I = 1 TO 16
    FILE.LINE$(GM.I) = ""
  NEXT GM.I

  FILE.MAX = 16
  GOSUB FILE.LOADARRAY
## ---- DIAGNOSTIC, AND IT COMES OUT AGAIN. FILE.ST is the ST the read loop
## ---- stopped on. Five rows on the drive coming back as one says the loop
## ---- was told end of file after the first, and this is the number that
## ---- said so. 64 is a real end of file and would mean the fault is not
## ---- the test at all.
  GM.FSTEP$ = GP.BSTR(BS.F.ARRAY, 4) + MID$(STR$(FILE.ROWS), 2) + GP.BSTR(BS.F.ARRAY, 5)
  GM.FSTEP$ = GM.FSTEP$ + GP.BSTR(BS.F.ARRAY, 12) + MID$(STR$(FILE.ST), 2)
  GOSUB GMX.F.DRIVE
  GM.FROW% = GM.FROW% + 1
  FOR GM.I = 1 TO FILE.ROWS
    GM.FTXT$ = "  " + MID$(STR$(GM.I), 2) + "   [" + FILE.LINE$(GM.I) + "]"
    GOSUB GMX.F.SAY
  NEXT GM.I

  GM.TELL$ = GP.BSTR(BS.F.ARRAY, 6)
  GOSUB GMX.TELL
  GOSUB FILE.DELETE
  GM.FSTEP$ = GP.BSTR(BS.F.ARRAY, 7)
  GOSUB GMX.F.DRIVE
  GM.TELL$ = GP.BSTR(BS.F.ARRAY, 8)
  GOSUB GMX.TELL
  GM.RESULT$ = GP.BSTR(BS.F.ARRAY, 9) + MID$(STR$(GM.FSENT%), 2) + GP.BSTR(BS.F.ARRAY, 10) + MID$(STR$(FILE.ROWS), 2) + GP.BSTR(BS.F.ARRAY, 11)
  RETURN


## ***********************************************************************
## **  GMX.F.RENAME -- FILE.RENAME and FILE.DELETE, round trip on one file.
## **
## **  RENAME ONTO A NAME THAT ALREADY EXISTS RETURNS 62, the same code that a
## **  missing SOURCE gives. So the target is scratched first, and what this
## **  panel trusts afterwards is FILE.EXISTS rather than the error number.
## **
## **  FILE.NEW$ IS THE NEW NAME and FILE.NAME$ the old one; the command sent
## **  is R:new=old. A rename does not touch FILE.NAME$, so the DELETE at the
## **  end has to be told the new name.
## ***********************************************************************


GP.BANKEDSTR GM.TEXTBANKB BS.F.RENAME
  "A FILE TO RENAME"
  "GPBFILE.BAK"
  "GPBFILE.DAT"
  "WROTE GPBFILE.DAT"
  "EXISTS  GPBFILE.DAT  "
  "    WANT 1"
  "RENAME TO GPBFILE.BAK"
  "    WANT 0"
  "EXISTS  GPBFILE.BAK  "
  "PRESS A KEY TO SCRATCH GPBFILE.BAK."
  "DELETE"
  "ERR 1 IS FILES SCRATCHED, AND FILE.TRK CARRIES THE COUNT: "
  "PRESS A KEY."
  "RENAME + DELETE  ERR "
GP.ENDBANKEDSTR
GMX.F.RENAME:
  GOSUB GMX.CLEARPANEL
  GM.FROW% = 8
  FILE.LINE$(1) = GP.BSTR(BS.F.RENAME, 0)
  FILE.ROWS = 1

  FILE.NAME$ = GP.BSTR(BS.F.RENAME, 1)
  GOSUB FILE.DELETE
  FILE.NAME$ = GP.BSTR(BS.F.RENAME, 2)
  GOSUB FILE.SAVEARRAY
  GM.FSTEP$ = GP.BSTR(BS.F.RENAME, 3)
  GOSUB GMX.F.DRIVE

  GOSUB FILE.EXISTS
  GM.NUM% = FILE.OK : GOSUB GMX.SIGNED
  GM.FTXT$ = GP.BSTR(BS.F.RENAME, 4) + GM.NUM$ + GP.BSTR(BS.F.RENAME, 5)
  GOSUB GMX.F.SAY

  FILE.NEW$ = GP.BSTR(BS.F.RENAME, 1)
  GOSUB FILE.RENAME
  GM.FSTEP$ = GP.BSTR(BS.F.RENAME, 6)
  GOSUB GMX.F.DRIVE

  GOSUB FILE.EXISTS
  GM.NUM% = FILE.OK : GOSUB GMX.SIGNED
  GM.FTXT$ = GP.BSTR(BS.F.RENAME, 4) + GM.NUM$ + GP.BSTR(BS.F.RENAME, 7)
  GOSUB GMX.F.SAY
  FILE.NAME$ = GP.BSTR(BS.F.RENAME, 1)
  GOSUB FILE.EXISTS
  GM.NUM% = FILE.OK : GOSUB GMX.SIGNED
  GM.FTXT$ = GP.BSTR(BS.F.RENAME, 8) + GM.NUM$ + GP.BSTR(BS.F.RENAME, 5)
  GOSUB GMX.F.SAY

  GM.TELL$ = GP.BSTR(BS.F.RENAME, 9)
  GOSUB GMX.TELL
  GOSUB FILE.DELETE
  GM.FSTEP$ = GP.BSTR(BS.F.RENAME, 10)
  GOSUB GMX.F.DRIVE
  GM.FTXT$ = GP.BSTR(BS.F.RENAME, 11) + MID$(STR$(FILE.TRK), 2)
  GOSUB GMX.F.SAY
  GM.TELL$ = GP.BSTR(BS.F.RENAME, 12)
  GOSUB GMX.TELL
  GM.RESULT$ = GP.BSTR(BS.F.RENAME, 13) + MID$(STR$(FILE.ERR), 2) + "  " + FILE.MSG$
  RETURN


## ***********************************************************************
## **  GMX.F.MKDIR -- FILE.MKDIR, FILE.CHDIR, FILE.CURDIR, FILE.UP, FILE.RMDIR.
## **
## **  THE ROW PUTS THE DRIVE BACK AS IT FOUND IT, so it can be run twice.
## **  RMDIR comes after UP, because RD will not remove the directory the
## **  drive is standing in.
## **
## **  FILE.UP sends CD: and the left arrow, CHR$(95), spelled by code so the
## **  source does not depend on how that character is encoded.
## ***********************************************************************


GP.BANKEDSTR GM.TEXTBANKB BS.F.MKDIR
  "STARTING IN  "
  "GPBDIR"
  "MKDIR GPBDIR"
  "CHDIR GPBDIR"
  "NOW IN  "
  "BACK IN  "
  "RMDIR GPBDIR"
  "GPBDIR MADE, ENTERED, LEFT AND REMOVED. PRESS A KEY."
  "MKDIR + CHDIR + UP + RMDIR  BACK IN "
GP.ENDBANKEDSTR
GMX.F.MKDIR:
  GOSUB GMX.CLEARPANEL
  GM.FROW% = 8
  GOSUB FILE.CURDIR
  GM.FTXT$ = GP.BSTR(BS.F.MKDIR, 0) + FILE.PATH$
  GOSUB GMX.F.SAY

  FILE.NAME$ = GP.BSTR(BS.F.MKDIR, 1)
  GOSUB FILE.MKDIR
  GM.FSTEP$ = GP.BSTR(BS.F.MKDIR, 2)
  GOSUB GMX.F.DRIVE

  GOSUB FILE.CHDIR
  GM.FSTEP$ = GP.BSTR(BS.F.MKDIR, 3)
  GOSUB GMX.F.DRIVE

  GOSUB FILE.CURDIR
  GM.FTXT$ = GP.BSTR(BS.F.MKDIR, 4) + FILE.PATH$
  GOSUB GMX.F.SAY

  GOSUB FILE.UP
  GM.FSTEP$ = "UP"
  GOSUB GMX.F.DRIVE

  GOSUB FILE.CURDIR
  GM.FTXT$ = GP.BSTR(BS.F.MKDIR, 5) + FILE.PATH$
  GOSUB GMX.F.SAY

  FILE.NAME$ = GP.BSTR(BS.F.MKDIR, 1)
  GOSUB FILE.RMDIR
  GM.FSTEP$ = GP.BSTR(BS.F.MKDIR, 6)
  GOSUB GMX.F.DRIVE

  GM.TELL$ = GP.BSTR(BS.F.MKDIR, 7)
  GOSUB GMX.TELL
  GM.RESULT$ = GP.BSTR(BS.F.MKDIR, 8) + FILE.PATH$
  RETURN


## ***********************************************************************
## **  GM.BANKSTOP -- the one thing that can go wrong before anything is
## **  drawn, and the only place this program refuses to run.
## **
## **  Neither failure can happen on a real X16: nothing else has claimed a
## **  bank when this runs, and 63 is the SMALLEST machine. It is here because
## **  running on regardless would write the GUI's own code with screen cells
## **  and report it as a drawing bug.
## ***********************************************************************


GP.BANKEDSTR GM.TEXTBANK BS.BANKSTOP
  "BANKS: "
GP.ENDBANKEDSTR
GM.BANKSTOP:
  GOSUB APPSYS.RESTORE
  PRINT GP.BSTR(BS.BANKSTOP, 0) ; GM.BANKFAIL$
  END
