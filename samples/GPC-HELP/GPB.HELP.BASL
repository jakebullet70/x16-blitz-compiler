#SAVEAS "@:GPB.HELP.SRC.PRG"
#SYMFILE "@:GPB.HELP.SRC.SYM"
#INCLUDE "GPC-BASIC/GPB.INC.BL"
#INCLUDE "GPC-BASIC/THEME.INC.BL"
#INCLUDE "GPC-BASIC/STASH.INC.BL"
#INCLUDE "GPC-BASIC/STRCASE.INC.BL"
#INCLUDE "GPC-BASIC/APPSYS.INC.BL"
#INCLUDE "GPC-BASIC/BANKMGR.INC.BL"
#INCLUDE "GPC-BASIC/MENU.INC.BANKED.BL"
#INCLUDE "GPC-BASIC/MENU.INC.BL"
#INCLUDE "GPC-BASIC/LINEINPUT.INC.BL"
#INCLUDE "GPC-BASIC/GUI.INC.BL"
#INCLUDE "GPC-BASIC/COMBO.INC.BL"
#INCLUDE "GPC-BASIC/CHECK.INC.BL"
#INCLUDE "GPC-BASIC/GUI-DIALOGS.INC.BL"

## ============================================================================
## GPB.HELP.BASL -- the GP.BASIC and BASL reference, on the machine.
##
## The index loads once at startup. A topic is read once into HELP.TBANK and
## every scroll after that paints one row out of the bank.
##
## The content is HELP-TXT/ beside the program: GPB.HELP.IDX and one .HLP per
## topic, built by MKHELP.PY from GPC-BASIC/. Nothing here parses markdown,
## measures a string or wraps a line.
##
## .HLP line format, a marker character then the text:
##      @  the topic record: line 1, and its title
##      =  section header, drawn as a full width bar
##      .  text, already wrapped        :  code, dimmed, what "export" writes
##      >  cross reference, ">index row|text"
##
## CP437 (charset 7) with bit 6 of $0372 set, 80x30. Labels and variables are
## both HELP.*: BASL files them in one symbol table.
##
## WARNING: do not add #AUTONUM. The default step of 1 is the only one
## STRCASE.INC.BL survives. At any other step its label jumps resolve to lines
## that were never generated and GPC stops with UNKNOWN LINE NUMBER.
## ============================================================================

## 174 index rows today, against a bank holding 250 records and 6,192
## characters of text. Rows past the end are dropped.
#DEFINE HELP.MAXIX 250

## Cross references in one topic, and the deepest chain of them ESC can walk
## back along. The largest topic carries 12.
#DEFINE HELP.MAXPICK 20
#DEFINE HELP.MAXBACK 12

## A spare RAM bank for the cells a dialog covers. Bank 0 holds the KERNAL's
## keyboard layout, so anything above it will do.
#DEFINE HELP.BANK 8

#DEFINE HELP.TBANK 9

## The index bank. Records at the front, eight bytes each: text offset lo and
## hi, length, type, topic, section line, topic length lo and hi. The text sits
## above them, row N at HELP.IWIN + (N - 1) * 8.
#DEFINE HELP.IBANK 10
#DEFINE HELP.IWIN $A000
#DEFINE HELP.IXREC 8
#DEFINE HELP.IXWIDE 72
#DEFINE HELP.WIN $A000
#DEFINE HELP.BANKSIZE 8192
#DEFINE HELP.MAXLINES 140

## The line table is in the bank. Four bytes a line at the front: offset low,
## offset high, length, kind. The text sits above them, line N at (N-1)*4.
## WARNING: do not move this to arrays. Three DIMs of HELP.MAXLINES cost 840
## bytes of workspace and raise OUT OF MEMORY.
#DEFINE HELP.RECSIZE 4

## VERA and the KERNAL, for HELP.PAGE.SHIFT. A #DEFINE takes a signed int16, so
## an address is written in hex, and it refuses a digit anywhere in the name, so
## the second data port is .B.
#DEFINE HELPK.MEMCOPY $FEE7
#DEFINE HELPK.VCTRL $9F25
#DEFINE HELPK.VLO $9F20
#DEFINE HELPK.VMID $9F21
#DEFINE HELPK.VHI $9F22
#DEFINE HELPK.LCONFIG $9F34
#DEFINE HELPK.LMAPBASE $9F35

## $9F23 and $9F24, VERA's two data ports, split into the bytes the 16-bit ABI
## registers want.
#DEFINE HELPK.PORTLO 35
#DEFINE HELPK.PORTLO.B 36
#DEFINE HELPK.PORTHI 159

## ADDRH: bank in bit 0, DECR in bit 3, auto-increment in the top nibble. 16 is
## "step forward by one", 24 the same walking backwards.
#DEFINE HELPK.UP 16
#DEFINE HELPK.DOWN 24

#DEFINE HELP.CHAN 2

## Mode $00 is 80x60 and $01 is 80x30. APPSYS.STARTUP remembers whichever the
## user had and APPSYS.RESTORE puts it back.
#DEFINE HELP.MODE 1

## CP437, the IBM PC set, charset 7. ROM R47 and later. $20-$7E is ASCII
## exactly and the high half carries the line drawing glyphs.
#DEFINE HELP.CHARSET 7

## The KERNAL's charset register. Bit 6 says the text is ASCII, and GP.PRINTAT
## reads it per character. Poke it rather than PRINT CHR$(15): that control code
## sets the same bit but also uploads the ISO font, losing the line drawing.
#DEFINE HELP.CHRREG 882
#DEFINE HELP.ASCIIBIT 64

## The single line box, as CP437 code points. GP.BOX writes its glyphs to VERA
## as tile indices without converting, and in CP437 the two are one number.
#DEFINE HELP.GL.H 196
#DEFINE HELP.GL.V 179
#DEFINE HELP.GL.TL 218
#DEFINE HELP.GL.TR 191
#DEFINE HELP.GL.BL 192
#DEFINE HELP.GL.BR 217

#DEFINE HELP.K.UP 145
#DEFINE HELP.K.DOWN 17
#DEFINE HELP.K.PGUP 130
#DEFINE HELP.K.PGDN 2
#DEFINE HELP.K.HOME 19
#DEFINE HELP.K.END 4

GOSUB HELP.BOOT
GP.IF HELP.OK = 0 THEN
    GOSUB APPSYS.RESTORE
    PRINT
    PRINT "GPB.HELP: HELP-TXT/GPB.HELP.IDX WOULD NOT LOAD."
    PRINT "RUN MKHELP.PY AND PUT THE HELP-TXT FOLDER"
    PRINT "BESIDE GPB.HELP.PRG."
    END
GP.ENDIF

GOSUB HELP.INDEX
GOSUB APPSYS.RESTORE
PRINT
PRINT "GPB.HELP."
END


## ============================================================================
## HELP.BOOT -- the screen as we want it, the arrays, and the index
## ============================================================================
HELP.BOOT:
    ## Before any SCREEN of our own: it records the state as it finds it.
    GOSUB APPSYS.STARTUP
    SCREEN HELP.MODE

    ## Before the first MENU.BEGIN, which claims MENU.TEXTBANK (62) for the
    ## link menu's rows.
    GOSUB BANKMGR.INIT

    ## Asked after the mode change. APPSYS.STARTUP reported the old screen.
    GOSUB GUI.SCREEN
    HELP.COLS = GUI.SCREEN.COLS : HELP.ROWS = GUI.SCREEN.ROWS

    ## Row 0 is the title and the last row the hint.
    HELP.VIEW = HELP.ROWS - 2
    IF HELP.VIEW < 4 THEN HELP.VIEW = 4

    THEME.ID% = 1 : GOSUB HELP.THEME.SET

    ## CP437, then declare that the text is ASCII. The order matters:
    ## screen_set_charset does not clear bit 6, so the charset goes first and the
    ## bit after. APPSYS.RESTORE hands the whole $0372 byte back.
    GP.CALL APPSYS.SETCHR, HELP.CHARSET, 0, 0, 0
    POKE HELP.CHRREG, PEEK(HELP.CHRREG) OR HELP.ASCIIBIT

    ## GP.BOX's four built-in styles are PETSCII screen codes and would draw
    ## letters here, so the frame glyphs are named outright.
    GP.SUB DLGRESET, HELP.BANK
    GUI.EDGE.H = HELP.GL.H     : GUI.EDGE.V = HELP.GL.V
    GUI.CORNER.TL = HELP.GL.TL : GUI.CORNER.TR = HELP.GL.TR
    GUI.CORNER.BL = HELP.GL.BL : GUI.CORNER.BR = HELP.GL.BR
    GP.SUB DLGGLYPH, 1

    GP.SUB DLGSHADOW, 1

    ## 72 spaces, HELP.IXWIDE. GPC takes SPC( only inside PRINT and inside a
    ## GP.BANKEDSTR body, so the width cannot be written as SPC(HELP.IXWIDE).
    ## Never reallocated: HELP.IXTEXT pokes the length byte and the characters
    ## through GP.STRPTR, and a string block never grows.
    HELP.ROW$ = "                                                                        "
    HELP.IXFREE = HELP.MAXIX * HELP.IXREC
    DIM HELP.PICK%(HELP.MAXPICK)    : DIM HELP.BACK.GO%(HELP.MAXBACK)
    DIM HELP.BACK.AT%(HELP.MAXBACK) : DIM HELP.FLD$(6)

    ## The only place the content folder's name is written. Set before
    ## HELP.IDXLOAD, the first thing to use it.
    HELP.DIR$ = "//HELP-TXT/:" : HELP.FIND$ = ""

    PRINT "GPB-HELP. READING INDEX..."
    GOSUB HELP.IDXLOAD
    RETURN


## ============================================================================
## HELP.IDX -- the master index, read once
## ============================================================================

HELP.IDXLOAD:
    HELP.OK = 0 : HELP.IX.N = 0
    OPEN HELP.CHAN, 8, HELP.CHAN, HELP.DIR$ + "GPB.HELP.IDX,S,R"
HELP.IDXLOAD.LOOP:
    LINPUT# HELP.CHAN, HELP.LINE$, 10 : HELP.ST = ST
    ## Bit 1 of ST is a read error. An OPEN that found no file still opens, and
    ## every LINPUT# then hands back CHR$(0) with ST = 66, for ever. Clean EOF is
    ## 64, so bit 1 alone tells "no such file" from "that was the last line".
    IF (HELP.ST AND 2) <> 0 THEN GOTO HELP.IDXLOAD.DONE
    GOSUB HELP.STRIP : GOSUB HELP.IDXROW
    ## Only bit 6 ends a read, not "ST is not zero". After a write channel has
    ## been opened and closed on this device a good read comes back with ST = 128
    ## and the line intact. Bit 1 is the error, bit 6 the end, bit 7 neither.
    IF (HELP.ST AND 64) = 0 THEN GOTO HELP.IDXLOAD.LOOP
HELP.IDXLOAD.DONE:
    CLOSE HELP.CHAN : IF HELP.IX.N > 0 THEN HELP.OK = 1
    RETURN

## Read to the LF, and drop a CR if one came with it.
HELP.STRIP:
    IF LEN(HELP.LINE$) = 0 THEN RETURN
    IF RIGHT$(HELP.LINE$, 1) = CHR$(13) THEN HELP.LINE$ = LEFT$(HELP.LINE$, LEN(HELP.LINE$) - 1)
    RETURN

## HELP.LINE$ -> HELP.FLD$(1..5). The fifth field takes everything left,
## because a title is free to contain the separator and a row is not.
HELP.SPLIT:
    HELP.REST$ = HELP.LINE$
    FOR HELP.FI = 1 TO 4
        HELP.CUT = GP.INSTR(HELP.REST$, "|")
        GP.IF HELP.CUT = 0 THEN
            HELP.FLD$(HELP.FI) = HELP.REST$
            HELP.REST$ = ""
        GP.ELSE
            HELP.FLD$(HELP.FI) = LEFT$(HELP.REST$, HELP.CUT - 1)
            HELP.REST$ = MID$(HELP.REST$, HELP.CUT + 1)
        GP.ENDIF
    NEXT HELP.FI
    HELP.FLD$(5) = HELP.REST$
    RETURN

HELP.IDXROW:
    IF LEN(HELP.LINE$) < 3 THEN RETURN
    HELP.TAG$ = LEFT$(HELP.LINE$, 1)
    IF HELP.TAG$ = "#" THEN RETURN
    IF HELP.TAG$ = "N" THEN RETURN
    IF HELP.IX.N >= HELP.MAXIX THEN RETURN
    GOSUB HELP.SPLIT
    HELP.IX.N = HELP.IX.N + 1 : HELP.KIND = 0
    IF HELP.TAG$ = "T" THEN HELP.KIND = 1
    IF HELP.TAG$ = "S" THEN HELP.KIND = 2
    HELP.T$ = HELP.FLD$(5) : HELP.TL = LEN(HELP.T$)
    IF HELP.TL > HELP.IXWIDE THEN HELP.TL = HELP.IXWIDE
    ## A row that will not fit is dropped whole rather than half written.
    IF HELP.IXFREE + HELP.TL > 8192 THEN HELP.IX.N = HELP.IX.N - 1 : RETURN
    HELP.REC = HELP.IWIN + (HELP.IX.N - 1) * HELP.IXREC
    HELP.LN2 = VAL(HELP.FLD$(4)) : HELP.HI = INT(HELP.LN2 / 256)
    BANK HELP.IBANK
    POKE HELP.REC, HELP.IXFREE - INT(HELP.IXFREE / 256) * 256
    POKE HELP.REC + 1, INT(HELP.IXFREE / 256)
    POKE HELP.REC + 2, HELP.TL
    POKE HELP.REC + 3, HELP.KIND
    POKE HELP.REC + 4, VAL(HELP.FLD$(2))
    POKE HELP.REC + 5, VAL(HELP.FLD$(3))
    POKE HELP.REC + 6, HELP.LN2 - HELP.HI * 256
    POKE HELP.REC + 7, HELP.HI
    HELP.SP = GP.STRPTR(HELP.T$) + 1
    GP.IF HELP.TL > 0 THEN
        FOR HELP.I = 0 TO HELP.TL - 1
            POKE HELP.IWIN + HELP.IXFREE + HELP.I, PEEK(HELP.SP + HELP.I)
        NEXT HELP.I
    GP.ENDIF
    HELP.IXFREE = HELP.IXFREE + HELP.TL
    RETURN

## One row out of the bank. HELP.IXR in, the six fields out. The rows live only
## in the bank, so every caller that wants a field calls this first.
HELP.IXREAD:
    BANK HELP.IBANK
    HELP.REC = HELP.IWIN + (HELP.IXR - 1) * HELP.IXREC
    HELP.IXOFF = PEEK(HELP.REC) + PEEK(HELP.REC + 1) * 256
    HELP.IXLEN = PEEK(HELP.REC + 2) : HELP.IXTYPE = PEEK(HELP.REC + 3)
    HELP.IXTOPIC = PEEK(HELP.REC + 4) : HELP.IXSEC = PEEK(HELP.REC + 5)
    HELP.IXLINES = PEEK(HELP.REC + 6) + PEEK(HELP.REC + 7) * 256
    RETURN

## The row's text, in HELP.ROW$. Call HELP.IXREAD first: this uses its offset
## and length. The length byte is poked rather than the string assigned, so
## nothing is allocated.
HELP.IXTEXT:
    HELP.RP = GP.STRPTR(HELP.ROW$)
    POKE HELP.RP, HELP.IXLEN
    BANK HELP.IBANK
    GP.IF HELP.IXLEN > 0 THEN
        FOR HELP.I = 0 TO HELP.IXLEN - 1
            POKE HELP.RP + 1 + HELP.I, PEEK(HELP.IWIN + HELP.IXOFF + HELP.I)
        NEXT HELP.I
    GP.ENDIF
    RETURN

## Topic 7 is HELP-TXT/H007.HLP: the index carries the number, so no row holds a
## file name. "//DIR/:NAME" is the CMD subdirectory syntax (X16 Reference 13). A
## plain "HELP-TXT/H007.HLP" works on the host filesystem and not on an SD card.
HELP.FILENAME:
    HELP.NUMV = HELP.TOPICNUM : GOSUB HELP.NUMSTR
    HELP.NAME$ = HELP.DIR$ + "H" + RIGHT$("000" + HELP.NUM$, 3) + ".HLP"
    RETURN


## ============================================================================
## The master index page
## ============================================================================

HELP.INDEX:
    HELP.IX.SEL = 1
HELP.INDEX.FIRST:
    ## Row 1 is a category header, and a header is not a destination.
    HELP.IXR = HELP.IX.SEL : GOSUB HELP.IXREAD
    IF HELP.IXTYPE = 0 THEN HELP.IX.SEL = HELP.IX.SEL + 1 : GOTO HELP.INDEX.FIRST
    HELP.IX.TOP = 1
    HELP.FULL = 1

HELP.INDEX.LOOP:
    GP.IF HELP.FULL <> 0 THEN
        GOSUB HELP.INDEX.DRAW
        HELP.FULL = 0
    GP.ENDIF
    GOSUB HELP.INDEX.STATUS

    HELP.SEL.WAS = HELP.IX.SEL : HELP.TOP.WAS = HELP.IX.TOP
    HELP.DONE = 0
    GOSUB HELP.GETKEY

    GP.SELECT HELP.KEY
        GP.CASE HELP.K.UP
            HELP.DIR = -1 : GOSUB HELP.IX.STEP
        GP.CASE HELP.K.DOWN
            HELP.DIR = 1 : GOSUB HELP.IX.STEP
        GP.CASE HELP.K.PGUP
            HELP.DIR = -1 : GOSUB HELP.IX.PAGE
        GP.CASE HELP.K.PGDN
            HELP.DIR = 1 : GOSUB HELP.IX.PAGE
        GP.CASE HELP.K.HOME
            HELP.IX.SEL = 1 : HELP.DIR = 1 : GOSUB HELP.IX.SNAP
        GP.CASE HELP.K.END
            HELP.IX.SEL = HELP.IX.N : HELP.DIR = -1 : GOSUB HELP.IX.SNAP
        GP.CASE 47, 70, 102
            GOSUB HELP.FIND.ASK
        GP.CASE 78, 110
            GOSUB HELP.FIND.NEXT
        GP.CASE 84, 116
            GOSUB HELP.THEME.NEXT : HELP.FULL = 1
        GP.CASE 63, 72, 104
            GOSUB HELP.ABOUT
        GP.CASE GUI.RETURN
            GOSUB HELP.OPEN.SEL
        GP.CASE GUI.ESCAPE, GUI.STOP
            GOSUB HELP.ASKQUIT
    GP.ENDSEL

    IF HELP.DONE <> 0 THEN RETURN
    GOSUB HELP.IX.SHOW
    ## A full redraw is already owed, so leave the row repaints below alone.
    IF HELP.FULL <> 0 THEN GOTO HELP.INDEX.LOOP
    ## A one row move slides. A move inside the page repaints two rows. A page
    ## jump or HOME repaints whole.
    GP.IF HELP.IX.TOP <> HELP.TOP.WAS THEN
        HELP.IXD = HELP.IX.TOP - HELP.TOP.WAS
        HELP.SHIFT = 0
        IF HELP.IXD = 1 THEN HELP.SHIFT = 1
        IF HELP.IXD = 0 - 1 THEN HELP.SHIFT = 0 - 1
        GP.IF HELP.SHIFT <> 0 THEN
            GOSUB HELP.INDEX.SLIDE
        GP.ELSE
            GOSUB HELP.INDEX.ROWS
        GP.ENDIF
        ## The row the highlight came from slid with it and is still wearing
        ## it, so it is redrawn where it landed.
        HELP.ROWI = HELP.SEL.WAS : GOSUB HELP.INDEX.ROW
    GP.ELSE
        HELP.ROWI = HELP.SEL.WAS : GOSUB HELP.INDEX.ROW
        HELP.ROWI = HELP.IX.SEL : GOSUB HELP.INDEX.ROW
    GP.ENDIF
    GOTO HELP.INDEX.LOOP

## The screen, the bars and the entries. For entering the index, or coming back
## to it from a topic or a dialog.
HELP.INDEX.DRAW:
    GOSUB HELP.PAGE.FRAME
    HELP.TITLE$ = "GPB.HELP    GP.BASIC and BASL, built from the library"
    GOSUB HELP.TITLEBAR
    GOSUB HELP.INDEX.ROWS
    RETURN

## The entries only: the bars do not change when the list moves. A one row move
## slides in VERA and names the entry that lands on the exposed row.
HELP.INDEX.SLIDE:
    GOSUB HELP.PAGE.SHIFT
    HELP.ROWI = HELP.IX.TOP + HELP.ONLY
    GOSUB HELP.INDEX.ROW
    RETURN

HELP.INDEX.ROWS:
    GP.FILL 0, 1, HELP.COLS, HELP.VIEW, 32, THEME.CLR(THEME.PAGE)
    FOR HELP.R = 0 TO HELP.VIEW - 1
        HELP.ROWI = HELP.IX.TOP + HELP.R
        GOSUB HELP.INDEX.ROW
    NEXT HELP.R
    RETURN

HELP.INDEX.ROW:
    IF HELP.ROWI < HELP.IX.TOP THEN RETURN
    IF HELP.ROWI > HELP.IX.TOP + HELP.VIEW - 1 THEN RETURN
    IF HELP.ROWI > HELP.IX.N THEN RETURN
    HELP.Y = 1 + HELP.ROWI - HELP.IX.TOP
    HELP.IXR = HELP.ROWI : GOSUB HELP.IXREAD
    HELP.ATTR = THEME.CLR(THEME.TEXT)
    IF HELP.IXTYPE = 0 THEN HELP.ATTR = THEME.CLR(THEME.TITLE)
    IF HELP.IXTYPE = 2 THEN HELP.ATTR = THEME.CLR(THEME.DIMMED)
    IF HELP.ROWI = HELP.IX.SEL THEN HELP.ATTR = THEME.CLR(THEME.HILITE)
    GP.FILL 0, HELP.Y, HELP.COLS, 1, 32, HELP.ATTR
    GOSUB HELP.IXTEXT
    GP.PRINTAT 1, HELP.Y, HELP.ROW$, HELP.ATTR
    RETURN

HELP.INDEX.STATUS:
    HELP.HINT$ = "ENTER open   / find   N next   T theme   ? about   ESC quit"
    HELP.NUMV = HELP.IX.SEL : GOSUB HELP.NUMSTR
    HELP.NOTE$ = HELP.NUM$
    HELP.NUMV = HELP.IX.N : GOSUB HELP.NUMSTR
    HELP.NOTE$ = HELP.NOTE$ + " of " + HELP.NUM$
    GOSUB HELP.STATUSBAR
    RETURN

## One selectable entry in HELP.DIR, stopping at either end.
HELP.IX.STEP:
    HELP.J = HELP.IX.SEL + HELP.DIR
HELP.IX.STEP.SCAN:
    IF HELP.J < 1 THEN RETURN
    IF HELP.J > HELP.IX.N THEN RETURN
    HELP.IXR = HELP.J : GOSUB HELP.IXREAD
    IF HELP.IXTYPE = 0 THEN HELP.J = HELP.J + HELP.DIR : GOTO HELP.IX.STEP.SCAN
    HELP.IX.SEL = HELP.J
    RETURN

HELP.IX.PAGE:
    HELP.J = HELP.IX.SEL + HELP.DIR * (HELP.VIEW - 1)
    IF HELP.J < 1 THEN HELP.J = 1
    IF HELP.J > HELP.IX.N THEN HELP.J = HELP.IX.N
    HELP.IX.SEL = HELP.J
    GOSUB HELP.IX.SNAP
    RETURN

## Land on something selectable: try HELP.DIR first, then turn round once.
HELP.IX.SNAP:
    HELP.TURNED = 0
    HELP.J = HELP.IX.SEL
HELP.IX.SNAP.SCAN:
    IF HELP.J < 1 THEN GOTO HELP.IX.SNAP.TURN
    IF HELP.J > HELP.IX.N THEN GOTO HELP.IX.SNAP.TURN
    HELP.IXR = HELP.J : GOSUB HELP.IXREAD
    IF HELP.IXTYPE <> 0 THEN HELP.IX.SEL = HELP.J : RETURN
    HELP.J = HELP.J + HELP.DIR
    GOTO HELP.IX.SNAP.SCAN
HELP.IX.SNAP.TURN:
    IF HELP.TURNED <> 0 THEN RETURN
    HELP.TURNED = 1
    HELP.DIR = 0 - HELP.DIR
    HELP.J = HELP.IX.SEL + HELP.DIR
    GOTO HELP.IX.SNAP.SCAN

HELP.IX.SHOW:
    IF HELP.IX.SEL < HELP.IX.TOP THEN HELP.IX.TOP = HELP.IX.SEL
    IF HELP.IX.SEL > HELP.IX.TOP + HELP.VIEW - 1 THEN HELP.IX.TOP = HELP.IX.SEL - HELP.VIEW + 1
    ## Keep a category heading on screen above the row that is selected.
    GP.IF HELP.IX.SEL > 1 AND HELP.IX.TOP = HELP.IX.SEL THEN
        HELP.IXR = HELP.IX.SEL - 1 : GOSUB HELP.IXREAD
        IF HELP.IXTYPE = 0 THEN HELP.IX.TOP = HELP.IX.SEL - 1
    GP.ENDIF
    IF HELP.IX.TOP > HELP.IX.N - HELP.VIEW + 1 THEN HELP.IX.TOP = HELP.IX.N - HELP.VIEW + 1
    IF HELP.IX.TOP < 1 THEN HELP.IX.TOP = 1
    RETURN


## ============================================================================
## The reader
## ============================================================================

HELP.OPEN.SEL:
    HELP.GO = HELP.IX.SEL
    HELP.BACK.N = 0
    GOSUB HELP.START.AT
    GOSUB HELP.TOPIC
    HELP.FULL = 1
    RETURN

## Where a row opens its topic. A section row starts on its own header; a
## topic row starts at the top.
HELP.START.AT:
    HELP.PG.FROM = 0
    HELP.IXR = HELP.GO : GOSUB HELP.IXREAD
    IF HELP.IXSEC > 1 THEN HELP.PG.FROM = HELP.IXSEC - 1
    GOSUB HELP.PG.CLAMP
    RETURN

HELP.PG.CLAMP:
    HELP.IXR = HELP.GO : GOSUB HELP.IXREAD
    HELP.PG.MAX = HELP.IXLINES - HELP.VIEW
    IF HELP.PG.FROM > HELP.PG.MAX THEN HELP.PG.FROM = HELP.PG.MAX
    IF HELP.PG.FROM < 0 THEN HELP.PG.FROM = 0
    RETURN

## Show index row HELP.GO, and every row a cross reference in it leads to, until
## ESC has walked back out. Flat, not nested: following a link re-enters at the
## top with HELP.NAV = 1, so the depth is in HELP.BACK.* and not on the stack.
HELP.TOPIC:
HELP.TOPIC.ENTER:
    ## Once per topic, not once per scroll. Everything below draws out of this
    ## bank.
    GOSUB HELP.PAGE.LOAD
    HELP.REDRAW = 1 : HELP.SHIFT = 0
HELP.PAGE.LOOP:
    GP.IF HELP.REDRAW <> 0 THEN
        GOSUB HELP.PAGE.DRAW
        HELP.REDRAW = 0
    GP.ENDIF
    IF HELP.PG.LINES = 0 THEN RETURN
    GOSUB HELP.PAGE.STATUS

    HELP.FROM.WAS = HELP.PG.FROM : HELP.NAV = 0
    GOSUB HELP.GETKEY

    GP.SELECT HELP.KEY
        GP.CASE HELP.K.UP
            HELP.PG.FROM = HELP.PG.FROM - 1
        GP.CASE HELP.K.DOWN
            HELP.PG.FROM = HELP.PG.FROM + 1
        GP.CASE HELP.K.PGUP
            HELP.PG.FROM = HELP.PG.FROM - HELP.VIEW + 1
        GP.CASE HELP.K.PGDN, GUI.SPACE
            HELP.PG.FROM = HELP.PG.FROM + HELP.VIEW - 1
        GP.CASE HELP.K.HOME
            HELP.PG.FROM = 0
        GP.CASE HELP.K.END
            HELP.IXR = HELP.GO : GOSUB HELP.IXREAD : HELP.PG.FROM = HELP.IXLINES
        GP.CASE 76, 108
            GOSUB HELP.LINKS
        GP.CASE 84, 116
            ## The frame as well. A topic page inherits the index's and never
            ## paints one, so the three corner cells would keep the old theme's
            ## colours.
            GOSUB HELP.THEME.NEXT : GOSUB HELP.PAGE.FRAME : HELP.REDRAW = 1
        GP.CASE 88, 120
            GOSUB HELP.EXPORT
        GP.CASE GUI.ESCAPE, GUI.STOP
            GOSUB HELP.BACK.POP
    GP.ENDSEL

    IF HELP.NAV = 2 THEN RETURN
    IF HELP.NAV = 1 THEN GOTO HELP.TOPIC.ENTER
    GOSUB HELP.PG.CLAMP
    ## The clamp runs first, so a PgDn that lands one line short of the bottom
    ## arrives here as a delta of 1 and slides like an arrow key.
    HELP.SHIFT = 0 : HELP.DELTA = HELP.PG.FROM - HELP.FROM.WAS
    IF HELP.DELTA = 1 THEN HELP.SHIFT = 1
    IF HELP.DELTA = 0 - 1 THEN HELP.SHIFT = 0 - 1
    IF HELP.DELTA <> 0 THEN HELP.REDRAW = 1
    GOTO HELP.PAGE.LOOP

## ============================================================================
## The topic lives in a bank. It is read once, on entry, into HELP.TBANK, and a
## scroll then paints one row out of RAM.
##
## WARNING: this cannot be one GP.CALL. The KERNAL's memory_copy takes no bank
## argument and BANK applies only around a PEEK or a POKE, so a raw call runs
## with whatever BASIC left in $00. Holding a bank across one needs GP.ASM.
## ============================================================================
HELP.PAGE.LOAD:
    HELP.HASCODE = 0
    HELP.PG.LINES = 0 : HELP.LINKN = 0 : HELP.ATTOPIC = 0
    ## The link menu is built as the topic loads, one popup row a cross reference.
    GP.SUB MENU.BEGIN, MENU.POPUP
    ## The text starts above the line table, which owns the front of the bank.
    HELP.PG.P = HELP.MAXLINES * HELP.RECSIZE
    HELP.RECP = HELP.WIN
    HELP.IXR = HELP.GO : GOSUB HELP.IXREAD
    HELP.TOPICNUM = HELP.IXTOPIC
    IF HELP.TOPICNUM < 1 THEN RETURN
    GOSUB HELP.FILENAME
    GOSUB HELP.PAGE.LOADING

    OPEN HELP.CHAN, 8, HELP.CHAN, HELP.NAME$ + ",S,R"
    LINPUT# HELP.CHAN, HELP.LINE$, 10 : HELP.ST = ST
    IF (HELP.ST AND 2) <> 0 THEN GOTO HELP.LOAD.CLOSE
    GOSUB HELP.STRIP
    HELP.IXR = HELP.GO : GOSUB HELP.IXREAD : GOSUB HELP.IXTEXT
    ## A copy. HELP.ROW$ is rewritten in place by the next row read.
    HELP.TITLE$ = HELP.ROW$ + ""
    IF LEFT$(HELP.LINE$, 1) = "@" THEN HELP.TITLE$ = MID$(HELP.LINE$, 2) : HELP.ATTOPIC = 1

HELP.LOAD.READ:
    IF HELP.PG.LINES > HELP.IXLINES + 4 THEN GOTO HELP.LOAD.CLOSE
    LINPUT# HELP.CHAN, HELP.LINE$, 10 : HELP.ST = ST
    IF (HELP.ST AND 2) <> 0 THEN GOTO HELP.LOAD.CLOSE
    HELP.PG.LINES = HELP.PG.LINES + 1
    ## The line is read through its pointer, not taken apart into strings.
    ## GP.STRPTR gives the address of the length byte, so length is offset 0, the
    ## marker 1 and the body 2. PEEK reads main RAM and ignores the bank.
    HELP.LP = GP.STRPTR(HELP.LINE$)
    HELP.LL = LEN(HELP.LINE$)
    IF HELP.LL > 0 THEN IF PEEK(HELP.LP + HELP.LL) = 13 THEN HELP.LL = HELP.LL - 1
    HELP.MARKC = 0
    IF HELP.LL > 0 THEN HELP.MARKC = PEEK(HELP.LP + 1)
    HELP.KIND = 0
    IF HELP.MARKC = 61 THEN HELP.KIND = 1
    IF HELP.MARKC = 58 THEN HELP.KIND = 2
    IF HELP.MARKC = 58 THEN HELP.HASCODE = 1
    ## A cross reference is the one line that needs a string. HELP.PAGE.REF
    ## splits it on "|" and adds the text to the link menu.
    GP.IF HELP.MARKC = 62 THEN
        HELP.BODY$ = MID$(HELP.LINE$, 2, HELP.LL - 1)
        GOSUB HELP.PAGE.REF
        HELP.SP = GP.STRPTR(HELP.BODY$) + 1 : HELP.W = LEN(HELP.BODY$)
    GP.ELSE
        HELP.SP = HELP.LP + 2 : HELP.W = HELP.LL - 1
    GP.ENDIF
    IF HELP.W < 0 THEN HELP.W = 0
    GOSUB HELP.LOAD.STORE
    IF HELP.PG.LINES >= HELP.MAXLINES THEN GOTO HELP.LOAD.CLOSE
    ## Bit 6 is the end. The last line carries data and the flag, so it is stored
    ## first and the loop leaves after it. HELP.IDXLOAD has the note on ST.
    IF (HELP.ST AND 64) = 0 THEN GOTO HELP.LOAD.READ

HELP.LOAD.CLOSE:
    CLOSE HELP.CHAN
    RETURN

## One line into the bank, its kind beside it so no row is parsed twice. The
## body is truncated to what a row can show. In: HELP.SP the address of the
## first body character, HELP.W how many, HELP.KIND.
HELP.LOAD.STORE:
    ## Ordinary text starts at column 2, which is the widest a row can be. Link
    ## rows indent to 5 and are clamped where they are drawn.
    IF HELP.W > HELP.COLS - 2 THEN HELP.W = HELP.COLS - 2
    ## Out of bank is recorded as an empty line, not a half written one.
    IF HELP.PG.P + HELP.W > HELP.BANKSIZE THEN HELP.W = 0
    ## The blob writes the line record as well as the text.
    ## WARNING: these are signed int16 holding an unsigned address. $A000
    ## comes back negative, but the low two bytes are the bit pattern the
    ## blob reads. Never do arithmetic on them in BASIC.
    ## HELP.SP already points at the first character, not the length byte.
    HELP.AS.SRC% = HELP.SP
    HELP.AS.DST% = HELP.WIN + HELP.PG.P
    HELP.AS.LEN% = HELP.W
    HELP.AS.BANK% = HELP.TBANK
    HELP.AS.REC% = HELP.RECP
    HELP.AS.OFF% = HELP.PG.P
    HELP.AS.KIND% = HELP.KIND
    GOSUB HELP.STORE.ASM
    HELP.RECP = HELP.RECP + HELP.RECSIZE
    HELP.PG.P = HELP.PG.P + HELP.W
    RETURN

## ============================================================================
## ============================================================================
## One line into the bank, in assembly.
##
## zTemp0, zTemp1 and zTemp2 hold the three pointers. They are free inside a
## blob: SYS clobbers zTemp0 reaching it.
##
## $00 is saved and put back, so the interpreter finds the bank as it left it. A
## line is at most 78 bytes, so the count fits in X and Y never wraps.
## ============================================================================
HELP.STORE.ASM:
    #REM 1
    GP.ASM
    REM LDA {HELP.AS.SRC%}       ; source -> zTemp0
    REM STA $2C
    REM LDX #1
    REM LDA {HELP.AS.SRC%},X
    REM STA $2D
    REM LDA {HELP.AS.DST%}       ; destination -> zTemp1
    REM STA $2E
    REM LDX #1
    REM LDA {HELP.AS.DST%},X
    REM STA $2F
    REM LDA {HELP.AS.REC%}       ; the line record -> zTemp2
    REM STA $30
    REM LDX #1
    REM LDA {HELP.AS.REC%},X
    REM STA $31
    REM LDA $00                  ; the bank we were handed, to put back
    REM PHA
    REM LDA {HELP.AS.BANK%}
    REM STA $00
    REM ; ---- offset low, offset high, length, kind ----
    REM LDY #0
    REM LDA {HELP.AS.OFF%}
    REM STA ($30),Y
    REM INY
    REM LDX #1
    REM LDA {HELP.AS.OFF%},X
    REM STA ($30),Y
    REM INY
    REM LDA {HELP.AS.LEN%}
    REM STA ($30),Y
    REM INY
    REM LDA {HELP.AS.KIND%}
    REM STA ($30),Y
    REM LDX {HELP.AS.LEN%}
    REM BEQ HSDONE
    REM LDY #0
    REM HSLP: LDA ($2C),Y
    REM STA ($2E),Y
    REM INY
    REM DEX
    REM BNE HSLP
    REM HSDONE: PLA
    REM STA $00
    GP.ENDASM
    #REM 0
    RETURN

## The title bar goes up before the read, so the topic is named while it loads.
HELP.PAGE.LOADING:
    GOSUB HELP.PAGE.FRAME
    HELP.IXR = HELP.GO : GOSUB HELP.IXREAD : GOSUB HELP.IXTEXT
    ## A copy. HELP.ROW$ is rewritten in place by the next row read.
    HELP.TITLE$ = HELP.ROW$ + ""
    GOSUB HELP.TITLEBAR
    GP.PRINTAT 2, 2, "Reading " + HELP.NAME$ + " ...", THEME.CLR(THEME.DIMMED)
    RETURN

## The page, painted from the bank. No file is opened here: this runs on every
## scroll and HELP.PAGE.LOAD does not.
HELP.PAGE.DRAW:
    IF HELP.PG.LINES = 0 THEN RETURN
    GOSUB HELP.TITLEBAR
    HELP.ONLY = 0 - 1
    GP.IF HELP.SHIFT <> 0 THEN
        GOSUB HELP.PAGE.SHIFT
    GP.ELSE
        GP.FILL 0, 1, HELP.COLS, HELP.VIEW, 32, THEME.CLR(THEME.PAGE)
    GP.ENDIF
    FOR HELP.R = 0 TO HELP.VIEW - 1
        HELP.LN = HELP.PG.FROM + HELP.R + 1
        HELP.Y = 1 + HELP.R
        ## HELP.ONLY < 0 is "all of them". Otherwise one row is new and the rest
        ## are already on screen, slid into place.
        IF HELP.ONLY < 0 THEN GOSUB HELP.PAGE.ROW
        IF HELP.ONLY = HELP.R THEN GOSUB HELP.PAGE.ROW
    NEXT HELP.R
    RETURN

## Slide the text region one row rather than repainting it. Rows 1..HELP.VIEW
## move; the bars are outside the rectangle. HELP.ONLY names the row the slide
## exposed, the only one the draw pass paints.
##
## One memory_copy, and the cells never leave VRAM. The two data ports $9F23 and
## $9F24 go in r0 and r1 a row apart, and the KERNAL steps no pointer, so VERA
## walks both itself. Going down the ranges overlap, so both ports start at the
## last byte and VERA's DECR bit walks them backwards.
HELP.PAGE.SHIFT:
    HELP.SC.MAPW = 32 * 2 ^ INT((PEEK(HELPK.LCONFIG) AND 48) / 16)
    HELP.SC.STRIDE = HELP.SC.MAPW * 2
    HELP.SC.BASE = PEEK(HELPK.LMAPBASE) * 512
    HELP.SC.N = (HELP.VIEW - 1) * HELP.SC.STRIDE

    HELP.SC.SRC = HELP.SC.BASE + HELP.SC.STRIDE * 2
    HELP.SC.DST = HELP.SC.BASE + HELP.SC.STRIDE
    HELP.SC.STEP = HELPK.UP
    HELP.ONLY = HELP.VIEW - 1
    GP.IF HELP.SHIFT <> 1 THEN
        HELP.SC.SRC = HELP.SC.BASE + HELP.SC.STRIDE + HELP.SC.N - 1
        HELP.SC.DST = HELP.SC.BASE + HELP.SC.STRIDE * 2 + HELP.SC.N - 1
        HELP.SC.STEP = HELPK.DOWN
        HELP.ONLY = 0
    GP.ENDIF

    HELP.SC.ADDR = HELP.SC.SRC : GOSUB HELP.SC.PORTA
    HELP.SC.ADDR = HELP.SC.DST : GOSUB HELP.SC.PORTB
    POKE 2, HELPK.PORTLO : POKE 3, HELPK.PORTHI
    POKE 4, HELPK.PORTLO.B : POKE 5, HELPK.PORTHI
    HELP.SC.HI = INT(HELP.SC.N / 256)
    POKE 6, HELP.SC.N - HELP.SC.HI * 256 : POKE 7, HELP.SC.HI
    GP.CALL HELPK.MEMCOPY

    ## The exposed row still holds its old text. HELP.PAGE.ROW paints over a
    ## cleared row and does not clear one itself.
    GP.FILL 0, 1 + HELP.ONLY, HELP.COLS, 1, 32, THEME.CLR(THEME.PAGE)
    RETURN

## The two address ports. CTRL bit 0 is ADDRSEL, so $9F20-$9F22 are port 1's
## registers while it is set, and it goes back to 0 for the streaming path.
HELP.SC.PORTA:
    GOSUB HELP.SC.SPLIT
    POKE HELPK.VCTRL, 0
    POKE HELPK.VLO, HELP.SC.LO : POKE HELPK.VMID, HELP.SC.MID
    POKE HELPK.VHI, HELP.SC.BANK + HELP.SC.STEP
    RETURN

HELP.SC.PORTB:
    GOSUB HELP.SC.SPLIT
    POKE HELPK.VCTRL, 1
    POKE HELPK.VLO, HELP.SC.LO : POKE HELPK.VMID, HELP.SC.MID
    POKE HELPK.VHI, HELP.SC.BANK + HELP.SC.STEP
    POKE HELPK.VCTRL, 0
    RETURN

## A VRAM address is 17 bits, so GP.HIBYTE and GP.LOBYTE cannot split it. Bit 16
## comes off first and rides in ADDRH.
HELP.SC.SPLIT:
    HELP.SC.BANK = INT(HELP.SC.ADDR / 65536)
    HELP.SC.REST = HELP.SC.ADDR - HELP.SC.BANK * 65536
    HELP.SC.MID = INT(HELP.SC.REST / 256)
    HELP.SC.LO = HELP.SC.REST - HELP.SC.MID * 256
    RETURN

## A ">" line is "ordinal|text". The ordinal is a HELP.IDX row, resolved by
## MKHELP.PY when it laid the index out.
HELP.PAGE.REF:
    HELP.KIND = 3
    HELP.CUT = GP.INSTR(HELP.BODY$, "|")
    IF HELP.CUT = 0 THEN RETURN
    HELP.TREF = VAL(LEFT$(HELP.BODY$, HELP.CUT - 1))
    HELP.BODY$ = MID$(HELP.BODY$, HELP.CUT + 1)
    IF HELP.TREF < 1 THEN RETURN
    IF HELP.TREF > HELP.IX.N THEN RETURN
    IF HELP.LINKN >= HELP.MAXPICK THEN RETURN
    HELP.LINKN = HELP.LINKN + 1
    HELP.PICK%(HELP.LINKN) = HELP.TREF
    GP.SUB MENU.ITEM, HELP.BODY$
    RETURN

## One row, out of the bank. HELP.LN is the line and HELP.Y the screen row. The
## row must be clear already: the full draw fills the region and a slide fills
## the one row it exposed.
HELP.PAGE.ROW:
    IF HELP.LN < 1 THEN RETURN
    IF HELP.LN > HELP.PG.LINES THEN RETURN
    ## WARNING: select the bank every time. STASH selects its own and does not
    ## put ours back, so a row read after a dialog comes out as the stash buffer
    ## and looks like the scroll corrupting the screen.
    BANK HELP.TBANK
    HELP.REC = HELP.WIN + (HELP.LN - 1) * HELP.RECSIZE
    HELP.A = HELP.WIN + PEEK(HELP.REC) + PEEK(HELP.REC + 1) * 256
    HELP.W = PEEK(HELP.REC + 2)
    HELP.KIND = PEEK(HELP.REC + 3)
    HELP.ATTR = THEME.CLR(THEME.TEXT)
    HELP.INDENT = 2
    GP.IF HELP.KIND = 1 THEN
        GP.FILL 0, HELP.Y, HELP.COLS, 1, 32, THEME.CLR(THEME.TITLE)
        HELP.ATTR = THEME.CLR(THEME.TITLE)
    GP.ENDIF
    IF HELP.KIND = 2 THEN HELP.ATTR = THEME.CLR(THEME.DIMMED)
    GP.IF HELP.KIND = 3 THEN
        HELP.ATTR = THEME.CLR(THEME.WARN)
        GP.PRINTAT 2, HELP.Y, "->", HELP.ATTR
        HELP.INDENT = 5
    GP.ENDIF
    HELP.WMAX = HELP.COLS - HELP.INDENT
    IF HELP.W > HELP.WMAX THEN HELP.W = HELP.WMAX
    ## A dialog may have run between the record read and here, so select again.
    BANK HELP.TBANK
    GP.IF HELP.W > 0 THEN
        FOR HELP.I = 0 TO HELP.W - 1
            GP.CHAR HELP.INDENT + HELP.I, HELP.Y, PEEK(HELP.A + HELP.I), HELP.ATTR
        NEXT HELP.I
    GP.ENDIF
    RETURN

## Only what this topic can do. A topic with no ":" lines gets no X in its
## footer.
HELP.PAGE.STATUS:
    HELP.HINT$ = "T theme   ESC back"
    IF HELP.HASCODE <> 0 THEN HELP.HINT$ = "X export code   " + HELP.HINT$
    IF HELP.LINKN > 0 THEN HELP.HINT$ = "L links   " + HELP.HINT$
    HELP.NUMV = HELP.PG.FROM + 1 : GOSUB HELP.NUMSTR
    HELP.NOTE$ = "line " + HELP.NUM$
    HELP.NUMV = HELP.PG.LINES : GOSUB HELP.NUMSTR
    HELP.NOTE$ = HELP.NOTE$ + " of " + HELP.NUM$
    GOSUB HELP.STATUSBAR
    RETURN


## ============================================================================
## Cross references, and the way back
## ============================================================================

HELP.LINKS:
    ## The footer is the contract. It does not offer L on a topic with no cross
    ## references, so the key does nothing. Same rule as X in HELP.EXPORT.
    IF HELP.LINKN = 0 THEN RETURN
    HELP.LINKSEL = GP.FN(PICKMENUEX, "SEE ALSO", "Follow", "", "", 1, 0)
    HELP.REDRAW = 1
    IF HELP.LINKSEL < 1 THEN RETURN
    GOSUB HELP.BACK.PUSH
    HELP.GO = HELP.PICK%(HELP.LINKSEL)
    HELP.PG.FROM = 0
    HELP.NAV = 1
    RETURN

HELP.BACK.PUSH:
    IF HELP.BACK.N >= HELP.MAXBACK THEN RETURN
    HELP.BACK.N = HELP.BACK.N + 1
    HELP.BACK.GO%(HELP.BACK.N) = HELP.GO
    HELP.BACK.AT%(HELP.BACK.N) = HELP.PG.FROM
    RETURN

## ESC. One step back along the links that got here, and the index when there
## are none left.
HELP.BACK.POP:
    IF HELP.BACK.N < 1 THEN HELP.NAV = 2 : RETURN
    HELP.GO = HELP.BACK.GO%(HELP.BACK.N)
    HELP.PG.FROM = HELP.BACK.AT%(HELP.BACK.N)
    HELP.BACK.N = HELP.BACK.N - 1
    HELP.NAV = 1
    RETURN


## ============================================================================
## Export -- the code out of a topic, as something BASLOAD can read
## ============================================================================

HELP.EXPORT:
    IF HELP.HASCODE = 0 THEN RETURN
    HELP.OUTNAME$ = GP.FN(INPUTBOXEX, "EXPORT", "Write this topic's code to:", "", "", "EXAMPLE.BL", 24, 0)
    HELP.REDRAW = 1
    IF GUI.OK = 0 THEN RETURN
    IF HELP.OUTNAME$ = "" THEN RETURN

    ## Channel 2 reads the topic and channel 3 writes the export. "@:" replaces.
    ## The lines are ASCII already, which is what BASLOAD reads.
    HELP.IXR = HELP.GO : GOSUB HELP.IXREAD
    HELP.TOPICNUM = HELP.IXTOPIC : GOSUB HELP.FILENAME
    HELP.CNT = 0
    OPEN 3, 8, 3, "@:" + HELP.OUTNAME$ + ",S,W"
    PRINT# 3, "## " + HELP.TITLE$
    PRINT# 3, "## exported by GPB.HELP from " + HELP.NAME$
    PRINT# 3, ""
    OPEN HELP.CHAN, 8, HELP.CHAN, HELP.NAME$ + ",S,R"
HELP.EXPORT.LOOP:
    LINPUT# HELP.CHAN, HELP.LINE$, 10 : HELP.ST = ST
    IF (HELP.ST AND 2) <> 0 THEN GOTO HELP.EXPORT.DONE
    GOSUB HELP.STRIP
    IF LEFT$(HELP.LINE$, 1) = ":" THEN GOSUB HELP.EXPORT.WRITE
    ## Bit 6 only. This loop is where ST = 128 comes from, since channel 3 is
    ## open for writing while channel 2 is being read.
    IF (HELP.ST AND 64) = 0 THEN GOTO HELP.EXPORT.LOOP
HELP.EXPORT.DONE:
    CLOSE HELP.CHAN
    CLOSE 3

    HELP.NUMV = HELP.CNT : GOSUB HELP.NUMSTR
    HELP.MSG.ONE$ = "Wrote " + HELP.NUM$ + " lines to " + HELP.OUTNAME$
    HELP.MSG.TWO$ = "It is source, not a program: BASLOAD it."
    IF HELP.CNT = 0 THEN HELP.MSG.TWO$ = "This topic had no code in it."
    GOSUB HELP.SAY
    RETURN

HELP.EXPORT.WRITE:
    HELP.CNT = HELP.CNT + 1
    PRINT# 3, MID$(HELP.LINE$, 2)
    RETURN


## ============================================================================
## Find, over the index that is already in memory
## ============================================================================

HELP.FIND.ASK:
    HELP.ASKED$ = GP.FN(INPUTBOXEX, "FIND", "Find in the index:", "", "", HELP.FIND$, 30, 0)
    HELP.FULL = 1
    IF GUI.OK = 0 THEN RETURN
    ## The "" is what makes it a copy. Assigning one string to another can hand
    ## over the same block, and STRCASE rewrites the bytes where they lie.
    HELP.FIND$ = HELP.ASKED$ + ""
    IF HELP.FIND$ = "" THEN RETURN
    STRCASE.PTR = GP.STRPTR(HELP.FIND$) : STRCASE.MODE = STRCASE.UPPER
    GOSUB STRCASE.GO
    GOSUB HELP.FIND.RUN
    RETURN

HELP.FIND.NEXT:
    IF HELP.FIND$ = "" THEN GOSUB HELP.FIND.ASK : RETURN
    GOSUB HELP.FIND.RUN
    RETURN

## The first selectable entry after the highlight that contains the needle,
## wrapping once. Case is folded on a copy, as in HELP.FIND.ASK.
HELP.FIND.RUN:
    HELP.J = HELP.IX.SEL
    HELP.TRIES = 0
HELP.FIND.SCAN:
    HELP.TRIES = HELP.TRIES + 1
    IF HELP.TRIES > HELP.IX.N THEN GOTO HELP.FIND.MISS
    HELP.J = HELP.J + 1
    IF HELP.J > HELP.IX.N THEN HELP.J = 1
    HELP.IXR = HELP.J : GOSUB HELP.IXREAD
    IF HELP.IXTYPE = 0 THEN GOTO HELP.FIND.SCAN
    GOSUB HELP.IXTEXT
    HELP.HAY$ = HELP.ROW$ + ""
    STRCASE.PTR = GP.STRPTR(HELP.HAY$) : STRCASE.MODE = STRCASE.UPPER
    GOSUB STRCASE.GO
    IF GP.INSTR(HELP.HAY$, HELP.FIND$) = 0 THEN GOTO HELP.FIND.SCAN
    HELP.IX.SEL = HELP.J
    GOSUB HELP.IX.SHOW
    HELP.FULL = 1
    RETURN
HELP.FIND.MISS:
    HELP.MSG.ONE$ = "Not found: " + HELP.FIND$
    HELP.MSG.TWO$ = ""
    GOSUB HELP.SAY
    HELP.FULL = 1
    RETURN


## ============================================================================
## Small dialogs, and the two bars
## ============================================================================

HELP.SAY:
    GP.SUB MSGBOXEX, "GPB.HELP", HELP.MSG.ONE$, HELP.MSG.TWO$, "", ""
    RETURN

## The two banks a reader has to work around when they open one of their own.
HELP.ABOUT:
    HELP.MSG.ONE$ = "GPB.HELP -- the GP.BASIC and BASL reference."
    HELP.MSG.TWO$ = "RAM banks used: 8 for dialogs, 9 for the open topic."
    GOSUB HELP.SAY
    HELP.FULL = 1
    RETURN

HELP.ASKQUIT:
    HELP.DONE = GP.FN(ASKYNEX, "GPB.HELP", "Leave the help viewer?", "", "", 1, 0)
    HELP.FULL = 1
    RETURN

## THEME.HI trades an attribute's nibbles, which turns white-on-black text into
## a black-on-white bar. The two bars are worked out on a theme change, so every
## theme change has to come back through here.
HELP.THEME.NEXT:
    GOSUB THEME.NEXT
    GOTO HELP.THEME.BARS

HELP.THEME.SET:
    GOSUB THEME.SELECT
HELP.THEME.BARS:
    THEME.ATTR% = THEME.CLR(THEME.TITLE)  : GOSUB THEME.HI : HELP.BAR.TOP = THEME.INV%
    THEME.ATTR% = THEME.CLR(THEME.DIMMED) : GOSUB THEME.HI : HELP.BAR.BOT = THEME.INV%
    RETURN

## The bars are filled once a page. Filling a row and printing over it leaves
## the bar empty in between, and the status bar is redrawn on every pass of the
## key loop, which flickers under a held arrow key.
HELP.PAGE.FRAME:
    GP.FILL 0, 0, HELP.COLS, HELP.ROWS, 32, THEME.CLR(THEME.PAGE)
    GP.FILL 0, 0, HELP.COLS, 1, 32, HELP.BAR.TOP
    GP.FILL 0, HELP.ROWS - 1, HELP.COLS, 1, 32, HELP.BAR.BOT
    RETURN

## The tail is cleared. The title is set twice, the index text and then the
## topic's own "@" record, and a shorter second would leave the first's end.
HELP.TITLEBAR:
    GP.PRINTAT 1, 0, HELP.TITLE$, HELP.BAR.TOP
    HELP.X = 1 + LEN(HELP.TITLE$)
    IF HELP.X < HELP.COLS THEN GP.FILL HELP.X, 0, HELP.COLS - HELP.X, 1, 32, HELP.BAR.TOP
    RETURN

HELP.STATUSBAR:
    GP.PRINTAT 1, HELP.ROWS - 1, HELP.HINT$, HELP.BAR.BOT
    HELP.X = 1 + LEN(HELP.HINT$)
    HELP.NX = HELP.COLS
    IF HELP.NOTE$ <> "" THEN HELP.NX = HELP.COLS - LEN(HELP.NOTE$) - 1
    ## The gap, so a note that shrinks by a digit leaves no tail behind.
    IF HELP.NX > HELP.X THEN GP.FILL HELP.X, HELP.ROWS - 1, HELP.NX - HELP.X, 1, 32, HELP.BAR.BOT
    IF HELP.NOTE$ <> "" THEN GP.PRINTAT HELP.NX, HELP.ROWS - 1, HELP.NOTE$, HELP.BAR.BOT
    RETURN

## STR$ leads a positive number with a space.
HELP.NUMSTR:
    HELP.NUM$ = STR$(HELP.NUMV)
    IF LEFT$(HELP.NUM$, 1) = " " THEN HELP.NUM$ = MID$(HELP.NUM$, 2)
    RETURN

## One key, in HELP.KEY. KBCLEAR drains the rest of the queue: a held arrow
## repeats faster than a page is drawn, and the queue keeps scrolling after the
## key is let go.
HELP.GETKEY:
    HELP.KEY = 0
HELP.GETKEY.WAIT:
    GET HELP.IN$
    IF HELP.IN$ = "" THEN GOTO HELP.GETKEY.WAIT
    HELP.KEY = ASC(HELP.IN$)
    GP.SUB KBCLEAR
    RETURN

