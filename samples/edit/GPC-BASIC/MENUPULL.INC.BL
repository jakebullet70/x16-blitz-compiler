## ***********************************************************************
## **
## **  MENUPULL.INC.BL -- a dropdown under a bar item.
## **
## **      B = GP.FN(MENUTO.BAR, 0, 0, MENU.NOBOX)
## **      GP.DO
## **          IF B = 0 THEN GP.EXITDO
## **          GOSUB MY.FILL                 MENU.BEGIN MENU.POPUP and its rows
## **          N = GP.FN(MENUTO.PULLDOWN, B, MENU.ROUND)
## **          B = MENU.NEXTBAR
## **      GP.LOOP
## **
## **  N = GP.FN(MENUTO.PULLDOWN, barnum, style)
## **      marks bar item barnum, opens the popup slot under it and runs it.
## **      Returns 1..N for RETURN or a hot key, 0 for anything else.
## **  MENU.SAVESCREEN mode
## **      where the screen under a dropdown is kept: MENU.SAVE.VRAM, the
## **      default, or MENU.SAVE.BANK.
## **  MENU.SHADOW     non-zero gives a boxed dropdown a drop shadow, solid
## **                  cells in MENU.SHADOWATTR% (0 is black), trimmed at the
## **                  screen edge. The save-under covers it.
## **
## **   out  MENU.EXITKEY    the key that ended it
## **        MENU.NEXTBAR    the bar item LEFT or RIGHT walks to, disabled
## **                        items stepped over as the bar does; 0 for any
## **                        other exit
## **        MENU.BARNUM     the bar's row count
## **        MENU.SELX       the item's column, MENU.SELW its width
## **
## **  The bar is the one MENUTO.BAR or MENU.DRAWBAR last drew, where that
## **  left it, with MENU.GAP and MENU.BARFLAGS as they are now. The item stays marked on the way out.
## **  The dropdown's corner is the item's column on the row under the bar,
## **  moved left if it would run off the screen. The style and colours are
## **  MENUTO.VERT's. It runs with MENU.KEYEXIT added to the caller's
## **  MENU.FLAGS.
## **
## **  The screen under the dropdown is saved first and put back after.
## **  MENU.SAVE.VRAM keeps it in VRAM with STASHVRAM. The first dropdown
## **  runs MENUPULL.SVSTART, which DIMs the handle table and runs SV.INIT
## **  with SV.MAX handles, 1 if SV.MAX is 0. A program that uses STASHVRAM
## **  itself sets SV.MAX, with a handle to spare for the menu, and runs
## **  GOSUB MENUPULL.SVSTART rather than DIM the table: the compiler takes
## **  one DIM of an array, and it is here. MENU.SAVE.BANK keeps it in bank MENU.STASHBANK%
## **  with STASH. Set that before the first call to choose the bank; left at
## **  0, the first call takes one from BANKMGR. If there is no room either
## **  way the dropdown still runs and the screen is not put back.
## **
## **  Requires MENU.INC.BL, STASH.INC.BL and STASHVRAM.INC.BL, included by
## **  the caller, and a #SYMFILE for STASH.
## **
## ***********************************************************************
#IFNDEF MENUPULL.DEFS
#DEFINE MENUPULL.DEFS 1

#DEFINE MENUPULL.SCRMODE $FF5F

#DEFINE MENU.SAVE.VRAM 1
#DEFINE MENU.SAVE.BANK 2

GOTO MENUPULL.MODULE.END

MENU.SAVESCREEN.BODY:
    GP.DEFPROC MENU.SAVESCREEN, MENU.SAVEMODE
    RETURN

MENUTO.PULLDOWN.BODY:
    GP.DEFPROC MENUTO.PULLDOWN, MENU.PULLAT, MENU.STYLE RETURNS MENU.CHOSEN
    MENU.PULLSLOT = MENU.POPUP

## ---- MENU.PULLSLOT run under bar item MENU.PULLAT. MENU.KEY comes in here
## ---- with a dropdown's slot.
MENUPULL.OPEN:
    MENU.CHOSEN = 0 : MENU.EXITKEY = 0 : MENU.NEXTBAR = 0
    IF MENU.READY = 0 THEN RETURN
    MENU.RUNSLOT = MENU.BAR : GOSUB MENU.MEASURE
    MENU.BARNUM = MENU.COUNT
    IF MENU.PULLAT < 1 OR MENU.PULLAT > MENU.BARNUM THEN MENU.SEL = 0 : RETURN
    IF MID$(MENU.FLAG$(MENU.BAR), MENU.PULLAT, 1) <> "0" THEN MENU.SEL = 0 : RETURN
    GOSUB MENUPULL.MARK

    MENU.RUNSLOT = MENU.PULLSLOT : GOSUB MENU.MEASURE
    IF MENU.COUNT = 0 THEN MENU.SEL = 0 : RETURN
    GOSUB MENUPULL.PLACE
    GOSUB MENUPULL.SAVE

    MENU.BOXW = MENU.WIDE : MENU.BOXH = MENU.COUNT
    GOSUB MENU.FRAMEBOX
    GOSUB MENUPULL.SHADE
    MENU.RUNFLAGS = MENU.FLAGS OR MENU.KEYEXIT
    GOSUB MENU.RUN

    GOSUB MENUPULL.RESTORE
    IF MENU.EXITKEY = MENU.ENTER OR MENU.HOTHIT <> 0 THEN MENU.CHOSEN = MENU.CUR
    IF MENU.EXITKEY = MENU.LEFT THEN MENU.NEXTBAR = MENU.LEFTOF
    IF MENU.EXITKEY = MENU.RIGHT THEN MENU.NEXTBAR = MENU.RIGHTOF
    RETURN

## ---- with the bar slot the one measured: the neighbours LEFT and RIGHT walk
## ---- to, then the old mark off and this item lit.
MENUPULL.MARK:
    MENU.ATCOL = MENU.BARX : MENU.ATROW = MENU.BARY
    MENU.RUNFLAGS = MENU.BARFLAGS
    MENU.STEP = -1 : GOSUB MENUPULL.BESIDE
    MENU.LEFTOF = MENU.CUR
    MENU.STEP = 1 : GOSUB MENUPULL.BESIDE
    MENU.RIGHTOF = MENU.CUR
    GOSUB MENU.LIGHT
    IF MENU.MARKED > 0 AND MENU.MARKED <> MENU.PULLAT THEN MENU.DRAWN = MENU.MARKED : MENU.PAINT = MENU.PLAIN : GOSUB MENU.DRAWROW
    MENU.DRAWN = MENU.PULLAT : MENU.PAINT = MENU.HILITE : GOSUB MENU.DRAWROW
    MENU.MARKED = MENU.PULLAT
    MENU.SELX = MENU.DRAWX : MENU.SELW = MENU.ROWW
    RETURN

## ---- the marked bar item back in the bar's plain colours, and none marked.
MENUPULL.UNMARK:
    IF MENU.MARKED < 1 THEN RETURN
    MENU.RUNSLOT = MENU.BAR : GOSUB MENU.MEASURE
    MENU.ATCOL = MENU.BARX : MENU.ATROW = MENU.BARY
    GOSUB MENU.LIGHT
    MENU.DRAWN = MENU.MARKED : MENU.PAINT = MENU.PLAIN : GOSUB MENU.DRAWROW
    MENU.MARKED = 0
    RETURN

## ---- the live item beside MENU.PULLAT the MENU.STEP way; nowhere live to go
## ---- stays put.
MENUPULL.BESIDE:
    MENU.CUR = MENU.PULLAT + MENU.STEP
    IF MENU.CUR < 1 THEN GOSUB MENU.WRAPTOP
    IF MENU.CUR > MENU.COUNT THEN GOSUB MENU.WRAPBOT
    GOSUB MENU.SKIPOFF
    IF MID$(MENU.FLAG$(MENU.BAR), MENU.CUR, 1) <> "0" THEN MENU.CUR = MENU.PULLAT
    RETURN

## ---- under the item, and pulled left to stay on screen. MENU.EDGE% is the frame.
MENUPULL.PLACE:
    MENU.RUNCOL = MENU.SELX : MENU.RUNROW = MENU.BARY + 1
    MENU.EDGE% = 2
    IF MENU.STYLE = MENU.NOBOX THEN MENU.EDGE% = 0
    GP.CALL MENUPULL.SCRMODE, 0, 0, 0, 1 : MENU.COLS% = GP.X : MENU.ROWS% = GP.Y
    IF MENU.RUNCOL + MENU.WIDE + MENU.EDGE% > MENU.COLS% THEN MENU.RUNCOL = MENU.COLS% - MENU.WIDE - MENU.EDGE%
    IF MENU.RUNCOL < 0 THEN MENU.RUNCOL = 0
    MENU.SHW% = 0 : MENU.SHH% = 0
    IF MENU.SHADOW = 0 OR MENU.EDGE% = 0 THEN RETURN
    MENU.SHW% = MENU.COLS% - MENU.RUNCOL - MENU.WIDE - MENU.EDGE%
    IF MENU.SHW% > 2 THEN MENU.SHW% = 2
    IF MENU.RUNROW + MENU.COUNT + MENU.EDGE% < MENU.ROWS% THEN MENU.SHH% = 1
    RETURN

## ---- the shadow: two columns down the right from the second row, one row
## ---- under from the third column, so the box's corners stay clear.
MENUPULL.SHADE:
    MENU.BOXR% = MENU.RUNCOL + MENU.WIDE + MENU.EDGE%
    MENU.BOXB% = MENU.RUNROW + MENU.COUNT + MENU.EDGE%
    IF MENU.SHW% > 0 THEN GP.FILL MENU.BOXR%, MENU.RUNROW + 1, MENU.SHW%, MENU.COUNT + MENU.EDGE% - 1, 32, MENU.SHADOWATTR%
    IF MENU.SHH% > 0 THEN GP.FILL MENU.RUNCOL + 2, MENU.BOXB%, MENU.WIDE + MENU.EDGE% + MENU.SHW% - 2, 1, 32, MENU.SHADOWATTR%
    RETURN

## ---- MENU.STASHED% is not 0 when there is something to put back: the
## ---- STASHVRAM handle, or -1 for the bank.
MENUPULL.SAVE:
    MENU.STASHED% = 0
    IF MENU.SAVEMODE = MENU.SAVE.BANK THEN GOTO MENUPULL.SAVEBANK
    IF SV.READY = 0 THEN GOSUB MENUPULL.SVSTART
    IF SV.READY = 0 THEN RETURN
    SV.X = MENU.RUNCOL : SV.Y = MENU.RUNROW
    SV.W = MENU.WIDE + MENU.EDGE% + MENU.SHW% : SV.H = MENU.COUNT + MENU.EDGE% + MENU.SHH%
    GOSUB SV.SAVE
    MENU.STASHED% = SV.HND
    RETURN

MENUPULL.SAVEBANK:
    IF MENU.STASHBANK% = 0 THEN GOSUB BANKMGR.GET.FREE.BANK : MENU.STASHBANK% = BANKMGR.BANK
    IF MENU.STASHBANK% = 0 THEN RETURN
    STASH.BANK = MENU.STASHBANK% : STASH.SLOT = 0
    STASH.X = MENU.RUNCOL : STASH.Y = MENU.RUNROW
    STASH.W = MENU.WIDE + MENU.EDGE% + MENU.SHW% : STASH.H = MENU.COUNT + MENU.EDGE% + MENU.SHH%
    GOSUB STASH.SAVE
    MENU.STASHED% = STASH.OK
    RETURN

## ---- once, and only when the program has not started STASHVRAM itself. A
## ---- refused SV.INIT leaves SV.READY 0 and nothing is saved from then on.
MENUPULL.SVSTART:
    IF MENU.SVTRIED% <> 0 THEN RETURN
    MENU.SVTRIED% = -1
    IF SV.MAX < 1 THEN SV.MAX = 1
    DIM SV.PAGE%(SV.MAX) : DIM SV.PAGES%(SV.MAX)
    GOSUB SV.INIT
    RETURN

MENUPULL.RESTORE:
    IF MENU.STASHED% = 0 THEN RETURN
    IF MENU.SAVEMODE = MENU.SAVE.BANK THEN STASH.BANK = MENU.STASHBANK% : STASH.SLOT = 0 : STASH.MOVE = 0 : GOSUB STASH.RESTORE : RETURN
    SV.HND = MENU.STASHED% : SV.MOVE = 0
    GOSUB SV.RESTORE
    GOSUB SV.FREE
    RETURN

MENUPULL.MODULE.END:
#ENDIF
