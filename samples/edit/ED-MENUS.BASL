REM ============================================================================
REM ED-MENUS.BASL -- the menu library, FORKED INTO THIS SAMPLE, and the editor's own
REM bar and dropdowns built on it.
REM
REM NOTHING HERE COMES FROM GPC-BASIC AT RUN TIME. MENU.INC.BL, MENUPULL.INC.BL and
REM MENUKEY.INC.BL were copied in, re-prefixed ED.*, and taken off the banks: the row
REM store is two string arrays rather than GP.BANKEDSTR groups, and the p-code runs in
REM low memory rather than a GP.BANKED region. Edit it here; the library copy is no
REM longer upstream of it.
REM
REM Every title's rows are stored once, in ED.MENU.SETUP below. ED.MENU.KEY sees each
REM key first: ESC or ALT+letter opens the bar, and it hands back the row chosen.
REM ============================================================================

REM ==========================================================================
REM MENU.INC.BL -- forked, unbanked
REM ==========================================================================
## ***********************************************************************
## **
## **  MENU.INC.BL -- the menu builder. A menu is built a row at a time into
## **  one of two slots, and a runner draws it from there.
## **
## **      GP.SUB ED.MENU.BEGIN, ED.MENU.POPUP
## **      GP.SUB ED.MENU.ITEM, "&ADD RECORD"
## **      GP.SUB ED.MENU.ITEMX, "&DEL RECORD", ED.MENU.OFF
## **      GP.SUB ED.MENU.ITEM, "-"
## **      GP.SUB ED.MENU.ITEM, "&QUIT"
## **
## **  ED.MENU.BEGIN slot                   empties a slot and builds into it
## **  ED.MENU.ITEM  text$                  appends a row, enabled
## **  ED.MENU.ITEMX text$, on              appends a row with its enable flag;
## **                                    on is tested <> 0, so -1 works too
## **  ED.MENU.SELECTED n                   the row the next run opens on; the
## **                                    next ED.MENU.BEGIN or run clears it
## **  R = GP.FN(ED.MENU.HOTROW, slot, key) the live row whose hot key is key,
## **                                    without case; 0 for none. For a
## **                                    key a run handed back, or ALT+key
## **  N = GP.FN(ED.MENUTO.VERT, row, col, style)
## **                                    runs the popup slot, returns 1..N or
## **                                    0 for ESC. ED.MENU.EXITKEY is the key
## **  N = GP.FN(ED.MENUTO.BAR, row, col, style)
## **                                    the same for the bar slot, laid out
## **                                    across. ED.MENU.BARNUM is its row count,
## **                                    ED.MENU.SELX and ED.MENU.SELW the chosen
## **                                    item's column and width
## **  ED.MENU.DRAWBAR row, col, style      draws the bar slot without running
## **                                    it, with ED.MENU.MARKED lit: the item a
## **                                    KEEPMARK bar or a dropdown left marked
## **  ED.MENU.DRAWVERT row, col, style     draws the popup slot without running
## **                                    it, no row lit
## **  ED.MENUTO.PULLDOWN, the popup slot under a bar item, is in
## **  MENUPULL.INC.BL, so a program without one does not carry ED.STASH.
## **  ED.MENU.KEY, a bar and its dropdowns run from the program's key loop, is
## **  in MENUKEY.INC.BL.
## **
## **  Both runners draw a GP.BOX of the given style with its corner at row,
## **  col, one cell bigger all round than the rows: ED.MENU.SOLID, ED.MENU.THIN,
## **  ED.MENU.ROUND, ED.MENU.THICK, or 256+ for a glyph table. ED.MENU.NOBOX draws
## **  none and puts the first row there instead.
## **
## **  Set once by the caller, and read by every run:
## **      ED.MENU.ATTR       rows, background * 16 + fg
## **      ED.MENU.HIATTR     the highlighted row; 0 inverts ED.MENU.ATTR
## **      ED.MENU.HOTATTR    the hot key letter; 0 leaves it untinted
## **      ED.MENU.DISATTR    a disabled row; 0 is ED.MENU.ATTR
## **      ED.MENU.SEPATTR    separator lines and the frame; 0 is ED.MENU.ATTR
## **      ED.MENU.SEPCHR     the separator glyph; 0 is ED.MENU.LINE
## **      ED.MENU.FLAGS      the popup's, added together, below
## **      ED.MENU.GAP        cells between bar items; 0 is none
## **      ED.MENU.BARFLAGS   the bar's flags
## **      ED.MENU.BARATTR, ED.MENU.BARHI, ED.MENU.BARHOT
## **                      the bar's own rows, highlight and hot key. BARATTR
## **                      and BARHOT 0 take the popup's; BARHI 0 inverts
## **                      the bar's rows
## **
## **  The popup flags: ED.MENU.MUSTSEL takes ESC away. ED.MENU.KEEPMARK leaves the
## **  chosen row lit. ED.MENU.NOWRAP stops at the ends. ED.MENU.KEYEXIT ends the
## **  run on a key the menu has no use for, LEFT and RIGHT most often, with
## **  ED.MENU.EXITKEY that key and the row it was on returned.
## **
## **  The bar takes the same flags in ED.MENU.BARFLAGS, with LEFT and RIGHT
## **  moving, and two of its own: ED.MENU.DOWNEXIT and ED.MENU.UPEXIT make DOWN or
## **  UP choose the item, for a bar with dropdowns under it.
## **
## **  The slots:
## **      ED.MENU.BAR        16 rows
## **      ED.MENU.POPUP      32 rows, the working list
## **      ED.MENU.DROP + n   the dropdown under bar item n, 1 to 16
## **  The dropdowns share a pool of 64 rows, taken in the order they are
## **  built. A ED.MENU.BEGIN on the bar empties every dropdown and the pool, so
## **  build the bar first and then its dropdowns; building one dropdown again
## **  on its own takes new rows and leaves its old ones used. A dropdown row
## **  keeps no hint.
## **  A row past the slot's size is dropped, and so is a row before any
## **  ED.MENU.BEGIN. For more, raise the .MAX defines below and add SPC lines
## **  to the groups in MENU.INC.BANKED.BL to match.
## **
## **  & marks the hot key: "SAVE &AS" is stored as "SAVE AS" with hot key A
## **  at column 6. Only the first & counts, && is a literal &, and a trailing
## **  & is left in the text.
## **
## **  A row whose text is one hyphen is a separator. It still counts.
## **
## **  Text and hints live in two string arrays, DIMmed by ED.MENU.CREATE on the
## **  first ED.MENU.BEGIN. No bank, no length cap, and no SHARED compile needed
## **  -- this is the forked store, not the library's GP.BANKEDSTR one.
## **  ED.MENU.OK is always true; it is kept so the row path reads unchanged.
## **
## **  The store is private to the runners. Row R of slot S is at
## **  I = ED.MENU.BASEAT%(S) + R; the bar starts at 0, the popup at 16 and the
## **  pool at 48:
## **      ED.MENU.TXT$(I)             the text, & removed
## **      MID$(ED.MENU.FLAG$(S), R, 1)          "0" live, "1" disabled,
## **                                         "2" a separator
## **      MID$(ED.MENU.HOTKEY$(S), R, 1)        the hot key, CHR$(0) for none
## **      MID$(ED.MENU.HOTCOL$(S), R, 1)        its column as CHR$(n), CHR$(0)
## **                                         for none
## **      LEN(ED.MENU.FLAG$(S))                 the slot's row count
## **
## ***********************************************************************
## Outside ED.MENU.DEFS: BASLOAD does not nest #IFNDEF.

#IFNDEF ED.MENU.DEFS
#DEFINE ED.MENU.DEFS 1

#DEFINE ED.MENU.BAR 0
#DEFINE ED.MENU.POPUP 1
#DEFINE ED.MENU.DROP 1
#DEFINE ED.MENU.LASTSLOT 17
#DEFINE ED.MENU.BAR.MAX 16
#DEFINE ED.MENU.POPUP.MAX 32
#DEFINE ED.MENU.POOL.MAX 64
## the pool's first row in the store, after the bar's and the popup's
#DEFINE ED.MENU.POOLBASE 48

#DEFINE ED.MENU.ON 1
#DEFINE ED.MENU.OFF 0

#DEFINE ED.MENU.SOLID 0
#DEFINE ED.MENU.THIN 1
#DEFINE ED.MENU.ROUND 2
#DEFINE ED.MENU.THICK 3
#DEFINE ED.MENU.NOBOX 255

#DEFINE ED.MENU.MUSTSEL 1
#DEFINE ED.MENU.KEEPMARK 2
#DEFINE ED.MENU.NOWRAP 4
#DEFINE ED.MENU.DOWNEXIT 16
#DEFINE ED.MENU.UPEXIT 32
#DEFINE ED.MENU.KEYEXIT 64

## PETSCII, as GET reports it
#DEFINE ED.MENU.DOWN 17
#DEFINE ED.MENU.UP 145
#DEFINE ED.MENU.LEFT 157
#DEFINE ED.MENU.RIGHT 29
#DEFINE ED.MENU.ENTER 13
#DEFINE ED.MENU.ESC 27
#DEFINE ED.MENU.STOP 3

## the stroke GP.BOX style 1 draws its edges with
#DEFINE ED.MENU.LINE 192

GOTO ED.MENU.MODULE.END

ED.MENU.BEGIN.BODY:
    GP.DEFPROC ED.MENU.BEGIN, ED.MENU.SLOT
    IF ED.MENU.READY = 0 THEN GOSUB ED.MENU.CREATE
    IF ED.MENU.SLOT < ED.MENU.BAR OR ED.MENU.SLOT > ED.MENU.LASTSLOT THEN ED.MENU.SLOT = ED.MENU.POPUP
    ED.MENU.CAP = ED.MENU.BAR.MAX
    IF ED.MENU.SLOT = ED.MENU.POPUP THEN ED.MENU.CAP = ED.MENU.POPUP.MAX
    IF ED.MENU.SLOT = ED.MENU.BAR THEN GOSUB ED.MENU.EMPTYDROPS
    IF ED.MENU.SLOT > ED.MENU.POPUP THEN GOSUB ED.MENU.DROPAT
    ED.MENU.BASE = ED.MENU.BASEAT%(ED.MENU.SLOT)
    ED.MENU.FLAG$(ED.MENU.SLOT) = "" : ED.MENU.HOTKEY$(ED.MENU.SLOT) = "" : ED.MENU.HOTCOL$(ED.MENU.SLOT) = ""
    ED.MENU.SEL = 0
    RETURN

## ---- ED.MENU.KEYSSET 0 has MENUKEY's next ED.MENU.KEY read the new hot keys.
ED.MENU.EMPTYDROPS:
    ED.MENU.POOLTOP = 0 : ED.MENU.KEYSSET = 0
    FOR ED.MENU.EACH = ED.MENU.DROP + 1 TO ED.MENU.LASTSLOT
        ED.MENU.FLAG$(ED.MENU.EACH) = "" : ED.MENU.HOTKEY$(ED.MENU.EACH) = "" : ED.MENU.HOTCOL$(ED.MENU.EACH) = ""
    NEXT ED.MENU.EACH
    RETURN

## ---- a dropdown starts at the pool's next free row and may fill the rest.
ED.MENU.DROPAT:
    ED.MENU.BASEAT%(ED.MENU.SLOT) = ED.MENU.POOLBASE + ED.MENU.POOLTOP - 1
    ED.MENU.CAP = ED.MENU.POOL.MAX - ED.MENU.POOLTOP
    RETURN

## ---- the first live row with the hot key, as ED.MENU.KEYHOT matches one.
ED.MENU.HOTROW.BODY:
    GP.DEFPROC ED.MENU.HOTROW, ED.MENU.FINDSLOT, ED.MENU.FINDKEY RETURNS ED.MENU.FOUND
    ED.MENU.FOUND = 0
    IF ED.MENU.READY = 0 THEN RETURN
    IF ED.MENU.FINDKEY = 0 THEN RETURN
    IF ED.MENU.FINDSLOT < ED.MENU.BAR OR ED.MENU.FINDSLOT > ED.MENU.LASTSLOT THEN ED.MENU.FINDSLOT = ED.MENU.POPUP
    IF ED.MENU.FINDKEY > 96 THEN IF ED.MENU.FINDKEY < 123 THEN ED.MENU.FINDKEY = ED.MENU.FINDKEY - 32
    ED.MENU.FINDN = LEN(ED.MENU.FLAG$(ED.MENU.FINDSLOT))
    IF ED.MENU.FINDN = 0 THEN RETURN
    FOR ED.MENU.SCAN = ED.MENU.FINDN TO 1 STEP -1
        ED.MENU.HAVE = ASC(MID$(ED.MENU.HOTKEY$(ED.MENU.FINDSLOT), ED.MENU.SCAN, 1))
        IF ED.MENU.HAVE > 96 THEN IF ED.MENU.HAVE < 123 THEN ED.MENU.HAVE = ED.MENU.HAVE - 32
        IF ED.MENU.HAVE = ED.MENU.FINDKEY THEN IF MID$(ED.MENU.FLAG$(ED.MENU.FINDSLOT), ED.MENU.SCAN, 1) = "0" THEN ED.MENU.FOUND = ED.MENU.SCAN
    NEXT ED.MENU.SCAN
    RETURN

ED.MENU.DRAWBAR.BODY:
    GP.DEFPROC ED.MENU.DRAWBAR, ED.MENU.RUNROW, ED.MENU.RUNCOL, ED.MENU.STYLE
    IF ED.MENU.READY = 0 THEN RETURN
    GOSUB ED.MENU.BARPLACE
    IF ED.MENU.COUNT = 0 THEN RETURN
    GOSUB ED.MENU.DRAWALL
    IF ED.MENU.MARKED < 1 THEN RETURN
    ED.MENU.DRAWN = ED.MENU.MARKED : ED.MENU.PAINT = ED.MENU.HILITE : GOSUB ED.MENU.DRAWROW
    RETURN

## ---- the bar slot measured and framed. ED.MENU.BARX and ED.MENU.BARY stay for
## ED.MENUTO.PULLDOWN.
ED.MENU.BARPLACE:
    ED.MENU.RUNSLOT = ED.MENU.BAR : GOSUB ED.MENU.MEASURE
    ED.MENU.BARNUM = ED.MENU.COUNT
    IF ED.MENU.COUNT = 0 THEN RETURN
    ED.MENU.BOXW = ED.MENU.SPAN + ED.MENU.GAP * (ED.MENU.COUNT - 1)
    ED.MENU.BOXH = 1 : GOSUB ED.MENU.FRAMEBOX
    ED.MENU.BARX = ED.MENU.ATCOL : ED.MENU.BARY = ED.MENU.ATROW
    ED.MENU.RUNFLAGS = ED.MENU.BARFLAGS
    RETURN

## ---- ED.MENU.RUNSLOT's row count, and where its rows start in the store.
## ED.MENU.WIDE is the widest row, ED.MENU.SPAN all of them end to end. A boxed
## popup pads its rows one cell each side, so ED.MENU.INDENT is 1 and ED.MENU.WIDE
## takes both cells; the bar and a NOBOX popup print from the edge.
ED.MENU.MEASURE:
    ED.MENU.COUNT = LEN(ED.MENU.FLAG$(ED.MENU.RUNSLOT))
    ED.MENU.RUNBASE = ED.MENU.BASEAT%(ED.MENU.RUNSLOT)
    ED.MENU.WIDE = 1 : ED.MENU.SPAN = 0 : ED.MENU.INDENT = 0
    IF ED.MENU.COUNT = 0 THEN RETURN
    FOR ED.MENU.EACH = 1 TO ED.MENU.COUNT
        ED.MENU.TEXTW = LEN(ED.MENU.TXT$(ED.MENU.RUNBASE + ED.MENU.EACH))
        IF ED.MENU.TEXTW > ED.MENU.WIDE THEN ED.MENU.WIDE = ED.MENU.TEXTW
        ED.MENU.SPAN = ED.MENU.SPAN + ED.MENU.TEXTW
    NEXT ED.MENU.EACH
    IF ED.MENU.RUNSLOT = ED.MENU.BAR OR ED.MENU.STYLE = ED.MENU.NOBOX THEN RETURN
    ED.MENU.INDENT = 1 : ED.MENU.WIDE = ED.MENU.WIDE + 2
    RETURN

## ---- a frame one cell outside ED.MENU.BOXW x ED.MENU.BOXH, and ED.MENU.ATCOL, ED.MENU.ATROW
## inside it. ED.MENU.NOBOX draws nothing and leaves them on row, col.
ED.MENU.FRAMEBOX:
    ED.MENU.ATCOL = ED.MENU.RUNCOL : ED.MENU.ATROW = ED.MENU.RUNROW
    IF ED.MENU.STYLE = ED.MENU.NOBOX THEN RETURN
    ED.MENU.FRAME = ED.MENU.SEPATTR
    IF ED.MENU.FRAME = 0 THEN ED.MENU.FRAME = ED.MENU.ATTR
    GP.BOX ED.MENU.RUNCOL, ED.MENU.RUNROW, ED.MENU.BOXW + 2, ED.MENU.BOXH + 2, ED.MENU.STYLE, ED.MENU.FRAME
    ED.MENU.ATCOL = ED.MENU.RUNCOL + 1 : ED.MENU.ATROW = ED.MENU.RUNROW + 1
    RETURN

## ***********************************************************************
## **  ED.MENU.RUN -- ED.MENU.RUNSLOT run at ED.MENU.ATCOL, ED.MENU.ATROW after
## **  ED.MENU.MEASURE, under ED.MENU.RUNFLAGS. The popup runs down, the bar
## **  across. Out: ED.MENU.CUR the row, 0 for ESC; ED.MENU.EXITKEY; ED.MENU.HOTHIT
## **  -1 when a hot key chose it.
## ***********************************************************************
ED.MENU.RUN:
    ED.MENU.EXITKEY = 0 : ED.MENU.HOTHIT = 0
    ED.MENU.CUR = ED.MENU.SEL : ED.MENU.SEL = 0
    IF ED.MENU.CUR < 1 THEN ED.MENU.CUR = 1
    IF ED.MENU.CUR > ED.MENU.COUNT THEN ED.MENU.CUR = ED.MENU.COUNT
    ED.MENU.STEP = 1 : GOSUB ED.MENU.SKIPOFF
    GOSUB ED.MENU.DRAWALL
    ED.MENU.DRAWN = ED.MENU.CUR : ED.MENU.PAINT = ED.MENU.HILITE : GOSUB ED.MENU.DRAWROW

ED.MENU.WAIT:
    GET ED.MENU.INKEY$
    IF ED.MENU.INKEY$ = "" THEN GOTO ED.MENU.WAIT
    ED.MENU.CODE = ASC(ED.MENU.INKEY$)

ED.MENU.KEYED:
    ED.MENU.DONE = 0 : ED.MENU.WAS = ED.MENU.CUR : ED.MENU.STEP = 0
    ED.MENU.MOVE = ED.MENU.CODE
    IF ED.MENU.RUNSLOT = ED.MENU.BAR THEN GOSUB ED.MENU.TURN
    GP.SELECT ED.MENU.MOVE
        GP.CASE ED.MENU.UP
            ED.MENU.STEP = -1
            ED.MENU.CUR = ED.MENU.CUR - 1
            IF ED.MENU.CUR < 1 THEN GOSUB ED.MENU.WRAPTOP
        GP.CASE ED.MENU.DOWN
            ED.MENU.STEP = 1
            ED.MENU.CUR = ED.MENU.CUR + 1
            IF ED.MENU.CUR > ED.MENU.COUNT THEN GOSUB ED.MENU.WRAPBOT
        GP.CASE ED.MENU.ENTER
            IF MID$(ED.MENU.FLAG$(ED.MENU.RUNSLOT), ED.MENU.CUR, 1) = "0" THEN ED.MENU.DONE = -1
        GP.CASE ED.MENU.ESC, ED.MENU.STOP
            GOSUB ED.MENU.CANCEL
        GP.OTHER
            GOSUB ED.MENU.KEYHOT
    GP.ENDSEL
    IF ED.MENU.STEP <> 0 THEN GOSUB ED.MENU.SKIPOFF
    IF ED.MENU.CUR <> ED.MENU.WAS THEN GOSUB ED.MENU.MOVED
    IF ED.MENU.DONE = 0 THEN GOTO ED.MENU.WAIT
    ED.MENU.EXITKEY = ED.MENU.CODE
    IF (ED.MENU.RUNFLAGS AND ED.MENU.KEEPMARK) <> 0 THEN RETURN
    IF ED.MENU.CUR < 1 THEN RETURN
    ED.MENU.DRAWN = ED.MENU.CUR : ED.MENU.PAINT = ED.MENU.PLAIN : GOSUB ED.MENU.DRAWROW
    RETURN

## ---- the bar's keys as the popup's: LEFT and RIGHT move as UP and DOWN do,
## and DOWN or UP chooses when ED.MENU.DOWNEXIT or ED.MENU.UPEXIT says so.
ED.MENU.TURN:
    IF ED.MENU.CODE = ED.MENU.LEFT THEN ED.MENU.MOVE = ED.MENU.UP : RETURN
    IF ED.MENU.CODE = ED.MENU.RIGHT THEN ED.MENU.MOVE = ED.MENU.DOWN : RETURN
    ED.MENU.EXITBIT = 0
    IF ED.MENU.CODE = ED.MENU.DOWN THEN ED.MENU.EXITBIT = ED.MENU.DOWNEXIT
    IF ED.MENU.CODE = ED.MENU.UP THEN ED.MENU.EXITBIT = ED.MENU.UPEXIT
    IF ED.MENU.EXITBIT = 0 THEN RETURN
    ED.MENU.MOVE = 0
    IF (ED.MENU.RUNFLAGS AND ED.MENU.EXITBIT) <> 0 THEN ED.MENU.MOVE = ED.MENU.ENTER
    RETURN

## ---- the old row back and the new one lit. ESC leaves no new row.
ED.MENU.MOVED:
    ED.MENU.DRAWN = ED.MENU.WAS : ED.MENU.PAINT = ED.MENU.PLAIN : GOSUB ED.MENU.DRAWROW
    IF ED.MENU.CUR < 1 THEN RETURN
    ED.MENU.DRAWN = ED.MENU.CUR : ED.MENU.PAINT = ED.MENU.HILITE : GOSUB ED.MENU.DRAWROW
    RETURN

ED.MENU.WRAPTOP:
    ED.MENU.CUR = ED.MENU.COUNT
    IF (ED.MENU.RUNFLAGS AND ED.MENU.NOWRAP) <> 0 THEN ED.MENU.CUR = 1
    RETURN

ED.MENU.WRAPBOT:
    ED.MENU.CUR = 1
    IF (ED.MENU.RUNFLAGS AND ED.MENU.NOWRAP) <> 0 THEN ED.MENU.CUR = ED.MENU.COUNT
    RETURN

ED.MENU.CANCEL:
    IF (ED.MENU.RUNFLAGS AND ED.MENU.MUSTSEL) <> 0 THEN RETURN
    ED.MENU.CUR = 0 : ED.MENU.DONE = -1
    RETURN

## ---- a hot key, matched without case; the first live row with it wins.
## Nothing matched and KEYEXIT set hands the key back.
ED.MENU.KEYHOT:
    ED.MENU.WANT = ED.MENU.CODE
    IF ED.MENU.WANT > 96 THEN IF ED.MENU.WANT < 123 THEN ED.MENU.WANT = ED.MENU.WANT - 32
    FOR ED.MENU.SCAN = 1 TO ED.MENU.COUNT
        ED.MENU.HAVE = ASC(MID$(ED.MENU.HOTKEY$(ED.MENU.RUNSLOT), ED.MENU.SCAN, 1))
        IF ED.MENU.HAVE > 96 THEN IF ED.MENU.HAVE < 123 THEN ED.MENU.HAVE = ED.MENU.HAVE - 32
        IF ED.MENU.HAVE = ED.MENU.WANT THEN GOSUB ED.MENU.HOTTAKE
    NEXT ED.MENU.SCAN
    IF ED.MENU.DONE = 0 THEN IF (ED.MENU.RUNFLAGS AND ED.MENU.KEYEXIT) <> 0 THEN ED.MENU.DONE = -1
    RETURN

ED.MENU.HOTTAKE:
    IF ED.MENU.DONE <> 0 THEN RETURN
    IF MID$(ED.MENU.FLAG$(ED.MENU.RUNSLOT), ED.MENU.SCAN, 1) <> "0" THEN RETURN
    ED.MENU.CUR = ED.MENU.SCAN : ED.MENU.DONE = -1 : ED.MENU.HOTHIT = -1
    RETURN

## ---- off a separator or a disabled row, the way the cursor was going. The
## counter stops a menu with no live row walking for ever.
ED.MENU.SKIPOFF:
    ED.MENU.SKIPS = 0
ED.MENU.SKIPLOOP:
    IF MID$(ED.MENU.FLAG$(ED.MENU.RUNSLOT), ED.MENU.CUR, 1) = "0" THEN RETURN
    ED.MENU.SKIPS = ED.MENU.SKIPS + 1
    IF ED.MENU.SKIPS > ED.MENU.COUNT THEN RETURN
    ED.MENU.CUR = ED.MENU.CUR + ED.MENU.STEP
    IF ED.MENU.CUR < 1 THEN GOSUB ED.MENU.WRAPTOP
    IF ED.MENU.CUR > ED.MENU.COUNT THEN GOSUB ED.MENU.WRAPBOT
    GOTO ED.MENU.SKIPLOOP

## ---- ED.MENU.RUNSLOT's colours: ED.MENU.PLAIN the rows, ED.MENU.HILITE the highlight,
## ED.MENU.TINT the hot key. A HILITE of 0 inverts PLAIN.
ED.MENU.LIGHT:
    ED.MENU.PLAIN = ED.MENU.ATTR : ED.MENU.HILITE = ED.MENU.HIATTR : ED.MENU.TINT = ED.MENU.HOTATTR
    IF ED.MENU.RUNSLOT = ED.MENU.BAR THEN GOSUB ED.MENU.BARLIGHT
    IF ED.MENU.HILITE = 0 THEN ED.MENU.HILITE = (ED.MENU.PLAIN AND 15) * 16 + INT(ED.MENU.PLAIN / 16)
    RETURN

ED.MENU.BARLIGHT:
    IF ED.MENU.BARATTR <> 0 THEN ED.MENU.PLAIN = ED.MENU.BARATTR
    ED.MENU.HILITE = ED.MENU.BARHI
    IF ED.MENU.BARHOT <> 0 THEN ED.MENU.TINT = ED.MENU.BARHOT
    RETURN

ED.MENU.DRAWALL:
    GOSUB ED.MENU.LIGHT
    ED.MENU.PAINT = ED.MENU.PLAIN
    FOR ED.MENU.DRAWN = 1 TO ED.MENU.COUNT
        GOSUB ED.MENU.DRAWROW
    NEXT ED.MENU.DRAWN
    RETURN

## ---- where row ED.MENU.DRAWN sits: ED.MENU.DRAWX, ED.MENU.DRAWY, ED.MENU.ROWW wide. A
## bar item is as wide as its text, after the items left of it and a
## ED.MENU.GAP each.
ED.MENU.SPOT:
    ED.MENU.DRAWX = ED.MENU.ATCOL
    ED.MENU.DRAWY = ED.MENU.ATROW + ED.MENU.DRAWN - 1
    ED.MENU.ROWW = ED.MENU.WIDE
    IF ED.MENU.RUNSLOT <> ED.MENU.BAR THEN RETURN
    ED.MENU.DRAWY = ED.MENU.ATROW
    ED.MENU.ROWW = LEN(ED.MENU.TXT$(ED.MENU.RUNBASE + ED.MENU.DRAWN))
    IF ED.MENU.DRAWN < 2 THEN RETURN
    FOR ED.MENU.LEFTW = 1 TO ED.MENU.DRAWN - 1
        ED.MENU.DRAWX = ED.MENU.DRAWX + LEN(ED.MENU.TXT$(ED.MENU.RUNBASE + ED.MENU.LEFTW)) + ED.MENU.GAP
    NEXT ED.MENU.LEFTW
    RETURN

## ---- row ED.MENU.DRAWN in ED.MENU.PAINT. The fill makes the highlight full width.
## The hot key is tinted only on a row in the plain attribute.
ED.MENU.DRAWROW:
    GOSUB ED.MENU.SPOT
    ED.MENU.ROWIS$ = MID$(ED.MENU.FLAG$(ED.MENU.RUNSLOT), ED.MENU.DRAWN, 1)
    IF ED.MENU.ROWIS$ = "2" THEN GOTO ED.MENU.SEPROW
    GP.FILL ED.MENU.DRAWX, ED.MENU.DRAWY, ED.MENU.ROWW, 1, 32, ED.MENU.PAINT
    ED.MENU.USE = ED.MENU.PAINT
    IF ED.MENU.ROWIS$ = "1" THEN IF ED.MENU.DISATTR <> 0 THEN ED.MENU.USE = ED.MENU.DISATTR
    ED.MENU.SHOW$ = ED.MENU.TXT$(ED.MENU.RUNBASE + ED.MENU.DRAWN)
    GP.PRINTAT ED.MENU.DRAWX + ED.MENU.INDENT, ED.MENU.DRAWY, ED.MENU.SHOW$, ED.MENU.USE
    IF ED.MENU.ROWIS$ = "1" THEN RETURN
    IF ED.MENU.TINT = 0 THEN RETURN
    IF ED.MENU.PAINT <> ED.MENU.PLAIN THEN RETURN
    ED.MENU.TINTAT = ASC(MID$(ED.MENU.HOTCOL$(ED.MENU.RUNSLOT), ED.MENU.DRAWN, 1))
    IF ED.MENU.TINTAT = 0 THEN RETURN
    GP.PRINTAT ED.MENU.DRAWX + ED.MENU.INDENT + ED.MENU.TINTAT - 1, ED.MENU.DRAWY, MID$(ED.MENU.SHOW$, ED.MENU.TINTAT, 1), ED.MENU.TINT
    RETURN

ED.MENU.SEPROW:
    ED.MENU.USE = ED.MENU.SEPATTR
    IF ED.MENU.USE = 0 THEN ED.MENU.USE = ED.MENU.PLAIN
    ED.MENU.GLYPH = ED.MENU.SEPCHR
    IF ED.MENU.GLYPH = 0 THEN ED.MENU.GLYPH = ED.MENU.LINE
    GP.FILL ED.MENU.DRAWX, ED.MENU.DRAWY, ED.MENU.ROWW, 1, ED.MENU.GLYPH, ED.MENU.USE
    RETURN

## ---- ITEM falls through into ITEMX's body with the enable default set.
ED.MENU.ITEM.BODY:
    GP.DEFPROC ED.MENU.ITEM, ED.MENU.ROWTEXT$
    ED.MENU.ROWON = ED.MENU.ON

ED.MENU.ITEMX.BODY:
    GP.DEFPROC ED.MENU.ITEMX, ED.MENU.ROWTEXT$, ED.MENU.ROWON
    IF ED.MENU.OK = 0 THEN RETURN
    ED.MENU.ROW = LEN(ED.MENU.FLAG$(ED.MENU.SLOT)) + 1
    IF ED.MENU.ROW > ED.MENU.CAP THEN RETURN
    ED.MENU.HOTAT = GP.INSTR(ED.MENU.ROWTEXT$, "&") : ED.MENU.HOTCH$ = CHR$(0)
    IF ED.MENU.HOTAT > 0 THEN GOSUB ED.MENU.STRIP
    ED.MENU.TXT$(ED.MENU.BASE + ED.MENU.ROW) = ED.MENU.ROWTEXT$
    IF ED.MENU.SLOT > ED.MENU.POPUP THEN ED.MENU.POOLTOP = ED.MENU.POOLTOP + 1
    ED.MENU.HOTKEY$(ED.MENU.SLOT) = ED.MENU.HOTKEY$(ED.MENU.SLOT) + ED.MENU.HOTCH$
    ED.MENU.HOTCOL$(ED.MENU.SLOT) = ED.MENU.HOTCOL$(ED.MENU.SLOT) + CHR$(ED.MENU.HOTAT)
    ED.MENU.ROWFLAG$ = "0"
    IF ED.MENU.ROWON = 0 THEN ED.MENU.ROWFLAG$ = "1"
    IF ED.MENU.ROWTEXT$ = "-" THEN ED.MENU.ROWFLAG$ = "2"
    ED.MENU.FLAG$(ED.MENU.SLOT) = ED.MENU.FLAG$(ED.MENU.SLOT) + ED.MENU.ROWFLAG$
    RETURN

## ---- the hot key slides left into the &'s column, so ED.MENU.HOTAT stays right.
ED.MENU.STRIP:
    IF ED.MENU.HOTAT = LEN(ED.MENU.ROWTEXT$) THEN ED.MENU.HOTAT = 0 : RETURN
    ED.MENU.HOTCH$ = MID$(ED.MENU.ROWTEXT$, ED.MENU.HOTAT + 1, 1)
    ED.MENU.ROWTEXT$ = LEFT$(ED.MENU.ROWTEXT$, ED.MENU.HOTAT - 1) + MID$(ED.MENU.ROWTEXT$, ED.MENU.HOTAT + 1)
    IF ED.MENU.HOTCH$ = "&" THEN ED.MENU.HOTCH$ = CHR$(0) : ED.MENU.HOTAT = 0
    RETURN

## ---- DIMmed on first use: an array touched before its DIM is auto-DIMmed to 10,
## and the DIM after it is an error.
ED.MENU.CREATE:
    DIM ED.MENU.FLAG$(ED.MENU.LASTSLOT) : DIM ED.MENU.HOTKEY$(ED.MENU.LASTSLOT) : DIM ED.MENU.HOTCOL$(ED.MENU.LASTSLOT)
    DIM ED.MENU.BASEAT%(ED.MENU.LASTSLOT)
    ED.MENU.BASEAT%(ED.MENU.BAR) = -1
    ED.MENU.BASEAT%(ED.MENU.POPUP) = ED.MENU.BAR.MAX - 1
    DIM ED.MENU.TXT$(ED.MENU.POOLBASE + ED.MENU.POOL.MAX - 1)
    ED.MENU.OK = -1 : ED.MENU.READY = -1
    RETURN

ED.MENU.MODULE.END:
#ENDIF

REM ==========================================================================
REM MENUPULL.INC.BL -- forked, unbanked
REM ==========================================================================
## ***********************************************************************
## **
## **  MENUPULL.INC.BL -- a dropdown under a bar item.
## **
## **      B = GP.FN(ED.MENUTO.BAR, 0, 0, ED.MENU.NOBOX)
## **      GP.DO
## **          IF B = 0 THEN GP.EXITDO
## **          GOSUB MY.FILL                 ED.MENU.BEGIN ED.MENU.POPUP and its rows
## **          N = GP.FN(ED.MENUTO.PULLDOWN, B, ED.MENU.ROUND)
## **          B = ED.MENU.NEXTBAR
## **      GP.LOOP
## **
## **  N = GP.FN(ED.MENUTO.PULLDOWN, barnum, style)
## **      marks bar item barnum, opens the popup slot under it and runs it.
## **      Returns 1..N for RETURN or a hot key, 0 for anything else.
## **  ED.MENU.SAVESCREEN mode
## **      where the screen under a dropdown is kept: ED.MENU.SAVE.VRAM, the
## **      default, or ED.MENU.SAVE.BANK.
## **  ED.MENU.SHADOW     non-zero gives a boxed dropdown a drop shadow, solid
## **                  cells in ED.MENU.SHADOWATTR (0 is black), trimmed at the
## **                  screen edge. The save-under covers it.
## **
## **   out  ED.MENU.EXITKEY    the key that ended it
## **        ED.MENU.NEXTBAR    the bar item LEFT or RIGHT walks to, disabled
## **                        items stepped over as the bar does; 0 for any
## **                        other exit
## **        ED.MENU.BARNUM     the bar's row count
## **        ED.MENU.SELX       the item's column, ED.MENU.SELW its width
## **
## **  The bar is the one ED.MENUTO.BAR or ED.MENU.DRAWBAR last drew, where that
## **  left it, with ED.MENU.GAP and ED.MENU.BARFLAGS as they are now. The item stays marked on the way out.
## **  The dropdown's corner is the item's column on the row under the bar,
## **  moved left if it would run off the screen. The style and colours are
## **  ED.MENUTO.VERT's. It runs with ED.MENU.KEYEXIT added to the caller's
## **  ED.MENU.FLAGS.
## **
## **  The screen under the dropdown is saved first and put back after.
## **  ED.MENU.SAVE.VRAM keeps it in VRAM with STASHVRAM. The first dropdown
## **  runs ED.MENUPULL.SVSTART, which DIMs the handle table and runs ED.SV.INIT
## **  with ED.SV.MAX handles, 1 if ED.SV.MAX is 0. A program that uses STASHVRAM
## **  itself sets ED.SV.MAX, with a handle to spare for the menu, and runs
## **  GOSUB ED.MENUPULL.SVSTART rather than DIM the table: the compiler takes
## **  one DIM of an array, and it is here. ED.MENU.SAVE.BANK keeps it in bank ED.MENU.STASHBANK
## **  with ED.STASH. Set that before the first call to choose the bank; left at
## **  0, the first call takes one from ED.BANKMGR. If there is no room either
## **  way the dropdown still runs and the screen is not put back.
## **
## **  Requires MENU.INC.BL, STASH.INC.BL and STASHVRAM.INC.BL, included by
## **  the caller, and a #SYMFILE for ED.STASH.
## **
## ***********************************************************************
#IFNDEF ED.MENUPULL.DEFS
#DEFINE ED.MENUPULL.DEFS 1

#DEFINE ED.MENUPULL.SCRMODE $FF5F

#DEFINE ED.MENU.SAVE.VRAM 1
#DEFINE ED.MENU.SAVE.BANK 2

GOTO ED.MENUPULL.MODULE.END

ED.MENU.SAVESCREEN.BODY:
    GP.DEFPROC ED.MENU.SAVESCREEN, ED.MENU.SAVEMODE
    RETURN

## ---- ED.MENU.PULLSLOT run under bar item ED.MENU.PULLAT. ED.MENU.KEY comes in here
## ---- with a dropdown's slot.
ED.MENUPULL.OPEN:
    ED.MENU.CHOSEN = 0 : ED.MENU.EXITKEY = 0 : ED.MENU.NEXTBAR = 0
    IF ED.MENU.READY = 0 THEN RETURN
    ED.MENU.RUNSLOT = ED.MENU.BAR : GOSUB ED.MENU.MEASURE
    ED.MENU.BARNUM = ED.MENU.COUNT
    IF ED.MENU.PULLAT < 1 OR ED.MENU.PULLAT > ED.MENU.BARNUM THEN ED.MENU.SEL = 0 : RETURN
    IF MID$(ED.MENU.FLAG$(ED.MENU.BAR), ED.MENU.PULLAT, 1) <> "0" THEN ED.MENU.SEL = 0 : RETURN
    GOSUB ED.MENUPULL.MARK

    ED.MENU.RUNSLOT = ED.MENU.PULLSLOT : GOSUB ED.MENU.MEASURE
    IF ED.MENU.COUNT = 0 THEN ED.MENU.SEL = 0 : RETURN
    GOSUB ED.MENUPULL.PLACE
    GOSUB ED.MENUPULL.SAVE

    ED.MENU.BOXW = ED.MENU.WIDE : ED.MENU.BOXH = ED.MENU.COUNT
    GOSUB ED.MENU.FRAMEBOX
    GOSUB ED.MENUPULL.SHADE
    ED.MENU.RUNFLAGS = ED.MENU.FLAGS OR ED.MENU.KEYEXIT
    GOSUB ED.MENU.RUN

    GOSUB ED.MENUPULL.RESTORE
    IF ED.MENU.EXITKEY = ED.MENU.ENTER OR ED.MENU.HOTHIT <> 0 THEN ED.MENU.CHOSEN = ED.MENU.CUR
    IF ED.MENU.EXITKEY = ED.MENU.LEFT THEN ED.MENU.NEXTBAR = ED.MENU.LEFTOF
    IF ED.MENU.EXITKEY = ED.MENU.RIGHT THEN ED.MENU.NEXTBAR = ED.MENU.RIGHTOF
    RETURN

## ---- with the bar slot the one measured: the neighbours LEFT and RIGHT walk
## ---- to, then the old mark off and this item lit.
ED.MENUPULL.MARK:
    ED.MENU.ATCOL = ED.MENU.BARX : ED.MENU.ATROW = ED.MENU.BARY
    ED.MENU.RUNFLAGS = ED.MENU.BARFLAGS
    ED.MENU.STEP = -1 : GOSUB ED.MENUPULL.BESIDE
    ED.MENU.LEFTOF = ED.MENU.CUR
    ED.MENU.STEP = 1 : GOSUB ED.MENUPULL.BESIDE
    ED.MENU.RIGHTOF = ED.MENU.CUR
    GOSUB ED.MENU.LIGHT
    IF ED.MENU.MARKED > 0 AND ED.MENU.MARKED <> ED.MENU.PULLAT THEN ED.MENU.DRAWN = ED.MENU.MARKED : ED.MENU.PAINT = ED.MENU.PLAIN : GOSUB ED.MENU.DRAWROW
    ED.MENU.DRAWN = ED.MENU.PULLAT : ED.MENU.PAINT = ED.MENU.HILITE : GOSUB ED.MENU.DRAWROW
    ED.MENU.MARKED = ED.MENU.PULLAT
    ED.MENU.SELX = ED.MENU.DRAWX : ED.MENU.SELW = ED.MENU.ROWW
    RETURN

## ---- the marked bar item back in the bar's plain colours, and none marked.
ED.MENUPULL.UNMARK:
    IF ED.MENU.MARKED < 1 THEN RETURN
    ED.MENU.RUNSLOT = ED.MENU.BAR : GOSUB ED.MENU.MEASURE
    ED.MENU.ATCOL = ED.MENU.BARX : ED.MENU.ATROW = ED.MENU.BARY
    GOSUB ED.MENU.LIGHT
    ED.MENU.DRAWN = ED.MENU.MARKED : ED.MENU.PAINT = ED.MENU.PLAIN : GOSUB ED.MENU.DRAWROW
    ED.MENU.MARKED = 0
    RETURN

## ---- the live item beside ED.MENU.PULLAT the ED.MENU.STEP way; nowhere live to go
## ---- stays put.
ED.MENUPULL.BESIDE:
    ED.MENU.CUR = ED.MENU.PULLAT + ED.MENU.STEP
    IF ED.MENU.CUR < 1 THEN GOSUB ED.MENU.WRAPTOP
    IF ED.MENU.CUR > ED.MENU.COUNT THEN GOSUB ED.MENU.WRAPBOT
    GOSUB ED.MENU.SKIPOFF
    IF MID$(ED.MENU.FLAG$(ED.MENU.BAR), ED.MENU.CUR, 1) <> "0" THEN ED.MENU.CUR = ED.MENU.PULLAT
    RETURN

## ---- under the item, and pulled left to stay on screen. ED.MENU.EDGE is the frame.
ED.MENUPULL.PLACE:
    ED.MENU.RUNCOL = ED.MENU.SELX : ED.MENU.RUNROW = ED.MENU.BARY + 1
    ED.MENU.EDGE = 2
    IF ED.MENU.STYLE = ED.MENU.NOBOX THEN ED.MENU.EDGE = 0
    GP.CALL ED.MENUPULL.SCRMODE, 0, 0, 0, 1 : ED.MENU.COLS = GP.X : ED.MENU.ROWS = GP.Y
    IF ED.MENU.RUNCOL + ED.MENU.WIDE + ED.MENU.EDGE > ED.MENU.COLS THEN ED.MENU.RUNCOL = ED.MENU.COLS - ED.MENU.WIDE - ED.MENU.EDGE
    IF ED.MENU.RUNCOL < 0 THEN ED.MENU.RUNCOL = 0
    ED.MENU.SHW = 0 : ED.MENU.SHH = 0
    IF ED.MENU.SHADOW = 0 OR ED.MENU.EDGE = 0 THEN RETURN
    ED.MENU.SHW = ED.MENU.COLS - ED.MENU.RUNCOL - ED.MENU.WIDE - ED.MENU.EDGE
    IF ED.MENU.SHW > 2 THEN ED.MENU.SHW = 2
    IF ED.MENU.RUNROW + ED.MENU.COUNT + ED.MENU.EDGE < ED.MENU.ROWS THEN ED.MENU.SHH = 1
    RETURN

## ---- the shadow: two columns down the right from the second row, one row
## ---- under from the third column, so the box's corners stay clear.
ED.MENUPULL.SHADE:
    ED.MENU.BOXR = ED.MENU.RUNCOL + ED.MENU.WIDE + ED.MENU.EDGE
    ED.MENU.BOXB = ED.MENU.RUNROW + ED.MENU.COUNT + ED.MENU.EDGE
    IF ED.MENU.SHW > 0 THEN GP.FILL ED.MENU.BOXR, ED.MENU.RUNROW + 1, ED.MENU.SHW, ED.MENU.COUNT + ED.MENU.EDGE - 1, 32, ED.MENU.SHADOWATTR
    IF ED.MENU.SHH > 0 THEN GP.FILL ED.MENU.RUNCOL + 2, ED.MENU.BOXB, ED.MENU.WIDE + ED.MENU.EDGE + ED.MENU.SHW - 2, 1, 32, ED.MENU.SHADOWATTR
    RETURN

## ---- ED.MENU.STASHED is not 0 when there is something to put back: the
## ---- STASHVRAM handle, or -1 for the bank.
ED.MENUPULL.SAVE:
    ED.MENU.STASHED = 0
    IF ED.SV.READY = 0 THEN GOSUB ED.MENUPULL.SVSTART
    IF ED.SV.READY = 0 THEN RETURN
    ED.SV.X = ED.MENU.RUNCOL : ED.SV.Y = ED.MENU.RUNROW
    ED.SV.W = ED.MENU.WIDE + ED.MENU.EDGE + ED.MENU.SHW : ED.SV.H = ED.MENU.COUNT + ED.MENU.EDGE + ED.MENU.SHH
    GOSUB ED.SV.SAVE
    ED.MENU.STASHED = ED.SV.HND
    RETURN

## ---- once, and only when the program has not started STASHVRAM itself. A
## ---- refused ED.SV.INIT leaves ED.SV.READY 0 and nothing is saved from then on.
ED.MENUPULL.SVSTART:
    IF ED.MENU.SVTRIED <> 0 THEN RETURN
    ED.MENU.SVTRIED = -1
    IF ED.SV.MAX < 1 THEN ED.SV.MAX = 1
    DIM ED.SV.PAGE%(ED.SV.MAX) : DIM ED.SV.PAGES%(ED.SV.MAX)
    GOSUB ED.SV.INIT
    RETURN

ED.MENUPULL.RESTORE:
    IF ED.MENU.STASHED = 0 THEN RETURN
    ED.SV.HND = ED.MENU.STASHED : ED.SV.MOVE = 0
    GOSUB ED.SV.RESTORE
    GOSUB ED.SV.FREE
    RETURN

ED.MENUPULL.MODULE.END:
#ENDIF

REM ==========================================================================
REM MENUKEY.INC.BL -- forked, unbanked
REM ==========================================================================
## ***********************************************************************
## **
## **  MENUKEY.INC.BL -- a menu bar and its dropdowns, run from the
## **  program's own key loop.
## **
## **      GP.SUB ED.MENU.BEGIN, ED.MENU.BAR
## **      GP.SUB ED.MENU.ITEM, " &FILE "
## **      GP.SUB ED.MENU.ITEM, " &HELP "
## **      GP.SUB ED.MENU.BEGIN, ED.MENU.DROP + 1
## **      GP.SUB ED.MENU.ITEM, " &OPEN "
## **      GP.SUB ED.MENU.ITEM, " E&XIT "
## **      GP.SUB ED.MENU.BEGIN, ED.MENU.DROP + 2
## **      GP.SUB ED.MENU.ITEM, " &ABOUT "
## **      GOSUB ED.MENU.THEME
## **      GP.SUB ED.MENU.DRAWBAR, 0, 0, ED.MENU.NOBOX
## **      GOSUB ED.MENU.KEYS.ON
## **
## **      GET K$
## **      N = GP.FN(ED.MENU.KEY, ASC(K$))
## **      IF N > 0 THEN ON ED.MENU.PICKBAR GOSUB MY.FILE, MY.HELP
## **      IF N < 0 THEN GOSUB MY.KEY
## **
## **      GOSUB ED.MENU.KEYS.OFF                  before the program ends
## **
## **  N = GP.FN(ED.MENU.KEY, key)
## **      -1  not a menu key: the program's own
## **       0  the menu opened and was closed with nothing chosen
## **       n  row n of the dropdown under bar item ED.MENU.PICKBAR
## **
## **  ESC opens the dropdown under the first live bar item, and ALT with a
## **  bar item's hot key the one under that item. While one is open, LEFT
## **  and RIGHT walk the bar, a bar item's hot key that no row claims jumps
## **  to it, and ESC closes. Call ED.MENU.KEY straight after GET: it asks the
## **  KERNAL whether ALT is down while the key still is.
## **
## **  Call it with 0 when GET gave nothing. ALT pressed and let go with no
## **  key between then lights the first live bar item and opens no
## **  dropdown. LEFT and RIGHT walk the bar, RETURN, DOWN or a bar hot key
## **  opens the dropdown, and ESC or ALT again puts the bar back.
## **
## **  The bar is the one ED.MENU.DRAWBAR last drew. Every bar item needs a
## **  dropdown of one row or more. Each is framed in ED.MENU.DROPSTYLE, a
## **  ED.MENUTO.VERT style, 0 until set, and the screen under it is put back as
## **  ED.MENU.SAVESCREEN says. The bar item is lit while its dropdown is open
## **  and plain again after.
## **
## **  GOSUB ED.MENU.THEME     the menu colours from ED.THEME.CLR. The bar is BAR
## **                       and a dropdown TEXT; the lit row is HILITE, a hot
## **                       key BORDER's colour over the row's background, a
## **                       disabled row DIMMED's the same way, and the frame
## **                       TEXT. Run it again after a theme change, and set a
## **                       MENU colour after it to differ.
## **  GOSUB ED.MENU.KEYS.ON   makes ALT with a bar hot key type that key.
## **  GOSUB ED.MENU.KEYS.OFF  puts the keyboard layout back.
## **
## **  ALT KEYS NEED THE LAYOUT. ALT with a letter arrives as a graphic in
## **  PETSCII mode and as a symbol or nothing in ISO mode, so ED.MENU.KEYS.ON
## **  writes each bar hot key into both ALT keyboard tables, at the key that
## **  types that letter. Run it once the bar's items are in: until then
## **  ALT+letter types no letter, and GET has none to hand ED.MENU.KEY. The
## **  tables outlive the program: ED.MENU.KEYS.OFF puts every byte back and
## **  must run before it ends.
## **
## **  The layout is read under BANK 0, and BANK 0 is left selected for PEEK
## **  and POKE. So this file is not for a GP.BANKED region.
## **
## **  Requires MENU.INC.BL, MENUPULL.INC.BL and THEME.INC.BL.
## **
## ***********************************************************************
#IFNDEF ED.MENUKEY.DEFS
#DEFINE ED.MENUKEY.DEFS 1

## kbdbuf_get_modifiers. Below the $FF00 jump table, so KERNAL ROM is paged in.
#DEFINE ED.MENU.KBDMOD $FEC0
#DEFINE ED.MENU.MOD.ALT 2

## Eleven 128-byte layout tables in RAM bank 0, byte 0 of each its ID.
#DEFINE ED.MENU.KEYMAP $A000
#DEFINE ED.MENU.MAP.PET 0
#DEFINE ED.MENU.MAP.PETALT 2
#DEFINE ED.MENU.MAP.ISO 128
#DEFINE ED.MENU.MAP.ISOALT 198

GOTO ED.MENUKEY.MODULE.END

ED.MENU.KEY.BODY:
    GP.DEFPROC ED.MENU.KEY, ED.MENU.GOTKEY RETURNS ED.MENU.PICKED
    ED.MENU.PICKED = -1 : ED.MENU.PICKBAR = 0
    IF ED.MENU.READY = 0 THEN RETURN
    IF ED.MENU.KEYSSET = 0 THEN GOSUB ED.MENU.KEYS.ON
    ED.MENU.WALKAT = 0
    IF ED.MENU.GOTKEY = 0 THEN GOTO ED.MENU.IDLE
    ED.MENU.ALTDOWN = 0
    IF ED.MENU.GOTKEY = ED.MENU.ESC THEN ED.MENU.WALKAT = GP.INSTR(ED.MENU.FLAG$(ED.MENU.BAR), "0")
    IF ED.MENU.GOTKEY <> ED.MENU.ESC THEN GOSUB ED.MENU.ALTHIT
    IF ED.MENU.WALKAT = 0 THEN RETURN
    ED.MENU.PICKED = 0

## ---- one dropdown open. The key it hands back says where to go next.
ED.MENU.WALK:
    ED.MENU.PULLAT = ED.MENU.WALKAT : ED.MENU.PULLSLOT = ED.MENU.DROP + ED.MENU.WALKAT
    ED.MENU.STYLE = ED.MENU.DROPSTYLE
    GOSUB ED.MENUPULL.OPEN
    IF ED.MENU.CHOSEN > 0 THEN ED.MENU.PICKED = ED.MENU.CHOSEN : ED.MENU.PICKBAR = ED.MENU.WALKAT : GOTO ED.MENU.WALKED
    ED.MENU.WALKTO = ED.MENU.NEXTBAR
    IF ED.MENU.WALKTO = 0 THEN GOSUB ED.MENU.WALKKEY
    IF ED.MENU.WALKTO > 0 THEN ED.MENU.WALKAT = ED.MENU.WALKTO : GOTO ED.MENU.WALK
ED.MENU.WALKED:
    GOSUB ED.MENUPULL.UNMARK
    RETURN

## ---- ESC, or no dropdown to run, closes. A bar hot key jumps; any other key
## ---- opens the same dropdown again.
ED.MENU.WALKKEY:
    IF ED.MENU.EXITKEY = 0 OR ED.MENU.EXITKEY = ED.MENU.ESC OR ED.MENU.EXITKEY = ED.MENU.STOP THEN RETURN
    ED.MENU.WALKTO = GP.FN(ED.MENU.HOTROW, ED.MENU.BAR, ED.MENU.EXITKEY)
    IF ED.MENU.WALKTO = 0 THEN ED.MENU.WALKTO = ED.MENU.WALKAT
    RETURN

## ---- no key. ALT down and up again with no key between lights the bar.
ED.MENU.IDLE:
    GOSUB ED.MENU.ALTTAP
    IF ED.MENU.TAPPED = 0 THEN RETURN
    ED.MENU.WALKAT = GP.INSTR(ED.MENU.FLAG$(ED.MENU.BAR), "0")
    IF ED.MENU.WALKAT = 0 THEN RETURN
    ED.MENU.PICKED = 0

## ---- the bar lit and no dropdown open. LEFT and RIGHT walk it; RETURN, DOWN
## ---- or a bar hot key opens a dropdown; ESC or ALT again leaves.
ED.MENU.FOCUS:
    ED.MENU.PULLAT = ED.MENU.WALKAT
    ED.MENU.RUNSLOT = ED.MENU.BAR : GOSUB ED.MENU.MEASURE
    GOSUB ED.MENUPULL.MARK
ED.MENU.FOCUSKEY:
    GET ED.MENU.INKEY$
    IF ED.MENU.INKEY$ <> "" THEN GOTO ED.MENU.FOCUSGOT
    GOSUB ED.MENU.ALTTAP
    IF ED.MENU.TAPPED <> 0 THEN GOTO ED.MENU.WALKED
    GOTO ED.MENU.FOCUSKEY
ED.MENU.FOCUSGOT:
    ED.MENU.ALTDOWN = 0
    ED.MENU.CODE = ASC(ED.MENU.INKEY$)
    IF ED.MENU.CODE = ED.MENU.ESC OR ED.MENU.CODE = ED.MENU.STOP THEN GOTO ED.MENU.WALKED
    IF ED.MENU.CODE = ED.MENU.LEFT THEN ED.MENU.WALKAT = ED.MENU.LEFTOF : GOTO ED.MENU.FOCUS
    IF ED.MENU.CODE = ED.MENU.RIGHT THEN ED.MENU.WALKAT = ED.MENU.RIGHTOF : GOTO ED.MENU.FOCUS
    IF ED.MENU.CODE = ED.MENU.ENTER OR ED.MENU.CODE = ED.MENU.DOWN THEN GOTO ED.MENU.WALK
    ED.MENU.WALKTO = GP.FN(ED.MENU.HOTROW, ED.MENU.BAR, ED.MENU.CODE)
    IF ED.MENU.WALKTO > 0 THEN ED.MENU.WALKAT = ED.MENU.WALKTO : GOTO ED.MENU.WALK
    GOTO ED.MENU.FOCUSKEY

## ---- ED.MENU.TAPPED is -1 when ALT has come up since it was last seen down.
ED.MENU.ALTTAP:
    ED.MENU.TAPPED = 0
    GOSUB ED.MENU.MODSNOW
    IF (ED.MENU.MODS AND ED.MENU.MOD.ALT) <> 0 THEN ED.MENU.ALTDOWN = -1 : RETURN
    ED.MENU.TAPPED = ED.MENU.ALTDOWN : ED.MENU.ALTDOWN = 0
    RETURN

ED.MENU.MODSNOW:
    ED.MENU.ROMWAS = PEEK(1)
    POKE 1, 0 : GP.CALL ED.MENU.KBDMOD : ED.MENU.MODS = GP.A : POKE 1, ED.MENU.ROMWAS
    RETURN

## ---- asked of the KERNAL while the key is still down.
ED.MENU.ALTHIT:
    GOSUB ED.MENU.MODSNOW
    IF (ED.MENU.MODS AND ED.MENU.MOD.ALT) = 0 THEN RETURN
    ED.MENU.WALKAT = GP.FN(ED.MENU.HOTROW, ED.MENU.BAR, ED.MENU.GOTKEY)
    RETURN

ED.MENU.THEME:
    IF ED.THEME.READY = 0 THEN GOSUB ED.THEME.SELECT
    ED.MENU.BARATTR = ED.THEME.CLR(ED.THEME.BAR)
    ED.MENU.BARHI = ED.THEME.CLR(ED.THEME.HILITE)
    ED.MENU.BARHOT = (ED.MENU.BARATTR AND 240) + (ED.THEME.CLR(ED.THEME.BORDER) AND 15)
    ED.MENU.ATTR = ED.THEME.CLR(ED.THEME.TEXT)
    ED.MENU.HIATTR = ED.THEME.CLR(ED.THEME.HILITE)
    ED.MENU.HOTATTR = (ED.MENU.ATTR AND 240) + (ED.THEME.CLR(ED.THEME.BORDER) AND 15)
    ED.MENU.DISATTR = (ED.MENU.ATTR AND 240) + (ED.THEME.CLR(ED.THEME.DIMMED) AND 15)
    ED.MENU.SEPATTR = ED.MENU.ATTR
    RETURN

## ---- the plain table finds the key that types each letter, and the ALT
## ---- table at the same place is made to type it too, once for PETSCII and
## ---- once for ISO. Each byte written is kept for ED.MENU.KEYS.OFF, by its
## ---- offset from ED.MENU.KEYMAP.
ED.MENU.KEYS.ON:
    GOSUB ED.MENU.KEYS.OFF
    ED.MENU.KEYSSET = -1
    IF ED.MENU.KEYSDIM = 0 THEN DIM ED.MENU.ALTAT%(2 * ED.MENU.BAR.MAX + 1) : DIM ED.MENU.ALTWAS%(2 * ED.MENU.BAR.MAX + 1) : ED.MENU.KEYSDIM = -1
    BANK 0
    ED.MENU.TID = ED.MENU.MAP.PET : ED.MENU.TIDALT = ED.MENU.MAP.PETALT : ED.MENU.TCASE = 0
    GOSUB ED.MENU.KEYPAIR
    ED.MENU.TID = ED.MENU.MAP.ISO : ED.MENU.TIDALT = ED.MENU.MAP.ISOALT : ED.MENU.TCASE = 32
    GOSUB ED.MENU.KEYPAIR
    RETURN

## ---- PETSCII types a letter as 65-90, ISO as 97-122: ED.MENU.TCASE is the gap.
ED.MENU.KEYPAIR:
    ED.MENU.TPLAIN = 0 : ED.MENU.TALT = 0
    FOR ED.MENU.TI = 0 TO 10
        ED.MENU.TB = ED.MENU.KEYMAP + 128 * ED.MENU.TI
        IF PEEK(ED.MENU.TB) = ED.MENU.TID THEN ED.MENU.TPLAIN = ED.MENU.TB
        IF PEEK(ED.MENU.TB) = ED.MENU.TIDALT THEN ED.MENU.TALT = ED.MENU.TB
    NEXT ED.MENU.TI
    IF ED.MENU.TPLAIN = 0 OR ED.MENU.TALT = 0 THEN RETURN
    FOR ED.MENU.KI = 1 TO 127
        ED.MENU.LETTER = PEEK(ED.MENU.TPLAIN + ED.MENU.KI) - ED.MENU.TCASE
        IF ED.MENU.LETTER >= 65 AND ED.MENU.LETTER <= 90 THEN GOSUB ED.MENU.KEYSET
    NEXT ED.MENU.KI
    RETURN

ED.MENU.KEYSET:
    IF ED.MENU.NALT > 2 * ED.MENU.BAR.MAX + 1 THEN RETURN
    IF GP.FN(ED.MENU.HOTROW, ED.MENU.BAR, ED.MENU.LETTER) = 0 THEN RETURN
    ED.MENU.ALTAT%(ED.MENU.NALT) = ED.MENU.TALT - ED.MENU.KEYMAP + ED.MENU.KI
    ED.MENU.ALTWAS%(ED.MENU.NALT) = PEEK(ED.MENU.TALT + ED.MENU.KI)
    POKE ED.MENU.TALT + ED.MENU.KI, ED.MENU.LETTER
    ED.MENU.NALT = ED.MENU.NALT + 1
    RETURN

ED.MENU.KEYS.OFF:
    IF ED.MENU.NALT = 0 THEN RETURN
    BANK 0
    FOR ED.MENU.KI = 0 TO ED.MENU.NALT - 1
        POKE ED.MENU.KEYMAP + ED.MENU.ALTAT%(ED.MENU.KI), ED.MENU.ALTWAS%(ED.MENU.KI)
    NEXT ED.MENU.KI
    ED.MENU.NALT = 0
    RETURN

ED.MENUKEY.MODULE.END:
#ENDIF


GOTO ED.MENUS.END

ED.MENUS.SETUP:
  GP.SUB ED.MENU.SAVESCREEN, ED.MENU.SAVE.VRAM
  GOSUB ED.MENU.THEME
  GP.SUB ED.MENU.BEGIN, ED.MENU.BAR
  GP.SUB ED.MENU.ITEM, " &File "
  GP.SUB ED.MENU.ITEM, " &Search "
  GP.SUB ED.MENU.ITEM, " &Help "
  REM A hot key need not be the initial: Save and Save As both start with S, so the
  REM second takes its A. The leading space insets the text; the trailing one pads.
  GP.SUB ED.MENU.BEGIN, ED.MENU.DROP + 1
  GP.SUB ED.MENU.ITEM, " &New "
  GP.SUB ED.MENU.ITEM, " &Open... "
  GP.SUB ED.MENU.ITEM, " &Save "
  GP.SUB ED.MENU.ITEM, " Save &As... "
  GP.SUB ED.MENU.ITEM, " E&xit "
  GP.SUB ED.MENU.BEGIN, ED.MENU.DROP + 2
  GP.SUB ED.MENU.ITEM, " &Find... "
  GP.SUB ED.MENU.ITEM, " &Go to Line... "
  GP.SUB ED.MENU.BEGIN, ED.MENU.DROP + 3
  GP.SUB ED.MENU.ITEM, " &About "
  RETURN

REM ---- the titles, none lit. ED.RENDER.MENUBAR draws the band and filename around 
REM ---- them. Just the top line
ED.MENUS.DRAW.BAR:
  GP.SUB ED.MENU.DRAWBAR, 0, 0, ED.MENU.NOBOX
  RETURN

REM ---- every key comes here first. ED.MENUS.PICK is -1 when it was not a menu key.
ED.MENUS.KEY:
  ED.MENUS.PICK = GP.FN(ED.MENU.KEY, ED.KEY)
  IF ED.MENUS.PICK < 0 THEN RETURN
  ## 
  GOSUB ED.PLACE.CARET
  IF ED.MENUS.PICK > 0 THEN GOSUB ED.MENUS.DISPATCH
  RETURN

## ---- ED.CMD.* live in EDITOR.BASL, reached through the one global symbol table.
## --- Menu bar 1st, then calls drop down menu
ED.MENUS.DISPATCH:
  ON ED.MENU.PICKBAR GOSUB ED.DROPDOWN.FILE, ED.DROPDOWN.SEARCH, ED.CMD.ABOUT
  RETURN

## ---- File menu
ED.DROPDOWN.FILE:
  ON ED.MENUS.PICK GOSUB ED.CMD.NEW, ED.CMD.OPEN, ED.CMD.SAVE, ED.CMD.SAVEAS, ED.CMD.EXIT
  RETURN

## --- Search menu
ED.DROPDOWN.SEARCH:
  ON ED.MENUS.PICK GOSUB ED.CMD.FIND, ED.CMD.GOTO
  RETURN


## -----------------------------------------------------------
## -----------------------------------------------------------
## -----------------------------------------------------------
## -----------------------------------------------------------

ED.MENUS.END:
