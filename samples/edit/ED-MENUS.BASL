## ============================================================================
## ED-MENUS.BASL -- the editor's menu bar and its dropdowns.
##
## The menus themselves are the library's: MENU, MENUPULL and MENUKEY, #INCLUDEd from
## GPC-BASIC/ by EDIT.BASL, with MENU and MENUPULL in a RAM bank and their rows in a
## GP.BANKEDSTR text bank. This file is the editor's layer on top -- which titles there
## are, what is in each dropdown, and what a chosen row calls.
##
## MENUS.KEY sees each key first: ALT, or ALT+letter, opens the bar, and it hands back
## the row chosen.
## ============================================================================

## ==========================================================================
## THE EDITOR'S OWN BAR AND DROPDOWNS
##
## Three titles, each with a dropdown, built once at startup. ED.MENUS.KEY reads every key
## before the editor does, and ED.MENUS.DISPATCH turns a choice into an ED.CMD.* call in
## EDITOR.BASL, which the one global symbol table makes reachable.
## ==========================================================================
GOTO ED.MENUS.END

## ED.MENUS.SETUP -- build the bar and its three dropdowns. Called once, from ED.INIT.
ED.MENUS.SETUP:
  GP.SUB MENU.SAVESCREEN, MENU.SAVE.VRAM
  MENU.SHADOW = -1
  GOSUB MENU.THEME
  GP.SUB MENU.BEGIN, MENU.BAR
  GP.SUB MENU.ITEM, " &File "
  GP.SUB MENU.ITEM, " &Edit "
  GP.SUB MENU.ITEM, " &Search "
  GP.SUB MENU.ITEM, " &Help "
  ## A hot key need not be the initial: Save and Save As both start with S, so the second
  ## takes its A. The leading space insets the text; the trailing one pads.
  GP.SUB MENU.BEGIN, MENU.DROP + 1
  GP.SUB MENU.ITEM, " &New "
  GP.SUB MENU.ITEM, " &Open... "
  GP.SUB MENU.ITEM, " &Save "
  GP.SUB MENU.ITEM, " Save &As... "
  GP.SUB MENU.ITEM, " E&xit "
  ## The dropdown numbers are the bar's own order, so a menu added in the middle moves every
  ## one above it -- here and in ED.MENUS.DISPATCH, which reads the same order.
  GP.SUB MENU.BEGIN, MENU.DROP + 2
  GP.SUB MENU.ITEM, " &Undo "
  GP.SUB MENU.ITEM, " &Redo "
  GP.SUB MENU.BEGIN, MENU.DROP + 3
  GP.SUB MENU.ITEM, " &Find... "
  GP.SUB MENU.ITEM, " Find &Next "
  GP.SUB MENU.ITEM, " Find &Previous "
  GP.SUB MENU.ITEM, " &Replace... "
  GP.SUB MENU.ITEM, " &Go to Line... "
  GP.SUB MENU.BEGIN, MENU.DROP + 4
  GP.SUB MENU.ITEM, " &About "
  RETURN

## ED.MENUS.DRAW.BAR -- draw the titles, none lit. ED.RENDER.MENUBAR draws the band and the
## file name around them.
ED.MENUS.DRAW.BAR:
  GP.SUB MENU.DRAWBAR, 0, 0, MENU.NOBOX
  RETURN

## ED.MENUS.KEY -- every key comes here first.
##
##   in   ED.KEY         the key the editor read
##   out  ED.MENUS.PICK  -1 when the menus did not take the key, 0 when a menu opened
##                       and closed with nothing chosen, otherwise the row chosen
ED.MENUS.KEY:
  ED.MENUS.PICK = GP.FN(MENU.KEY, ED.KEY)
  IF ED.MENUS.PICK < 0 THEN RETURN
  ## The dropdown painted over the caret cell on its way out.
  GOSUB ED.PLACE.CARET
  IF ED.MENUS.PICK > 0 THEN GOSUB ED.MENUS.DISPATCH
  RETURN

## ED.MENUS.DISPATCH -- the bar item first, then the row inside its dropdown.
ED.MENUS.DISPATCH:
  ON MENU.PICKBAR GOSUB ED.DROPDOWN.FILE, ED.DROPDOWN.EDIT, ED.DROPDOWN.SEARCH, ED.CMD.ABOUT
  RETURN

## ED.DROPDOWN.FILE -- the File menu's rows.
ED.DROPDOWN.FILE:
  ON ED.MENUS.PICK GOSUB ED.CMD.NEW, ED.CMD.OPEN, ED.CMD.SAVE, ED.CMD.SAVEAS, ED.CMD.EXIT
  RETURN

## ED.DROPDOWN.EDIT -- the Edit menu's rows. Both live in ED-UNDO.BASL, which is #INCLUDEd
## at the foot of EDIT.BASL; a label is resolved wherever it is in the run, so the forward
## reference is fine. Its #DEFINEs are not, which is why the recording hooks call wrappers.
ED.DROPDOWN.EDIT:
  ON ED.MENUS.PICK GOSUB UNDO.CMD, UNDO.REDO.CMD
  RETURN

## ED.DROPDOWN.SEARCH -- the Search menu's rows.
ED.DROPDOWN.SEARCH:
  ON ED.MENUS.PICK GOSUB ED.CMD.FIND, ED.CMD.FINDNEXT, ED.CMD.FINDPREV, ED.CMD.REPLACE, ED.CMD.GOTO
  RETURN

ED.MENUS.END:
