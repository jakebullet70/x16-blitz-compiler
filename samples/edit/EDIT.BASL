#SAVEAS "@:EDIT.SRC.PRG"
#REM 0
#SYMFILE "@:EDIT.SRC.SYM"


#DEFINE ED.GUT.D 4
#DEFINE ED.GUT.W 6
#DEFINE ED.MSG.JIFFIES 180

#INCLUDE "GPB.INC.BL"
#INCLUDE "ED-FONT.BASL"
#INCLUDE "ED-MISC.BASL"
#INCLUDE "ED-MENUS.BASL"
#INCLUDE "ED-DIALOG.BASL"

REM ============================================================================
REM EDITOR.BASL -- GPC EDIT, an MS-DOS-EDIT-styled text / Markdown editor for the
REM Commander X16, written in BASLOAD and compiled by GPC.
REM
REM NOTHING GOES THROUGH THE KERNAL: every cell, text area and chrome alike, is written
REM straight into VERA's text map. The document lives in banked RAM behind the DOC.* layer,
REM ED-STORE.BASL, #INCLUDEd at the bottom; the menus are ED-MENUS.BASL's, at the top.
REM
REM IT TAKES NO LIBRARY CODE. Every module it once #INCLUDEd from GPC-BASIC was forked into
REM ED-MISC.BASL and ED-MENUS.BASL, re-prefixed ED.* and taken off the banks. GPB.INC.BL is
REM the one file still read from there, and that is the keyword list rather than code.
REM
REM BANKS: 1 the runtime's, 2-4 the line table, 13 up to the top of RAM the document arena.
REM Nothing else is claimed -- no code and no menu text is banked.
REM
ED.SCREEN.MODE = 1 : REM 1 = 80x30, 3 = 40x30 (see KERNAL screen_mode $FF5F)
ED.THEME.ID = 3 : REM the colour theme, see ED-MISC.BASL

GOSUB ED.INIT
DOC.FILE.NAME$ = "TEST.MD"
GOSUB DOC.LOADFILE
GOSUB ED.OPEN.DONE
GOSUB ED.RENDER.ALL
GOSUB ED.L0.ON

REM ---- main loop ----
REM
GP.DO
  GET ED.KEY$
  GP.IF ED.KEY$ <> "" THEN 
    ED.KEY = ASC(ED.KEY$) 
    ## --- check if menu key and deal with it
    GOSUB ED.MENUS.KEY : 
    IF ED.MENUS.PICK < 0 THEN GOSUB ED.DISPATCH.EDITING.KEY
  GP.ENDIF
GP.LOOP


ED.DISPATCH.EDITING.KEY:
  GP.SELECT ED.KEY
    GP.CASE 157 : GOSUB ED.MOVE.LEFT
    GP.CASE 29  : GOSUB ED.MOVE.RIGHT
    GP.CASE 145 : GOSUB ED.MOVE.UP
    GP.CASE 17  : GOSUB ED.MOVE.DOWN
    GP.CASE 19  : GOSUB ED.MOVE.HOME
    GP.CASE 4   : GOSUB ED.MOVE.END
    GP.CASE 130 : GOSUB ED.MOVE.PAGEUP
    GP.CASE 2   : GOSUB ED.MOVE.PAGEDOWN
    GP.CASE 13  : GOSUB ED.DO.ENTER
    GP.CASE 20  : GOSUB ED.DO.BACKSPACE
    GP.CASE 25  : GOSUB ED.DO.DELETE
    GP.CASE 148 : GOSUB ED.TOGGLE.INSERT
    GP.CASE 137 : GOSUB ED.CMD.SAVE
    GP.CASE 134 : GOSUB ED.FIND.NEXT
    GP.OTHER    : GOSUB ED.KEY.RANGE
  GP.ENDSEL
  RETURN

ED.KEY.RANGE:
  REM ASCII, because ED.INIT declares ISO encoding -- see the $0372 poke there. Under
  REM PETSCII this had to case-swap every letter.
  IF ED.KEY >= 32 AND ED.KEY <= 126 THEN GOSUB ED.DO.INSERT
  RETURN


ED.QUIT:
  GOSUB ED.SHADOW.PALETTE.OFF
  POKE 40761, 0 : POKE 40762, 0 : REM undo any hardware VSCROLL before returning to BASIC
  REM layer 0 off again
  POKE 40754, 0 : POKE 40755, 0 : POKE 40741, 0 : POKE 40745, PEEK(40745) AND 239
  GOSUB ED.MENU.KEYS.OFF : GOSUB ED.APPSYS.RESTORE
  PRINT CHR$(147);
  PRINT "BYE."
  END




REM ============================================================================
REM SETUP
REM ============================================================================
ED.INIT:
  GOSUB ED.APPSYS.STARTUP
  GOSUB ED.BANKMGR.INIT
  GOSUB DOC.INIT
  GOSUB ED.CLAIM.FIXED.BANKS
  GOSUB ED.THEME.SELECT
  ED.SV.MAX = 2 : REM the dropdown's stash and the dialog's, claimed on first use
  GOSUB ED.MENUS.SETUP
  GOSUB ED.CLAIM.ARENA.BANKS
  
  GP.CALL ED.APPSYS.SCRMODE, ED.SCREEN.MODE, 0, 0, 0 : REM carry CLEAR sets the mode
  GP.CALL ED.APPSYS.SETCHR, 3, 0, 0, 0 : REM charset 3, PET upper/lower
  PRINT CHR$(147);
  GOSUB ED.PETFONT : REM ...then re-index it so a VERA tile index IS a character code
  POKE 882, PEEK(882) OR 64
  GOSUB ED.GUI.SETUP : REM ...and tell MENU where the frame glyphs ended up
  GOSUB ED.SHADOW.PALETTE
  GP.CALL ED.APPSYS.SCRMODE, 0, 0, 0, 1
  SCREEN.COLS = GP.X : SCREEN.ROWS = GP.Y
  IF SCREEN.COLS < 20 THEN SCREEN.COLS = 80
  IF SCREEN.ROWS < 8 THEN SCREEN.ROWS = 60
  ED.TEXT.WIDTH  = SCREEN.COLS - ED.GUT.W
  ED.TEXT.BOTTOM = SCREEN.ROWS - 2
  ED.TEXT.ROWS   = SCREEN.ROWS - 2
  ED.ATTR.TEXT   = ED.THEME.CLR(ED.THEME.TEXT)
  ED.ATTR.CARET  = ED.THEME.CLR(ED.THEME.HILITE)
  ED.ASM.GATTR% = ED.THEME.CLR(ED.THEME.DIMMED) : REM the gutter, read by ED.ROW.STREAM
  ED.MAP.TOP = 0
  POKE 40761, 0 : POKE 40762, 0 : REM L1 never scrolls again -- see ED.LAYERS
  ED.MAP.CFG = PEEK(40756) : ED.MAP.HB = INT(ED.MAP.CFG / 64) : ED.MAP.H = 32
  IF ED.MAP.HB = 1 THEN ED.MAP.H = 64
  IF ED.MAP.HB = 2 THEN ED.MAP.H = 128
  IF ED.MAP.HB = 3 THEN ED.MAP.H = 256
  ED.MAP.MAXTOP = ED.MAP.H - SCREEN.ROWS
  ED.HW.OK = 0 : IF ED.MAP.MAXTOP >= 4 THEN ED.HW.OK = 1
  GOSUB ED.LAYERS
  REM ALT+letter types nothing until the keymap carries the bar's hot keys.
  GOSUB ED.MENU.KEYS.ON
  ED.MB.FORCE = 1 : REM the first ED.RENDER.MENUBAR draws; the dirty guard alone would skip it
  RETURN



REM ---- the fixed banks: the line table, and nothing else. No code and no menu text is
REM banked any more, so banks 5 to 12 are the arena's to take.
ED.CLAIM.FIXED.BANKS:
  FOR ED.BK = DOC.TABLE.BASE.BANK TO DOC.TABLE.BASE.BANK + DOC.TABLE.BANKS - 1
    ED.BANKMGR.SET.BANK = ED.BK
    GOSUB ED.BANKMGR.CLAIM
    IF ED.BANKMGR.OK = 0 THEN GOSUB ED.BANK.FAILED
  NEXT ED.BK
  RETURN



REM ---- the document arena: every bank from DOC.FIRST.BANK up to the first one it cannot
REM claim, the top of RAM when nobody else owns one.
ED.CLAIM.ARENA.BANKS:
  DOC.LAST.BANK = DOC.FIRST.BANK - 1
  ED.BANKMGR.SET.BANK = DOC.FIRST.BANK
  GOSUB ED.BANKMGR.CLAIM
  IF ED.BANKMGR.OK = 0 THEN GOSUB ED.BANK.FAILED
  GP.DO
    IF ED.BANKMGR.OK = 0 THEN GP.EXITDO
    DOC.LAST.BANK = ED.BANKMGR.SET.BANK
    ED.BANKMGR.SET.BANK = ED.BANKMGR.SET.BANK + 1
    GOSUB ED.BANKMGR.CLAIM
  GP.LOOP
  RETURN



REM ---- a claim failed: two owners name one bank. ED.BANKMGR.SET.BANK is the bank.
ED.BANK.FAILED:
  PRINT "BANK"; ED.BANKMGR.SET.BANK; "FAILED"
  END



REM VSCROLL moves a whole LAYER, so with one layer the bars slid with the document and had to
REM be redrawn every line. Layer 0 takes the document and scrolls alone; layer 1 keeps the
REM bars, the dropdown and the dialogs at fixed SCREEN rows. The seam was already there: every
REM GP command addresses layer 1 only.
ED.LAYERS:
  POKE 40741, 0 : REM DCSEL 0, or $9F29 is an FX register instead of DC_VIDEO
  REM L0: config and tilebase copied from L1, map at $00000, and the only scroll left.
  POKE 40749, PEEK(40756) : POKE 40750, 0 : POKE 40751, PEEK(40758)
  POKE 40754, 0 : POKE 40755, 0
  REM The dropdowns are saved in VRAM from ED.SV.BASE up, so that starts past this map.
  ED.MAP.W = 32 * 2 ^ INT((PEEK(40756) AND 48) / 16)
  ED.L0.END = ED.MAP.W * ED.MAP.H * 2
  ED.SV.BASE = $4000
  IF ED.L0.END > ED.SV.BASE THEN ED.SV.BASE = ED.L0.END
  GOSUB ED.CLEAR.OVERLAY
  RETURN



REM The shadow under a dropdown or a dialog is drawn on layer 1, where colour 0 is the
REM transparent index -- a shadow in it would show the document through untouched. So the
REM editor buys itself a black: palette entry 4 is purple, which no theme uses, and this
REM points it at black. The themes then ask for colour 4 and get a shadow that is really
REM black. The entry is read back first, and ED.QUIT puts it as it was.
ED.SHADOW.PALETTE:
  ED.PAL.LO = VPEEK(1, $FA08) : ED.PAL.HI = VPEEK(1, $FA09)
  VPOKE 1, $FA08, 0 : VPOKE 1, $FA09, 0
  RETURN

ED.SHADOW.PALETTE.OFF:
  VPOKE 1, $FA08, ED.PAL.LO : VPOKE 1, $FA09, ED.PAL.HI
  RETURN


REM Layer 0 is switched on AFTER the first full render, and is never cleared: VRAM comes up
REM with whatever was in it, but no row is ever visible before it is painted.
ED.L0.ON:
  POKE 40741, 0 : POKE 40745, PEEK(40745) OR 16 : REM DC_VIDEO bit 4
  RETURN

REM Layer 1's text region back to transparent. Attribute 0 is the transparent one.
REM
REM The two bar rows are not part of that region, and they are not left alone either. The
REM PRINT CHR$(147) up in ED.INIT clears the whole screen in the KERNAL's own white-on-blue,
REM and layer 1 is visible from that moment -- so the top and bottom rows stayed blue right
REM through DOC.LOADFILE, the slowest thing the editor ever does, until ED.RENDER.ALL
REM finally painted over them. Filling them with the bar attribute here means the bars come
REM up in the theme's colours and then fill with text, rather than changing colour under
REM the user.
ED.CLEAR.OVERLAY:
  GP.FILL 0, 1, SCREEN.COLS, ED.TEXT.ROWS, 32, 0
  GP.FILL 0, 0, SCREEN.COLS, 1, 32, ED.THEME.CLR(ED.THEME.BAR)
  GP.FILL 0, SCREEN.ROWS - 1, SCREEN.COLS, 1, 32, ED.THEME.CLR(ED.THEME.BAR)
  RETURN

ED.OPEN.DONE:
  ED.TOP.LINE = 0 : ED.LEFT.COL = 0 : ED.CUR.ROW = 0 :  ED.CUR.COL = 0 : ED.INSERT.MODE = 1 : ED.DOC.DIRTY = 0
  GOSUB ED.LOAD.LIVE
  RETURN




REM ============================================================================
REM LIVE LINE
REM ============================================================================
ED.LOAD.LIVE:
  LINE.INDEX = ED.CUR.ROW : GOSUB DOC.LOAD
  ED.CUR.LINE$ = LINE.TEXT$ : ED.CUR.DIRTY = 0
  RETURN

ED.COMMIT.LIVE:
  IF ED.CUR.DIRTY = 0 THEN RETURN
  LINE.TEXT$ = ED.CUR.LINE$ : LINE.INDEX = ED.CUR.ROW : GOSUB DOC.STORE
  ED.CUR.DIRTY = 0
  RETURN

ED.CLAMP.COL:
  IF ED.CUR.COL > LEN(ED.CUR.LINE$) THEN ED.CUR.COL = LEN(ED.CUR.LINE$)
  RETURN




REM ============================================================================
REM CURSOR MOVEMENT
REM ============================================================================
ED.MOVE.LEFT:
  IF ED.CUR.COL > 0 THEN ED.CUR.COL = ED.CUR.COL - 1 : GOSUB ED.CARET.REFRESH : RETURN
  IF ED.CUR.ROW = 0 THEN RETURN
  GOSUB ED.COMMIT.LIVE
  ED.CUR.ROW = ED.CUR.ROW - 1 :    GOSUB ED.LOAD.LIVE
  ED.CUR.COL = LEN(ED.CUR.LINE$) : GOSUB ED.CARET.REFRESH
  RETURN

ED.MOVE.RIGHT:
  IF ED.CUR.COL < LEN(ED.CUR.LINE$) THEN ED.CUR.COL = ED.CUR.COL + 1 : GOSUB ED.CARET.REFRESH : RETURN
  IF ED.CUR.ROW >= LINE.COUNT - 1 THEN RETURN
  GOSUB ED.COMMIT.LIVE
  ED.CUR.ROW = ED.CUR.ROW + 1 : GOSUB ED.LOAD.LIVE
  ED.CUR.COL = 0 : GOSUB ED.CARET.REFRESH
  RETURN

ED.MOVE.UP:
  IF ED.CUR.ROW = 0 THEN RETURN
  GOSUB ED.COMMIT.LIVE
  ED.CUR.ROW = ED.CUR.ROW - 1 : GOSUB ED.LOAD.LIVE : GOSUB ED.CLAMP.COL
  GOSUB ED.CARET.REFRESH
  RETURN

ED.MOVE.DOWN:
  IF ED.CUR.ROW >= LINE.COUNT - 1 THEN RETURN
  GOSUB ED.COMMIT.LIVE
  ED.CUR.ROW = ED.CUR.ROW + 1 : GOSUB ED.LOAD.LIVE : GOSUB ED.CLAMP.COL
  GOSUB ED.CARET.REFRESH
  RETURN

ED.MOVE.HOME:
  ED.CUR.COL = 0 : GOSUB ED.CARET.REFRESH
  RETURN

ED.MOVE.END:
  ED.CUR.COL = LEN(ED.CUR.LINE$) : GOSUB ED.CARET.REFRESH
  RETURN

ED.MOVE.PAGEUP:
  GOSUB ED.COMMIT.LIVE :  ED.CUR.ROW = ED.CUR.ROW - ED.TEXT.ROWS
  IF ED.CUR.ROW < 0 THEN ED.CUR.ROW = 0
  GOSUB ED.LOAD.LIVE : GOSUB ED.CLAMP.COL : GOSUB ED.CARET.REFRESH
  RETURN

ED.MOVE.PAGEDOWN:
  GOSUB ED.COMMIT.LIVE : ED.CUR.ROW = ED.CUR.ROW + ED.TEXT.ROWS
  IF ED.CUR.ROW > LINE.COUNT - 1 THEN ED.CUR.ROW = LINE.COUNT - 1
  GOSUB ED.LOAD.LIVE : GOSUB ED.CLAMP.COL : GOSUB ED.CARET.REFRESH
  RETURN



REM ============================================================================
REM EDITING
REM ============================================================================
ED.DO.INSERT:
  IF LEN(ED.CUR.LINE$) >= 250 THEN RETURN
  ED.CH$ = CHR$(ED.KEY)
  IF ED.INSERT.MODE = 0 AND ED.CUR.COL < LEN(ED.CUR.LINE$) THEN GOTO ED.INS.OVER
  ED.CUR.LINE$ = LEFT$(ED.CUR.LINE$, ED.CUR.COL) + ED.CH$ + MID$(ED.CUR.LINE$, ED.CUR.COL + 1, 250)
  GOTO ED.INS.DONE
ED.INS.OVER:
  ED.CUR.LINE$ = LEFT$(ED.CUR.LINE$, ED.CUR.COL) + ED.CH$ + MID$(ED.CUR.LINE$, ED.CUR.COL + 2, 250)
ED.INS.DONE:
  ED.CUR.COL = ED.CUR.COL + 1 : ED.CUR.DIRTY = 1 : ED.DOC.DIRTY = 1
  GOSUB ED.REFRESH.INTRA
  RETURN

ED.DO.BACKSPACE:
  IF ED.CUR.COL = 0 THEN GOTO ED.BS.JOIN
  ED.CUR.LINE$ = LEFT$(ED.CUR.LINE$, ED.CUR.COL - 1) + MID$(ED.CUR.LINE$, ED.CUR.COL + 1, 250)
  ED.CUR.COL = ED.CUR.COL - 1 : ED.CUR.DIRTY = 1 : ED.DOC.DIRTY = 1
  GOSUB ED.REFRESH.INTRA
  RETURN

ED.BS.JOIN:
  IF ED.CUR.ROW = 0 THEN RETURN
  LINE.INDEX = ED.CUR.ROW - 1 : GOSUB DOC.LOAD
  ED.JOIN.COL = LEN(LINE.TEXT$) : ED.CUR.LINE$ = LEFT$(LINE.TEXT$ + ED.CUR.LINE$, 250)
  LINE.TEXT$ = ED.CUR.LINE$ : LINE.INDEX = ED.CUR.ROW - 1 : GOSUB DOC.STORE
  LINE.INDEX = ED.CUR.ROW : GOSUB DOC.DELETE.SLOT
  ED.CUR.ROW = ED.CUR.ROW - 1 : ED.CUR.COL = ED.JOIN.COL
  ED.CUR.DIRTY = 0 : ED.DOC.DIRTY = 1  : GOSUB ED.REFRESH.FULL
  RETURN

ED.DO.DELETE:
  IF ED.CUR.COL < LEN(ED.CUR.LINE$) THEN GOTO ED.DEL.CHAR
  IF ED.CUR.ROW >= LINE.COUNT - 1 THEN RETURN
  LINE.INDEX = ED.CUR.ROW + 1 : GOSUB DOC.LOAD
  ED.CUR.LINE$ = LEFT$(ED.CUR.LINE$ + LINE.TEXT$, 250)
  LINE.TEXT$ = ED.CUR.LINE$ : LINE.INDEX = ED.CUR.ROW : GOSUB DOC.STORE
  LINE.INDEX = ED.CUR.ROW + 1 : GOSUB DOC.DELETE.SLOT
  ED.CUR.DIRTY = 0 : ED.DOC.DIRTY = 1 : GOSUB ED.REFRESH.FULL
  RETURN
  
ED.DEL.CHAR:
  ED.CUR.LINE$ = LEFT$(ED.CUR.LINE$, ED.CUR.COL) + MID$(ED.CUR.LINE$, ED.CUR.COL + 2, 250)
  ED.CUR.DIRTY = 1 : ED.DOC.DIRTY = 1 : GOSUB ED.REFRESH.INTRA
  RETURN

ED.DO.ENTER:
  ED.LEFT.HALF$ = LEFT$(ED.CUR.LINE$, ED.CUR.COL)
  ED.RIGHT.HALF$ = MID$(ED.CUR.LINE$, ED.CUR.COL + 1, 250)
  LINE.TEXT$ = ED.LEFT.HALF$ : LINE.INDEX = ED.CUR.ROW : GOSUB DOC.STORE
  LINE.INDEX = ED.CUR.ROW + 1 : GOSUB DOC.INSERT.SLOT
  LINE.TEXT$ = ED.RIGHT.HALF$ : LINE.INDEX = ED.CUR.ROW + 1 : GOSUB DOC.STORE
  ED.CUR.ROW = ED.CUR.ROW + 1 : ED.CUR.COL = 0
  ED.CUR.LINE$ = ED.RIGHT.HALF$ : ED.CUR.DIRTY = 0 : ED.DOC.DIRTY = 1
  GOSUB ED.REFRESH.FULL
  RETURN

ED.TOGGLE.INSERT:
  ED.INSERT.MODE = 1 - ED.INSERT.MODE : GOSUB ED.RENDER.STATUS
  RETURN






REM ============================================================================
REM COMMANDS
REM ============================================================================
ED.CMD.NEW:
  GOSUB ED.CONFIRM.DISCARD
  IF ED.DISCARD.OK = 0 THEN GOSUB ED.REFRESH.FULL : RETURN
  GOSUB DOC.INIT
  LINE.TEXT$ = "" : LINE.INDEX = 0 : GOSUB DOC.STORE : LINE.COUNT = 1
  DOC.FILE.NAME$ = "UNTITLED" : ED.MB.FORCE = 1
  GOSUB ED.OPEN.DONE : GOSUB ED.REFRESH.FULL
  RETURN

ED.OPEN.FILE:
  ED.MB.FORCE = 1 : REM the bar carries the name, which the numeric guard cannot see
  GOSUB DOC.LOADFILE
  IF LINE.COUNT = 0 THEN LINE.TEXT$ = "" : LINE.INDEX = 0 : GOSUB DOC.STORE : LINE.COUNT = 1
  GOSUB ED.OPEN.DONE : GOSUB ED.REFRESH.FULL
  RETURN

ED.CMD.OPEN:
  GOSUB ED.CONFIRM.DISCARD
  IF ED.DISCARD.OK = 0 THEN GOSUB ED.REFRESH.FULL : RETURN
  ED.PROMPT.TITLE$ = "Open" : ED.PROMPT.MSG$ = "File name:" : GOSUB ED.PROMPT
  IF ED.PROMPT.OK = 0 THEN GOSUB ED.REFRESH.FULL : RETURN
  DOC.FILE.NAME$ = ED.INPUT$
  GOSUB ED.OPEN.FILE
  RETURN

ED.SAVE.FILE:
  GOSUB ED.COMMIT.LIVE : GOSUB DOC.SAVEFILE : ED.DOC.DIRTY = 0
  RETURN

ED.CMD.SAVE:
  IF DOC.FILE.NAME$ = "UNTITLED" THEN GOSUB ED.CMD.SAVEAS : RETURN
  GOSUB ED.SAVE.FILE : GOSUB ED.REFRESH.FULL
  ED.MSG$ = "Saved " + DOC.FILE.NAME$ : GOSUB ED.INFO.MSG
  RETURN

ED.CMD.SAVEAS:
  ED.SAVEAS.START$ = DOC.FILE.NAME$ : IF DOC.FILE.NAME$ = "UNTITLED" THEN ED.SAVEAS.START$ = ""
  ED.PROMPT.TITLE$ = "Save as" : ED.PROMPT.MSG$ = "File name:" : ED.PROMPT.TEXT$ = ED.SAVEAS.START$ : GOSUB ED.PROMPT
  IF ED.PROMPT.OK = 0 THEN GOSUB ED.REFRESH.FULL : RETURN
  DOC.FILE.NAME$ = ED.INPUT$ : ED.MB.FORCE = 1
  GOSUB ED.SAVE.FILE : GOSUB ED.REFRESH.FULL
  ED.MSG$ = "Saved " + DOC.FILE.NAME$ : GOSUB ED.INFO.MSG
  RETURN

ED.CMD.EXIT:
  IF ED.DOC.DIRTY = 0 THEN GOTO ED.CMD.EXIT.GO
  ED.PROMPT.TITLE$ = "Exit" : ED.PROMPT.MSG$ = "Discard changes?" : GOSUB ED.PROMPT.YN
  IF ED.YN = 0 THEN GOSUB ED.REFRESH.FULL : RETURN
ED.CMD.EXIT.GO:
  GOTO ED.QUIT
REM ---- Help > About: a box rather than the status line, because it now carries the
REM editor's memory readout as well as its name. The two questions asked at this point --
REM what is this, and how much room is left -- are the same visit.
REM
REM EVERY NUMBER IS READ LIVE. FRE(0) is the STRING HEAP and not much else -- the p-code,
REM the workspace and the arrays are all fixed at compile or DIM time, so the heap is the
REM only low memory that moves. It only ever falls: a block a string outgrows is flagged
REM dead and re-fitted, never given back. The rest of the figures come off the bump
REM allocator in ED-STORE.BASL -- DOC.CUR.BANK and DOC.CUR.PTR are its high-water mark,
REM DOC.FIRST.BANK to DOC.LAST.BANK is what BANKMGR handed over.
REM
REM The strings are all built into ED.DLG.S$, one at a time. A separate variable per line
REM would leave eight buffers spoken for at their peak length for the rest of the run.
ED.CMD.ABOUT:
  ED.AB.PER = DOC.WIN.END - DOC.WIN.START : REM usable bytes in one arena bank
  ED.AB.BANKS = DOC.LAST.BANK - DOC.FIRST.BANK + 1
  ED.AB.USED = (DOC.CUR.BANK - DOC.FIRST.BANK) * ED.AB.PER + DOC.CUR.PTR - DOC.WIN.START
  ED.AB.TOT = ED.AB.BANKS * ED.AB.PER
  ED.AB.PCT = 0 : IF ED.AB.TOT > 0 THEN ED.AB.PCT = INT(ED.AB.USED * 100 / ED.AB.TOT)

  REM 46 wide because the Document line is the longest thing here: a full 240-bank arena
  REM puts four digits on both figures, and ED.DLG.SAY truncates rather than wraps.
  REM 12 deep because rows 0 and 11 are left empty, so the text is not up against the frame
  REM top and bottom -- which puts the title on row 1 and the hint on row 10.
  ED.DLG.TITLE$ = "About" : ED.DLG.W = 46 : ED.DLG.H = 12
  GOSUB ED.DLG.OPEN

  ED.DLG.SX = 1 : ED.DLG.SY = 1 : ED.DLG.SATTR = ED.DLG.TITLEATTR
  ED.DLG.S$ = "GPC EDIT -- a text / Markdown editor" : GOSUB ED.DLG.SAY
  ED.DLG.SY = 2 : ED.DLG.SATTR = ED.DLG.TEXTATTR
  ED.DLG.S$ = "for the Commander X16" : GOSUB ED.DLG.SAY

  ED.DLG.SY = 4
  ED.DLG.S$ = "String heap   " + MID$(STR$(FRE(0)), 2) + " bytes free"
  GOSUB ED.DLG.SAY
  ED.DLG.SY = 5
  ED.DLG.S$ = "Document      " + MID$(STR$(INT(ED.AB.USED / 1024)), 2) + "K used, " + MID$(STR$(INT((ED.AB.TOT - ED.AB.USED) / 1024)), 2) + "K free  (" + MID$(STR$(ED.AB.PCT), 2) + "%)"
  GOSUB ED.DLG.SAY
  ED.DLG.SY = 6
  ED.DLG.S$ = "Lines         " + MID$(STR$(LINE.COUNT), 2)
  IF DOC.FULL <> 0 THEN ED.DLG.S$ = ED.DLG.S$ + "   DOCUMENT FULL"
  GOSUB ED.DLG.SAY

  ED.DLG.SY = 7
  ED.DLG.S$ = "Arena banks   " + MID$(STR$(DOC.FIRST.BANK), 2) + "-" + MID$(STR$(DOC.LAST.BANK), 2) + " (" + MID$(STR$(ED.AB.BANKS), 2) + " x 8K)"
  GOSUB ED.DLG.SAY
  ED.DLG.SY = 8
  ED.DLG.S$ = "Table banks   " + MID$(STR$(DOC.TABLE.BASE.BANK), 2) + "-" + MID$(STR$(DOC.TABLE.BASE.BANK + DOC.TABLE.BANKS - 1), 2) + "    Machine has " + MID$(STR$(ED.BANKMGR.BANKS), 2)
  GOSUB ED.DLG.SAY

  REM Centred on the box rather than set at a fixed column, so it stays centred if the
  REM width is ever changed. ED.DLG.SAY reads SX and S$, so the order of the two is free.
  ED.DLG.SY = 10 : ED.DLG.SATTR = ED.DLG.HINTATTR
  ED.DLG.S$ = "Press any key"
  ED.DLG.SX = INT((ED.DLG.W - LEN(ED.DLG.S$)) / 2)
  GOSUB ED.DLG.SAY

  GOSUB ED.DLG.WAITKEY
  GOSUB ED.DLG.CLOSE
  RETURN

ED.CONFIRM.DISCARD:
  ED.DISCARD.OK = -1
  IF ED.DOC.DIRTY = 0 THEN RETURN
  ED.PROMPT.TITLE$ = "Discard changes" : ED.PROMPT.MSG$ = "The document has changed. Discard it?" : GOSUB ED.PROMPT.YN
  ED.DISCARD.OK = ED.YN
  RETURN

ED.CMD.FIND:
  ED.PROMPT.TITLE$ = "Find" : ED.PROMPT.MSG$ = "Find text:" : ED.PROMPT.TEXT$ = ED.FIND$ : GOSUB ED.PROMPT
  IF ED.PROMPT.OK = 0 THEN GOSUB ED.REFRESH.FULL : RETURN
  ED.FIND$ = ED.INPUT$ : GOSUB ED.FIND.NEXT
  RETURN

ED.CMD.GOTO:
  ED.PROMPT.TITLE$ = "Go to line" : ED.PROMPT.MSG$ = "Line number:" : GOSUB ED.PROMPT
  IF ED.PROMPT.OK = 0 THEN GOSUB ED.REFRESH.FULL : RETURN
  ED.GOTO.N = VAL(ED.INPUT$)
  IF ED.GOTO.N < 1 THEN ED.GOTO.N = 1
  IF ED.GOTO.N > LINE.COUNT THEN ED.GOTO.N = LINE.COUNT
  GOSUB ED.COMMIT.LIVE
  ED.CUR.ROW = ED.GOTO.N - 1 : ED.CUR.COL = 0
  GOSUB ED.LOAD.LIVE : GOSUB ED.REFRESH.FULL
  ED.MSG$ = "Line " + MID$(STR$(ED.GOTO.N), 2) : GOSUB ED.INFO.MSG
  RETURN

REM ---- forward, wrapping, case-insensitive substring search for ED.FIND$ ----
REM A CASE-BLIND SEARCH THAT ALLOCATES NOTHING. Folding the needle and every line into new
REM strings cost 579 measured bytes of workspace per search, owned for the rest of the run,
REM and that is what the dialogs later ran out of. The fold now happens IN PLACE through
REM GP.STRPTR and the search is GP.INSTR. LINE.TEXT$ is the scratch copy DOC.LOAD already
REM makes, so upper-casing it harms nothing.
ED.FIND.NEXT:
  IF LEN(ED.FIND$) = 0 THEN RETURN
  REM The needle is folded on a COPY: ED.FIND$ is what both messages below print back.
  ED.NEEDLE$ = ED.FIND$
  ED.STRCASE.PTR = GP.STRPTR(ED.NEEDLE$) : ED.STRCASE.MODE = ED.STRCASE.UPPER : GOSUB ED.STRCASE.GO
  GOSUB ED.COMMIT.LIVE
  ED.FR = ED.CUR.ROW : ED.FROM = ED.CUR.COL + 2 : ED.SCANNED = 0
ED.FN.LOOP:
  IF ED.SCANNED > LINE.COUNT THEN GOTO ED.FN.NONE
  LINE.INDEX = ED.FR : GOSUB DOC.LOAD
  ED.STRCASE.PTR = GP.STRPTR(LINE.TEXT$) : GOSUB ED.STRCASE.GO : REM MODE is sticky, set above
  ED.FOUND.AT = GP.INSTR(LINE.TEXT$, ED.NEEDLE$, ED.FROM)
  IF ED.FOUND.AT > 0 THEN GOTO ED.FN.HIT
  ED.FR = ED.FR + 1
  IF ED.FR > LINE.COUNT - 1 THEN ED.FR = 0
  ED.FROM = 1 : ED.SCANNED = ED.SCANNED + 1
  GOTO ED.FN.LOOP
ED.FN.HIT:
  ED.CUR.ROW = ED.FR : ED.CUR.COL = ED.FOUND.AT - 1
  GOSUB ED.LOAD.LIVE : GOSUB ED.REFRESH.FULL
  ED.MSG$ = "Found: " + ED.FIND$ : GOSUB ED.INFO.MSG
  RETURN

ED.FN.NONE:
  ED.MSG$ = "Not found: " + ED.FIND$ : GOSUB ED.ERR.MSG
  RETURN






REM ============================================================================
REM PROMPTS
REM ============================================================================
REM Both are now the one popup box, ED-DIALOG.BASL: it saves the screen under itself and
REM puts it back, so a prompt costs no repaint. The interface is unchanged -- ED.PROMPT.MSG$
REM in, plus ED.PROMPT.TITLE$ for the caption and ED.PROMPT.TEXT$ for what the field starts
REM with, and ED.INPUT$ plus ED.PROMPT.OK, or ED.YN, out.

ED.PROMPT:
  ED.DLG.TITLE$ = ED.PROMPT.TITLE$
  ED.DLG.PROMPT$ = ED.PROMPT.MSG$
  ED.DLG.TEXT$ = ED.PROMPT.TEXT$
  ED.DLG.MAX = 0 : REM the dialog's own default, wide enough for a path
  GOSUB ED.DLG.ASK
  ED.INPUT$ = ED.DLG.INPUT$
  ED.PROMPT.OK = ED.DLG.OK
  REM The starting text is per call: a Find that remembers its needle must not hand the
  REM same one to the next Save As.
  ED.PROMPT.TEXT$ = ""
  RETURN

ED.PROMPT.YN:
  ED.DLG.TITLE$ = ED.PROMPT.TITLE$
  ED.DLG.MSG$ = ED.PROMPT.MSG$
  GOSUB ED.DLG.YN
  ED.YN = ED.DLG.YES
  RETURN






REM ============================================================================
REM MESSAGES
REM ============================================================================
REM A message takes over the status line for ED.MSG.JIFFIES and then the status line comes
REM back, so the editor never sits showing a stale "Saved" or "Not found". Keys struck during
REM the hold stay in the keyboard buffer and are read as usual once the status line returns.
ED.INFO.MSG:
  ED.PS.ROW = SCREEN.ROWS - 1 : ED.PS.COL = 0 : ED.PS.WIDTH = SCREEN.COLS
  ED.PS$ = " " + ED.MSG$ : ED.PS.ATTR = ED.THEME.CLR(ED.THEME.BAR) : GOSUB ED.PUT.FIELD
  GOSUB ED.MSG.HOLD
  RETURN

ED.ERR.MSG:
  ED.PS.ROW = SCREEN.ROWS - 1 : ED.PS.COL = 0 : ED.PS.WIDTH = SCREEN.COLS
  ED.PS$ = " " + ED.MSG$ : ED.PS.ATTR = ED.THEME.CLR(ED.THEME.WARN) : GOSUB ED.PUT.FIELD
  GOSUB ED.MSG.HOLD
  RETURN

REM ---- hold the message on screen, then put the status line back ----
REM TI counts jiffies, 60 to the second, and it is read rather than counted down a loop so
REM the wait is the same length whatever the machine is doing. TI rolls over to 0 at
REM midnight: the elapsed count then goes negative, which ends the wait early rather than
REM leaving the editor stuck for the best part of a day.
REM
REM The keyboard is drained on the way out. Three seconds is long enough to type into, and
REM a held arrow repeats through the whole hold: without the drain those keys all arrive at
REM once the moment the main loop starts reading again. GET hands back "" on an empty
REM buffer, so the drain stops at the first empty read.
ED.MSG.HOLD:
  ED.MSG.T0 = TI
ED.MSG.HOLD.WAIT:
  ED.MSG.EL = TI - ED.MSG.T0
  IF ED.MSG.EL >= 0 AND ED.MSG.EL < ED.MSG.JIFFIES THEN GOTO ED.MSG.HOLD.WAIT
  GOSUB ED.RENDER.STATUS
ED.MSG.HOLD.DRAIN:
  GET ED.MSG.K$
  IF ED.MSG.K$ <> "" THEN GOTO ED.MSG.HOLD.DRAIN
  RETURN






REM ============================================================================
REM RENDERING
REM ============================================================================
ED.REFRESH.FULL:
  GOSUB ED.ENSURE.VISIBLE : GOSUB ED.RENDER.ALL
  RETURN
ED.REFRESH.INTRA:
  GOSUB ED.ENSURE.VISIBLE
  IF ED.SCROLLED = 1 THEN GOSUB ED.DO.SCROLL : RETURN
  ED.SCREEN.ROW = ED.CUR.ROW - ED.TOP.LINE + 1 : ED.DOC.LINE = ED.CUR.ROW
  GOSUB ED.RENDER.ROW: GOSUB ED.PLACE.CARET : GOSUB ED.RENDER.STATUS
  RETURN

REM Cheap cursor move: restore the old caret cell, invert the new one, repaint the status
REM line -- about 2 cells, not a screen. Only an actual scroll falls back to a full repaint.
ED.CARET.REFRESH:
  GOSUB ED.UNCARET : GOSUB ED.ENSURE.VISIBLE
  IF ED.SCROLLED = 1 THEN GOSUB ED.DO.SCROLL : RETURN
  GOSUB ED.PLACE.CARET : GOSUB ED.RENDER.STATUS
  RETURN

ED.ENSURE.VISIBLE:
  ED.SCROLLED = 0 : ED.HSCROLLED = 0 : ED.EV.OLDTOP = ED.TOP.LINE
  IF ED.CUR.ROW < ED.TOP.LINE THEN ED.TOP.LINE = ED.CUR.ROW
  IF ED.CUR.ROW > ED.TOP.LINE + ED.TEXT.ROWS - 1 THEN ED.TOP.LINE = ED.CUR.ROW - ED.TEXT.ROWS + 1
  IF ED.CUR.COL < ED.LEFT.COL THEN ED.LEFT.COL = ED.CUR.COL : ED.HSCROLLED = 1
  IF ED.CUR.COL > ED.LEFT.COL + ED.TEXT.WIDTH - 1 THEN ED.LEFT.COL = ED.CUR.COL - ED.TEXT.WIDTH + 1 : ED.HSCROLLED = 1
  ED.VDELTA = ED.TOP.LINE - ED.EV.OLDTOP
  IF ED.VDELTA <> 0 THEN ED.SCROLLED = 1
  IF ED.HSCROLLED = 1 THEN ED.SCROLLED = 1
  RETURN

REM A one-row move is served by VERA: bump L0_VSCROLL and paint the ONE newly-exposed row.
REM The bars are on layer 1 and did not move. Anything else -- a multi-line jump, any
REM horizontal scroll -- is a full repaint at the current map offset.
ED.DO.SCROLL:
  IF ED.HW.OK = 0 THEN GOSUB ED.RENDER.ALL : RETURN
  IF ED.HSCROLLED = 1 THEN GOSUB ED.RENDER.ALL : RETURN
  IF ED.VDELTA = 1 THEN GOSUB ED.HW.SCROLL.DOWN : RETURN
  IF ED.VDELTA = 0 - 1 THEN GOSUB ED.HW.SCROLL.UP : RETURN
  GOSUB ED.RENDER.ALL
  RETURN

REM scroll down one line: content slides up, a new line appears at the bottom text row.
ED.HW.SCROLL.DOWN:
  ED.MAP.TOP = ED.MAP.TOP + 1
  IF ED.MAP.TOP > ED.MAP.MAXTOP THEN ED.MAP.TOP = 0 : GOSUB ED.SET.VSCROLL : GOSUB ED.RENDER.ALL : RETURN
  GOSUB ED.SET.VSCROLL
  ED.SCREEN.ROW = ED.TEXT.BOTTOM : ED.DOC.LINE = ED.TOP.LINE + ED.SCREEN.ROW - 1 : GOSUB ED.RENDER.ROW
  GOSUB ED.RENDER.STATUS : GOSUB ED.PLACE.CARET
  RETURN

REM scroll up one line: content slides down, a new line appears at the top text row (1).
ED.HW.SCROLL.UP:
  ED.MAP.TOP = ED.MAP.TOP - 1
  IF ED.MAP.TOP < 0 THEN ED.MAP.TOP = ED.MAP.MAXTOP : GOSUB ED.SET.VSCROLL : GOSUB ED.RENDER.ALL : RETURN
  GOSUB ED.SET.VSCROLL
  ED.SCREEN.ROW = 1 : ED.DOC.LINE = ED.TOP.LINE + ED.SCREEN.ROW - 1 : GOSUB ED.RENDER.ROW
  GOSUB ED.RENDER.STATUS : GOSUB ED.PLACE.CARET
  RETURN

ED.SET.VSCROLL:
  ED.VSP = ED.MAP.TOP * 8
  POKE 40754, ED.VSP - INT(ED.VSP / 256) * 256 : REM $9F32 L0 VSCROLL (7:0)
  POKE 40755, INT(ED.VSP / 256)                : REM $9F33 L0 VSCROLL (11:8)
  RETURN

ED.RENDER.ALL:
  GOSUB ED.RENDER.MENUBAR
  FOR ED.SCREEN.ROW = 1 TO ED.TEXT.BOTTOM
    ED.DOC.LINE = ED.TOP.LINE + ED.SCREEN.ROW - 1
    GOSUB ED.RENDER.ROW
  NEXT ED.SCREEN.ROW
  GOSUB ED.RENDER.STATUS : GOSUB ED.PLACE.CARET
  RETURN





REM Rows render through ONE inline-assembly block: VERA setup, the cell loop, teardown.
REM
REM WHY ASSEMBLY. The VERA path was already the fast one; the loop around it was the cost --
REM two POKEs a cell, each a push / dispatch / bank-save-restore through the p-code VM, about
REM 800 cycles a cell against the ~20 the same compare-load-store takes native.
REM
REM THE VERA METHOD IS UNCHANGED. FX 32-bit cache write: one DATA0 write flushes 4 VRAM bytes
REM = 2 cells [char,attr,char,attr]. Every cell in a row shares an attribute, so the two attr
REM slots are loaded ONCE and the loop writes only the two char slots plus a flush. Increment
REM +4 walks two cells a flush, and ED.TEXT.WIDTH is even.
REM FX regs: $9F25 CTRL bits 6:1 = DCSEL; DCSEL 2 -> FX_CTRL $9F29 bit 6 cache-write-enable;
REM DCSEL 6 -> FX_CACHE L/M/H/U $9F29-2C = [char0, attr0, char1, attr1].
REM
REM THE SOURCE IS ONE OF THREE THINGS, and ED.ASM.MODE% tells the block which:
REM   a stored line    MODE 0, ED.ASM.SRC% is its address in the $A000 window (BANK is set)
REM   the edited line  MODE 1, read out of ED.CUR.LINE$ past its 3-byte header
REM   past the end     MODE 0 with ED.ASM.VIS% = 0 -- every cell a space, source never read
ED.RENDER.ROW:
  REM The gutter's four digits, written by the block below in the SAME VERA pass as the
  REM text -- see ED.ROW.STREAM. Blank past the end of the document, and leading zeros
  REM blank because a digit that is never computed stays a space. 48 is "0".
  ED.GD0% = 32 : ED.GD1% = 32 : ED.GD2% = 32 : ED.GD3% = 32
  IF ED.DOC.LINE >= LINE.COUNT THEN GOTO ED.ROW.GEOM
  ED.GN = ED.DOC.LINE + 1
  ED.GT = INT(ED.GN / 10) : ED.GD3% = 48 + ED.GN - ED.GT * 10 : ED.GN = ED.GT
  IF ED.GN > 0 THEN ED.GT = INT(ED.GN / 10) : ED.GD2% = 48 + ED.GN - ED.GT * 10 : ED.GN = ED.GT
  IF ED.GN > 0 THEN ED.GT = INT(ED.GN / 10) : ED.GD1% = 48 + ED.GN - ED.GT * 10 : ED.GN = ED.GT
  IF ED.GN > 0 THEN ED.GD0% = 48 + ED.GN
ED.ROW.GEOM:
  ED.ASM.BASE% = (ED.SCREEN.ROW + ED.MAP.TOP) * 256 : REM layer 0, at the GUTTER: the block
  REM draws that first and the VERA address walks on into the text of its own accord.
  ED.ASM.ATTR% = ED.ATTR.TEXT : ED.ASM.WIDTH% = ED.TEXT.WIDTH : ED.ASM.MODE% = 0 : ED.ASM.VIS% = 0
  IF ED.DOC.LINE >= LINE.COUNT THEN GOTO ED.ROW.STREAM
  IF ED.DOC.LINE = ED.CUR.ROW THEN GOTO ED.ROW.LIVE
  LINE.INDEX = ED.DOC.LINE : GOSUB DOC.SLOT.READ
  BANK DOC.GOT.BANK
  ED.VIS = PEEK(DOC.GOT.OFF) - ED.LEFT.COL : REM visible chars after horizontal scroll
  IF ED.VIS > 0 THEN ED.ASM.VIS% = ED.VIS
  ED.ASM.SRC% = DOC.GOT.OFF + 1 + ED.LEFT.COL
  GOTO ED.ROW.STREAM
ED.ROW.LIVE:
  ED.ASM.MODE% = 1 : ED.VIS = LEN(ED.CUR.LINE$) - ED.LEFT.COL
  IF ED.VIS > 0 THEN ED.ASM.VIS% = ED.VIS
  ED.ASM.OFS% = 3 + ED.LEFT.COL : REM past [MaxLen][control][ActLen] to the text
ED.ROW.STREAM:
  #REM 1
  GP.ASM
  REM ; ---- VERA: address, +4 increment, FX cache write on, both attribute slots ----
  REM LDA {ED.ASM.BASE%}
  REM STA $9F20
  REM LDX #1
  REM LDA {ED.ASM.BASE%},X
  REM STA $9F21
  REM LDA #48                  ; bank 0 (layer 0's map), increment +4 = two cells a flush
  REM STA $9F22
  REM LDA #4                   ; DCSEL 2
  REM STA $9F25
  REM LDA #64                  ; FX_CTRL: cache write enable
  REM STA $9F29
  REM LDA #12                  ; DCSEL 6 -- the cache itself
  REM STA $9F25
  REM ; ---- the gutter, in the dim attribute: four digits then two spaces. Three flushes,
  REM ; ---- so the address walks to the text still 4-byte aligned, and the text column
  REM ; ---- cannot be odd by construction.
  REM LDA {ED.ASM.GATTR%}
  REM STA $9F2A
  REM STA $9F2C
  REM LDA {ED.GD0%}
  REM STA $9F29
  REM LDA {ED.GD1%}
  REM STA $9F2B
  REM STZ $9F23
  REM LDA {ED.GD2%}
  REM STA $9F29
  REM LDA {ED.GD3%}
  REM STA $9F2B
  REM STZ $9F23
  REM LDA #32
  REM STA $9F29
  REM STA $9F2B
  REM STZ $9F23
  REM ; ---- and now the text attribute, for the rest of the row ----
  REM LDA {ED.ASM.ATTR%}
  REM STA $9F2A                ; attr0
  REM STA $9F2C                ; attr1
  REM ; ---- aim the two fetches at the source, whichever kind of source it is ----
  REM ; There is no expression syntax, so the address goes INTO the operand of the LDA
  REM ; that reads it: STA RGA,X with X=1 patches the low byte, X=2 the high one.
  REM LDA {ED.ASM.MODE%}
  REM BNE RSTR
  REM LDA {ED.ASM.SRC%}        ; the banked store: already a plain address
  REM LDX #1
  REM STA RGA,X
  REM STA RGB,X
  REM LDA {ED.ASM.SRC%},X
  REM BRA RHI
  REM RSTR: CLC                ; ED.CUR.LINE$: the slot holds the block address...
  REM LDA {ED.CUR.LINE$}
  REM ADC {ED.ASM.OFS%}        ; ...and the text starts 3 bytes into the block
  REM LDX #1
  REM STA RGA,X
  REM STA RGB,X
  REM LDA {ED.CUR.LINE$},X
  REM ADC #0
  REM RHI: LDX #2
  REM STA RGA,X
  REM STA RGB,X
  REM ; ---- two cells a pass: char0, char1, one flush ----
  REM LDY #0
  REM RLP: CPY {ED.ASM.VIS%}
  REM BCS RSP1
  REM RGA: LDA $FFFF,Y         ; operand patched above
  REM BRA RPUT1
  REM RSP1: LDA #32
  REM RPUT1: STA $9F29
  REM INY
  REM CPY {ED.ASM.VIS%}
  REM BCS RSP2
  REM RGB: LDA $FFFF,Y         ; operand patched above
  REM BRA RPUT2
  REM RSP2: LDA #32
  REM RPUT2: STA $9F2B
  REM STZ $9F23                ; flush the cache: two cells written
  REM INY
  REM CPY {ED.ASM.WIDTH%}
  REM BCC RLP
  REM ; ---- FX off and DCSEL back to 0, so ordinary VERA writes work again ----
  REM LDA #4
  REM STA $9F25
  REM STZ $9F29
  REM STZ $9F25
  GP.ENDASM
  #REM 0
  RETURN

REM Caret = one inverted attribute cell, remembered so a cursor move can restore it
REM (ED.UNCARET) instead of repainting the screen.
ED.PLACE.CARET:
  ED.CARET.SROW = ED.CUR.ROW - ED.TOP.LINE + 1
  ED.CARET.SCOL = ED.CUR.COL - ED.LEFT.COL
  ED.CARET.VALID = 0
  IF ED.CARET.SROW < 1 OR ED.CARET.SROW > ED.TEXT.BOTTOM THEN RETURN
  IF ED.CARET.SCOL < 0 OR ED.CARET.SCOL >= ED.TEXT.WIDTH THEN RETURN
  ED.CARET.ADDR = (ED.CARET.SROW + ED.MAP.TOP) * 256 + (ED.CARET.SCOL + ED.GUT.W) * 2 + 1
  VPOKE 0, ED.CARET.ADDR, ED.ATTR.CARET : ED.CARET.VALID = 1
  RETURN

ED.UNCARET:
  IF ED.CARET.VALID = 0 THEN RETURN
  VPOKE 0, ED.CARET.ADDR, ED.ATTR.TEXT : ED.CARET.VALID = 0
  RETURN


REM ---- menu bar (layer 1, screen row 0). Attr = bg*16+fg. ----
REM ED.MENU.DRAWBAR draws the titles; the editor's own two things are the full width band
REM and the document name at the right.
REM
REM DRAWN ONLY WHEN IT WOULD COME OUT DIFFERENT -- the body blanks the whole row and draws
REM the items back over it, which flickers. The two tests are the star and which title is
REM highlighted; the FILENAME is a string, so it uses a flag rather than a key string,
REM because a string built per keystroke is an allocation per keystroke.
ED.RENDER.MENUBAR:
  IF ED.MB.FORCE = 1 THEN GOTO ED.MB.DRAW
  IF ED.DOC.DIRTY <> ED.MB.D THEN GOTO ED.MB.DRAW
  RETURN
ED.MB.DRAW:
  ED.MB.FORCE = 0 : ED.MB.D = ED.DOC.DIRTY
  ED.PS.ROW = 0 : ED.PS.COL = 0 : ED.PS.WIDTH = SCREEN.COLS
  ED.PS$ = "" : ED.PS.ATTR = ED.THEME.CLR(ED.THEME.BAR) : GOSUB ED.PUT.FIELD
  GOSUB ED.MENUS.DRAW.BAR
  ED.NAME$ = DOC.FILE.NAME$ : IF ED.DOC.DIRTY = 1 THEN ED.NAME$ = ED.NAME$ + " *"
  ED.NCOL = SCREEN.COLS - LEN(ED.NAME$) - 1
  IF ED.NCOL > 1 THEN ED.PS.ROW = 0 : ED.PS.COL = ED.NCOL - 1 : ED.PS.WIDTH = LEN(ED.NAME$) : ED.PS$ = ED.NAME$ : ED.PS.ATTR = (ED.THEME.CLR(ED.THEME.BAR) AND 240) + (ED.THEME.CLR(ED.THEME.TITLE) AND 15) : GOSUB ED.PUT.FIELD
  RETURN


ED.RENDER.STATUS:
  ED.MARK$ = "   " : IF ED.DOC.DIRTY   = 1 THEN ED.MARK$ = " * "
  REM The arena ran out and lines past that point were stored empty. See DOC.ALLOC.
  IF DOC.FULL <> 0 THEN ED.MARK$ = " DOCUMENT FULL "
  ED.MODE$ = "INS" : IF ED.INSERT.MODE = 0 THEN ED.MODE$ = "OVR"
  ED.BAR$ = ED.MARK$ + "L" + MID$(STR$(ED.CUR.ROW + 1), 2) + " C" + MID$(STR$(ED.CUR.COL + 1), 2) + "  " + ED.MODE$ + "  LINES=" + MID$(STR$(LINE.COUNT), 2) + "   ESC=MENU (F/S/H)  F2=SAVE  F3=FIND"
  ED.PS.ROW = SCREEN.ROWS - 1 : ED.PS.COL = 0 : ED.PS.WIDTH = SCREEN.COLS
  ED.PS$ = ED.BAR$ : ED.PS.ATTR = ED.THEME.CLR(ED.THEME.BAR) : GOSUB ED.PUT.FIELD
  RETURN

REM ---- write ED.PS$ into the VERA text map at 0-based (ED.PS.ROW, ED.PS.COL), attribute
REM ED.PS.ATTR, padded with spaces to ED.PS.WIDTH and truncated past it ----
REM
REM VERA AUTO-INCREMENT: the address and a +1 step are programmed ONCE, then
REM char,attr,char,attr streams to DATA0. Char and attr are adjacent and cells follow each
REM other, so +1 walks the whole field with no per-cell address arithmetic.
REM
REM Assembly for ED.RENDER.ROW's reason: this draws all the chrome, on every keystroke.
REM The width guard matters because the block's test is at the BOTTOM -- without it a
REM width of 0 would write one cell, where the FOR loop it replaced wrote none.
ED.PUT.FIELD:
  IF ED.PS.WIDTH < 1 THEN RETURN
  ED.ASM.BASE% = 45056 + ED.PS.ROW * 256 + ED.PS.COL * 2 : REM layer 1, a SCREEN row
  ED.ASM.ATTR% = ED.PS.ATTR : ED.ASM.WIDTH% = ED.PS.WIDTH : ED.ASM.VIS% = LEN(ED.PS$)
  #REM 1
  GP.ASM
  REM ; ---- VERA: address, +1 increment, ordinary (non-FX) writes ----
  REM LDA {ED.ASM.BASE%}
  REM STA $9F20
  REM LDX #1
  REM LDA {ED.ASM.BASE%},X
  REM STA $9F21
  REM LDA #17                  ; bank 1, address increment +1
  REM STA $9F22
  REM ; ---- aim the fetch at ED.PS$'s text, 3 bytes into its block ----
  REM CLC
  REM LDA {ED.PS$}
  REM ADC #3
  REM LDX #1
  REM STA FGA,X
  REM LDA {ED.PS$},X
  REM ADC #0
  REM LDX #2
  REM STA FGA,X
  REM ; ---- one cell a pass: char then attribute, both to DATA0 ----
  REM LDY #0
  REM FLP: CPY {ED.ASM.VIS%}
  REM BCS FSP
  REM FGA: LDA $FFFF,Y         ; operand patched above
  REM BRA FPUT
  REM FSP: LDA #32
  REM FPUT: STA $9F23          ; char -- VERA steps to the attribute byte
  REM LDA {ED.ASM.ATTR%}
  REM STA $9F23                ; attr -- VERA steps to the next cell
  REM INY
  REM CPY {ED.ASM.WIDTH%}
  REM BCC FLP
  GP.ENDASM
  #REM 0
  RETURN

REM --- this read / writes BANKS (line-pointer table + banked memory)
#INCLUDE "ED-STORE.BASL"
