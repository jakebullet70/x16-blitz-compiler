## ED-STORE.BASL -- the line table, and the banked memory the document lives in. line 255 line 355 here is what we want line 355 here is what we want line 355 here is what we want line 355 here is what we want line 355 here is what we wantline 355 here is what we want line 355 here is what we want line 355 here is what we want
##


## It is #INCLUDEd inline by the editor, so there is one global symbol table: the DOC.*
## labels are GOSUBbed from the main program and the variables below are visible to both.
##
## There are no pointers. A far pointer is two numbers, a bank and an offset, and PEEK and
## POKE honour the last BANK statement, so an access reads BANK <bank> : PEEK $A000 +
## <offset>.
##
## Interface:
##
##   LINE.TEXT$       in for DOC.STORE, out for DOC.LOAD
##   LINE.INDEX%       the line a call works on
##   LINE.COUNT%       lines in the document
##   DOC.FILE.NAME$   in for DOC.LOADFILE and DOC.SAVEFILE
##   DOC.LAST.BANK%    the caller's cap on the arena, 0 for no cap
##   DOC.EOL.MODE%     out of DOC.LOADFILE, in for DOC.SAVEFILE: how lines end on disk
##   DOC.CHARSET%      out of DOC.LOADFILE, in for DOC.SAVEFILE: PETSCII or ASCII on disk
##                    NEVER ASSIGNED FROM OUTSIDE past the load: DOC.SET.CHARSET changes it,
##                    because the document's own bytes have to change with it
##
## Layout:
##
##   Line table   3 bytes a line, [bank][off_lo][off_hi], banks 2 to 4, 2048 entries a
##                bank, so 6144 lines. Line I is at bank BASE + INT(I / 2048), byte
##                (I mod 2048) * 3 of the window, so go-to-line is one calculation.
##   Content      A bump allocator over $A000 to $BF00 in banks 16 to DOC.LAST.BANK%,
##                each line [len][chars]. A record is never freed on its own. DOC.INIT
##                frees all of them, and a save reclaims the rest.
##
## The editor claims the arena from BANKMGR and sets DOC.LAST.BANK% to the last bank it got.
## The bench programs have no BANKMGR and leave it 0.
##
## REQUIRES ED-DOC-CONST.BASL, #INCLUDEd ahead of this file. It holds the DOC.EOL.*,
## DOC.CS.*, DOC.SW.* and DOC.SNIFF.MAX constants.
##
## Names are dotted because BASLOAD tokenises a whole run of A-Z, 0-9 and _ as a keyword if
## that is what it spells. FN$ and ON$ both break.
## ============================================================================

## The DOC.EOL.*, DOC.CS.*, DOC.SW.* and DOC.SNIFF.MAX constants used below are in
## ED-DOC-CONST.BASL, which every program including this file must include first. See the
## header there for why they cannot live in this file.

## DOC.INIT -- empty the store and lay out the banks it uses.
DOC.INIT:
  DOC.WIN.START = 40960 : REM $A000
  DOC.WIN.END = 48896   : REM $BF00 -- $BF00..$BFFF left as a guard tail
  ## Not bank 1: the runtime keeps its rarely used handlers there.
  DOC.TABLE.PER.BANK% = 2048 : DOC.TABLE.BASE.BANK% = 2 : DOC.TABLE.BANKS% = 3
  ## Slots in the whole table. Line 6144 has nowhere to live: DOC.SLOT.LOCATE would work its
  ## segment out as 3 and write the slot into bank 5, the undo log, so every caller that grows
  ## the document has to stop here. DOC.LOADFILE is the one that meets it, on a long file or on
  ## a file of long lines, which the split turns into more lines still.
  DOC.MAX.LINES% = DOC.TABLE.PER.BANK% * DOC.TABLE.BANKS%
  ## What the last load had to do to the file. Both are reported once, after it is on screen.
  DOC.SPLIT.LINES% = 0 : REM lines on disk too long to hold, so split across document lines
  DOC.OVERFLOW% = 0    : REM -1 when the file had more lines than DOC.MAX.LINES% and was cut
  ## The arena only grows upward, so it starts above every fixed bank and leaves 5 to 15 for
  ## whatever wants one.
  ##
  ## WARNING: THIS NUMBER HAS TO STAY ABOVE THE LAST FIXED BANK. EDIT.BASL claims the fixed
  ## banks first and then walks the arena up from here, so an arena that starts on a bank
  ## already taken fails its very first claim and the editor stops with BANK n FAILED before
  ## it draws anything. The file picker's three banks, 13 to 15, are what pushed it to 16.
  DOC.FIRST.BANK% = 16     : REM content arena starts here
  DOC.CUR.BANK% = DOC.FIRST.BANK%  : DOC.CUR.PTR = DOC.WIN.START
  DOC.HIGH.BANK% = DOC.FIRST.BANK% : LINE.COUNT% = 0
  ## The empty record a line gets when the arena is full: the first byte of the guard tail,
  ## which DOC.ALLOC never hands out.
  DOC.FULL% = 0
  BANK DOC.FIRST.BANK%
  POKE DOC.WIN.END, 0
  ## The PETSCII conversion, off unless DOC.LOADFILE turns it on.
  ##
  ## WARNING: it is assigned here, textually above the GP.ASM block in DOC.STORE.CHARS that
  ## reads it. {VAR} needs a slot the compiler has already made, and a variable first
  ## assigned further down the file raises UNKNOWN VARIABLE IN {} at the block.
  DOC.CP.SWAP% = 0
  ## DOC.SWAP.REC's direction, here for exactly the same reason: its GP.ASM block reads
  ## {DOC.SW.DIR%} and DOC.SET.CHARSET, the only routine that assigns it, is further down.
  DOC.SW.DIR% = DOC.SW.TO.ASCII
  ## A document with no file behind it yet. ASCII is right for the host filesystem, which is
  ## where the sources this editor exists to edit live, and it is what the renderer wants in
  ## memory. DOC.LOADFILE overwrites both of these from the file it is about to read.
  DOC.EOL.MODE% = DOC.EOL.CR : DOC.EOL.DELIM% = 13
  DOC.CHARSET% = DOC.CS.ASCII
  RETURN

## DOC.ALLOC -- reserve bytes in the arena.
##
##   in   DOC.ALLOC.SIZE%    bytes wanted
##   out  DOC.RESULT.BANK%   the bank they are in
##        DOC.RESULT.OFF    the offset in the $A000 window
##        DOC.ALLOC.OK%      -1 on success, 0 when the arena is full
##
## WARNING: on a failure the result is the guard record, which every full line shares.
## Nothing may be written past its length byte.
DOC.ALLOC:
  DOC.ALLOC.OK% = -1
  IF DOC.CUR.PTR + DOC.ALLOC.SIZE% <= DOC.WIN.END THEN GOTO DOC.ALLOC.PLACE
  IF DOC.LAST.BANK% > 0 AND DOC.CUR.BANK% >= DOC.LAST.BANK% THEN GOTO DOC.ALLOC.FULL
  DOC.CUR.BANK% = DOC.CUR.BANK% + 1 : DOC.CUR.PTR = DOC.WIN.START
  IF DOC.CUR.BANK% > DOC.HIGH.BANK% THEN DOC.HIGH.BANK% = DOC.CUR.BANK%
DOC.ALLOC.PLACE:
  DOC.RESULT.BANK% = DOC.CUR.BANK% : DOC.RESULT.OFF = DOC.CUR.PTR
  DOC.CUR.PTR = DOC.CUR.PTR + DOC.ALLOC.SIZE%
  RETURN

DOC.ALLOC.FULL:
  DOC.ALLOC.OK% = 0
  DOC.FULL% = -1
  DOC.RESULT.BANK% = DOC.FIRST.BANK%
  DOC.RESULT.OFF = DOC.WIN.END
  RETURN

## DOC.SLOT.LOCATE -- find line LINE.INDEX%'s table slot.
##
##   out  DOC.SLOT.BANK%   the table bank holding it
##        DOC.SLOT.ADDR   its address in the window
DOC.SLOT.LOCATE:
  DOC.SEGMENT% = INT(LINE.INDEX% / DOC.TABLE.PER.BANK%) : DOC.SLOT.BANK% = DOC.TABLE.BASE.BANK% + DOC.SEGMENT%
  DOC.SLOT.ADDR = DOC.WIN.START + (LINE.INDEX% - DOC.SEGMENT% * DOC.TABLE.PER.BANK%) * 3
  RETURN

## DOC.SLOT.WRITE -- point line LINE.INDEX%'s slot at (DOC.PUT.BANK%, DOC.PUT.OFF).
##
## WARNING: THE OFFSETS ARE UNTYPED ON PURPOSE. An offset into the $A000 window runs from
## 40960 to 48896 and a % is a SIGNED 16-bit integer, so every one of them is negative in a
## %. The split below then writes the wrong high byte and every record is read from the
## wrong address: a whole document of garbage, with no error to say so. DOC.GOT.OFF,
## DOC.PUT.OFF, DOC.RESULT.OFF, DOC.CUR.PTR, DOC.SLOT.ADDR and DOC.SH.ADDR all stay
## untyped for this reason. The BANK, LEN and INDEX names beside them are small and are %.
DOC.SLOT.WRITE:
  GOSUB DOC.SLOT.LOCATE : BANK DOC.SLOT.BANK%
  POKE DOC.SLOT.ADDR, DOC.PUT.BANK% : DOC.OFF.HIGH% = INT(DOC.PUT.OFF / 256)
  POKE DOC.SLOT.ADDR + 1, DOC.PUT.OFF - DOC.OFF.HIGH% * 256
  POKE DOC.SLOT.ADDR + 2, DOC.OFF.HIGH%
  RETURN

## DOC.SLOT.READ -- read line LINE.INDEX%'s slot into DOC.GOT.BANK%, DOC.GOT.OFF.
DOC.SLOT.READ:
  GOSUB DOC.SLOT.LOCATE : BANK DOC.SLOT.BANK%
  DOC.GOT.BANK% = PEEK(DOC.SLOT.ADDR)
  DOC.GOT.OFF = PEEK(DOC.SLOT.ADDR + 2) * 256 + PEEK(DOC.SLOT.ADDR + 1)
  RETURN

## DOC.STORE -- store LINE.TEXT$ as line LINE.INDEX%: allocate, copy, update the table.
##
## The old record is not freed. DOC.INIT is the only way back, and a save is what reclaims
## the space.
DOC.STORE:
  DOC.LEN% = LEN(LINE.TEXT$) : DOC.ALLOC.SIZE% = DOC.LEN% + 1
  GOSUB DOC.ALLOC
  IF DOC.ALLOC.OK% = 0 THEN DOC.LEN% = 0
  BANK DOC.RESULT.BANK% : POKE DOC.RESULT.OFF, DOC.LEN%
  IF DOC.LEN% > 0 THEN GOSUB DOC.STORE.CHARS
  DOC.PUT.BANK% = DOC.RESULT.BANK% : DOC.PUT.OFF = DOC.RESULT.OFF
  GOSUB DOC.SLOT.WRITE
  RETURN

## DOC.STORE.CHARS -- copy the line's characters from main RAM into the bank window, in one
## machine-code pass.
##
## Y walks down from the length, so offset 0, the length byte written by DOC.STORE, is left
## alone and the loop needs no counter. DOC.CP.SWAP% turns on the PETSCII to ASCII conversion
## that only the loader wants.
DOC.STORE.CHARS:
  DOC.CP.BANK% = DOC.RESULT.BANK% : DOC.CP.SRC% = GP.STRPTR(LINE.TEXT$)
  DOC.CP.DST% = DOC.RESULT.OFF   : DOC.CP.LEN% = DOC.LEN%
  #REM 1
  GP.ASM
  REM LDA {DOC.CP.BANK%}
  REM STA $00
  REM LDA {DOC.CP.SRC%}
  REM LDX #1
  REM STA CPS,X
  REM LDA {DOC.CP.SRC%},X
  REM LDX #2
  REM STA CPS,X
  REM LDA {DOC.CP.DST%}
  REM LDX #1
  REM STA CPD,X
  REM LDA {DOC.CP.DST%},X
  REM LDX #2
  REM STA CPD,X
  REM LDX {DOC.CP.SWAP%}
  REM LDY {DOC.CP.LEN%}
  REM CPS: LDA $FFFF,Y
  REM CPX #0
  REM BEQ CPW
  REM CMP #$C1
  REM BCC CPLO
  REM CMP #$DB
  REM BCS CPW
  REM SEC
  REM SBC #$80
  REM BRA CPW
  REM CPLO: CMP #$41
  REM BCC CPW
  REM CMP #$5B
  REM BCS CPW
  REM CLC
  REM ADC #$20
  REM CPW:
  REM CPD: STA $FFFF,Y
  REM DEY
  REM BNE CPS
  GP.ENDASM
  #REM 0
  RETURN

## DOC.SWAP.REC -- convert one stored record between PETSCII and ASCII, in place.
##
##   in   DOC.GOT.BANK%, DOC.GOT.OFF   the record, as DOC.SLOT.READ leaves them
##        DOC.SW.DIR%                  DOC.SW.TO.ASCII or DOC.SW.TO.PETSCII
##
## IN PLACE IS THE WHOLE POINT. Both conversions are byte maps that preserve length, so the
## record never has to move, and a document of 6144 lines can be reinterpreted without taking
## a single byte more of the arena. Going through DOC.LOAD and DOC.STORE instead would
## allocate a fresh record for every line, and the arena is a bump allocator that frees
## nothing until a save, so a second press could fill it.
##
## Y walks down from the length to 1, so offset 0, the length byte, is never touched.
DOC.SWAP.REC:
  BANK DOC.GOT.BANK% : DOC.SW.LEN% = PEEK(DOC.GOT.OFF)
  IF DOC.SW.LEN% = 0 THEN RETURN
  DOC.CP.BANK% = DOC.GOT.BANK% : DOC.CP.DST% = DOC.GOT.OFF : DOC.CP.LEN% = DOC.SW.LEN%
  #REM 1
  GP.ASM
  REM LDA {DOC.CP.BANK%}
  REM STA $00
  REM LDA {DOC.CP.DST%}
  REM LDX #1
  REM STA SWR,X
  REM STA SWW,X
  REM LDA {DOC.CP.DST%},X
  REM LDX #2
  REM STA SWR,X
  REM STA SWW,X
  REM LDX {DOC.SW.DIR%}
  REM LDY {DOC.CP.LEN%}
  REM SWR: LDA $FFFF,Y
  REM CPX #0
  REM BNE SWTOPET
  REM CMP #$C1
  REM BCC SWAUP
  REM CMP #$DB
  REM BCS SWDONE
  REM SEC
  REM SBC #$80
  REM BRA SWDONE
  REM SWAUP: CMP #$41
  REM BCC SWDONE
  REM CMP #$5B
  REM BCS SWDONE
  REM CLC
  REM ADC #$20
  REM BRA SWDONE
  REM SWTOPET: CMP #$41
  REM BCC SWPLO
  REM CMP #$5B
  REM BCS SWPLO
  REM CLC
  REM ADC #$80
  REM BRA SWDONE
  REM SWPLO: CMP #$61
  REM BCC SWDONE
  REM CMP #$7B
  REM BCS SWDONE
  REM SEC
  REM SBC #$20
  REM SWDONE:
  REM SWW: STA $FFFF,Y
  REM DEY
  REM BNE SWR
  GP.ENDASM
  #REM 0
  RETURN

## DOC.SET.CHARSET -- say that the file is really in the other character set, and convert the
## whole document to match.
##
##   in   DOC.NEW.CHARSET%   DOC.CS.ASCII or DOC.CS.PETSCII
##
## This is what the editor's character-set key calls. It is not a flag flip: if DOC.SNIFF.FILE
## read the file wrongly then the bytes in the store are wrong too, so the flag and the bytes
## have to move together.
##
## WARNING: THE DIRECTION IS THE OPPOSITE OF THE CHARACTER SET BEING SET, and getting it
## backwards corrupts every line. The store always holds ASCII, because that is what the
## renderer draws. So:
##
##   setting PETSCII   the load swap was SKIPPED, the store holds raw PETSCII, and it must be
##                     converted TO ASCII now
##   setting ASCII     the load swap WAS applied to a file that did not want it, so it must be
##                     undone, which means converting the store back TO PETSCII
##
## The two maps are inverses over the letter ranges, so pressing the key twice returns the
## document to exactly the bytes it started with.
DOC.SET.CHARSET:
  IF DOC.NEW.CHARSET% = DOC.CHARSET% THEN RETURN
  DOC.SW.DIR% = DOC.SW.TO.ASCII
  IF DOC.NEW.CHARSET% = DOC.CS.ASCII THEN DOC.SW.DIR% = DOC.SW.TO.PETSCII
  DOC.CHARSET% = DOC.NEW.CHARSET%
  ## WARNING: FOR 0 TO -1 runs the body once, with an index the document does not have, so an
  ## empty document would swap whatever the first table slot happens to hold.
  IF LINE.COUNT% = 0 THEN RETURN
  FOR DOC.SW.INDEX = 0 TO LINE.COUNT% - 1
    LINE.INDEX% = DOC.SW.INDEX : GOSUB DOC.SLOT.READ : GOSUB DOC.SWAP.REC
  NEXT DOC.SW.INDEX
  RETURN

## DOC.LOAD -- read line LINE.INDEX% into LINE.TEXT$. A line past the end reads empty.
##
## WARNING: keep the LINE.COUNT% guard, and note that line 0 of a 0-line document is past the
## end. A never-written slot PEEKs as a length over randomised RAM, which builds a garbage
## string of up to 255 characters and raises OUT OF MEMORY later.
DOC.LOAD:
  LINE.TEXT$ = ""
  IF LINE.INDEX% >= LINE.COUNT% THEN RETURN
  GOSUB DOC.SLOT.READ : BANK DOC.GOT.BANK% : DOC.LEN% = PEEK(DOC.GOT.OFF)
  IF DOC.LEN% > 0 THEN GOSUB DOC.LOAD.CHARS
  RETURN
## DOC.LOAD.CHARS -- append the record's DOC.LEN% characters to LINE.TEXT$.
DOC.LOAD.CHARS:
  FOR DOC.CHAR.INDEX = 1 TO DOC.LEN%
    LINE.TEXT$ = LINE.TEXT$ + CHR$(PEEK(DOC.GOT.OFF + DOC.CHAR.INDEX))
  NEXT DOC.CHAR.INDEX
  RETURN

## DOC.SNIFF.FILE -- read the head of DOC.FILE.NAME$ and answer the two things a text file
## does not say about itself: which bytes end its lines, and whether its letters are PETSCII
## or ASCII.
##
##   in   DOC.FILE.NAME$
##   out  DOC.EOL.MODE%    DOC.EOL.CR, DOC.EOL.LF or DOC.EOL.CRLF
##        DOC.EOL.DELIM%   the byte LINPUT# stops at: 13 for CR, 10 for LF and CRLF
##        DOC.CHARSET%     DOC.CS.ASCII or DOC.CS.PETSCII
##
## BOTH ANSWERS ARE READ AGAIN BY DOC.SAVEFILE, and that is the point of the routine. The
## editor used to take every file for PETSCII and write every file back as PETSCII. On a
## CMDR-DOS drive that is right. On the host filesystem it is not: a host file is ASCII, the
## load swap turns its capitals into lower case, the save swap then turns all of it into
## $41-$5A, and both cases have collapsed onto one byte. The file is rewritten and the case
## cannot be recovered from it. Sniffing the file and writing back what was read is the fix.
##
## The read is a byte at a time because nothing else can tell a CR from a CRLF: a CR has to
## be followed to the byte after it, and LINPUT# has already swallowed that byte. It is
## capped at DOC.SNIFF.MAX and it stops as soon as both answers are in.
##
## The charset test is the two ranges the encodings disagree about. PETSCII holds lower case
## in $41-$5A and upper case in $C1-$DA; ASCII holds upper case in $41-$5A and lower case in
## $61-$7A. A byte in $41-$5A is therefore no evidence at all.
##
## THE TWO KINDS OF EVIDENCE ARE NOT EQUAL, and treating them as equal loses text. A byte in
## $61-$7A is a letter no PETSCII text file can contain, so it is decisive and the scan stops
## on it. A byte in $C1-$DA is only probably PETSCII: the editor runs in ISO mode, where
## $C1-$DA is A-grave to U-acute, so a host file with an accented capital in it has those
## bytes and is still ASCII. It is therefore recorded and the scan CARRIES ON, and any later
## lower-case byte overrules it.
##
## Getting this backwards is not a cosmetic error. A mixed-case ASCII file read as PETSCII has
## the load swap applied to it, which sends $41-$5A and $61-$7A both into $61-$7A. The two
## cases are then one byte and no key can separate them again. The file that provokes it is a
## plain one -- a heading in accented capitals above the first ordinary word.
##
## WARNING: the default settles every all-upper-case file, because unaccented capitals and
## punctuation alone are evidence for neither encoding. ASCII is the default, so such a file loads
## unchanged and saves back byte for byte. A PETSCII file of capitals only then shows on
## screen in the wrong case, which is worth seeing and is not worth rewriting the file over.
DOC.SNIFF.FILE:
  DOC.SN.EOL% = 0 : DOC.SN.CS% = 0 : DOC.SN.CR% = 0 : DOC.SN.LEFT% = DOC.SNIFF.MAX
  DOC.OPEN.NAME$ = DOC.FILE.NAME$ + ",S,R"
  OPEN 2, 8, 2, DOC.OPEN.NAME$
  GP.DO
    ## GET# hands back "" for a zero byte, and for the CHR$(0) a missing file answers with.
    GET# 2, DOC.SN.CHAR$
    DOC.STATUS% = ST : DOC.SN.CHAR% = 0
    IF DOC.SN.CHAR$ <> "" THEN DOC.SN.CHAR% = ASC(DOC.SN.CHAR$)
    ## The endings. A CR sets DOC.EOL.CR and remembers itself; the byte after it either is an
    ## LF, which makes it DOC.EOL.CRLF, or is not, which leaves it CR. An LF with no CR
    ## before it is DOC.EOL.LF. The first of the two to appear is the answer.
    GP.IF DOC.SN.EOL% = 0 THEN
      IF DOC.SN.CR% <> 0 AND DOC.SN.CHAR% = 10 THEN DOC.EOL.MODE% = DOC.EOL.CRLF : DOC.EOL.DELIM% = 10
      IF DOC.SN.CR% <> 0 THEN DOC.SN.EOL% = 1
      IF DOC.SN.EOL% = 0 AND DOC.SN.CHAR% = 13 THEN DOC.SN.CR% = 1 : DOC.EOL.MODE% = DOC.EOL.CR : DOC.EOL.DELIM% = 13
      IF DOC.SN.EOL% = 0 AND DOC.SN.CHAR% = 10 THEN DOC.EOL.MODE% = DOC.EOL.LF : DOC.EOL.DELIM% = 10 : DOC.SN.EOL% = 1
    GP.ENDIF
    GP.IF DOC.SN.CS% = 0 THEN
      IF DOC.SN.CHAR% >= 97 AND DOC.SN.CHAR% <= 122 THEN DOC.CHARSET% = DOC.CS.ASCII : DOC.SN.CS% = 1
      ## No DOC.SN.CS% here on purpose: weak evidence, so keep reading. The cost is that a
      ## PETSCII file, which has no $61-$7A byte anywhere, always reads the full
      ## DOC.SNIFF.MAX. An ASCII file with lower case in its first line, which is every
      ## source this editor edits, still stops on that line.
      IF DOC.SN.CHAR% >= 193 AND DOC.SN.CHAR% <= 218 THEN DOC.CHARSET% = DOC.CS.PETSCII
    GP.ENDIF
    IF DOC.SN.EOL% <> 0 AND DOC.SN.CS% <> 0 THEN GP.EXITDO
    ## Any ST at all ends it: 64 is end of file and 66 is the missing file that never ends.
    IF DOC.STATUS% <> 0 THEN GP.EXITDO
    DOC.SN.LEFT% = DOC.SN.LEFT% - 1
    IF DOC.SN.LEFT% = 0 THEN GP.EXITDO
  GP.LOOP
  CLOSE 2
  RETURN

## DOC.LOADFILE -- read the text file DOC.FILE.NAME$ into the store, filling the table and
## setting LINE.COUNT.
##
## DOC.SNIFF.FILE runs first and DOC.INIT before it, because DOC.INIT resets the two answers
## the sniff is there to work out. LINPUT# then reads a whole line in assembly, one string a
## line, stopping at the one byte the sniff chose. A CRLF file is read to its LF, so the CR
## before it is still on the end of the string and is taken off here.
##
## At end of file the KERNAL sets ST while handing over the last byte, so that read still
## carries a real line. DOC.RAW% is the line's length once the CR is off and the split has
## taken its whole-length chunks away: 0 means the file ended on a bare line ending, a blank
## last line that is kept.
##
## A line longer than DOC.MAX.LINE.LEN is split rather than truncated, and DOC.SPLIT.LINES%
## counts the lines that were, for the caller to report. A file with more lines than the table
## has slots is read as far as the table goes and sets DOC.OVERFLOW%.
DOC.LOADFILE:
  GOSUB DOC.INIT
  GOSUB DOC.SNIFF.FILE
  DOC.OPEN.NAME$ = DOC.FILE.NAME$ + ",S,R"
  OPEN 2, 8, 2, DOC.OPEN.NAME$
  ## Only a PETSCII file is converted on the way in, and DOC.CS.PETSCII is the flag value the
  ## GP.ASM block in DOC.STORE.CHARS wants.
  DOC.CP.SWAP% = DOC.CHARSET%
DOC.READ.LOOP:
  LINPUT# 2, LINE.TEXT$, DOC.EOL.DELIM%
  DOC.STATUS% = ST
  ## WARNING: bit 1 of ST is a read error, and it is the only thing that separates a missing
  ## file from a clean end of file. An OPEN that found no file still opens, and every
  ## LINPUT# then hands back CHR$(0) with ST = 66 for ever, which reads as a document of one
  ## NUL line. Clean end of file is 64.
  IF (DOC.STATUS% AND 2) <> 0 THEN GOTO DOC.READ.DONE
  ## The table is full, so this line and everything after it is dropped. Abandoning the read is
  ## the only honest answer: a slot above the table is computed into the undo log's bank.
  IF LINE.COUNT% >= DOC.MAX.LINES% THEN DOC.OVERFLOW% = -1 : GOTO DOC.READ.DONE
  IF DOC.EOL.MODE% = DOC.EOL.CRLF AND LEN(LINE.TEXT$) > 0 AND RIGHT$(LINE.TEXT$, 1) = CHR$(13) THEN LINE.TEXT$ = LEFT$(LINE.TEXT$, LEN(LINE.TEXT$) - 1)
  IF LEN(LINE.TEXT$) > DOC.MAX.LINE.LEN THEN GOSUB DOC.SPLIT.LONG
  ## Only reached when the split ran out of table in the middle of the line. Without it a
  ## record longer than its own length byte can count would be stored.
  IF LEN(LINE.TEXT$) > DOC.MAX.LINE.LEN THEN LINE.TEXT$ = LEFT$(LINE.TEXT$, DOC.MAX.LINE.LEN)
  DOC.RAW% = LEN(LINE.TEXT$)
  ## DOC.STORE.CHARS does the PETSCII swap, in the same pass as the copy.
  IF DOC.STATUS% = 0 THEN GOSUB DOC.PUSH.LINE : GOTO DOC.READ.LOOP
  IF DOC.RAW% > 0 THEN GOSUB DOC.PUSH.LINE : GOTO DOC.READ.DONE
  IF LINE.COUNT% > 0 THEN GOSUB DOC.PUSH.LINE
DOC.READ.DONE:
  DOC.CP.SWAP% = 0 : CLOSE 2
  ## Clear the drive's latched error. A name that is not on the disk opens anyway and leaves
  ## the error set, and the red light then stays on until something reads channel 15, which
  ## is what an empty DOS.CMD does. DOC.SNIFF.FILE opens the same missing name first and
  ## latches the same error, so this one call answers for both. FILE.ERR holds the code.
  GP.SUB DOS.CMD, ""
  RETURN

## DOC.PUSH.LINE -- store LINE.TEXT$ as the next line, and clear it.
DOC.PUSH.LINE:
  LINE.INDEX% = LINE.COUNT% : GOSUB DOC.STORE : LINE.COUNT% = LINE.COUNT% + 1
  LINE.TEXT$ = ""
  RETURN

## DOC.SPLIT.LONG -- push whole DOC.MAX.LINE.LEN chunks of LINE.TEXT$ until what is left fits,
## and leave that remainder in LINE.TEXT$ for the read loop to push as usual.
##
## Called only when the line is already over length, so at least one chunk goes out and the
## remainder is 1 to DOC.MAX.LINE.LEN characters: the loop ends on a length that no longer
## EXCEEDS the maximum, and zero cannot be that length. A line of exactly 500 characters is
## therefore two lines, not two and a blank one.
##
## The tail is copied out before DOC.PUSH.LINE is called, because DOC.PUSH.LINE clears
## LINE.TEXT$.
##
## DOC.SPLIT.LINES% counts LINES OF THE FILE that were split, not the pieces they became: one
## 4000-character line is 1 here and 16 lines in the document.
##
## WARNING: the file on disk is untouched, but the document no longer matches it. A save writes
## the pieces out as separate lines, so the file that comes back has line endings the original
## did not. That is why the caller reports the count instead of keeping quiet: it is the one
## case where opening a file and saving it changes the file.
DOC.SPLIT.LONG:
  DOC.SPLIT.LINES% = DOC.SPLIT.LINES% + 1
  GP.DO
    DOC.SPLIT.TAIL$ = MID$(LINE.TEXT$, DOC.MAX.LINE.LEN + 1)
    LINE.TEXT$ = LEFT$(LINE.TEXT$, DOC.MAX.LINE.LEN)
    GOSUB DOC.PUSH.LINE
    LINE.TEXT$ = DOC.SPLIT.TAIL$ : DOC.SPLIT.TAIL$ = ""
    IF LEN(LINE.TEXT$) <= DOC.MAX.LINE.LEN THEN GP.EXITDO
    ## Out of table in the middle of one line. The caller clamps what is left and stops.
    IF LINE.COUNT% >= DOC.MAX.LINES% THEN DOC.OVERFLOW% = -1 : GP.EXITDO
  GP.LOOP
  RETURN

## ============================================================================
## The table shift -- a memmove in assembly
## ============================================================================
## An insert or a delete moves every table entry above the line. BASIC works out which bytes
## move and the assembly moves them.
##
## The shift is one entry either way, so source and destination overlap. An insert copies
## top down, a delete bottom up, and the chunking keeps that order.
##
## WARNING: a shift may not cross a segment boundary. A table bank holds 2048 entries and
## one bank is selected for the whole copy, so an entry at the top of a bank moves into the
## next bank, which the block cannot reach. Those entries move an entry at a time in BASIC
## instead, at most two a shift. Nothing crosses a boundary under 2048 lines, so a block
## that ignores this passes every short test and corrupts the first long file it meets.

## DOC.INSERT.SLOT -- open a slot at LINE.INDEX% by shifting the entries above it up, and
## raise LINE.COUNT. The caller then DOC.STOREs the new line's content there.
DOC.INSERT.SLOT:
  DOC.INS.AT% = LINE.INDEX% : DOC.SH.J% = LINE.COUNT% - 1
DOC.INS.LOOP:
  IF DOC.SH.J% < DOC.INS.AT% THEN GOTO DOC.INS.DONE
  DOC.SH.SEG% = INT(DOC.SH.J% / DOC.TABLE.PER.BANK%)
  IF DOC.SH.SEG% <> INT((DOC.SH.J% + 1) / DOC.TABLE.PER.BANK%) THEN GOTO DOC.INS.CROSS
  DOC.SH.LO% = DOC.SH.SEG% * DOC.TABLE.PER.BANK%
  IF DOC.SH.LO% < DOC.INS.AT% THEN DOC.SH.LO% = DOC.INS.AT%
  DOC.MV.BANK% = DOC.TABLE.BASE.BANK% + DOC.SH.SEG% : DOC.SH.ADDR = DOC.WIN.START + (DOC.SH.LO% - DOC.SH.SEG% * DOC.TABLE.PER.BANK%) * 3
  DOC.SH.P% = (DOC.SH.J% - DOC.SH.LO% + 1) * 3
DOC.INS.CHUNK:
  IF DOC.SH.P% < 1 THEN GOTO DOC.INS.RUNDONE
  DOC.SH.K% = DOC.SH.P% : IF DOC.SH.K% > 255 THEN DOC.SH.K% = 255
  DOC.MV.SRC% = DOC.SH.ADDR + DOC.SH.P% - DOC.SH.K% : DOC.MV.DST% = DOC.SH.ADDR + DOC.SH.P% - DOC.SH.K% + 3
  DOC.MV.LEN% = DOC.SH.K%
  GOSUB DOC.MV.DOWN
  DOC.SH.P% = DOC.SH.P% - DOC.SH.K%
  GOTO DOC.INS.CHUNK
DOC.INS.RUNDONE:
  DOC.SH.J% = DOC.SH.LO% - 1
  GOTO DOC.INS.LOOP
## The one entry whose destination is in the next bank. Two banks, so it moves in BASIC.
DOC.INS.CROSS:
  LINE.INDEX% = DOC.SH.J% : GOSUB DOC.SLOT.READ
  DOC.PUT.BANK% = DOC.GOT.BANK% : DOC.PUT.OFF = DOC.GOT.OFF
  LINE.INDEX% = DOC.SH.J% + 1 : GOSUB DOC.SLOT.WRITE
  DOC.SH.J% = DOC.SH.J% - 1
  GOTO DOC.INS.LOOP
DOC.INS.DONE:
  LINE.COUNT% = LINE.COUNT% + 1
  RETURN

## DOC.DELETE.SLOT -- remove the slot at LINE.INDEX% by shifting the entries above it down,
## and lower LINE.COUNT. The line's content record is left where it is until the next save
## reclaims it.
DOC.DELETE.SLOT:
  DOC.DEL.AT% = LINE.INDEX% : DOC.SH.J% = DOC.DEL.AT% + 1
DOC.DEL.LOOP:
  IF DOC.SH.J% > LINE.COUNT% - 1 THEN GOTO DOC.DEL.DONE
  DOC.SH.SEG% = INT(DOC.SH.J% / DOC.TABLE.PER.BANK%)
  IF DOC.SH.SEG% <> INT((DOC.SH.J% - 1) / DOC.TABLE.PER.BANK%) THEN GOTO DOC.DEL.CROSS
  DOC.SH.HI% = DOC.SH.SEG% * DOC.TABLE.PER.BANK% + DOC.TABLE.PER.BANK% - 1
  IF DOC.SH.HI% > LINE.COUNT% - 1 THEN DOC.SH.HI% = LINE.COUNT% - 1
  DOC.MV.BANK% = DOC.TABLE.BASE.BANK% + DOC.SH.SEG%
  DOC.SH.ADDR = DOC.WIN.START + (DOC.SH.J% - 1 - DOC.SH.SEG% * DOC.TABLE.PER.BANK%) * 3
  DOC.SH.N% = (DOC.SH.HI% - DOC.SH.J% + 1) * 3 :  DOC.SH.P% = 0
DOC.DEL.CHUNK:
  IF DOC.SH.P% >= DOC.SH.N% THEN GOTO DOC.DEL.RUNDONE
  DOC.SH.K% = DOC.SH.N% - DOC.SH.P% : IF DOC.SH.K% > 255 THEN DOC.SH.K% = 255
  DOC.MV.DST% = DOC.SH.ADDR + DOC.SH.P% : DOC.MV.SRC% = DOC.SH.ADDR + DOC.SH.P% + 3
  DOC.MV.LEN% = DOC.SH.K% :  GOSUB DOC.MV.UP : DOC.SH.P% = DOC.SH.P% + DOC.SH.K%
  GOTO DOC.DEL.CHUNK
DOC.DEL.RUNDONE:
  DOC.SH.J% = DOC.SH.HI% + 1
  GOTO DOC.DEL.LOOP
## The one entry whose destination is in the previous bank, which moves in BASIC.
DOC.DEL.CROSS:
  LINE.INDEX% = DOC.SH.J% : GOSUB DOC.SLOT.READ
  DOC.PUT.BANK% = DOC.GOT.BANK% : DOC.PUT.OFF = DOC.GOT.OFF
  LINE.INDEX% = DOC.SH.J% - 1 : GOSUB DOC.SLOT.WRITE
  DOC.SH.J% = DOC.SH.J% + 1
  GOTO DOC.DEL.LOOP
DOC.DEL.DONE:
  LINE.COUNT% = LINE.COUNT% - 1
  RETURN

## DOC.MV.DOWN -- move DOC.MV.LEN% bytes, 1 to 255, inside bank DOC.MV.BANK%, highest byte
## first.
##
##   in   DOC.MV.SRC%    source offset in the $A000 window
##        DOC.MV.DST%    destination offset, which is DOC.MV.SRC% + 3 on an insert
##        DOC.MV.LEN%    bytes to move
##
## Source and destination overlap, so the last byte moves first. $00 is the RAM bank
## register, and the block owns the bank for its own accesses only. The operands are patched
## in place rather than held in zero page, the idiom the EDIT.BASL renderers use.
DOC.MV.DOWN:
  #REM 1
  GP.ASM
  REM LDA {DOC.MV.BANK%}
  REM STA $00
  REM LDA {DOC.MV.SRC%}
  REM LDX #1
  REM STA MDS,X
  REM LDA {DOC.MV.SRC%},X
  REM LDX #2
  REM STA MDS,X
  REM LDA {DOC.MV.DST%}
  REM LDX #1
  REM STA MDD,X
  REM LDA {DOC.MV.DST%},X
  REM LDX #2
  REM STA MDD,X
  REM LDY {DOC.MV.LEN%}
  REM MDL: DEY
  REM MDS: LDA $FFFF,Y
  REM MDD: STA $FFFF,Y
  REM CPY #0
  REM BNE MDL
  GP.ENDASM
  #REM 0
  RETURN

## DOC.MV.UP -- move DOC.MV.LEN% bytes, 1 to 255, inside bank DOC.MV.BANK%, lowest byte
## first. On a delete DOC.MV.SRC% is DOC.MV.DST% + 3, so the first byte moves first.
DOC.MV.UP:
  #REM 1
  GP.ASM
  REM LDA {DOC.MV.BANK%}
  REM STA $00
  REM LDA {DOC.MV.SRC%}
  REM LDX #1
  REM STA MUS,X
  REM LDA {DOC.MV.SRC%},X
  REM LDX #2
  REM STA MUS,X
  REM LDA {DOC.MV.DST%}
  REM LDX #1
  REM STA MUD,X
  REM LDA {DOC.MV.DST%},X
  REM LDX #2
  REM STA MUD,X
  REM LDY #0
  REM MUS: LDA $FFFF,Y
  REM MUD: STA $FFFF,Y
  REM INY
  REM CPY {DOC.MV.LEN%}
  REM BCC MUS
  GP.ENDASM
  #REM 0
  RETURN

## DOC.SAVEFILE -- write the whole document to DOC.FILE.NAME$, in the encoding it was read
## in.
##
## "@:" replaces an existing file. A save is also where the arena is compacted, so the caller
## may reload afterwards.
##
## THE LINE ENDING AND THE CHARACTER SET BOTH COME FROM THE LOAD, through DOC.EOL.MODE% and
## DOC.CHARSET%, so a file goes back to disk the way it arrived. A document with no file
## behind it takes the DOC.INIT defaults.
##
## The trailing semicolon on the PRINT# is what makes that possible: without it PRINT# adds a
## CR of its own and the ending could only ever be CR. DOC.EOL$ is the only thing that writes
## one, and it is built once rather than per line.
DOC.SAVEFILE:
  DOC.EOL$ = CHR$(13)
  IF DOC.EOL.MODE% = DOC.EOL.LF THEN DOC.EOL$ = CHR$(10)
  IF DOC.EOL.MODE% = DOC.EOL.CRLF THEN DOC.EOL$ = CHR$(13) + CHR$(10)
  DOC.OPEN.NAME$ = "@:" + DOC.FILE.NAME$ + ",S,W"
  OPEN 2, 8, 2, DOC.OPEN.NAME$
  FOR DOC.SAVE.INDEX = 0 TO LINE.COUNT% - 1
    LINE.INDEX% = DOC.SAVE.INDEX : GOSUB DOC.LOAD
    GOSUB DOC.ENCODE.LINE : PRINT#2, DOC.OUT$; DOC.EOL$;
  NEXT DOC.SAVE.INDEX
  CLOSE 2
  RETURN

## DOC.ENCODE.LINE -- LINE.TEXT$ as it is in memory to DOC.OUT$ as the file wants it.
##
## An ASCII file is one assignment and no loop at all. That is not only correct, it is much
## the quicker path: the loop below builds a new string for every character of every line of
## the document, and most files this editor is pointed at are ASCII.
##
## WARNING: upper case is tested first. A letter moved to $C1-$DA is then out of range of
## the lower-case test, so nothing converts twice.
DOC.ENCODE.LINE:
  DOC.OUT$ = LINE.TEXT$
  IF DOC.CHARSET% = DOC.CS.ASCII THEN RETURN
  DOC.OUT$ = ""
  ## WARNING: FOR 1 TO 0 runs the body once, because the test is at the NEXT. Without the
  ## guard an empty line goes out as a single CHR$(0).
  IF LEN(LINE.TEXT$) = 0 THEN RETURN
  FOR DOC.TI = 1 TO LEN(LINE.TEXT$)
    DOC.TC% = ASC(MID$(LINE.TEXT$, DOC.TI, 1))
    IF DOC.TC% >= 65 AND DOC.TC% <= 90 THEN DOC.TC% = DOC.TC% + 128
    IF DOC.TC% >= 97 AND DOC.TC% <= 122 THEN DOC.TC% = DOC.TC% - 32
    DOC.OUT$ = DOC.OUT$ + CHR$(DOC.TC%)
  NEXT DOC.TI
  RETURN
